            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of lysosomal acid lipase deficiency characterized by progressive cholesterol esters and triglyceride accumulation in tissues and organs typically presenting with hepatosplenomegaly, liver dysfunction and/or dyslipidemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cholesterol ester storage disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cholesteryl ester storage disease</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder defined by generalized osteosclerosis with periosteal bone formation, characteristic facial dysmorphism, brain abnormalities including intracerebral calcifications, and neonatal lethal course.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Osteosclerotic bone dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Raine syndrome</oboInOwl:hasExactSynonym>

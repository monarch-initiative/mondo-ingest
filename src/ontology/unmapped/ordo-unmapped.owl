        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">COG5-CDG is an extremely rare form of CDG syndrome characterized clinically in the single reported case to date by moderate mental retardation with slow and inarticulate speech, truncal ataxia, and mild hypotonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type IIi</oboInOwl:hasExactSynonym>

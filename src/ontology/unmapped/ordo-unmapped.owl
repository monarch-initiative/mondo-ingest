    <!-- http://www.orpha.net/ORDO/Orphanet_1682 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1682">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_496924"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare association syndrome, reported in several members of two families to date, characterized by arterial dissection, occurring at an early age and presenting with a range of manifestations depending on the vascular territory involved (ex. headache, dysphasia, hemiparesis), in association with cystic medial necrosis and multiple lentigines (brown and black in color and mainly affecting the skin of the trunk and extremities).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Arterial dissection-lentiginosis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Arterial dissection-lentiginosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:I72.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:BD50.Z</skos:broadMatch>
        <skos:exactMatch>MONDO:0010889</skos:exactMatch>
        <skos:exactMatch>OMIM:600459</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304024</skos:exactMatch>
    </owl:Class>

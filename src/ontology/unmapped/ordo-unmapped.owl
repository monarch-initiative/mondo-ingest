    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_620146 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_620146">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_620096"/>
        <obo:IAO_0000115 xml:lang="en">A form of non-syndromic unisutural craniosynostosis characterized by premature fusion of one of the two squamosal sutures. Most cases of isolated unilateral squamosal craniosynostosis are normocephalic. The risk of increased intracranial pressure is low.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated unisquamosal craniosynostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-syndromic unilateral squamosal suture synostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Non-syndromic unisquamosal craniosynostosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-syndromic unisquamosal craniosynostosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q75.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB70.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0850076</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680400</skos:exactMatch>
    </owl:Class>

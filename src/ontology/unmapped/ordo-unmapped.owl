        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_329319 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329319">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_248401"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294955"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_404560 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_404560">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140162"/>

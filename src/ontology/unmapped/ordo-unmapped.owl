        <obo:IAO_0000115 xml:lang="en">A rare, genetic malformation syndrome characterized by congenital anomalies (microcephaly, specific facial characteristics, and broad thumbs and halluces), short stature, intellectual disability and behavioral characteristics.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Broad thumb-hallux syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Broad thumbs-halluces syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rubinstein-Taybi syndrome</oboInOwl:hasExactSynonym>

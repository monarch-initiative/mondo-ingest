    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_238763">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_525677"/>

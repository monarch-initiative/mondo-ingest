        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_168577 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168577">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98365"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hemolytic anemia characterized by combination of neurologic features, such as psychomotor delay, seizures, variable movement disorders, and hemolytic anemia with stomatocytosis, resulting in cation-leaky erythrocytes, pseudohyperkalemia, hemolytic crises and hepatosplenomegaly. Cataracts are also a presenting feature.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CHC type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary cryohydrocytosis type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary cryohydrocytosis with reduced stomatin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stomatin-deficient cryohydrocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sdCHC</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary cryohydrocytosis with reduced stomatin</rdfs:label>
        <skos:broadMatch>ICD-10:D58.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012143</skos:exactMatch>
        <skos:exactMatch>OMIM:608885</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190707</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_168577"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hereditary cryohydrocytosis with reduced stomatin</owl:annotatedTarget>

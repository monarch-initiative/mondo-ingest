                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/28648"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare overgrowth syndrome characterized by polyhydramnios, pre- and postnatal macrosomia, muscular hypotonia, renal anomalies, organomegaly, abdominal distension, cryptorchidism, typical facial dysmorphism, neurodevelopmental delay and high neonatal mortality. Individuals surviving infancy show a high risk of developing Wilms tumor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Nephroblastomatosis-fetal ascites-macrosomia-Wilms tumor syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Perlman syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Perlman syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009965</skos:exactMatch>
        <skos:exactMatch>MeSH:C536399</skos:exactMatch>
        <skos:exactMatch>MedDRA:10088870</skos:exactMatch>
        <skos:exactMatch>OMIM:267000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796113</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

    <!-- http://www.orpha.net/ORDO/Orphanet_404448 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_404448">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurodevelopmental disorder characterized by intellectual disability (ID), autistic features, gastrointestinal problems, hypotonia, delayed speech, behavioral and sleep problems, pain insensitivity, seizures, structural brain anomalies, dysmorphic features, and visual problems.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ADNP syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ADNP-related Helsmoortel-Van der Aa syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ADNP-related syndromic intellectual disability-autism spectrum disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HVDAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Helsmoortel-Van der Aa syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Helsmoortel-Van der Aa syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0014379</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083856</skos:exactMatch>
        <skos:exactMatch>OMIM:615873</skos:exactMatch>
        <skos:exactMatch>UMLS:C4014538</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

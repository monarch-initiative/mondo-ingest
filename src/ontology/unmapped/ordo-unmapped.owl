    <!-- http://www.orpha.net/ORDO/Orphanet_1573 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1573">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

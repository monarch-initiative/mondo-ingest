    <!-- http://www.orpha.net/ORDO/Orphanet_93930 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93930">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_322"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A subtype of exstrophy-epispadias complex (EEC) characterized by an open bladder plate, epispadias and an anterior defect of the pelvis, pelvic floor and the abdominal wall.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Classic bladder exstrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic exstrophy of the bladder</oboInOwl:hasExactSynonym>
        <rdfs:label>Classic bladder exstrophy</rdfs:label>
        <skos:broadMatch>OMIM:600057</skos:broadMatch>

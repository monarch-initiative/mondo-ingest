        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare infantile epilepsy syndrome characterized by early onset of seizures of variable type and severity, potentially associated with a spectrum of clinical signs and symptoms including delay or lack of psychomotor development, intellectual disability, poor or absent speech development, behavioral abnormalities, hypotonia, movement disorders, spasticity, microcephaly, and dysmorphic facial features, among others. Brain imaging findings are also variable and may include cerebral atrophy or white matter abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-specific EOEE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Non-specific early-onset epileptic encephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Undetermined EOEE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Undetermined early-onset epileptic encephalopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-specific early-onset epileptic encephalopathy</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_96175 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96175">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363203"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal anomaly characterized by variable clinical features, including early growth retardation and short stature, microcephaly, developmental delay, some degree of intellectual disability, facial dysmorphism and café-au-lait spots. In some cases, congenital heart disease and endocrine abnormalities have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">RC11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ring 11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ring chromosome 11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ring chromosome 11 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">r(11) syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ring chromosome 11 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD7Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019906</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265444</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96175"/>

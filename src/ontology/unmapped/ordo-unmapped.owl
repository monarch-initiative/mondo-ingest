    <!-- http://www.orpha.net/ORDO/Orphanet_99965 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99965">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98506"/>
        <obo:IAO_0000115 xml:lang="en">A rare acquired motor neuron disease characterized by an initial unilateral weakness in the intrinsic hand muscles that eventually spreads to the opposite limb (with an asymmetrical distribution) and that has a very slow progression of muscular atrophy over a 20 year period.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>O&apos;Sullivan-McLeod syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>O&apos;Sullivan-McLeod syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G12.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0020559</skos:exactMatch>
        <skos:exactMatch>MedDRA:10069682</skos:exactMatch>
        <skos:exactMatch>UMLS:C2721741</skos:exactMatch>
    </owl:Class>

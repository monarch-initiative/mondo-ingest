        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant lateral temporal lobe epilepsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EAF</oboInOwl:hasExactSynonym>

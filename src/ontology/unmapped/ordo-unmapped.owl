        <oboInOwl:hasExactSynonym xml:lang="en">Palmoplantar hyperkeratosis-periodontopathia-onychogryposis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Palmoplantar keratoderma-periodontopathia-onychogryposis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Haim-Munk syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.Y</skos:broadMatch>

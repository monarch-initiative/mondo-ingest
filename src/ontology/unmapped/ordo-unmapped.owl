    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_280 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166469"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180779"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_261884"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98642"/>
        <obo:IAO_0000115 xml:lang="en">A developmental disorder characterized by typical craniofacial features, prenatal and postnatal growth impairment, intellectual disability, severe delayed psychomotor development, seizures, and hypotonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">4p- syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal deletion 4p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal monosomy 4p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Telomeric deletion 4p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wolf-Hirschhorn syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Wolf-Hirschhorn syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.41</skos:broadMatch>
        <skos:exactMatch>MONDO:0008684</skos:exactMatch>
        <skos:exactMatch>MeSH:D054877</skos:exactMatch>
        <skos:exactMatch>MedDRA:10050361</skos:exactMatch>
        <skos:exactMatch>OMIM:194190</skos:exactMatch>
        <skos:exactMatch>UMLS:C1956097</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_280"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Wolf-Hirschhorn syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2800 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2800">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98063"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3430"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare skin tumor characterized by predominantly intraepithelial growth of an adenocarcinoma which may either arise primarily in the skin (primary extramammary Paget disease) or result from intraepithelial spread of a visceral carcinoma (secondary extramammary Paget disease). The lesion is typically located in the anogenital region, presenting as a scaly, oozing, pruritic or painful erythematous plaque often resembling eczema. It may exhibit an invasive component with a significant risk of lymph node metastasis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Extramammary Paget disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Extramammary Paget disease</rdfs:label>
        <skos:broadMatch>ICD-10:C44.5</skos:broadMatch>
        <skos:exactMatch>ICD-11:2E64.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0008177</skos:exactMatch>
        <skos:exactMatch>MeSH:D010145</skos:exactMatch>
        <skos:exactMatch>MedDRA:10068223</skos:exactMatch>
        <skos:exactMatch>OMIM:167300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0030186</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2800"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Extramammary Paget disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_280062 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280062">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182222"/>

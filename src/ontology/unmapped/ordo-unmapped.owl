        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_86864"/>
        <obo:IAO_0000115 xml:lang="en">A type of HCD characterized by the production of incomplete monoclonal gamma-heavy chains without associated light chains. The clinical presentation most commonly resembles that of patients with systemic lymphoproliferative/autoimmune diseases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Franklin disease</oboInOwl:hasExactSynonym>

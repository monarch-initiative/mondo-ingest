        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716459"/>
        <obo:IAO_0000115 xml:lang="en">A rare ophthalmic disorder characterized by 3 stages: vasculitis, occlusion, and retinal neovascularization, leading to recurrent vitreous hemorrhages and vision loss.</obo:IAO_0000115>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3054"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Dentinogenesis imperfecta type 2 (DGI-2) is a rare, severe form of dentinogenesis imperfecta (DGI) and is characterized by weakness and discoloration of all teeth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Capdepont teeth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DGI-2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DI-2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dentinogenesis imperfecta type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dentinogenesis imperfecta, Shields type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Dentinogenesis imperfecta type 2</rdfs:label>
        <skos:broadMatch>ICD-10:K00.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA30.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0007441</skos:exactMatch>
        <skos:exactMatch>OMIM:125490</skos:exactMatch>
        <skos:exactMatch>UMLS:C2973527</skos:exactMatch>
        <skos:narrowMatch>OMIM:605594</skos:narrowMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_331226 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_331226">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_319539"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12440"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare primary immunodeficiency characterized by increased susceptibility to intracellular bacterial and viral infection, with or without increased serum IgE. Clinical manifestations are highly variable, depending on the infection type and location, and can include recurrent otitis, sinusitis, pulmonary and cutaneous infections, meningitis and internal abscesses.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Susceptibility to infection due to TYK2 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Susceptibility to infection due to TYK2 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D82.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0012682</skos:exactMatch>
        <skos:exactMatch>MeSH:C566928</skos:exactMatch>
        <skos:exactMatch>OMIM:611521</skos:exactMatch>
        <skos:exactMatch>UMLS:C1969086</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_331226"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Susceptibility to infection due to TYK2 deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



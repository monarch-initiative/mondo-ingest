    <!-- http://www.orpha.net/ORDO/Orphanet_319276 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319276">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217071"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare renal tumor arising from proximal tubular epithelial cells of the renal cortex, characterized histologically by malignant epithelial cells with typical clear cytoplasm in conventional staining methods due to a high glycogen and lipid content, featuring a nested growth pattern. Clinically it may present with hematuria, flank pain, anemia or, less commonly, a palpable abdominal mass.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CCRCC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Clear cell renal carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Clear cell renal cell adenocarcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Clear cell renal cell carcinoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Clear cell renal carcinoma</rdfs:label>
        <skos:broadMatch>ICD-10:C64</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C90.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH46F1</skos:exactMatch>
        <skos:exactMatch>MONDO:0005005</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073251</skos:exactMatch>
        <skos:exactMatch>UMLS:C0279702</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_319276"/>

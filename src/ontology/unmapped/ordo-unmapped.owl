        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, non-syndromic urogenital tract malformation characterized by the absence of a vagina or the presence of a vaginal dimple shorter than 5 cm. It is often associated with uterine agenesis, hematocolpos or primary amenorrhea and dyspareunia. Ovaries and fallopian tubes are normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital absence of vagina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated partial vaginal agenesis</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated partial vaginal agenesis</rdfs:label>

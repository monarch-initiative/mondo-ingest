    <!-- http://www.orpha.net/ORDO/Orphanet_300313 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300313">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309839"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_178389 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_178389">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101977"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2781"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_728475"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11908"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Osteopetrosis-hypogammaglobulinemia syndrome is an extremely rare primary bone dysplasia with increased bone density disorder characterized by severe osteoclast-poor osteopetrosis associated with hypogammaglobulinemia. Patients typically present infantile malignant osteopetrosis (manifesting with increased bone density, bone fractures, abnormal eye movements/visual loss, nystagmus), hematologic abnormalities with bone marrow failure (e.g. anemia, hepatosplenomegaly) and immunological deficiency (manifesting as recurrent respiratory infections) associated with reduced immunoglobulin levels due to impaired peripheral B cell differentiation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive osteoclast-poor osteopetrosis with hypogammaglobulinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive osteopetrosis type 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteopetrosis-hypogammaglobulinemia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteopetrosis-hypogammaglobulinemia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012859</skos:exactMatch>
        <skos:exactMatch>OMIM:612301</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751205</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_178389"/>

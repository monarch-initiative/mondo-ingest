        <oboInOwl:hasExactSynonym xml:lang="en">T-B+K- severe combined immunodeficiency, X-linked</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">T-B+NK- SCID due to gamma chain deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T-B+NK- severe combined immunodeficiency due to gamma chain deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>T-B+NK- severe combined immunodeficiency due to gamma chain deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D81.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0010315</skos:exactMatch>

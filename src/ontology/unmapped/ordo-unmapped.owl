                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9588"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by abnormal development and enlargement of the cerebellum, and an increased intracranial pressure. The tumors can be characterized by the abnormal growth of ganglion cells that regulate activities in the cerebellum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dysplastic gangliocytoma of the cerebellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LDD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lhermitte-Duclos disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Lhermitte-Duclos disease</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.21</skos:broadMatch>
        <skos:broadMatch>OMIM:158350</skos:broadMatch>

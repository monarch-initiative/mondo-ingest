        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93546"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital genitourinary anomaly, encompassing a wide spectrum of anatomic variants in which the urethra is partially or totally duplicated, which may be asymptomatic or cause symptoms such as incontinence, recurrent urinary infections and difficulty urinating.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Duplication of urethra</oboInOwl:hasExactSynonym>
        <rdfs:label>Duplication of urethra</rdfs:label>
        <skos:broadMatch>ICD-10:Q64.7</skos:broadMatch>

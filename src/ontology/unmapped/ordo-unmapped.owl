    <!-- http://www.orpha.net/ORDO/Orphanet_3466 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3466">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

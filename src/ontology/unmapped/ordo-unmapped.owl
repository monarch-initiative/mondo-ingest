            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Juvenile Huntington disease (JHD) is a form of Huntington disease (HD), characterized by onset of signs and symptoms before 20 years of age.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">JHD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile Huntington chorea</oboInOwl:hasExactSynonym>

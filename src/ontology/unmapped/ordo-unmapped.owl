    <!-- http://www.orpha.net/ORDO/Orphanet_456298 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_456298">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139021"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_261857"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly characterized by an intrauterine and postnatal growth retardation, short stature, developmental delay, learning difficulties, hearing loss, hypermetropia, and a recognisable facial dysmorphism including prominent forehead, long, myopathic facies, fine eyebrows, small mouth and micrognathia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>1p35.2 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(1)(p35.2)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Deletion 1p35.2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 1p35.2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(1)(p35.2)</oboInOwl:hasExactSynonym>
        <rdfs:label>1p35.2 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0018697</skos:exactMatch>
        <skos:exactMatch>OMIM:617930</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679992</skos:exactMatch>

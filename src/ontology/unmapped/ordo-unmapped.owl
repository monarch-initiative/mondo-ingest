    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2139 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2139">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by global developmental delay, mild intellectual disability, seizures, obesity, and dysmorphic facial features (including large, bulbous nose, prominent philtrum, wide mouth). Additional reported features are bilateral pes planus, scoliosis, and spina bifida occulta. Brain MRI may show mild ventricular dilatation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hernández-Aguirre Negrete syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intellectual disability-epilepsy-bulbous nose syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hernández-Aguirre Negrete syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0016290</skos:exactMatch>
        <skos:exactMatch>MeSH:C538112</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931736</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2139"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hernández-Aguirre Negrete syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_214 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_214">

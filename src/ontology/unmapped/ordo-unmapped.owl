    <!-- http://www.orpha.net/ORDO/Orphanet_96102 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96102">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262914"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

        <oboInOwl:hasExactSynonym>Cushing syndrome due to bilateral macronodular adrenocortical disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cushing syndrome due to macronodular adrenal hyperplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cushing syndrome due to primary bilateral macronodular adrenal hyperplasia</oboInOwl:hasExactSynonym>

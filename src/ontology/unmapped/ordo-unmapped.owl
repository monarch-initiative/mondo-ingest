    <!-- http://www.orpha.net/ORDO/Orphanet_264675 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_264675">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100049"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_674896"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2435"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2436"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, interstitial lung disease due to mutations in the CSF2R (colony-stimulating factor 2 receptor) alpha or beta subunits and characterized by alveolar accumulation of pulmonary surfactant, presenting a highly variable clinical presentation, ranging from asymptomatic to severe respiratory failure. Characteristic lung biopsy findings include periodic acid-Schiff-positive, granular eosinophilic material, enlarged foamy alveolar macrophages, and well-preserved alveolar walls. The Granulocyte-macrophage colony-stimulating factor (GM-CSF) receptor function is impaired but GM-CSF receptor autoantibodies are absent.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital PAP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital pulmonary alveolar proteinosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary pulmonary alveolar proteinosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary pulmonary alveolar proteinosis</rdfs:label>
        <skos:broadMatch>ICD-10:J84.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:CB04.31</skos:broadMatch>
        <skos:exactMatch>MONDO:0012580</skos:exactMatch>
        <skos:exactMatch>MeSH:C535832</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931035</skos:exactMatch>
        <skos:narrowMatch>OMIM:300770</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614370</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_264675"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hereditary pulmonary alveolar proteinosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

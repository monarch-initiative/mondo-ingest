    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_75501">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C052"/>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: EDS X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Ehlers-Danlos syndrome type 10</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Ehlers-Danlos syndrome with platelet dysfunction from fibronectin abnormality</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Ehlers-Danlos syndrome, fibronectin-deficient</oboInOwl:hasExactSynonym>
        <rdfs:label>OBSOLETE: Ehlers-Danlos syndrome, fibronectinemic type</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_75508 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_75508">

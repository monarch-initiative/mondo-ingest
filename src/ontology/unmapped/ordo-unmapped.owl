    <!-- http://www.orpha.net/ORDO/Orphanet_118 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_118">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207018"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217581"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79215"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93448"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6831"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Beta-mannosidosis is a very rare lysosomal storage disease characterized by developmental delay of varying severity and hearing loss, but that can manifest a wide phenotypic heterogeneity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Beta-mannosidase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Beta-mannosidosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Beta-mannosidosis</rdfs:label>
        <skos:broadMatch>ICD-10:E77.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.21</skos:broadMatch>
        <skos:exactMatch>MONDO:0009562</skos:exactMatch>
        <skos:exactMatch>MeSH:D044905</skos:exactMatch>
        <skos:exactMatch>OMIM:248510</skos:exactMatch>
        <skos:exactMatch>UMLS:C4048196</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_118"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

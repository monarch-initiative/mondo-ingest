    <!-- http://www.orpha.net/ORDO/Orphanet_91135 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91135">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_228215"/>

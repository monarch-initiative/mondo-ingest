    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247257 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247257">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Inhalational anthrax is a rare acute systemic infection caused by the inhalation of &lt;i&gt;Bacillus anthracis&lt;/i&gt; spores (e.g. through infected animal products, bioterrorism) and characterized by an initial stage where patients present with non specific symptoms (fever, cough, chills, fatigue) that is followed by an acute phase during which hemorrhagic mediastinitis occurs that can progress into meningitis, gastrointestinal involvement, and refractory shock, that can be fatal, if left untreated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Inhalation anthrax disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inhalational anthrax</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pulmonary anthrax</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Respiratory anthrax</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Respiratory anthrax disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Inhalational anthrax</rdfs:label>
        <skos:broadMatch>ICD-10:A22.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:1B97</skos:broadMatch>
        <skos:exactMatch>MONDO:0016595</skos:exactMatch>
        <skos:exactMatch>MeSH:C571912</skos:exactMatch>
        <skos:exactMatch>MedDRA:10035667</skos:exactMatch>
        <skos:exactMatch>UMLS:C0155866</skos:exactMatch>
    </owl:Class>

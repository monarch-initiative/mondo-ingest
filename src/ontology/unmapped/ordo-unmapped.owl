    <!-- http://www.orpha.net/ORDO/Orphanet_252183 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_252183">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_252131"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare benign peripheral nerve sheath tumor characterized by a well-demarcated intraneural or diffusely infiltrative extraneural space-occupying lesion consisting of Schwann cells, perineurial-like cells, and fibroblasts. It presents as a cutaneous nodule, a circumscribed mass in a peripheral nerve, a plexiform enlargement of a major nerve trunk, or with diffuse but localized involvement of skin and subcutaneous tissue. Multiple neurofibromas are typically associated with neurofibromatosis 1. Malignant transformation occurs almost exclusively in plexiform neurofibromas and neurofibromas of major nerves.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neurofibroma</oboInOwl:hasExactSynonym>
        <rdfs:label>Neurofibroma</rdfs:label>
        <skos:broadMatch>ICD-10:D36.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F3Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016755</skos:exactMatch>
        <skos:exactMatch>MeSH:D009455</skos:exactMatch>
        <skos:exactMatch>MedDRA:10029267</skos:exactMatch>
        <skos:exactMatch>UMLS:C0027830</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

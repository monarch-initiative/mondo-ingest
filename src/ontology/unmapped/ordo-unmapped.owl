    <!-- http://www.orpha.net/ORDO/Orphanet_309294 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_309294">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716405"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79215"/>
        <obo:IAO_0000115 xml:lang="en">Sialidosis is a lysosomal storage disease, belonging to the group of oligosaccharidoses or glycoproteinoses, with a wide clinical spectrum that is divided into two main clinical subtypes: sialidosis type I, the milder, non dysmorphic form of the disease characterized by gait abnormalities, progressive visual loss, bilateral macular cherry red spots and myoclonus, that presents in adolescence or adulthood (second or third decade of life); and sialidosis type II the more severe, early onset form, characterized by a progressive and severe mucopolysaccharidosis-like phenotype with coarse facies, visceromegaly, dysostosis multiplex, and developmental delay. Bilateral macular cherry red spots are also present. Sialidosis type II has been further divided into congenital (with hydrops fetalis), infantile and juvenile presentations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Sialidosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Sialidosis</rdfs:label>
        <skos:broadMatch>ICD-11:5C56.21</skos:broadMatch>
        <skos:exactMatch>MONDO:0017734</skos:exactMatch>
        <skos:exactMatch>MONDO:17734</skos:exactMatch>
        <skos:exactMatch>MedDRA:10058800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268226</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_309294"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

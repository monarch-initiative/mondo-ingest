    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_439897">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1037"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156162"/>

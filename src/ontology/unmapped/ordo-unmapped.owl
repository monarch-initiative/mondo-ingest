    <!-- http://www.orpha.net/ORDO/Orphanet_91385 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91385">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_658"/>
        <obo:IAO_0000115 xml:lang="en">A rare disease characterized by the occurrence of transitory and recurrent subcutaneous and/or submucosal edemas resulting in swelling and/or abdominal pain due to an acquired C1 inhibitor (C1-INH) deficiency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AAE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired C1 inhibitor deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acquired angioedema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired angioneurotic edema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired bradykinine-induced angioedema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired non histamine-induced angioedema</oboInOwl:hasExactSynonym>
        <rdfs:label>Acquired angioedema</rdfs:label>
        <skos:exactMatch>ICD-11:4A00.15</skos:exactMatch>
        <skos:exactMatch>MONDO:0019624</skos:exactMatch>
        <skos:exactMatch>MeSH:C538173</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081035</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931758</skos:exactMatch>
        <skos:narrowMatch>OMIM:300909</skos:narrowMatch>
    </owl:Class>

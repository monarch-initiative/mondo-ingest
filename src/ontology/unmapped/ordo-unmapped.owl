    <!-- http://www.orpha.net/ORDO/Orphanet_2031 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2031">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101939"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156604"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93587"/>
        <obo:IAO_0000115 xml:lang="en">Hepatic fibrosis-renal cysts-intellectual disability syndrome is a rare, syndromic intellectual disability characterized by early developmental delay with failure to thrive, intellectual disability, congenital hepatic fibrosis, renal cystic dysplasia, and dysmorphic facial features (bilateral ptosis, anteverted nostrils, high arched palate, and micrognathia). Variable additional features have been reported, including cerebellar anomalies, postaxial polydactyly, syndactyly, genital anomalies, tachypnea. There have been no further descriptions in the literature since 1987.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hepatic fibrosis-renal cysts-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Thompson-Baraitser syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hepatic fibrosis-renal cysts-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008941</skos:exactMatch>
        <skos:exactMatch>MeSH:C536515</skos:exactMatch>
        <skos:exactMatch>OMIM:213010</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931226</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2031"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hepatic fibrosis-renal cysts-intellectual disability syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2032 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2032">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98300"/>
        <obo:IAO_0000115 xml:lang="en">An interstitial lung disease with a poor prognosis, that is characterized by the progressive formation of scar tissue within the lungs in the absence of any known cause.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">IPF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Idiopathic pulmonary fibrosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic pulmonary fibrosis</rdfs:label>
        <skos:broadMatch>ICD-10:J84.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:CB03.4</skos:exactMatch>
        <skos:exactMatch>MONDO:800504</skos:exactMatch>
        <skos:exactMatch>MeSH:D054990</skos:exactMatch>
        <skos:exactMatch>MedDRA:10021240</skos:exactMatch>

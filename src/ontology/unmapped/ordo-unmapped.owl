    <!-- http://www.orpha.net/ORDO/Orphanet_363478 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363478">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363472"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, locally invasive or malignant, urogenital tumor characterized by a gland-forming epithelial neoplasm arising from paratesticular structures, typically manifesting with a palpable scrotal mass, with or without hydrocele, and/or testicular pain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adenocarcinoma of the paratestis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Paratesticular adenocarcinoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Paratesticular adenocarcinoma</rdfs:label>
        <skos:exactMatch>MONDO:0018192</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190800</skos:exactMatch>
        <skos:narrowMatch>ICD-10:C63.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C63.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C63.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C63.7</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C63.8</skos:narrowMatch>
    </owl:Class>

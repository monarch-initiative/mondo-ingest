        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Camptodactyly syndrome, Guadalajara type 1 is a rare syndrome consisting of growth retardation, facial dysmorphism, camptodactyly and skeletal anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Camptodactyly syndrome, Guadalajara type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Camptodactyly syndrome, Guadalajara type 1</rdfs:label>

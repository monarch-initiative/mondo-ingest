                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8607"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare parkinsonian disorder characterized by an age of onset between 21-45 years, rigidity, painful cramps followed by tremor, bradykinesia, dystonia, gait complaints and falls, and other non-motor symptoms. A slow disease progression and a more pronounced response to dopaminergic therapy are also observed in most forms of this disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset Parkinson disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">YOPD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Young-onset Parkinson disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Young-onset Parkinson disease</rdfs:label>
        <skos:broadMatch>ICD-10:G20</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A00.00</skos:broadMatch>

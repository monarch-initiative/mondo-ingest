    <!-- http://www.orpha.net/ORDO/Orphanet_319229 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319229">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_341"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Bolivian hemorrhagic fever (BHF), caused by the Machupo virus (MACV), is a severe acute viral hemorrhagic fever characterized by fever, myalgia, and arthralgia followed by hemorrhagic and neurological manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bolivian hemorrhagic fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Machupo hemorrhagic fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Bolivian hemorrhagic fever</rdfs:label>
        <skos:exactMatch>ICD-10:A96.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:1D61.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0017875</skos:exactMatch>
        <skos:exactMatch>MedDRA:10005932</skos:exactMatch>
        <skos:exactMatch>UMLS:C0282192</skos:exactMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35807"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare malignant germ cell tumor of ovary characterized by a solid, lobulated mass, usually with a diameter of more than 10 cm, generally occurring in children or young women who present with abdominal pain or an abdominal mass and elevated serum LDH. It is bilateral in about 20% of cases, although the contralateral tumor may not be evident on macroscopic examination. Histopathologically, tumor cells are uniform rounded primitive germ cells with clear cytoplasm and macronucleoli, arranged in nests or cords separated by thin fibrous septa containing lymphocytes. Immunohistochemistry should be positive for OCT4 or SALL4, KIT (CD117), and/or D2-40.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dysgerminoma of ovary</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dysgerminomatous germ cell cancer of the ovary</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ovarian dysgerminoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Ovarian dysgerminoma</rdfs:label>
        <skos:broadMatch>ICD-10:C56</skos:broadMatch>
        <skos:exactMatch>ICD-11:2C73.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0020538</skos:exactMatch>
        <skos:exactMatch>UMLS:C0346185</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_99912"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ovarian dysgerminoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



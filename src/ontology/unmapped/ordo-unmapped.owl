                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Craniosynostosis - anal anomalies - porokeratosis, or CDAGS, is a very rare condition characterized by craniosynostosis and clavicular hypoplasia, (C), delayed closure of the fontanel (D), anal anomalies (A), genitourinary malformations (G) and skin eruption (S).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CAP syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDAGS syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Craniosynostosis-anal anomalies-porokeratosis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Craniosynostosis-anal anomalies-porokeratosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011287</skos:exactMatch>
        <skos:exactMatch>MeSH:C536789</skos:exactMatch>
        <skos:exactMatch>OMIM:603116</skos:exactMatch>
        <skos:exactMatch>UMLS:C1864186</skos:exactMatch>
    </owl:Class>

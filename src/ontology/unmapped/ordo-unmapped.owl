    <!-- http://www.orpha.net/ORDO/Orphanet_686468 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_686468">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98006"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by persistent side effects of terminated 5-alpha-reductase inhibitor treatment, including impaired sexual function (low libido, erectile dysfunction, diminished semen volume and force), genital numbness or paresthesia, gynecomastia, depression, brain fog and elevated anxiety. Additional symptoms may include muscular problems (tics, muscle spasms, tremors, involuntary muscle contraction and muscular ache), joint pain, chronic fatigue, migraine, decreased body temperature and dry skin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Post 5-alpha-reductase inhibitors treatment syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Post 5-alpha-reductase inhibitors treatment syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:F52.8</skos:broadMatch>
        <skos:exactMatch>MONDO:975897</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_686468"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Post 5-alpha-reductase inhibitors treatment syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_686475 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_686475">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98006"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by persistent side effects of depression treatment with selective serotonin reuptake inhibitors (SSRIs) manifests as a range of sexual and reproductive dysfunctions. Commonly experienced clinical signs in (male) patients include the triad of genital anesthesia, decreased or lost libido, and erectile dysfunction, as well as weak or pleasureless orgasm, premature ejaculation, reduced penile size, decreased seminal volume, and testicular atrophy or pain. In female patients, additional manifestations may include vaginal lubrication difficulties, irregular menstruation, and nipple insensitivity. These symptoms may begin days or weeks after initiation of treatment and can persist even after the medication is discontinued, significantly impacting quality of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PSSD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Post-SSRI sexual dysfunction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Post-selective serotonin reuptake inhibitor sexual dysfunction</oboInOwl:hasExactSynonym>
        <rdfs:label>Post-selective serotonin reuptake inhibitor sexual dysfunction</rdfs:label>
        <skos:broadMatch>ICD-10:F52.8</skos:broadMatch>
        <skos:exactMatch>MONDO:975898</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_686475"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Post-selective serotonin reuptake inhibitor sexual dysfunction</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



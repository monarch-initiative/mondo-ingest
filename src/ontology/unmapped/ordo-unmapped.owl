        <obo:IAO_0000115 xml:lang="en">Charcot-Marie-Tooth disease type 1 (CMT1) is a group of autosomal dominant demyelinating peripheral neuropathies characterized by distal weakness and atrophy, sensory loss, foot deformities, and slow nerve conduction velocity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant demyelinating Charcot-Marie-Tooth disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CMT1</oboInOwl:hasExactSynonym>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A congenital respiratory tract anomaly characterized by a cleft extending below the vocal folds into the cricoid cartilage, with swallowing disorders and lung infections.</obo:IAO_0000115>

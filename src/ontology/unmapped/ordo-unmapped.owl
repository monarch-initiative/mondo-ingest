        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Neonatal severe primary hyperparathyroidism (NSHPT) is characterized by severe hypercalcemia (&gt; 3.5 mM) from birth and associated with major hyperparathyroidism.</obo:IAO_0000115>

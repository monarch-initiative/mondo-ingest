        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98153"/>
        <obo:IAO_0000115 xml:lang="en">Maternal uniparental disomy of chromosome 2 is an uniparental disomy of maternal origin that most likely does not have any phenotypic expression except from cases of homozygosity for a recessive disease mutation for which only mother is a carrier.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Maternal uniparental disomy of chromosome 2 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UPD(2)mat</oboInOwl:hasExactSynonym>
        <rdfs:label>Maternal uniparental disomy of chromosome 2 syndrome</rdfs:label>

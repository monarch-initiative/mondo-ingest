                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6251"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6263"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic cardiac rhythm disease characterized by a short QTc interval on the surface electrocardiogram (ECG) with a high risk of syncope or sudden death due to malignant ventricular arrhythmia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital SQTS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital short QT syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital short QT syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:I49.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:BC65.2</skos:exactMatch>
        <skos:exactMatch>OMIM:609620</skos:exactMatch>
        <skos:exactMatch>UMLS:C2348199</skos:exactMatch>
        <skos:narrowMatch>OMIM:609621</skos:narrowMatch>
        <skos:narrowMatch>OMIM:609622</skos:narrowMatch>
        <skos:narrowMatch>OMIM:620231</skos:narrowMatch>
    </owl:Class>

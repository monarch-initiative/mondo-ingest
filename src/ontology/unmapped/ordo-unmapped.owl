        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Sporadic infantile bilateral necrosis is the sporadic form of infantile bilateral striatal necrosis (IBSN), a syndrome of bilateral symmetric spongy degeneration of the caudate nucleaus, putamen and globus pallidus characterized by developmental regression, choreoathetosis and dystonia progressing to spastic quadriparesis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ABSN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acute bilateral striatal necrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sporadic IBSN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sporadic infantile bilateral striatal necrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sporadic infantile striatonigral degeneration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sporadic infantile striatonigral necrosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Sporadic infantile bilateral striatal necrosis</rdfs:label>
        <skos:broadMatch>ICD-10:G23.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016394</skos:exactMatch>

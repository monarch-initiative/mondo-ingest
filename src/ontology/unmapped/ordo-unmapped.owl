        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1319 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1319">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498451"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Camptobrachydactyly is an extremely rare brachydactyly syndrome, characterized by short broad hands and feet with brachydactyly associated with congenital flexion contractures of the proximal and/or distal interphalangeal joints of the fingers, as well as syndactyly of feet. Polydactyly, septate vagina and urinary incontinence were also occasionally reported. Camptobrachydactyly has been described in 18 members of 1 family, suggesting an autosomal dominant inheritance. There have been no further descriptions in the literature since 1972.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Camptobrachydactyly</oboInOwl:hasExactSynonym>
        <rdfs:label>Camptobrachydactyly</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0007249</skos:exactMatch>
        <skos:exactMatch>MeSH:C537967</skos:exactMatch>
        <skos:exactMatch>OMIM:114150</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861963</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1319"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Camptobrachydactyly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_132 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_132">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79219"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/983"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Butyrylcholinesterase (BChE) deficiency is a metabolic disorder characterised by prolonged apnoea after the use of certain anaesthetic drugs, including the muscle relaxants succinylcholine or mivacurium and other ester local anaesthetics. The duration of the prolonged apnoea varies significantly depending on the extent of the enzyme deficiency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hereditary butyrylcholinesterase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary pseudocholinesterase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary butyrylcholinesterase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E88.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C59.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015270</skos:exactMatch>
        <skos:exactMatch>MeSH:C537417</skos:exactMatch>
        <skos:exactMatch>MedDRA:10062674</skos:exactMatch>
        <skos:exactMatch>OMIM:617936</skos:exactMatch>
        <skos:exactMatch>UMLS:C5880943</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_132"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hereditary butyrylcholinesterase deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1320 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1320">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206638"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Idiopathic camptocormia is a postural disease characterized by an anterior flexion of the torso (during walking or standing) that resolves in the supine position and that is caused by weakness of the lumbar paraspinal muscles (spinal extensors), due to massive fatty infiltrations of posterior spinal muscles, without an identifiable etiology.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Idiopathic camptocormia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic camptocormism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic progressive lumbar kyphosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic camptocormia</rdfs:label>
        <skos:broadMatch>ICD-10:M43.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0015271</skos:exactMatch>
        <skos:exactMatch>MeSH:C537968</skos:exactMatch>
        <skos:exactMatch>MedDRA:10069646</skos:exactMatch>
        <skos:exactMatch>UMLS:C0264162</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_136 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_136">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_477754"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716459"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717348"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98549"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7883"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">CADASIL (Cerebral Autosomal Dominant Arteriopathy with Subcortical Infarcts and Leukoencephalopathy) is a hereditary cerebrovascular disorder characterized by mid-adult onset of recurrent subcortical ischemic stroke and cognitive impairment progressing to dementia in addition to migraines with aura and mood disturbances seen in about a third of patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CADASIL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cerebral autosomal dominant arteriopathy-subcortical infarcts-leukoencephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary multi-infarct dementia</oboInOwl:hasExactSynonym>
        <rdfs:label>CADASIL</rdfs:label>
        <skos:broadMatch>ICD-10:I67.8</skos:broadMatch>
        <skos:broadMatch>OMIM:125310</skos:broadMatch>
        <skos:exactMatch>ICD-11:8B22.C0</skos:exactMatch>
        <skos:exactMatch>MONDO:0000914</skos:exactMatch>
        <skos:exactMatch>MeSH:D046589</skos:exactMatch>
        <skos:exactMatch>MedDRA:10065551</skos:exactMatch>
        <skos:exactMatch>UMLS:C0751587</skos:exactMatch>
    </owl:Class>

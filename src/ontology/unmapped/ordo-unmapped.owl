            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/888"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary sensory and autonomic neuropathy characterized by profound and universal sensory loss involving large and small fiber nerves.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive sensory radicular neuropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HSAN2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary sensory and autonomic neuropathy type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary sensory and autonomic neuropathy type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurogenic acroosteolysis</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary sensory and autonomic neuropathy type 2</rdfs:label>
        <skos:broadMatch>ICD-10:G60.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C21.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:243000</skos:broadMatch>
        <skos:exactMatch>MONDO:0019941</skos:exactMatch>
        <skos:exactMatch>UMLS:C0020072</skos:exactMatch>

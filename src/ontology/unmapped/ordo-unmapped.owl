            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A very rare primary monoamine neurotransmitter synthesis disorder with norepinephrine and adrenaline deficiency that leads to young-onset severe orthostatic hypotension and eyelid ptosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DBH deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dopamine beta-hydroxylase deficiency</oboInOwl:hasExactSynonym>

        <obo:IAO_0000115 xml:lang="en">A sclerosing disorder of the skeleton characterized by increased bone density that classically displays the radiographic sign of &apos;&apos;sandwich vertebrae&apos;&apos; (dense bands of sclerosis parallel to the vertebral endplates).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Albers-Schönberg osteopetrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteopetrosis autosomal dominant type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Albers-Schönberg osteopetrosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.2</skos:broadMatch>

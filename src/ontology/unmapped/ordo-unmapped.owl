        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome characterized by a combination of distal limb abnormalities (syndactyly of all fingers and toes, preaxial polydactyly in the feet and/or hands) and upper sternum malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ACRP syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acropectoral syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Syndactyly-preaxial polydactyly-sternal deformity syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Acropectoral syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.0</skos:broadMatch>

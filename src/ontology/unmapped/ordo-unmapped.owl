    <!-- http://www.orpha.net/ORDO/Orphanet_206549 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_206549">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102015"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207122"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/27337"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of limb-girdle muscular dystrophy most often characterized by an adult onset (but ranging from 11 to 51 years) of mainly proximal lower limb weakness, with difficulties standing on tiptoes being one of the initial signs. Proximal upper limb and distal lower limb weakness is also common, as well as atrophy of the quadriceps (most commonly), biceps brachii, and lower leg muscles. Calf hypertrophy has also been reported in some cases. LGMD2L progresses slowly, with most patients remaining ambulatory until late adulthood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Anoctamin-5-related LGMD R12</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Anoctamin-5-related limb-girdle muscular dystrophy R12</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive limb-girdle muscular dystrophy type 2L</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD type 2L</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD2L</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Limb-girdle muscular dystrophy type 2L</oboInOwl:hasExactSynonym>
        <rdfs:label>Anoctamin-5-related limb-girdle muscular dystrophy R12</rdfs:label>
        <skos:broadMatch>ICD-10:G71.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0012652</skos:exactMatch>
        <skos:exactMatch>MeSH:C566968</skos:exactMatch>
        <skos:exactMatch>OMIM:611307</skos:exactMatch>
        <skos:exactMatch>UMLS:C1969785</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_206549"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Anoctamin-5-related limb-girdle muscular dystrophy R12</owl:annotatedTarget>

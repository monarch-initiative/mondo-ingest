    <!-- http://www.orpha.net/ORDO/Orphanet_99776 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99776">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98131"/>
        <obo:IAO_0000115 xml:lang="en">Mosaic trisomy 9 is a rare chromosomal anomaly syndrome, with a highly variable phenotype, principally characterized by intellectual disability, growth and developmental delay, facial dysmorphism (incl. microphthalmia, deep-set eyes, low-set, malformed ears, bulbous nose, high-arched palate, micrognathia) and congenital heart defects (e.g. ventricular septal defect), as well as urogenital (e.g. hypoplastic genitalia, cryptorchidism), skeletal (congenital joint dislocations or hyperflexion, scoliosis/kyphosis) and central nervous system anomalies (hydrocephalus, Dandy-Walker malformation). Pigmentary mosaic skin lesions along the lines of Blaschko are also frequently observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mosaic trisomy 9 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mosaic trisomy chromosome 9</oboInOwl:hasExactSynonym>

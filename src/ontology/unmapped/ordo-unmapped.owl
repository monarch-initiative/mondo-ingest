    <!-- http://www.orpha.net/ORDO/Orphanet_1747 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1747">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98131"/>
        <obo:IAO_0000115 xml:lang="en">Mosaic trisomy 7 is a rare chromosomal anomaly syndrome, with a highly variable phenotype, mostly characterized by blaschkolinear skin pigmentary dysplasia, body asymmetry, enamel dysplasia, and developmental and growth delay. Intellectual disability, facial dysmorphism (e.g. frontal bossing, abnormal palpebral fissures, strabismus, abnormally shaped ears, and micrognathia), and genital anomalies (e.g. undescended testes) have also been observed. It has been reported to be associated with maternal uniparental disomy of chromosome 7, resulting in a Silver-Russell syndrome phenotype. Cases with no associated malformations have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mosaic trisomy 7 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mosaic trisomy chromosome 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 7 mosaicism</oboInOwl:hasExactSynonym>
        <rdfs:label>Mosaic trisomy 7 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD40.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015771</skos:exactMatch>
        <skos:exactMatch>MeSH:C537822</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931631</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

    <!-- http://www.orpha.net/ORDO/Orphanet_2430 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2430">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156207"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by muscular hypertrophy, adenoid hyperplasia, or vascular malformation that results in an enlarged, often protruding, tongue. Complications include difficulty in swallowing, breathing and mastication, drooling, dental and skeletal deformities, such as malocclusion, open bite, asymmetry in maxillary and mandibular arches. It may be isolated or associated with genetic syndromes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital macroglossia</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital macroglossia</rdfs:label>
        <skos:broadMatch>ICD-10:Q38.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA31.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0007927</skos:exactMatch>
        <skos:exactMatch>MeSH:C531735</skos:exactMatch>
        <skos:exactMatch>OMIM:153630</skos:exactMatch>
        <skos:exactMatch>UMLS:C0009677</skos:exactMatch>
    </owl:Class>

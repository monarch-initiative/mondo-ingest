            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital chronic diarrhea with protein-losing enteropathy is a rare, genetic, intestinal disease characterized by early-onset, chronic, non-infectious, non-bloody, watery diarrhea associated with protein-losing enteropathy which results in hypoalbuminemia, hypogammaglobulinemia and elevated stool alpha-1-antitrypsin. Patients typically present severe, intractable diarrhea, failure to thrive, recurrent infections and edema.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital chronic diarrhea with exudative enteropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital chronic diarrhea with protein-losing enteropathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital chronic diarrhea with protein-losing enteropathy</rdfs:label>
        <skos:broadMatch>ICD-10:P78.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA96.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:14375</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751003</skos:exactMatch>
        <skos:narrowMatch>OMIM:615863</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618183</skos:narrowMatch>
    </owl:Class>

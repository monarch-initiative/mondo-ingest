    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_576074 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_576074">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101944"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163585"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare infectious disease caused by Middle East respiratory syndrome coronavirus (MERS&amp;#8208;CoV) and characterized by a spectrum of illness, ranging from mild upper respiratory symptoms to rapidly progressive lower respiratory infection/pneumonia potentially leading to acute respiratory distress syndrome (ARDS), multi-system organ failure, and death. Presenting signs and symptoms typically include fever, cough, shortness of breath, chills, dyspnea, myalgia, abdominal pain, nausea, vomiting, and diarrhea.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MERS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Middle East respiratory syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Middle East respiratory syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:B34.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:1D64</skos:exactMatch>
        <skos:exactMatch>MONDO:0100116</skos:exactMatch>
        <skos:exactMatch>MeSH:D065207</skos:exactMatch>
        <skos:exactMatch>MedDRA:10075271</skos:exactMatch>
        <skos:exactMatch>UMLS:C3694279</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_576074"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Middle East respiratory syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation syndrome characterized by ulnar hypoplasia associated with hypoplastic to absent fourth and/or fifth digits, fibular hypoplasia, short stature and facial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Morava-Mehes syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ulnar/fibula ray defect-brachydactyly syndrome</oboInOwl:hasExactSynonym>

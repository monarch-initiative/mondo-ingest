        <oboInOwl:hasExactSynonym xml:lang="en">Hearing loss-onychodystrophy-osteodystrophy-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hearing loss-onychodystrophy-osteodystrophy-intellectual disability-seizures syndrome</oboInOwl:hasExactSynonym>

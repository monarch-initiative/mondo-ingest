    <!-- http://www.orpha.net/ORDO/Orphanet_423470 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_423470">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_577"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/23026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Mucolipidosis type III gamma (ML 3 gamma) is a very rare lysosomal disease, that has most often been observed in the Middle East, characterized by a progressive slowing of the growth rate in early childhood; stiffness and pain in shoulders, hips, and finger joints; a gradual, mild coarsening of facial features; and by a slower progression, milder clinical course and longer life expectancy than that seen in mucolipidosis type II and mucolipidosis type III alpha/beta. Cognitive function is normal or only slightly impaired and retinitis pigmentosa has been reported in a few patients. Many survive into early adulthood, but ultimately succumb to cardiorespiratory insufficiency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ML 3 gamma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ML III gamma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucolipidosis type 3 gamma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mucolipidosis type III gamma</oboInOwl:hasExactSynonym>
        <rdfs:label>Mucolipidosis type III gamma</rdfs:label>
        <skos:broadMatch>ICD-10:E77.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.20</skos:broadMatch>
        <skos:exactMatch>MONDO:0009652</skos:exactMatch>
        <skos:exactMatch>OMIM:252605</skos:exactMatch>
        <skos:exactMatch>UMLS:C1854896</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_423470"/>

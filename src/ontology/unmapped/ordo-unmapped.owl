    <!-- http://www.orpha.net/ORDO/Orphanet_363483 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363483">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363472"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare neoplastic disease characterized by the presence of a testicular tumor composed of several, well-differentiated or immature, tissues derived from one or more of the 3 germinal layers. Patients typically present unilateral (occasionally bilateral) painless testicular swelling or a palpable testicular nodule/mass.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Teratoma of the testis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Testicular teratoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Testicular teratoma</rdfs:label>
        <skos:broadMatch>ICD-10:C62.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C80.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F34</skos:broadMatch>
        <skos:broadMatch>OMIM:273300</skos:broadMatch>
        <skos:exactMatch>MONDO:0018193</skos:exactMatch>
        <skos:exactMatch>MeSH:C562472</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073120</skos:exactMatch>
        <skos:exactMatch>UMLS:C0238451</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_363483"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_612 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_612">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206970"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98738"/>
        <obo:IAO_0000115 xml:lang="en">A muscular channelopathy presenting with a pure myotonia dramatically aggravated by potassium ingestion, with variable cold sensitivity and no episodic weakness. This group includes three forms: myotonia fluctuans, myotonia permanens, and acetazolamide-responsive myotonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">K+-aggravated myotonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">K-aggravated myotonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PAM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Potassium-aggravated myotonia</oboInOwl:hasExactSynonym>
        <rdfs:label>Potassium-aggravated myotonia</rdfs:label>
        <skos:exactMatch>MONDO:0018959</skos:exactMatch>
        <skos:exactMatch>MONDO:18959</skos:exactMatch>
        <skos:exactMatch>MeSH:C538353</skos:exactMatch>
        <skos:exactMatch>OMIM:608390</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931826</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_612"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of arthrogryposis multiplex congenita characterized by congenital immobility of the limbs with fixation of multiple joints and muscle wasting. This condition is secondary to neurogenic muscular atrophy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neurogenic arthrogryposis multiplex congenita</oboInOwl:hasExactSynonym>

        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19182"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial generalized lentiginosis is a rare, inherited, skin hyperpigmentation disorder characterized by widespread lentigines without associated noncutaneous abnormalities. Patients present multiple brown to dark brown, non-elevated macula of 0.2 to 1 cm in diameter, spread over the entire body, sometimes including palms or soles, but never oral mucosa.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial generalized lentiginosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial lentigines profusa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial multiple lentigines syndrome without systemic involvement</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial generalized lentiginosis</rdfs:label>
        <skos:broadMatch>ICD-10:L81.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC23.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0007891</skos:exactMatch>
        <skos:exactMatch>OMIM:151001</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707357</skos:exactMatch>
    </owl:Class>

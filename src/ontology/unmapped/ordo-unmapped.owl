        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Familial platelet disorder with predisposition to hematological cancer</oboInOwl:hasExactSynonym>
        <rdfs:label>OBSOLETE: Hereditary thrombocytopenia-hematological cancer predisposition syndrome</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

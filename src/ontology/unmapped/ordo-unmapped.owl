        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Interventricular communication</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: VSD</oboInOwl:hasExactSynonym>
        <rdfs:label>NON RARE IN EUROPE: Ventricular septal defect</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

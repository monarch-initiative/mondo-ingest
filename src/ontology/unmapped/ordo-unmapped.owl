        <skos:exactMatch>MedDRA:10028095</skos:exactMatch>
        <skos:exactMatch>UMLS:C0026707</skos:exactMatch>
        <skos:narrowMatch>OMIM:252300</skos:narrowMatch>
        <skos:narrowMatch>OMIM:253000</skos:narrowMatch>

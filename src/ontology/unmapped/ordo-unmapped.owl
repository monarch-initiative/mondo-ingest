        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93426"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia disorder characterized by a bell-shaped thorax, disproportionate short stature, pelvic hypoplasia, dislocatable radial heads and elongated distal fibulae. No acetabular spurs nor phalangeal cone-shaped epiphyses are present and osseous manifestations tend to normalize with age. There have been no further descriptions in the literature since 1988.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Rivera-Perez-Salas syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Thoracolimb dysplasia, Rivera type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Thoracomelic dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Thoracomelic dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.BY</skos:broadMatch>

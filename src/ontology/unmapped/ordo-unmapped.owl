    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_927 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_927">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79167"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17996"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of urea cycle metabolism causing a deficit of ammonia detoxification and arginine synthesis, and characterized by hyperammonemia of variable severity. Manifestations range from neonatal presentation of poor feeding, vomiting, lethargy, tachypnea, convulsions and coma to adult-onset headaches, hazy gastrointestinal symptoms, seizures, behavioral/psychiatric problems, confusion and lethargy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hyperammonemia due to N-acetylglutamate synthase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NAGS deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperammonemia due to N-acetylglutamate synthase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.AY</skos:broadMatch>
        <skos:exactMatch>MONDO:0009377</skos:exactMatch>
        <skos:exactMatch>MeSH:C536109</skos:exactMatch>
        <skos:exactMatch>MedDRA:10071092</skos:exactMatch>
        <skos:exactMatch>OMIM:237310</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268543</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_927"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hyperammonemia due to N-acetylglutamate synthase deficiency</owl:annotatedTarget>

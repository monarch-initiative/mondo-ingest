        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98649"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome characterized by facial rash (poikiloderma) associated with short stature due to pre- and postnatal growth delay, sparse scalp hair, sparse or absent eyelashes and/or eyebrows, juvenile cataracts, skeletal abnormalities, radial ray defects, premature aging and cancer susceptibility.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Poikiloderma of Rothmund-Thomson</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RTS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rothmund-Thomson syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Rothmund-Thomson syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2B</skos:broadMatch>
        <skos:exactMatch>MONDO:0010002</skos:exactMatch>
        <skos:exactMatch>MeSH:D011038</skos:exactMatch>
        <skos:exactMatch>UMLS:C0032339</skos:exactMatch>
        <skos:narrowMatch>OMIM:268400</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615789</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618625</skos:narrowMatch>
        <skos:narrowMatch>OMIM:620819</skos:narrowMatch>
    </owl:Class>

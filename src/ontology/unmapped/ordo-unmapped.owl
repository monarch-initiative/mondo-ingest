    <!-- http://www.orpha.net/ORDO/Orphanet_2875 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2875">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_723267"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79375"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98196"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98638"/>
        <obo:IAO_0000115 xml:lang="en">A rare skin disease characterized by the co-occurrence of a widespread vascular nevus (typically nevus flammeus) and a pigmentary nevus, potentially associated with a variety of other cutaneous nevi, and with or without extracutaneous (most commonly central nervous system, ocular, or musculoskeletal) involvement. Several subtypes are distinguished based on phenotypic characteristics.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Phakomatosis pigmentovascularis</oboInOwl:hasExactSynonym>
        <rdfs:label>Phakomatosis pigmentovascularis</rdfs:label>
        <skos:broadMatch>ICD-10:Q85.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2D.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017318</skos:exactMatch>
        <skos:exactMatch>MeSH:C537894</skos:exactMatch>
        <skos:exactMatch>UMLS:C1274879</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2875"/>

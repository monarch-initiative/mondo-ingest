        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">Cochleosaccular degeneration-cataract syndrome is characterised by progressive sensorineural hearing loss due to severe cochleosaccular degeneration and cataract. So far, it has been reported in two families. Transmission is autosomal dominant.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cochleosaccular degeneration-cataract syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cochleosaccular degeneration-cataract syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:H83.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007346</skos:exactMatch>
        <skos:exactMatch>MeSH:C536432</skos:exactMatch>
        <skos:exactMatch>OMIM:120040</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861512</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3233"/>

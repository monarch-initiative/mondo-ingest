            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by complete mirror-imaged arrangement of the internal organs across the left-right axis of the body. Primary ciliary dyskinesia, Kartagener type, is frequently associated. Congenital heart disease are present in 43% of cases, which is less frequent than in patients with heterotaxy. Similarly, extracardiac and vascular anomalies can be associated (e.g. intestinal malrotation, spleen anomalies, absence of retrohepatic inferior vena cava, bilateral superior vena cava), but less frequently that in heterotaxy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Complete situs inversus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Complete situs inversus viscerum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Situs inversus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Situs inversus totalis</oboInOwl:hasExactSynonym>
        <rdfs:label>Situs inversus totalis</rdfs:label>
        <skos:broadMatch>ICD-10:Q89.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA82</skos:exactMatch>
        <skos:exactMatch>MONDO:0010029</skos:exactMatch>
        <skos:exactMatch>MONDO:10029</skos:exactMatch>
        <skos:exactMatch>UMLS:C0037221</skos:exactMatch>
        <skos:narrowMatch>OMIM:619607</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619608</skos:narrowMatch>
    </owl:Class>

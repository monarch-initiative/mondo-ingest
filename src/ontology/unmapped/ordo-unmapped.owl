    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_141136 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_141136">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C044"/>
        <oboInOwl:hasExactSynonym xml:lang="en">First branchial arch syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hemifacial microsomia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Laterofacial microsomia</oboInOwl:hasExactSynonym>

        <oboInOwl:hasExactSynonym xml:lang="en">Galactocerebrosidase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Galactosylceramidase deficiency</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_1023 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1023">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2222"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">Congenital generalized hypertrichosis, Ambras type is an extremely rare type of hypertrichosis lanuginosa congenita, a congenital skin disease, that is characterized by the presence of vellus-type hair on the entire body, especially on the face, ears and shoulders, with the exception of palms, soles, and mucous membranes. Facial and dental anomalies can also be observed, such as triangular, coarse face, bulbous nasal tip, long palpebral fissures, delayed tooth eruption and absence of teeth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ambras syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital generalized hypertrichosis, Ambras type</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital generalized hypertrichosis, Ambras type</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007787</skos:exactMatch>
        <skos:exactMatch>MeSH:C536605</skos:exactMatch>
        <skos:exactMatch>OMIM:145701</skos:exactMatch>
        <skos:exactMatch>UMLS:C1840362</skos:exactMatch>
    </owl:Class>

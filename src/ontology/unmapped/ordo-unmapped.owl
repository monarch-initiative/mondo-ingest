        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29331"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Vici syndrome is a very rare and severe congenital multisystem disorder characterized by the principal features of agenesis of the corpus callosum, cataracts, oculocutaneous hypopigmentation, cardiomyopathy and combined immunodeficiency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Corpus callosum agenesis-cataract-immunodeficiency syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dionisi-Vici-Sabetta-Gambarara syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vici syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Vici syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009452</skos:exactMatch>
        <skos:exactMatch>MeSH:C535566</skos:exactMatch>
        <skos:exactMatch>OMIM:242840</skos:exactMatch>
        <skos:exactMatch>UMLS:C1855772</skos:exactMatch>
    </owl:Class>

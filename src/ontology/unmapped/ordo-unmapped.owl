    <!-- http://www.orpha.net/ORDO/Orphanet_43115 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_43115">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254843"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98497"/>
        <obo:IAO_0000115 xml:lang="en">Congenital trigeminal anesthesia is a rare neuro-ophtalmological disorder characterized by a congenital sensory deficit involving all or some of the sensory components of the trigeminal nerve. Due to corneal anesthesia, it usually presents with recurrent, painless eye infections, painless corneal opacities and/or poorly healing, ulcerated wounds on the facial skin and mucosa (typically the buccal mucosa and/or nasal septum).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital trigeminal anesthesia</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital trigeminal anesthesia</rdfs:label>
        <skos:broadMatch>ICD-10:G50.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0007384</skos:exactMatch>
        <skos:exactMatch>MeSH:C536440</skos:exactMatch>
        <skos:exactMatch>MedDRA:10088099</skos:exactMatch>
        <skos:exactMatch>OMIM:122450</skos:exactMatch>
        <skos:exactMatch>UMLS:C1852541</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_231013"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital trigeminal anesthesia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_231031 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231031">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79385"/>
        <obo:IAO_0000115 xml:lang="en">Erythema palmare hereditarium is a rare, benign, congenital genetic skin disorder characterized by permanent and asymptomatic erythema of the palmar and, less frequently, the solar surfaces. In most cases, it presents with sharply demarcated redness of the thenar and hypothenar eminences, as well as the palmar aspect of the phalanges, with scattered telangiectasia spots that do not cause any discomfort (pain, itching or burning) to the patient.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Erythema palmare hereditarium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lane disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Red palms disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Erythema palmare hereditarium</rdfs:label>
        <skos:broadMatch>ICD-10:L98.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EM0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007570</skos:exactMatch>
        <skos:exactMatch>MeSH:C565041</skos:exactMatch>
        <skos:exactMatch>OMIM:133000</skos:exactMatch>
        <skos:exactMatch>UMLS:C1851502</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

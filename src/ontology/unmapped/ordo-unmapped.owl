    <!-- http://www.orpha.net/ORDO/Orphanet_254361 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_254361">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102015"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209196"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

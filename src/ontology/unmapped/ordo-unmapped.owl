        <obo:IAO_0000115 xml:lang="en">Drug-induced autoimmune hemolytic anemia is a type of autoimmune hemolytic anemia (AIHA) that occurs as a reaction to therapeutic drugs, and can be due to various mechanisms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Drug-induced AIHA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Drug-induced autoimmune hemolytic anemia</oboInOwl:hasExactSynonym>

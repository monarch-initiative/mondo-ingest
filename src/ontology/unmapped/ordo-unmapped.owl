        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4274"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic skin disorder characterized by absence of scalp and body hair and palmoplantar keratoderma, without other hand complications.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant palmoplantar hyperkeratosis and congenital alopecia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autosomal dominant palmoplantar keratoderma and congenital alopecia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PPK-CA, Stevanovic type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Palmoplantar keratoderma and congenital alopecia, Stevanovic type</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant palmoplantar keratoderma and congenital alopecia</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>

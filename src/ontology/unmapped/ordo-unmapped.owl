        <oboInOwl:hasExactSynonym>Autosomal recessive spastic ataxia of Charlevoix-Saguenay</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive spastic ataxia type 6</oboInOwl:hasExactSynonym>

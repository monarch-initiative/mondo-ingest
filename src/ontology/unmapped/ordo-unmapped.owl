    <!-- http://www.orpha.net/ORDO/Orphanet_206564 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_206564">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102015"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209024"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309469"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371047"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19139"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of limb-girdle muscular dystrophy characterized by an onset in childhood or adolescence of rapidly progressive proximal limb muscle weakness (particularly affecting the neck, hip girdle, and shoulder abductors), hypertrophy in the calves and quadriceps, ankle contractures, and myopia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive limb-girdle muscular dystrophy type 2O</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD type 2O</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD2O</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Limb-girdle muscular dystrophy type 2O</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">POMGNT1-related LGMD R15</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>POMGNT1-related limb-girdle muscular dystrophy R15</oboInOwl:hasExactSynonym>
        <rdfs:label>POMGNT1-related limb-girdle muscular dystrophy R15</rdfs:label>
        <skos:broadMatch>ICD-10:G71.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C70.41</skos:broadMatch>
        <skos:exactMatch>MONDO:0013161</skos:exactMatch>
        <skos:exactMatch>OMIM:613157</skos:exactMatch>
        <skos:exactMatch>UMLS:C3150417</skos:exactMatch>
    </owl:Class>

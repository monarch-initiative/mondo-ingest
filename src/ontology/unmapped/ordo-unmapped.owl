        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3755"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A Pierre Robin syndrome associated with bone disease characterized by severe short-limbed dwarfism, joint dislocations, club feet along with distinctive facies and radiographic findings.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AO1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">AOI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Atelosteogenesis type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Atelosteogenesis type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Giant cell chondrodysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spondylo-humero-femoral dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Atelosteogenesis type I</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.E</skos:broadMatch>
        <skos:exactMatch>MONDO:0007167</skos:exactMatch>
        <skos:exactMatch>MeSH:C535396</skos:exactMatch>
        <skos:exactMatch>OMIM:108720</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265283</skos:exactMatch>
    </owl:Class>

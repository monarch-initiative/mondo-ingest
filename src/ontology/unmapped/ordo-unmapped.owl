    <!-- http://www.orpha.net/ORDO/Orphanet_268173 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_268173">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_511"/>

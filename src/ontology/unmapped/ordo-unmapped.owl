    <!-- http://www.orpha.net/ORDO/Orphanet_320370 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_320370">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100981"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Autosomal recessive spastic paraplegia type 43 is a rare, complex hereditary spastic paraplegia characterized by a childhood to adolescent onset of progressive lower limb spasticity, associated with mild to severe gait disturbances, extensor plantar responses, muscle weakness and severe distal atrophy, frequently with upper limb involvement. Additional features may include joint contractures, distal sensory loss and brisk or absent deep tendon reflexes. Other signs, such as depression, memory loss, optic atrophy (with vision loss) and brain iron deposition (revealed by brain imagery), have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive spastic paraplegia type 43</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG43</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive spastic paraplegia type 43</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0014024</skos:exactMatch>
        <skos:exactMatch>OMIM:615043</skos:exactMatch>
        <skos:exactMatch>UMLS:C2680446</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_320370"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

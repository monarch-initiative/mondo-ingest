    <!-- http://www.orpha.net/ORDO/Orphanet_99141 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99141">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156246"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_289825"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_435606"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9647"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by choanal atresia and early onset of lymphedema of the lower extremities. Additional reported features include facial dysmorphism (hypertelorism, broad forehead, smooth philtrum, unilateral low-set ear, and high-arched palate), hypoplastic nipples, and pectus excavatum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lymphedema-posterior choanal atresia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lymphedema-posterior choanal atresia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0013324</skos:exactMatch>
        <skos:exactMatch>OMIM:613611</skos:exactMatch>
        <skos:exactMatch>UMLS:C3150875</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, autosomal dominant spastic ataxia disorder characterized by lower-limb spasticity and ataxia in the form of head jerks, ocular movement abnormalities, dysarthria, dysphagia and gait disturbances.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant spastic ataxia type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPAX1</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant spastic ataxia type 1</rdfs:label>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">White forelock with malformations is a multiple congenital anomalies syndrome characterized by poliosis, distinct facial features (epicanthal folds, hypertelorism, posterior rotation of ears, prominent philtrum, high-arched palate) and congenital anomalies/malformations of the eye (blue sclera), cardiopulmonary (atrial septal defect, prominent thoracic and abdominal veins), and skeletal (clinodactyly, syndactyly of the fingers and 2nd and 3rd toes) systems. There have been no further descriptions in the literature since 1980.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>White forelock with malformations</oboInOwl:hasExactSynonym>
        <rdfs:label>White forelock with malformations</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010199</skos:exactMatch>
        <skos:exactMatch>MeSH:C536700</skos:exactMatch>
        <skos:exactMatch>OMIM:277740</skos:exactMatch>
        <skos:exactMatch>UMLS:C1848463</skos:exactMatch>
    </owl:Class>

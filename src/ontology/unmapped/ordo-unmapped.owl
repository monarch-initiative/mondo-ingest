        <oboInOwl:hasExactSynonym xml:lang="en">SMS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stiff man spectrum disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Stiff person spectrum disorder</oboInOwl:hasExactSynonym>
        <rdfs:label>Stiff person spectrum disorder</rdfs:label>
        <skos:broadMatch>ICD-10:G25.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8E4A.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008491</skos:exactMatch>

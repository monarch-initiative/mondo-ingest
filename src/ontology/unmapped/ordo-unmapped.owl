                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7610"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare primary early-onset glaucoma characterized by early onset, severe elevation of intra ocular pressure of rapid progression, leading to optic nerve excavation and, when untreated, substantial visual impairment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Juvenile glaucoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Juvenile glaucoma</rdfs:label>
        <skos:broadMatch>ICD-10:H40.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:9C61.41</skos:broadMatch>
        <skos:broadMatch>OMIM:231300</skos:broadMatch>
        <skos:exactMatch>MONDO:0020367</skos:exactMatch>
        <skos:exactMatch>MedDRA:10064032</skos:exactMatch>
        <skos:exactMatch>UMLS:C2981140</skos:exactMatch>
        <skos:narrowMatch>OMIM:137750</skos:narrowMatch>
        <skos:narrowMatch>OMIM:608695</skos:narrowMatch>
        <skos:narrowMatch>OMIM:608696</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610535</skos:narrowMatch>
        <skos:narrowMatch>OMIM:611274</skos:narrowMatch>
    </owl:Class>

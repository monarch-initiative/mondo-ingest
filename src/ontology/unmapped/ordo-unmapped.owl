    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3194 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3194">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98628"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, ectodermal dysplasia syndrome characterized by corneal epithelial changes (ranging from roughening to nodular irregularities), diffuse palmoplantar hyperkeratosis with thickened, erythematous, scaly lesions affecting the elbows, knees and knuckles, distal onycholysis, brachydactyly accompanied by a single transverse palmar crease, short stature, premature birth, and increased susceptibility to tooth decay. Ocular symptoms include photophobia, reduced night vision, burning and watery eyes, and varying visual acuity. There have been no further descriptions in the literature since 1984.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDO syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Corneodermatoosseous syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stern-Lubinsky-Durrie syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Corneodermatoosseous syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:H18.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007383</skos:exactMatch>
        <skos:exactMatch>MeSH:C536444</skos:exactMatch>
        <skos:exactMatch>OMIM:122440</skos:exactMatch>
        <skos:exactMatch>UMLS:C1852542</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

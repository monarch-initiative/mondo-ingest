    <!-- http://www.orpha.net/ORDO/Orphanet_645362 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645362">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>

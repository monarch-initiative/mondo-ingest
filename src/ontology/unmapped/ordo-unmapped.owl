    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2364 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2364">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79201"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic glycogen storage disease characterized by either lactate dehydrogenase (LDH) M- or H-subunit deficiency. Main features of LDH M-subunit deficiency are exertional fatigue and muscle pain potentially accompanied by myoglobinuria. Some patients may develop pustular psoriasis-like skin lesions. Complications of pregnancy, such as frequent abdominal pains and increased uterine tone with a risk of dystocia have also been described. LDH H-subunit deficiency manifests with low serum LDH activity of unclear clinical relevance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD due to lactate dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glycogen storage disease due to lactate dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis due to lactate dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LDH deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Glycogen storage disease due to lactate dehydrogenase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0016527</skos:exactMatch>
        <skos:exactMatch>UMLS:C5575057</skos:exactMatch>
        <skos:narrowMatch>OMIM:612933</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614128</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2364"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Glycogen storage disease due to lactate dehydrogenase deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2368 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2368">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108977"/>

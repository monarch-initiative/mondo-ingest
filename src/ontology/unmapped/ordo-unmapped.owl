        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93442"/>
        <obo:IAO_0000115 xml:lang="en">Non-rhizomelic chondrodysplasia punctata is a form of chondrodysplasia punctata, a group of diseases in which the common characteristic is bone calcifications near joints from birth. Non-rhizomelic chondrodysplasia punctata is not an entity in itself but covers several diseases with variable clinical findings and modes of transmission.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Non-rhizomelic chondrodysplasia punctata</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-rhizomelic chondrodysplasia punctata</rdfs:label>
        <skos:exactMatch>MONDO:0015775</skos:exactMatch>
        <skos:exactMatch>MONDO:15775</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681009</skos:exactMatch>
    </owl:Class>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Autosomal recessive Robinow syndrome (RRS) is the less common type of Robinow syndrome (RS) characterized by short-limb dwarfism, costovertebral segmentation defects and abnormalities of the head, face and external genitalia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive Robinow syndrome</oboInOwl:hasExactSynonym>

        <owl:annotatedTarget>Non-distal deletion 12q syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_96164 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96164">

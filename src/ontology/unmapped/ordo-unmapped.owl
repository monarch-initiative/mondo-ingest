    <!-- http://www.orpha.net/ORDO/Orphanet_36412 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_36412">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156149"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_280369"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_567556"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2959"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare immune complex-mediated small vessel vasculitis characterized by urticaria and hypocomplementemia (low C3, C4 and/or C1q), and usually associated with circulating anti-C1q autoantibodies. Arthritis, pulmonary disease, ocular inflammation are common systemic manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Anti-C1q vasculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypocomplementemic urticarial vasculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mac Duffie hypocomplementemic urticarial vasculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mac Duffie syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">McDuffie hypocomplementemic urticarial vasculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">McDuffie syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypocomplementemic urticarial vasculitis</rdfs:label>
        <skos:broadMatch>ICD-10:M31.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:4A44.91</skos:exactMatch>
        <skos:exactMatch>MONDO:0018227</skos:exactMatch>
        <skos:exactMatch>UMLS:C0343206</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        <obo:IAO_0000115 xml:lang="en">Neovascular glaucoma is the most common type of secondary glaucoma, usually caused by diabetic retinopathy, central retinal vein occlusion and carotid artery obstruction but sometimes by trauma, uveitis or ocular tumors, and characterized by severe eye pain, synechial angle glaucoma, high intraocular pressure and leading to loss of vision.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neovascular glaucoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Neovascular glaucoma</rdfs:label>
        <skos:broadMatch>ICD-10:H40.5</skos:broadMatch>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hurler-Scheie syndrome is the intermediate form of mucopolysaccharidosis type 1 (MPS1) between the two extremes Hurler syndrome and Scheie syndrome; it is a rare lysosomal storage disease, characterized by skeletal deformities and a delay in motor development.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hurler-Scheie syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MPS1H/S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MPSIH/S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucopolysaccharidosis type 1H/S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucopolysaccharidosis type IH/S</oboInOwl:hasExactSynonym>
        <rdfs:label>Hurler-Scheie syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E76.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.30</skos:broadMatch>
        <skos:exactMatch>MONDO:0011759</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056916</skos:exactMatch>
        <skos:exactMatch>OMIM:607015</skos:exactMatch>
        <skos:exactMatch>UMLS:C0086431</skos:exactMatch>
    </owl:Class>

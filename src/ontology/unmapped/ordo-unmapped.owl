    <!-- http://www.orpha.net/ORDO/Orphanet_2838 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2838">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <obo:IAO_0000115 xml:lang="en">A rare, syndromic, developmental defect during embryogenesis characterized by urinary tract and kidney anomalies, such as renal pelviocaliceal attenuation with multiple tiny caliceal diverticula, associated with sensorineural hearing loss. There have been no further descriptions in the literature since 1981.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Renal caliceal diverticuli-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Renal caliceal diverticuli-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Renal caliceal diverticuli-deafness syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q64.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0017281</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190738</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2838"/>

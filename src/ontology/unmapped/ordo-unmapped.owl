            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A severe form of dystrophic epidermolysis bullosa (DEB) characterized by generalized cutaneous and mucosal blistering and scarring associated with severe deformities and major extracutaneous involvement.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive dystrophic epidermolysis bullosa generalisata gravis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive dystrophic epidermolysis bullosa, Hallopeau-Siemens type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autosomal recessive generalized dystrophic epidermolysis bullosa, severe form</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Generalized RDEB, severe form</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RDEB generalisata gravis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RDEB, Hallopeau-Siemens type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe generalized RDEB</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive generalized dystrophic epidermolysis bullosa, severe form</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC32</skos:broadMatch>
        <skos:exactMatch>MONDO:0009179</skos:exactMatch>
        <skos:exactMatch>OMIM:226600</skos:exactMatch>

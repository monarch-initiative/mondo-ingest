        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_69078"/>
        <obo:IAO_0000115 xml:lang="en">Myxoid/round cell liposarcoma (MRCLS) is a type of liposarcoma (LS) mostly located in the limbs, with a variable behavior depending on the histological subtype. Both myxoid and round cell are distinct histological subtypes of LS.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MRCLS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Myxoid/round cell liposarcoma</oboInOwl:hasExactSynonym>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1492"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, hereditary disorder of pentose phosphate metabolism characterized by increased urine levels of sedoheptulose and erythritol, and low-to-normal excretion of sedoheptulose-7P. Clinical presentation of this disorder is currently unclear.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated SHPK deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated sedoheptulokinase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated sedoheptulokinase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0014969</skos:exactMatch>
        <skos:exactMatch>OMIM:617213</skos:exactMatch>
        <skos:exactMatch>UMLS:C1291373</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_440713"/>

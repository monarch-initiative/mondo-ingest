    <!-- http://www.orpha.net/ORDO/Orphanet_890 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_890">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101938"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506210"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare vascular liver disease characterized by toxic injury to the hepatic sinusoidal capillaries that leads to obstruction of the small hepatic veins and sinusoids. Clinical manifestations include painful hepatomegaly, jaundice, and fluid retention that manifests by weight gain, edemas, and ascites.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hepatic veno-occlusive disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sinusoidal obstruction syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hepatic veno-occlusive disease</rdfs:label>
        <skos:exactMatch>ICD-10:K76.5</skos:exactMatch>
        <skos:exactMatch>ICD-11:DB98.6</skos:exactMatch>
        <skos:exactMatch>MONDO:0019514</skos:exactMatch>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_111 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_111">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206966"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217613"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_289902"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_331184"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_352312"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11577"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Barth syndrome (BTHS) is an inborn error of phospholipid metabolism characterized by dilated cardiomyopathy (DCM), skeletal myopathy, neutropenia, growth delay and organic aciduria.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">3-methylglutaconic aciduria type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">BTHS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Barth syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cardioskeletal myopathy with neutropenia and abnormal mitochondria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cardioskeletal myopathy-neutropenia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MGA2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked cardioskeletal myopathy and neutropenia</oboInOwl:hasExactSynonym>
        <rdfs:label>Barth syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E71.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E0</skos:broadMatch>
        <skos:exactMatch>MONDO:0010543</skos:exactMatch>
        <skos:exactMatch>MeSH:D056889</skos:exactMatch>
        <skos:exactMatch>MedDRA:10078537</skos:exactMatch>
        <skos:exactMatch>OMIM:302060</skos:exactMatch>
        <skos:exactMatch>UMLS:C0574083</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_111"/>

        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6697"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hyperostosis corticalis generalisata, also known as van Buchem disease, is a rare craniotubular hyperostosis characterized by hyperostosis of the skull, mandible, clavicles, ribs and diaphyses of the long bones, as well as the tubular bones of the hands and feet. Clinical manifestations include increased skull thickness with cranial nerve entrapment causing inconsistent cranial nerve palsies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hyperostosis corticalis generalisata</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperphosphatasemia tarda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Van Buchem disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperostosis corticalis generalisata</rdfs:label>
        <skos:broadMatch>ICD-10:M89.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009395</skos:exactMatch>
        <skos:exactMatch>OMIM:239100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432272</skos:exactMatch>
        <skos:narrowMatch>OMIM:144750</skos:narrowMatch>
    </owl:Class>

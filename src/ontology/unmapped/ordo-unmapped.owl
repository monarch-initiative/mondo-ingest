    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2921 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2921">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by intellectual disability, growth retardation, unilateral preaxial polydactyly, and colobomatous anomalies (including coloboma of the iris, optic nerve head, choroid, and retina). There have been no further descriptions in the literature since 1987.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Pfeiffer-Mayer syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Preaxial polydactyly-colobomata-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Preaxial polydactyly-colobomata-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0017377</skos:exactMatch>
        <skos:exactMatch>MeSH:C537888</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931655</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2921"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Preaxial polydactyly-colobomata-intellectual disability syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2924 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2924">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101941"/>

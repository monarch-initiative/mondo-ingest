        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly characterized by mild intellectual disability, developmental delay, short stature, hypotonia and dysmorphic facial features. Anxiety and short attention span have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>11q22.2q22.3 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(11)(q22.2q22.3)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 11q22.2q22.3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(11)(q22.2q22.3)</oboInOwl:hasExactSynonym>
        <rdfs:label>11q22.2q22.3 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0018632</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680062</skos:exactMatch>
    </owl:Class>

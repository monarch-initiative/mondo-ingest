    <!-- http://www.orpha.net/ORDO/Orphanet_556030 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_556030">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_427"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2592"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare type of familial hypoaldosteronism characterized by early infantile onset of vomiting, diarrhea, severe dehydration, and failure to thrive. Analysis of plasma electrolytes shows hyponatremia, hyperkalemia, and acidosis. Plasma renin activity is elevated, and aldosterone levels are low.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset familial hyperreninemic hypoaldosteronism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early-onset familial hypoaldosteronism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe aldosterone synthase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Early-onset familial hypoaldosteronism</rdfs:label>
        <skos:broadMatch>ICD-10:E27.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A73</skos:broadMatch>
        <skos:exactMatch>MONDO:0035320</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680171</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_556030"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Early-onset familial hypoaldosteronism</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_556037 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_556037">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_427"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare form of familial hypoaldosteronism characterized by adult onset of subnormal plasma aldosterone with elevated plasma renin activity, hyperkalemia, metabolic acidosis, and hypotension. Signs and symptoms are typically mild, and affected individuals may be clinically asymptomatic and diagnosed only after biochemical screening.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Late-onset familial hyperreninemic hypoaldosteronism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Late-onset familial hypoaldosteronism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mild aldosterone synthase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Late-onset familial hypoaldosteronism</rdfs:label>
        <skos:broadMatch>ICD-10:E27.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A73</skos:broadMatch>
        <skos:exactMatch>MONDO:0035321</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680172</skos:exactMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomalie characterized by intellectual deficit, retinal and skin pigmentation disorders, seizures, and dysmorphic features, including flat occiput, epicanthal folds, downward slanting eyes, flat nasal bridge, upturned nostrils, short neck, and large low set ears.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ring 14</oboInOwl:hasExactSynonym>

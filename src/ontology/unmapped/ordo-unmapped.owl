    <!-- http://www.orpha.net/ORDO/Orphanet_93940 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93940">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2004"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A congenital respiratory tract anomaly characterized by a cleft extending through the cricoid cartilage, sometimes into the cervical trachea, with severe swallowing disorders, lung infections and pulmonary damage.</obo:IAO_0000115>

        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease type II, infantile onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis due to acid maltase deficiency, infantile onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis type 2, infantile onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis type II, infantile onset</oboInOwl:hasExactSynonym>

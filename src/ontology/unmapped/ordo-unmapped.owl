        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404574"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12786"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome with limb reduction defects characterized by severe femoral bowing, aplasia/hypoplasia of the fibula and ulna. Patients may present with poly-, oligo-, clino- and syndactyly. Absence/coalescence of tarsal bones, absence of metatarsals, hypoplasia/aplasia of toes, fingers and fingernails, hypoplasia of pelvis, congenital hip dislocation, short stature and amenorrhea have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Fibular hypoplasia or aplasia-femoral bowing-oligodactyly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fuhrmann syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fuhrmann-Rieger-de Sousa syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Fuhrmann syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009232</skos:exactMatch>
        <skos:exactMatch>MeSH:C538189</skos:exactMatch>
        <skos:exactMatch>OMIM:228930</skos:exactMatch>
        <skos:exactMatch>UMLS:C1856728</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Scheie syndrome is the mildest form of mucopolysaccharidosis type 1 (MPS1), a rare lysosomal storage disease, characterized by skeletal deformities and a delay in motor development.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MPS1S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MPSIS</oboInOwl:hasExactSynonym>

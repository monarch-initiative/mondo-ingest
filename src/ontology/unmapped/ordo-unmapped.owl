    <!-- http://www.orpha.net/ORDO/Orphanet_79143 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79143">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139027"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79369"/>
        <obo:IAO_0000115 xml:lang="en">Isolated congenital anonychia is characterized by nail abnormalities ranging from onychodystrophy (dystrophic nails) to anonychia (absence of nails). Onychodystrophy-anonychia has been described in at least four generations of a family with male-to-male transmission, suggesting autosomal dominant transmission. Anonychia has been described in approximately less than 20 cases; it is likely to be transmitted as an autosomal recessive trait. Total anonychia congenita, in which all the fingernails and toenails are absent, may have an autosomal dominant inheritance pattern.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated anonychia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated congenital anonychia</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated congenital anonychia</rdfs:label>
        <skos:broadMatch>ICD-11:EC22.0</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q84.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0019211</skos:exactMatch>
        <skos:exactMatch>MeSH:C536377</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265998</skos:exactMatch>
        <skos:narrowMatch>OMIM:107000</skos:narrowMatch>
        <skos:narrowMatch>OMIM:206800</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614149</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_79143"/>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_391316 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_391316">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166472"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

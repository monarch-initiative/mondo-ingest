    <!-- http://www.orpha.net/ORDO/Orphanet_85146 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85146">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209041"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98505"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2770"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neuromuscular disease characterized by adult-onset muscle weakness and atrophy in a scapuloperoneal distribution, mild involvement of the facial muscles, dysphagia, and gynecomastia. Elevated serum CK levels and mixed myopathic and neurogenic abnormalities are associated clinical findings.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Kaeser syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neurogenic scapuloperoneal syndrome, Kaeser type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stark-Kaeser syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Neurogenic scapuloperoneal syndrome, Kaeser type</rdfs:label>
        <skos:broadMatch>ICD-10:G12.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0008407</skos:exactMatch>
        <skos:exactMatch>MeSH:C566695</skos:exactMatch>
        <skos:exactMatch>OMIM:181400</skos:exactMatch>
        <skos:exactMatch>UMLS:C1867005</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_85146"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neurogenic scapuloperoneal syndrome, Kaeser type</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

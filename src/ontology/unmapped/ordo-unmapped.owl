    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2396 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2396">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183484"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183487"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79382"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3688"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic skin disease characterized by the ocular, cutaneous, and central nervous system anomalies. Typical clinical features include a well-demarcated hairless fatty nevus on the scalp, benign ocular tumors, and central nervous system lipomas, leading sometimes to seizures, spasticity, and intellectual disability. Nevus psiloliparus, focal dermal hypo- or aplasia, eyelid skin tags, colobomas, abnormal intracranial vessels, hemispheric atrophy, porencephalic cyst, and hydrocephalus have also been associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Encephalocraniocutaneous lipomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Haberland syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Encephalocraniocutaneous lipomatosis</rdfs:label>
        <skos:broadMatch>ICD-10:E88.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:EF02.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0013074</skos:exactMatch>
        <skos:exactMatch>MeSH:C535736</skos:exactMatch>
        <skos:exactMatch>OMIM:613001</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406612</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2396"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Encephalocraniocutaneous lipomatosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2398 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2398">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183484"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79382"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16877"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare subcutaneous tissue disease characterized by growth of symmetric non-encapsulated masses of adipose tissue mostly around the face and neck, with variable clinical repercussions (e.g. reduced neck mobility, compression of respiratory structures).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cephalothoracic lipodystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial benign cervical lipomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Launois-Bensaude lipomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Madelung disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple symmetric lipomatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple symmetric lipomatosis</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EF02.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0007908</skos:exactMatch>
        <skos:exactMatch>MeSH:D008069</skos:exactMatch>
        <skos:exactMatch>OMIM:151800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0023804</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

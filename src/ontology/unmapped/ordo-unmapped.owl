    <!-- http://www.orpha.net/ORDO/Orphanet_2890 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2890">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

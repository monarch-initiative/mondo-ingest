            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare adult-onset disorder of neurodegeneration with brain iron accumulation (NBIA) characterized by anemia (often microcytic), visceral and brain iron accumulation, diabetes, various neurological symptoms and retinal degeneration.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aceruloplasminemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary ceruloplasmin deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Aceruloplasminemia</rdfs:label>
        <skos:broadMatch>ICD-10:E83.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A00.Y</skos:broadMatch>

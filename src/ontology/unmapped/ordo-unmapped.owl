    <!-- http://www.orpha.net/ORDO/Orphanet_306661 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_306661">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309458"/>

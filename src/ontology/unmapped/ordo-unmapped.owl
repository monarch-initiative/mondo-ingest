    <!-- http://www.orpha.net/ORDO/Orphanet_8 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_8">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263746"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare sex chromosome aneuploidy where males receive an additional Y chromosome, that is characterized clinically by tall stature evident from childhood, macrocephaly, facial features (mild hypertelorism, low set ears, a mildly flat malar region), speech delay and an increased risk for social and emotional difficulties, attention deficit hyperactive disorder and autistic spectrum disorder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>47,XYY syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Double Y syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Jacobs syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XYY syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Y disomy</oboInOwl:hasExactSynonym>
        <rdfs:label>47,XYY syndrome</rdfs:label>
        <skos:broadMatch>ICD-11:LD52.1</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q98.5</skos:exactMatch>
        <skos:exactMatch>MONDO:0019339</skos:exactMatch>

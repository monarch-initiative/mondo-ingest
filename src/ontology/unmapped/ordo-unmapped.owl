    <!-- http://www.orpha.net/ORDO/Orphanet_1166 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1166">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_155832"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, isolated, congenital, head and neck morphological anomaly characterized by the unilateral hypoplasia/agenesis of the depressor anguli oris muscle, resulting in an asymmetric crying facies in neonatal period/infancy (drooping of one corner of the mouth during crying) while eye closure, nasolabial fold and forehead wrinkling are symmetric. Although isolated in the majority of cases, newborns presenting with this morphological anomaly should be referred for further screening for 22q11.2 deletion syndrome and/or other coexisting cardiovascular, musculoskeletal, cervicofacial, respiratory, genitourinary and endocrine anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital unilateral hypoplasia of depressor anguli oris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated asymmetric crying facies</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital unilateral hypoplasia of depressor anguli oris</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0007443</skos:exactMatch>
        <skos:exactMatch>MeSH:C535349</skos:exactMatch>
        <skos:exactMatch>UMLS:C0431406</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1166"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98158"/>
        <obo:IAO_0000115 xml:lang="en">A genetic male infertility characterized by azoospermia or oligozoospermia due to chromosome Y microdeletion.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Chromosome Y microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Male infertility due to chromosome Y microdeletion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Microdeletion of the AZF region on the Y chromosome</oboInOwl:hasExactSynonym>
        <rdfs:label>Chromosome Y microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q98.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A81.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0015607</skos:exactMatch>
        <skos:exactMatch>MeSH:C536297</skos:exactMatch>

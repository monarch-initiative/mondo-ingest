    <!-- http://www.orpha.net/ORDO/Orphanet_160148 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_160148">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117569"/>

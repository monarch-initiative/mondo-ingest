        <skos:narrowMatch>OMIM:601815</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610992</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614023</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

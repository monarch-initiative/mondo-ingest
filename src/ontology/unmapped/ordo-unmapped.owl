        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Complete androgen insensitivity syndrome (CAIS) is a form of androgen insensitivity syndrome (AIS), a disorder of sex development (DSD), characterized by the presence of female external genitalia in a 46,XY individual with normal testis development but undescended testes and unresponsiveness to age-appropriate levels of androgens.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CAIS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Complete androgen insensitivity syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Complete androgen resistance syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Complete androgen insensitivity syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E34.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2A.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0021023</skos:exactMatch>
        <skos:exactMatch>OMIM:300068</skos:exactMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93438"/>
        <obo:IAO_0000115 xml:lang="en">A rare disorder characterized by disproportionate short stature from birth with dysplasia of the ulna and fibula.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mesomelic dwarfism, Reinhardt-Pfeiffer type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Reinhardt-Pfeiffer mesomelic dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Reinhardt-Pfeiffer syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Mesomelic dwarfism, Reinhardt-Pfeiffer type</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.A</skos:broadMatch>
        <skos:exactMatch>MONDO:0008618</skos:exactMatch>
        <skos:exactMatch>MeSH:C537349</skos:exactMatch>

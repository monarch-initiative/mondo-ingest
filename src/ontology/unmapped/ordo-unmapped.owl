        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95495"/>
        <obo:IAO_0000115 xml:lang="en">A rare complex brain malformation characterized by incomplete cleavage of the prosencephalon, and affecting both the forebrain and face and resulting in neurological manifestations and facial anomalies of variable severity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HPE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Holoprosencephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Holoprosencephaly</rdfs:label>
        <skos:broadMatch>OMIM:612530</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q04.2</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA05.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0016296</skos:exactMatch>
        <skos:exactMatch>MeSH:D016142</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056304</skos:exactMatch>
        <skos:exactMatch>OMIM:236100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0079541</skos:exactMatch>
        <skos:narrowMatch>OMIM:142945</skos:narrowMatch>
        <skos:narrowMatch>OMIM:142946</skos:narrowMatch>
        <skos:narrowMatch>OMIM:147250</skos:narrowMatch>

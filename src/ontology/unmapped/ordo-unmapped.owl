        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Hereditary clear cell renal cell carcinoma (ccRCC) is a hereditary renal cancer syndrome defined as development of ccRCC in two or more family members without evidence of constitutional chromosome 3 translocation, von Hippel-Lindau disease or other tumor predisposing syndromes associated with ccRCC, such as tuberous sclerosis or Birt-Hogg-Dubbé syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary clear cell renal cell adenocarcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary clear cell renal cell carcinoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary clear cell renal cell carcinoma</rdfs:label>
        <skos:broadMatch>ICD-10:C64</skos:broadMatch>
        <skos:broadMatch>OMIM:144700</skos:broadMatch>

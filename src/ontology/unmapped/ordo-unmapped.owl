            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Refractory cytopenias with unilineage dysplasia (RCUD) is a frequent low-risk subtype of myelodysplastic syndrome (MDS) characterized by refractory cytopenias associated with dysplasia limited to one cell lineage.</obo:IAO_0000115>

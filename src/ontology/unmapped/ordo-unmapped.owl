            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary sensory and autonomic neuropathy characterized by decreased pain and temperature perception, absent deep tendon reflexes, proprioceptive ataxia, afferent baroreflex failure and progressive optic neuropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial dysautonomia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HSAN3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary sensory and autonomic neuropathy type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary sensory and autonomic neuropathy type III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Riley-Day syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial dysautonomia</rdfs:label>
        <skos:exactMatch>ICD-10:G90.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:8C21.1</skos:exactMatch>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13815"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary hypercarotenemia and vitamin A deficiency is an extremely rare metabolic disorder characterized clinically by skin discoloration, elevated levels of carotene and low levels of vitamin A described in fewer than 5 patients to date.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hereditary hypercarotenemia and vitamin A deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary hypercarotenemia and vitamin A deficiency</rdfs:label>

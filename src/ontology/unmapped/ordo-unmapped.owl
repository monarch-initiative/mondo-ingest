        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2929"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Infantile juvenile polyposis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Juvenile polyposis of infancy</oboInOwl:hasExactSynonym>
        <rdfs:label>Juvenile polyposis of infancy</rdfs:label>
        <skos:broadMatch>ICD-10:D12.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:2B90.Y</skos:broadMatch>

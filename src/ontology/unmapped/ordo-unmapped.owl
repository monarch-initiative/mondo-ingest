                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/144"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/47"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8620"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, developmental defect of the eye characterized by a uni- or bilateral notch, gap, hole or fissure, typically located in the inferonasal quadrant of the eye, involving only the pigment epithelium or the iris stroma (incomplete) or involving both (complete), manifesting with iris shape anomalies (e.g. &apos;keyhole&apos; or oval pupil) and/or photophobia. Association with colobomata in other parts of the eye (incl. ciliary body, zonule, choroid, retina, optic nerve) and complex malformation syndromes (such as CHARGE syndrome) may be observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Coloboma of iris</oboInOwl:hasExactSynonym>
        <rdfs:label>Coloboma of iris</rdfs:label>
        <skos:broadMatch>OMIM:120200</skos:broadMatch>
        <skos:broadMatch>OMIM:620731</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q13.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA11.4</skos:exactMatch>
        <skos:exactMatch>MONDO:0020356</skos:exactMatch>
        <skos:exactMatch>MedDRA:10052642</skos:exactMatch>
        <skos:exactMatch>UMLS:C0266551</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98944"/>

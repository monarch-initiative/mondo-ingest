    <!-- http://www.orpha.net/ORDO/Orphanet_317419 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_317419">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183660"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">T-B- severe combined immunodeficiency (SCID) is a group of rare monogenic primary immunodeficiency disorders characterized by a lack of functional peripheral T and B lymphocytes, resulting in recurrent early-onset severe respiratory viral, bacterial or fungal infections, diarrhea and failure to thrive. Hypersensitivity to ionizing radiation is a characteristic feature of some of its sub-types.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">T-B- SCID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T-B- severe combined immunodeficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>T-B- severe combined immunodeficiency</rdfs:label>
        <skos:broadMatch>ICD-11:4A01.10</skos:broadMatch>
        <skos:exactMatch>ICD-10:D81.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0017855</skos:exactMatch>
        <skos:exactMatch>MONDO:17855</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679893</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_317419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>T-B- severe combined immunodeficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_317425 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_317425">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

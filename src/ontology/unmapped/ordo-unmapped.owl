        <skos:exactMatch>UMLS:C5779508</skos:exactMatch>
        <skos:narrowMatch>OMIM:278300</skos:narrowMatch>
        <skos:narrowMatch>OMIM:603592</skos:narrowMatch>
    </owl:Class>

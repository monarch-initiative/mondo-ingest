    <!-- http://www.orpha.net/ORDO/Orphanet_248340 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_248340">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

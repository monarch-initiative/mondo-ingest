            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of neonatal diabetes mellitus characterized by a triad of Developmental delay, Epilepsy, and Neonatal Diabetes (DEND syndrome), with a generally severe course. This form of neonatal diabetes is not associated with abnormal pancreatic development.</obo:IAO_0000115>

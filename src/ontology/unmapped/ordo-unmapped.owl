    <!-- http://www.orpha.net/ORDO/Orphanet_2110 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2110">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294959"/>

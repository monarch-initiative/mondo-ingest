        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Cerebro-facio-thoracic dysplasia or Pascual-Castroviejo syndrome type 1 is a rare syndrome characterized by facial dysmorphism, intellectual deficit and costovertebral abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cerebrofaciothoracic dysplasia</oboInOwl:hasExactSynonym>

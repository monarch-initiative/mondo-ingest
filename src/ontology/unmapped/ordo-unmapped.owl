        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic renal disorder characterized by renal, neurologic and thyroid disease, associated with thrombocytopenia. There have been no further descriptions in the literature since 1978.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutler-Bass-Romshe syndrome</oboInOwl:hasExactSynonym>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9949"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies characterized by distinctive signs and facial associated features from which the acronym RAPADILINO is made: RA for radial ray defect, PA for patellae hypoplasia/aplasia and cleft or highly arched palate, DI for diarrhea and dislocated joints, LI for little size and limb malformations, NO for long, slender nose and normal intelligence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>RAPADILINO syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>RAPADILINO syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>

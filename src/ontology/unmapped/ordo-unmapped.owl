        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98642"/>
        <obo:IAO_0000115 xml:lang="en">Distal trisomy of the long arm of chromosome 10 (10q) is characterized by pre- and postnatal growth retardation, a pattern of specific facial features, hypotonia, and developmental and psychomotor delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal duplication 10q syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal trisomy 10q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Telomeric duplication 10q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 10qter</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal duplication 10q syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD41.90</skos:broadMatch>
        <skos:exactMatch>MONDO:0019884</skos:exactMatch>
        <skos:exactMatch>MeSH:C538087</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931728</skos:exactMatch>
    </owl:Class>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Thyroid hypoplasia is a form of thyroid dysgenesis characterized by incomplete development of the thyroid gland that results in primary congenital hypothyroidism, a permanent thyroid deficiency that is present from birth.</obo:IAO_0000115>

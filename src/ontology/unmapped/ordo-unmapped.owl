        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019176</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816692</skos:exactMatch>
        <skos:narrowMatch>OMIM:190350</skos:narrowMatch>
        <skos:narrowMatch>OMIM:190351</skos:narrowMatch>
    </owl:Class>

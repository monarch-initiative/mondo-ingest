    <!-- http://www.orpha.net/ORDO/Orphanet_3003 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3003">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93465"/>
        <obo:IAO_0000115 xml:lang="en">A rare lethal chondrodysplasia characterized by severe generalized osteosclerosis. Main clinical manifestations include large head, palpebral edema, flat nose, low-set ears, hexagon-like mouth, a short neck (hidden by skin folds), a short and wide trunk, a prominent abdomen, and severe micromelic dwarfism with rather normal-length hands and feet. X-rays show marked sclerosis of the facial bones and extremities, and poor ossification elsewhere. It has a lethal outcome, either prenatally or during the early neonatal period. There have been no further descriptions in the literature since 1986.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Camera syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pyknoachondrogenesis</oboInOwl:hasExactSynonym>
        <rdfs:label>Pyknoachondrogenesis</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB82.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009942</skos:exactMatch>
        <skos:exactMatch>MeSH:C536251</skos:exactMatch>
        <skos:exactMatch>OMIM:265880</skos:exactMatch>
        <skos:exactMatch>UMLS:C1849523</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3003"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_404546 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_404546">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290839"/>

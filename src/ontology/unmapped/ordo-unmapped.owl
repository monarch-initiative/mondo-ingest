        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare bone disease characterized by congenital or infancy-onset blindness and juvenile-onset osteoporosis with spontaneous and low trauma fractures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">OPPG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteoporosis-pseudoglioma syndrome</oboInOwl:hasExactSynonym>

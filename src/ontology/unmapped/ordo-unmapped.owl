    <!-- http://www.orpha.net/ORDO/Orphanet_538 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_538">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156610"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264740"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12362"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12363"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, multiple cystic lung disease characterized by progressive cystic destruction of the lung and lymphatic abnormalities, frequently associated with renal angiomyolipomas (AMLs).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LAM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lymphangioleiomyomatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Lymphangioleiomyomatosis</rdfs:label>
        <skos:broadMatch>ICD-10:D48.7</skos:broadMatch>

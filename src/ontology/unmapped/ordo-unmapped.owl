        <skos:exactMatch>ICD-11:LB42.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0019932</skos:exactMatch>
        <skos:exactMatch>UMLS:C1261251</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96269"/>

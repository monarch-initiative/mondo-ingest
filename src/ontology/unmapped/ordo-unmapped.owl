    <!-- http://www.orpha.net/ORDO/Orphanet_169796 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_169796">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

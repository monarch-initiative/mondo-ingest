        <oboInOwl:hasExactSynonym xml:lang="en">Wittwer syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked intellectual disability, Wittwer type</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>

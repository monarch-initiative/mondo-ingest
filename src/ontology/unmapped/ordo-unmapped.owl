    <!-- http://www.orpha.net/ORDO/Orphanet_1048 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1048">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268843"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare neural tube defect characterized by the absence of cranial vault and brain structures. This lethal malformation is secondary to a failure to close the anterior neuropore during early embryonic development, leading to exencephaly (&apos;&apos;open&apos;&apos; brain). The degeneration of the cerebral tissue is due to their exposure to the amniotic fluid and converts the exencephaly into anencephaly (absence of the brain).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated anencephaly/exencephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated anencephaly/exencephaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.8</skos:broadMatch>
        <skos:exactMatch>MONDO:8791</skos:exactMatch>
        <skos:exactMatch>OMIM:206500</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680972</skos:exactMatch>
        <skos:narrowMatch>ICD-11:LA00.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:LA00.Y</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619452</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1048"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Isolated anencephaly/exencephaly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_105 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_105">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_435365"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare fetal lower urinary tract obstruction (LUTO) characterized by closure or failure to develop an opening in the urethra and resulting in obstructive uropathy presenting &lt;i&gt;in utero&lt;/i&gt; as megacystis, oligohydramnios or anhydramnios, and potter sequence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Atresia of urethra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Urethral atresia</oboInOwl:hasExactSynonym>
        <rdfs:label>Atresia of urethra</rdfs:label>
        <skos:broadMatch>ICD-11:LB31.2</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q64.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0015195</skos:exactMatch>
        <skos:exactMatch>MedDRA:10064895</skos:exactMatch>
        <skos:exactMatch>UMLS:C0345345</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

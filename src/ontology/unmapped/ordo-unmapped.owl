    <!-- http://www.orpha.net/ORDO/Orphanet_2321 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2321">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_177107"/>

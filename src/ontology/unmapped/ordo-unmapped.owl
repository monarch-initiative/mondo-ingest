    <!-- http://www.orpha.net/ORDO/Orphanet_363727 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363727">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_220452"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of holoprosencephaly characterized by separation of the right and left cerebral hemispheres and lateral ventricules with some continuity only across the frontal neocortex, especially rostrally and ventrally. Craniofacial features are variable may include ocular hypotelorism, midline cleft lip (complete or partial) and/or flat nose amongst other features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lobar holoprosencephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Lobar holoprosencephaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA05.2</skos:broadMatch>
        <skos:broadMatch>OMIM:157170</skos:broadMatch>
        <skos:broadMatch>OMIM:609637</skos:broadMatch>

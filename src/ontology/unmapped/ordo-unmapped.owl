    <!-- http://www.orpha.net/ORDO/Orphanet_137834 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137834">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_364541"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29242"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia characterized by megalocornea, multiple skeletal anomalies, characteristic facial dysmorphism (wide fontanels, prominent forehead, hypertelorism, prominent eyes, full cheeks and micrognathia) and developmental delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Frank-Ter Haar syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ter Haar syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Frank-Ter Haar syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD25.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0009579</skos:exactMatch>

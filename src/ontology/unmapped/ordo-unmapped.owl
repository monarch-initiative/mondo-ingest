    <!-- http://www.orpha.net/ORDO/Orphanet_73229 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_73229">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_477765"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_544590"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2202"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multisystemic disease characterized by small-vessel brain disease, cerebral aneurysm, and extracerebral findings involving the kidney, muscle, and small vessels of the eye.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant familial hematuria-retinal arteriolar tortuosity-contractures syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HANAC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary angiopathy-nephropathy-aneurysms-muscle cramps syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>HANAC syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:I99</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB4Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012726</skos:exactMatch>
        <skos:exactMatch>MeSH:C567088</skos:exactMatch>
        <skos:exactMatch>OMIM:611773</skos:exactMatch>
        <skos:exactMatch>UMLS:C2673195</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

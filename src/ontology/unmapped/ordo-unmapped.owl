        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98036"/>
        <obo:IAO_0000115 xml:lang="en">A rare respiratory disease characterized by the development of exophytic papillomas, affecting the mucosa of the upper aero-digestive tract (with a strong predilection for the larynx), caused by an infection with human papilloma virus. Symptoms at presentation vary with the age of patients and the extent of lesions and include dysphonia, chronic cough and recurrent respiratory infections.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Recurrent respiratory papillomatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Recurrent respiratory papillomatosis</rdfs:label>
        <skos:broadMatch>ICD-10:D14.4</skos:broadMatch>
        <skos:exactMatch>ICD-11:2F00.1</skos:exactMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare disorder characterised by growth retardation with prenatal onset, cataracts, microcephaly, intellectual deficit, immune deficiency, delayed ossification and enamel hypoplasia. It has been described in two siblings. Transmission is autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microcephalic primordial dwarfism, Toriello type</oboInOwl:hasExactSynonym>
        <rdfs:label>Microcephalic primordial dwarfism, Toriello type</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>

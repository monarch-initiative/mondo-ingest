            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Osteopetrosis with renal tubular acidosis is a rare disorder characterized by osteopetrosis, renal tubular acidosis (RTA), and neurological disorders related to cerebral calcifications.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Carbonic anhydrase 2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Guibaud-Vainsel syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Marble brain disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mixed RTA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mixed renal tubular acidosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteopetrosis with renal tubular acidosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Renal tubular acidosis type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteopetrosis with renal tubular acidosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.10</skos:broadMatch>

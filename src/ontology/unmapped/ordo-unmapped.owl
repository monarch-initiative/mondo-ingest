    <!-- http://www.orpha.net/ORDO/Orphanet_99903 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99903">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_31205"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare bacterial zoonosis characterized by inflammation which appears at the site of a rat bite or scratch that becomes painful, indurated, edematous and may ulcerate. The inflammation is followed by fever, vomiting and chills and is associated with local lymphadenopathy. Spirillary rat-bite fever (RBF), also known as Sodoku (Japanese for so: rat and doku: poison), is caused by the Gram-negative bacillus &lt;i&gt;Spirillum minus&lt;/i&gt; and is transmitted to humans through the bites and scratches of rats.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Sodoku</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spirillary rat-bite fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Spirillary rat-bite fever</rdfs:label>
        <skos:exactMatch>ICD-10:A25.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:1B90.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0020532</skos:exactMatch>
        <skos:exactMatch>UMLS:C0152062</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_99903"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Spirillary rat-bite fever</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_99905 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99905">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_31205"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare systemic bacterial zoonosis characterized by high fever, chills, headache, and nausea associated with arthralgia and a morbilliform or purpuric rash of the extremities. It is caused by the aerobic Gram-negative bacterium &lt;i&gt;Streptobacillus moniliformis&lt;/i&gt; and is transmitted to humans through the bites and scratches of infected rats.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Streptobacillary rat-bite fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Streptobacillary rat-bite fever</rdfs:label>
        <skos:exactMatch>ICD-10:A25.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:1B90.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0020533</skos:exactMatch>
        <skos:exactMatch>UMLS:C0152063</skos:exactMatch>
    </owl:Class>

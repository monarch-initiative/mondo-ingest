                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6493"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of junctional epidermolysis bullosa (JEB) characterized by generalized skin blistering, atrophic scarring, nail dystrophy or nail absence, and enamel hypoplasia, with extracutaneous involvement.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Generalized atrophic benign epidermolysis bullosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Generalized junctional epidermolysis bullosa, non-Herlitz type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intermediate generalized JEB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Intermediate generalized junctional epidermolysis bullosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Junctional epidermolysis bullosa generalisata mitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Junctional epidermolysis bullosa, Disentis type</oboInOwl:hasExactSynonym>
        <rdfs:label>Intermediate generalized junctional epidermolysis bullosa</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.8</skos:broadMatch>

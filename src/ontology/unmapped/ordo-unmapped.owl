        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic eye disease characterized by the combination of ptosis, strabismus and ectopic pupils. There have been no further descriptions in the literature since 1976.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">McPherson-Hall syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ptosis-strabismus-ectopic pupils syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ptosis-strabismus-ectopic pupils syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q10.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA10.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008341</skos:exactMatch>

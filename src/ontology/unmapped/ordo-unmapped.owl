        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98565"/>
        <obo:IAO_0000115 xml:lang="en">An ectodermal dysplasia syndrome with defining features of ankyloblepharon filiforme adnatum (AFA), ectodermal abnormalities and a cleft lip and/or palate.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AEC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ankyloblepharon-ectodermal defects-cleft lip/palate syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hay-Wells syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ankyloblepharon-ectodermal defects-cleft lip/palate syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007124</skos:exactMatch>
        <skos:exactMatch>MeSH:C535847</skos:exactMatch>
        <skos:exactMatch>OMIM:106260</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406709</skos:exactMatch>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9608"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5382"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5383"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia characterized by multiple enchondromas (benign cartilage-forming tumors). The lesions are generally unilateral or asymmetrically distributed. The most common affected site is the appendicular skeleton.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Enchondromatosis Spranger type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple Enchondromatosis type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple Enchondromatosis, Ollier type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ollier disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Ollier disease</rdfs:label>
        <skos:broadMatch>ICD-11:2E83.Z</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q78.4</skos:exactMatch>
        <skos:exactMatch>MONDO:0008145</skos:exactMatch>
        <skos:exactMatch>MeSH:D004687</skos:exactMatch>
        <skos:exactMatch>MedDRA:10014642</skos:exactMatch>
        <skos:exactMatch>OMIM:166000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0014084</skos:exactMatch>
    </owl:Class>

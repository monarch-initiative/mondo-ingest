    <!-- http://www.orpha.net/ORDO/Orphanet_178338 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_178338">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183490"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

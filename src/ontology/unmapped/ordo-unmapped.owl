    <!-- http://www.orpha.net/ORDO/Orphanet_227796 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_227796">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_215"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9940"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Fundus albipunctatus is a rare, genetic retinal dystrophy disorder characterized by the presence of numerous small, round, yellowish-white retinal lesions that are distributed throughout the retina but spare the fovea. Patients present in childhood with non-progressive night blindness with prolonged cone and rod adaptation times. The macula may or may not be involved, which may result in a decrease of central visual acuity with age.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fundus albipunctatus</oboInOwl:hasExactSynonym>
        <rdfs:label>Fundus albipunctatus</rdfs:label>
        <skos:broadMatch>ICD-10:H35.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B70</skos:broadMatch>
        <skos:exactMatch>MONDO:0007639</skos:exactMatch>
        <skos:exactMatch>MeSH:C562733</skos:exactMatch>
        <skos:exactMatch>OMIM:136880</skos:exactMatch>
        <skos:exactMatch>UMLS:C0311338</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_447997 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_447997">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35705"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10942"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurometabolic disorder due to serine deficiency characterized by neonatal to infantile onset of global developmental delay, postnatal microcephaly and intellectual disability, which may be associated with slowly progressive spastic tetraplegia mainly affecting the lower extremities, seizures, and brain MRI findings including thin corpus callosum, delayed myelination and cerebral atrophy. Additional symptoms include brisk deep tendon reflexes, extensor plantar responses, behavioral abnormalities (such as irritability, hyperactivity, sleep disorder), abnormal hand movements and stereotypy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ASCT1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spastic quadriplegia-thin corpus callosum-progressive postnatal microcephaly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spastic tetraplegia-thin corpus callosum-progressive postnatal microcephaly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Spastic tetraplegia-thin corpus callosum-progressive postnatal microcephaly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E72.8</skos:broadMatch>
        <skos:broadMatch>ICD-10:Q02</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.6</skos:broadMatch>
        <skos:exactMatch>MONDO:0014725</skos:exactMatch>
        <skos:exactMatch>OMIM:616657</skos:exactMatch>
        <skos:exactMatch>UMLS:C4225254</skos:exactMatch>
    </owl:Class>

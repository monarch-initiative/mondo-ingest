                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9449"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of genetic prion disease characterized by typical CJD features (rapidly progressive dementia, personality/behavioral changes, psychiatric disorders, myoclonus, and ataxia) with a genetic cause and sometimes a family history of dementia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Inherited CJD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inherited Creutzfeldt-Jakob disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Inherited Creutzfeldt-Jakob disease</rdfs:label>
        <skos:broadMatch>ICD-10:A81.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:8E02.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0007403</skos:exactMatch>
        <skos:exactMatch>OMIM:123400</skos:exactMatch>
        <skos:exactMatch>UMLS:C0751254</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_282166"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522554"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522564"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98623"/>
        <obo:IAO_0000115 xml:lang="en">Marfan syndrome is a systemic disease of connective tissue characterized by a variable combination of cardiovascular, musculo-skeletal, ophthalmic and pulmonary manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MFS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Marfan syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Marfan syndrome</rdfs:label>

        <oboInOwl:hasExactSynonym xml:lang="en">Endodermal sinus tumor of CNS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Endodermal sinus tumor of central nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intracranial endodermal sinus tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intracranial yolk sac tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Yolk sac tumor of CNS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Yolk sac tumor of central nervous system</oboInOwl:hasExactSynonym>
        <rdfs:label>Yolk sac tumor of central nervous system</rdfs:label>

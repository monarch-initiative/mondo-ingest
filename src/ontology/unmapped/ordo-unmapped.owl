    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1368 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1368">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183518"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522548"/>

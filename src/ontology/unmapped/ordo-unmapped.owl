            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A progressive form of familial flecked retinopathy characterized by white punctata throughout the fundus (but sparing the macula in the early stages). Patients present with nightblindness in childhood and may also experience a loss of visual acuity. Significant loss of vision is reported in the 5th and 6th decades of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">RPA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Retinitis punctata albescens</oboInOwl:hasExactSynonym>
        <rdfs:label>Retinitis punctata albescens</rdfs:label>
        <skos:broadMatch>ICD-10:H35.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B70</skos:broadMatch>
        <skos:broadMatch>OMIM:136880</skos:broadMatch>
        <skos:exactMatch>MONDO:0018877</skos:exactMatch>
        <skos:exactMatch>UMLS:C1405854</skos:exactMatch>
    </owl:Class>

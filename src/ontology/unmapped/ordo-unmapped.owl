    <!-- http://www.orpha.net/ORDO/Orphanet_2717 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2717">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98566"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/23399"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Oculotrichoanal syndrome is a form of rare, multiple congenital anomalies/dysmorphic syndrome characterized by a combination of various nose, eye, gastrointestinal and genitourinary abnormalities. Clinical presentation is variable and often includes bifid and broad nasal tip, aberrant anterior hairline, coloboma, cryptophthalmos or unilateral anophthalmia, anal anomalies, and omphalocele. Intelligence and global development is normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MOTA syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Manitoba oculotrichoanal syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Marles syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Marles-Greenberg-Persaud syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oculotrichoanal syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Oculotrichoanal syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009560</skos:exactMatch>
        <skos:exactMatch>MeSH:C536022</skos:exactMatch>
        <skos:exactMatch>OMIM:248450</skos:exactMatch>
        <skos:exactMatch>UMLS:C1855425</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2717"/>

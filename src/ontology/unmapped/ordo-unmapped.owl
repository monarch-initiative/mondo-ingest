    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_820 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_820">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_233655"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_496924"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_71281"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90077"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1839"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Sneddon&apos;s syndrome (SS) is a rare non-inflammatory thrombotic vasculopathy characterized by the combination of cerebrovascular disease with livedo racemosa.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ehrmann-Sneddon syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Livedo racemosa-cerebrovascular accident syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Livedo reticularis-cerebrovascular accident syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sneddon syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Sneddon syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:I77.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:4A44.6</skos:exactMatch>
        <skos:exactMatch>MONDO:0008436</skos:exactMatch>
        <skos:exactMatch>MeSH:D018860</skos:exactMatch>

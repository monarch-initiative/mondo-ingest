        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_619249"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93446"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2197"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2198"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare systemic disease characterized by the association of the features of Ehlers-Danlos syndrome with those of osteogenesis imperfecta. Predominant clinical manifestations include generalized joint hypermobility and dislocations, skin hyperextensibility and/or translucency, easy bruising, and invariable association with mild signs of osteogenesis imperfecta, including short stature, blue sclera, and osteopenia or fractures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EDS/OI syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ehlers-Danlos/osteogenesis imperfecta syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ehlers-Danlos/osteogenesis imperfecta syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q79.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD28.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016470</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518787</skos:exactMatch>
        <skos:narrowMatch>OMIM:619115</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619120</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_230857"/>

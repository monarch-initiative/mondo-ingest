        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare abdominal wall malformation characterized by the bowel protruding from the fetal abdomen on the right lateral base of the umbilical cord, and without a covering sac.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Gastroschisis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Laparoschisis</oboInOwl:hasExactSynonym>
        <rdfs:label>Gastroschisis</rdfs:label>
        <skos:exactMatch>ICD-10:Q79.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:LB02</skos:exactMatch>
        <skos:exactMatch>MONDO:0009264</skos:exactMatch>
        <skos:exactMatch>MeSH:D020139</skos:exactMatch>
        <skos:exactMatch>MedDRA:10018046</skos:exactMatch>
        <skos:exactMatch>OMIM:230750</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265706</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

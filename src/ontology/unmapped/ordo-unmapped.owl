            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9587"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia characterized by growth delay, generalized and progressive craniotubular hyperostosis, intellectual disability, distinct craniofacial appearance, dental anomalies, loose skin, and distal-limb anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Lenz-Majewski hyperostotic dwarfism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lenz-Majewski hyperostotic dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lenz-Majewski syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lenz-Majewski hyperostotic dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007892</skos:exactMatch>
        <skos:exactMatch>MeSH:C537115</skos:exactMatch>
        <skos:exactMatch>OMIM:151050</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432269</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

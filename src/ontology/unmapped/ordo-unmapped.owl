            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare peripheral neuropathy characterized by the association of an axonal sensory and autonomic neuropathy with hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked HSAN with deafness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked HSAN with hearing loss</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_1570 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1570">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498451"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Symbrachydactyly of hands and feet is a rare, non-syndromic limb reduction defect disorder characterized by unilateral or bilateral brachydactyly, cutaneous syndactyly and global hypoplasia of the hand and/or foot, with underlying muscles, tendons, ligaments and bones being affected but without other associated limb anomalies. Patients typically present short, stiff, webbed or missing fingers and/or toes which are often replaced with small stumps (nubbins) with residual nails.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">De Smet-Fabry-Fryns syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Symbrachydactyly of hands and feet</oboInOwl:hasExactSynonym>
        <rdfs:label>Symbrachydactyly of hands and feet</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB75.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0015516</skos:exactMatch>
        <skos:exactMatch>MeSH:C538062</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931719</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1570"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Symbrachydactyly of hands and feet</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1571 -->


        <obo:IAO_0000115 xml:lang="en">Neurofibromatosis type 1 (NF1) is a clinically heterogeneous, neurocutaneous genetic disorder characterized by café-au-lait spots, iris Lisch nodules, axillary and inguinal freckling, and multiple neurofibromas.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neurofibromatosis type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nonmosaic NF1</oboInOwl:hasExactSynonym>

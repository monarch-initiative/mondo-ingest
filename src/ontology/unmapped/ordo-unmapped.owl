    <!-- http://www.orpha.net/ORDO/Orphanet_85338 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85338">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_247765"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <obo:IAO_0000115 xml:lang="en">A rare, X-linked syndromic intellectual disability disorder characterized by non-progressive ataxia, apraxia, variable intellectual disability and/or visuospatial, visuographic and visuoconstructive dysfunctions in male patients. Seizures, congenital clubfoot and macroorchidism have also been associated. Partial clinical expression was noted in obligate female carriers. There have been no further descriptions in the literature since 1992.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked intellectual disability-ataxia-apraxia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked intellectual disability-ataxia-apraxia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G31.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A03.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019430</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305139</skos:exactMatch>
    </owl:Class>

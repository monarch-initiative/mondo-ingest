        <oboInOwl:hasExactSynonym>T-B+NK- severe combined immunodeficiency due to JAK3 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>T-B+NK- severe combined immunodeficiency due to JAK3 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D81.2</skos:broadMatch>

        <skos:broadMatch>ICD-10:E75.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E1</skos:broadMatch>
        <skos:broadMatch>OMIM:271900</skos:broadMatch>
        <skos:exactMatch>MONDO:0017830</skos:exactMatch>
        <skos:exactMatch>UMLS:C5575558</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_314911"/>

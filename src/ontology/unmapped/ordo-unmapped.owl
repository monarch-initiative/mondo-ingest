        <owl:annotatedTarget>Cleft palate-congenital heart defect-intellectual disability syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



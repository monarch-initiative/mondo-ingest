    <!-- http://www.orpha.net/ORDO/Orphanet_424039 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_424039">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217074"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare epithelial tumor of the exocrine pancreas, histologically characterized by presence of keratinization and/or intracellular bridges and lymphovascular and perineural invasion, as well as high metastatic potential. Patients present with upper abdominal and back pain, anorexia, weight loss, nausea, vomiting and jaundice.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Pancreatic squamous cell carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Squamous cell carcinoma of pancreas</oboInOwl:hasExactSynonym>
        <rdfs:label>Squamous cell carcinoma of pancreas</rdfs:label>
        <skos:broadMatch>ICD-11:2C10.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018521</skos:exactMatch>
        <skos:exactMatch>UMLS:C2675993</skos:exactMatch>
        <skos:narrowMatch>ICD-10:C25.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C25.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C25.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C25.7</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C25.8</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_424039"/>

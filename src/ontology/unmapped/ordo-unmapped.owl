            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, developmental and epileptic encephalopathy characterized by infantile onset of intractable seizures that are often febrile, and associated with cognitive and motor impairment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dravet syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SMEI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe myoclonic epilepsy of infancy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe myoclonus epilepsy of infancy</oboInOwl:hasExactSynonym>
        <rdfs:label>Dravet syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G40.4</skos:broadMatch>

        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Atypical HUS with thrombomodulin anomaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: D- HUS with thrombomodulin anomaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Hemolytic uremic syndrome without diarrhea with thrombomodulin anomaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: aHUS with thrombomodulin anomaly</oboInOwl:hasExactSynonym>

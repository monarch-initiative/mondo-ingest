            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital skin disease defined as an abnormality of the structure of the scalp hair and characterized by extreme kinkiness of the hair.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial woolly hair syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial wooly hair syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary woolly hair syndrome</oboInOwl:hasExactSynonym>

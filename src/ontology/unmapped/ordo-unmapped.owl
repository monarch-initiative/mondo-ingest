            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2201"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic connective tissue disorder typically characterized by the association of unexpected organ fragility (arterial/bowel/gravid uterine rupture) with inconstant physical features as thin, translucent skin, easy bruising and acrogeric traits.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arterial-ecchymotic EDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EDS IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ehlers-Danlos syndrome type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sack-Barabas syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vascular EDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vascular Ehlers-Danlos syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vEDS</oboInOwl:hasExactSynonym>
        <rdfs:label>Vascular Ehlers-Danlos syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q79.6</skos:broadMatch>

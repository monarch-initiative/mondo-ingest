    <!-- http://www.orpha.net/ORDO/Orphanet_238305 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_238305">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

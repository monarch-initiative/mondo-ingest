    <!-- http://www.orpha.net/ORDO/Orphanet_314022 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_314022">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140162"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_423776"/>

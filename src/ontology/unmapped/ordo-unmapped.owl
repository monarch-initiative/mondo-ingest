        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare vascular calcification disorder typically characterized by occlusion of microvessels in the cutaneous tissue resulting in painful cutaneous lesions. The disorder is often life-limiting.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Calciphylaxis</oboInOwl:hasExactSynonym>
        <rdfs:label>Calciphylaxis</rdfs:label>
        <skos:broadMatch>ICD-10:E83.5</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_93279 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93279">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_253"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined immunodeficiency due to partial RAG1 deficiency is a form of combined T and B cell immunodeficiency (CID) characterized by severe and persistent cytomegalovirus (CMV) infection and autoimmune cytopenia.</obo:IAO_0000115>

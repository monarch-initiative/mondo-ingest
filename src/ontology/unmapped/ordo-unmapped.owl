        <oboInOwl:hasExactSynonym xml:lang="en">Xq27.3-q28 microduplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Xq27.3q28 duplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dup(x)(q27.3q28)</oboInOwl:hasExactSynonym>
        <rdfs:label>Xq27.3q28 duplication syndrome</rdfs:label>

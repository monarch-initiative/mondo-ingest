    <!-- http://www.orpha.net/ORDO/Orphanet_363741 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363741">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

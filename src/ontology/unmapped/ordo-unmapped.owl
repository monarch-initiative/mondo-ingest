        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_622914"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6441"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">White sponge nevus (WSN) is a rare and autosomal dominant genetic disease in which the oral mucosa is white or greyish, thickened, folded, and spongy. The onset is early in life, and both sexes are affected equally. Other common sites include the tongue, floor of the mouth, and alveolar mucosa.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary mucosal leukokeratosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>White sponge nevus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">White sponge nevus of Cannon</oboInOwl:hasExactSynonym>
        <rdfs:label>White sponge nevus</rdfs:label>
        <skos:broadMatch>ICD-10:Q38.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA02.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0015748</skos:exactMatch>
        <skos:exactMatch>MeSH:D053529</skos:exactMatch>
        <skos:exactMatch>MedDRA:10072666</skos:exactMatch>
        <skos:exactMatch>OMIM:193900</skos:exactMatch>
        <skos:exactMatch>UMLS:C1721005</skos:exactMatch>
        <skos:narrowMatch>OMIM:615785</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_171723"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>White sponge nevus</owl:annotatedTarget>

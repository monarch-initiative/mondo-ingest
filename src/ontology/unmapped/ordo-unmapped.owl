        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive distal renal tubular acidosis without hearing loss</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal renal tubular acidosis type 1c</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">dRTA type 1c</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_139436 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139436">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_157987"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

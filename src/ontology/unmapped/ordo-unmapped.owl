            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Clouston syndrome (or hidrotic ectodermal dysplasia) is characterised by the clinical triad of nail dystrophy, alopecia, and palmoplantar hyperkeratosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Clouston syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hidrotic ectodermal dysplasia</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Primary dystonia, DYT21 type is a subtype of mixed dystonia with a late-onset form of pure torsion dystonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DYT21</oboInOwl:hasExactSynonym>

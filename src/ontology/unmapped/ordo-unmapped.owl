    <!-- http://www.orpha.net/ORDO/Orphanet_95457 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95457">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98721"/>
        <obo:IAO_0000115 xml:lang="en">A rare, congenital, non-syndromic heart malformation characterized by partial or complete absence of tricuspid valve tissue and its apparatus, with an existing orifice. It can be isolated or associated with other heart anomalies. Clinical presentation is variable and may include syncope, arrhythmias, cyanosis, right heart dilatation and failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital unguarded tricuspid orifice</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tricuspid valve agenesis</oboInOwl:hasExactSynonym>
        <rdfs:label>Tricuspid valve agenesis</rdfs:label>
        <skos:broadMatch>ICD-10:Q22.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA87.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019811</skos:exactMatch>
        <skos:exactMatch>UMLS:C0685715</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_95457"/>

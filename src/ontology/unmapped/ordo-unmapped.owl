    <!-- http://www.orpha.net/ORDO/Orphanet_293202 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_293202">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_3394"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, soft tissue tumor characterized by high incidence of local recurrence, regional lymph node involvement and distant metastases. It commonly affects the soft tissue under the skin of a finger, hand, forearm, lower leg or foot, less often other areas of the body.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Epithelioid sarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Epithelioid sarcoma</rdfs:label>
        <skos:broadMatch>ICD-10:C49.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:2B5F.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH4F96</skos:exactMatch>
        <skos:exactMatch>MONDO:0017387</skos:exactMatch>
        <skos:exactMatch>MedDRA:10015099</skos:exactMatch>
        <skos:exactMatch>UMLS:C0205944</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_293202"/>

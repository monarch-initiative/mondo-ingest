    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_420699 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_420699">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_439849"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

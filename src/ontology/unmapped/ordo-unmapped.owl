    <!-- http://www.orpha.net/ORDO/Orphanet_91358 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91358">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, non-syndromic, congenital esophageal malformation characterized by a false diverticulum, most often located in the upper, posterior esophagus (pharyngo-esophageal) but may occur anywhere along the esophagus (mid-thoracic or epiphrenic). Many patients are asymptomatic, but bad breath, chronic cough, respiratory distress, food regurgitation, dysphagia, chest pain or discomfort, and aspiration pneumonia are typical presenting manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital esophageal diverticulum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital esophageal pouch</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital esophageal diverticulum</rdfs:label>
        <skos:broadMatch>ICD-10:Q39.6</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB12.4</skos:exactMatch>
        <skos:exactMatch>MONDO:0019620</skos:exactMatch>
        <skos:exactMatch>UMLS:C0266133</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_91358"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital esophageal diverticulum</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_91359 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91359">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264694"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Chronic pneumonitis of infancy is a rare pediatric form of interstitial lung disease (ILD).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CPI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic pneumonitis of infancy</oboInOwl:hasExactSynonym>
        <rdfs:label>Chronic pneumonitis of infancy</rdfs:label>
        <skos:broadMatch>ICD-10:J84.0</skos:broadMatch>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_929 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_929">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108961"/>

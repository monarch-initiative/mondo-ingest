            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism that is characterized by progressive external ophthalmoplegia (PEO), pigmentary retinitis and an onset before the age of 20 years. Common additional features include deafness, cerebellar ataxia and heart block.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Kearns-Sayre syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Kearns-Sayre syndrome</rdfs:label>

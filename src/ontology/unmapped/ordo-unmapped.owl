                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9817"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, movement disorder characterized by involuntary movements on one side of the body that mirror intentional movements on the opposite side of the body, which are present in various first-degree members of a family, persist beyond the first decade of life, and have no associated comorbidities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial congenital controlateral synkinesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial congenital mirror movements</oboInOwl:hasExactSynonym>

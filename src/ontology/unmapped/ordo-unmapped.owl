    <!-- http://www.orpha.net/ORDO/Orphanet_2865 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2865">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Short stature-webbed neck-heart disease syndrome is characterized by short stature, intellectual deficit, facial dysmorphism, short webbed neck, skin changes and congenital heart defects. It has been reported in four Arab Bedouin sibs born to consanguineous parents.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Al Gazali-Aziz-Salem syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short stature-webbed neck-heart disease syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Short stature-webbed neck-heart disease syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0017315</skos:exactMatch>
        <skos:exactMatch>MeSH:C535613</skos:exactMatch>
        <skos:exactMatch>UMLS:C2930950</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2865"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Short stature-webbed neck-heart disease syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2866 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2866">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis malformation syndrome characterized by proportionate short stature, sensorineural deafness, mutism, facial dysmorphism and recurrent infections as a result of abnormal neutrophil chemotaxis. There have been no further descriptions in the literature since 1978.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Short stature-deafness-neutrophil dysfunction-dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Short stature-hearing loss-neutrophil dysfunction-dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Thong-Douglas-Ferrante syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Short stature-deafness-neutrophil dysfunction-dysmorphism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017316</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274785</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2866"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Short stature-deafness-neutrophil dysfunction-dysmorphism syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2867 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2867">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93450"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia characterized by severe intrauterine and postnatal growth retardation and short stature in association with craniofacial dysmorphism (such as large forehead, triangular face, low-set ears, and micro-retrognathism) and osteochondrodysplastic lesions. Radiographic findings include epiphyseal maturation delay, abnormal metaphyses, a narrow thorax, small pelvis, and short and broad metacarpal bones and phalanges. There have been no further descriptions in the literature since 1996.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Mievis-Verellen-Dumoulin syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short stature, Brussels type</oboInOwl:hasExactSynonym>
        <rdfs:label>Short stature, Brussels type</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011046</skos:exactMatch>
        <skos:exactMatch>MeSH:C537121</skos:exactMatch>
        <skos:exactMatch>OMIM:601350</skos:exactMatch>
        <skos:exactMatch>UMLS:C1832439</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2867"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Short stature, Brussels type</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2868 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2868">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Short stature-valvular heart disease-characteristic facies syndrome is characterised by severe short stature with disproportionately short legs, small hands, clinodactyly, valvular heart disease and dysmorphism (ptosis, high-arched palate, abnormal dentition). It has been described in a mother and two daughters. This syndrome is probably transmitted as an autosomal dominant trait.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Short stature-valvular heart disease-characteristic facies syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Short stature-valvular heart disease-characteristic facies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0007461</skos:exactMatch>
        <skos:exactMatch>OMIM:126190</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274784</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2868"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Short stature-valvular heart disease-characteristic facies syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2869 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2869">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104010"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183422"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271835"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_589746"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79375"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98196"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11389"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A genetic intestinal polyposis syndrome characterized by development of characteristic hamartomatous polyps throughout the gastrointestinal (GI) tract, and by mucocutaneous pigmentation. This disorder carries a considerably increased risk of GI and extra-GI malignancies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hamartomatous intestinal polyposis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PJS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Peutz-Jeghers syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Peutz-Jeghers syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q85.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD2D.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0008280</skos:exactMatch>
        <skos:exactMatch>MeSH:D010580</skos:exactMatch>
        <skos:exactMatch>MedDRA:10034764</skos:exactMatch>
        <skos:exactMatch>OMIM:175200</skos:exactMatch>
        <skos:exactMatch>UMLS:C0031269</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Peutz-Jeghers syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_287 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_287">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108979"/>

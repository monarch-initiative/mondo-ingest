            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Leukonychia totalis is a rare nail anomaly disorder characterized by complete white discoloration of the nails. Patients typically present white, chalky nails as an isolated finding, although other cutaneous or systemic manifestations could also be present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Leukonychia totalis</oboInOwl:hasExactSynonym>

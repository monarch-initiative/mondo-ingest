    <!-- http://www.orpha.net/ORDO/Orphanet_360 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_360">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251561"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Glioblastomas are malignant astrocytic tumors (grade IV according to the WHO classification).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GBM</oboInOwl:hasExactSynonym>

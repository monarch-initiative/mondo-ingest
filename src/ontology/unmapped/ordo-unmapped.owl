    <!-- http://www.orpha.net/ORDO/Orphanet_411986 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_411986">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

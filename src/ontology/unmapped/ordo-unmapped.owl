            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11204"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare skeletal dysplasia characterized by peculiar facial anomalies, Pierre Robin sequence, cleft palate, shortening and bowing of long bones. Sexual ambiguity or female external genitalia is possible in individuals with a male karyotype.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Campomelic dwarfism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Campomelic dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Campomelic dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2A.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007251</skos:exactMatch>
        <skos:exactMatch>MeSH:D055036</skos:exactMatch>
        <skos:exactMatch>OMIM:114290</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861922</skos:exactMatch>
        <skos:narrowMatch>OMIM:211990</skos:narrowMatch>
        <skos:narrowMatch>OMIM:602196</skos:narrowMatch>
    </owl:Class>

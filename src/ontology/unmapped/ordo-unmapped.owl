            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Borjeson-Forssman-Lehmann syndrome (BFLS) is a rare X-linked obesity syndrome characterized by intellectual deficit, truncal obesity, characteristic facial features, hypogonadism, tapered fingers and short toes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BFLS</oboInOwl:hasExactSynonym>

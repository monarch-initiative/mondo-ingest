    <!-- http://www.orpha.net/ORDO/Orphanet_141234 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_141234">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_141229"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <oboInOwl:hasExactSynonym>Median facial cleft</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Midline facial cleft</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tessier number 0-14 and 30 facial cleft</oboInOwl:hasExactSynonym>
        <rdfs:label>Median facial cleft</rdfs:label>
        <skos:exactMatch>MONDO:15412</skos:exactMatch>
        <skos:exactMatch>UMLS:C4022007</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_141234"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

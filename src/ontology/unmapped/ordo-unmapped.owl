        <obo:IAO_0000115 xml:lang="en">The newly described 5q14.3 microdeletion syndrome includes severe intellectual deficit with no speech, stereotypic movements and epilepsy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>5q14.3 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Brain abnormalities-severe developmental delay-facial dysmorphism-intellectual disability syndrome due to 5q14.3 microdeletion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(5)(q14.3)</oboInOwl:hasExactSynonym>

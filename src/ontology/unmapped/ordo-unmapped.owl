    <!-- http://www.orpha.net/ORDO/Orphanet_3161 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3161">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108993"/>

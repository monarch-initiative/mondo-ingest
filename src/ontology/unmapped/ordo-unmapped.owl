    <!-- http://www.orpha.net/ORDO/Orphanet_983 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_983">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_325118"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98313"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17210"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Testicular regression syndrome (TRS) is a developmental anomaly characterized by the absence of one or both testicles with partial or complete absence of testicular tissue. TRS may vary from normal male with unilateral no-palpable testis through phenotypic male with micropenis, to phenotypic female. The phenotype depends on the extent and timing of the intrauterine accident in relation to sexual development.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ETRS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Embryonic testicular regression syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TRS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Testicular regression syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vanishing testes syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vanishing testis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XY gonadal agenesis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Testicular regression syndrome</rdfs:label>
        <skos:broadMatch>ICD-11:LD2A.Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q55.0</skos:exactMatch>
        <skos:exactMatch>MONDO:8000015</skos:exactMatch>
        <skos:exactMatch>OMIM:273250</skos:exactMatch>
        <skos:exactMatch>UMLS:C0266427</skos:exactMatch>
    </owl:Class>

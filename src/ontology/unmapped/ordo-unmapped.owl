        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1423 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1423">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93465"/>
        <obo:IAO_0000115 xml:lang="en">Lethal recessive chondrodysplasia is an extremely rare lethal form of chondrodysplasia characterized by severe micromelic dwarfism, short and incurved limbs with normal hands and feet, facial dysmorphism (disproportionately large skull, frontal prominence, slightly flattened nasal bridge and short neck), muscular hypotonia, hyperlaxity of the extremities, and a narrow thorax. Most patients die of respiratory distress during the first hours or weeks of life. There have been no further descriptions in the literature since 1988.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lethal recessive chondrodysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maroteaux-Stanescu-Cousin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lethal recessive chondrodysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB82.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015425</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304745</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1423"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lethal recessive chondrodysplasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1425 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1425">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139030"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93441"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19721"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/24290"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Desbuquois syndrome (DBQD) is an osteochondrodysplasia characterized by severe micromelic dwarfism, facial dysmorphism, joint laxity with multiple dislocations, vertebral and metaphyseal abnormalities and advanced carpotarsal ossification. Two forms have been distinguished on the basis of the presence (type 1) or the absence (type 2) of characteristic hand anomalies. A variant form of DBQD, Kim variant, has also been described and is characterized by short stature and articular, minor facial and significant hand anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DBQD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Desbuquois dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Desbuquois syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Desbuquois syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.E</skos:broadMatch>
        <skos:exactMatch>MONDO:0015426</skos:exactMatch>
        <skos:exactMatch>MeSH:C535943</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432242</skos:exactMatch>
        <skos:narrowMatch>OMIM:251450</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615777</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618870</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Desbuquois syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1426 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1426">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79195"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93442"/>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3207 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3207">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_199639"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_251071 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251071">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165707"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_261920"/>

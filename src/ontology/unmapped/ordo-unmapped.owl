    <!-- http://www.orpha.net/ORDO/Orphanet_307 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_307">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306759"/>

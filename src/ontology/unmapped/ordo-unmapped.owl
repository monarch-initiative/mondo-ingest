    <!-- http://www.orpha.net/ORDO/Orphanet_99898 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99898">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_319535"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

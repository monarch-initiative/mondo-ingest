        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68356"/>
        <obo:IAO_0000115 xml:lang="en">Pelizaeus-Merzbacher disease (PMD) is an X-linked leukodystrophy characterized by developmental delay, nystagmus, hypotonia, spasticity, and variable intellectual deficit. It is classified into three sub-forms based on the age of onset and severity: connatal, transitional, and classic PMD.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse familial brain sclerosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pelizaeus-Merzbacher brain sclerosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pelizaeus-Merzbacher disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sudanophilic leukodystrophy, Paelizeus-Merzbacher type</oboInOwl:hasExactSynonym>
        <rdfs:label>Pelizaeus-Merzbacher disease</rdfs:label>
        <skos:broadMatch>ICD-10:E75.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:8A44.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0010714</skos:exactMatch>
        <skos:exactMatch>MeSH:D020371</skos:exactMatch>
        <skos:exactMatch>MedDRA:10067610</skos:exactMatch>
        <skos:exactMatch>OMIM:312080</skos:exactMatch>
        <skos:exactMatch>UMLS:C0205711</skos:exactMatch>
        <skos:narrowMatch>OMIM:213900</skos:narrowMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_168782 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168782">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_168778"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Childhood disintergrative disorder is a rare pervasive developmental disorder with a disease onset before the age of three and characterized by a dramatic loss of behavioral and developmental functioning after atleast two years of normal development. Manifestations of the disease include loss of speech, incontinence, communication and social interaction problems, stereotypical autistic behaviors and dementia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Childhood disintegrative disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dementia infantilis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Heller syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Childhood disintegrative disorder</rdfs:label>
        <skos:broadMatch>ICD-11:6A02.3</skos:broadMatch>
        <skos:exactMatch>ICD-10:F84.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0015681</skos:exactMatch>
        <skos:exactMatch>MedDRA:10008522</skos:exactMatch>
        <skos:exactMatch>UMLS:C0236791</skos:exactMatch>
    </owl:Class>

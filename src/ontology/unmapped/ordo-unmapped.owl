                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/23161"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>

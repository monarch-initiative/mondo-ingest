        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_402003 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_402003">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_307846"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20406"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, isolated, focal palmoplantar keratoderma disease characterized by focal thickening of the skin of the soles, and often of the palms, associated with minimal or no nail involvement. Patients frequently present non-epidermolytic painful plantar blistering and, occasionally, subtle oral leukokeratosis or plantar hyperhidrosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant focal non-epidermolytic palmoplantar keratoderma with plantar blistering</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant focal non-epidermolytic palmoplantar keratoderma with plantar blistering</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.31</skos:broadMatch>
        <skos:exactMatch>MONDO:0014327</skos:exactMatch>
        <skos:exactMatch>OMIM:615735</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190822</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_402003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autosomal dominant focal non-epidermolytic palmoplantar keratoderma with plantar blistering</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <obo:IAO_0000115 xml:lang="en">Peripartum cardiomyopathy (PPCM) is an idiopathic, potentially fatal form of dilated cardiomyopathy that develops during the final month of pregnancy or within five months after delivery.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Peripartum cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Postpartum cardiomyopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Peripartum cardiomyopathy</rdfs:label>
        <skos:exactMatch>ICD-10:O90.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:JB44.3</skos:exactMatch>

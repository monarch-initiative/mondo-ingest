    <!-- http://www.orpha.net/ORDO/Orphanet_1778 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1778">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Facial dysmorphism-shawl scrotum-joint laxity syndrome is characterised by facial dysmorphism (hypertelorism, telecanthus, downslanting palpebral fissures, ptosis, malar hypoplasia, broad nasal bridge, thin upper lip, smooth philtrum, and low-set prominent ears) and associated with joint anomalies (genu valgum or cubitus valgus, hyper-extensible joints, etc.). It has been described in two patients (a mother and her son). The boy also had hypoplastic shawl scrotum and cryptorchidism, and the mother had mild intellectual deficit.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Facial dysmorphism-shawl scrotum-joint laxity syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Seaver-Cassidy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Facial dysmorphism-shawl scrotum-joint laxity syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0015781</skos:exactMatch>
        <skos:exactMatch>MeSH:C537529</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931522</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1778"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Facial dysmorphism-shawl scrotum-joint laxity syndrome</owl:annotatedTarget>

    <!-- http://www.orpha.net/ORDO/Orphanet_2547 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2547">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1037"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_202948"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_459787"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_471383"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare lethal multiple congenital anomalies/dysmorphic syndrome characterized by the association of fetal akinesia sequence, bilateral microphthalmia, microtia, and persistent truncus arteriosus. Additional dysmorphic features include prominent forehead, small nose, micrognathia, as well as camptodactyly and symphalangism. Contractures of large joints and micropenis have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microphthalmia-microtia-fetal akinesia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Thomas-Jewett-Raines syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Microphthalmia-microtia-fetal akinesia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q68.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0043143</skos:exactMatch>
        <skos:exactMatch>MeSH:C536513</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931224</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2547"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Microphthalmia-microtia-fetal akinesia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

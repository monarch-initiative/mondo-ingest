        <skos:exactMatch>MedDRA:10071755</skos:exactMatch>
        <skos:exactMatch>OMIM:186580</skos:exactMatch>
        <skos:exactMatch>UMLS:C5201146</skos:exactMatch>
    </owl:Class>

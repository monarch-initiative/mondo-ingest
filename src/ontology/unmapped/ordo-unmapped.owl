    <!-- http://www.orpha.net/ORDO/Orphanet_26791 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_26791">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206953"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217591"/>

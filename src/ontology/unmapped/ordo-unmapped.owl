        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Brain-lung-thyroid syndrome is a rare disorder characterized by congenital hypothyroidism (CH), infant respiratory distress syndrome (IRDS) and benign hereditary chorea (BHC).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Brain-lung-thyroid syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Choreoathetosis-hypothyroidism-neonatal respiratory distress syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Brain-lung-thyroid syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E03.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:CB04.5</skos:exactMatch>
        <skos:exactMatch>MONDO:0012593</skos:exactMatch>
        <skos:exactMatch>MeSH:C567034</skos:exactMatch>
        <skos:exactMatch>OMIM:610978</skos:exactMatch>
        <skos:exactMatch>UMLS:C1970269</skos:exactMatch>
    </owl:Class>

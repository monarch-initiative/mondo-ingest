        <obo:IAO_0000115 xml:lang="en">Portal vein thrombosis (PVT) is associated with acute (recent) or chronic (long-standing) thrombosis of the portal system.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-cirrhotic and non-tumoral portal vein thrombosis</oboInOwl:hasExactSynonym>

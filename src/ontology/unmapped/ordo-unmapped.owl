    <!-- http://www.orpha.net/ORDO/Orphanet_99942 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99942">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_64746"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7225"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of axonal Charcot-Marie-Tooth disease, a peripheral sensorimotor neuropathy, characterized by a late onset with severe sensory loss (paresthesia and hypoesthesia) associated with distal weakness, mainly of the legs, and absent or reduced deep tendon reflexes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant Charcot-Marie-Tooth disease type 2I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CMT2I</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant Charcot-Marie-Tooth disease type 2I</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C20.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0011889</skos:exactMatch>
        <skos:exactMatch>MeSH:C535416</skos:exactMatch>
        <skos:exactMatch>OMIM:607677</skos:exactMatch>
        <skos:exactMatch>UMLS:C3888087</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_99942"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autosomal dominant Charcot-Marie-Tooth disease type 2I</owl:annotatedTarget>

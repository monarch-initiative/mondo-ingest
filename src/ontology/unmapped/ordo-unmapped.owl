    <!-- http://www.orpha.net/ORDO/Orphanet_34514 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_34514">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102015"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209056"/>

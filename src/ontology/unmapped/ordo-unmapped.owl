    <!-- http://www.orpha.net/ORDO/Orphanet_247868 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247868">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290842"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_324924"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

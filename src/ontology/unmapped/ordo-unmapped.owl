        <obo:IAO_0000115 xml:lang="en">A rare multi-system disorder characterized by oculocutaneous albinism, bleeding diathesis and, in some cases, neutropenia, pulmonary fibrosis, or granulomatous colitis. The clinical subtypes of Hermansky-Pudlak syndrome (HPS) often present the same clinical phenotype but have different associated complications with varying degrees of severity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hermansky-Pudlak syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hermansky-Pudlak syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E70.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC23.20</skos:broadMatch>
        <skos:exactMatch>MONDO:0019312</skos:exactMatch>

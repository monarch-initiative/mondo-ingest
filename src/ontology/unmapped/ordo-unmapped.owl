    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_163631">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_284385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506210"/>

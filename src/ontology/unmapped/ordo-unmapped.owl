        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare acquired developmental anomaly syndrome characterized by skin, neurological, ocular, limbs and growth defects secondary to maternal Varicella-Zoster Virus (VZV) infection.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Antenatal varicella virus infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital varicella syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mother-to-child transmission of varicella syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital varicella syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:P35.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:KA62.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0017372</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275251</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

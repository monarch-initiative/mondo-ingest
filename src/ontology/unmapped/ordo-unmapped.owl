        <skos:exactMatch>MONDO:15816</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680498</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_178548"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Indolent primary cutaneous T-cell lymphoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_178551 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_178551">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_171901"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <oboInOwl:hasExactSynonym>Aggressive primary cutaneous T-cell lymphoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Aggressive primary cutaneous T-cell lymphoma</rdfs:label>
        <skos:exactMatch>MONDO:15817</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680497</skos:exactMatch>
    </owl:Class>

                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8975"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/950"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, mostly benign, neoplastic disease characterized by a primary tumor of the meninges, usually located intracranially (~90%) but spinal meningiomas occur as well. Clinical symptoms relate to the location of the tumor and may include seizures, focal neurological deficits (sensory-motor or visual symptoms, cranial nerve dysfunction), vascular complications (occlusion of cerebral blood vessels, deep venous thrombosis, pulmonary embolism), chronically increased intracranial pressure neurocognitive impairment and/or loss of bladder/anus sphincter control.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Meningioma</oboInOwl:hasExactSynonym>
        <rdfs:label>Meningioma</rdfs:label>
        <skos:broadMatch>ICD-10:D32.9</skos:broadMatch>
        <skos:exactMatch>ICD-11:2A01.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0016642</skos:exactMatch>
        <skos:exactMatch>MeSH:D008579</skos:exactMatch>
        <skos:exactMatch>MedDRA:10027191</skos:exactMatch>
        <skos:exactMatch>UMLS:C0025286</skos:exactMatch>
        <skos:narrowMatch>OMIM:606190</skos:narrowMatch>
    </owl:Class>

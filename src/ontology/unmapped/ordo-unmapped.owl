    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_199247 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_199247">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101954"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183637"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_250811"/>

        <owl:annotatedTarget>Autosomal dominant Charcot-Marie-Tooth disease type 2N</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

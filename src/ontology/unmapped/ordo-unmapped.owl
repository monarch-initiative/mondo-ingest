    <!-- http://www.orpha.net/ORDO/Orphanet_570371 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_570371">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_112"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16353"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of antenatal Bartter syndrome characterized by early maternal polyhydramnios, excessive renal salt loss with secondary metabolic alkalosis in the neonatal period that completely disappears within the first months of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bartter syndrome type 5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bartter syndrome type V</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Transient antenatal Bartter syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Bartter syndrome type 5</rdfs:label>
        <skos:broadMatch>ICD-10:E26.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB90.43</skos:broadMatch>
        <skos:exactMatch>MONDO:0010503</skos:exactMatch>

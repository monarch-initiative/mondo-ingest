            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">IVIC syndrome is a very rare genetic malformation syndrome characterized by upper limb anomalies (radial ray defects, carpal bone fusion), extraocular motor disturbances, and congenital bilateral non-progressive mixed hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>IVIC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oculo-oto-radial syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Radial ray defects, hearing impairment, external ophthalmoplegia, and thrombocytopenia</oboInOwl:hasExactSynonym>
        <rdfs:label>IVIC syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q71.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0007836</skos:exactMatch>
        <skos:exactMatch>MeSH:C535544</skos:exactMatch>
        <skos:exactMatch>OMIM:147750</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_977 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_977">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101960"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">An extremely rare genetic endocrine disease characterized by primary adrenal insufficiency, dystrophic myopathy, hepatic steatosis, severe psychomotor delay, megalocornea, failure to thrive, chronic constipation, and terminal bladder ectasia which can lead to death. There have been no further descriptions in the literature since 1982.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Adrenomyodystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Adrenomyodystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:E27.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A74.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010288</skos:exactMatch>
        <skos:exactMatch>MeSH:C538051</skos:exactMatch>
        <skos:exactMatch>OMIM:300270</skos:exactMatch>
        <skos:exactMatch>UMLS:C1846044</skos:exactMatch>
    </owl:Class>

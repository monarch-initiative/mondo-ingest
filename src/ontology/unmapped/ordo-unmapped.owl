    <!-- http://www.orpha.net/ORDO/Orphanet_180111 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_180111">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180086"/>

        <oboInOwl:hasExactSynonym xml:lang="en">Focal facial dermal dysplasia type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Focal facial dermal dysplasia type I</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_137807 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137807">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79381"/>
        <obo:IAO_0000115 xml:lang="en">A rare group of skin diseases characterized histologically by the extracellular accumulation of amyloid deposits in the dermis. Rare forms include lichen amyloidosus, X-linked reticulate pigmentary disorder, primary localized cutaneous nodular amyloidosis, and macular amyloidosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PLCA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary cutaneous amyloidosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary localized cutaneous amyloidosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary cutaneous amyloidosis</rdfs:label>
        <skos:broadMatch>ICD-11:5D00.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0015301</skos:exactMatch>
        <skos:exactMatch>MONDO:15301</skos:exactMatch>
        <skos:exactMatch>MeSH:C562642</skos:exactMatch>
        <skos:exactMatch>MedDRA:10011659</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268397</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_137807"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Primary cutaneous amyloidosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_137810 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137810">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_137807"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Primary localized cutaneous nodular amyloidosis (PLCNA) is the most rare form of primary cutaneous amyloidosis, a skin disease characterized by the accumulation of amyloid deposits in the dermis, characterized clinically by yellowish waxy crusted nodules and papules on the face, lower extremities, trunk, scalp, and genitalia and histologically by the localized deposition of immunoglobulin-derived amyloid in the papillary dermis and subcutis. PLCNA can be associated with connective tissue disorders such as Sjögren&apos;s syndrome and CREST syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Nodular cutaneous amyloidosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PLCNA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary localized cutaneous nodular amyloidosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Nodular cutaneous amyloidosis</rdfs:label>
        <skos:broadMatch>ICD-10:E85.4+</skos:broadMatch>
        <skos:broadMatch>ICD-10:L99.0*</skos:broadMatch>
        <skos:broadMatch>ICD-11:5D00.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0015302</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056953</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274331</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_137810"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Nodular cutaneous amyloidosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_137814 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137814">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_137807"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Macular amyloidosis (MA) is a rare chronic form of cutaneous amyloidosis, a skin disease characterized by the accumulation of amyloid deposits in the dermis, clinically characterized by pruritic hyperkeratotic gray-brown macules that give a rippled or reticulated pattern of pigmentation usually in the upper back and extensor sites of arms, forearms and legs, and histologically by the deposition of amyloid in the upper dermis and close to the basal cell layer of the epidermis. MA is commonly associated with other skin diseases, such as atopic dermatitis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Macular amyloidosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Macular amyloidosis</rdfs:label>
        <skos:broadMatch>ICD-10:E85.4+</skos:broadMatch>
        <skos:broadMatch>ICD-10:L99.0*</skos:broadMatch>
        <skos:broadMatch>ICD-11:5D00.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0015303</skos:exactMatch>
        <skos:exactMatch>UMLS:C0544839</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_137814"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Macular amyloidosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_137817 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137817">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98006"/>
        <obo:IAO_0000115 xml:lang="en">A chronic inflammation of the arachnoid layer of the meninges, of which adhesive arachnoiditis is the most severe form, characterized by debilitating, intractable neurogenic back and limb pain and a range of other neurological problems.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adhesive arachnoiditis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Arachnoiditis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chronic arachnoiditis</oboInOwl:hasExactSynonym>
        <rdfs:label>Arachnoiditis</rdfs:label>
        <skos:broadMatch>ICD-10:G03.9</skos:broadMatch>
        <skos:exactMatch>ICD-11:8E40.3</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_2123 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2123">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_210589"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Diffuse neonatal hemangiomatosis is a rare vascular tumor from unknown origin characterized by multiple, progressive, rapidly growing cutaneous hemangiomas (e.g. in the scalp, face, trunk and extremities) associated with widespread visceral hemangiomas in the liver, lungs, gastrointestinal tract, brain, and meninges.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse neonatal hemangiomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multifocal infantile haemangioma with extracutenous involvement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multifocal infantile hemangioma with extracutenous involvement</oboInOwl:hasExactSynonym>
        <rdfs:label>Multifocal infantile hemangioma with extracutenous involvement</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2E81.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016237</skos:exactMatch>
        <skos:exactMatch>UMLS:C0474965</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2123"/>

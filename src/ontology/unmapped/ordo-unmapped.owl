    <!-- http://www.orpha.net/ORDO/Orphanet_2997 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2997">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98578"/>
        <obo:IAO_0000115 xml:lang="en">Ptosis-vocal cord paralysis syndrome is a rare, hereditary disorder with ptosis characterized by the combination of congenital bilateral recurrent laryngeal nerve paralysis and congenital bilateral ptosis. There have been no further descriptions in the literature since 1983.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ptosis-vocal cord paralysis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tucker syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ptosis-vocal cord paralysis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:J38.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:CA0H.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008665</skos:exactMatch>
        <skos:exactMatch>MeSH:C536923</skos:exactMatch>
        <skos:exactMatch>OMIM:193240</skos:exactMatch>
        <skos:exactMatch>UMLS:C1860403</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2997"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ptosis-vocal cord paralysis syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



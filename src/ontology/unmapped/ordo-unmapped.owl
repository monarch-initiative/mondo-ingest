    <!-- http://www.orpha.net/ORDO/Orphanet_180151 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_180151">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182117"/>

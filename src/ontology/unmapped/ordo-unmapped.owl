    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_97361 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97361">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93101"/>
        <obo:IAO_0000115 xml:lang="en">A form of renal hypoplasia characterized by unilateral abnormally small kidneys with reduced number of nephrons. Patients are usually asymptomatic however some patients may present with hypertension and urinary tract infections. Risk of renal failure in childhood is minimal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Renal hypoplasia, unilateral</oboInOwl:hasExactSynonym>
        <rdfs:label>Renal hypoplasia, unilateral</rdfs:label>
        <skos:broadMatch>ICD-11:LB30.0Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q60.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0019979</skos:exactMatch>
        <skos:exactMatch>UMLS:C0431691</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97361"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Renal hypoplasia, unilateral</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_97362 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97362">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93101"/>
        <obo:IAO_0000115 xml:lang="en">A form of renal hypoplasia characterized by bilateral abnormally small kidneys with reduced number of nephrons. Patients are usually asymptomatic but may have hypertension, some excretory functional limitations, as well as eventual chronic renal failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Renal hypoplasia, bilateral</oboInOwl:hasExactSynonym>
        <rdfs:label>Renal hypoplasia, bilateral</rdfs:label>
        <skos:broadMatch>ICD-11:LB30.0Y</skos:broadMatch>

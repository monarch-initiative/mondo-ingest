        <oboInOwl:hasExactSynonym xml:lang="en">Myopathy due to succinate dehydrogenase and aconitase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myopathy with exercise intolerance, Swedish type</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary myopathy with lactic acidosis due to ISCU deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:G71.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.1</skos:broadMatch>

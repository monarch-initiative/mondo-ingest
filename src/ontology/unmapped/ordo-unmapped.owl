            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Joubert syndrome with hepatic defect is a very rare subtype of Joubert syndrome and related disorders (JSRD) characterized by the neurological features of JS associated with congenital hepatic fibrosis (CHF).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COACH syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cerebellar vermis hypoplasia-oligophrenia-congenital ataxia-coloboma-hepatic fibrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Gentile syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">JS-H</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Joubert syndrome with congenital hepatic fibrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Joubert syndrome with hepatic defect</oboInOwl:hasExactSynonym>
        <rdfs:label>Joubert syndrome with hepatic defect</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_2832 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2832">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Short tarsus - absence of lower eyelashes is a very rare syndrome characterized by the association of thin and short upper and lower tarsus and absence of the lower eyelashes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Lopes-Gorlin syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short tarsus-absence of lower eyelashes syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Short tarsus-absence of lower eyelashes syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0010855</skos:exactMatch>
        <skos:exactMatch>MeSH:C537036</skos:exactMatch>
        <skos:exactMatch>OMIM:600269</skos:exactMatch>
        <skos:exactMatch>UMLS:C1838328</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Short tarsus-absence of lower eyelashes syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2833 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2833">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3603"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Stiff skin syndrome is a rare, slowly progressive cutaneous disease characterized by rock-hard skin bound firmly to the underlying tissues (mainly on the shoulders, lower back, buttocks and thighs), mild hypertrichosis and hyperpigmentation overlying the affected areas of skin, as well as limited joint mobility (mainly of large joints) with flexion contractures. Cutaneous nodules, affecting mostly distal interphalangeal joints, as well as extracutaneous manifestations, including diffuse entrapment neuropathy, scoliosis, a tiptoe gait and a narrow thorax, may be associated. Restrictive pulmonary changes, muscle weakness, short stature and growth delay have also been reported. No vascular hyperreactivity, immunologic abnormalities nor visceral, muscular or bone involvement has been described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Stiff skin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Stiff skin syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:L98.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EE6Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008492</skos:exactMatch>
        <skos:exactMatch>MeSH:C566112</skos:exactMatch>
        <skos:exactMatch>MedDRA:10085085</skos:exactMatch>
        <skos:exactMatch>OMIM:184900</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861456</skos:exactMatch>
        <skos:narrowMatch>OMIM:228020</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2833"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Stiff skin syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2834 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2834">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_357058"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18481"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Wrinkly skin syndrome (WSS) is characterized by wrinkling of the skin of the dorsum of the hands and feet, an increased number of palmar and plantar creases, wrinkled abdominal skin, multiple skeletal abnormalities (joint laxity and congenital hip dislocation), late closing of the anterior fontanel, microcephaly, pre- and postnatal growth retardation, developmental delay and facial dysmorphism (a broad nasal bridge, downslanting palpebral fissures and hypertelorism).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">WSS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wrinkled skin syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wrinkly skin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Wrinkly skin syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2B</skos:broadMatch>
        <skos:exactMatch>MONDO:0010208</skos:exactMatch>
        <skos:exactMatch>MeSH:C536750</skos:exactMatch>
        <skos:exactMatch>OMIM:278250</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406587</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2834"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Wrinkly skin syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2835 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2835">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79370"/>
        <obo:IAO_0000115 xml:lang="en">Pectus excavatum-macrocephaly-dysplastic nails syndrome is a rare multiple congenital anomalies syndrome characterized by relative macrocephaly, pectus excavatum, short stature, nail dysplasia, and motor developmental delay (that resolves during childhood). There have been no further descriptions in the literature since 1992.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Pectus excavatum-macrocephaly-dysplastic nails syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Zori-Stalker-Williams syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Pectus excavatum-macrocephaly-dysplastic nails syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0010883</skos:exactMatch>
        <skos:exactMatch>MeSH:C536728</skos:exactMatch>
        <skos:exactMatch>OMIM:600399</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931302</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2835"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pectus excavatum-macrocephaly-dysplastic nails syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2836 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2836">

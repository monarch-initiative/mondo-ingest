    <!-- http://www.orpha.net/ORDO/Orphanet_231040 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231040">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

        <obo:IAO_0000115 xml:lang="en">8p11.2 deletion syndrome is a contiguous gene syndrome characterized by the association of congenital spherocytosis, dysmorphic features, growth delay and hypogonadotropic hypogonadism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>8p11.2 deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(8)(p11.2)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 8p11.2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(8)(p11.2)</oboInOwl:hasExactSynonym>
        <rdfs:label>8p11.2 deletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.81</skos:broadMatch>
        <skos:exactMatch>MONDO:0016657</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304505</skos:exactMatch>
    </owl:Class>

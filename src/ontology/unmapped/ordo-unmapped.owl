        <oboInOwl:hasExactSynonym xml:lang="en">Jamaican vomiting sickness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Jamaican vomiting syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Acute ackee fruit intoxication</rdfs:label>
        <skos:broadMatch>ICD-10:T62.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:NE61</skos:broadMatch>

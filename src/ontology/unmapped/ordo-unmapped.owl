    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_300888 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300888">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_289644"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_544"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Diffuse large B-cell lymphoma with chronic inflammation is an Epstein-Barr virus-associated malignant lymphoproliferative disorder, developing in a context of long-standing or slow-growing, chronically inflamed lesions, such as chronic pyothorax, metallic implants in bones and joints, chronic osteomyelitis, chronic venous ulcer, or, rarely granulomatous inflammation. The tumor is usually primarily localized, with no involvement of other organs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DLBCL with chronic inflammation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Diffuse large B-cell lymphoma with chronic inflammation</oboInOwl:hasExactSynonym>
        <rdfs:label>Diffuse large B-cell lymphoma with chronic inflammation</rdfs:label>
        <skos:broadMatch>ICD-10:C83.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0017601</skos:exactMatch>
        <skos:exactMatch>UMLS:C4511460</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_300888"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Diffuse large B-cell lymphoma with chronic inflammation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_300895 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300895">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98841"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/427"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A type of ALCL, a rare and aggressive peripheral T-cell non-Hodgkin lymphoma affecting lymph nodes and extranodal sites, which is characterized by the expression of a protein called anaplastic lymphoma kinase (ALK).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ALK+ ALCL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ALK+ anaplastic large cell lymphoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ALK-positive anaplastic large cell lymphoma</oboInOwl:hasExactSynonym>
        <rdfs:label>ALK-positive anaplastic large cell lymphoma</rdfs:label>
        <skos:exactMatch>ICD-10:C84.6</skos:exactMatch>
        <skos:exactMatch>ICD-11:2A90.A</skos:exactMatch>
        <skos:exactMatch>ICD-11:XH9484</skos:exactMatch>
        <skos:exactMatch>MONDO:0017602</skos:exactMatch>
        <skos:exactMatch>UMLS:C1332079</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_300895"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ALK-positive anaplastic large cell lymphoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_83450 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_83450">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_164001"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare orodental disease characterized by localized developmental anomaly of the dental tissues, with enamel and dentin hypomineralization affecting one (odontodysplasia) or several (regional odontodysplasia; ROD) teeth (deciduous and permanent, with teeth of the maxilla more frequently involved).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ghost teeth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Regional odontodysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Regional odontodysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:K00.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA07.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0019367</skos:exactMatch>
        <skos:exactMatch>UMLS:C0206554</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_83450"/>

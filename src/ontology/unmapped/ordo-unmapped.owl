        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <obo:IAO_0000115 xml:lang="en">A rare benign follicular hamartoma that develops primarily on the face of adults, with a particular predilection for the back of the nose, but also on the neck or scalp. It presents as a solitary hemispheric flesh-colored nodule with a central pore or black dot that may contain a tuft of hair.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Trichofolliculoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Trichofolliculoma</rdfs:label>
        <skos:broadMatch>ICD-10:D23.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LC01</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH0U05</skos:exactMatch>
        <skos:exactMatch>MONDO:0019445</skos:exactMatch>
        <skos:exactMatch>MeSH:C536553</skos:exactMatch>
        <skos:exactMatch>MedDRA:10044611</skos:exactMatch>
        <skos:exactMatch>UMLS:C0334262</skos:exactMatch>
    </owl:Class>

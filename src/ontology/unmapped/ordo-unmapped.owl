        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93446"/>
        <obo:IAO_0000115 xml:lang="en">Grant syndrome is a rare osteogenesis imperfecta-like disorder, described in two patients to date, characterized clinically by persistent wormian bones, blue sclera, mandibular hypoplasia, shallow glenoid fossa, and campomelia. There have been no further descriptions in the literature since 1986.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Grant syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Grant syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.KY</skos:broadMatch>
        <skos:exactMatch>MONDO:0007683</skos:exactMatch>

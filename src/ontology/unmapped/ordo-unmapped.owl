                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16400"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial cold urticaria (FCAS) is the mildest form of cryopyrin-associated periodic syndrome (CAPS) and is characterized by recurrent episodes of urticaria-like skin rash triggered by exposure to cold associated with low-grade fever, general malaise, eye redness and arthralgia/myalgia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FCAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FCU</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial cold autoinflammatory syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial cold urticaria</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial cold urticaria</rdfs:label>
        <skos:broadMatch>ICD-10:L50.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A60.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0018768</skos:exactMatch>
        <skos:exactMatch>MedDRA:10064570</skos:exactMatch>
        <skos:exactMatch>UMLS:C0343068</skos:exactMatch>
        <skos:narrowMatch>OMIM:120100</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_47045"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary disorder of renal phosphate wasting characterized by hypophosphatemia and hypercalciuria associated with rickets and/or osteomalacia. Other features include slow growth, short stature, skeletal deformities, muscle weakness and bone pain that are associated with normal or elevated plasma levels of calcitriol and hyperphosphaturia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HHRH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary hypophosphatemic rickets with hypercalciuria</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary hypophosphatemic rickets with hypercalciuria</rdfs:label>
        <skos:broadMatch>ICD-10:E83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C63.22</skos:broadMatch>
        <skos:exactMatch>MONDO:0009431</skos:exactMatch>
        <skos:exactMatch>MeSH:C562793</skos:exactMatch>
        <skos:exactMatch>OMIM:241530</skos:exactMatch>
        <skos:exactMatch>UMLS:C1853271</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_157215"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

        <rdfs:label>Congenital dyserythropoietic anemia type I</rdfs:label>
        <skos:broadMatch>ICD-10:D64.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A73</skos:broadMatch>
        <skos:exactMatch>MONDO:0020337</skos:exactMatch>
        <skos:exactMatch>OMIM:224120</skos:exactMatch>

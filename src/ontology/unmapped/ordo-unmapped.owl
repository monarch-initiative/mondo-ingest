    <!-- http://www.orpha.net/ORDO/Orphanet_261272 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_261272">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262968"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_210133 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_210133">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

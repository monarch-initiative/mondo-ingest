    <!-- http://www.orpha.net/ORDO/Orphanet_643 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_643">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98497"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4137"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Giant axonal neuropathy (GAN) is a severe, slowly progressive neurodegenerative disorder characterized by progressive motor and sensory peripheral neuropathy, central nervous system involvement (including pyramidal and cerebellar signs), and characteristic kinky hair in most cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GAN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Giant axonal neuropathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Giant axonal neuropathy</rdfs:label>
        <skos:broadMatch>ICD-10:G60.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009749</skos:exactMatch>
        <skos:exactMatch>MeSH:D056768</skos:exactMatch>
        <skos:exactMatch>OMIM:256850</skos:exactMatch>
        <skos:exactMatch>UMLS:C5200933</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_643"/>

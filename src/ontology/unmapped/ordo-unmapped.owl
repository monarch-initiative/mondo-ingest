        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98535"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by multifaceted motor system dysfunctions and cognitive defects such as asymmetric rigidity, bradykinesia, limb apraxia, and visuospatial dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Corticobasal syndrome</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_66634 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_66634">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217619"/>

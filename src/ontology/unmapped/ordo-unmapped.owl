    <!-- http://www.orpha.net/ORDO/Orphanet_600663 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_600663">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_168778"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Isolated glycerol kinase deficiency (GKD) is a very rare X-linked disorder of glycerol metabolism characterized biochemically by elevated plasma and urine glycerol levels, and clinically by variable neurometabolic manifestations, depending on the age of onset, and varying from a life-threatening childhood metabolic crisis to an asymptomatic adult form (infantile GKD, juvenile GKD, and adult GKD).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperglycerolemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated glycerol kinase deficiency</oboInOwl:hasExactSynonym>

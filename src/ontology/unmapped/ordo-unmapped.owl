    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_280586 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280586">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93441"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/26019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, primary bone dysplasia characterized by prenatal onset of disproportionate short stature, shortening of the limbs, congenital joint dislocations, micrognathia, posterior cleft palate, brachydactyly, short metacarpals and irregular size of the metacarpal epiphyses, supernumerary carpal ossification centers and dysmorphic facial features. In addition, hearing impairment and mild psychomotor delay have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Chondrodysplasia with joint dislocations, gPAPP type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">gPAPP deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Chondrodysplasia with joint dislocations, gPAPP type</rdfs:label>
        <skos:broadMatch>ICD-10:Q79.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.E</skos:broadMatch>
        <skos:exactMatch>MONDO:0013561</skos:exactMatch>
        <skos:exactMatch>OMIM:614078</skos:exactMatch>
        <skos:exactMatch>UMLS:C3279757</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_280586"/>

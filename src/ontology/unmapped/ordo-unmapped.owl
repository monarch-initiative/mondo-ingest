    <!-- http://www.orpha.net/ORDO/Orphanet_168601 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168601">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104006"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9490"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital enteropathy due to enteropeptidase deficiency is a rare, genetic, gastroenterological disease characterized by early-onset failure to thrive, edema, hypoproteinemia, diarrhea and fat malabsorption (or steatorrhea) in the presence of very low or absent trypsin activity in duodenal fluid. Celiac disease, or other pancreatic or mucosal disorders, may be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital enterokinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital enteropathy due to enteropeptidase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital enteropathy due to enteropeptidase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:K90.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009173</skos:exactMatch>
        <skos:exactMatch>MeSH:C562649</skos:exactMatch>
        <skos:exactMatch>OMIM:226200</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268416</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

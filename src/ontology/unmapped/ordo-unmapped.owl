    <!-- http://www.orpha.net/ORDO/Orphanet_627 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_627">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

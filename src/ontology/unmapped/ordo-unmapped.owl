    <!-- http://www.orpha.net/ORDO/Orphanet_254925 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_254925">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35696"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12420"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined oxidative phosphorylation defect type 4 is a rare mitochondrial disorder due to a defect in mitochondrial protein synthesis characterized by a neonatal onset of severe metabolic acidosis and respiratory distress, persistent lactic acidosis with episodes of metabolic crises, developmental regression, microcephaly, abnormal gaze fixation and pursuit, axial hypotonia with limb spasticity and reduced spontaneous movements. Neuroimaging studies reveal polymicrogyria, white matter abnormalities and multiple cystic brain lesions, including basal ganglia, and cerebral atrophy. Decreased activity of complex I and IV have been determined in muscle biopsy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COXPD4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Combined oxidative phosphorylation defect type 4</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined oxidative phosphorylation defect type 4</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.23</skos:broadMatch>
        <skos:exactMatch>MONDO:0012534</skos:exactMatch>
        <skos:exactMatch>MeSH:C565690</skos:exactMatch>
        <skos:exactMatch>OMIM:610678</skos:exactMatch>
        <skos:exactMatch>UMLS:C1857682</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_254925"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Combined oxidative phosphorylation defect type 4</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_254930 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_254930">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_497623"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/26784"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined oxidative phosphorylation defect type 7 is a rare mitochondrial disease due to a defect in mitochondrial protein synthesis characterized by a variable phenotype that includes onset in infancy or early childhood of failure to thrive and psychomotor regression (after initial normal development), as well as ocular manifestations (such as ptosis, nystagmus, optic atrophy, ophthalmoplegia and reduced vision). Additional manifestations include bulbar paresis with facial weakness, hypotonia, difficulty chewing, dysphagia, mild dysarthria, ataxia, global muscle atrophy, and areflexia. It has a relatively slow disease progression with patients often living into the third decade of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COXPD7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Combined oxidative phosphorylation defect type 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe C12ORF65-related COXPD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe C12ORF65-related combined oxidative phosphorylation defect</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined oxidative phosphorylation defect type 7</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.23</skos:broadMatch>
        <skos:exactMatch>MONDO:0013306</skos:exactMatch>
        <skos:exactMatch>OMIM:613559</skos:exactMatch>
        <skos:exactMatch>UMLS:C3150801</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_254930"/>

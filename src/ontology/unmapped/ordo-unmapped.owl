            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11362"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, primary immunodeficiency due to a defect in innate immunity disorder characterized by impaired intracellular signaling from both type I and type II interferons, leading to early-onset, severe, life-threatening intracellular bacterial (typically mycobacteria) and viral (mainly herpes viruses) infections.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Predisposition to severe viral infection due to STAT1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">STAT1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Susceptibility to viral and mycobacterial infections due to STAT1 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Susceptibility to viral and mycobacterial infections due to STAT1 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D84.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0013427</skos:exactMatch>
        <skos:exactMatch>OMIM:613796</skos:exactMatch>
        <skos:exactMatch>UMLS:C4755296</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_391311"/>

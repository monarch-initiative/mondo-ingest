        <obo:IAO_0000115 xml:lang="en">A rare immune dysregulation disease with immunodeficiency characterized by severe, progressive infantile onset inflammatory bowel disease with pancolitis, perianal disease (ulceration, fistulae), recurrent respiratory, genitourinary and cutaneous infections, arthritis and a high risk of B-cell lymphoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">IL10-related early-onset IBD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">IL10-related early-onset inflammatory bowel disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Immune dysregulation-inflammatory bowel disease-arthritis-recurrent infections syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Immune dysregulation-inflammatory bowel disease-arthritis-recurrent infections syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:K52.8</skos:broadMatch>
        <skos:broadMatch>ICD-11: 4A6Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016542</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749850</skos:exactMatch>
        <skos:narrowMatch>OMIM:612567</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613148</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_238569"/>

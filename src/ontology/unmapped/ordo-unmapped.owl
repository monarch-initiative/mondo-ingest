    <!-- http://www.orpha.net/ORDO/Orphanet_93929 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93929">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_322"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital genitourinary malformation characterized by urogenital, gastrointestinal, skeletal and neurospinal anomalies. It is the most severe part of the spectrum of the exstrophy-epispadias complex (EEC) and is also referred as the OEIS complex (omphalocele, exstrophy, imperforate anus and spinal defects).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cloacal exstrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OEIS complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Omphalocele-cloacal exstrophy-imperforate anus-spinal defect syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cloacal exstrophy</rdfs:label>
        <skos:broadMatch>ICD-10:Q64.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB17.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0009774</skos:exactMatch>
        <skos:exactMatch>MeSH:C537748</skos:exactMatch>
        <skos:exactMatch>MedDRA:10067424</skos:exactMatch>
        <skos:exactMatch>OMIM:258040</skos:exactMatch>
        <skos:exactMatch>UMLS:C1850321</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93929"/>

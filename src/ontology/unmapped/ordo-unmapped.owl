    <!-- http://www.orpha.net/ORDO/Orphanet_261519 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_261519">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263793"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A uniparental disomy of maternal origin that does not seem to have an adverse impact on the phenotype of an individual. There is a possibility of homozygosity for a recessive disease mutation for which the mother is a carrier and specific phenotype depends on the inherited disorder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Maternal uniparental disomy of chromosome X syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UPD(X)mat</oboInOwl:hasExactSynonym>
        <rdfs:label>Maternal uniparental disomy of chromosome X syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD45.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0016851</skos:exactMatch>
        <skos:exactMatch>UMLS:C5191056</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_261519"/>

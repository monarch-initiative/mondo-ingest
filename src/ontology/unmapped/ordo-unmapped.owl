    <!-- http://www.orpha.net/ORDO/Orphanet_90186 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90186">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_289825"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

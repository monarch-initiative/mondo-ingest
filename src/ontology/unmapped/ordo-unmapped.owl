        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multi-system disease characterized by markedly impaired extracellular fibrinolysis leading to the formation of ligneous (fibrin-rich) pseudomembranes on mucosae.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hypoplasminogenemia</oboInOwl:hasExactSynonym>

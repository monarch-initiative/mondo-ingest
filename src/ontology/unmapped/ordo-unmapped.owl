    <!-- http://www.orpha.net/ORDO/Orphanet_3433 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3433">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269528"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498454"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522548"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">Microcephaly-brachydactyly-kyphoscoliosis syndrome is characterized by profound intellectual deficit in association with microcephaly, short stature, brachydactyly type D, a flattened occiput, downslanting palpebral fissures, low-set large ears, a broad prominent nose and kyphoscoliosis. It has been described in three sisters. The disorder is likely to be transmitted as an autosomal recessive trait.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microcephaly-brachydactyly-kyphoscoliosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Viljoen-Kallis-Voges syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Microcephaly-brachydactyly-kyphoscoliosis syndrome</rdfs:label>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hemoglobin D disease(HbD) is a hemoglobinopathy characterized by production of abnormal variant hemoglobin known as hemoglobin D, with no or mild clinical manifestations (splenomegaly, very mild anemia).</obo:IAO_0000115>

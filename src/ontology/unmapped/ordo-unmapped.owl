    <!-- http://www.orpha.net/ORDO/Orphanet_589442 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_589442">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139021"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183570"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716405"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93441"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8999"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia characterized by microcephaly, developmental delay and intellectual disability, sensorineural hearing loss, retinal degeneration, and skeletal dysplasia. Musculoskeletal abnormalities include delayed ossification of epiphyses, spondyloepimetaphyseal dysplasia, short stature, severe spinal deformities, and severe joint laxity resulting in multiple joint dislocations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Liberfarb syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short stature-skeletal dysplasia-retinal degeneration-intellectual disability-sensorineural hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Short stature-skeletal dysplasia-retinal degeneration-intellectual disability-sensorineural hearing loss syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0030045</skos:exactMatch>
        <skos:exactMatch>OMIM:618889</skos:exactMatch>
        <skos:exactMatch>UMLS:C5394404</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

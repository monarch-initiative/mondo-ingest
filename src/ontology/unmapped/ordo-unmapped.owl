    <!-- http://www.orpha.net/ORDO/Orphanet_648562 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_648562">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309842"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of renal agenesis characterized by complete absence of kidney development, absent ureters and subsequent absence of fetal renal function resulting in Potter sequence with pulmonary hypoplasia related to oligohydramnios, which is fatal shortly after birth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Renal agenesis, bilateral</oboInOwl:hasExactSynonym>
        <rdfs:label>Renal agenesis, bilateral</rdfs:label>
        <skos:broadMatch>ICD-11:LB30.00</skos:broadMatch>

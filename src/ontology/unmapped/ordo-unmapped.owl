    <!-- http://www.orpha.net/ORDO/Orphanet_95409 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95409">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101958"/>

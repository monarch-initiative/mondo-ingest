    <!-- http://www.orpha.net/ORDO/Orphanet_331235 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_331235">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_331232"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary immunodeficiency characterized by recurrent and/or invasive bacterial, viral, and fungal infections, associated with low to absent blood IgM levels, while IgG, IgG subclasses, and IgA levels, as well as IgG antibody response to vaccinations, are normal. Patients may also present allergic diatheses, and the prevalence of autoimmune diseases is increased.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Selective IgM deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Selective immunoglobulin M deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Selective IgM deficiency</rdfs:label>
        <skos:broadMatch>ICD-11:4A01.04</skos:broadMatch>
        <skos:exactMatch>ICD-10:D80.4</skos:exactMatch>
        <skos:exactMatch>MONDO:0018039</skos:exactMatch>
        <skos:exactMatch>MedDRA:10039916</skos:exactMatch>
        <skos:exactMatch>UMLS:C0154275</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

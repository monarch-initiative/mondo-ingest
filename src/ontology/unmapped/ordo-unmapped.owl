    <!-- http://www.orpha.net/ORDO/Orphanet_424002 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_424002">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_423998"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare epithelial tumor of the rectum, arising from squamous cells in the rectal epithelium, without the presence of squamous-lined fistulous tracts in the rectum or a proximal extension of SCC of anal or gynecological origin. The reported symptoms are often nonspecific, such as anorexia, weight loss, lower abdominal pain, rectal bleeding and changes of bowel habits.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Rectal squamous cell carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Squamous cell carcinoma of the rectum</oboInOwl:hasExactSynonym>
        <rdfs:label>Squamous cell carcinoma of the rectum</rdfs:label>
        <skos:broadMatch>ICD-10:C20</skos:broadMatch>
        <skos:broadMatch>ICD-11:2B92.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018515</skos:exactMatch>
        <skos:exactMatch>UMLS:C1335690</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, constitutional thrombocytopenia disease characterized by mild to moderate thrombocytopenia, abnormal platelet function and a propensity to develop hematological malignancies, mainly of myeloid origin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FPD/AML</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FPDMM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FPS/AML</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial platelet disorder with associated myeloid malignancy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial platelet disorder with predisposition to acute myelogenous leukemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial platelet disorder with predisposition to myeloid malignancy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial platelet disorder with propensity to acute myeloid leukemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial thrombocytopenia with propensity to acute myelogenous leukemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RUNX1 familial platelet disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RUNX1 familial platelet disorder with associated myeloid malignancies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RUNX1-FPD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RUNX1-FPDMM</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial platelet disorder with associated myeloid malignancy</rdfs:label>
        <skos:broadMatch>ICD-10:D69.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B62.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0011071</skos:exactMatch>

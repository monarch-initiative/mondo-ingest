    <!-- http://www.orpha.net/ORDO/Orphanet_94147 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94147">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_208508"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

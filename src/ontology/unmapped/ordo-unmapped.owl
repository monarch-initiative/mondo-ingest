            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/358"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, hereditary endocrine tumor characterized by a benign pituitary adenoma that is either secreting (e.g. prolactin, growth hormone, thyroid stimulating hormone) or non-secreting. Symptoms may occur due to either the hormonal hypersecretion and/or the mass effect of the lesion on local structures in the brain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FIPA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial isolated pituitary adenoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial isolated pituitary adenoma</rdfs:label>
        <skos:broadMatch>ICD-10:D35.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F37.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:102200</skos:broadMatch>
        <skos:exactMatch>MONDO:0017824</skos:exactMatch>
        <skos:exactMatch>MeSH:C566321</skos:exactMatch>
        <skos:exactMatch>UMLS:C2676191</skos:exactMatch>
        <skos:narrowMatch>OMIM:617540</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_314777"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_364055 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_364055">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717324"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_730376"/>
        <rdfs:subClassOf>

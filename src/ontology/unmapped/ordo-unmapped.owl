            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A malformation syndrome that is characterized by facial dysmorphism, severe hypoplasia of the nasal bones and frontal sinuses, ocular involvement, early-onset hearing loss, skeletal and anhidrotic ectodermal anomalies and short stature with spondyloepiphyseal dysplasia and early-onset osteoarthritis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Marshall syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Marshall syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>

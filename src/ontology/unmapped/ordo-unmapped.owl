        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93460"/>
        <obo:IAO_0000115 xml:lang="en">A rare partial autosomal trisomy/tetrasomy characterized by obesity, global developmental delay and intellectual disability, facial dysmorphism (synophrys, high-arched eyebrows, large posteriorly rotated ears, upturned nose, long smooth philtrum, overbite and high palate), large hands and limb hypotonia. Additional features include seizures and behavioral abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>11p15.4 microduplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dup(11)p(15.4)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 11p15.4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dup(11)p(15.4)</oboInOwl:hasExactSynonym>
        <rdfs:label>11p15.4 microduplication syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD41.A</skos:broadMatch>
        <skos:exactMatch>MONDO:0017580</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749508</skos:exactMatch>
    </owl:Class>

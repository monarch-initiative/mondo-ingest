    <!-- http://www.orpha.net/ORDO/Orphanet_35705 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_35705">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>

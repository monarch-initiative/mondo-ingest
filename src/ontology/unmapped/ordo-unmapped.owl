        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Xeroderma pigmentosum variant is a milder subtype of xeroderma pigmentosum (XP), a rare genetic photodermatosis characterized by severe sun sensitivity and an increased risk of skin cancer.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">XPV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Xeroderma pigmentosum variant</oboInOwl:hasExactSynonym>
        <rdfs:label>Xeroderma pigmentosum variant</rdfs:label>

        <oboInOwl:hasExactSynonym xml:lang="en">Functioning PNET</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Functioning neuroendocrine tumor of pancreas</oboInOwl:hasExactSynonym>

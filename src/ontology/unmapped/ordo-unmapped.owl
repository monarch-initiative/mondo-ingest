    <!-- http://www.orpha.net/ORDO/Orphanet_156 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_156">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309130"/>

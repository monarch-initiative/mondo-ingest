    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_324 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_324">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183478"/>

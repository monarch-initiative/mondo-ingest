        <skos:exactMatch>MedDRA:10081685</skos:exactMatch>
        <skos:exactMatch>OMIM:156550</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265279</skos:exactMatch>
    </owl:Class>

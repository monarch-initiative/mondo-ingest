            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of Perrault syndrome characterized by sensorineural hearing loss and ovarian dysgenesis in females. No neurological features are observed. Hearing loss is sensorineural, generally bilateral, prelingual, progressive, sometimes asymmetric and manifests with variable severity (mild to profound). Majority of the cases have primary amenorrhea.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Perrault syndrome type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XX gonadal dysgenesis-deafness syndrome-without neurological manifestations</oboInOwl:hasExactSynonym>
        <rdfs:label>Perrault syndrome type 1</rdfs:label>
        <skos:exactMatch>MONDO:0009300</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816798</skos:exactMatch>
        <skos:narrowMatch>OMIM:621101</skos:narrowMatch>
    </owl:Class>

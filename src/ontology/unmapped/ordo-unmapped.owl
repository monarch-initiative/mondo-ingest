        <owl:annotatedTarget>Diazoxide-resistant focal hyperinsulinism due to Kir6.2 deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

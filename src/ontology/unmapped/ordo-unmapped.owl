    <!-- http://www.orpha.net/ORDO/Orphanet_320365 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_320365">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/33240"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A complex form of hereditary spastic paraplegia, characterized by an onset in childhood or adulthood of progressive spastic paraplegia (with spastic gait, spasticity, lower limb weakness, pes cavus and urinary urgency) associated with the additional manifestation of peripheral sensorimotor neuropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant spastic paraplegia type 36</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG36</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant spastic paraplegia type 36</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0013132</skos:exactMatch>
        <skos:exactMatch>MeSH:C567930</skos:exactMatch>
        <skos:exactMatch>OMIM:613096</skos:exactMatch>
        <skos:exactMatch>UMLS:C2936879</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

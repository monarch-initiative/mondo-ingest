    <!-- http://www.orpha.net/ORDO/Orphanet_300547 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300547">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183634"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

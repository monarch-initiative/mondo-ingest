    <!-- http://www.orpha.net/ORDO/Orphanet_439254 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_439254">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276058"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

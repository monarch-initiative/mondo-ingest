    <!-- http://www.orpha.net/ORDO/Orphanet_657 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_657">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276525"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_91088"/>
        <obo:IAO_0000115 xml:lang="en">A rare endocrine disease characterized by an excessive or uncontrolled insulin secretion and recurrent episodes of hypoglycemia that can result in neurological sequelae if left untreated. There are two forms according to the response to first line treatment: diazoxide-sensitive and diazoxide-resistant hyperinsulinism; and three histopathological forms: focal, diffuse and atypical forms. Focal forms are only observed in early-onset cases of diazoxide unresponsive patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital isolated hyperinsulinism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PHHI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Persistent hyperinsulinemic hypoglycemia of infancy</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital isolated hyperinsulinism</rdfs:label>
        <skos:exactMatch>MONDO:0019010</skos:exactMatch>
        <skos:exactMatch>MONDO:19010</skos:exactMatch>
        <skos:exactMatch>MeSH:D044903</skos:exactMatch>
        <skos:exactMatch>UMLS:C3888018</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_657"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital isolated hyperinsulinism</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_65720 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_65720">

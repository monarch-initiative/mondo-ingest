    <!-- http://www.orpha.net/ORDO/Orphanet_248111 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_248111">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276058"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive cerebellar ataxia (ARCA), characterized by progressive cerebellar ataxia associated with frequent oculomotor apraxia, severe neuropathy and an elevated serum alpha-fetoprotein (AFP) level.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AOA2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ataxia-oculomotor apraxia type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCAN 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCAR1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia with axonal neuropathy type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Spinocerebellar ataxia with axonal neuropathy type 2</rdfs:label>
        <skos:broadMatch>ICD-10:G60.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:9C82.4</skos:broadMatch>

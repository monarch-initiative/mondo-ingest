            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare malignant adrenal disease characterized by a tumor that arises from the adrenal cortex. The clinical presentation depends on the hormones secreted; in children virilization is a predominant feature; other manifestations can include symptoms of Cushing syndrome or symptoms related to tumor volume or metastases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ACC</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_2369 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2369">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Limb body wall complex (LBWC) is characterized by severe multiple congenital anomalies in the fetus with exencephaly/encephalocele, thoraco- and/or abdominoschisis (anterior body wall defects) and limb defects, with or without facial clefts.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Body stalk anomaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LBWC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Limb body wall complex</oboInOwl:hasExactSynonym>
        <rdfs:label>Limb body wall complex</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016528</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274839</skos:exactMatch>
    </owl:Class>

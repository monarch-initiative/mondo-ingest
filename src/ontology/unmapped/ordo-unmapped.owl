    <!-- http://www.orpha.net/ORDO/Orphanet_263458 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_263458">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276525"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

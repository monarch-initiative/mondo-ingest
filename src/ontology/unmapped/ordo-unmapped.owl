        <obo:IAO_0000115 xml:lang="en">Secondary short bowel syndrome is an intestinal failure caused by any condition that results in a functional small intestine of less than 200 cm in length and is characterized by diarrhea, nutrient malabsoption, bowel dilation and dysmobility.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Secondary short bowel syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Secondary short bowel syndrome</rdfs:label>

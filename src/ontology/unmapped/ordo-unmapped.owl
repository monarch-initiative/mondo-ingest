    <!-- http://www.orpha.net/ORDO/Orphanet_231160 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231160">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102006"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371436"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/23140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17754"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurovascular malformation characterized by sac-like bulging of cerebral arteries due to weakening of the endothelial layer. Familial occurrence is suspected when two or more affected first- to third-degree relatives are present in a family. Aneurysms may remain asymptomatic throughout life, or rupture and thereby cause potentially life-threatening subarachnoid hemorrhage. Patients with familial cerebral saccular aneurysm are more likely to develop more than one brain aneurysm, are at greater risk of rupture, and tend to have poorer outcome after rupture than patients with sporadic cerebral aneurysms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial berry aneurysm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial cerebral saccular aneurysm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial intracranial saccular aneurysm</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial cerebral saccular aneurysm</rdfs:label>
        <skos:broadMatch>ICD-10:I67.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:8B22.6</skos:exactMatch>
        <skos:exactMatch>MONDO:16483</skos:exactMatch>
        <skos:exactMatch>OMIM:105800</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_251595 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251595">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251592"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare low-grade astrocytoma characterized by a high degree of cellular differentiation, slow growth, and diffuse infiltration of adjacent brain structures, and corresponding to WHO grade II. The tumor typically affects young adults and has an intrinsic tendency for progression to high-grade glioma. Histological variants are fibrillary, gemistocytic, and protoplasmic astrocytoma. Patients most commonly present with seizures, but also with other neurological or neuropsychological abnormalities, depending on the location.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Astrocytoma grade 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse astrocytoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Astrocytoma grade 2</rdfs:label>
        <skos:broadMatch>ICD-10:D33.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016686</skos:exactMatch>
        <skos:exactMatch>UMLS:C0280785</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Astrocytoma grade 2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



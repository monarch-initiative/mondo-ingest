    <!-- http://www.orpha.net/ORDO/Orphanet_831 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_831">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102000"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Congenital cervical spinal stenosis is a rare neurological disease characterized by a congenital narrowing of the bony anatomy of the cervical spinal canal (saggital diameter &lt;14mm), predisposing the individual to symptomatic neural compression, such as cramps, paresthesias, pain, muscle hypertonia and weakness, myelopathy and sphincter disturbances.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital cervical spinal stenosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital narrowing of cervical spinal canal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital stenosis of the cervical spine</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital cervical spinal stenosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q06.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0019357</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749275</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_831"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multisystemic disorder characterized by cone-rod dystrophy, hearing loss, obesity, insulin resistance and hyperinsulinemia, type 2 diabetes mellitus, dilated cardiomyopathy (DCM), and progressive hepatic and renal dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Alström syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Alström syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E34.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>

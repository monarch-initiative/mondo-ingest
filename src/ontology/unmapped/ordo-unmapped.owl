        <obo:IAO_0000115 xml:lang="en">6q25 microdeletion syndrome is a recently described syndrome characterized by developmental delay, facial dysmorphism and hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>6q25.2q25.3 microdeletion syndrome</oboInOwl:hasExactSynonym>

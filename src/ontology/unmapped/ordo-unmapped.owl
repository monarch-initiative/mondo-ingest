    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_49042 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_49042">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_167759"/>

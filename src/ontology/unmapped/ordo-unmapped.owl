        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic axial skeletal dysostosis characterized by multiple segmentation defects of the vertebrae in combination with abnormalities of the ribs (malalignment, intercostal fusion and possible reduction in rib number), leading to short trunk in proportion to height, short neck and non-progressive scoliosis that is typically mild.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive spondylocostal dysostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Jarcho-Levin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive spondylocostal dysostosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q76.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.H</skos:broadMatch>
        <skos:exactMatch>MONDO:0010180</skos:exactMatch>
        <skos:exactMatch>MeSH:C537565</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265343</skos:exactMatch>
        <skos:narrowMatch>OMIM:122600</skos:narrowMatch>

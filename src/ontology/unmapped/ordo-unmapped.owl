    <!-- http://www.orpha.net/ORDO/Orphanet_166409 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_166409">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_310"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_726812"/>
        <obo:IAO_0000115 xml:lang="en">A rare epilepsy syndrome with onset in childhood and adolescence characterized by focal seizures involving the occipital lobe triggered by visual stimuli.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">POLE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Photosensitive occipital lobe epilepsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Photosensitive occipital lobe epilepsy</rdfs:label>
        <skos:broadMatch>ICD-10:G40.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.40</skos:broadMatch>
        <skos:exactMatch>MONDO:0015643</skos:exactMatch>
        <skos:exactMatch>OMIM:132100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0393720</skos:exactMatch>
        <skos:narrowMatch>OMIM:609572</skos:narrowMatch>
        <skos:narrowMatch>OMIM:609573</skos:narrowMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_268 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_268">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102015"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207073"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

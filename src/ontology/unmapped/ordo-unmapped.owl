    <!-- http://www.orpha.net/ORDO/Orphanet_168451 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168451">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_253"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Spondyloepimetaphyseal dysplasia-abnormal dentition syndrome is a rare primary bone dysplasia disorder characterized by the association of dental anomalies (oligodontia with pointed incisors) and generalized platyspondyly with epiphyseal and metaphyseal involvement. Thin tapering fingers and accentuated palmar creases are additional features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SEMDAD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spondyloepimetaphyseal dysplasia-abnormal dentition syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Spondyloepimetaphyseal dysplasia-abnormal dentition syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0011124</skos:exactMatch>
        <skos:exactMatch>OMIM:601668</skos:exactMatch>
        <skos:exactMatch>UMLS:C1866507</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

    <!-- http://www.orpha.net/ORDO/Orphanet_66633 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_66633">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306712"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6295"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Isolated hemihyperplasia is a rare overgrowth syndrome characterized by an asymmetric regional body overgrowth, involving at least one limb, and associated with an increased risk of developing embryonal tumors, principally nephroblastoma and hepoblastoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hemi 3 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hemicorporal hypertrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated hemihyperplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated hemihypertrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated hemihyperplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2C</skos:broadMatch>
        <skos:exactMatch>MONDO:0009331</skos:exactMatch>
        <skos:exactMatch>MeSH:C565524</skos:exactMatch>
        <skos:exactMatch>MedDRA:10019463</skos:exactMatch>
        <skos:exactMatch>OMIM:235000</skos:exactMatch>
        <skos:exactMatch>UMLS:C1856184</skos:exactMatch>
    </owl:Class>

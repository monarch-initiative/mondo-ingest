    <!-- http://www.orpha.net/ORDO/Orphanet_800 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_800">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206644"/>

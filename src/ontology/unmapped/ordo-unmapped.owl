        <oboInOwl:hasExactSynonym>Canavan disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spongy degeneration of the brain</oboInOwl:hasExactSynonym>
        <rdfs:label>Canavan disease</rdfs:label>
        <skos:broadMatch>ICD-10:E75.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E1</skos:broadMatch>

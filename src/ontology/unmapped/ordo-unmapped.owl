            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Crouzon disease is characterized by craniosynostosis and facial hypoplasia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Crouzon craniofacial dysostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Crouzon syndrome</oboInOwl:hasExactSynonym>

        <oboInOwl:hasExactSynonym xml:lang="en">Anti-MAG neuropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neuropathy associated with monoclonal IgM antibodies to myelin-associated glycoprotein</oboInOwl:hasExactSynonym>
        <rdfs:label>Polyneuropathy associated with IgM monoclonal gammopathy with anti-MAG</rdfs:label>

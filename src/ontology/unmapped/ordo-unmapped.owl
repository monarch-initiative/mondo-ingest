            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Dimethylglycine dehydrogenase deficiency is an extremely rare autosomal recessive glycine metabolism disorder characterized clinically in the single reported case to date by muscle fatigue and a fish-like odor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DMG dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DMGDH deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dimethylglycine dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Dimethylglycine dehydrogenase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.7Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011610</skos:exactMatch>
        <skos:exactMatch>MeSH:C565278</skos:exactMatch>
        <skos:exactMatch>OMIM:605850</skos:exactMatch>
        <skos:exactMatch>UMLS:C1853892</skos:exactMatch>
    </owl:Class>

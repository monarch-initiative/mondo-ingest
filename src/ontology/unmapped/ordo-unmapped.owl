            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">PEHO-like syndrome is a rare, genetic neurological disease characterized by progressive encephalopathy, early-onset seizures with a hypsarrhythmic pattern, facial and limb edema, severe hypotonia, early arrest of psychomotor development and craniofacial dysmorphism (evolving microcephaly, narrow forehead, short nose, prominent auricles, open mouth, micrognathia), in the absence of neuro-ophthalmic or neuroradiologic findings. Poor visual responsiveness, growth failure and tapering fingers are also associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PEHO-like syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>PEHO-like syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G93.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0020495</skos:exactMatch>
        <skos:exactMatch>OMIM:617507</skos:exactMatch>

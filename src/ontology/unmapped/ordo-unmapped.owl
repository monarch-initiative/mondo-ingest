    <!-- http://www.orpha.net/ORDO/Orphanet_91378 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91378">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183770"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_658"/>
        <obo:IAO_0000115 xml:lang="en">Hereditary angioedema (HAE) is a genetic disease characterized by the occurrence of transitory and recurrent subcutaneous and/or submucosal edemas resulting in swelling and/or abdominal pain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial angioneurotic edema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HAE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary angioedema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary angioneurotic edema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary bradykinine-induced angioedema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary non histamine-induced angioedema</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary angioedema</rdfs:label>
        <skos:exactMatch>ICD-11:4A00.14</skos:exactMatch>
        <skos:exactMatch>MONDO:0019623</skos:exactMatch>
        <skos:exactMatch>MeSH:D054179</skos:exactMatch>
        <skos:exactMatch>MedDRA:10019860</skos:exactMatch>
        <skos:exactMatch>UMLS:C0019243</skos:exactMatch>
        <skos:narrowMatch>OMIM:106100</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610618</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619360</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619361</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619363</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619366</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619367</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

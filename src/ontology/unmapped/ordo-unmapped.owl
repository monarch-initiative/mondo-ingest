    <!-- http://www.orpha.net/ORDO/Orphanet_384 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_384">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98352"/>

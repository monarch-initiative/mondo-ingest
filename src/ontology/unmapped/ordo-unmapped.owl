    <!-- http://www.orpha.net/ORDO/Orphanet_3380 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3380">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98131"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98642"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal abnormality characterized by the presence of an extra chromosome&amp;nbsp;18 material and manifesting with severe intellectual disability growth delay, and extremely variable multiple congenital anomalies, including minor malformations (cranio-facial dysmorphia, short sternum, overlapping fingers) and major malformations, especially cardiac and cerebral. Neurological involvement may lead to seizures and hypotonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Chromosome 18 duplication</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Edwards syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Trisomy 18 syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Trisomy 18 syndrome</rdfs:label>
        <skos:exactMatch>ICD-11:LD40.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0018071</skos:exactMatch>
        <skos:exactMatch>MeSH:D000073842</skos:exactMatch>
        <skos:exactMatch>MedDRA:10053884</skos:exactMatch>
        <skos:exactMatch>UMLS:C4317091</skos:exactMatch>
        <skos:narrowMatch>ICD-10:Q91.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:Q91.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:Q91.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:Q91.3</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3380"/>

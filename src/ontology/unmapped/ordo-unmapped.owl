        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare partial deletion of the long arm of chromosome 6 characterized by a variable clinical phenotype that includes a characteristic craniofacial dysmorphism (including microcephaly, broad nose with prominent nasal root and bulbous nasal tip, large ears that may be malformed and low-set, characteristic downturned mouth, and short neck), global development delay, intellectual disability, and variable, non-specific, congenital malformations. Muscular hypotonia, seizures, retinal anomalies, and variable brain abnormalities have been reported in association.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>6q terminal deletion syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>6q terminal deletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.60</skos:broadMatch>
        <skos:exactMatch>MONDO:0019164</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304514</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

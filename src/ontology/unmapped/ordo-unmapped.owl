    <!-- http://www.orpha.net/ORDO/Orphanet_401859 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_401859">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225700"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_401854"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16429"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurometabolic disease characterized by a neonatal onset of seizures (often intractable), muscular hypotonia, feeding difficulties (poor sucking and/or swallowing) and mild to severe psychomotor delay, associated with nonketotic hyperglycinemia typically revealed by biochemical analysis. Respiratory problems (apnea, acute respiratory acidosis), lethargy, hearing loss, microcephaly and spasticity with pyramidal signs may also be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lipoic acid synthetase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Lipoic acid synthetase deficiency</rdfs:label>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A mild form of familial primary hypomagnesemia (FPH), characterized by extreme weakness, tetany and convulsions. Secondary disturbances in calcium excretion are observed.</obo:IAO_0000115>

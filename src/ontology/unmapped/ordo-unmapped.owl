        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <obo:IAO_0000115 xml:lang="en">A rare ectodermal dysplasia syndrome characterized by the association of amelogenesis imperfecta and trichodysplasia with symmetrical pits in the cuticles of hair shafts. There have been no further descriptions in the literature since 1993.</obo:IAO_0000115>

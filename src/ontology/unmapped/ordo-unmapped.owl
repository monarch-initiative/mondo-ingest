        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93593"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/417"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary fructose intolerance (HFI) is an autosomal recessive disorder of fructose metabolism, resulting from a deficiency of hepatic fructose-1-phosphate aldolase activity and leading to gastrointestinal disorders and postprandial hypoglycemia following fructose ingestion. HFI is a benign condition when treated, but it is life-threatening and potentially fatal if left untreated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hereditary fructose intolerance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary fructose-1-phosphate aldolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary fructosemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary fructose intolerance</rdfs:label>
        <skos:broadMatch>ICD-10:E74.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C51.50</skos:exactMatch>
        <skos:exactMatch>MONDO:0009249</skos:exactMatch>
        <skos:exactMatch>MeSH:D005633</skos:exactMatch>
        <skos:exactMatch>MedDRA:10019878</skos:exactMatch>
        <skos:exactMatch>OMIM:229600</skos:exactMatch>
        <skos:exactMatch>UMLS:C0016751</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_469"/>

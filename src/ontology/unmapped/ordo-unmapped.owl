            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A severe form of sickle cell disease (SCD) characterized by homozygosity for the sickle hemoglobin (HbS) gene and which acutely manifests with severe anemia, susceptibility to severe bacterial infections, and ischemic vasoocclusive accidents (VOA). It is a red cell disease of genetic origin which manifests with hemolytic disease and loss of red cell deformability leading to other occlusive events.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Homozygous hemoglobin S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Homozygous sickle cell anemia SS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sickle cell anemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Sickle cell anemia</rdfs:label>
        <skos:exactMatch>MONDO:0011382</skos:exactMatch>

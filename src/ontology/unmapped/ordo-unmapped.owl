            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7765"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, hereditary, pheochromocytoma/paraganglioma tumor arising from neuroendocrine chromaffin cells of the adrenal medulla (pheochromocytoma) or from any paraganglia from the skull base to the pelvic floor (paraganglioma). Clinical manifestations are often linked to excess catecholamines production causing sustained or paroxysmal elevations in blood pressure, headache, episodic profuse sweating, palpitations, pallor and apprehension or anxiety. Hereditary pheochromocytoma/paraganglioma tumors tend to present at younger ages, to be multi-focal, bilateral, and recurrent, or to have multiple synchronous neoplasms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial pheochromocytoma-paraganglioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary pheochromocytoma-paraganglioma</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary pheochromocytoma-paraganglioma</rdfs:label>
        <skos:broadMatch>ICD-10:C74.1</skos:broadMatch>
        <skos:broadMatch>ICD-10:C75.5</skos:broadMatch>
        <skos:broadMatch>ICD-10:D35.0</skos:broadMatch>
        <skos:broadMatch>ICD-10:D35.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A75</skos:broadMatch>
        <skos:exactMatch>MONDO:0017366</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274332</skos:exactMatch>
        <skos:narrowMatch>OMIM:115310</skos:narrowMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1388"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, transient paroxysmal dystonia characterized by onset of recurrent episodes of torticollis posturing of the head between infancy and early-childhood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Benign paroxysmal torticollis of infancy</oboInOwl:hasExactSynonym>
        <rdfs:label>Benign paroxysmal torticollis of infancy</rdfs:label>
        <skos:broadMatch>ICD-10:G24.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A02.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0019113</skos:exactMatch>
        <skos:exactMatch>UMLS:C3494934</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_71518"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Benign paroxysmal torticollis of infancy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_71519 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_71519">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102003"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377792"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by the manifestation of an underlying psychiatric illness or malingering, and that cannot be attributed to any known structural or neurochemical diseases. Most cases fall in the psychiatric diagnostic category of conversion disorder, also referred to as functional neurological symptom disorder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Psychogenic dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Psychogenic movement disorders</oboInOwl:hasExactSynonym>
        <rdfs:label>Psychogenic movement disorders</rdfs:label>
        <skos:broadMatch>ICD-10:F44.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019114</skos:exactMatch>
        <skos:exactMatch>MedDRA:10072376</skos:exactMatch>
        <skos:exactMatch>UMLS:C0752208</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_71519"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Psychogenic movement disorders</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_71526 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_71526">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_179490"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9201"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Pro-opiomelanocortin (POMC) deficiency is a form of monogenic obesity resulting in severe early-onset obesity, adrenal insufficiency, red hair and pale skin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Obesity due to pro-opiomelanocortin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">POMC deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Obesity due to pro-opiomelanocortin deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E66.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5B81.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:601665</skos:broadMatch>
        <skos:exactMatch>MONDO:0012335</skos:exactMatch>
        <skos:exactMatch>MeSH:C565726</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083937</skos:exactMatch>
        <skos:exactMatch>OMIM:609734</skos:exactMatch>
        <skos:exactMatch>UMLS:C1857854</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_71526"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Obesity due to pro-opiomelanocortin deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_71528 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_71528">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_179490"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181390"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8743"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic endocrine disease characterized by early onset of severe intractable diarrhea and intestinal malabsorption, followed by obesity and hormonal deficiencies due to insufficient activation of several prohormones, resulting in hypocortisolism, hypothyroidism, diabetes insipidus, hypogonadism, growth deficiency, and diabetes mellitus. Extent and age of onset of hormone deficiencies are variable between patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Obesity due to prohormone convertase I deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PCI deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Obesity due to prohormone convertase I deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E66.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5B81.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010961</skos:exactMatch>
        <skos:exactMatch>OMIM:600955</skos:exactMatch>
        <skos:exactMatch>UMLS:C4302878</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_71528"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Obesity due to prohormone convertase I deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



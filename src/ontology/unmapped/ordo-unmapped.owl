        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly characterized by an extremely variable clinical phenotype and may include heart defects, urogenital abnormalities, velopharyngeal insufficiency with or without cleft palate, and ranging from multiple defects to mild learning difficulties with some individuals being essentially normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>22q11.2 duplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">22q11.2 microduplication syndrome</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_423275 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_423275">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_94145"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19967"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spinocerebellar ataxia type 40 (SCA40) is a very rare subtype of autosomal dominant cerebellar ataxia type 1, characterized by the adult-onset of unsteady gait and dysarthria, followed by wide-based gait, gait ataxia, ocular dysmetria, intention tremor, scanning speech, hyperreflexia and dysdiadochokinesis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA40</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 40</oboInOwl:hasExactSynonym>
        <rdfs:label>Spinocerebellar ataxia type 40</rdfs:label>
        <skos:broadMatch>ICD-10:G11.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A03.16</skos:broadMatch>
        <skos:exactMatch>MONDO:0014475</skos:exactMatch>
        <skos:exactMatch>OMIM:616053</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518336</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary persistence of fetal hemoglobin (HPFH) associated with beta-thalassemia is characterized by high hemoglobin (Hb) F levels and an increased number of fetal-Hb-containing-cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HPFH-beta-thalassemia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary persistence of fetal hemoglobin-beta-thalassemia syndrome</oboInOwl:hasExactSynonym>

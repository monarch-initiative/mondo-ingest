            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">CARASIL is a hereditary cerebral small vessel disease characterized by early-onset gait disturbances, premature scalp alopecia, ischemic stroke, acute mid to lower back pain and progressive cognitive disturbances leading to severe dementia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CARASIL</oboInOwl:hasExactSynonym>

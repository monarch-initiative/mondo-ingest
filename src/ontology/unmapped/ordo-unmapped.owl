            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">The fetal akinesia/hypokinesia sequence (or Pena-Shokeir syndrome type I) is characterized by multiple joint contractures, facial anomalies and pulmonary hypoplasia. Whatever the cause, the common feature of this sequence is decreased foetal activity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arthrogryposis multiplex congenita-pulmonary hypoplasia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FADS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fetal akinesia deformation sequence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pena-Shokeir syndrome type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Fetal akinesia deformation sequence</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>

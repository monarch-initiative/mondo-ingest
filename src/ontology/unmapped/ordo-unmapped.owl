    <!-- http://www.orpha.net/ORDO/Orphanet_293939 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_293939">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263783"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

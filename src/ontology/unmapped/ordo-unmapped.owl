    <!-- http://www.orpha.net/ORDO/Orphanet_3427 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3427">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2445"/>

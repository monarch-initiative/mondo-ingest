    <!-- http://www.orpha.net/ORDO/Orphanet_86820 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_86820">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399302"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399388"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93421"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2200"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Avascular necrosis of femoral head (ANFH) is a severely disabling disease characterised by progressive groin pain, a limping gait, leg length discrepancy, collapse of the subchondral bone, limitation of hip function and eventual degeneration of the hip joint requiring total hip arthroplasty.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial avascular necrosis of femoral head</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial osteonecrosis of the femoral head</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial avascular necrosis of femoral head</rdfs:label>
        <skos:broadMatch>ICD-10:M87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB82.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0012126</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275066</skos:exactMatch>
        <skos:narrowMatch>OMIM:608805</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617383</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_86820"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial avascular necrosis of femoral head</owl:annotatedTarget>

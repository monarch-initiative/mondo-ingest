    <!-- http://www.orpha.net/ORDO/Orphanet_66518 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_66518">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181368"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by the association of unilateral or bilateral short fifth metacarpals (defined as a gap of 2 mm or more between the distal end of the fifth metacarpal bone and a tangential line connecting the distal ends of the third and fourth metacarpals), insulin resistance, and spherocytosis. Familial short stature has not been reported as part of the syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Short fifth metacarpals-insulin resistance syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Short fifth metacarpals-insulin resistance syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E14.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A44</skos:broadMatch>
        <skos:exactMatch>MONDO:0019017</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303621</skos:exactMatch>
    </owl:Class>

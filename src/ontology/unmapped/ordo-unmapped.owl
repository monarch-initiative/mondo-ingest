            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation syndrome characterized by a typical facial dysmorphism, macrodontia of the permanent upper central incisors, short stature, skeletal anomalies, developmental delay and behavioral abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ANKRD11-related disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>KBG syndrome</oboInOwl:hasExactSynonym>

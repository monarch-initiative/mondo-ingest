    <!-- http://www.orpha.net/ORDO/Orphanet_71212 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_71212">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165985"/>

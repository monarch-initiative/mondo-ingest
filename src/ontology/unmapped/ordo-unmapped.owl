    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_753">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399685"/>

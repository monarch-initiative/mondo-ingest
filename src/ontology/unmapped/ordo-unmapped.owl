    <!-- http://www.orpha.net/ORDO/Orphanet_251855 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251855">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_616"/>
        <obo:IAO_0000115 xml:lang="en">A histological variant of medulloblastoma, an embryonic malignancy, associated with extremely low survival rates and a high risk of metastatic disease and manifesting with symptoms of increased intracranial pressure such as vomiting, headache, listlessness, papilledema and diplopia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anaplastic/large cell medulloblastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Anaplastic/large cell medulloblastoma</rdfs:label>
        <skos:broadMatch>ICD-10:C71.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0016709</skos:exactMatch>
        <skos:exactMatch>UMLS:C4330531</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Anaplastic/large cell medulloblastoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_251858 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251858">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_616"/>
        <obo:IAO_0000115 xml:lang="en">Medulloblastoma with extensive nodularity (MBEN) is a histological variant of medulloblastoma, an embryonic malignancy, most often located in the inferior medullary velum and then growing into the fourth ventricle, and presenting in infants and young children with symptoms of increased intracranial pressure such as headache, listlessness, vomiting, diplopia and papilledema. It is often associated with Gorlin syndrome and has a relatively good prognosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MBEN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Medulloblastoma with extensive nodularity</oboInOwl:hasExactSynonym>
        <rdfs:label>Medulloblastoma with extensive nodularity</rdfs:label>
        <skos:broadMatch>ICD-10:C71.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.10</skos:broadMatch>
        <skos:broadMatch>OMIM:155255</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH6JN6</skos:exactMatch>
        <skos:exactMatch>MONDO:0016710</skos:exactMatch>
        <skos:exactMatch>UMLS:C1334970</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251858"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Medulloblastoma with extensive nodularity</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_251863 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251863">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_616"/>
        <obo:IAO_0000115 xml:lang="en">Desmoplastic/nodular medulloblastoma is a histological variant of medulloblastoma, an embryonic malignancy, often located in one of the cerebellar hemispheres, occurring most frequently in adults and manifesting with symptoms such as vomiting and headache.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Desmoplastic/nodular medulloblastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Desmoplastic/nodular medulloblastoma</rdfs:label>
        <skos:broadMatch>ICD-10:C71.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.10</skos:broadMatch>
        <skos:broadMatch>OMIM:155255</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH7PN5</skos:exactMatch>
        <skos:exactMatch>MONDO:0016711</skos:exactMatch>
        <skos:exactMatch>UMLS:C0751291</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251863"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Desmoplastic/nodular medulloblastoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_251867 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251867">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_616"/>
        <obo:IAO_0000115 xml:lang="en">Classic medulloblastoma is a histological variant of medulloblastoma ,an embryonic malignancy, having a midline location, occurring most often in children and manifesting with variable symptoms such as headaches, nausea, vomiting and ataxia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Classic medulloblastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Classic medulloblastoma</rdfs:label>
        <skos:broadMatch>ICD-10:C71.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.10</skos:broadMatch>
        <skos:broadMatch>OMIM:155255</skos:broadMatch>
        <skos:exactMatch>MONDO:0016712</skos:exactMatch>
        <skos:exactMatch>UMLS:C1707400</skos:exactMatch>
        <skos:narrowMatch>ICD-11:XH0RY1</skos:narrowMatch>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17975"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant pure hereditary spastic paraplegia characterized by early childhood onset of slowly progressive crural spastic paraparesis presenting with spastic gait, mild stiffness at rest, hyperreflexia (in lower limbs), extensor plantar responses and, in some, mild postural tremor, pes cavus, sphincter disturbances and sensory loss at ankles.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal spastic paraplegia type 72</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG72</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal spastic paraplegia type 72</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.00</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0014282</skos:exactMatch>
        <skos:exactMatch>OMIM:615625</skos:exactMatch>
        <skos:exactMatch>UMLS:C3810160</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_401849"/>

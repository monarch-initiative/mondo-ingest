    <!-- http://www.orpha.net/ORDO/Orphanet_98851 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98851">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2467"/>

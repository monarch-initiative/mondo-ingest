                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9202"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, congenital muscular dystrophy due to dystroglycanopathy characterized by proximal muscle weakness with a tendency for muscle hypertrophy and pseudohypertrophy, variable cognitive impairment, microcephaly, cerebellar hypoplasia with or without cysts, and other structural brain anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CMD with cerebellar involvement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CMD-CRB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital muscular dystrophy with cerebellar involvement</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital muscular dystrophy with cerebellar involvement</rdfs:label>
        <skos:broadMatch>ICD-10:G71.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C70.6</skos:broadMatch>
        <skos:broadMatch>OMIM:606612</skos:broadMatch>
        <skos:broadMatch>OMIM:613155</skos:broadMatch>
        <skos:broadMatch>OMIM:613156</skos:broadMatch>
        <skos:broadMatch>OMIM:615351</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_455 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_455">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_281103"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial dyskinesia and facial myokymia is a rare paroxysmal movement disorder, with childhood or adolescent onset, characterized by paroxysmal choreiform, dystonic, and myoclonic movements involving the limbs (mostly distal upper limbs), neck and/or face, which can progressively increase in both frequency and severity until they become nearly constant. Patients may also present with delayed motor milestones, perioral and periorbital dyskinesias, dysarthria, hypotonia, and weakness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FDFM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial dyskinesia and facial myokymia</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial dyskinesia and facial myokymia</rdfs:label>
        <skos:broadMatch>ICD-10:G51.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0800028</skos:exactMatch>
        <skos:exactMatch>MeSH:C564676</skos:exactMatch>
        <skos:exactMatch>UMLS:C1847627</skos:exactMatch>
        <skos:narrowMatch>OMIM:606703</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619647</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_324588"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by the combination of congenital distal limb reduction and scalp defects, often accompanied by skull ossification defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AOS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Adams-Oliver syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Aplasia cutis congenita with distal limb anomalies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Aplasia cutis congenita with terminal transverse limb defects</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital scalp defects with distal limb anomalies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital scalp defects with distal limb reduction anomalies</oboInOwl:hasExactSynonym>
        <rdfs:label>Adams-Oliver syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.2</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_454887 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_454887">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306666"/>

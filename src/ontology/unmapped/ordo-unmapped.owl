        <owl:annotatedTarget>del(3)(q13)</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1625 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1625">

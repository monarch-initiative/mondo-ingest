        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">8p23.1 deletion involves a partial deletion of the short arm of chromosome 8 characterized by low birth weight, postnatal growth deficiency, mild intellectual deficit, hyperactivity, craniofacial abnormalities, and congenital heart defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>8p23.1 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(8)(p23.1)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 8p23.1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(8)(p23.1)</oboInOwl:hasExactSynonym>
        <rdfs:label>8p23.1 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.81</skos:broadMatch>
        <skos:exactMatch>MONDO:0016658</skos:exactMatch>
        <skos:exactMatch>MeSH:C537827</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931638</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251071"/>

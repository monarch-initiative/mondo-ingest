    <!-- http://www.orpha.net/ORDO/Orphanet_90002 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90002">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare systemic autoimmune disease characterized by the presence of signs and symptoms suggestive of a systemic autoimmune disease that do not fulfil the existing classification criteria. The main clinical manifestations are arthritis with arthralgia, Raynaud&apos;s phenomenon, xerostomia, xerophthalmia, and leukopenia, while neurologic or renal involvement are virtually absent.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">UCTD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Undifferentiated connective tissue syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Undifferentiated connective tissue syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:M35.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD28.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019527</skos:exactMatch>
        <skos:exactMatch>MeSH:D000074079</skos:exactMatch>
        <skos:exactMatch>MedDRA:10071575</skos:exactMatch>
        <skos:exactMatch>UMLS:C0409999</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90002"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, sporadic, orofaciodigital syndrome characterized by severe intellectual disability, postaxial polydactyly, vertebral fusion, deafness and congenital heart defects. Characteristic facial features include blepharophimosis, bulbous nasal tip, broad nasal bridge, downslanting palpebral fissures and low-set ears.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">OFD11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oral-facial-digital syndrome type 11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oral-facial-digital syndrome, Gabrielli type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Orofaciodigital syndrome type 11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Orofaciodigital syndrome, Gabrielli type</oboInOwl:hasExactSynonym>
        <rdfs:label>Orofaciodigital syndrome type 11</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD25.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0013035</skos:exactMatch>
        <skos:exactMatch>MeSH:C557821</skos:exactMatch>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare and severe inborn metabolic disease characterized clinically by the association of severe-to-profound neurodevelopmental impairment, severe visual impairment, ante-postnatal growth impairment, severe scoliosis and, frequently, early-onset epilepsy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">5-amino-4-imidazole carboxamide ribosiduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>AICA-ribosiduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">AICA-ribosiduria due to ATIC deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">AICAR transformylase/IMP cyclohydrolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ATIC deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>AICA-ribosiduria</rdfs:label>
        <skos:broadMatch>ICD-10:E79.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C55.0Y</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_799 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_799">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166478"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269190"/>

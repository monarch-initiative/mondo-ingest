        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90786"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95710"/>
        <obo:IAO_0000115 xml:lang="en">A severe form of congenital adrenal hyperplasia (CAH) characterized by severe adrenal insufficiency and sex reversal in males.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CLAH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital lipoid adrenal hyperplasia due to STAR deficency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LCAH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lipoid CAH</oboInOwl:hasExactSynonym>

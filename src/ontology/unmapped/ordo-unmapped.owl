            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic lipodystrophy characterized by a loss of subcutaneous adipose tissue from the trunk, buttocks and limbs; fat accumulation in the neck, face, axillary and pelvic regions; muscular hypertrophy; and usually associated with metabolic complications such as insulin resistance, diabetes mellitus, dyslipidemia and liver steatosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dunnigan syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FPLD2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial partial lipodystrophy type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial partial lipodystrophy, Dunnigan type</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial partial lipodystrophy, Dunnigan type</rdfs:label>
        <skos:broadMatch>ICD-10:E88.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A44</skos:broadMatch>

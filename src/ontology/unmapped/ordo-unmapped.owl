        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Kallmann syndrome with cardiopathy is characterised by hypogonadotropic hypogonadism associated with gonadotropin-releasing hormone (GnRH) deficiency, anosmia or hyposmia (with hypoplasia or aplasia of the olfactory bulbs) and complex congenital cardiac malformations (double-outlet right ventricle, dilated cardiomyopathy, right aortic arch). It represents a distinct clinical entity from Kallmann syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Kallmann syndrome-heart disease syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Kallmann syndrome-heart disease syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q24.8</skos:broadMatch>

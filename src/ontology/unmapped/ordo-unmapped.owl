    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_370002 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_370002">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_307846"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, isolated palmoplantar keratoderma characterized by focal hyperkeratotic lesions affecting the pressure- and mechanical trauma-bearing areas of the palms and soles, as well as hyperkeratotic plaques involving joints, including knees, elbows, ankles and dorsa of interphalangeal joints.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Focal palmoplantar keratoderma with joint keratoses</oboInOwl:hasExactSynonym>
        <rdfs:label>Focal palmoplantar keratoderma with joint keratoses</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.31</skos:broadMatch>
        <skos:broadMatch>OMIM:148700</skos:broadMatch>
        <skos:exactMatch>MONDO:0018252</skos:exactMatch>
        <skos:exactMatch>UMLS:C4755302</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_370002"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Focal palmoplantar keratoderma with joint keratoses</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



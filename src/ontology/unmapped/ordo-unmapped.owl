    <!-- http://www.orpha.net/ORDO/Orphanet_306731 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_306731">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306727"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377793"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare acquired autoimmune movement disorder characterized by chorea, hypotonia, and emotional lability. Additional clinical features may include motor impersistence and various neuropsychiatric symptoms. As a major clinical manifestation of acute rheumatic fever (ARF), the disorder typically emerges as a post-infectious complication of a group A streptococcal infection and frequently presents alongside cardiac involvement, such as clinical or subclinical carditis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Sydenham chorea</oboInOwl:hasExactSynonym>
        <rdfs:label>Sydenham chorea</rdfs:label>
        <skos:broadMatch>ICD-11:1B42</skos:broadMatch>
        <skos:exactMatch>MONDO:0017648</skos:exactMatch>
        <skos:exactMatch>MedDRA:10042732</skos:exactMatch>
        <skos:exactMatch>UMLS:C0152113</skos:exactMatch>
        <skos:narrowMatch>ICD-10:I02.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:I02.9</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_306731"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Sydenham chorea</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_306734 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_306734">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_376724"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, ectodermal dysplasia syndrome characterized by severe hand/foot anomalies, breast and/or nipple hypoplasia, and ectodermal dysplasia (principally teeth and nail anomalies). Cleft lip/palate may be variably present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LMS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Limb-mammary syndrome</oboInOwl:hasExactSynonym>

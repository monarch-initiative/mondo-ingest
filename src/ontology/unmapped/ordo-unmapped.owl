    <!-- http://www.orpha.net/ORDO/Orphanet_90059 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90059">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377793"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68361"/>
        <obo:IAO_0000115 xml:lang="en">A rare otorhinolaryngologic condition characterized by sudden hearing loss of at least 30 decibels across three contiguous frequencies, within 72 hours or less, due to acute damage to the cochlear hair cells, resulting from acoustic trauma or mechanical trauma during surgery, or occurring without any known cause. The hearing loss may affect one or both ears. Typical concomitant symptoms are aural fullness, tinnitus, and vertigo. Patients may fully recover or remain with hearing loss of variable intensity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Secondary acute sensorineural hearing loss</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sudden sensorineural hearing loss</oboInOwl:hasExactSynonym>
        <rdfs:label>Sudden sensorineural hearing loss</rdfs:label>
        <skos:broadMatch>ICD-10:H83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:AB51.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0043373</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275242</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90059"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Sudden sensorineural hearing loss</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_90060 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90060">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101944"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377792"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare clinical situation for which there is a European and/or American orphan designation. Characteristics include diffuse bleeding into the alveolar spaces that originate from the pulmonary microvasculature, including the alveolar capillaries, arterioles and venules. Patients present with cough, dyspnea, chest pain, fever, anemia and hemoptysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Diffuse alveolar hemorrhage</oboInOwl:hasExactSynonym>
        <rdfs:label>Diffuse alveolar hemorrhage</rdfs:label>
        <skos:broadMatch>ICD-10:R04.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:MD23</skos:broadMatch>
        <skos:exactMatch>MONDO:0019540</skos:exactMatch>
        <skos:exactMatch>UMLS:C4476767</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90060"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Diffuse alveolar hemorrhage</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_90061 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90061">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_280892"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-infectious choroiditis</oboInOwl:hasExactSynonym>

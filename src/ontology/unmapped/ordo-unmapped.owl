    <!-- http://www.orpha.net/ORDO/Orphanet_66630 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_66630">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_364559"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404568"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysostosis of genetic origin characterized by a painless mass over the clavicle which is due to the failure of the union process of the ossification nuclei of the clavicle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital pseudarthrosis of the clavicle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital pseudoarthrosis of the clavicle</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital pseudoarthrosis of the clavicle</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB72.Y</skos:broadMatch>

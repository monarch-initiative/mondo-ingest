    <!-- http://www.orpha.net/ORDO/Orphanet_3304 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3304">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

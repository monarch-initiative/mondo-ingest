        <skos:broadMatch>ICD-11:LA30.7</skos:broadMatch>
        <skos:exactMatch>MONDO:0007438</skos:exactMatch>
        <skos:exactMatch>MeSH:C538213</skos:exactMatch>
        <skos:exactMatch>OMIM:125440</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749611</skos:exactMatch>
    </owl:Class>

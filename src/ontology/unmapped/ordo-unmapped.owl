        <obo:IAO_0000115 xml:lang="en">Lelis syndrome is characterised by the association of ectodermal dysplasia (hypotrichosis and hypohidrosis) with acanthosis nigricans.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ectodermal dysplasia-acanthosis nigricans syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lelis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lelis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.4</skos:broadMatch>

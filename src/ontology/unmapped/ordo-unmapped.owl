    <!-- http://www.orpha.net/ORDO/Orphanet_314394 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_314394">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363250"/>

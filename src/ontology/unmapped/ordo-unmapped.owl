    <!-- http://www.orpha.net/ORDO/Orphanet_217266 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_217266">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>

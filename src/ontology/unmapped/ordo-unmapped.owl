    <!-- http://www.orpha.net/ORDO/Orphanet_364063 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_364063">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182079"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic disorder of vitamin D metabolism characterized by severe hypocalcemia leading to osteomalacia and rachitic bone deformations, and moderate hypophosphatemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">1-alpha-hydroxylase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypocalcemic vitamin D-dependent rickets</oboInOwl:hasExactSynonym>

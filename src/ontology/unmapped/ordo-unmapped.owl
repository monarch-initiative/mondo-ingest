        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247604 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247604">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98505"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1356"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A very rare motor neuron disease characterized by progressive upper motor neuron dysfunction leading to loss of the ability to walk with wheelchair dependence, and subsequently, loss of motor speech production.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">JPLS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile PLS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Juvenile primary lateral sclerosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Juvenile primary lateral sclerosis</rdfs:label>
        <skos:broadMatch>ICD-10:G12.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0011663</skos:exactMatch>
        <skos:exactMatch>MeSH:C536416</skos:exactMatch>
        <skos:exactMatch>OMIM:606353</skos:exactMatch>
        <skos:exactMatch>UMLS:C1853396</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

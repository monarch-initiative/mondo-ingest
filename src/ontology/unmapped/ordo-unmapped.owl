        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <obo:IAO_0000115 xml:lang="en">A rare, aggressive, neoplastic disease characterized by the presence of a melanocyte tumor that develops in any mucosal membrane. Clinical manifestations vary depending on the site of occurrence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Malignant melanoma of the mucosa</oboInOwl:hasExactSynonym>
        <rdfs:label>Malignant melanoma of the mucosa</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_2789 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2789">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268843"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7883"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurological disorder characterized by multiple lateral meningoceles, distinctive facial dysmorphism (including hypertelorism, downslanting palpebral fissures, posteriorly rotated ears, micrognathia, and high, narrow palate, among others), and skeletal abnormalities (e. g. vertebral anomalies, wormian bones, short stature, and scoliosis). Multiple additional features may present, such as conductive hearing impairment, hypotonia, and connective tissue and urogenital abnormalities. Cognition is usually normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lateral meningocele syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lehman syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lateral meningocele syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA07.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007537</skos:exactMatch>
        <skos:exactMatch>MeSH:C537878</skos:exactMatch>
        <skos:exactMatch>OMIM:130720</skos:exactMatch>
        <skos:exactMatch>UMLS:C1851710</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2789"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lateral meningocele syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



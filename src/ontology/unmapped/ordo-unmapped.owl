        <obo:IAO_0000115 xml:lang="en">A rare rheumatologic disease characterized by combination of systemic or cutaneous lupus erythematosus with erythema multiform-like skin lesions and characteristic immunologic findings including speckled pattern of antinuclear antibody, presence of anti-Ro/SSA or anti-La/SSB antibodies or rheumatoid factor. Chilblains may also be present. Patients may present with fever, hair loss, photosensitivity, polyarthralgia, morning stiffness, fatigue, weight loss and oral ulcers. Middle-aged women are predominantly affected.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Rowell syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Rowell syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:M32.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A40.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0041186</skos:exactMatch>
        <skos:exactMatch>MONDO:41186</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406637</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

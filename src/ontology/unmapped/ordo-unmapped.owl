    <!-- http://www.orpha.net/ORDO/Orphanet_140481 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_140481">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140453"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14103"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary demyelinating motor and sensory neuropathy characterized by slowed nerve conduction velocities, in the absence of clinically apparent neurological deficits, gait abnormalities or muscular atrophy, associated with a germline mutation in the &lt;i&gt;ARGHEF10&lt;/i&gt; gene.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant slowed nerve conduction velocity</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant slowed nerve conduction velocity</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0011998</skos:exactMatch>
        <skos:exactMatch>MeSH:C564269</skos:exactMatch>
        <skos:exactMatch>OMIM:608236</skos:exactMatch>
        <skos:exactMatch>UMLS:C1842357</skos:exactMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93438"/>
        <obo:IAO_0000115 xml:lang="en">Rhizomelic dysplasia, Patterson-Lowry type is a rare primary bone dysplasia characterized by short stature, severe rhizomelic shortening of the upper limbs associated with specific malformations of humeri (including marked widening and flattening of proximal metaphyses, medial flattening of the proximal epiphyses, and lateral bowing with medial cortical thickening of the proximal diaphyses), marked coxa vara with dysplastic femoral heads and brachymetacarpia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Rhizomelic dysplasia, Patterson-Lowry type</oboInOwl:hasExactSynonym>
        <rdfs:label>Rhizomelic dysplasia, Patterson-Lowry type</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.A</skos:broadMatch>
        <skos:exactMatch>MONDO:0011079</skos:exactMatch>
        <skos:exactMatch>MeSH:C537609</skos:exactMatch>
        <skos:exactMatch>OMIM:601438</skos:exactMatch>
        <skos:exactMatch>UMLS:C1832359</skos:exactMatch>
    </owl:Class>

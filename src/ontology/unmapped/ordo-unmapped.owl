    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_860">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_216675"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271853"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital cardiac malformation characterized by a connection of the morphologically right ventricle to the aorta, and of the morphologically left ventricle to the pulmonary trunk (atrioventricular concordance and ventriculoarterial VA discordance).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenitally uncorrected transposition of the great arteries</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Discordant ventriculoarterial connections</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Transposition of the great vessels</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenitally uncorrected transposition of the great arteries</rdfs:label>
        <skos:broadMatch>ICD-10:Q20.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA85.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0019443</skos:exactMatch>
        <skos:exactMatch>MONDO:19443</skos:exactMatch>
        <skos:exactMatch>UMLS:C3531771</skos:exactMatch>
        <skos:narrowMatch>OMIM:608808</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613854</skos:narrowMatch>
    </owl:Class>

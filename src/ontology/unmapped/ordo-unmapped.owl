        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <oboInOwl:hasExactSynonym xml:lang="en">FACS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fetal AEDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fetal anticonvulsant syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fetal antiepileptic drug syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Fetal anticonvulsant syndrome</rdfs:label>
        <skos:exactMatch>MONDO:18262</skos:exactMatch>
        <skos:exactMatch>MedDRA:10066485</skos:exactMatch>
        <skos:exactMatch>UMLS:C1739111</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_370068"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_101 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_101">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_158266"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_810 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_810">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bacterial infectious disease characterized by dysentery caused by Shigella. There are four species (S. dysenteriae, S. flexneri, S. boydii and S. sonnei), all of which cause bacillary dysentery and are strictly limited to human hosts. Affected individuals present with dysenteric syndrome with 10-30 glairy, bloody and watery stools per day, a high temperature (40°C), abdominal pain/cramps and tenesmus following an incubation period of 2-3 days.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Shigellosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Shigellosis</rdfs:label>
        <skos:exactMatch>ICD-11:1A02</skos:exactMatch>
        <skos:exactMatch>MONDO:0019345</skos:exactMatch>
        <skos:exactMatch>MedDRA:10054178</skos:exactMatch>
        <skos:exactMatch>UMLS:C0013371</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A03.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A03.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A03.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A03.3</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A03.8</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A03.9</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_810"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

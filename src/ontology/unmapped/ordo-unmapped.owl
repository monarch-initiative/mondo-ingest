            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic variant of mendelian susceptibility to mycobacterial diseases (MSMD) characterized by a partial deficiency leading to impaired IFN-gamma immunity and, consequently, recurrent, moderately severe infections with bacillus Calmette-Guérin (BCG) and other environmental mycobacteria (EM).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant MSMD due to partial IFNgammaR1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant MSMD due to partial interferon gamma receptor 1 deficiency</oboInOwl:hasExactSynonym>

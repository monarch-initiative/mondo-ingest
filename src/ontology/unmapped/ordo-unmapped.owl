    <!-- http://www.orpha.net/ORDO/Orphanet_1647 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1647">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166478"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_202948"/>

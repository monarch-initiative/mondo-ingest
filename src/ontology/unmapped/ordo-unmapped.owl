        <obo:IAO_0000115 xml:lang="en">Mandibuloacral dysplasia (MAD) is a rare genetic bone disorder characterized by growth delay, postnatal development of craniofacial anomalies including mandibular hypoplasia, progressive acral osteolysis, mottled or patchy pigmentation, skin atrophy, and partial or generalized lipodystrophy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MAD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mandibuloacral dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Mandibuloacral dysplasia</rdfs:label>

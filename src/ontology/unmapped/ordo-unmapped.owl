        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_444051 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_444051">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262164"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, syndromic intellectual disability characterized by psychomotor delay, hypotonia, feeding difficulties, failure to thrive, anomalies of the hands and feet (clinodactyly, camptodactyly, brachydactyly, feet malposition), and craniofacial dysmorphism. Associated prenatal growth retardation, and gastrointestinal, heart and eye anomalies have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>20q11.2 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(20)(q11.2)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 20q11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(20)(q11.2)</oboInOwl:hasExactSynonym>
        <rdfs:label>20q11.2 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0018633</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680063</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_444051"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_273 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_273">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206647"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217595"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519347"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522522"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98033"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98578"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98648"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic multi-system disorder characterized by a wide range of muscle-related manifestations (muscle weakness, myotonia, early onset cataracts (before age 50) and systemic manifestations (cerebral, endocrine, cardiac, gastrointestinal tract, uterus, skin and immunologic involvement) that vary depending on the age of onset. The very wide clinical spectrum ranges from lethal presentations in infancy to mild, late-onset disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Myotonic dystrophy type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Steinert disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Steinert myotonic dystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Steinert myotonic dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:G71.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C71.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008056</skos:exactMatch>
        <skos:exactMatch>MeSH:C538008</skos:exactMatch>
        <skos:exactMatch>OMIM:160900</skos:exactMatch>
        <skos:exactMatch>UMLS:C3250443</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_273"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98282"/>
        <obo:IAO_0000115 xml:lang="en">Multiple myeloma (MM) is a malignant tumor of plasma cell characterized by overproduction of abnormal plasma cells in the bone marrow and skeletal destruction. The clinical features are bone pain, renal impairment, immunodeficiency, anemia and presence of abnormal immunoglobulins (Ig).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Kahler disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Medullary plasmacytoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple myeloma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myelomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Plasma cell myeloma</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple myeloma</rdfs:label>
        <skos:exactMatch>ICD-10:C90.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:2A83.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0009693</skos:exactMatch>
        <skos:exactMatch>MeSH:D009101</skos:exactMatch>
        <skos:exactMatch>MedDRA:10028228</skos:exactMatch>
        <skos:exactMatch>OMIM:254500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0026764</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_29073"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

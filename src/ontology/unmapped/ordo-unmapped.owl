                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3413"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, inherited, severe form of progressive myoclonus epilepsy characterized by drug-resistant epilepsy, myoclonus, and psychomotor deterioration affecting previously healthy children or adolescents.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EPM2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lafora disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PME type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive myoclonic epilepsy type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive myoclonus epilepsy type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Lafora disease</rdfs:label>
        <skos:broadMatch>ICD-10:G40.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.41</skos:broadMatch>
        <skos:exactMatch>MONDO:0009697</skos:exactMatch>

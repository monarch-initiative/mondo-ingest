        <obo:IAO_0000115 xml:lang="en">Hepatocellular adenoma (HA) is a rare benign tumor of the liver.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hepatocellular adenoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Hepatocellular adenoma</rdfs:label>

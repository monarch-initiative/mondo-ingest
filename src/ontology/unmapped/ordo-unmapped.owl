    <!-- http://www.orpha.net/ORDO/Orphanet_291 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_291">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_232035"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

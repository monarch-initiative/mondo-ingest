    <!-- http://www.orpha.net/ORDO/Orphanet_1698 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1698">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98131"/>
        <obo:IAO_0000115 xml:lang="en">Mosaic trisomy 12 is a rare chromosomal anomaly syndrome, with a highly variable phenotype, principally characterized by developmental or growth delay, short stature, craniofacial dysmorphism (e.g. turricephaly, tall forehead, downslanting palpebral fissures, posteriorly rotated and low set ears, narrow palate), congenital heart defects (e.g. atrial septal defect, patent ductus arteriosus), hypotonia, and pigmentary dysplasia. Scoliosis, hearing loss, facial/body asymmetry, and intellectual disability have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mosaic trisomy 12 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mosaic trisomy chromosome 12</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 12 mosaicism</oboInOwl:hasExactSynonym>
        <rdfs:label>Mosaic trisomy 12 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD40.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015718</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706889</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1698"/>

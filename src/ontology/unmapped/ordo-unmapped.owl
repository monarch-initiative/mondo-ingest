    <!-- http://www.orpha.net/ORDO/Orphanet_314950 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_314950">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_168956"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare hypereosinophilic syndrome characterized by hypereosinophilia produced by clonal eosinophils derived from neoplastic stem cells in the absence of any secondary cause of eosinophilia and persisting for at least six months. The condition is associated with signs of organ infiltration, dysfunction, and damage. Clinical manifestations are highly variable, depending on the organ systems involved, and include dermatologic, pulmonary, cardiac, gastrointestinal, and cerebral manifestations, among others.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Clonal hypereosinophilic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HES-M</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HES-N</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neoplastic hypereosinophilic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary HES</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary hypereosinophilic syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary hypereosinophilic syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D47.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0017833</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_2108 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2108">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139021"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183570"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

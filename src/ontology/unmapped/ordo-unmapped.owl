            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Dominant beta-thalassemia is a form of beta-thalassemia resulting in moderate to severe anemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant beta-thalassemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inclusion body beta-thalassemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Unstable beta globin chain variant disease</oboInOwl:hasExactSynonym>

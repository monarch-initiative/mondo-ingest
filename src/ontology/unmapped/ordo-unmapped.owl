        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98305"/>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive form of lipodystrophy characterized by the association of generalized lipoatrophy with acromegaloid features, muscle hypertrophy, insulin resistance, hypertriglyceridemia, and liver steatosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BSCL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Berardinelli-Seip congenital lipodystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Berardinelli-Seip syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CGL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital generalized lipodystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital generalized lipodystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:E88.1</skos:broadMatch>
        <skos:broadMatch>OMIM:606721</skos:broadMatch>

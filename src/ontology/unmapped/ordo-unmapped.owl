        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neurodevelopmental disorder characterized by global developmental delay, severe intellectual disability and absence of expressive language. Muscular hypotonia, seizures, autistic behavior and stereotypic movements are common.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>NRXN1-related severe neurodevelopmental disorder-motor stereotypies-chronic constipation-sleep-wake cycle disturbance</oboInOwl:hasExactSynonym>
        <rdfs:label>NRXN1-related severe neurodevelopmental disorder-motor stereotypies-chronic constipation-sleep-wake cycle disturbance</rdfs:label>
        <skos:broadMatch>ICD-10:G96.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0035774</skos:exactMatch>
        <skos:exactMatch>OMIM:614325</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681528</skos:exactMatch>
    </owl:Class>

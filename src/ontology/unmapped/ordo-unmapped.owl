        <obo:IAO_0000115 xml:lang="en">A rare malformation syndrome with short stature characterized by intrauterine growth retardation and intermittent locking of the finger joints. Ventricular septal defect can also be present. There have been no further descriptions in the literature since 1987.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Eng-Strom syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Short stature-locking fingers syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Eng-Strom syndrome</rdfs:label>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_718053"/>
        <obo:IAO_0000115 xml:lang="en">Good syndrome, also known as thymoma-immunodeficiency, is a very rare acquired immunodeficiency syndrome characterized by the association of thymoma and combined B-cell and T-cell immunodeficiency of adult onset with increased susceptibility to infections.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Good syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Thymoma-hypogammaglobulinemia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Thymoma-hypogammaglobulinemia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D81.8</skos:broadMatch>

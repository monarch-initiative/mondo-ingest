        <oboInOwl:hasExactSynonym xml:lang="en">Rosenthal factor deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rosenthal syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital factor XI deficiency</rdfs:label>
        <skos:exactMatch>ICD-10:D68.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:3B13</skos:exactMatch>

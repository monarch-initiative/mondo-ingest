        <obo:IAO_0000115 xml:lang="en">Osteomesopyknosis is a very rare benign bone disorder characterized by bone dysplasia manifested by patchy sclerosis of the axial skeleton and increased bone mineral content.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Axial osteosclerosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteomesopycnosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteomesopyknosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteomesopyknosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0008155</skos:exactMatch>

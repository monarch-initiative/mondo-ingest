            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Fetal Gaucher disease is the perinatal lethal form of Gaucher disease (GD).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fetal Gaucher disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Perinatal lethal Gaucher disease</oboInOwl:hasExactSynonym>

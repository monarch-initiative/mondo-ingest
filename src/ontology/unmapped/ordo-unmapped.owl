    <!-- http://www.orpha.net/ORDO/Orphanet_300305 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300305">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

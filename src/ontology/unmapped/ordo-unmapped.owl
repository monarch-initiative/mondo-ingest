        <skos:broadMatch>ICD-11:8A03.16</skos:broadMatch>
        <skos:exactMatch>MONDO:0008457</skos:exactMatch>
        <skos:exactMatch>OMIM:183086</skos:exactMatch>
        <skos:exactMatch>UMLS:C0752124</skos:exactMatch>
    </owl:Class>

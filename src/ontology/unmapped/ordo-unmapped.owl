            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Waardenburg-Shah syndrome (WSS), also known as Waardenburg syndrome type 4 (WS4) is characterized by the association of Waardenburg syndrome (sensorineural hearing loss and pigmentary abnormalities) and Hirschsprung disease (aganglionic megacolon).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Shah-Waardenburg syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">WS4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Waardenburg syndrome type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Waardenburg-Hirschsprung syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Waardenburg-Shah syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Waardenburg-Shah syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD2H.3</skos:exactMatch>

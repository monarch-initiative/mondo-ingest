            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare systemic disorder characterized by vitreoretinal and macular degeneration, as well as occipital encephalocele.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Knobloch syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Knobloch-Layer syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Retinal detachment-occipital encephalocele syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Knobloch syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q15.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:800167</skos:exactMatch>

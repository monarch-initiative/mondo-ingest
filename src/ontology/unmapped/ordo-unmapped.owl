                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8618"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">MODY (maturity-onset diabetes of the young) is a rare, familial, clinically and genetically heterogeneous form of diabetes characterized by young age of onset (generally 10-45 years of age) with maintenance of endogenous insulin production, lack of pancreatic beta-cell autoimmunity, absence of obesity and insulin resistance and extra-pancreatic manifestations in some subtypes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MODY</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maturity-onset diabetes of the young</oboInOwl:hasExactSynonym>
        <rdfs:label>MODY</rdfs:label>
        <skos:broadMatch>ICD-10:E13.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A13.6</skos:broadMatch>
        <skos:exactMatch>MONDO:0018911</skos:exactMatch>

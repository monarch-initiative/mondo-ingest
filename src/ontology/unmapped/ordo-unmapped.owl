    <!-- http://www.orpha.net/ORDO/Orphanet_178307 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_178307">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

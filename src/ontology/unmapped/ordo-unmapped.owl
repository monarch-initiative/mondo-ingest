    <!-- http://www.orpha.net/ORDO/Orphanet_2149 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2149">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163209"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-syndromic cerebral malformation due to abnormal neuronal migration characterized by clusters of disorganized neurons in abnormal locations such as periventricular and subcortical. The extent of the lesions ranges from isolated single to bilateral confluent nodules. Pediatric patients typically show variable degrees of developmental delay, intellectual disability, and intractable epilepsy, and concomitant cerebral and/or systemic malformations are frequent. Milder forms may present with onset of seizures in adulthood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Nodular neuronal heterotopia</oboInOwl:hasExactSynonym>
        <rdfs:label>Nodular neuronal heterotopia</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA05.5Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016292</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680679</skos:exactMatch>
        <skos:narrowMatch>OMIM:300049</skos:narrowMatch>
        <skos:narrowMatch>OMIM:608097</skos:narrowMatch>
        <skos:narrowMatch>OMIM:608098</skos:narrowMatch>
        <skos:narrowMatch>OMIM:612881</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615544</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617201</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2149"/>

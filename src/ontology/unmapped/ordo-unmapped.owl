        <oboInOwl:hasExactSynonym xml:lang="en">HAE-III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary angioedema type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary angioneurotic edema type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inherited estrogen-associated angioedema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inherited estrogen-associated angioneurotic edema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inherited estrogen-dependent angioedema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inherited estrogen-dependent angioneurotic edema</oboInOwl:hasExactSynonym>

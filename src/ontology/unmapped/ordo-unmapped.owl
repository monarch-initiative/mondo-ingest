        <oboInOwl:hasExactSynonym>Patterson-Stevenson-Fontaine syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Split foot deformity-mandibulofacial dysostosis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Patterson-Stevenson-Fontaine syndrome</rdfs:label>

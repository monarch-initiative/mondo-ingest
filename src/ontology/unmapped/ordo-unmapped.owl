        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Severe intellectual disability-epilepsy-anal anomalies-distal phalangeal hypoplasia is characterised by severe intellectual deficit, epilepsy, hypoplasia of the terminal phalanges, and an anteriorly displaced anus. It has been described in two sisters born to consanguineous parents. The syndrome is transmitted as an autosomal recessive trait and appears to be caused by anomalies in the chromosome regions, one localised to chromosome 1 and the other to chromosome 14.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Severe intellectual disability-epilepsy-anal anomalies-distal phalangeal hypoplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe intellectual disability-epilepsy-anal anomalies-distal phalangeal hypoplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0019786</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510007</skos:exactMatch>
    </owl:Class>

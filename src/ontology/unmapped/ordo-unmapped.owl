        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_199302 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_199302">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1991"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2089 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2089">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_308520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4707"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetically inherited anomaly of glycogen metabolism, considered a form of glycogen storage disease (GSD, or glycogenosis), characterized by post-meal hyperglycemia and fasting hypoglycemia. This is not a glycogenosis, strictly speaking, as there is no storage of glycogen, the enzyme deficiency preventing hepatic glycogen synthesis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD due to hepatic glycogen synthase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type 0a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glycogen storage disease due to hepatic glycogen synthase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease due to liver glycogen synthase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease type 0a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis type 0a</oboInOwl:hasExactSynonym>
        <rdfs:label>Glycogen storage disease due to hepatic glycogen synthase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0009414</skos:exactMatch>
        <skos:exactMatch>OMIM:240600</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510753</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2089"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

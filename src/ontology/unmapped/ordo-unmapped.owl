    <!-- http://www.orpha.net/ORDO/Orphanet_98963 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98963">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

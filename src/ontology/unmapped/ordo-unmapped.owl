                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/47"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, pigmentation anomaly of the skin characterized by generalized, irregularly shaped, asymptomatic, hyper- and hypopigmented macules distributed in a reticular pattern involving the trunk, limbs, and sometimes the face. The palms, soles and mucosa are usually not affected. Systemic abnormalities have been rarely reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dyschromatosis universalis hereditaria</oboInOwl:hasExactSynonym>
        <rdfs:label>Dyschromatosis universalis hereditaria</rdfs:label>
        <skos:broadMatch>ICD-10:L81.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC23.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0000736</skos:exactMatch>
        <skos:exactMatch>MeSH:C535730</skos:exactMatch>
        <skos:exactMatch>OMIM:127500</skos:exactMatch>

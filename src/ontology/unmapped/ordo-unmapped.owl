    <!-- http://www.orpha.net/ORDO/Orphanet_2780 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2780">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183542"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2781"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98038"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2514"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/26837"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Osteopathia striata with cranial sclerosis (OS-CS) is a bone dysplasia characterized by longitudinal striations of the metaphyses of the long bones, sclerosis of the craniofacial bones, macrocephaly, cleft palate and hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperostosis generalisata with striations</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteopathia striata-cranial sclerosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Robinow-Unger syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteopathia striata-cranial sclerosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010310</skos:exactMatch>
        <skos:exactMatch>MeSH:C536053</skos:exactMatch>
        <skos:exactMatch>OMIM:300373</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432268</skos:exactMatch>
    </owl:Class>

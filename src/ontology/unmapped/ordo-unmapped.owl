        <skos:exactMatch>OMIM:605432</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303670</skos:exactMatch>
        <skos:narrowMatch>OMIM:616738</skos:narrowMatch>
    </owl:Class>

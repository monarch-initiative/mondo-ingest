    <!-- http://www.orpha.net/ORDO/Orphanet_3341 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3341">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165707"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Torticollis-keloids-cryptorchidism-renal dysplasia syndrome is an extremely rare developmental defect during embryogenesis malformation syndrome characterized by congenital muscular torticollis associated with skin anomalies (such as multiple keloids, pigmented nevi, epithelioma), urogenital malformations (including cryptorchidism and hypospadias) and renal dysplasia (e.g. chronic pyelonephritis, renal atrophy). Additional reported features include varicose veins, intellectual disability and musculoskeletal anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Torticollis-keloids-cryptorchidism-renal dysplasia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Torticollis-keloids-cryptorchidism-renal dysplasia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0010748</skos:exactMatch>
        <skos:exactMatch>MeSH:C536970</skos:exactMatch>
        <skos:exactMatch>OMIM:314300</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749808</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

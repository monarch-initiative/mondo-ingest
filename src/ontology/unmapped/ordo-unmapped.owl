        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder/difference of sex development (DSD) characterized by atypical gonadal development that results in genital ambiguity of variable degree ranging from almost female phenotype to almost male phenotype in a patient carrying a 46,XY karyotype.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">46,XY PGD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>46,XY partial gonadal dysgenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">46,XY partial testicular dysgenesis</oboInOwl:hasExactSynonym>

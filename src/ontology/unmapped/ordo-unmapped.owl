    <!-- http://www.orpha.net/ORDO/Orphanet_69078 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_69078">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_3394"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Liposarcoma (LS), a type of soft tissue sarcoma, describes a group of lipomatous tumors of varying severity ranging from slow-growing to aggressive and metastatic. Liposarcomas are most often located in the lower extremities or retroperitoneum, but they can also occur in the upper extremities, neck, peritoneal cavity, spermatic cord, breast, vulva and axilla.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Liposarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Liposarcoma</rdfs:label>
        <skos:broadMatch>ICD-10:C49.9</skos:broadMatch>
        <skos:exactMatch>ICD-11:2B59</skos:exactMatch>
        <skos:exactMatch>MONDO:0005060</skos:exactMatch>
        <skos:exactMatch>MeSH:D008080</skos:exactMatch>
        <skos:exactMatch>MedDRA:10024627</skos:exactMatch>
        <skos:exactMatch>UMLS:C0023827</skos:exactMatch>
        <skos:narrowMatch>ICD-11:2B59.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:2B59.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:2B59.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:2B59.Y</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613488</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_69078"/>

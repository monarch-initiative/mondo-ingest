        <owl:annotatedTarget>Familial keratoacanthoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_493342 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_493342">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182734"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

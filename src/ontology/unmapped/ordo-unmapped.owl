    <!-- http://www.orpha.net/ORDO/Orphanet_329178 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329178">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309526"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_370953"/>

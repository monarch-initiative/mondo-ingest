    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_838">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

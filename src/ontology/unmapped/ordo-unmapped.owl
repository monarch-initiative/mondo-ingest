    <!-- http://www.orpha.net/ORDO/Orphanet_1442 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1442">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363203"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_729527"/>
        <obo:IAO_0000115 xml:lang="en">A rare cerebellar malformation characterized by congenital complete or partial fusion of the cerebellar hemispheres, dentate nuclei, and middle cerebellar peduncles, and complete or partial absence of the vermis. It may occur as an isolated anomaly or with other malformations of the brain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated rhombencephalosynapsis</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated rhombencephalosynapsis</rdfs:label>

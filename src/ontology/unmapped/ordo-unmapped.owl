            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism characterized by congenital hypertryptophanemia and hyperserotonemia. Patients are typically asymptomatic, although developmental delay, intellectual disability, and behavioral abnormalities, among others, have been reported in association.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hypertryptophanemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypertryptophanemia</rdfs:label>
        <skos:broadMatch>ICD-10:E70.8</skos:broadMatch>

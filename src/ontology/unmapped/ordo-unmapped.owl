    <!-- http://www.orpha.net/ORDO/Orphanet_295044 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_295044">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294953"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-syndromic limb overgrowth characterized by isolated congenital enlargement of some or all tissue elements of one or more digits of the hand, typically within a peripheral nerve territory, with the nerve itself being elongated, as well as increased in diameter. The index finger is most commonly affected. If two or more digits are involved, these are always adjacent. The enlargement may be progressive with disproportionate or static with proportionate growth and can be unilateral or bilateral. Patients may experience pain and reduced range of motion.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Macrodactyly of fingers</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Macrodactyly of hand</oboInOwl:hasExactSynonym>
        <rdfs:label>Macrodactyly of fingers</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB97.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0017474</skos:exactMatch>
        <skos:exactMatch>MeSH:C537720</skos:exactMatch>
        <skos:exactMatch>UMLS:C0574044</skos:exactMatch>
        <skos:narrowMatch>OMIM:155500</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_295044"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Macrodactyly of fingers</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_295047 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_295047">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294953"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-syndromic limb overgrowth characterized by isolated congenital enlargement of some or all tissue elements of one or more digits of a foot. Enlargement may be progressive with disproportionate or static with proportionate growth and can be unilateral or bilateral. It typically occurs within a peripheral nerve territory, with the nerve itself being elongated, as well as increased in diameter.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Macrodactyly of foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Macrodactyly of toes</oboInOwl:hasExactSynonym>
        <rdfs:label>Macrodactyly of toes</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB97.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0017475</skos:exactMatch>
        <skos:exactMatch>UMLS:C0158768</skos:exactMatch>
        <skos:narrowMatch>OMIM:155500</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_295047"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Macrodactyly of toes</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_295049 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_295049">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294953"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

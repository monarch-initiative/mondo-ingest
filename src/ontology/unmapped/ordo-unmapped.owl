    <!-- http://www.orpha.net/ORDO/Orphanet_60039 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_60039">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182086"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, acquired peripheral neuropathy characterized by chronic neuropathic pain involving the sensory territory of the pudendal nerve (from clitoris to anus or from penis to anus) aggravated by sitting. It is often associated with pelvic dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Alcock syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pudendal algia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pudendal nerve entrapment syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pudendal neuralgia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pudendal neuralgia by pudendal nerve entrapment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pudendal neuropathic pain syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pudendal neuropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pudendalgia</oboInOwl:hasExactSynonym>
        <rdfs:label>Pudendal nerve entrapment syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G58.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GA34.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018957</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_2496 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2496">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262065"/>

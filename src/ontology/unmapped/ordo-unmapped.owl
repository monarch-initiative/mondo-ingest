            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A severe form of oculocutaneous albinism type 1 (OCA1) characterized by complete absence of melanin and manifesting as white hair and skin, blue, fully translucent irises, nystagmus and misrouting of the optic nerves.</obo:IAO_0000115>

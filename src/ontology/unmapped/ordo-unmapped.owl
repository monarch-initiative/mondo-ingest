            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12367"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined oxidative phosphorylation deficiency type 3 is an extremely rare clinically heterogenous disorder described in about 5 patients to date. Clinical signs included hypotonia, lactic acidosis, and hepatic insufficiency, with progressive encephalomyopathy or hypertrophic cardiomyopathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Fatal mitochondrial disease due to COXPD3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fatal mitochondrial disease due to combined oxidative phosphorylation defect type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Fatal mitochondrial disease due to combined oxidative phosphorylation defect type 3</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.23</skos:broadMatch>
        <skos:exactMatch>MONDO:0012512</skos:exactMatch>
        <skos:exactMatch>OMIM:610505</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303760</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_168566"/>

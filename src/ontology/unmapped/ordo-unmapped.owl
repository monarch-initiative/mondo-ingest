                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7872"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Idiopathic achalasia (IA) is a primary esophageal motor disorder characterized by loss of esophageal peristalsis and insufficient lower esophageal sphincter (LES) relaxation in response to deglutition.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Achalasia cardia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Idiopathic achalasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic achalasia of esophagus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary achalasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic achalasia</rdfs:label>
        <skos:broadMatch>ICD-11:DA21.0</skos:broadMatch>
        <skos:exactMatch>ICD-10:K22.0</skos:exactMatch>

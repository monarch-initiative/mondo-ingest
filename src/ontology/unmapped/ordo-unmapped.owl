    <!-- http://www.orpha.net/ORDO/Orphanet_398189 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_398189">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_398166"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20577"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Focal facial dermal dysplasia type IV (FFDD4) is a rare focal facial dysplasia (FFDD), characterized by congenital isolated preauricular and/or cheek blister scar-like lesions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FFDD type IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FFDD4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Focal facial dermal dysplasia 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Focal facial dermal dysplasia type IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Focal facial preauricular dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Focal facial dermal dysplasia type IV</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013997</skos:exactMatch>
        <skos:exactMatch>OMIM:614974</skos:exactMatch>
        <skos:exactMatch>UMLS:C3554246</skos:exactMatch>
    </owl:Class>

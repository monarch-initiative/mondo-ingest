        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies syndrome characterized by the association of limb pterygia, heart anomalies, autosomal recessive inheritance, vertebral defects, ear anomalies and radial defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PHAVER syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Powell-Chandra-Saal syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>PHAVER syndrome</rdfs:label>

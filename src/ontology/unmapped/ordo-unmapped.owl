            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3775"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease associated with mild to severe intellectual deficit that may be associated with behavioral disorders and characteristic physical features including a high forehead, prominent and large ears, hyperextensible finger joints, flat feet with pronation and, in adolescent and adult males, macroorchidism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FRAXA syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FXS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FraX syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fragile X syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Martin-Bell syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Fragile X syndrome</rdfs:label>
        <skos:broadMatch>OMIM:300624</skos:broadMatch>
        <skos:broadMatch>OMIM:311360</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q99.2</skos:exactMatch>
        <skos:exactMatch>ICD-11:LD55</skos:exactMatch>
        <skos:exactMatch>MONDO:0010383</skos:exactMatch>
        <skos:exactMatch>MeSH:D005600</skos:exactMatch>

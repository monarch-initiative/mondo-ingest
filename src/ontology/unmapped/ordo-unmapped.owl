            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17768"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary ataxia characterized by an early onset symptomatic generalized epilepsy, progressive cerebellar ataxia resulting in significant difficulties to walk or wheelchair dependency, and intellectual disability.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive cerebellar ataxia-epilepsy-intellectual disability syndrome due to TUD deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCAR23</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spinocerebellar ataxia autosomal recessive type 23</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive cerebellar ataxia-epilepsy-intellectual disability syndrome due to TUD deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:G11.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0014846</skos:exactMatch>
        <skos:exactMatch>OMIM:616949</skos:exactMatch>
        <skos:exactMatch>UMLS:C4750914</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_404493"/>

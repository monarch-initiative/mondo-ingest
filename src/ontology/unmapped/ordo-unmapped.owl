    <!-- http://www.orpha.net/ORDO/Orphanet_93473 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93473">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

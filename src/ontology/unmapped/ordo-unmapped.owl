        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1263 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1263">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93425"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93441"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3755"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Boomerang dysplasia (BD) is a rare lethal skeletal dysplasia characterized by severe short-limbed dwarfism, dislocated joints, club feet, distinctive facies and diagnostic x-ray findings of underossified and dysplastic long tubular bones, with a boomerang-like bowing.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Boomerang dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Boomerang dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.E</skos:broadMatch>
        <skos:exactMatch>MONDO:0007208</skos:exactMatch>
        <skos:exactMatch>MeSH:C536573</skos:exactMatch>
        <skos:exactMatch>OMIM:112310</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432201</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

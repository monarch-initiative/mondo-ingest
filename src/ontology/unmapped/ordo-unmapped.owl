            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital atransferrinemia is a very rare hematologic disease caused by a transferrin (TF) deficiency and characterized by microcytic, hypochromic anemia (manifesting with pallor, fatigue and growth retardation) and iron overload, and that can be fatal if left untreated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital atransferrinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital hypotransferrinemia</oboInOwl:hasExactSynonym>

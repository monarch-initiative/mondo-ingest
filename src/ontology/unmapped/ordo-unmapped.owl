    <!-- http://www.orpha.net/ORDO/Orphanet_385 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_385">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276058"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306695"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_307058"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98534"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare neurometabolic disease characterized by progressive extrapyramidal dysfunction (including generalized or oromandibular dystonia, dysarthria, Parkinsonism, choreoathetosis), iron accumulation in the brain and the presence of axonal spheroids, usually limited to the central nervous system. It encompasses several disorders that can be distinguised by MRI and patients may present with variable clinical features including neuropathy, spastic paraplegia, encephalopathy, autism, dementia, diabetus mellitus, retinitis pigmentosa, optic atrophy, hypogonadism, alopecia and deafness. The age at onset and rate of progression are variable among individuals.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">NBIA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neurodegeneration with brain iron accumulation</oboInOwl:hasExactSynonym>
        <rdfs:label>Neurodegeneration with brain iron accumulation</rdfs:label>
        <skos:exactMatch>MONDO:0018307</skos:exactMatch>
        <skos:exactMatch>MONDO:18307</skos:exactMatch>
        <skos:exactMatch>MeSH:C538421</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931845</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_385"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neurodegeneration with brain iron accumulation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_386 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_386">

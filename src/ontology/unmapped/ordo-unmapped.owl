    <!-- http://www.orpha.net/ORDO/Orphanet_329242 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329242">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363300"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, usually benign, chronic, form of systemic mastocytosis (SM) characterized by an abnormal accumulation of neoplastic mast cells (MCs) mainly in the bone marrow (BM) but also in other organs or tissues such as preferably the skin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Indolent systemic mastocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Indolent systemic mastocytosis</rdfs:label>
        <skos:broadMatch>ICD-10:D47.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A21.0Y</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH2Y59</skos:exactMatch>
        <skos:exactMatch>MONDO:0020331</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056452</skos:exactMatch>
        <skos:exactMatch>UMLS:C0272203</skos:exactMatch>
    </owl:Class>

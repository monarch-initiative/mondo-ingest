    <!-- http://www.orpha.net/ORDO/Orphanet_2634 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2634">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

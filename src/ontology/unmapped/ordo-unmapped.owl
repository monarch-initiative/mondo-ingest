                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, inherited, epidermolysis bullosa simplex characterized by mild, predominantly acral, trauma-induced skin fragility, resulting in blisters. Blisters mostly affect the feet, including the dorsal side.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DST-related epidermolysis bullosa simplex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EBS due to BP230 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Epidermolysis bullosa simplex due to BP230 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Epidermolysis bullosa simplex due to BP230 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC30</skos:broadMatch>

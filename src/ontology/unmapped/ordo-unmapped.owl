    <!-- http://www.orpha.net/ORDO/Orphanet_261304 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_261304">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262164"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Paternal 20q13.2q13.3 microdeletion syndrome is a recently described syndrome characterized by severe pre- and post-natal growth retardation, microcephaly, intractable feeding difficulties, mild psychomotor retardation, hypotonia and facial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Paternal 20q13.2q13.3 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Paternal del(20)(q13.2q13.3)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Paternal monosomy 20q13.2q13.3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>paternal del(20)(q13.2q13.3)</oboInOwl:hasExactSynonym>
        <rdfs:label>Paternal 20q13.2q13.3 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.L0</skos:broadMatch>
        <skos:exactMatch>MONDO:0016842</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510306</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_114 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_114">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93441"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia with multiple joint dislocations characterized by multiple osseous dysplasia, characteristic ear shape (elongation of the lobe that is attached and accompanied by a small, slightly posterior lobule) and short stature. Dysplasia of the radiocapitellar joint has been reported in all patients. There have been no further descriptions in the literature since 1967.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Auriculoosteodysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Auriculoosteodysplasia</rdfs:label>

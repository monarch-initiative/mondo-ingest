        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Diffuse panbronchiolitis is a rare chronic inflammatory obstructive pulmonary disease primarily affecting the respiratory bronchioles throughout both lungs and inducing sinobronchial infection. Onset occurs in the second to fifth decade of life and manifests by chronic cough, exertional dyspnea, and sputum production. Most patients also have chronic paranasal sinusitis</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Diffuse panbronchiolitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Diffuse panbronchiolitis</rdfs:label>
        <skos:broadMatch>ICD-10:J44.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:CA26.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0011490</skos:exactMatch>
        <skos:exactMatch>MeSH:C536174</skos:exactMatch>
        <skos:exactMatch>MedDRA:10062952</skos:exactMatch>
        <skos:exactMatch>OMIM:604809</skos:exactMatch>
        <skos:exactMatch>UMLS:C0878555</skos:exactMatch>
    </owl:Class>

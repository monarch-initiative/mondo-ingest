        <obo:IAO_0000115 xml:lang="en">A form of adrenal Cushing syndrome, an endogenous Cushing syndrome (CS), characterized by chronic over-secretion of cortisol due to a benign adrenal tumor that arises from the adrenal cortex.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CS due to cortisol-producing adrenocortical adenoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cushing syndrome due to cortisol-producing adrenocortical adenoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Cushing syndrome due to cortisol-producing adrenocortical adenoma</rdfs:label>
        <skos:broadMatch>ICD-10:E24.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A70.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0958258</skos:exactMatch>

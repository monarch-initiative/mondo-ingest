    <!-- http://www.orpha.net/ORDO/Orphanet_97231 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97231">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C044"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Conjunctivitis lignosa</oboInOwl:hasExactSynonym>
        <rdfs:label>Ligneous conjunctivitis</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:exactMatch>MedDRA:10071570</skos:exactMatch>
        <skos:exactMatch>UMLS:C1274789</skos:exactMatch>
    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_97232 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97232">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_97245"/>
        <obo:IAO_0000115 xml:lang="en">Fingerprint body myopathy is a congenital benign muscle disorder characterised by congenital hypotonia and weakness and by the presence of numerous fingerprint bodies located at the periphery of the muscle fibers. Prevalence is unknown. Less than 20 patients have been described. Few sporadic cases have been observed, as well as cases of recessive transmission.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fingerprint body myopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Fingerprint body myopathy</rdfs:label>
        <skos:broadMatch>ICD-10:G71.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C72.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010591</skos:exactMatch>
        <skos:exactMatch>MeSH:C564425</skos:exactMatch>
        <skos:exactMatch>OMIM:305550</skos:exactMatch>
        <skos:exactMatch>UMLS:C1844560</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97232"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Fingerprint body myopathy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_97234 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97234">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79201"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8889"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare glycogen storage disease characterized by susceptibility to rhabdomyolysis complicated by episodes of exercise-induced muscle pain, cramping, and myoglobinuria. Tubular aggregates may be present on muscle biopsy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DiMauro disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD due to phosphoglycerate mutase 2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type 10</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease due to PGAM2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease due to phosphoglycerate mutase 2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glycogen storage disease due to phosphoglycerate mutase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease, type 10</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease, type X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis due to phosphoglycerate mutase 2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Muscle phosphoglycerate mutase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myopathy due to phosphoglycerate mutase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PGAM deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PGAM-M  deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Glycogen storage disease due to phosphoglycerate mutase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0009865</skos:exactMatch>
        <skos:exactMatch>OMIM:261670</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268149</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An autosomal dominant cerebellar ataxia type III that is characterized by late-onset and slowly progressive gait ataxia and other cerebellar signs such as impaired muscle coordination and nystagmus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA6</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 6</oboInOwl:hasExactSynonym>

        <skos:exactMatch>MedDRA:10026829</skos:exactMatch>
        <skos:exactMatch>UMLS:C0024796</skos:exactMatch>
        <skos:narrowMatch>OMIM:154700</skos:narrowMatch>
    </owl:Class>

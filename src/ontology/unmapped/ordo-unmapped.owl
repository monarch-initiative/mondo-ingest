    <!-- http://www.orpha.net/ORDO/Orphanet_1394 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1394">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

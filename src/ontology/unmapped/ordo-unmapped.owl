    <!-- http://www.orpha.net/ORDO/Orphanet_91494 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91494">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139039"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183557"/>

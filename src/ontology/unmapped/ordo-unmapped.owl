    <!-- http://www.orpha.net/ORDO/Orphanet_320360 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_320360">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102013"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare complex hereditary spastic paraplegia characterized by adulthood-onset of slowly progressive, bilateral, mainly lower limb spasticity and distal weakness associated with lower limb pain, hyperreflexia, and reduced vibration sense. Axonal neuropathy is frequently observed on electromyography and nerve conduction examination.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MT-ATP6-related mitochondrial spastic paraplegia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maternally-inherited SPG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maternally-inherited spastic paraplegia</oboInOwl:hasExactSynonym>
        <rdfs:label>MT-ATP6-related mitochondrial spastic paraplegia</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017917</skos:exactMatch>
        <skos:exactMatch>UMLS:C4755299</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_320360"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>MT-ATP6-related mitochondrial spastic paraplegia</owl:annotatedTarget>

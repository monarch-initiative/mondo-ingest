                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11976"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18122"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial vesicoureteral reflux is a rare, non-syndromic urogenital tract malformation characterized by the familial occurrence of retrograde flow of urine from the bladder into the ureter and sometimes the kidneys. Patients may be asymptomatic or may present with recurrent, sometimes febrile, urinary tract infections that, in case of acute pyelonephritis, may lead to serious complications (renal scarring, hypertension, renal failure). Spontaneous resolution of the disorder is possible.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial VUR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial vesicoureteral reflux</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial vesicoureteral reflux</rdfs:label>
        <skos:broadMatch>ICD-10:N13.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB56.5</skos:broadMatch>
        <skos:broadMatch>OMIM:193000</skos:broadMatch>
        <skos:exactMatch>MONDO:0017329</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706552</skos:exactMatch>
        <skos:narrowMatch>OMIM:610878</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613674</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614317</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614318</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614319</skos:narrowMatch>

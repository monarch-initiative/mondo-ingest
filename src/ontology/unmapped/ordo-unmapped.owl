        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95710"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by a clinical picture of variable severity associating sensorineural hearing impairment with ovarian dysgenesis in females, sometimes progressive neurologic disorder, and exceptionally renal disease. The disease affects both sexes, but hypogonadism is not a feature in males.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Perrault syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XX gonadal dysgenesis-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XX gonadal dysgenesis-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Perrault syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017312</skos:exactMatch>
        <skos:exactMatch>MeSH:C537286</skos:exactMatch>
        <skos:exactMatch>OMIM:233400</skos:exactMatch>
        <skos:exactMatch>UMLS:C0685838</skos:exactMatch>
        <skos:narrowMatch>OMIM:614129</skos:narrowMatch>

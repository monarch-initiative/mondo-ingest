        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16639"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare overgrowth/obesity syndrome characterized by mild developmental delay (notably speech delay), behaviour abnormalities (including autistic or attention deficit hyperactivity disorder features, hypersociability/ overfriendliness), overweight/obesity and mild dysmorphic features (including deep set eyes, broad bulbous nasal tip, large everted ears and thin upper lip). Other clinical features include variable and mild intellectual diability when present, broad short hands and feet.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Developmental delay-overweight-facial dysmorphism-behavioral abnormalities syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Developmental delay-overweight-facial dysmorphism-behavioral abnormalities syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0957397</skos:exactMatch>
        <skos:exactMatch>MONDO:957397</skos:exactMatch>
        <skos:exactMatch>OMIM:620439</skos:exactMatch>
        <skos:exactMatch>UMLS:C5924786</skos:exactMatch>
    </owl:Class>

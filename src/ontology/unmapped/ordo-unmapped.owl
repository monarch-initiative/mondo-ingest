            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Metachondromatosis (MC) is a rare disorder characterized by the presence of both multiple enchondromas and osteochondroma-like lesions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Metachondromatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Metachondromatosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.4</skos:broadMatch>

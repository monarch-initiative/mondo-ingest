        <obo:IAO_0000115 xml:lang="en">A rare nevus syndrome characterized by the association of an nevus sebaceous with a broad spectrum of abnormalities that affect many organ systems, most commonly the eye, skeletal and central nervous system.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Linear nevus sebaceus syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nevus sebaceus of Jadassohn</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic urinary tract malformation characterized by the association of severe voiding dysfunction and inversion of facial expression when the child smiles or cries.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hydronephrosis-inverted smile syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inverted smile-neurogenic bladder syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ochoa facial syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ochoa syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Partial facial palsy with urinary abnormalities</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Urofacial syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Urofacial syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:N31.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0000463</skos:exactMatch>

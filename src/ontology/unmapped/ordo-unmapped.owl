        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Progressive non-fluent aphasia (PNFA) is a form of frontotemporal dementia (FTD), characterized by agrammatism, laborious speech, alexia, and agraphia, frequently accompanied by apraxia of speech (AOS). Language comprehension is relatively preserved.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Agramatic variant of PPA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Agramatic variant of primary progressive aphasia</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Woodhouse-Sakati syndrome is a multisystemic disorder characterized by hypogonadism, alopecia, diabetes mellitus, intellectual deficit and extrapyramidal signs with choreoathetoid movements and dystonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diabetes-hypogonadism-deafness-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Diabetes-hypogonadism-hearing loss-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Woodhouse-Sakati syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Woodhouse-Sakati syndrome</rdfs:label>

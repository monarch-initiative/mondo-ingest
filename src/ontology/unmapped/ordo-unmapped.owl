            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Paroxysmal kinesigenic dyskinesia (PKD) is a form of paroxysmal dyskinesia, characterized by recurrent brief involuntary hyperkinesias, such as choreoathetosis, ballism, athetosis or dystonia, triggered by sudden movements.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial PKD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial paroxysmal kinesigenic dyskinesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Paroxysmal kinesigenic choreathetosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Paroxysmal kinesigenic dyskinesia</oboInOwl:hasExactSynonym>
        <rdfs:label>Paroxysmal kinesigenic dyskinesia</rdfs:label>
        <skos:broadMatch>ICD-10:G24.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A02.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0044202</skos:exactMatch>
        <skos:exactMatch>MONDO:44202</skos:exactMatch>
        <skos:exactMatch>OMIM:128200</skos:exactMatch>
        <skos:exactMatch>UMLS:C1868682</skos:exactMatch>
        <skos:narrowMatch>OMIM:611031</skos:narrowMatch>
    </owl:Class>

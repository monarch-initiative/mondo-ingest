    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_440392">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264930"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264992"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10802"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic interstitial lung disease characterized by diffuse lung disease of variable phenotype ranging from severe respiratory insufficiency in infancy to asymptomatic adults, due to surfactant protein C deficiency. Typical presentation in infancy includes dyspnea, cough, wheezing, and gradual cyanosis, with or without failure to thrive. Radiological findings include diffuse ground-glass opacities in neonates, later interstitial thickening associated with lung hyperinflation, intraparenchymal/subpleural cysts, honeycombing, subpleural nodules, or bronchiectasis. Infiltrates and air leaks are frequent complications.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Interstitial lung disease due to SP-C deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Interstitial lung disease due to surfactant protein C deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Interstitial lung disease due to SP-C deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:J84.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:CB04.2</skos:broadMatch>
        <skos:broadMatch>OMIM:610913</skos:broadMatch>
        <skos:exactMatch>MONDO:0018603</skos:exactMatch>
        <skos:exactMatch>MeSH:C567048</skos:exactMatch>
        <skos:exactMatch>UMLS:C1970470</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_440392"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Interstitial lung disease due to SP-C deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_440402 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_440402">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100049"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/33"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic respiratory disease characterized by a variable clinical outcome ranging from a fatal respiratory distress syndrome in the neonatal period to chronic interstitial lung disease developing in infancy or childhood with chronic cough, rapid breathing, shortness of breath and recurrent pulmonary infections. Clinical manifestations of respiratory failure include grunting, intercostal retractions, nasal flaring, cyanosis, and progressive dyspnea.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Interstitial lung disease due to ABCA3 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Interstitial lung disease due to ATP-binding cassette subfamily A member 3 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Interstitial lung disease due to ABCA3 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:J84.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:CB04.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0012582</skos:exactMatch>
        <skos:exactMatch>MeSH:C567046</skos:exactMatch>
        <skos:exactMatch>OMIM:610921</skos:exactMatch>
        <skos:exactMatch>UMLS:C1970456</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_440402"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Interstitial lung disease due to ABCA3 deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_440427 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_440427">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100049"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101939"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156604"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6898"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic interstitial lung disease characterized by accumulation of lipoproteins in the pulmonary alveoli leading to restrictive lung disease and respiratory failure. Patients present with dyspnea, tachypnea, cough, failure to thrive, and digital clubbing. Liver disease have been described in some cases including hepatomegaly, steatosis, fibrosis or cirrhosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary pulmonary alveolar proteinosis with hepatic involvement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Interstitial lung and liver disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PAP, Reunion island type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pulmonary alveolar proteinosis, Reunion island type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Severe early-onset pulmonary alveolar proteinosis due to MARS deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe early-onset pulmonary alveolar proteinosis due to MARS deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:J84.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:CB04.31</skos:broadMatch>
        <skos:exactMatch>MONDO:0014206</skos:exactMatch>
        <skos:exactMatch>OMIM:615486</skos:exactMatch>
        <skos:exactMatch>UMLS:C4225400</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_440427"/>

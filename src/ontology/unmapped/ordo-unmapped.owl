        <rdfs:label>Ring chromosome 17 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD7Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015433</skos:exactMatch>
        <skos:exactMatch>MeSH:C538046</skos:exactMatch>
        <skos:exactMatch>UMLS:C0795863</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1441"/>

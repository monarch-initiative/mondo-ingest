    <!-- http://www.orpha.net/ORDO/Orphanet_139507 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139507">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309842"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare disorder described in sub-Saharan African populations and characterized by iron overload due to excess dietary iron intake and possibly genetic factors, leading to hepatic portal fibrosis and micronodular cirrhosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">African iron overload</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bantu siderosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dietary iron overload disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Dietary iron overload disease</rdfs:label>
        <skos:broadMatch>ICD-10:E83.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0011012</skos:exactMatch>
        <skos:exactMatch>MeSH:C537904</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083862</skos:exactMatch>
        <skos:exactMatch>OMIM:601195</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268063</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_139507"/>

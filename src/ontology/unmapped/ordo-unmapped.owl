    <!-- http://www.orpha.net/ORDO/Orphanet_280774 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280774">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

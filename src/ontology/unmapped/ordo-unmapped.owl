            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Beta-thalassemia (BT) major is a severe early-onset form of BT characterized by severe anemia requiring regular red blood cell transfusions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Beta transfusion dependent thalassemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Beta-TDT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Beta-thalassemia major</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cooley anemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mediterranean anemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Beta-thalassemia major</rdfs:label>
        <skos:broadMatch>ICD-10:D56.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A50.2</skos:broadMatch>
        <skos:broadMatch>OMIM:613985</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_93610 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93610">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_18"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_228312 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_228312">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98375"/>
        <obo:IAO_0000115 xml:lang="en">Cold autoimmune hemolytic anemia comprises two types of autoimmune hemolytic anemia (AIHA) defined by the presence of cold autoantibodies (autoantibodies which are active at temperatures below 30&amp;nbsp;°C): cold agglutinin disease (CAD), which is the more common, and paroxysmal cold hemoglobinuria (PCH).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autoimmune hemolytic anemia, cold type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cold AIHA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">cAHA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">cAIHA</oboInOwl:hasExactSynonym>
        <rdfs:label>Autoimmune hemolytic anemia, cold type</rdfs:label>
        <skos:exactMatch>ICD-11:3A20.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0016450</skos:exactMatch>
        <skos:exactMatch>MONDO:16450</skos:exactMatch>
        <skos:exactMatch>MedDRA:10009868</skos:exactMatch>
        <skos:exactMatch>UMLS:C5848126</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_228312"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autoimmune hemolytic anemia, cold type</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



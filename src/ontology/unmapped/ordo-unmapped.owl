    <!-- http://www.orpha.net/ORDO/Orphanet_306577 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_306577">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98497"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10582"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10583"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10597"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, peripheral neuropathy disorder due to gain-of-function mutations in voltage-gated sodium channels present in the small peripheral nerve fibers characterized by neuropathic pain of varying intensity (often beginning in the distal extermities and with a burning quality) associated with autonomic dysfunction (e.g. orthostatic dizziness, palpitations, dry eyes and mouth), abnormal quantitative sensory testing, and reduction in intraepidermal nerve &amp;#64257;ber density. Large fiber functions (i.e. normal strength, tendon reflexes, and vibration sense) and nerve conduction studies are typically normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hereditary sodium channelopathy-related small fibers neuropathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary sodium channelopathy-related small fibers neuropathy</rdfs:label>
        <skos:broadMatch>ICD-10:G99.1</skos:broadMatch>
        <skos:broadMatch>OMIM:133020</skos:broadMatch>
        <skos:exactMatch>MONDO:0017629</skos:exactMatch>
        <skos:exactMatch>UMLS:C5925033</skos:exactMatch>
        <skos:narrowMatch>OMIM:615551</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_306577"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hereditary sodium channelopathy-related small fibers neuropathy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



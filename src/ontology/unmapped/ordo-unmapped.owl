    <!-- http://www.orpha.net/ORDO/Orphanet_90695 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90695">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_178025"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181390"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11199"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9455"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic pituitary disease characterized by variable deficiency of all hormones produced in the anterior lobe of the pituitary gland. Clinical manifestations include hypothyroidism, hypogonadism, growth retardation and short stature, and secondary adrenal insufficiency. Age of onset is variable. Signs and symptoms usually develop gradually, and loss of the different hormones is often sequential.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Genetic panhypopituitarism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Non-acquired panhypopituitarism</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-acquired panhypopituitarism</rdfs:label>
        <skos:broadMatch>ICD-10:E23.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A61.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0019591</skos:exactMatch>
        <skos:exactMatch>MONDO:19591</skos:exactMatch>
        <skos:exactMatch>MedDRA:10033662</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680191</skos:exactMatch>
        <skos:narrowMatch>OMIM:262600</skos:narrowMatch>
        <skos:narrowMatch>OMIM:312000</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90695"/>

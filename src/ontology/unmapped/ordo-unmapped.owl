        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98718"/>
        <obo:IAO_0000115 xml:lang="en">A rare heart defect characterized by complete lack of anatomical continuity between the transverse aortic arch and the descending thoracic aorta. AAI should be distinguished anatomically from atresia of the aortic arch where continuity between these segments is achieved by an imperforate fibrous strand of various lengths.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aortic arch interruption</oboInOwl:hasExactSynonym>
        <rdfs:label>Aortic arch interruption</rdfs:label>
        <skos:broadMatch>ICD-10:Q25.4</skos:broadMatch>

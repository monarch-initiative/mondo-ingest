    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2289 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2289">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276058"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

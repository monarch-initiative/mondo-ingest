        <oboInOwl:hasExactSynonym xml:lang="en">Multilocular peritoneal inclusion cyst</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Peritoneal cyctic mesothelioma</oboInOwl:hasExactSynonym>

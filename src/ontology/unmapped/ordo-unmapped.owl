        <skos:exactMatch>MedDRA:10083037</skos:exactMatch>
        <skos:exactMatch>UMLS:C0338573</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_329217"/>

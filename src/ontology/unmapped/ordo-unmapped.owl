    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95611">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95502"/>
        <oboInOwl:hasExactSynonym>Pituitary hormone deficiency of vascular origin</oboInOwl:hasExactSynonym>
        <rdfs:label>Pituitary hormone deficiency of vascular origin</rdfs:label>
        <skos:exactMatch>UMLS:C5681571</skos:exactMatch>
    </owl:Class>

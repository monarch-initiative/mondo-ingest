                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10923"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked syndromic intellectual disability with neuromuscular involvement characterized by a varying degree of neurodevelopmental delay including hypotonia, hypokinesia, dystonia and spasticity, and a wide range of clinical sequelae secondary to chronic peripheral thyrotoxicosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AHDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Allan-Herndon-Dudley syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MCT8 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monocarboxylate transporter 8 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked intellectual disability-hypotonia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Allan-Herndon-Dudley syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E03.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A00.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010354</skos:exactMatch>
        <skos:exactMatch>MeSH:C537047</skos:exactMatch>
        <skos:exactMatch>MedDRA:10078821</skos:exactMatch>
        <skos:exactMatch>OMIM:300523</skos:exactMatch>
        <skos:exactMatch>UMLS:C0795889</skos:exactMatch>
    </owl:Class>

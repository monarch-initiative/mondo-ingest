    <!-- http://www.orpha.net/ORDO/Orphanet_1451 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1451">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_208650"/>

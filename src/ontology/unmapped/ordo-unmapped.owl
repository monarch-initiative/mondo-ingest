            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Dysspondyloenchondromatosis is a rare skeletal dysplasia characterized by anisospondyly and multiple enchondromas in vertebrae and the metaphyseal and diaphyseal parts of long tubular bones, leading to kyphoscoliosis and lower limb asymmetry.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dysspondyloenchondromatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Dysspondyloenchondromatosis</rdfs:label>

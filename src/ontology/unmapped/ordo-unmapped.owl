        <obo:IAO_0000115 xml:lang="en">A rare genetic multiple pterygium syndrome characterized by intrauterine growth retardation, fetal akinesia, multiple joint contractures causing severe arthrogryposis and pterygia (webbing) across multiple joints. Cystic hygroma and/or fetal hydrops are almost invariably present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive lethal multiple pterygium syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LMPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lethal multiple pterygium syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lethal multiple pterygium syndrome</rdfs:label>

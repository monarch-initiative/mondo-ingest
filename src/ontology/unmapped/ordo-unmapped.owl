    <!-- http://www.orpha.net/ORDO/Orphanet_596 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_596">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207110"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

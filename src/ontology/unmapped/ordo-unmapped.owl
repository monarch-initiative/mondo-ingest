    <!-- http://www.orpha.net/ORDO/Orphanet_284417 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_284417">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

        <owl:annotatedTarget>B3GALT6-related spondylodysplastic Ehlers-Danlos syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_567558"/>
        <obo:IAO_0000115 xml:lang="en">A rare inflammatory multisystem disorder characterized clinically by four cardinal signs: fever of unknown origin, arthralgia or arthritis, hyperleucocytosis, and typical skin rash.</obo:IAO_0000115>

    <!-- http://www.orpha.net/ORDO/Orphanet_284426 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_284426">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2364"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

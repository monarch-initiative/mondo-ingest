    <!-- http://www.orpha.net/ORDO/Orphanet_631248 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_631248">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140453"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/119"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurological disorder characterized by childhood to adolescence onset of progressive demyelination occurring in episodes, sensorimotor polyneuropathy, and hearing loss. Disease progression and severity is variable. In general, in a waxing and waning course, patients eventually develop respiratory insufficiency, loss of motor skills and ambulation, ataxia, and cognitive decline. Vision problems and skin rashes are commonly reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mitchell Syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Mitchell Syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G60.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0030073</skos:exactMatch>
        <skos:exactMatch>OMIM:618960</skos:exactMatch>
        <skos:exactMatch>UMLS:C5394554</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_631248"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mitchell Syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



    <!-- http://www.orpha.net/ORDO/Orphanet_93335 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93335">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498467"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4319"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital limb malformation characterized by duplication of the fifth digit in a hand or foot, the sixth digit being rudimentary, poorly developed, and non-functional, frequently consisting of additional soft tissue on a pedicle. The anomaly can be unilateral or bilateral.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Postaxial polydactyly type B</oboInOwl:hasExactSynonym>
        <rdfs:label>Postaxial polydactyly type B</rdfs:label>
        <skos:broadMatch>ICD-10:Q69.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB78.2</skos:broadMatch>
        <skos:broadMatch>OMIM:174200</skos:broadMatch>
        <skos:exactMatch>MONDO:0019674</skos:exactMatch>
        <skos:exactMatch>UMLS:C1868120</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93335"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

        <oboInOwl:hasExactSynonym xml:lang="en">Mixed cryoglobulinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary cryoglobulinemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Cryoglobulinemic vasculitis</rdfs:label>
        <skos:broadMatch>ICD-10:D89.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:4A44.90</skos:exactMatch>

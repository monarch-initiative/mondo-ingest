    <!-- http://www.orpha.net/ORDO/Orphanet_498481 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_498481">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93446"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6697"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia characterized by reduced bone mineral density (defined as a Z score below -2.0), vertebral compression fractures, and recurrent peripheral fractures caused by low-impact trauma, leading to bone pain and impaired mobility. Patients typically become symptomatic in childhood or adolescence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>LRP5-related primary osteoporosis</oboInOwl:hasExactSynonym>
        <rdfs:label>LRP5-related primary osteoporosis</rdfs:label>
        <skos:broadMatch>ICD-10:M85.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.KY</skos:broadMatch>
        <skos:exactMatch>MONDO:0044675</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567241</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_498481"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>LRP5-related primary osteoporosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_498485 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_498485">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498448"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare overgrowth syndrome with skeletal involvement characterized by pre- or postnatal onset of overgrowth, accelerated bone age in infancy and early childhood, tall stature, bony overgrowth of the skull base, spondylar dysplasia, and undermodeling of the tubular bones. Facial dysmorphism includes mild hypertelorism, depressed nasal bridge, short and broad nose, and full lower lip. Additional reported features are scoliosis, as well as delayed puberty, cryptorchidism, and hypospadias.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Overgrowth-metaphyseal undermodeling-spondylar dysplasia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Overgrowth-metaphyseal undermodeling-spondylar dysplasia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2C</skos:broadMatch>
        <skos:exactMatch>MONDO:0012131</skos:exactMatch>
        <skos:exactMatch>MeSH:C537355</skos:exactMatch>
        <skos:exactMatch>OMIM:608811</skos:exactMatch>
        <skos:exactMatch>UMLS:C1837316</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_498485"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Overgrowth-metaphyseal undermodeling-spondylar dysplasia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_498488 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_498488">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263708"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498448"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare overgrowth syndrome with skeletal involvement characterized by long and slim body habitus and multiple skeletal manifestations, such as scoliosis, macrodactyly of the big toes, arachnodactyly of fingers and toes, camptodactyly and clinodactyly, and progressive valgus deformities of the feet. Epimetaphyseal dysplasia, bowing of the tibiae, and dysmorphic facial features (hypertelorism, high palate, or micrognathia), as well as aortic root dilatation and umbilical hernia have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Overgrowth syndrome with 2q37 translocation</oboInOwl:hasExactSynonym>
        <rdfs:label>Overgrowth syndrome with 2q37 translocation</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2C</skos:broadMatch>
        <skos:exactMatch>MONDO:0034676</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567236</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_498488"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Overgrowth syndrome with 2q37 translocation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_498491 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_498491">

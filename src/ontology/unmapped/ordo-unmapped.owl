    <!-- http://www.orpha.net/ORDO/Orphanet_352563 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_352563">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217587"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35696"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16650"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare mitochondrial oxidative phosphorylation disorder with complex I and IV deficiency characterized by hypertrophic cardiomyopathy, hepatic steatosis with elevated liver transaminases, exercise intolerance and muscle weakness. Neuro-opthalmological features (hemiplegic migraine, Leigh-like lesions on brain MRI, pigmentary retinopathy) have been reported later in life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COXPD16</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Combined oxidative phosphorylation defect type 16</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Infantile hypertrophic cardiomyopathy due to MRPL44 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile hypertrophic cardiomyopathy due to MRPL44 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0014162</skos:exactMatch>
        <skos:exactMatch>OMIM:615395</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749946</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

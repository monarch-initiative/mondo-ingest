    <!-- http://www.orpha.net/ORDO/Orphanet_46484 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_46484">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182067"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">Oligodendrogliomas are cerebral tumors that are differentiated from other gliomas on the basis of their unique genetic characteristics and better response to chemotherapy. These tumors are classified according to their grade (low grade oligodendrogliomas: grade II of the WHO classification and anaplastic oligodendrogliomas: grade III of the WHO classification) and according to their pure or mixed histology (oligoastrocytomas).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Oligodendroglial tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Oligodendroglial tumor</rdfs:label>

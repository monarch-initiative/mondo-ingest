            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Osteocraniostenosis is a lethal skeletal dysplasia characterized by a cloverleaf skull anomaly, facial dysmorphism, limb shortness, splenic hypo/aplasia and radiological anomalies including thin tubular bones with flared metaphyses and deficient calvarial mineralization.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Gracile bone dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteocraniosplenic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteocraniostenosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteocraniostenosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.D</skos:broadMatch>
        <skos:exactMatch>MONDO:0011215</skos:exactMatch>

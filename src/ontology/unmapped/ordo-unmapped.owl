    <!-- http://www.orpha.net/ORDO/Orphanet_2825 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2825">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2699 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2699">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_155832"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare familial facial anomaly characterized by a nodule beneath the vermilion border of the upper lip that tapered into the frenulum. The lesion is soft, easily compressible and asymptomatic. It can be wide (up to 8 mm) or flat and less prominent. Regression of the nodule by age has been reported. There have been no further descriptions in the literature since 1994.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Median nodule of the upper lip</oboInOwl:hasExactSynonym>
        <rdfs:label>Median nodule of the upper lip</rdfs:label>
        <skos:broadMatch>ICD-10:Q18.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0007904</skos:exactMatch>
        <skos:exactMatch>OMIM:151630</skos:exactMatch>
        <skos:exactMatch>UMLS:C1835396</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2699"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Median nodule of the upper lip</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_27 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_27">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_293355"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93593"/>
        <obo:IAO_0000115 xml:lang="en">Vitamin B12-unresponsive methylmalonic acidemia is an inborn error of vitamin B12 (cobalamin) metabolism characterized by recurrent ketoacidotic crises or transient vomiting, dehydration, hypotonia and intellectual deficit, which does not respond to administration of vitamin B12. There are two types of vitamin B12-unresponsive methylmalonic acidemia: &lt;i&gt;mut0&lt;/i&gt; and &lt;i&gt;mut-&lt;/i&gt;.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Methylmalonyl-CoA mutase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Methylmalonyl-Coenzyme A mutase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vitamin B12-unresponsive methylmalonic acidemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vitamin B12-unresponsive methylmalonic aciduria</oboInOwl:hasExactSynonym>
        <rdfs:label>Vitamin B12-unresponsive methylmalonic acidemia</rdfs:label>
        <skos:broadMatch>ICD-10:E71.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E0</skos:broadMatch>
        <skos:exactMatch>MONDO:0009612</skos:exactMatch>
        <skos:exactMatch>MONDO:9612</skos:exactMatch>
        <skos:exactMatch>MeSH:C537573</skos:exactMatch>
        <skos:exactMatch>OMIM:251000</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931536</skos:exactMatch>
    </owl:Class>

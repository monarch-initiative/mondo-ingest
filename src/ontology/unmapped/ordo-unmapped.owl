    <!-- http://www.orpha.net/ORDO/Orphanet_3426 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3426">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2445"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271853"/>

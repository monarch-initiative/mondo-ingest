    <!-- http://www.orpha.net/ORDO/Orphanet_83461 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_83461">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183557"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183607"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98553"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Carney-Stratakis syndrome is a recently described familial syndrome characterized by gastrointestinal stromal tumors (GIST) and paragangliomas, often at multiple sites.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Carney dyad</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Carney-Stratakis dyad</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Carney-Stratakis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GIST-paraganglioma dyad</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Paraganglioma and gastric stromal sarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Carney-Stratakis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D44.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F7A.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0011740</skos:exactMatch>
        <skos:exactMatch>MeSH:C564650</skos:exactMatch>
        <skos:exactMatch>OMIM:606864</skos:exactMatch>
        <skos:exactMatch>UMLS:C1847319</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97286"/>

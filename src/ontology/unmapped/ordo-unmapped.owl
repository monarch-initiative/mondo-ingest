        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Dentinogenesis imperfecta (DGI) is a hereditary dentin defect characterized by abnormal dentin structure resulting in abnormal tooth development.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DGI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DGI without OI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dentinogenesis imperfecta</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dentinogenesis imperfecta without osteogenesis imperfecta</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-syndromic DGI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-syndromic dentinogenesis imperfecta</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Opalescent teeth without OI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Opalescent teeth without osteogenesis imperfecta</oboInOwl:hasExactSynonym>
        <rdfs:label>Dentinogenesis imperfecta</rdfs:label>
        <skos:broadMatch>ICD-10:K00.5</skos:broadMatch>

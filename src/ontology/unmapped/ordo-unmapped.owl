        <rdfs:label>OBSOLETE: Autosomal dominant coarctation of aorta</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1456 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1456">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98718"/>
        <obo:IAO_0000115 xml:lang="en">A rare vascular anomaly characterized by the segmental narrowing of the abdominal and/or distal descending thoracic aorta, with varying involvement of the visceral and renal arteries, that commonly presents in children and young adults with early onset and refractory hypertension, abdominal angina, and lower-limb claudication, that can lead to life-threatening complications associated with severe hypertension (i.e. myocardial infarction, heart failure, aortic rupture, renal insufficiency and intracranial hemorrhage). It may be due to various congenital or acquired causes, but it is most often secondary to an acquired inflammatory disease (i.e. Takayasu arteritis or giant cell arteritis).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Abdominal coarctation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Coarctation of the abdominal aorta</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MAC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mid-aortic dysplastic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mid-aortic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Midaortic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Middle aortic coarctation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Middle aortic syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Middle aortic syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q25.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA8B.21</skos:broadMatch>
        <skos:exactMatch>MONDO:0015446</skos:exactMatch>
        <skos:exactMatch>UMLS:C3496579</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1456"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Middle aortic syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1457 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1457">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98718"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital non-syndromic heart malformation characterized by a discrete luminal narrowing of the aorta, typically located at the junction between the aortic arch and the descending aorta, opposite the site of ductus arteriosus insertion. Coarctation of aorta (CoA) is often associated with other cardiac anomalies including bicuspid aortic valve and tubular hypoplasia of the transverse arch.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Aorta coarctation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Coarctation of aorta</oboInOwl:hasExactSynonym>
        <rdfs:label>Coarctation of aorta</rdfs:label>
        <skos:exactMatch>ICD-10:Q25.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA8B.21</skos:exactMatch>
        <skos:exactMatch>MONDO:0007345</skos:exactMatch>
        <skos:exactMatch>MeSH:D001017</skos:exactMatch>
        <skos:exactMatch>MedDRA:10009807</skos:exactMatch>
        <skos:exactMatch>OMIM:120000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0003492</skos:exactMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare frontonasal dysplasia characterized by craniosynostosis, Poland anomaly, cranio-fronto-nasal dysplasia, and genital and breast anomalies. There have been no further descriptions in the literature since 1994.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Craniofrontonasal dysplasia-Poland anomaly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Webster-Deming syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Craniofrontonasal dysplasia-Poland anomaly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0015464</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303859</skos:exactMatch>
    </owl:Class>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare skin disease that is the most common form of porokeratosis characterized by the presence of several small annular plaques with a distinctive keratotic rim found most commonly on sun-exposed areas of the skin, particularly the extremities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Disseminated superficial actinic porokeratosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Disseminated superficial actinic porokeratosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:ED52</skos:broadMatch>
        <skos:exactMatch>MONDO:0019212</skos:exactMatch>
        <skos:exactMatch>MedDRA:10085766</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265970</skos:exactMatch>
        <skos:narrowMatch>OMIM:175900</skos:narrowMatch>
        <skos:narrowMatch>OMIM:607728</skos:narrowMatch>
        <skos:narrowMatch>OMIM:612293</skos:narrowMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_95626 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95626">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_178029"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A subtype of central diabetes insipidus (CDI) characterized by polyuria and polydipsia, due to an idiopathic or secondary decrease in vasopressin (AVP) production.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired CDI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acquired arginine vasopressin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired neurogenic diabetes insipidus</oboInOwl:hasExactSynonym>
        <rdfs:label>Acquired arginine vasopressin deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E23.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A61.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0019846</skos:exactMatch>

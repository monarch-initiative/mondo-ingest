        <obo:IAO_0000115 xml:lang="en">Burkitt lymphoma is a rare form of malignant mature B-cell non-Hodgkin lymphoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Burkitt lymphoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Small non-cleaved cell lymphoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Burkitt lymphoma</rdfs:label>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A variant of intermediate severity of the PBD-Zellweger syndrome spectrum (PBD-ZSS) characterized by hypotonia, leukodystrophy, and vision and sensorineural hearing deficiencies. Phenotypic overlap is seen between NALD and infantile Refsum disease (IRD).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Intermediate PBD-ZSD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intermediate peroxisome biogenesis disorder-Zellweger spectrum disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NALD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neonatal adrenoleukodystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Neonatal adrenoleukodystrophy</rdfs:label>

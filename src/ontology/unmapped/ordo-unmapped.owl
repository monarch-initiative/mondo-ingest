        <owl:annotatedTarget>dup(8)(p23.1p23.1)</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2511 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2511">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139039"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <obo:IAO_0000115 xml:lang="en">Microbrachycephaly-ptosis-cleft lip syndrome is characterised by the association of intellectual deficit, microbrachycephaly, hypotelorism, palpebral ptosis, a thin/long face, cleft lip, and anomalies of the lumbar vertebra, sacrum and pelvis. It has been described in two Brazilian sisters. Transmission appears to be autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microbrachycephaly-ptosis-cleft lip syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Richieri Costa-Guion Almeida-Ramos syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Microbrachycephaly-ptosis-cleft lip syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0010007</skos:exactMatch>
        <skos:exactMatch>OMIM:268850</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518461</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2511"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Microbrachycephaly-ptosis-cleft lip syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Familial isolated hypertrophic obstructive cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Familial isolated hypertrophic subaortic stenosis</oboInOwl:hasExactSynonym>

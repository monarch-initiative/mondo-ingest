        <oboInOwl:hasExactSynonym xml:lang="en">Polymerase proofreading-related adenomatous polyposis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polymerase proofreading-related polyposis</oboInOwl:hasExactSynonym>

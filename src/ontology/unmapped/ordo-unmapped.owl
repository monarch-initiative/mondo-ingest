    <!-- http://www.orpha.net/ORDO/Orphanet_140949 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_140949">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101433"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377793"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare urogenital condition characterized by a persistent unwanted painful erection that lasts more than 4 hours, caused by obstruction of the normal drainage of blood from the erectile tissues, leading to ischemia. It may be due to hematological diseases, metabolic or neurological disorders, and some erectile dysfunction medications. If the condition continues for several days, abnormal thickening and scarring of the erectile tissue may develop, causing permanent erectile dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Low-flow priapism</oboInOwl:hasExactSynonym>
        <rdfs:label>Low-flow priapism</rdfs:label>
        <skos:broadMatch>ICD-10:N48.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB06.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0004745</skos:exactMatch>
        <skos:exactMatch>MONDO:4745</skos:exactMatch>
        <skos:exactMatch>UMLS:C2711256</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_140949"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Low-flow priapism</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



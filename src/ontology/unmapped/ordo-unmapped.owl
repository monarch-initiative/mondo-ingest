    <!-- http://www.orpha.net/ORDO/Orphanet_319171 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319171">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_261965"/>

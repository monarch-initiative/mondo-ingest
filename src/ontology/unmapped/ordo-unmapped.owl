    <!-- http://www.orpha.net/ORDO/Orphanet_85138 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85138">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101963"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A chronic and rare endocrine disorder due to autoimmune destruction of the adrenal cortex and resulting in a glucocorticoid and mineralocorticoid deficiency. Properly speaking, it designates autoimmune adrenalitis, but it is a term commonly used to describe any form of chronic primary adrenal insufficiency (CPAI).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Addison disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autoimmune Addison disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autoimmune adrenalitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic Addison disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary Addison disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary adrenal insufficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Addison disease</rdfs:label>
        <skos:broadMatch>ICD-10:E27.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:5A74.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0100480</skos:exactMatch>
        <skos:exactMatch>MONDO:100480</skos:exactMatch>
        <skos:exactMatch>MeSH:D000224</skos:exactMatch>
        <skos:exactMatch>MedDRA:10001130</skos:exactMatch>
        <skos:exactMatch>OMIM:240200</skos:exactMatch>
        <skos:exactMatch>UMLS:C0001403</skos:exactMatch>
        <skos:narrowMatch>OMIM:103230</skos:narrowMatch>
    </owl:Class>

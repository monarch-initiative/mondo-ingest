    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_391417 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_391417">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79158"/>
        <obo:IAO_0000115 xml:lang="en">HSD10 disease is a rare, life-threatening neurometabolic disease characterized by a progressive neurodegenerative course, epilepsy, retinopathy and progressive cardiomyopathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">2-methyl-3-hydroxybutyric aciduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">2-methyl-3-hydroxybutyryl-CoA dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HSD10 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HSD10 disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MHBD deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>HSD10 disease</rdfs:label>
        <skos:broadMatch>ICD-10:E72.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C52.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0010327</skos:exactMatch>
        <skos:exactMatch>MeSH:C564560</skos:exactMatch>
        <skos:exactMatch>OMIM:300438</skos:exactMatch>
        <skos:exactMatch>UMLS:C3266731</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_391417"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>HSD10 disease</owl:annotatedTarget>

    <!-- http://www.orpha.net/ORDO/Orphanet_275872 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_275872">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276061"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306708"/>

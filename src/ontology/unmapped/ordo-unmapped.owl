    <!-- http://www.orpha.net/ORDO/Orphanet_2340 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2340">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498"/>

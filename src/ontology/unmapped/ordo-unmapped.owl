    <!-- http://www.orpha.net/ORDO/Orphanet_3342 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3342">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_285014"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2151 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2151">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519286"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522568"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, developmental defect during embryogenesis syndrome characterized by total or partial colonic aganglionosis associated with peripheral, usually multifocal, neuroblastic tumors (ganglioneuroblastoma, neuroblastoma, ganglioneuroma). Congenital central hypoventilation syndrome, with variable severity of respiratory compromise, cardiovascular and ophthalmologic symptoms, consistent with autonomic nervous system dysfunction, is occasionally associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hirschsprung disease-ganglioneuroblastoma syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hirschsprung disease-ganglioneuroblastoma syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q43.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0013082</skos:exactMatch>
        <skos:exactMatch>MeSH:C538119</skos:exactMatch>
        <skos:exactMatch>UMLS:C5191058</skos:exactMatch>
    </owl:Class>

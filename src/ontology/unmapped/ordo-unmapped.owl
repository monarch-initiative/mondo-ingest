                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, congenital, ocular defect caused by anterior segment dysgenesis and characterized by anteriorly displaced Schwalbe&apos;s line and iris bands extending into the cornea. In contrast, Rieger&apos;s anomaly includes characteristic iris and pupil anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Axenfeld anomaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Axenfeld anomaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q15.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA11.2</skos:broadMatch>
        <skos:broadMatch>OMIM:601631</skos:broadMatch>
        <skos:broadMatch>OMIM:602482</skos:broadMatch>
        <skos:exactMatch>MONDO:0020368</skos:exactMatch>
        <skos:exactMatch>MedDRA:10058653</skos:exactMatch>
        <skos:exactMatch>UMLS:C0266548</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98978"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Axenfeld anomaly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_98979 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98979">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_64734"/>
        <obo:IAO_0000115 xml:lang="en">A clinical variant of iridocorneal endothelial (ICE) syndrome, characterized by very few iris abnormalities but more severe corneal edema and less severe secondary glaucoma than seen in the other two ICE syndrome variants: Cogan-Reese syndrome and essential iris atrophy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Chandler syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Chandler syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:H21.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA11.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0020369</skos:exactMatch>
        <skos:exactMatch>MedDRA:10057487</skos:exactMatch>
        <skos:exactMatch>UMLS:C0544008</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98979"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Chandler syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_98980 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98980">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_64734"/>
        <obo:IAO_0000115 xml:lang="en">A clinical variant of iridocorneal endothelial (ICE) syndrome, characterized by variable iris atrophy, pigmented and pedunculated nodules on the iris and corneal abonormalities. Secondary glaucoma is also a common complication of the disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cogan-Reese syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cogan-Reese syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:H21.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA11.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0020370</skos:exactMatch>
        <skos:exactMatch>MedDRA:10059200</skos:exactMatch>
        <skos:exactMatch>UMLS:C1168173</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98980"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Cogan-Reese syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_98981 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98981">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_64734"/>
        <obo:IAO_0000115 xml:lang="en">A clinical variant of iridocorneal endothelial (ICE) syndrome, characterized by progressive iris atrophy and holes present on the surface of the iris, corneal edema, corectopia, uveal ectropion and anterior synechiae. Secondary glaucoma is also a common complication of the disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Essential iris atrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Essential iris atrophy</rdfs:label>
        <skos:broadMatch>ICD-10:H21.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:9A90.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0020371</skos:exactMatch>
        <skos:exactMatch>UMLS:C0271111</skos:exactMatch>
    </owl:Class>

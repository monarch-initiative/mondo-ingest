    <!-- http://www.orpha.net/ORDO/Orphanet_50942 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_50942">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_307846"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

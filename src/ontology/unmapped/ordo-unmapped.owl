        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_75374 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_75374">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716367"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30304"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic retinal disorder characterized by childhood-onset of markedly delayed visual adaptation to both dark and light conditions, marked difficulties tracking moving objects, and mild photophobia. Visual acuity is variably reduced, while color vision is unaffected.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bradyopsia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PERRS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Prolonged electroretinal response suppression</oboInOwl:hasExactSynonym>
        <rdfs:label>Bradyopsia</rdfs:label>
        <skos:broadMatch>ICD-10:H53.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9D7Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012033</skos:exactMatch>
        <skos:exactMatch>MeSH:C564243</skos:exactMatch>
        <skos:exactMatch>UMLS:C1842073</skos:exactMatch>
        <skos:narrowMatch>OMIM:608415</skos:narrowMatch>
        <skos:narrowMatch>OMIM:620344</skos:narrowMatch>
    </owl:Class>

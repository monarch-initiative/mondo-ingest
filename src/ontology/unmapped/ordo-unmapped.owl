        <owl:annotatedTarget>Isolated hereditary congenital facial paralysis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_306530 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_306530">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156224"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98518"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5111"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital hereditary facial paralysis-variable hearing loss syndrome is an extremely rare autosomal recessive disorder characterized by bilateral facial palsy with masked facies, sensorineural hearing loss, dysmorphic features (midfacial retrusion, low-set ears), and strabismus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital hereditary facial palsy with variable deafness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital hereditary facial palsy with variable hearing loss</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital hereditary facial paralysis with variable deafness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital hereditary facial paralysis-variable deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital hereditary facial paralysis-variable hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital hereditary facial paralysis-variable hearing loss syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0017627</skos:exactMatch>
        <skos:exactMatch>UMLS:C4302592</skos:exactMatch>
        <skos:narrowMatch>OMIM:604185</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614744</skos:narrowMatch>
    </owl:Class>

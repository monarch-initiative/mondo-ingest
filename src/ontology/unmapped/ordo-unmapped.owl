        <oboInOwl:hasExactSynonym>X-linked hereditary sensory and autonomic neuropathy with deafness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked hereditary sensory and autonomic neuropathy with hearing loss</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked hereditary sensory and autonomic neuropathy with deafness</rdfs:label>
        <skos:broadMatch>ICD-10:G60.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C21.Y</skos:broadMatch>

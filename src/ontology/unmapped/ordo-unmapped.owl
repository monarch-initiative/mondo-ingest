        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_715334"/>
        <obo:IAO_0000115 xml:lang="en">A rare vascular malformation characterized by fibro-adipose and venous tissue with diffuse muscle infiltration and extension along fascial planes, most often affecting the calf and forearm. Major clinical features include severe and persistent pain, phlebectasia, contractures, joint deformity as well as muscle atrophy. The skin is usually unremarkable.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FAVA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fibro-adipose vascular anomaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fibro-fatty vascular anomaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fibroadipose vascular anomaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Fibro-adipose vascular anomaly</rdfs:label>
    </owl:Class>

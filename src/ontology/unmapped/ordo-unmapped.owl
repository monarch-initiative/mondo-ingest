        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Colonic atresia is a congenital intestinal malformation resulting in a non-latent segment of the colon and characterized by lower intestinal obstruction manifesting with abdominal distention and failure to pass meconium in newborns.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Colonic atresia</oboInOwl:hasExactSynonym>
        <rdfs:label>Colonic atresia</rdfs:label>
        <skos:broadMatch>ICD-10:Q42.9</skos:broadMatch>

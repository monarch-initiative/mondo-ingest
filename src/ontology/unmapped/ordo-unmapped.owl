    <!-- http://www.orpha.net/ORDO/Orphanet_330032 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_330032">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_231230"/>

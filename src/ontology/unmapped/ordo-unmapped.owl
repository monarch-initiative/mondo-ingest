    <!-- http://www.orpha.net/ORDO/Orphanet_69087 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_69087">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>

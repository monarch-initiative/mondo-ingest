    <!-- http://www.orpha.net/ORDO/Orphanet_365 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_365">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217572"/>

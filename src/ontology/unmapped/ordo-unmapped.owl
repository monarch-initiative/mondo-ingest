        <owl:annotatedTarget>Leukoencephalopathy with mild cerebellar ataxia and white matter edema</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_363543 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363543">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C044"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive limb-girdle muscular dystrophy due to desmin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD2R</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive limb-girdle muscular dystrophy type 2R</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

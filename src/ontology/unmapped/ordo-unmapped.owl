    <!-- http://www.orpha.net/ORDO/Orphanet_216694 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_216694">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_216675"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare cardiac malformation characterized by the combination of discordant atrioventricular (AV) and ventriculo-arterial (VA) connections so that the morphologically right atrium connects to the morphologically left ventricle, the morphologically left atrium connects to the morphologically right ventricle, the morphologically right ventricle connects to the aorta, and the morphologically left ventricle connects to the pulmonary trunk. It is usually accompanied by other cardiovascular malformations which determine the clinical picture.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenitally corrected transposition of the great arteries</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenitally corrected transposition of the great vessels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Discordant ventriculoarterial and atrioventricular connections</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Double discordance</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenitally corrected transposition of the great arteries</rdfs:label>
        <skos:exactMatch>ICD-10:Q20.5</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA85.00</skos:exactMatch>
        <skos:exactMatch>MONDO:0016301</skos:exactMatch>
        <skos:exactMatch>MeSH:D000080041</skos:exactMatch>
        <skos:exactMatch>MedDRA:10011120</skos:exactMatch>
        <skos:exactMatch>UMLS:C0344616</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_216694"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenitally corrected transposition of the great arteries</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2167 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2167">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139039"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Holzgreve syndrome is an extremely rare, lethal, multiple congenital anomalies/dysmorphic syndrome characterized by renal agenesis with Potter sequence, cleft lip/palate, oral synechiae, cardiac defects, and skeletal abnormalities including postaxial polydactyly. Intestinal nonfixation and intrauterine growth restriction are also associated. There have been no further descriptions in the literature since 1988.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cleft palate-Potter sequence-congenital heart anomalies-mesoaxial polydactyly-multiple malformations syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Holzgreve syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Holzgreve-Wagner-Rehder syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Holzgreve syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009350</skos:exactMatch>
        <skos:exactMatch>MeSH:C535327</skos:exactMatch>
        <skos:exactMatch>OMIM:236110</skos:exactMatch>
        <skos:exactMatch>UMLS:C1856095</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2167"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Holzgreve syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



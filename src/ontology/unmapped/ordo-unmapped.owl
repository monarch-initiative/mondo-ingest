        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Pentosuria is an inborn error of metabolism which is characterized by the excretion of 1 to 4 g of the pentose L-xylulose in the urine per day.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Essential pentosuria</oboInOwl:hasExactSynonym>

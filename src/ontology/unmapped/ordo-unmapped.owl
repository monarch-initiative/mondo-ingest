            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Maternally inherited Leigh syndrome is a rare subtype of Leigh syndrome characterized clinically by encephalopathy, lactic acidosis, seizures, cardiomyopathy, respiratory disorders and developmental delay, with onset in infancy or early childhood, and resulting from maternally-inherited mutations in mitochondrial DNA.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MILS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maternally-inherited Leigh disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maternally-inherited infantile subacute necrotizing encephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mitochondrial DNA-associated Leigh syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">mtDNA-associated Leigh syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Mitochondrial DNA-associated Leigh syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G31.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C73.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016814</skos:exactMatch>
        <skos:exactMatch>MeSH:C536035</skos:exactMatch>
        <skos:exactMatch>OMIM:500017</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931092</skos:exactMatch>
    </owl:Class>

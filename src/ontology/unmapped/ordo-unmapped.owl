    <!-- http://www.orpha.net/ORDO/Orphanet_1837 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1837">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93430"/>
        <obo:IAO_0000115 xml:lang="en">Ulna metaphyseal dysplasia syndrome is a rare primary bone dysplasia characterized by dysplasia of the distal ulnar metaphyses, as well as metacarpal/metatarsal dysplasia and metaphyseal changes resembling enchondromata. Patients usually present bony swelling of the wrists with or without pain (knees and ankles may also be affected). Other variably associated features include platyspondyly, skeletal development delay, short stature and coxa valga.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Metaphyseal chondrodysplasia, Rosenberg type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rosenberg-Lohr syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Metaphyseal chondrodysplasia, Rosenberg type</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.7</skos:broadMatch>
        <skos:exactMatch>MONDO:0008619</skos:exactMatch>
        <skos:exactMatch>MeSH:C536935</skos:exactMatch>
        <skos:exactMatch>OMIM:191420</skos:exactMatch>
        <skos:exactMatch>UMLS:C1860615</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1837"/>

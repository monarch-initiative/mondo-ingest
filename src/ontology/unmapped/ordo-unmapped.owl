        <owl:annotatedTarget>Global developmental delay-alopecia-macrocephaly-facial dysmorphism-structural brain anomalies syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98642"/>
        <obo:IAO_0000115 xml:lang="en">A partial deletion of the long arm of chromosome 18 characterized by highly variable phenotype, most commonly including hypotonia, developmental delay, short stature, growth hormone deficiency, hearing loss and external ear anomalies, intellectual disability, palatal defects, dysmorphic facial features, skeletal anomalies (foot deformities, tapering fingers, scoliosis) and mood disorders.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">18q deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">18q- syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">De Grouchy syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Deletion 18q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Monosomy 18q syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Monosomy 18q syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0011147</skos:exactMatch>
        <skos:exactMatch>MeSH:C536580</skos:exactMatch>

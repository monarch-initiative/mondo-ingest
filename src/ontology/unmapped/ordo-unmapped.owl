    <!-- http://www.orpha.net/ORDO/Orphanet_2287 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2287">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_164001"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>

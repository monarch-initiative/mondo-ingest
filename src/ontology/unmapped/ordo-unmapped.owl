    <!-- http://www.orpha.net/ORDO/Orphanet_308425 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_308425">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_293355"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

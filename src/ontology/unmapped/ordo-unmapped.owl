        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Pyomyositis (PM) is a rare primary bacterial infection of the skeletal muscle, usually resulting from hematogenous spread or due to muscle injury, and characterized by pain and tenderness in the affected muscle, fever and abscess formation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Myositis purulenta tropica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myositis tropicans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pyomyositis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Suppurative myositis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tropical pyomyositis</oboInOwl:hasExactSynonym>
        <rdfs:label>Pyomyositis</rdfs:label>
        <skos:broadMatch>ICD-10:M60.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB30</skos:broadMatch>
        <skos:exactMatch>MONDO:0019168</skos:exactMatch>
        <skos:exactMatch>MeSH:D052880</skos:exactMatch>

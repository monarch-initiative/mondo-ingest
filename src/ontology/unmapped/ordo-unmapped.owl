    <!-- http://www.orpha.net/ORDO/Orphanet_79328 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79328">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309347"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371071"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371157"/>

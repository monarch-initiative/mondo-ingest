    <!-- http://www.orpha.net/ORDO/Orphanet_95430 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95430">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108993"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156252"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182111"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_435612"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Congenital tracheomalacia is a rare condition where the trachea is soft and flexible causing the tracheal wall to collapse when exhaling, coughing or crying, that usually presents in infancy, and that is characterized by stridor and noisy breathing or upper respiratory infections. Tracheomalacia improves by the age of 18-24 months.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital major airway collapse</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital tracheomalacia</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital tracheomalacia</rdfs:label>
        <skos:exactMatch>ICD-10:Q32.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA73.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0019804</skos:exactMatch>
        <skos:exactMatch>MONDO:19804</skos:exactMatch>
        <skos:exactMatch>MeSH:C557675</skos:exactMatch>
        <skos:exactMatch>MedDRA:10010654</skos:exactMatch>
        <skos:exactMatch>UMLS:C0392109</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_95430"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_293958 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_293958">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis syndrome characterized by hypertelorism, bilateral preauricular sinus, bilateral punctal pits, lacrimal duct obstruction, hearing loss, abnormal palmar flexion creases and bilateral distal axial triradii. Shawl scrotum has also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HPPD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypertelorism-preauricular sinus-punctual pits-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypertelorism-preauricular sinus-punctual pits-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypertelorism-preauricular sinus-punctual pits-deafness syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0013614</skos:exactMatch>
        <skos:exactMatch>OMIM:614187</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751125</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_293958"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hypertelorism-preauricular sinus-punctual pits-deafness syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">RAS-associated autoimmune leukoproliferative disease (RALD) is a rare genetic disorder characterized by monocytosis, autoimmune cytopenias, lymphoproliferation, hepatosplenomegaly, and hypergammaglobulinemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">RALD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RAS-associated autoimmune leukoproliferative disease</oboInOwl:hasExactSynonym>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_448 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_448">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68334"/>
        <obo:IAO_0000115 xml:lang="en">A rare hematological disorder characterized by spontaneous hemorrhage or prolonged bleeding due to factor VIII or IX deficiency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hemophilia</oboInOwl:hasExactSynonym>
        <rdfs:label>Hemophilia</rdfs:label>
        <skos:exactMatch>MONDO:0018660</skos:exactMatch>
        <skos:exactMatch>MONDO:18660</skos:exactMatch>
        <skos:exactMatch>MedDRA:10061992</skos:exactMatch>
        <skos:exactMatch>UMLS:C0684275</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_448"/>

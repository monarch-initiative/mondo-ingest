    <!-- http://www.orpha.net/ORDO/Orphanet_95512 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95512">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95506"/>
        <obo:IAO_0000115 xml:lang="en">A rare, acquired pituitary hormone deficiency, a type of primary hypophysitis characterized by an inflammation of anterior pituitary. Clinical presentation is variable and includes headaches, visual disturbances, symptoms of adrenal insufficiency, hyperprolactinemia, hypothyroidism and hypogonadism. It most commonly affects young women during pregnancy or postpartum period.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Adenohypophysitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Anterior pituitary hypophysitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Adenohypophysitis</rdfs:label>
        <skos:broadMatch>ICD-10:E23.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A61.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0019838</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190880</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_95512"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Adenohypophysitis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_95513 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95513">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95506"/>
        <obo:IAO_0000115 xml:lang="en">A type of primary hypophysitis characterized by an inflammation of the entire pituitary gland. Common clinical presentation is diabetes insipidus with polyuria and polydipsia and partial or panhypopituitarism. Other symptoms may include headaches, nausea/vomiting, visual disturbances and fatigue.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Infundibulo-panhypophysitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Panhypophysitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Panhypophysitis</rdfs:label>
        <skos:broadMatch>ICD-10:E23.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A61.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0019839</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190786</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_95513"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Panhypophysitis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



    <!-- http://www.orpha.net/ORDO/Orphanet_481662 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_481662">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163531"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183478"/>

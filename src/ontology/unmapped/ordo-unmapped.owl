    <!-- http://www.orpha.net/ORDO/Orphanet_65684 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_65684">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98506"/>
        <obo:IAO_0000115 xml:lang="en">Monomelic amyotrophy (MA) is a rare benign lower motor neuron disorder characterized by muscular weakness and wasting in the distal upper extremities during adolescence followed by a spontaneous halt in progression and a stabilization of symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign focal amyotrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hirayama disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">JMADUE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile muscular atrophy of distal upper extremity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile muscular atrophy of the distal upper limb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Monomelic amyotrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Monomelic amyotrophy</rdfs:label>
        <skos:broadMatch>ICD-10:G12.8</skos:broadMatch>

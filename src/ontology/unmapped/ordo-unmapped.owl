            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Pyogenic arthritis-pyoderma gangrenosum-acne syndrome is a rare pleiotropic autoinflammatory disorder of childhood, primarily affecting the joints and skin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FRA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial recurrent arthritis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>PAPA syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pyogenic arthritis-pyoderma gangrenosum-acne syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>PAPA syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D89.8</skos:broadMatch>

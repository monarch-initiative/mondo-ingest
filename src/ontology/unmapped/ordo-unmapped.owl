    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_90026 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90026">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140474"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10597"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Primary erythermalgia is characterized by intermittent attacks of red, warm, painful burning extremities. It spontaneously arises during early childhood and adolescence in the absence of any detectable underlying disorder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary erythermalgia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary erythromelalgia</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary erythromelalgia</rdfs:label>
        <skos:broadMatch>ICD-10:I73.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EG00</skos:broadMatch>
        <skos:exactMatch>MONDO:0007571</skos:exactMatch>
        <skos:exactMatch>MeSH:D004916</skos:exactMatch>
        <skos:exactMatch>OMIM:133020</skos:exactMatch>
        <skos:exactMatch>UMLS:C0014805</skos:exactMatch>
    </owl:Class>

        <owl:annotatedTarget>Cramp-fasciculation syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_582 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_582">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93448"/>
        <obo:IAO_0000115 xml:lang="en">A rare lysosomal storage disease characterized by mild to severe spondylo-epiphyso-metaphyseal dysplasia, manifesting with disproportionate short stature (short neck and trunk), joint laxity, pectus carinatum, genum valgum, abnormal gait, tracheal narrowing, spinal abnormalities (kyphosis and scoliosis), respiratory impairment and valvular heart disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MPS4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MPSIV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Morquio disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mucopolysaccharidosis type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucopolysaccharidosis type IV</oboInOwl:hasExactSynonym>
        <rdfs:label>Mucopolysaccharidosis type 4</rdfs:label>
        <skos:broadMatch>ICD-10:E76.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C56.32</skos:exactMatch>
        <skos:exactMatch>MONDO:0018938</skos:exactMatch>

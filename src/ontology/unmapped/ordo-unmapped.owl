            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Early-onset X-linked optic atrophy is a rare form of hereditary optic atrophy, seen in only 4 families to date, with an onset in early childhood, characterized by progressive loss of visual acuity, significant optic nerve pallor and occasionally additional neurological manifestations, with females being unaffected.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Early-onset X-linked optic atrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-Leber type optic atrophy with early-onset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OPA2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Optic atrophy type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Early-onset X-linked optic atrophy</rdfs:label>
        <skos:broadMatch>ICD-10:H47.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0010698</skos:exactMatch>
        <skos:exactMatch>OMIM:311050</skos:exactMatch>
        <skos:exactMatch>UMLS:C1839576</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

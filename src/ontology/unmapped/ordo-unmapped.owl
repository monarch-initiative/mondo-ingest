    <!-- http://www.orpha.net/ORDO/Orphanet_412181 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_412181">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

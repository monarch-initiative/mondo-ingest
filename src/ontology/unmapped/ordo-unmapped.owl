    <!-- http://www.orpha.net/ORDO/Orphanet_397685 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_397685">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183628"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399572"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399831"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399983"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_400011"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_715120"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9446"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial hyperprolactinemia is a rare, genetic endocrine disorder characterized by persistently high prolactin serum levels (not associated with gestation, puerperium, drug intake or pituitary tumor) in multiple members of a family. Clinically it manifests with signs usually observed in hyperprolactinemia, which are: secondary medroxyprogesterone acetate (MPA)-negative amenorrhea and galactorrhea in female patients, and hypogonadism and decreased testosterone level-driven sexual dysfunction in male patients. Oligomenorrhea and primary infertility have also been reported in some female patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial hyperprolactinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial isolated prolactin receptor deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial hyperprolactinemia</rdfs:label>
        <skos:broadMatch>ICD-10:E22.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A60.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0014250</skos:exactMatch>
        <skos:exactMatch>OMIM:615555</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706551</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

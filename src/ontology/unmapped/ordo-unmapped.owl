            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by moderate to severe prenatal and postnatal growth retardation, microcephaly, a distinctive facial appearance, profound psychomotor delay, hip and knee contractures and rockerbottom feet.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bowen syndrome, Hutterite type</oboInOwl:hasExactSynonym>

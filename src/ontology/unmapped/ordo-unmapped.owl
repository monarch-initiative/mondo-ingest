    <!-- http://www.orpha.net/ORDO/Orphanet_641380 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_641380">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_652510"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_653434"/>
        <obo:IAO_0000115 xml:lang="en">A rare autoinflammatory syndrome characterized by a chronic-relapsing course of the combination of pyogenic arthritis, pyoderma gangrenosum, acne, and hidradenitis suppurativa (which, in addition to axillae and inguinal folds, can be observed on the face, neck, scalp, back, and buttocks, among others). Typical age of onset is adolescence to young adulthood, with the different signs and symptoms appearing simultaneously or subsequently.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PAPASH syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pyogenic arthritis-pyoderma gangrenosum-acne-hidradenitis suppurativa syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>PAPASH syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:L88</skos:broadMatch>
        <skos:broadMatch>ICD-11:EB21</skos:broadMatch>
        <skos:exactMatch>MONDO:0958343</skos:exactMatch>
        <skos:exactMatch>MONDO:958343</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816787</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_641380"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>PAPASH syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_641385 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_641385">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_653434"/>
        <obo:IAO_0000115 xml:lang="en">A rare autoinflammatory syndrome characterized by a chronic-relapsing course of the combination of pyoderma gangrenosum, acne, hidradenitis suppurativa (which, in addition to axillae and inguinal folds, can be observed on upper and lower limbs, back, and buttocks, among others), and ankylosing spondylitis. Typical age of onset is adolescence to young adulthood, with the different signs and symptoms appearing simultaneously or subsequently.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PASS syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pyoderma gangrenosum-acne-hidradenitis suppurativa-ankylosing spondylitis syndrome</oboInOwl:hasExactSynonym>

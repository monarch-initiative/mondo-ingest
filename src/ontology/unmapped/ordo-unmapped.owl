    <!-- http://www.orpha.net/ORDO/Orphanet_99792 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99792">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

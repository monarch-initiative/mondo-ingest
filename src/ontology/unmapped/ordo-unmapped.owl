        <obo:IAO_0000115 xml:lang="en">A rare drug-induced, immune-mediated prothrombotic disorder associated with thrombocytopenia and venous and/or arterial thrombosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic HAT</oboInOwl:hasExactSynonym>

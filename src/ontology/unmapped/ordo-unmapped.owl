    <!-- http://www.orpha.net/ORDO/Orphanet_401935 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_401935">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262110"/>

        <obo:IAO_0000115 xml:lang="en">14q11.2 microdeletion syndrome is a recently described syndrome characterized by developmental delay, hypotonia and facial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>14q11.2 microdeletion syndrome</oboInOwl:hasExactSynonym>

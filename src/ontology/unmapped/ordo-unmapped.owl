        <obo:IAO_0000115 xml:lang="en">Distal 7q11.23 microduplication syndrome is a rare chromosomal anomaly characterized by a predominantly neuropsychiatric phenotype with a few dysmorphic characteristics. Speech delay, learning difficulties, attention deficit hyperactivity disorder, bipolar disorder and aggressiveness have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal 7q11.23 microduplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal dup(7)(q11.23)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal trisomy 7q11.23</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dup7q11.23D</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>distal dup(7)(q11.23)</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal 7q11.23 microduplication syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD41.60</skos:broadMatch>
        <skos:exactMatch>MONDO:0016832</skos:exactMatch>
        <skos:exactMatch>UMLS:C4750782</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_208650 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_208650">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290839"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290842"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_324924"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_622720"/>
        <obo:IAO_0000115 xml:lang="en">Cryopyrin associated periodic syndrome (CAPS) defines a group of autoinflammatory diseases, characterized by recurrent episodes of systemic inflammatory attacks in the absence of infection or autoimmune disease. CAPS comprises 3 disorders on a continuum of severity: severe CINCA syndrome, intermediate Muckle-Wells syndrome (MWS) and milder familial cold urticaria (FCAS).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CAPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cryopyrin associated periodic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cryopyrinopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NLRP3-associated AID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>NLRP3-associated autoinflammatory disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NLRP3-associated autoinflammatory syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>NLRP3-associated autoinflammatory disease</rdfs:label>
        <skos:exactMatch>ICD-11:4A60.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0016168</skos:exactMatch>
        <skos:exactMatch>MONDO:16168</skos:exactMatch>
        <skos:exactMatch>MeSH:D056587</skos:exactMatch>
        <skos:exactMatch>MedDRA:10068850</skos:exactMatch>
        <skos:exactMatch>UMLS:C2316212</skos:exactMatch>
    </owl:Class>

        <owl:annotatedTarget>Congenital sodium diarrhea</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_103909 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_103909">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104006"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309001"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12266"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, intestinal disease characterized by osmotic diarrhea, abdominal pain and increased rectal flatulence after ingestion of trehalose, a disaccharide found mainly in mushrooms, due to intestinal trehalase deficiency. It occurs primarily in the Greenland population, although cases have also been reported elsewhere.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated trehalose intolerance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Trehalase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Trehalase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C61.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0012803</skos:exactMatch>
        <skos:exactMatch>MONDO:12803</skos:exactMatch>
        <skos:exactMatch>MeSH:C562603</skos:exactMatch>
        <skos:exactMatch>OMIM:612119</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268187</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_103909"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/145"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Megacystis microcolon intestinal hypoperistalsis syndrome (MMIHS) is a rare congenital disease characterized by massive abdominal distension caused by a largely dilated non-obstructed urinary bladder (megacystis), microcolon and decreased or absent intestinal peristalsis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Berdon syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MMIHS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Megacystis-microcolon-intestinal hypoperistalsis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Megacystis-microcolon-intestinal hypoperistalsis-hydronephrosis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Megacystis-microcolon-intestinal hypoperistalsis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q43.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>

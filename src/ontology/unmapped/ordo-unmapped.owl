    <!-- http://www.orpha.net/ORDO/Orphanet_280403 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280403">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108979"/>

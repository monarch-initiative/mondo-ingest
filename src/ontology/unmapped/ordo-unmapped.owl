    <!-- http://www.orpha.net/ORDO/Orphanet_261222 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_261222">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_240371"/>

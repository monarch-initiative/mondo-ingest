    <!-- http://www.orpha.net/ORDO/Orphanet_88618 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_88618">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79173"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/343"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, multisystemic inherited metabolic disease characterized clinically, by a variable spectrum of severity, primarily comprised of psychomotor delay, myopathy and liver dysfunction. Most patients present in infancy, but the onset can be already &lt;i&gt;in utero&lt;/i&gt; or in adult age. Hypermethioninemia is frequent, but often absent in infancy. Creatine kinase is elevated in most patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>S-adenosylhomocysteine hydrolase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>S-adenosylhomocysteine hydrolase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.B</skos:broadMatch>
        <skos:exactMatch>MONDO:0013404</skos:exactMatch>
        <skos:exactMatch>OMIM:613752</skos:exactMatch>
        <skos:exactMatch>UMLS:C3151058</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_88618"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>S-adenosylhomocysteine hydrolase deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_88619 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_88619">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9848"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial acute necrotizing encephalopathy or ADANE is a potentially fatal neurological disease characterised by neuropathological lesions principally involving the brainstem, thalamus and putamen.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ADANE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial acute necrotizing encephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Recurrent acute necrotizing encephalopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial acute necrotizing encephalopathy</rdfs:label>
        <skos:broadMatch>ICD-10:G93.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0011953</skos:exactMatch>
        <skos:exactMatch>OMIM:608033</skos:exactMatch>
        <skos:exactMatch>UMLS:C4509836</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_88619"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial acute necrotizing encephalopathy</owl:annotatedTarget>

        <oboInOwl:hasExactSynonym xml:lang="en">Chondrodystrophia calcificans congenita</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Conradi-Hünermann-Happle syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked chondrodysplasia punctata type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked dominant chondrodysplasia punctata</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked dominant chondrodysplasia punctata</rdfs:label>

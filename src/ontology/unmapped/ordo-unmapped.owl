                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3354"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare glycolysis disorder characterized clinically by exercise intolerance and myalgia due to severe enolase deficiency in muscle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD due to muscle beta-enolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSDXIII</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glycogen storage disease due to muscle beta-enolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis due to muscle beta-enolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis type 13</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Muscle enolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Muscular enolase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Glycogen storage disease due to muscle beta-enolase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.3</skos:broadMatch>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Juvenile glycerol kinase deficiency (GKD) is an uncommon form of GKD characterized by Reye-like clinical manifestations including episodic vomiting, acidemia, and disorders of consciousness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Glycerol kinase deficiency, juvenile form</oboInOwl:hasExactSynonym>

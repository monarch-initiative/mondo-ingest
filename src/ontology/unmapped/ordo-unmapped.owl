    <!-- http://www.orpha.net/ORDO/Orphanet_101028 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_101028">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

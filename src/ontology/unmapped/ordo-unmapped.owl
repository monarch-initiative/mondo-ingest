    <!-- http://www.orpha.net/ORDO/Orphanet_261183 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_261183">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262119"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">15q11.2 microdeletion syndrome is a rare partial autosomal monosomy with a variable phenotypic expression and reduced penetrance associated with an increased susceptibility to neuropsychiatric or neurodevelopmental disorders including delayed psychomotor development, speech delay, autism spectrum disorder, attention deficit-hyperactivity disorder, obsessive-compulsive disorder, epilepsy or seizures. It may also include mild non-specific dysmorphic features (such as dysplastic ears, broad forehead, hypertelorism), cleft palate, neurological and neuroimaging abnormalities (such as ataxia and muscular hypotonia).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">15q11.2 BP1-BP2 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>15q11.2 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(15)(q11.2)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 15q11.2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(15)(q11.2)</oboInOwl:hasExactSynonym>
        <rdfs:label>15q11.2 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.F</skos:broadMatch>
        <skos:exactMatch>MONDO:0014294</skos:exactMatch>
        <skos:exactMatch>OMIM:615656</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749854</skos:exactMatch>
    </owl:Class>

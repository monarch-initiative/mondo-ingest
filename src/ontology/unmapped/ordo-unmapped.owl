    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_85274 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85274">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare, X-linked syndromic intellectual disability disorder characterized by mild to moderate intellectual disability, obesity, hypogonadism, tapering fingers and microphallus with small or undescended testes, localized to Xp11.3-Xq23. Additional variable manifestations include alopecia, dental and eyesight anomalies, speech disabilities, and decreased body strength.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ahmad syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intellectual developmental disorder, X-linked, syndromic 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MRXS7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked intellectual disability, Ahmad type</oboInOwl:hasExactSynonym>
        <rdfs:label>Ahmad syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90</skos:broadMatch>
        <skos:exactMatch>MONDO:0010270</skos:exactMatch>
        <skos:exactMatch>MeSH:C537449</skos:exactMatch>
        <skos:exactMatch>OMIM:300218</skos:exactMatch>
        <skos:exactMatch>UMLS:C1846170</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_85274"/>

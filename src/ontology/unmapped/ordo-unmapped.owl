        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 2j</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type IIj</oboInOwl:hasExactSynonym>
        <rdfs:label>COG4-CDG</rdfs:label>

        <skos:narrowMatch>ICD-10:B38.8</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B38.9</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1F25.0</skos:narrowMatch>

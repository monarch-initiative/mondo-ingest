        <obo:IAO_0000115 xml:lang="en">A very rare syndrome characterized by the association of gingival fibromatosis and craniofacial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Gingival fibromatosis-facial dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Gingival fibromatosis-facial dysmorphism syndrome</rdfs:label>

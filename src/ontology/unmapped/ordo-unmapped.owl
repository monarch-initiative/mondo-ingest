    <!-- http://www.orpha.net/ORDO/Orphanet_53583 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_53583">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_200037"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, paroxysmal dystonia disorder characterized by childhood to adolescent-onset of episodic paroxysmal choreoathetosis, triggered mainly by sudden movements, prolonged exercise, anxiety and emotional stress, in association with progressive spastic paraparesis (onest in adulthood), gait ataxia, mild to moderate cognitive impairment, and/or epileptic seizures. Episodes typically last from a few minutes to hours, have a variable frequency (daily to yearly), and are relieved by rest. Frequency of episodes tends to decrease with age.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DYT9</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Episodic choreoathetosis/spasticity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Paroxysmal dystonic choreathetosis with episodic ataxia and spasticity</oboInOwl:hasExactSynonym>
        <rdfs:label>Paroxysmal dystonic choreathetosis with episodic ataxia and spasticity</rdfs:label>
        <skos:broadMatch>ICD-10:G24.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A02.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0010983</skos:exactMatch>
        <skos:exactMatch>MeSH:C563401</skos:exactMatch>
        <skos:exactMatch>OMIM:601042</skos:exactMatch>
        <skos:exactMatch>UMLS:C1832855</skos:exactMatch>
    </owl:Class>

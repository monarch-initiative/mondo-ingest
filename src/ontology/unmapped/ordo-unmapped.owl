        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Severe Canavan disease (CD) is a rapidly progressing neurodegenerative disorder characterized by leukodystrophy with macrocephaly, severe developmental delay and hypotonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Infantile Canavan disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal Canavan disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Severe Canavan disease</oboInOwl:hasExactSynonym>

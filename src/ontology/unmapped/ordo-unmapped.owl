            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of holoprosencephaly characterized by fusion of the left and right frontal and parietal lobes with only a posterior interhemispheric fissure. Craniofacial features variably include ocular hypotelorism, midline cleft lip (complete or partial) and a flat nose.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Semilobar holoprosencephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Semilobar holoprosencephaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA05.2</skos:broadMatch>
        <skos:broadMatch>OMIM:157170</skos:broadMatch>
        <skos:broadMatch>OMIM:301043</skos:broadMatch>
        <skos:broadMatch>OMIM:609637</skos:broadMatch>
        <skos:broadMatch>OMIM:610829</skos:broadMatch>
        <skos:exactMatch>UMLS:C0751617</skos:exactMatch>
    </owl:Class>

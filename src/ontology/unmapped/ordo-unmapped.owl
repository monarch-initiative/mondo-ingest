        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">An extremely rare genetic syndrome characterized by the association of microcephaly, intellectual deficit and achalasia (with symptoms of coughing, dysphagia, vomiting, failure to thrive and aspiration appearing in infancy/early-childhood). Antenatal exposure to Mefloquine was reported in one simplex case.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Achalasia-microcephaly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Achalasia-microcephaly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q39.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0008699</skos:exactMatch>
        <skos:exactMatch>MeSH:C536010</skos:exactMatch>
        <skos:exactMatch>OMIM:200450</skos:exactMatch>
        <skos:exactMatch>UMLS:C1860212</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_929"/>

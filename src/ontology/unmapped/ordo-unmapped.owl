        <skos:narrowMatch>OMIM:613115</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614213</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_970"/>

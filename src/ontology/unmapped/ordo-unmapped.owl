    <!-- http://www.orpha.net/ORDO/Orphanet_26793 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_26793">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206953"/>

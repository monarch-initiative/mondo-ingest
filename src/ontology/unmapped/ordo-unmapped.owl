                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7610"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare ophthalmic disorder characterized by an elevated intra-ocular pressure. The clinical presentation frequently associates an increase in the size of the eye, as well as corneal edema.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Buphthalmia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Buphthalmos</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Buphthalmus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital glaucoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary congenital glaucoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital glaucoma</rdfs:label>
        <skos:exactMatch>ICD-10:Q15.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:9C61.40</skos:exactMatch>
        <skos:exactMatch>OMIM:231300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0020302</skos:exactMatch>
        <skos:narrowMatch>OMIM:600975</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613085</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613086</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617272</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98976"/>

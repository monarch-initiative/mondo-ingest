    <!-- http://www.orpha.net/ORDO/Orphanet_79099 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79099">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182231"/>

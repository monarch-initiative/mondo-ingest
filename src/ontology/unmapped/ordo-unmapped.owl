    <!-- http://www.orpha.net/ORDO/Orphanet_85198 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85198">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8620"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic ocular disease characterized by congenital nystagmus (horizontal, vertical and/or torsional), foveal hypoplasia, presenile cataracts (with typical onset in the second to third decade of life), and normal irides. Corneal pannus and/or optic nerve hypoplasia may also be present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Foveal hypoplasia-presenile cataract syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">O&apos;Donnell-Pappas syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Foveal hypoplasia-presenile cataract syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:H26.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:9C2Y</skos:broadMatch>
        <skos:broadMatch>OMIM:136520</skos:broadMatch>
        <skos:exactMatch>MONDO:0016395</skos:exactMatch>
        <skos:exactMatch>MeSH:C537858</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931644</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2253"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

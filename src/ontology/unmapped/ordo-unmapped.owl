    <!-- http://www.orpha.net/ORDO/Orphanet_79474 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79474">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139033"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_300766"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363245"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6636"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A heterogeneous group of cases that are clinically diagnosed as Werner syndrome (WS) but do not carry &lt;i&gt;WRN&lt;/i&gt; gene mutations. Similar to classical WS caused by &lt;i&gt;WRN&lt;/i&gt; mutations, patients generally exhibit an aged appearance and common age-related disorders at earlier ages compared to the general population.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Atypical Werner syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Atypical progeroid syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Atypical Werner syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E34.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2B</skos:broadMatch>
        <skos:exactMatch>MONDO:0019321</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275075</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

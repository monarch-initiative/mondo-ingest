        <skos:exactMatch>MeSH:C562441</skos:exactMatch>
        <skos:exactMatch>MedDRA:10028210</skos:exactMatch>
        <skos:exactMatch>UMLS:C0220744</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2300"/>

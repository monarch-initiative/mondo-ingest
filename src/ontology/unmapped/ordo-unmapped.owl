            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This syndrome is characterized by the association of sensorineural hearing impairment and peripheral neuropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neuropathy with hearing impairment</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuropathy with hearing impairment</rdfs:label>

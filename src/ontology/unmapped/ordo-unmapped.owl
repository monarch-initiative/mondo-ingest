    <!-- http://www.orpha.net/ORDO/Orphanet_2959 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2959">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139027"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139033"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363245"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79389"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic multiple congenital anomalies/dysmorphic syndrome characterized by intrauterine growth retardation and short stature, microcephaly, premature aging, bird-like facies with lack of facial subcutaneous fat, multiple pigmented nevi, sensorineural hearing loss, and variable intellectual disability. Immunodeficiency and development of tumors have also been described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Mulvihill-Smith syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progeria-short stature-pigmented nevi syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Progeria-short stature-pigmented nevi syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2B</skos:broadMatch>
        <skos:exactMatch>MONDO:0008311</skos:exactMatch>
        <skos:exactMatch>MeSH:C536422</skos:exactMatch>
        <skos:exactMatch>OMIM:176690</skos:exactMatch>
        <skos:exactMatch>UMLS:C1261128</skos:exactMatch>
    </owl:Class>

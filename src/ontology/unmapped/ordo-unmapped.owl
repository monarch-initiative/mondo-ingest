        <obo:IAO_0000115 xml:lang="en">Pseudomyxoma peritonei is characterized by disseminated intra-peritoneal mucinous tumors and mucinous ascites in the abdomen and pelvis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adenomucinosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Gelatinous ascites</oboInOwl:hasExactSynonym>

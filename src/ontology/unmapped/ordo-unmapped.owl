    <!-- http://www.orpha.net/ORDO/Orphanet_2724 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2724">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139042"/>

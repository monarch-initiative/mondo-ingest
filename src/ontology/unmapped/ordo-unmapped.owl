    <!-- http://www.orpha.net/ORDO/Orphanet_94080 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94080">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_573163"/>
        <obo:IAO_0000115 xml:lang="en">A rare neuroendocrine tumor arising from neural crest-derived paraganglion cells (most often in the para-aortic region at the level of renal hilia, organ of Zuckerkandl, thoracic paraspinal region, bladder, and carotid body) not associated with catecholamine secretion. These tumors are usually clinically silent and symptoms, if present, are nonspecific and depend on the location of the tumor. Association with certain hereditary cancer-predisposing syndromes, such as multiple endocrine neoplasia, neurofibromatosis type 1 or von Hippel lindau syndrome, may be observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Non-functioning paraganglioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-secreting paraganglioma</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-functioning paraganglioma</rdfs:label>
        <skos:broadMatch>ICD-10:D44.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F9A</skos:broadMatch>
        <skos:exactMatch>MONDO:0019788</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707263</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_94080"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Non-functioning paraganglioma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_94083 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94083">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182079"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Partington syndrome is a form of syndromic X-linked mental retardation (S-XLMR) characterised by the association of mild to moderate intellectual deficit, dysarthria and dystonic hand movements. So far, less than 20 cases have been described in the literature. The syndrome is caused by mutations in the Aristaless-related homeobox (&lt;i&gt;ARX&lt;/i&gt;) gene (Xp22.13). Transmission is X-linked recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Partington syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Partington-Mulley syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked intellectual disability-dystonia-dysarthria syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Partington syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G93.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010654</skos:exactMatch>
        <skos:exactMatch>MeSH:C536300</skos:exactMatch>
        <skos:exactMatch>OMIM:309510</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796250</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_94083"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Partington syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_94084 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94084">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C044"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Fryns-Aftimos syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cerebro-oculo-facial-lymphatic syndrome</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:exactMatch>UMLS:C1853623</skos:exactMatch>
    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_94086 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94086">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79166"/>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism characterized by early-onset diarrhea, fever, recurrent hypoglycemia, hypercalcemia with nephrocalcinosis, metabolic acidosis, and indicanuria due to bacterial degradation of malabsorbed tryptophan with excessive indole production which, upon oxidation to indigo blue, causes bluish discoloration of urine spots in the diaper of the affected infant.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Blue diaper syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Drummond syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial hypercalcemia-nephrocalcinosis-indicanuria syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Blue diaper syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E70.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C60.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008877</skos:exactMatch>
        <skos:exactMatch>MeSH:C536239</skos:exactMatch>
        <skos:exactMatch>OMIM:211000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268478</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_94086"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Blue diaper syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_94087 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94087">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79382"/>
        <obo:IAO_0000115 xml:lang="en">Cytophagic histiocytic panniculitis (CHP) is a very rare form of panniculitis manifesting as recurrent multiple subcutaneous nodules (which may progressively become ecchymotic and ulcerated), and histologically characterized by lobular panniculitis with lymphocytic and histiocytic infiltration in the subcutaneous adipose tissue.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CHP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cytophagic histiocytic panniculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Winkelmann cytophagic panniculitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Cytophagic histiocytic panniculitis</rdfs:label>
        <skos:broadMatch>ICD-10:M35.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EE8Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019789</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081137</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406594</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_94087"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Cytophagic histiocytic panniculitis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_94088 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94088">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183592"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93603"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13446"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17989"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A genetic renal tubular disorder characterized by urinary urate wasting that typically leads to asymptomatic hypouricemia and predisposes to urolithiasis and exercise-induced acute renal failure (EIARF).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial renal hypouricemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary renal hypouricemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary renal hypouricemia</rdfs:label>
        <skos:broadMatch>ICD-10:N25.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB90.4Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009071</skos:exactMatch>
        <skos:exactMatch>OMIM:220150</skos:exactMatch>
        <skos:exactMatch>UMLS:C4551590</skos:exactMatch>
        <skos:narrowMatch>OMIM:242050</skos:narrowMatch>
        <skos:narrowMatch>OMIM:307830</skos:narrowMatch>
        <skos:narrowMatch>OMIM:612076</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_94088"/>

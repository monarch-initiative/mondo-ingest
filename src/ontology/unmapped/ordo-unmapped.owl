            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Johanson-Blizzard syndrome (JBS) is a multiple congenital anomaly characterized by exocrine pancreatic insufficiency, hypoplasia/aplasia of the nasal alae, hypodontia, sensorineural hearing loss, growth retardation, anal and urogenital malformations, and variable intellectual disability.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">JBS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Johanson-Blizzard syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Johanson-Blizzard syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009479</skos:exactMatch>
        <skos:exactMatch>MeSH:C535880</skos:exactMatch>
        <skos:exactMatch>MedDRA:10074947</skos:exactMatch>
        <skos:exactMatch>OMIM:243800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0175692</skos:exactMatch>
    </owl:Class>

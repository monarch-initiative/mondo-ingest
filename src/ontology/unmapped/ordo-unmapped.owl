        <oboInOwl:hasExactSynonym xml:lang="en">Arterial hyperabduction syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Arterial scalenus anticus syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Arterial thoracic outlet compression syndrome</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_540 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_540">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102005"/>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_289499 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_289499">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522548"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14966"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13907"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic eye disease characterized by congenital cataract, microcornea, and corneal opacity, resulting in severe visual impairment or blindness. Depending on the genetic background, other developmental ocular defects may also be present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CCMCO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital cataract microcornea with corneal opacity</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital cataract microcornea with corneal opacity</rdfs:label>
        <skos:broadMatch>ICD-10:Q12.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B3Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010015</skos:exactMatch>
        <skos:exactMatch>OMIM:269400</skos:exactMatch>
        <skos:exactMatch>UMLS:C5779991</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3771"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism characterized by the presence of large amounts of trimethylamine in urine, sweat, and breath, resulting in a fishy body odor in affected individuals. While there are no additional signs and symptoms, the condition can have profound psychosocial consequences.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Severe primary trimethylaminuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TMAU</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe primary trimethylaminuria</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.G</skos:broadMatch>
        <skos:broadMatch>OMIM:602079</skos:broadMatch>
        <skos:exactMatch>MONDO:0018767</skos:exactMatch>
        <skos:exactMatch>UMLS:C5575503</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_468726"/>

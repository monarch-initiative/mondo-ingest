        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic microphthalmia characterized by bilateral, usually asymmetrical, microphthalmia associated typically with a unilateral coloboma, truncal obesity, borderline to mild intellectual disability, hypogenitalism and, more variably, nystagmus, cataracts and developmental delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Colobomatous microphthalmia-obesity-hypogenitalism-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Colobomatous microphthalmia-obesity-hypogenitalism-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0011145</skos:exactMatch>
        <skos:exactMatch>OMIM:601794</skos:exactMatch>
        <skos:exactMatch>UMLS:C4755253</skos:exactMatch>
    </owl:Class>

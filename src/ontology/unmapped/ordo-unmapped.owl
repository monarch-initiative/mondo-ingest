    <!-- http://www.orpha.net/ORDO/Orphanet_45452 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_45452">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_218439"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Idiopathic neonatal atrial flutter (AFL) is a rare rhythm disorder, characterized by sustained tachycardia in newborns and infants with an atrial rate often at around 440 beats/minute (range 340-580). AFL may manifest as asymptomatic tachycardia, congestive heart failure or hydrops.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Idiopathic neonatal atrial flutter</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic neonatal atrial flutter</rdfs:label>
        <skos:broadMatch>ICD-10:P29.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:BC81.20</skos:broadMatch>
        <skos:exactMatch>MONDO:0018684</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275090</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_45452"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Idiopathic neonatal atrial flutter</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_45453 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_45453">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_218439"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Incessant infant ventricular tachycardia is a rare type of ventricular tachycardia (VT) characterized by the presence of tachycardia originating from the ventricles, observed for more than 10% of a 24 hour monitoring period. Patients are either asymptomatic or present congestive heart failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Incessant infant ventricular tachycardia</oboInOwl:hasExactSynonym>
        <rdfs:label>Incessant infant ventricular tachycardia</rdfs:label>
        <skos:broadMatch>ICD-10:I47.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:BC71.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018685</skos:exactMatch>
        <skos:exactMatch>UMLS:C0340487</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_45453"/>

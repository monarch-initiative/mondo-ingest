            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An extremely rare syndromic lymphedema disorder characterized by early-onset hypotrichosis, childhood-onset lymphedema, and variable telangiectasia, particularly of the palms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypotrichosis-lymphedema-telangiectasia-membranoproliferative glomerulonephritis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypotrichosis-lymphedema-telangiectasia-renal defect syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypotrichosis-lymphedema-telangiectasia-renal defect syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:BD93.0</skos:broadMatch>
        <skos:exactMatch>UMLS:C4317151</skos:exactMatch>
        <skos:narrowMatch>OMIM:137940</skos:narrowMatch>
        <skos:narrowMatch>OMIM:607823</skos:narrowMatch>
    </owl:Class>

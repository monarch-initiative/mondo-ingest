    <!-- http://www.orpha.net/ORDO/Orphanet_86918 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_86918">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98352"/>
        <obo:IAO_0000115 xml:lang="en">Diffuse palmoplantar keratoderma-acrocyanosis syndrome is characterised by the association of diffuse palmoplantar keratoderma and acrocyanosis. It has been described in eight members of one family and in two sporadic cases. The mode of inheritance in the familial cases was autosomal dominant.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse palmoplantar hyperkeratosis-acrocyanosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Diffuse palmoplantar keratoderma-acrocyanosis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Diffuse palmoplantar keratoderma-acrocyanosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.30</skos:broadMatch>
        <skos:exactMatch>MONDO:0019489</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303588</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_86918"/>

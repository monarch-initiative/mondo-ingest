    <!-- http://www.orpha.net/ORDO/Orphanet_171863 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171863">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100980"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/95"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A pure form of hereditary spastic paraplegia characterized by slowly progressive spastic paraplegia of lower extremities with an age of onset ranging from childhood to adulthood and patients presenting with spastic gait, increased tendon reflexes in lower limbs, extensor plantar response, weakness and atrophy of lower limb muscles and, in rare cases, pes cavus. No abnormalities are noted on magnetic resonance imaging.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant spastic paraplegia type 42</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG42</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant spastic paraplegia type 42</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0012928</skos:exactMatch>
        <skos:exactMatch>MeSH:C567262</skos:exactMatch>
        <skos:exactMatch>UMLS:C2675528</skos:exactMatch>
        <skos:narrowMatch>OMIM:612539</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618087</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_171863"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An astrogliopathy and a form of Alexander disease (AxD) characterized by ataxia, bulbar symptoms, spastic paraparesis, palatal myoclonus, and autonomic symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Alexander disease type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">AxD type II</oboInOwl:hasExactSynonym>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">Scleroderma is a rare autoimmune connective tissue disorder characterized by abnormal hardening of the skin and, sometimes, other organs. It is classified into two main forms: localized scleroderma and systemic sclerosis (SSc), the latter comprising three subsets; diffuse cutaneous SSc (dcSSc), limited cutaneous SSc (lcSSc) and limited SSc (lSSc).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Scleroderma</oboInOwl:hasExactSynonym>
        <rdfs:label>Scleroderma</rdfs:label>
        <skos:exactMatch>MONDO:0019340</skos:exactMatch>
        <skos:exactMatch>MONDO:19340</skos:exactMatch>
        <skos:exactMatch>MedDRA:10039710</skos:exactMatch>
        <skos:exactMatch>UMLS:C0011644</skos:exactMatch>
    </owl:Class>

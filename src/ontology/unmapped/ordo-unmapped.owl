    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_84090">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183586"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

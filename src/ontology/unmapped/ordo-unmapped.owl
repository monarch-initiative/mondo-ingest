    <!-- http://www.orpha.net/ORDO/Orphanet_45448 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_45448">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206653"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207073"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

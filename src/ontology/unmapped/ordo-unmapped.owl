        <oboInOwl:hasExactSynonym xml:lang="en">Steroid 5-alpha-reductase 2 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>46,XY difference of sex development due to 5-alpha-reductase 2 deficiency</rdfs:label>

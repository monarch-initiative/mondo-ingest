        <oboInOwl:hasExactSynonym xml:lang="en">Xp21 contiguous gene deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Xp21 deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Xp21 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(x)(p21)</oboInOwl:hasExactSynonym>
        <rdfs:label>Xp21 deletion syndrome</rdfs:label>

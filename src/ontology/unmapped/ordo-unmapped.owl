    <!-- http://www.orpha.net/ORDO/Orphanet_319600 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319600">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_319543"/>

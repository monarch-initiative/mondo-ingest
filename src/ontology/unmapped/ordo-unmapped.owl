    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_238769">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262001"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">1q44 microdeletion syndrome is a newly described syndrome associated with facial dysmorphism, developmental delay, in particular of expressive speech, seizures and hypotonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>1q44 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(1)(q44)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 1q44</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(1)(q44)</oboInOwl:hasExactSynonym>
        <rdfs:label>1q44 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0016561</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304540</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

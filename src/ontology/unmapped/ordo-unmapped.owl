        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_478042 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_478042">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35696"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/26022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare mitochondrial oxidative phosphorylation disorder characterized by neonatal onset of hypotonia, feeding difficulties, deafness, and early fatal respiratory failure. Cardiac and liver involvement has been reported. Serum lactate is increased, and metabolic studies show decreased activity of mitochondrial respiratory complexes I and IV in skeletal muscle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COXPD30</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Combined oxidative phosphorylation defect type 30</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined oxidative phosphorylation defect type 30</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.23</skos:broadMatch>
        <skos:exactMatch>MONDO:0014856</skos:exactMatch>
        <skos:exactMatch>OMIM:616974</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567605</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_478042"/>

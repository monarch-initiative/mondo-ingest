        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1762 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1762">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263783"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked genomic disorder associated with interstitial chromosomal duplications at Xq28 encompassing the &lt;i&gt;MECP2&lt;/i&gt; gene. It is characterized in males by infantile onset hypotonia, severe global developmental delay, intellectual disability, progressive spasticity, seizures, gastrointestinal symptoms and recurrent respiratory infections. In females, the phenotype is more variable.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MECP2 duplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Proximal Xq28 duplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked intellectual disability syndrome, Lubs type</oboInOwl:hasExactSynonym>
        <rdfs:label>Proximal Xq28 duplication syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD51</skos:broadMatch>
        <skos:exactMatch>MONDO:0010283</skos:exactMatch>
        <skos:exactMatch>MeSH:C537723</skos:exactMatch>
        <skos:exactMatch>UMLS:C1846058</skos:exactMatch>
        <skos:narrowMatch>OMIM:300260</skos:narrowMatch>
        <skos:narrowMatch>OMIM:300815</skos:narrowMatch>
    </owl:Class>

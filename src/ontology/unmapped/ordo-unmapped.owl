        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_66529 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_66529">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217678"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare cardiac disease characterized by acute occurrence of heart failure after an emotional or physical trigger; recovery of the wall motion abnormalities are observed within months. Symptoms are similar to acute coronary syndrome (ACS).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ampulla cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Apical ballooning syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ballooning cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Broken heart syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stress cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tako-Tsubo cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tako-Tsubo syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Takotsubo cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Takotsubo syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Transient left ventricular apical ballooning syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Tako-Tsubo cardiomyopathy</rdfs:label>
        <skos:broadMatch>ICD-10:I42.8</skos:broadMatch>

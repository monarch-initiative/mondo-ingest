                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4704"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary elliptocytosis (HE) is a rare clinically and genetically heterogeneous disorder of the red cell membrane characterized by manifestations ranging from mild to severe transfusion-dependent hemolytic anemia but with the majority of patients being asymptomatic.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary elliptocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary elliptocytosis</rdfs:label>
        <skos:exactMatch>ICD-10:D58.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:3A10.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0017319</skos:exactMatch>
        <skos:exactMatch>MeSH:D004612</skos:exactMatch>
        <skos:exactMatch>MedDRA:10014490</skos:exactMatch>
        <skos:exactMatch>UMLS:C0013902</skos:exactMatch>
        <skos:narrowMatch>OMIM:130600</skos:narrowMatch>
        <skos:narrowMatch>OMIM:235370</skos:narrowMatch>
        <skos:narrowMatch>OMIM:611804</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617948</skos:narrowMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_530792 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_530792">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_301"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare ependymal tumor characterized by the presence of a &lt;i&gt;RELA&lt;/i&gt; fusion gene. This supratentorial grade II or III ependymoma most often occurs in children and young adults. Histopathological features are variable, but a distinctive vascular pattern of branching capillaries or clear-cell change are common. Patients may present with focal neurological deficits, seizures, or features of raised intracranial pressure. Prognosis is worse than in other supratentorial ependymomas.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>RELA fusion-positive ependymoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Supratentorial C11ORF95-RELA fused ependymoma</oboInOwl:hasExactSynonym>
        <rdfs:label>RELA fusion-positive ependymoma</rdfs:label>
        <skos:broadMatch>ICD-10:D43.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.0Y</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH2AY7</skos:exactMatch>
        <skos:exactMatch>MONDO:0033980</skos:exactMatch>
        <skos:exactMatch>UMLS:C4289581</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_530792"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

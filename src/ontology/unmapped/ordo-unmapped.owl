    <!-- http://www.orpha.net/ORDO/Orphanet_209959 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_209959">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306648"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare ophthalmic disorder characterized by a zonal granulomatous inflammatory reaction centered around the lens secondary to its traumatic rupture. Signs and symptoms include photophobia, ocular irritation or pain, blurred vision, redness, mutton-fat keratic precipitates, posterior synechiae, and sometimes hypopyon. Intraocular pressure may be elevated due to blockage of the trabecular meshwork by inflammatory cells or lens material.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Endophthalmitis phacoanaphylactica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lens-induced endophthalmitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lens-induced iridocyclitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lens-induced uveitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phacoallergic endophthalmitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Phacoanaphylactic uveitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phacoantigenic endophthalmitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phako-anaphylactic endophthalmitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Phacoanaphylactic uveitis</rdfs:label>
        <skos:broadMatch>ICD-11:9A96.Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:H20.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0016207</skos:exactMatch>
        <skos:exactMatch>UMLS:C1444621</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

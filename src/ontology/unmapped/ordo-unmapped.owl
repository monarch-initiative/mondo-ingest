    <!-- http://www.orpha.net/ORDO/Orphanet_563576 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_563576">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2137"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A form of autoimmune hepatitis characterized by clinical presentation as cryptogenic hepatitis, interface hepatitis on histological examination, elevated serum aminotransferase levels, hypergammaglobulinemia/elevated immunoglobulin G, and presence of circulating autoantibodies, specifically antinuclear antibodies (ANA), anti-smooth muscle antibodies (anti-SMA), and/or anti-soluble liver antigen/liver pancreas antigen antibodies (anti-SLA/LP). The disease predominantly develops at a post-pubertal age and most commonly takes a chronic course, although acute or acute severe presentation may also be observed. Typical concurrent autoimmune diseases are autoimmune thyroiditis and rheumatic diseases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AIH type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autoimmune hepatitis type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Autoimmune hepatitis type 1</rdfs:label>
        <skos:broadMatch>ICD-10:K75.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:DB96.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0005543</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303164</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_563576"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autoimmune hepatitis type 1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_563581 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_563581">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2137"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A form of autoimmune hepatitis characterized by clinical presentation as cryptogenic hepatitis, interface hepatitis on histological examination, elevated serum aminotransferase levels, hypergammaglobulinemia/elevated immunoglobulin G, and presence of circulating autoantibodies, specifically antibodies to liver kidney microsome type 1 (anti-LKM1) and anti-liver cytosol type 1 (anti-LC1) antibodies. The disease typically manifests in childhood or adolescence with an acute onset, often with acute liver failure. Long-term immunosuppression is usually required. Reported concurrent autoimmune diseases are autoimmune thyroiditis, diabetes mellitus, and vitiligo.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AIH type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autoimmune hepatitis type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Autoimmune hepatitis type 2</rdfs:label>
        <skos:broadMatch>ICD-10:K75.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:DB96.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0021176</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303163</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_563581"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autoimmune hepatitis type 2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_563589 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_563589">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2137"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A form of autoimmune hepatitis characterized by the features of classic autoimmune hepatitis (i. e. clinical presentation as acute or chronic cryptogenic hepatitis, interface hepatitis on histological examination, elevated serum aspartate aminotransferase and alanine aminotransferase levels, hypergammaglobulinemia/elevated immunoglobulin G, therapeutic response to corticosteroids) in the absence of serum autoantibodies. Clinical manifestations include fatigue, malaise, arthralgia, jaundice, at later stages also signs of advanced chronic liver disease, such as spider nevi, caput medusae, splenomegaly, ascites, and palmar erythema. Presence of concurrent autoimmune diseases is frequently observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autoantibody-negative autoimmune hepatitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Seronegative AIH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Seronegative autoimmune hepatitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Seronegative autoimmune hepatitis</rdfs:label>
        <skos:broadMatch>ICD-10:K75.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:DB96.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0035400</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680121</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_563589"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Seronegative autoimmune hepatitis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



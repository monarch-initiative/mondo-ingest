            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Dopa-responsive dystonia (DRD) due to sepiapterin reductase deficiency (SRD) is a very rare neurometabolic disorder characterized by dystonia with diurnal fluctuations, axial hypotonia, oculogyric crises, and delays in motor and cognitive development.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive sepiapterin reductase-deficient DRD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DRD due to SRD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dopa-responsive dystonia due to sepiapterin reductase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPR deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sepiapterin reductase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Dopa-responsive dystonia due to sepiapterin reductase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:G24.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C59.01</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_90045 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90045">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104004"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_285657"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_331217"/>

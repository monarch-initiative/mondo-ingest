        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_251663 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251663">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251651"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare and aggressive glial tumor of the central nervous system, that usually presents in adults with seizures, is most often located in the cerebral hemispheres and that is associated with a very poor prognosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anaplastic oligoastrocytoma, dual genotype</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Anaplastic oligoastrocytoma, dual genotype NEC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Anaplastic oligoastrocytoma, dual genotype, not elsewhere classified</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">aMOA</oboInOwl:hasExactSynonym>
        <rdfs:label>Anaplastic oligoastrocytoma, dual genotype</rdfs:label>
        <skos:broadMatch>ICD-10:C71.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016703</skos:exactMatch>
        <skos:exactMatch>UMLS:C0431108</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251663"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Sudden infant death with dysgenesis of the testes (SIDDT) syndrome is a lethal condition in infants with dysgenesis of testes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SIDDT</oboInOwl:hasExactSynonym>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2771 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2771">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_167762"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7820"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked dominant multiple congenital anomalies/dysmorphic syndrome characterized by congenital cataracts with microcornea, dental anomalies, and facial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Nance-Horan syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Nance-Horan syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>

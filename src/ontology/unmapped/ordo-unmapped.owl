        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Acro-cephalo-synostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Allain-Babin-Demarquez syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>OBSOLETE: Craniosynostosis-synostoses-hypertensive nephropathy syndrome</rdfs:label>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8582"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of phenylalanine (Phe) metabolism, an inborn error of amino acid metabolism, characterized by the development of microcephaly, growth retardation, congenital heart disease, facial dysmorphism and intellectual disability in non-phenylketonuric offspring of mothers with excess blood Phe concentrations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperphenylalaninemic embryopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maternal PKU syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maternal hyperphenylalaninemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Maternal phenylketonuria syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phenylketonuric embryopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Maternal phenylketonuria syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E70.1</skos:broadMatch>

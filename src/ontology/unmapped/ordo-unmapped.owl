    <!-- http://www.orpha.net/ORDO/Orphanet_296 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_296">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140162"/>

        <owl:annotatedTarget>Glucagonoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_97282 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97282">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506060"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">VIPoma is an extremely rare type of pancreatic neuroendocrine tumor that secretes vasoactive intestinal polypeptide (VIP) leading to the manifestations of watery diarrhea, hypokalemia and achlorhydia or hypochhlorhydia (known as WDHA syndrome).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diarrheogenic islet cell tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pancreatic cholera</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">VIP-secreting tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>VIPoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Verner-Morrison syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">WDHA syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Watery diarrhea-hypokalemia-achlorhydria syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>VIPoma</rdfs:label>
        <skos:broadMatch>ICD-10:D37.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C10.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH72E5</skos:exactMatch>
        <skos:exactMatch>MONDO:0019960</skos:exactMatch>
        <skos:exactMatch>MeSH:D003969</skos:exactMatch>
        <skos:exactMatch>MedDRA:10047430</skos:exactMatch>
        <skos:exactMatch>UMLS:C0011993</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97282"/>

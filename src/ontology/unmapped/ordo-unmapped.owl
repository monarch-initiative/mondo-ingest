            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neurocutaneous disease characterized by severe developmental abnormalities of the nervous system and aberrant differentiation of the epidermis. Patients present with a unique constellation of clinical signs described with the acronym CEDNIK: CErebral Dysgenesis, Neuropathy, Ichthyosis, and palmoplantar Keratoderma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CEDNIK syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cerebral dysgenesis-neuropathy-ichthyosis-palmoplantar keratoderma syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>CEDNIK syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0012290</skos:exactMatch>

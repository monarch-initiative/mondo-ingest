            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1733"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic syndromic intellectual disability characterized by intellectual disabilities/neurodevelopmental disorders associated with developmental delay and various others features such as congenital heart malformation and specific facial features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CDK13-related developmental delay-intellectual disability-facial dysmorphism-congenital heart defects syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDK13-related disorder</oboInOwl:hasExactSynonym>
        <rdfs:label>CDK13-related developmental delay-intellectual disability-facial dysmorphism-congenital heart defects syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0044302</skos:exactMatch>
        <skos:exactMatch>OMIM:617360</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816700</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_646278"/>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_324321 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_324321">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101934"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

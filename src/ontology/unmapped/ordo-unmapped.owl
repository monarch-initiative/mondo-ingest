        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by congenital hydrocephalus involving the lateral ventricles, low-set umbilicus, bilateral inguinal hernia, and mild facial dysmorphism (such as epicanthal folds, broad, flat nasal bridge, and small, bulbous nose). Additional reported manifestations include unilateral cryptorchidism, vesicoureteral reflux, and tetralogy of Fallot. There have been no further descriptions in the literature since 1993.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hydrocephaly-low insertion umbilicus syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Palmer-Pagon syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hydrocephaly-low insertion umbilicus syndrome</rdfs:label>

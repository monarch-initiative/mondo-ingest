        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bacterial infectious disease caused by &lt;i&gt;Francisella tularensis&lt;/i&gt; and characterized by six major clinical presentations: ulceroglandular, glandular, oropharyngeal, oculoglandular, pneumonic, or typhoidal, depending on the route of infection. Early flu-like symptoms are common to all forms and are accompanied/followed by either a skin inoculation ulcer with localized lymphadenopathy; isolated lymphadenopathy; chronic pharyngitis with cervical lymphadenopathy; conjunctivitis with localized lymphadenopathy; lung involvement; severe systemic disease with neurological symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Tularemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Tularemia</rdfs:label>
        <skos:exactMatch>ICD-11:1B94</skos:exactMatch>

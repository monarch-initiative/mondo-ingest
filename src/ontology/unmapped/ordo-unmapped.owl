    <!-- http://www.orpha.net/ORDO/Orphanet_2695 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2695">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_141234"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156246"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_435606"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital nose and cavum anomaly characterized by clefting of the nose ranging from a minimally noticeable groove in the columella to complete clefting of the underlying bones and cartilage (resulting in two half noses) with a usually adequate airway. Bifid nose may be seen in frontonasal dysplasia; other malformations such as hypertelorbitism and midline clefts of the lip may also be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bifid nose</oboInOwl:hasExactSynonym>
        <rdfs:label>Bifid nose</rdfs:label>
        <skos:broadMatch>ICD-10:Q30.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA70.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0000110</skos:exactMatch>
        <skos:exactMatch>MeSH:C535441</skos:exactMatch>
        <skos:exactMatch>UMLS:C0221363</skos:exactMatch>
        <skos:narrowMatch>OMIM:109740</skos:narrowMatch>
        <skos:narrowMatch>OMIM:210400</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2695"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Bifid nose</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



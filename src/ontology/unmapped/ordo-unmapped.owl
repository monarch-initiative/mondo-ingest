            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital disorder of copper metabolism that is principally characterized by bony exostoses (including the pathognomonic occipital horns), and connective tissue manifestations with cutis laxa and bladder diverticula. Central nervous system involvement is variable.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Occipital horn syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Occipital horn syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E83.0</skos:broadMatch>

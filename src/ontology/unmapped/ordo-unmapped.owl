        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by intellectual disability, growth delay, absence deformities of upper and lower limbs, hypotrichosis, hypoplastic nails, abnormal dentition, abnormal auricles, hypoplastic nipples, thyroid enlargement, and abnormalities of tyrosine and/or tryptophane metabolism. Hypogonadism and cleft lip have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Freire-Maia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Odontotrichomelic syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Odontotrichomelic syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010111</skos:exactMatch>
        <skos:exactMatch>MeSH:C535637</skos:exactMatch>
        <skos:exactMatch>OMIM:273400</skos:exactMatch>
        <skos:exactMatch>UMLS:C2930960</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2723"/>

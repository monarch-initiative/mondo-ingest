            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare acid sphingomyelinase deficiency characterized by mild to massive hepatosplenomegaly, hypersplenism leading to thrombocytopenia, interstitial lung disease, dyslipidemia and central nervous system manifestations (including developmental delay, intellectual disability and ataxia). Some affected individuals may present with coarse facial features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Chronic neurovisceral ASMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic neurovisceral acid sphingomyelinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NPD-A/B</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Niemann-Pick disease type A/B</oboInOwl:hasExactSynonym>
        <rdfs:label>Chronic neurovisceral acid sphingomyelinase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E75.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.0Y</skos:broadMatch>
        <skos:broadMatch>OMIM:257200</skos:broadMatch>
        <skos:broadMatch>OMIM:607616</skos:broadMatch>
        <skos:exactMatch>MONDO:0850058</skos:exactMatch>
        <skos:exactMatch>UMLS:C5539139</skos:exactMatch>
    </owl:Class>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spondyloepiphyseal dysplasia congenita (SEDC) is a chondrodysplasia characterized by disproportionate short stature, abnormal epiphyses and flattened vertebral bodies.</obo:IAO_0000115>

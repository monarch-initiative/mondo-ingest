    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_65285 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_65285">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251934"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269523"/>

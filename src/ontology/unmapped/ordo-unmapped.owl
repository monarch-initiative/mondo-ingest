                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4394"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4678"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8787"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare retinal dystrophy characterized by photophobia, progressive loss of visual acuity, nystagmus, visual field abnormalities, abnormal color vision, and psychophysical and electrophysiological evidence of abnormal cone function. Progressive cone dystrophy usually presents in childhood or early adult life, and patients tend to develop rod photoreceptor dysfunction in later life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cone dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progressive cone dystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Progressive cone dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:H35.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B70</skos:broadMatch>
        <skos:exactMatch>MONDO:455</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083940</skos:exactMatch>
        <skos:exactMatch>UMLS:C3665342</skos:exactMatch>
        <skos:narrowMatch>OMIM:180020</skos:narrowMatch>
        <skos:narrowMatch>OMIM:300085</skos:narrowMatch>
        <skos:narrowMatch>OMIM:304030</skos:narrowMatch>
        <skos:narrowMatch>OMIM:602093</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613093</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1871"/>

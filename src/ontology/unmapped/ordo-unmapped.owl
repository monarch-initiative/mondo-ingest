    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_157987 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_157987">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182222"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_645749 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645749">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-syndromic esophageal malformation characterized by intrinsic narrowing of the esophagus, caused by congenital malformation of esophageal wall architecture present at birth. Patients manifest dysphagia and progressive vomiting. Esophageal food impaction, failure to thrive or respiratory distress can be present. Symptoms are often attributed to colic or reflux, thus diagnosis is often difficult.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CES</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital esophageal stenosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital oesophageal stenosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital esophageal stenosis</rdfs:label>
        <skos:broadMatch>ICD-11:LB12.3</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q39.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0957459</skos:exactMatch>
        <skos:exactMatch>MedDRA:10010564</skos:exactMatch>
        <skos:exactMatch>UMLS:C1963580</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645749"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital esophageal stenosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645793 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645793">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117569"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165711"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare intestinal disease characterized by a single, focal intestinal perforation, associated with hemorrhagic necrosis, typically occurring at the terminal ileum, involving antimesenteric border. It may also occur in the jejunum or colon. It predominantly affects very (or extremely) low weight infants (birth weight less than 1500&amp;nbsp;g) mostly in the first week of life. Patients have healthy bowel apart from the perforation site, they present with bluish discoloration and gasless abdomen in the absence of pneumatosis intestinalis. Urinary tract infection can also be present. However they do not manifest necrotizing enterocolitis, bowel obstruction or prodromal clinical symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FIP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Focal intestinal perforation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated perforation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal focal intestinal perforation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SIP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spontaneous intestinal perforation</oboInOwl:hasExactSynonym>
        <rdfs:label>Spontaneous intestinal perforation</rdfs:label>
        <skos:broadMatch>ICD-10:K63.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:KB84</skos:exactMatch>
        <skos:exactMatch>MONDO:0957460</skos:exactMatch>
        <skos:exactMatch>UMLS:C3897004</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645793"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Spontaneous intestinal perforation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



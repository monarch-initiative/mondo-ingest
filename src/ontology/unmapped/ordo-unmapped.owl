    <!-- http://www.orpha.net/ORDO/Orphanet_168829 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168829">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_168807"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Primary peritoneal carcinoma (PPC) is a rare malignant tumor of the peritoneal cavity of extra-ovarian origin, clinically and histologically similar to advanced-stage serous ovarian carcinoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EOPPC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Extra-ovarian primary peritoneal carcinoma</oboInOwl:hasExactSynonym>

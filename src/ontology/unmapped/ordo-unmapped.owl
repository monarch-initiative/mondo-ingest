    <!-- http://www.orpha.net/ORDO/Orphanet_2026 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2026">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139042"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183580"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79365"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/35"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant disorder characterized by a generalized enlargement of the gingiva occurring at birth or during childhood that is associated with generalized hypertrichosis developing at birth, during the first years of life, or at puberty and predominantly affecting the face, upper limbs, and midback.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CGHT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital generalized hypertrichosis terminalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gingival fibromatosis-hypertrichosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hirsutism-congenital gingival hyperplasia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypertrichosis with or without gingival hyperplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Gingival fibromatosis-hypertrichosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:L68.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007610</skos:exactMatch>
        <skos:exactMatch>OMIM:135400</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274889</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2026"/>

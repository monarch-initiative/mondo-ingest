    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3348">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101944"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare idiopathic, benign respiratory disease characterized by submucosal cartilaginous and/or bony nodules presenting in the trachea with or without the involvement of the major bronchi; involvement is potentially anywhere along the anterior and lateral walls of the tracheobronchial tree with sparing the posterior walls.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Tracheobronchopathia osteochondroplastica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tracheopathia osteoplastica</oboInOwl:hasExactSynonym>
        <rdfs:label>Tracheobronchopathia osteochondroplastica</rdfs:label>
        <skos:broadMatch>ICD-10:J98.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:CA27.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0008587</skos:exactMatch>
        <skos:exactMatch>MeSH:C536977</skos:exactMatch>
        <skos:exactMatch>OMIM:189961</skos:exactMatch>
        <skos:exactMatch>UMLS:C0520538</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3348"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Tracheobronchopathia osteochondroplastica</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



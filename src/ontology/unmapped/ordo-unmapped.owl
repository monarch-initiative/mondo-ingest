            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Cerebro-costo-mandibular syndrome (CCMS) is characterized at birth by posterior rib gaps and orofacial anomalies reminiscent of Pierre Robin syndrome that include palatal defects (short hard palate, absent soft palate, absent uvula), micrognathia and glossoptosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cerebrocostomandibular syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cerebrocostomandibular syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.H</skos:broadMatch>
        <skos:exactMatch>MONDO:0007301</skos:exactMatch>
        <skos:exactMatch>MeSH:C562538</skos:exactMatch>
        <skos:exactMatch>MedDRA:10088264</skos:exactMatch>
        <skos:exactMatch>OMIM:117650</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265342</skos:exactMatch>
    </owl:Class>

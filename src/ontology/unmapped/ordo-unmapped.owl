        <rdfs:label>Cardiac-valvular Ehlers-Danlos syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q79.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD28.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009159</skos:exactMatch>
        <skos:exactMatch>OMIM:225320</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303789</skos:exactMatch>
    </owl:Class>

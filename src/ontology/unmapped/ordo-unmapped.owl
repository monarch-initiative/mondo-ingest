        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209059"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209182"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_607"/>
        <obo:IAO_0000115 xml:lang="en">A rapidly progressive type of nemaline myopathy (NM) characterized by a very late onset.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Adult-onset nemaline myopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Adult-onset nemaline myopathy</rdfs:label>
        <skos:broadMatch>ICD-10:G71.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C72.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0015739</skos:exactMatch>
        <skos:exactMatch>UMLS:C0546123</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_171442"/>

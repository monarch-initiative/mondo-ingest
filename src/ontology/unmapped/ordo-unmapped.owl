    <!-- http://www.orpha.net/ORDO/Orphanet_3214 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3214">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183469"/>

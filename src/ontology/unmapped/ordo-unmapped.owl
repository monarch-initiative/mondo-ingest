    <!-- http://www.orpha.net/ORDO/Orphanet_2056 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2056">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_308463"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6315"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Essential fructosuria is a rare autosomal recessive disorder of fructose metabolism caused by a deficiency of fructokinaseenzyme activity. It is characterized by elevated fructosemia and presence of fructosuria following ingestion of fructose and related sugars (sucrose, sorbitol). Essential fructosuria is clinically asymptomatic and harmless. Dietary restriction is not indicated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Essential fructosuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fructokinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ketohexokinase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Essential fructosuria</rdfs:label>
        <skos:broadMatch>ICD-10:E74.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.5Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009252</skos:exactMatch>
        <skos:exactMatch>MeSH:C538068</skos:exactMatch>
        <skos:exactMatch>MedDRA:10015487</skos:exactMatch>
        <skos:exactMatch>OMIM:229800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268160</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2056"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Essential fructosuria</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2057 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2057">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98578"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome characterised by the association of blepharophimosis and ptosis, V-esotropia, and weakness of extraocular and frontal muscles with syndactyly of the toes, short stature, prognathism, and hypertrophy and fusion of the eyebrows.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Blepharophimosis-ptosis-esotropia-syndactyly-short stature syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Frydman-Cohen-Karmon syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Blepharophimosis-ptosis-esotropia-syndactyly-short stature syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008875</skos:exactMatch>
        <skos:exactMatch>OMIM:210745</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303550</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2057"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Blepharophimosis-ptosis-esotropia-syndactyly-short stature syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2058 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2058">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by severe psychomotor development delay (without development of primary motor abilities and speech) and severe intellectual disability, associated with marfanoid habitus, joint laxity, bilateral hip luxation, hypotonia, scoliosis, and characteristic facial dysmorphism (including high nasal bridge, sharp nose, short philtrum, large mouth, full lips and maxillary hypoplasia). There have been no further descriptions in the literature since 1994.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fryns-Smeets-Thiry syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Fryns-Smeets-Thiry syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0023201</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680810</skos:exactMatch>
    </owl:Class>

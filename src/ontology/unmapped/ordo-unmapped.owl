    <!-- http://www.orpha.net/ORDO/Orphanet_88950 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_88950">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156162"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_34149"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12559"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of autosomal dominant tubulointerstitial kidney disease (ADTKD) due to &lt;i&gt;UMOD&lt;/i&gt; mutations that is clinically characterized by bland urinalysis (absence of blood or protein in the urine), chronic kidney disease (CKD) leading to end-stage kidney disease (ESKD) between 20 and 80 years, and gout occurring in 50% of affected individuals.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ADTKD-UMOD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant tubulointerstitial kidney disease due to UMOD mutation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial juvenile hyperuricemic nephropathy type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MCKD2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Medullary cystic kidney disease type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UAKD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UMOD kidney disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UMOD-related ADTKD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>UMOD-related autosomal dominant tubulointerstitial kidney disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Uromodulin-associated kidney disease</oboInOwl:hasExactSynonym>
        <rdfs:label>UMOD-related autosomal dominant tubulointerstitial kidney disease</rdfs:label>
        <skos:broadMatch>ICD-10:Q61.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB82</skos:broadMatch>
        <skos:exactMatch>MONDO:0008073</skos:exactMatch>
        <skos:exactMatch>MeSH:C548033</skos:exactMatch>
        <skos:exactMatch>OMIM:162000</skos:exactMatch>
        <skos:exactMatch>UMLS:C1859040</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_88950"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>UMOD-related autosomal dominant tubulointerstitial kidney disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



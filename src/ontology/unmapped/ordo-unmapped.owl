    <!-- http://www.orpha.net/ORDO/Orphanet_1094 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1094">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A multiple congenital anomaly disorder characterized by anonychia congenita totalis and microcephaly, and normal intelligence along with some minor anomalies including single transverse palmar creases, fifth-finger clinodactyly and widely-spaced teeth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anonychia-microcephaly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Teebi-Kaurah syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Anonychia-microcephaly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0011795</skos:exactMatch>
        <skos:exactMatch>MeSH:C536948</skos:exactMatch>
        <skos:exactMatch>OMIM:607214</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931373</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1094"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

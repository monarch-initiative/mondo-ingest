        </rdfs:subClassOf>
        <oboInOwl:hasExactSynonym xml:lang="en">CMT1A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Charcot-Marie-Tooth disease type 1A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Microduplication 17p12</oboInOwl:hasExactSynonym>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/583"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare intestinal polyposis syndrome characterized by the development of up to hundreds to thousands of adenomas in the large bowel. It is a multi-system disorder with important extracolonic manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Colorectal adenomatous polyposis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FAP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial adenomatous polyposis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial polyposis coli</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial adenomatous polyposis</rdfs:label>
        <skos:broadMatch>ICD-10:D12.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:2B90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0021055</skos:exactMatch>
        <skos:exactMatch>MeSH:D011125</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056981</skos:exactMatch>
        <skos:exactMatch>UMLS:C0032580</skos:exactMatch>
        <skos:narrowMatch>OMIM:175100</skos:narrowMatch>
        <skos:narrowMatch>OMIM:608456</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616415</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617100</skos:narrowMatch>
    </owl:Class>

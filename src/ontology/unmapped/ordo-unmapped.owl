    <!-- http://www.orpha.net/ORDO/Orphanet_168999 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168999">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

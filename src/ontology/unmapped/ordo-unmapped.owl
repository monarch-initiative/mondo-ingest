        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93454"/>
        <obo:IAO_0000115 xml:lang="en">Imperforate oropharynx-costovertebral anomalies syndrome is a dysostosis with predominant vertebral and costal involvement characterized by oropharyngeal atresia, mild mandibulofacial dysostosis, auricular malformations, and costovertebral anomalies (hemivertebrae, block vertebra, partial fusion of the ribs, absent ribs). There have been no further descriptions in the literature since 1989.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Imperforate oropharynx-costovertebral anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Seghers syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Imperforate oropharynx-costovertebral anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0017162</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749770</skos:exactMatch>
    </owl:Class>

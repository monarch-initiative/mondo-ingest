    <!-- http://www.orpha.net/ORDO/Orphanet_173 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_173">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>

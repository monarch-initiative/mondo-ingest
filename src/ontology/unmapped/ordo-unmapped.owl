        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Fallot complex - intellectual deficit - growth delay is a rare disorder characterized by tetralogy of Fallot, minor facial anomalies, and severe intellectual deficiency and growth delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bindewald-Ulmer-Müller syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fallot complex-intellectual disability-growth delay syndrome</oboInOwl:hasExactSynonym>

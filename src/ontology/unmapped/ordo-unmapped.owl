    <!-- http://www.orpha.net/ORDO/Orphanet_3255 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3255">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/26877"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Filippi syndrome is characterised by microcephaly, cutaneous syndactyly of the fingers and toes, intellectual deficit, growth retardation and a characteristic facies (high and broad nasal bridge, thin alae nasi, micrognathia and a high frontal hairline). So far, less than 25 cases have been reported. Cryptorchidism, polydactyly, and teeth and hair anomalies may also be present. Transmission is autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Filippi syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Type 1 syndactyly-microcephaly-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Filippi syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010092</skos:exactMatch>
        <skos:exactMatch>MeSH:C538152</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083943</skos:exactMatch>
        <skos:exactMatch>OMIM:272440</skos:exactMatch>
        <skos:exactMatch>UMLS:C0795940</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3255"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

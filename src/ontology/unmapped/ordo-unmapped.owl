            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4288"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital ectodermal disorder characterized by vascularizing keratitis, hyperkeratotic skin lesions and hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ichthyosis hystrix Rheydt type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>KID syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">KID/HID syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratitis-ichthyosis-deafness/Hystrix-like ichthyosis-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratitis-ichthyosis-hearing loss/Hystrix-like ichthyosis-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Senter syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>KID syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q80.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.2</skos:broadMatch>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_163976 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_163976">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181441"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, syndromic intellectual disability characterized by developmental delay, mild to moderate intellectual disability, low birth weight, moderate to severe short stature, microcephaly and variable hypergonadotropic hypogonadism. Mild facial dismorphism include upslanted palpebral fissures and prominent nasal bridge.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked intellectual disability, Van Esch type</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked intellectual disability, Van Esch type</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90</skos:broadMatch>
        <skos:exactMatch>MONDO:0015601</skos:exactMatch>
        <skos:exactMatch>OMIM:301030</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305072</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_163976"/>

        <skos:narrowMatch>OMIM:612555</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613399</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614291</skos:narrowMatch>
    </owl:Class>

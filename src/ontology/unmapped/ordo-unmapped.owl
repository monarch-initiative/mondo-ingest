            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic, syndromic glomerular disorder characterized by the association of progressive glomerular nephropathy and 46,XY complete gonadal dysgenesis with a high risk of developing gonadoblastoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Frasier syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Frasier syndrome</rdfs:label>

        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1787"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial atypical multiple mole melanoma (FAMMM) syndrome is an inherited genodermatosis characterized by the presence of multiple melanocytic nevi (often &gt;50) and a family history of melanoma as well as, in a subset of patients, an increased risk of developing pancreatic cancer and other malignancies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">B-K mole syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FAMM-PC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FAMMM syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial atypical mole syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial atypical multiple mole melanoma syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial atypical multiple mole melanoma-pancreatic carcinoma syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial dysplastic nevus syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Melanoma-pancreatic cancer syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial atypical multiple mole melanoma syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:C43.9</skos:broadMatch>
        <skos:exactMatch>MONDO:0018453</skos:exactMatch>
        <skos:exactMatch>UMLS:C2314896</skos:exactMatch>

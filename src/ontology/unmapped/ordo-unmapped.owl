        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Odontoma-dysphagia syndrome is a malformation syndrome, characterized by odontomas (undifferentiated mass of the esophagus) and severe dysphagia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bader syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Odontomatosis-aortae esophagus stenosis syndrome</oboInOwl:hasExactSynonym>

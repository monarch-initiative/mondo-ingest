    <!-- http://www.orpha.net/ORDO/Orphanet_1070 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1070">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163588"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A fish-borne zoonosis caused by the ingestion of third stage larvae of nematodes belonging to the genus &lt;i&gt;Anisakis&lt;/i&gt;, present in fish or cephalopods. Following its penetration in the human gastrointestinal tract, the parasite can cause gastrointestinal classified as acute (manifesting as abdominal pain, diarrhea, nausea and vomiting), chronic, or ectopic reactions or allergic manifestations (urticaria, angioedema, anaphylactic shock).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anisakiasis</oboInOwl:hasExactSynonym>
        <rdfs:label>Anisakiasis</rdfs:label>
        <skos:exactMatch>ICD-10:B81.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:1F61</skos:exactMatch>
        <skos:exactMatch>MONDO:0015200</skos:exactMatch>
        <skos:exactMatch>MeSH:D017129</skos:exactMatch>
        <skos:exactMatch>MedDRA:10002533</skos:exactMatch>
        <skos:exactMatch>UMLS:C0162576</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1070"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

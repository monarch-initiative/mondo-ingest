                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/34382"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A pure form of hereditary spastic paraplegia characterized by onset in adolescence or early adulthood of slowly progressive spastic paraplegia, proximal muscle weakness of the lower extremities and small hand muscles, hyperreflexia, spastic gait and mild urinary compromise.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant spastic paraplegia type 41</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG41</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant spastic paraplegia type 41</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0013239</skos:exactMatch>
        <skos:exactMatch>OMIM:613364</skos:exactMatch>
        <skos:exactMatch>UMLS:C3888208</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_320355"/>

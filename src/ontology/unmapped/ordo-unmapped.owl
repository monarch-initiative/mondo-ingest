        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <obo:IAO_0000115 xml:lang="en">Caudal duplication (CD) is a rare developmental anomaly in which structures derived from the embryonic cloaca and notochord are duplicated to varying extents.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Caudal duplication</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dipygus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Split notochord syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Caudal duplication</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_637 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_637">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522548"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_634518"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7773"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited cancer-predisposing syndrome disorder characterized by the development of multiple schwannomas, meningiomas and ependymoma. Schwannomas typically affect both vestibular nerves but also other cranial and peripheral nerves, leading to tinnitus, hearing loss and balance dysfunction. Intradermal schwannomas and ocular involvement (cataract, retinal hamartoma) are also typical.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Full NF2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Full NF2-related schwannomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Full neurofibromatosis type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nonmosaic NF2-related schwannomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nonmosaic neurofibromatosis type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Full NF2-related schwannomatosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q85.0</skos:broadMatch>

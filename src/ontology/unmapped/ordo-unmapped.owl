    <!-- http://www.orpha.net/ORDO/Orphanet_217656 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_217656">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_247"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_300755"/>

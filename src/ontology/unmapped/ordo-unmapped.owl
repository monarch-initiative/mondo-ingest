    <!-- http://www.orpha.net/ORDO/Orphanet_730421 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_730421">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183530"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18141"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/28396"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare ciliopathy characterized by the association of nephronophthisis and liver fibrosis. Renal manifestations include chronic renal failure, polyuria, polydipsia, anemia, as well as increased echogenicity on renal ultrasound and interstitial fibrosis and tubular dilation on biopsy. Hepatic involvement manifests as hepatosplenomegaly with extensive fibrosis, destruction of the bile ducts, and cholestasis. Mild psychomotor retardation and ocular symptoms, such as strabismus, nystagmus, retinal degeneration, and anisocoria, have been reported in some patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Boichis disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nephronophthisis-hepatic fibrosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Senior-Boichis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Senior-Boichis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q61.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB8Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019394</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274018</skos:exactMatch>
        <skos:narrowMatch>OMIM:613550</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616217</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_84081"/>

        <skos:exactMatch>MONDO:0010907</skos:exactMatch>
        <skos:exactMatch>MeSH:C563467</skos:exactMatch>
        <skos:exactMatch>OMIM:600627</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931837</skos:exactMatch>
    </owl:Class>

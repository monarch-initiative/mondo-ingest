    <!-- http://www.orpha.net/ORDO/Orphanet_500095 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_500095">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3705"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare overgrowth syndrome associated with multiple congenital anomalies characterized by tall stature, large hands and feet with large thumbs and halluces, spatulate digits, developmental delay and facial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Tall stature-intellectual disability-renal anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Thauvin-Robinet-Faivre syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Tall stature-intellectual disability-renal anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2C</skos:broadMatch>
        <skos:exactMatch>MONDO:0014918</skos:exactMatch>
        <skos:exactMatch>OMIM:617107</skos:exactMatch>
        <skos:exactMatch>UMLS:C4310715</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_500095"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

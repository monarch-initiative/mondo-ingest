        <skos:narrowMatch>ICD-10:D57.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:3A51.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:3A51.2</skos:narrowMatch>
    </owl:Class>

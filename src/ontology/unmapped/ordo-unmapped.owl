        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <obo:IAO_0000115 xml:lang="en">A very rare syndrome characterized by intellectual deficit, horseshoe kidney, and congenital heart defects.</obo:IAO_0000115>

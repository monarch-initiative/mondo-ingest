    <!-- http://www.orpha.net/ORDO/Orphanet_254509 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_254509">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1267"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">Iatrogenic botulism is the most recent man-made form of botulism, a rare acquired neuromuscular junction disease with descending flaccid paralysis caused by botulinum neurotoxins (BoNTs), and it may occur as an adverse event after therapeutic or cosmetic use.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Iatrogenic botulism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inadvertent botulism</oboInOwl:hasExactSynonym>
        <rdfs:label>Iatrogenic botulism</rdfs:label>
        <skos:broadMatch>ICD-10:A05.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:1A11.1</skos:broadMatch>

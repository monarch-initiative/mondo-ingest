    <!-- http://www.orpha.net/ORDO/Orphanet_95232 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95232">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

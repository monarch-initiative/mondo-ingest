        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182070"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183500"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309515"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8957"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurodegenerative disease characterized by progressive neurodegeneration, cutaneous abnormalities, including varying degrees of ichthyosis or seborrheic dermatitis, and systemic iron overload. Patients manifest with infantile-onset seizures, encephalopathy, abnormal eye movements, axial hypotonia with peripheral hypertonia, brisk reflexes, cortical blindness and deafness, myoclonus and hepato/splenomegaly, as well as oral manifestations, including microdontia, widely spaced and pointed teeth with delayed eruption, and gingival overgrowth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cerebro-cutaneous syndrome with iron overload</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ferro-cerebro-cutaneous syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ferro-cerebro-cutaneous syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G31.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0018346</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751570</skos:exactMatch>
        <skos:narrowMatch>OMIM:301072</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_397922"/>

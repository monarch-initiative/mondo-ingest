        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.F</skos:broadMatch>
        <skos:broadMatch>OMIM:613406</skos:broadMatch>
        <skos:exactMatch>MONDO:0013256</skos:exactMatch>
        <skos:exactMatch>MeSH:C579849</skos:exactMatch>
        <skos:exactMatch>UMLS:C3697269</skos:exactMatch>
    </owl:Class>

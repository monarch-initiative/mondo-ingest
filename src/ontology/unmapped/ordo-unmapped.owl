        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare, genetic, progressive muscular dystrophies, including Duchenne muscular dystrophy (DMD), Becker muscular dystrophy (BMD) and a symptomatic form in female carriers. The diseases represent a spectrum of severity ranging from progressive skeletal and cardiac muscle wasting and weakness (DMD, BMD) to less severe muscle weakness or isolated cardiomyopathy affecting carrier females.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Duchenne and Becker muscular dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe dystrophinopathy, Duchenne and Becker type</oboInOwl:hasExactSynonym>
        <rdfs:label>Duchenne and Becker muscular dystrophy</rdfs:label>
        <skos:exactMatch>MONDO:16899</skos:exactMatch>
        <skos:exactMatch>UMLS:C3542021</skos:exactMatch>
    </owl:Class>

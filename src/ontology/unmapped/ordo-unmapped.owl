    <!-- http://www.orpha.net/ORDO/Orphanet_2558 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2558">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181441"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome with hypergonadotropic hypogonadism characterized by microcephaly, hypergonadotropic hypogonadism, short stature and facial dysmorphism (including a narrow forehead, synophrys, abnormally folded pinna, and micrognathia). Early teeth loss, gynecomastia, cubitus valgus, genu valgum and cryptorchidism were reported in some patients. There have been no further descriptions in the literature since 1985.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Microcephaly-hypergonadotropic hypogonadism-short stature syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mikati-Najjar-Sahli syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Mikati-Najjar-Sahli syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0016818</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518578</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2558"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mikati-Najjar-Sahli syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_256 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_256">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_376724"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3098"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9437"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare movement disorder characterized by involuntary, repetitive, sustained muscle contractions or postures that typically begins in a single limb and, in most individuals, followed by progressive involvement of other limbs and the trunk, typically sparing the cranial and cervical region.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dystonia musculorum deformans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EOTD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early-onset generalized limb-onset dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset generalized torsion dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset isolated dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset primary dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset torsion dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic torsion dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oppenheim dystonia</oboInOwl:hasExactSynonym>
        <rdfs:label>Early-onset generalized limb-onset dystonia</rdfs:label>
        <skos:broadMatch>ICD-11:8A02.0Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:G24.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0007492</skos:exactMatch>
        <skos:exactMatch>MedDRA:10076668</skos:exactMatch>
        <skos:exactMatch>UMLS:C3888090</skos:exactMatch>
        <skos:narrowMatch>OMIM:128100</skos:narrowMatch>
        <skos:narrowMatch>OMIM:602554</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619687</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_256"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Early-onset generalized limb-onset dystonia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2560 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2560">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181387"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic neurological disorder characterized by the association of Möbius syndrome (congenital facial palsy with impaired ocular abduction) with peripheral axonal neuropathy and hypogonadotropic hypogonadism. There have been no further descriptions in the literature since 1996.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Moebius syndrome-axonal neuropathy-hypogonadotropic hypogonadism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Moebius syndrome-axonal neuropathy-hypogonadotropic hypogonadism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0016819</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931024</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2560"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Moebius syndrome-axonal neuropathy-hypogonadotropic hypogonadism syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2561 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2561">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139042"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183580"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by a variable combination of dental, cutaneous, ocular, and bone abnormalities, including pyramidal and fused molar roots, taurodontism, an abnormal upper lip without a cupid&apos;s bow and thickened and wide philtrum, juvenile glaucoma, syndactyly, and clinodactyly. There have been no further descriptions in the literature since 1973.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ackerman fused molar roots syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pyramidal molars-abnormal upper lip syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Pyramidal molars-abnormal upper lip syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:K00.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0008706</skos:exactMatch>
        <skos:exactMatch>MeSH:C538170</skos:exactMatch>
        <skos:exactMatch>OMIM:200970</skos:exactMatch>
        <skos:exactMatch>UMLS:C1860167</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2561"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pyramidal molars-abnormal upper lip syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2563 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2563">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_240371"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">MOMO syndrome is a very rare genetic overgrowth/obesity syndrome characterized by macrocephaly, obesity, mental (intellectual) disability and ocular abnormalities. Other frequent clinical signs include macrosomia, downslanting palpebral fissures, hypertelorism, broad nasal root, high and broad forehead and delay in bone maturation, in association with normal thyroid function and karyotype.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MOMO syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Macrocephaly-obesity-intellectual disability-ocular abnormalities syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Macrosomia-obesity-macrocephaly-ocular abnormalities syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>MOMO syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2C</skos:broadMatch>
        <skos:exactMatch>MONDO:0008008</skos:exactMatch>
        <skos:exactMatch>MeSH:C535812</skos:exactMatch>
        <skos:exactMatch>OMIM:157980</skos:exactMatch>
        <skos:exactMatch>UMLS:C1834759</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2563"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>MOMO syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2564 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2564">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294955"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404574"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Tetramelic monodactyly is a rare, genetic, congenital limb malformation disorder characterized by the presence of a single digit on all four extremities. Malformation is typically isolated however, aplastic and hypoplastic defects in the remaining skeletal parts of hands and feet have been reported. There have been no further descriptions in the literature since 1992.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Sommer-Hines syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tetramelic monodactyly</oboInOwl:hasExactSynonym>
        <rdfs:label>Tetramelic monodactyly</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008544</skos:exactMatch>
        <skos:exactMatch>MeSH:C566066</skos:exactMatch>
        <skos:exactMatch>OMIM:187510</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861233</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2564"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Tetramelic monodactyly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2565 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2565">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498451"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysostosis with brachydactyly without extraskeletal manifestations characterized by skeletal dysplasia associated with finger malformations (brachydactyly with short and abducted thumbs, short index fingers, and markedly short and abducted great toes), variable mild short stature, and mild bowleg with fibular overgrowth. Females were reported to exhibit phenotypic variation and be less severely affected than males who were similarly affected. There have been no further descriptions in the literature since 1992.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mononen-Karnes-Senac syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Skeletal dysplasia-brachydactyly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Mononen-Karnes-Senac syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0010538</skos:exactMatch>
        <skos:exactMatch>MeSH:C535914</skos:exactMatch>
        <skos:exactMatch>OMIM:301940</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931060</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2565"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mononen-Karnes-Senac syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2566 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2566">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163585"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Chronic Epstein-Barr virus infection syndrome is a rare infectious disease characterized by familial, primary, chronic Epstein-Barr virus infection which typically manifests with persistent mononucleosis-like signs and symptoms, in the absence of secondary immunodeficiency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CAEBV syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chronic EBV infection syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic Epstein-Barr virus infection syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Chronic Epstein-Barr virus infection syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:B27.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:1D81.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0009194</skos:exactMatch>
        <skos:exactMatch>OMIM:226990</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751209</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genodermatosis characterized by the presence of the mixture of hyperpigmented and hypopigmented macules of approximately 5mm in diameter, principally located on the extremities.</obo:IAO_0000115>

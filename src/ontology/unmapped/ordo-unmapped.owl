        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6172"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">STT3A-CDG is a form of congenital disorders of N-linked glycosylation characterized by developmental delay, intellectual disability, failure to thrive, hypotonia and seizures. STT3A-CDG is caused by mutations in the gene &lt;i&gt;STT3A&lt;/i&gt; (11q23.3).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type Iw</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG-Iw</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG1W</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 1w</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type Iw</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>STT3A-CDG</oboInOwl:hasExactSynonym>
        <rdfs:label>STT3A-CDG</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C54.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0014270</skos:exactMatch>
        <skos:exactMatch>OMIM:615596</skos:exactMatch>
        <skos:exactMatch>UMLS:C3810062</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, syndromic intellectual disability characterized by intrauterine growth retardation, microcephaly, hypotonia, motor and neurodevelopmental delay, speech delay, intellectual disability, and mild dysmorphic features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>19p13.3 microduplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dup(19)(p13.3)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dup(19)(p13.3)</oboInOwl:hasExactSynonym>
        <rdfs:label>19p13.3 microduplication syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0018658</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679996</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_3294 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3294">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_109009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404577"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Extensor tendons of finger anomalies is a rare, genetic, congenital limb malformation characterized by bilateral anomalous attachment of the extensor tendons of the four ulnar fingers. Attachment occurrs to the medial and lateral aspects of the middle phalanges leading to constant flexion in the midphalangeal joints and inability to extend the fingers. There have been no further descriptions in the literature since 1980.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Extensor tendons of finger anomalies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hapnes-Boman-Skeie syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Extensor tendons of finger anomalies</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008540</skos:exactMatch>
        <skos:exactMatch>MeSH:C536960</skos:exactMatch>
        <skos:exactMatch>OMIM:187390</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931376</skos:exactMatch>
    </owl:Class>

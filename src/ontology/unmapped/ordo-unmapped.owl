    <!-- http://www.orpha.net/ORDO/Orphanet_434179 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_434179">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140997"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269528"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/24564"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental disorder of the ciliopathy group characterized by oral, facial and digital malformations associated with microcephaly and cerebral malformations such as corpus callosum agenesis and vermis hypoplasia with molar tooth sign. Oral manifestations include gingival frenulae, lingual hamartomas, cleft/lobulated tongue and a cleft palate. Facial features can include telecanthus and an upslanting palpebral fissures. Digital malformations encompass hands postaxial polydactyly and duplication of the hallux.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Microcephaly-cerebral malformation-orofaciodigital syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OFD14</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oral-facial-digital syndrome type 14</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Orofaciodigital syndrome type 14</oboInOwl:hasExactSynonym>
        <rdfs:label>Orofaciodigital syndrome type 14</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD25.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0014413</skos:exactMatch>
        <skos:exactMatch>OMIM:615948</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706604</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_434179"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Orofaciodigital syndrome type 14</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



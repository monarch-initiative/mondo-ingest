    <!-- http://www.orpha.net/ORDO/Orphanet_1546 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1546">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163591"/>

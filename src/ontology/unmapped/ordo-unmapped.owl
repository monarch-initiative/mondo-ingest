    <!-- http://www.orpha.net/ORDO/Orphanet_71277 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_71277">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225713"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693802"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79178"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism characterized by encephalopathy due to impaired glucose transport into neural cells. The most frequent clinical manifestations are epilepsy, intellectual disability and movement disorder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic GLUT1 deficiency syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic GLUT1-DS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Classic glucose transporter type 1 deficiency syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">De Vivo disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Encephalopathy due to GLUT1 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Classic glucose transporter type 1 deficiency syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E74.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C61.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0011724</skos:exactMatch>
        <skos:exactMatch>OMIM:606777</skos:exactMatch>
        <skos:exactMatch>UMLS:C4551966</skos:exactMatch>
    </owl:Class>

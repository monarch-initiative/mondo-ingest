    <!-- http://www.orpha.net/ORDO/Orphanet_492 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_492">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <obo:IAO_0000115 xml:lang="en">A rare large, multinodular, usually benign, tumor that is generally located in the posterior part of the scalp in aged women (over 50 years). It first appears as a painless nodule that later grows into a solid or partially cystic tumor that is mobile over the underlying subcutaneous tissues. It can present ulceration, inflammation or even bleeding and can cause necrosis of the adjacent tissues.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Proliferating trichilemmal cyst</oboInOwl:hasExactSynonym>
        <rdfs:label>Proliferating trichilemmal cyst</rdfs:label>
        <skos:broadMatch>ICD-10:L72.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:EK70.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:XH7WJ7</skos:exactMatch>
        <skos:exactMatch>MONDO:0018850</skos:exactMatch>
        <skos:exactMatch>UMLS:C2959585</skos:exactMatch>
    </owl:Class>

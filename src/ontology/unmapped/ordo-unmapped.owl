            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Lethal left ventricular non-compaction-seizures-hypotonia-cataract-developmental delay syndrome is rare, genetic, neurometabolic disease characterized by global developmental delay, severe hypotonia, seizures, cataracts, cardiomyopathy (including left or bi-ventricular hypertrophy, dilated cardiomyopathy) and left ventricular non-compaction, typically resulting in infantile or early-childhood death. Patients usually present metabolic lactic acidosis, failure to thrive, head lag, respiratory problems and decrease in respiratory chain complex activity. Highly variable cerebral abnormalities have been reported and include microcephaly, prominent extra-axial cerebrospinal fluid spaces, diffuse neuronal loss and cortical/white matter gliosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lethal left ventricular non-compaction-seizures-hypotonia-cataract-developmental delay syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lethal left ventricular non-compaction-seizures-hypotonia-cataract-developmental delay syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5D0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0014976</skos:exactMatch>
        <skos:exactMatch>OMIM:617228</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567603</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_478049"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lethal left ventricular non-compaction-seizures-hypotonia-cataract-developmental delay syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_478664 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_478664">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140477"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

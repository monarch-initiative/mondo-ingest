            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare distal arthrogryposis syndrome characterized by multiple pterygia (typically involving the neck, axilla and popliteal areas), joint contractures, ptosis, camptodactyly of the hands with hypoplastic flexion creases, vertebral fusions, severe scoliosis and short stature.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant multiple pterygium syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal arthrogryposis type 8</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant multiple pterygium syndrome</rdfs:label>

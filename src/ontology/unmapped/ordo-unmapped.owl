        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_573278"/>
        <obo:IAO_0000115 xml:lang="en">A rare subtype of split cord malformation characterized by each hemicord contained in its own dural sac, typically with a intervening bony septum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diastematomyelia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCM type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCM type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Split cord malformation type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Split cord malformation type I</oboInOwl:hasExactSynonym>
        <rdfs:label>Split cord malformation type I</rdfs:label>
        <skos:broadMatch>ICD-11:LA07.1</skos:broadMatch>

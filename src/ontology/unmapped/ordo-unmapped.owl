            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare metabolic liver disease characterized clinically by a benign, chronic, predominantly conjugated hyperbilirubinemia, and histopathologically by black-brown pigment deposition in parenchymal liver cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dubin-Johnson syndrome</oboInOwl:hasExactSynonym>

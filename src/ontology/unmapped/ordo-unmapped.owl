    <!-- http://www.orpha.net/ORDO/Orphanet_90318 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90318">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C053"/>

        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9453"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of proline metabolism characterized biochemically by markedly elevated levels of proline in plasma and urine due to deficiency of proline oxidase. The reported clinical phenotype ranges from asymptomatic to variable neurologic and psychiatric manifestations (including global developmental delay, seizures, autistic features, and hyperactivity).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hyperprolinemia type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Proline oxidase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperprolinemia type 1</rdfs:label>
        <skos:broadMatch>ICD-10:E72.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009400</skos:exactMatch>
        <skos:exactMatch>MedDRA:10058513</skos:exactMatch>
        <skos:exactMatch>OMIM:239500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268529</skos:exactMatch>
    </owl:Class>

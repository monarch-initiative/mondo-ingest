        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Duane retraction syndrome with congenital deafness</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_529665 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_529665">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4446"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, syndromic intellectual disability characterized by global developmental delay, early-onset seizures, cerebellar atrophy, osteopenia, nystagmus and dysmorphic facial features, including bitemporal narrowing, prominent forehead, anteverted nares. Dysarthria, dysmetria, ataxic gait, spasticity and dysmorphic features have also been associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GPAA1-related biosynthesis defect</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neurodevelopmental delay-seizures-ophthalmic anomalies-osteopenia-cerebellar atrophy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Neurodevelopmental delay-seizures-ophthalmic anomalies-osteopenia-cerebellar atrophy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0060627</skos:exactMatch>
        <skos:exactMatch>OMIM:617810</skos:exactMatch>
        <skos:exactMatch>UMLS:C4540520</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_529665"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neurodevelopmental delay-seizures-ophthalmic anomalies-osteopenia-cerebellar atrophy syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_529799 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_529799">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377792"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_415286"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by lethargy, hypotonia, poor feeding, opisthotonus, and a typical high-pitched cry due to bilirubin accumulation in the globus pallidus, sub-thalamic nuclei, and other brain regions, resulting from severe neonatal unconjugated hyperbilirubinemia. Onset of symptoms is typically within the first three to five days of life. Additional features include fever, apnea, seizures, and coma. Especially respiratory failure or refractory seizures may lead to a fatal outcome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ABE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acute bilirubin encephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acute kernicterus</oboInOwl:hasExactSynonym>
        <rdfs:label>Acute bilirubin encephalopathy</rdfs:label>
        <skos:broadMatch>ICD-10:P57.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:KA86</skos:broadMatch>
        <skos:exactMatch>MONDO:0035344</skos:exactMatch>
        <skos:exactMatch>UMLS:C5671282</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_529799"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Acute bilirubin encephalopathy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_529808 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_529808">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377792"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_415286"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by the chronic consequences of bilirubin toxicity in the globus pallidus, sub-thalamic nuclei, and other brain regions, after exposure to high levels of unconjugated bilirubin in the neonatal period. Symptoms begin after the acute phase of bilirubin encephalopathy in the first year of life, evolve slowly over several years, and include mild to severe extrapyramidal disturbances (especially dystonia and athetosis), auditory neuropathy spectrum disorder, and oculomotor and dental abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BIND</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bilirubin-induced neurological dysfunction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CBE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic bilirubin encephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">KSD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Kernicterus spectrum disorder</oboInOwl:hasExactSynonym>
        <rdfs:label>Chronic bilirubin encephalopathy</rdfs:label>
        <skos:broadMatch>ICD-10:P57.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:KA86</skos:broadMatch>
        <skos:exactMatch>MONDO:0035345</skos:exactMatch>
        <skos:exactMatch>UMLS:C5575229</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_529808"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Chronic bilirubin encephalopathy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



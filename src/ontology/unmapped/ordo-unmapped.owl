    <!-- http://www.orpha.net/ORDO/Orphanet_586130 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_586130">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_576356"/>
        <obo:IAO_0000115 xml:lang="en">A rare sporadic human prion disease characterized by adult onset of progredient neurodegeneration presenting as a combination of psychiatric, sleep, and oculomotor disturbances, with development of progressive cognitive impairment (the predominantly affected cognitive domains being memory, temporal and/or spatial orientation, language, executive functions, and attention), postural instability, and sometimes additional motor abnormalities and autonomic hyperactivity, in the course of the disease. Bilateral thalamic hypometabolism on FDG-PET imaging and positive prion seeding activity in the cerebrospinal fluid are present in many cases. The disease is fatal within typically two to three years.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Sporadic fatal insomnia</oboInOwl:hasExactSynonym>
        <rdfs:label>Sporadic fatal insomnia</rdfs:label>
        <skos:broadMatch>ICD-10:A81.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:6D85.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0035614</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567889</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_586130"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Sporadic fatal insomnia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



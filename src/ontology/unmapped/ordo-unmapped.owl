            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Testicular seminomatous germ cell tumor is a rare testicular germ cell tumor, most commonly presenting with a painless mass in the scrotum, with a very high cure rate if caught in the early stages.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Seminoma of testis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Seminomatous germ cell tumor of testis</oboInOwl:hasExactSynonym>

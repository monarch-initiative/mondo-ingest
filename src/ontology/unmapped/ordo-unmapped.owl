    <!-- http://www.orpha.net/ORDO/Orphanet_431149 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_431149">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140162"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

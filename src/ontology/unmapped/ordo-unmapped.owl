            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic metabolic disorder due to pyruvate kinase deficiency characterized by a variable degree of chronic nonspherocytic hemolytic anemia resulting in a variable clinical manifestations ranging from fatal anemia at birth to a to a fully compensated hemolysis without apparent anemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hemolytic anemia due to red cell pyruvate kinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pyruvate kinase deficiency of erythrocytes</oboInOwl:hasExactSynonym>
        <rdfs:label>Hemolytic anemia due to red cell pyruvate kinase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D55.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009950</skos:exactMatch>

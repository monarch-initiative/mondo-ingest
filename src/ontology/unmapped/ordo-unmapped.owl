    <!-- http://www.orpha.net/ORDO/Orphanet_231237 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231237">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_275749"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

        <oboInOwl:hasExactSynonym xml:lang="en">Mucopolysaccharidosis type IS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Scheie syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Scheie syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E76.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.30</skos:broadMatch>

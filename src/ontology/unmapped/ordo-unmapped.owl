        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79355"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/554"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/559"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of copper metabolism characterized by intellectual deficit, enteropathy, sensorineural hearing loss, peripheral neuropathy, lamellar and erythrodermic ichthyosis, and keratodermia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Intellectual disability-enteropathy-deafness-peripheral neuropathy-ichthyosis-keratodermia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intellectual disability-enteropathy-hearing loss-peripheral neuropathy-ichthyosis-keratodermia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MEDNIK syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>MEDNIK syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E83.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012251</skos:exactMatch>
        <skos:exactMatch>OMIM:609313</skos:exactMatch>
        <skos:exactMatch>UMLS:C1836330</skos:exactMatch>
    </owl:Class>

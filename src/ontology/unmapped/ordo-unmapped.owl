    <!-- http://www.orpha.net/ORDO/Orphanet_2690 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2690">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_331184"/>

        <obo:IAO_0000115 xml:lang="en">A rare familial renal cancer syndrome characterized by a predisposition for developing bilateral and multifocal classic type papillary renal cell carcinomas (formerly known as type 1 papillary renal cell carcinoma until the 2022 WHO classification of renal tumors).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HPRC</oboInOwl:hasExactSynonym>

        <skos:exactMatch>MeSH:C536011</skos:exactMatch>
        <skos:exactMatch>MedDRA:10036669</skos:exactMatch>
        <skos:exactMatch>UMLS:C0859976</skos:exactMatch>
        <skos:narrowMatch>OMIM:200400</skos:narrowMatch>
    </owl:Class>

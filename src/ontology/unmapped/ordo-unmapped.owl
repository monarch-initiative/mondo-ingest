    <!-- http://www.orpha.net/ORDO/Orphanet_C041 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_C041">
        <obo:IAO_0000115 xml:lang="en">A clinical entity that has been excluded from the Orphanet nomenclature. This includes obsolete entities, deprecated entities, and entities that have been inactivated because they are not rare in Europe.</obo:IAO_0000115>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557866"/>
        <obo:IAO_0000115 xml:lang="en">Hirschsprung disease-type D brachydactyly syndrome is characterized by Hirschsprung disease and absence or hypoplasia of the nails and distal phalanges of the thumbs and great toes (type D brachydactyly). It has been described in four males from one family (two brothers and two maternal uncles). Transmission appears to be X-linked recessive but autosomal dominant inheritance with incomplete penetrance in females can not be ruled out.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hirschsprung disease-type D brachydactyly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hirschsprung disease-type D brachydactyly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q43.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0016294</skos:exactMatch>
        <skos:exactMatch>MeSH:C538319</skos:exactMatch>
        <skos:exactMatch>OMIM:306980</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303481</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2150"/>

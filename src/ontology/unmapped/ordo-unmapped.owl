        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation syndrome characterized by the association of facial and skeletal anomalies with severe intellectual deficit and occasional genitourinary anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Acrofrontofacionasal dysostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Richieri-Costa-Colletto syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Acrofrontofacionasal dysostosis</rdfs:label>

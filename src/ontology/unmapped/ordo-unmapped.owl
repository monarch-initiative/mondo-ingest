        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_527450 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_527450">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139030"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93441"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15808"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect with connective tissue involvement characterized by joint hyperextensibility and multiple dislocations of large joints, severe myopia, and short stature. Other common features include retinal detachment, iris and chorioretinal coloboma, kyphoscoliosis and other spine deformities, pectus carinatum, talipes equinovarus, and progressive hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Severe myopia-generalized joint laxity-short stature syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe myopia-generalized joint laxity-short stature syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.E</skos:broadMatch>
        <skos:exactMatch>MONDO:0060556</skos:exactMatch>
        <skos:exactMatch>OMIM:617662</skos:exactMatch>
        <skos:exactMatch>UMLS:C4540020</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_527450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Severe myopia-generalized joint laxity-short stature syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_527468 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_527468">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108969"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108973"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180779"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_459787"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_471383"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4978"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic multiple congenital anomalies/dysmorphic syndrome characterized by congenital diaphragmatic hernia, short bowel, and asplenia. Dysmorphic facial features include long forehead, hypertelorism, upturned nares, and small mandible. Atresia of the duodenum has also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Diaphragmatic hernia-short bowel-asplenia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Diaphragmatic hernia-short bowel-asplenia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0035105</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681454</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_527468"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Diaphragmatic hernia-short bowel-asplenia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_527497 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_527497">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_316240"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68356"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19321"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare leukodystrophy characterized by a spectrum of progressive neurologic manifestations comprising rapidly progressive early-onset nystagmus, spastic tetraplegia, and visual and hearing impairment, resulting in death in early childhood, as well as later onset of slowly progressive complex spastic ataxia with pyramidal and cerebellar symptoms and loss of developmental milestones. Brain imaging shows diffuse hypomyelination of the subcortical and deep white matter, cerebellar atrophy, and diffuse spinal cord volume loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive hypomyelinating leukodystrophy-progressive spastic ataxia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>NKX6-2-related autosomal recessive hypomyelinating leukodystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPAX8</oboInOwl:hasExactSynonym>
        <rdfs:label>NKX6-2-related autosomal recessive hypomyelinating leukodystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:E75.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0033043</skos:exactMatch>
        <skos:exactMatch>OMIM:617560</skos:exactMatch>
        <skos:exactMatch>UMLS:C4479653</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_527497"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>NKX6-2-related autosomal recessive hypomyelinating leukodystrophy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_52759 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_52759">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68362"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98023"/>
        <obo:IAO_0000115 xml:lang="en">Vasculitis represents a clinically heterogenous group of diseases of multifactorial etiology characterized by inflammation of either large-sized vessels (large-vessel vasculitis, e.g. Giant-cell arteritis and Takayasu arteritis), medium-sized vessels (medium-vessel vasculitis e.g. polyarteritis nodosa and Kawasaki disease), or small-sized vessels (small-vessel vasculitis, e.g. granulomatosis with polyangiitis, microscopic polyangiitis, immunoglobulin A vasculitis, and cutaneous leukocytoclastic angiitis). Vasculitis occurs at any age, may be acute or chronic, and manifests with general symptoms such as fever, weight loss and fatigue, as well as more specific clinical signs depending on the type of vessels and organs affected. The degree of severity is variable, ranging from life or sight threatening disease (e.g. Behçet disease) to relatively minor skin disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Systemic vasculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vasculitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Vasculitis</rdfs:label>
        <skos:exactMatch>ICD-11:4A44</skos:exactMatch>
        <skos:exactMatch>MONDO:0018882</skos:exactMatch>
        <skos:exactMatch>MONDO:18882</skos:exactMatch>
        <skos:exactMatch>MeSH:D014657</skos:exactMatch>
        <skos:exactMatch>MedDRA:10047115</skos:exactMatch>
        <skos:exactMatch>UMLS:C0042384</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_52759"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Vasculitis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_528 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_528">

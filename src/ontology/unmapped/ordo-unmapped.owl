    <!-- http://www.orpha.net/ORDO/Orphanet_79434 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79434">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_352731"/>

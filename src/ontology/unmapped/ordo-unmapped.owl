        <skos:broadMatch>ICD-11:5A73</skos:broadMatch>
        <skos:exactMatch>MONDO:0018541</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275180</skos:exactMatch>
        <skos:narrowMatch>OMIM:203400</skos:narrowMatch>
        <skos:narrowMatch>OMIM:606984</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610600</skos:narrowMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_139471 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139471">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

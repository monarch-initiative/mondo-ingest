        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of renal agenesis characterized by the complete absence of development of one kidney accompanied by an absent ureter.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Renal agenesis, unilateral</oboInOwl:hasExactSynonym>

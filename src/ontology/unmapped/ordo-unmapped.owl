    <!-- http://www.orpha.net/ORDO/Orphanet_363717 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363717">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_3240 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3240">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_314822"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_696870"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6215"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurological disorder characterized by early-onset progressive leukoencephalopathy, severe developmental delay, early-onset or congenital deafness (only few cases reported without hearing loss), and visual impairment. All patients manifest calcifications in brain and spinal cord. Cognitive impairment, seizures, hypotonia, spastic tetraplegia or quadriplegia are observed in the majority of the patients. Variable features may include microcephaly and anemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Early onset progressive leukoencephalopathy- central nervous system calcification- hearing loss-visual impairment syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early-onset progressive leukoencephalopathy-central nervous system calcification-deafness-visual impairment syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Early-onset progressive leukoencephalopathy-central nervous system calcification-deafness-visual impairment syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G93.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017924</skos:exactMatch>
        <skos:exactMatch>OMIM:619147</skos:exactMatch>
        <skos:exactMatch>UMLS:C5925004</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3240"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Early-onset progressive leukoencephalopathy-central nervous system calcification-deafness-visual impairment syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3241 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3241">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">Deafness-craniofacial syndrome is characterised by the association of congenital hearing loss and facial dysmorphism (facial asymmetry, a broad nasal root and small nasal alae). It has been described in two members (father and daughter) of one Jewish family. Temporal alopecia was also noted. Transmission appeared to be autosomal dominant.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Deafness-craniofacial syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hearing loss-craniofacial syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Deafness-craniofacial syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007428</skos:exactMatch>
        <skos:exactMatch>MeSH:C565118</skos:exactMatch>
        <skos:exactMatch>OMIM:125230</skos:exactMatch>
        <skos:exactMatch>UMLS:C1852278</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3241"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Deafness-craniofacial syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3242 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3242">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Renpenning syndrome is an X-linked intellectual disability syndrome (XLMR) characterized by intellectual deficiency, microcephaly, leanness and mild short stature.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Renpenning syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked intellectual disability due to PQBP1 mutations</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked intellectual disability, Renpenning type</oboInOwl:hasExactSynonym>
        <rdfs:label>Renpenning syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010653</skos:exactMatch>
        <skos:exactMatch>OMIM:309500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796135</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

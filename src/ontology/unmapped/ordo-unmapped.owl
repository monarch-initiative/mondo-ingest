    <!-- http://www.orpha.net/ORDO/Orphanet_2177 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2177">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269190"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17619"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare cerebral malformation characterized by an almost or complete lack of cortex, specifically the cerebral hemispheres, with the cranium and meninges completely intact. In most cases, death occurs in utero or in the first weeks of life. Developmental delay, drug-resistant seizures, spastic diplegia, severe growth failure, deafness and blindness are typical.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hydranencephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Hydranencephaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:broadMatch>OMIM:605013</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA05.62</skos:exactMatch>
        <skos:exactMatch>MONDO:0016344</skos:exactMatch>
        <skos:exactMatch>MeSH:D006832</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073472</skos:exactMatch>
        <skos:exactMatch>UMLS:C0020225</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2177"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hydranencephaly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



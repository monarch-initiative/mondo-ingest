    <!-- http://www.orpha.net/ORDO/Orphanet_2824 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2824">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

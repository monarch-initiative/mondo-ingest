    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1202 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1202">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156249"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_435609"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare larynx anomaly characterized by complete absence of the laryngeal lumen resulting in congenital upper airway obstruction syndrome which, without fetal or neonatal intervention, is incompatible with life. Fetal sonography shows a dilated trachea, hyperechoic lungs, pleural effusion, minimal fetal abdominal ascites or hydrops, and amniotic fluid abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Larynx atresia</oboInOwl:hasExactSynonym>
        <rdfs:label>Larynx atresia</rdfs:label>
        <skos:broadMatch>ICD-10:Q31.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA71.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007879</skos:exactMatch>
        <skos:exactMatch>OMIM:150300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265756</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1202"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Larynx atresia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1203 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1203">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108963"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108967"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, non-syndromic intestinal malformation characterized by a complete but short segment obliteration of the duodenal lumen.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Duodenal atresia</oboInOwl:hasExactSynonym>
        <rdfs:label>Duodenal atresia</rdfs:label>
        <skos:broadMatch>ICD-10:Q41.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB14</skos:broadMatch>
        <skos:exactMatch>MONDO:0009126</skos:exactMatch>
        <skos:exactMatch>MeSH:C535720</skos:exactMatch>
        <skos:exactMatch>MedDRA:10013812</skos:exactMatch>
        <skos:exactMatch>OMIM:223400</skos:exactMatch>
        <skos:exactMatch>UMLS:C0266174</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1203"/>

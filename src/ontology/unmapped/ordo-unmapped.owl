        <obo:IAO_0000115 xml:lang="en">L-2-hydroxyglutaric aciduria is a primarily neurological form of 2-hydroxyglutaric aciduria characterized by psychomotor retardation, cerebellar ataxia and variable macrocephaly or epilepsy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">L-2-HGA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">L-2-hydroxyglutaric acidemia</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of glycogen storage disease (GSD) characterized classically by exertional fatigue and muscular exercise intolerance. It occurs typically in childhood and adolescence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD due to muscle phosphofructokinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type VII</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glycogen storage disease due to muscle phosphofructokinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease type 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease type VII</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis due to muscle phosphofructokinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis type 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis type VII</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tarui disease</oboInOwl:hasExactSynonym>

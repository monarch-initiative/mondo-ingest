            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of congenital dyserythropoietic anemia characterized by anemia, jaundice, splenomegaly, gallstones, and often iron overload.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDA II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDA type 2</oboInOwl:hasExactSynonym>

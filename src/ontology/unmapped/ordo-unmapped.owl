        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_364574"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18683"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Richieri Costa-Pereira syndrome is characterized by short stature, Robin sequence, cleft mandible, pre/postaxial hand anomalies (including hypoplastic thumbs), and clubfoot. It has been described in 14 Brazilian families and in one unrelated French patient. Prominent low set ears and a highly arched palate were also observed. Transmission is autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Richieri Costa-Pereira syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Short stature-Pierre Robin sequence-cleft mandible-hand anomalies clubfoot syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Short stature-Pierre Robin syndrome-cleft mandible-hand anomalies clubfoot syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Richieri Costa-Pereira syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009998</skos:exactMatch>
        <skos:exactMatch>MeSH:C535677</skos:exactMatch>
        <skos:exactMatch>OMIM:268305</skos:exactMatch>
        <skos:exactMatch>UMLS:C1849348</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3102"/>

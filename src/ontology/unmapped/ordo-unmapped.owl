    <!-- http://www.orpha.net/ORDO/Orphanet_397787 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_397787">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_688571"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5960"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic form of primary immunodeficiency characterized by life-threatening bacterial, fungal and viral infections with the onset in infancy, and failure to thrive. Typically, hypogammaglobulinemia or agammaglobulinemia and normal levels of T and B cells are present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CID due to IKBKB deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Combined immunodeficiency due to IKBKB deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Combined immunodeficiency due to inhibitor of nuclear factor kappa B subunit beta deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined immunodeficiency due to IKBKB deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D81.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0014267</skos:exactMatch>
        <skos:exactMatch>OMIM:615592</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190593</skos:exactMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90291"/>
        <obo:IAO_0000115 xml:lang="en">Limited systemic sclerosis (lSSc) (or SSc sine scleroderma) is a subset of systemic sclerosis (SSc) characterized by organ involvement in the absence of fibrosis of the skin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Limited systemic sclerosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Systemic sclerosis sine scleroderma</oboInOwl:hasExactSynonym>

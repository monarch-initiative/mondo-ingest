                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25941"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6192"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7217"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare myeloproliferative neoplasm characterized by stem-cell derived clonal over proliferation of mature myeloid lineages, such as erythrocytes, leukocytes, and megakaryocytes, with variable degrees of megakaryocyte atypia, associated with reticulin and/or collagen bone marrow fibrosis, osteosclerosis, ineffective erythropoiesis, angiogenesis, extramedullary hematopoiesis, and abnormal cytokine expression.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Agnogenic myeloid metaplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic myelofibrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myelofibrosis with myeloid metaplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteomyelofibrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary myelofibrosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary myelofibrosis</rdfs:label>
        <skos:broadMatch>ICD-10:D47.4</skos:broadMatch>
        <skos:exactMatch>ICD-11:2A20.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0009692</skos:exactMatch>
        <skos:exactMatch>MeSH:D055728</skos:exactMatch>
        <skos:exactMatch>MedDRA:10077161</skos:exactMatch>
        <skos:exactMatch>OMIM:254450</skos:exactMatch>
        <skos:exactMatch>UMLS:C0001815</skos:exactMatch>
    </owl:Class>

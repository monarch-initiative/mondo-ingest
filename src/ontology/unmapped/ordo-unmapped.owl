    <!-- http://www.orpha.net/ORDO/Orphanet_779 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_779">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101941"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290836"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_567558"/>
        <obo:IAO_0000115 xml:lang="en">Reynolds syndrome (RS) is an autoimmune disorder characterized by the association of primary biliary cirrhosis (PBC) with limited cutaneous systemic sclerosis (lcSSc).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary biliary cirrhosis and systemic scleroderma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reynolds syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Reynolds syndrome</rdfs:label>
        <skos:broadMatch>ICD-11:4A43.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013276</skos:exactMatch>
        <skos:exactMatch>MedDRA:10070953</skos:exactMatch>
        <skos:exactMatch>OMIM:613471</skos:exactMatch>
        <skos:exactMatch>UMLS:C0748397</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_779"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98153"/>
        <obo:IAO_0000115 xml:lang="en">Maternal uniparental disomy of chromosome 13 is an uniparental disomy of maternal origin that most likely do not have any phenotypic expression except from cases of homozygosity for a recessive disease mutation for which only mother is a carrier.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Maternal uniparental disomy of chromosome 13 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UPD(13)mat</oboInOwl:hasExactSynonym>
        <rdfs:label>Maternal uniparental disomy of chromosome 13 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD45.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0019994</skos:exactMatch>
        <skos:exactMatch>UMLS:C4722325</skos:exactMatch>
    </owl:Class>

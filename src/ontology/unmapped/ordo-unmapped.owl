        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717311"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717330"/>
        <obo:IAO_0000115 xml:lang="en">A non-progressive autosomal dominant macular disorder of congenital or infantile onset characterized by loss of central vision, the accumulation of drusen in the macula and atrophy of photoreceptor cells with a variable phenotype at macular examination.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CAPE dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CAPED</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Central areolar pigment epithelial dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Central retinal pigment epithelial dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MCDR1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NCMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>North Carolina macular dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">North Carolina macular dystrophy, retinal 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive foveal dystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>North Carolina macular dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:H35.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B75.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007630</skos:exactMatch>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2233 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2233">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181441"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by mild intellectual disability, hypogonadism due to primary gonadal failure, mitral valve prolapse, and short stature. Dysmorphic features include low posterior hairline, highly arched palate, short neck, short fourth metacarpals, and cubitus valgus. There have been no further descriptions in the literature since 1989.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cantalamessa-Baldini-Ambrosi syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypogonadism-mitral valve prolapse-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypogonadism-mitral valve prolapse-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0016385</skos:exactMatch>
        <skos:exactMatch>MeSH:C537981</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931685</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2233"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hypogonadism-mitral valve prolapse-intellectual disability syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2234 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2234">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181441"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by intellectual disability, hypergonadotropic hypogonadism, germinal aplasia or complete tubular fibrosis, aspermatogenesis, gynecomastia, congenital skeletal anomalies involving the cervical spine and superior ribs, and diabetes mellitus. There have been no further descriptions in the literature since 1953.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Male hypergonadotropic hypogonadism-intellectual disability-skeletal anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sohval-Soffer syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Male hypergonadotropic hypogonadism-intellectual disability-skeletal anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0010617</skos:exactMatch>
        <skos:exactMatch>MeSH:C536679</skos:exactMatch>
        <skos:exactMatch>OMIM:307500</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931285</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2234"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Male hypergonadotropic hypogonadism-intellectual disability-skeletal anomalies syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2235 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2235">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181387"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716342"/>
        <obo:IAO_0000115 xml:lang="en">A rare endocrine disease characterized by hypogonadotropic hypogonadism (with primary amenorrhea and lack of secondary sexual development) and retinitis pigmentosa. Patients have decreased axillary and pubic hair growth, hypoplastic external genitalia, and small uterus and ovaries. No additional physical development abnormalities or intellectual deficiency are reported. There have been no further descriptions in the literature since 1981.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Chang-Davidson-Carlson syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypogonadotropic hypogonadism-retinitis pigmentosa syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypogonadotropic hypogonadism-retinitis pigmentosa syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E23.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0016386</skos:exactMatch>
        <skos:exactMatch>MeSH:C538075</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931722</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2235"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurodegenerative disorder characterized by early-onset cerebellar ataxia, a pyramidal syndrome and peripheral neuropathy.</obo:IAO_0000115>

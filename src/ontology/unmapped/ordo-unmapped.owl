    <!-- http://www.orpha.net/ORDO/Orphanet_100998 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100998">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100979"/>

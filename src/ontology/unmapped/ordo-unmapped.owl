        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79364"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98576"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98733"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15454"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A Noonan-related syndrome, characterized by facial anomalies suggestive of Noonan syndrome, loose anagen hair, frequent congenital heart defects, distinctive skin features (darkly pigmented skin, keratosis pilaris, eczema or ichthyosis), and short stature that is often associated with a growth hormone deficiency. Psychomotor delay with attention deficit/hyperactivity disorder (ADHD) is frequently observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Mazzanti syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NS/LAH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Noonan syndrome-like disorder with loose anagen hair</oboInOwl:hasExactSynonym>
        <rdfs:label>Noonan syndrome-like disorder with loose anagen hair</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011899</skos:exactMatch>
        <skos:exactMatch>UMLS:C1843181</skos:exactMatch>
        <skos:narrowMatch>OMIM:607721</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617506</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2701"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_231178 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231178">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_886"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12601"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16361"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17416"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare ciliopathy characterized by congenital moderate-to-severe deafness, retinitis pigmentosa developing in the first or second decade, and normal vestibular function. Congenital bilateral sensorineural hearing loss is mild to moderate in the low frequencies and severe to profound in the higher frequencies. Additional manifestations include night blindness, constricted visual field (tunnel vision), and later on decreased visual acuity sometimes ending with bare light perception.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">USH2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Usher syndrome type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Usher syndrome type 2</rdfs:label>
        <skos:broadMatch>ICD-10:H35.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0016484</skos:exactMatch>
        <skos:exactMatch>UMLS:C0339534</skos:exactMatch>
        <skos:narrowMatch>OMIM:276901</skos:narrowMatch>
        <skos:narrowMatch>OMIM:605472</skos:narrowMatch>
        <skos:narrowMatch>OMIM:611383</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_231178"/>

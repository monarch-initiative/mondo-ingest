                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/53924"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Neuronal intranuclear inclusion disease (NIID) is a very rare multisystem neurodegenerative disorder characterized by the presence of eosinophilic intranuclear inclusions in neuronal and glial cells, and neuronal loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neuronal intranuclear inclusion disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuronal intranuclear inclusion disease</rdfs:label>
        <skos:broadMatch>ICD-10:G31.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011327</skos:exactMatch>
        <skos:exactMatch>MeSH:C537395</skos:exactMatch>
        <skos:exactMatch>MedDRA:10084235</skos:exactMatch>
        <skos:exactMatch>OMIM:603472</skos:exactMatch>
        <skos:exactMatch>UMLS:C1863843</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2289"/>

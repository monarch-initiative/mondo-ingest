            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare T-cell non-Hodgkin lymphoma characterized clinically by tumor developing exclusively after exposure to textured breast implants, and arising typically from the periprosthetic capsule surrounding them. Despite being a hematological malignancy, it behaves as a solid tumor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Breast implant-associated ALCL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Breast implant-associated anaplastic large cell lymphoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Seroma-associated ALCL</oboInOwl:hasExactSynonym>
        <rdfs:label>Breast implant-associated anaplastic large cell lymphoma</rdfs:label>

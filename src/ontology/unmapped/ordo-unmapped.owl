        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98750"/>
        <obo:IAO_0000115 xml:lang="en">Isaac&apos;s syndrome is an immune-mediated peripheral motor neuron disorder characterized by continuous muscle fiber activity at rest resulting in muscle stiffness, cramps, myokymia, and pseudomyotonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Continuous muscle fiber activity syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isaacs syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isaacs-Mertens syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Quantal squander syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Isaacs syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G71.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:8C71.4</skos:exactMatch>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_397937 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_397937">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217610"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79201"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15864"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Polyglucosan body myopathy type 1 is a rare, genetic, glycogen storage disorder characterized by polyglucosan accumulation in various tissues, manifesting with progressive proximal muscle weakness in the lower limbs and rapidly progressive, usually dilated, cardiomyopathy. Hepatic involvement and growth retardation may be associated. Early-onset immunodeficiency and autoinflammation, presenting with recurrent bacterial infections, have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PGBM1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polyglucosan body myopathy type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Polyglucosan body myopathy type 1</rdfs:label>
        <skos:broadMatch>ICD-10:E74.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.3</skos:broadMatch>
        <skos:broadMatch>OMIM:615895</skos:broadMatch>
        <skos:exactMatch>MONDO:0014389</skos:exactMatch>
        <skos:exactMatch>UMLS:C4014605</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_397937"/>

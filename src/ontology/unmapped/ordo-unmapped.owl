    <!-- http://www.orpha.net/ORDO/Orphanet_95455 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95455">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_293815"/>

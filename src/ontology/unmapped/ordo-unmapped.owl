        <obo:IAO_0000115 xml:lang="en">Fuchs heterochromic iridocyclitis (FHI) is an ocular disease of unknown etiology occurring in a very small percentage (0.5-6.2%) of uveitis cases, characterized by diffuse iris heterochromia or atrophy, keratic precipitates in the absence of synechiae, and in some cases evolving to glaucoma and vitreous opacities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FHI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fuchs heterochromic iridocyclitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Fuchs heterochromic iridocyclitis</rdfs:label>
        <skos:broadMatch>ICD-10:H20.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9A96.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0016989</skos:exactMatch>
        <skos:exactMatch>MedDRA:10017406</skos:exactMatch>
        <skos:exactMatch>UMLS:C0016782</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_263479"/>

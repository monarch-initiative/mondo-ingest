            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary spherocytosis is a congenital hemolytic anemia with a wide clinical spectrum (from symptom-free carriers to severe hemolysis) characterized by anemia, variable jaundice, splenomegaly and cholelithiasis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hereditary spherocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Minkowski-Chauffard disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary spherocytosis</rdfs:label>
        <skos:broadMatch>ICD-11:3A10.Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:D58.0</skos:exactMatch>

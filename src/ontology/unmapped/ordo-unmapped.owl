    <!-- http://www.orpha.net/ORDO/Orphanet_300903 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300903">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98841"/>
        <obo:IAO_0000115 xml:lang="en">A type of ALCL, a rare and aggressive peripheral T-cell non-Hodgkin lymphoma affecting lymph nodes and extranodal sites, which is characterized by the lack of expression of a protein called anaplastic lymphoma kinase (ALK).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ALK- ALCL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ALK- anaplastic large cell lymphoma</oboInOwl:hasExactSynonym>

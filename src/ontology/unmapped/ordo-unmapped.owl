            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spinocerebellar ataxia type 19 (SCA19) is a very rare subtype of type I autosomal dominant cerebellar ataxia (ADCA type I). It is characterized by mild cerebellar ataxia, cognitive impairment, low scores on the Wisconsin Card Sorting Test measuring executive function, myoclonus, and postural tremor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA19/22</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 19/22</oboInOwl:hasExactSynonym>

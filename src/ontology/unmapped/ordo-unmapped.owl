        <owl:annotatedTarget>Tarsal-carpal coalition syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_141209 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_141209">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_719950"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by multifocal dilated lymphatic vessels involving multiple organs and tissues. Patients mostly present in infancy and childhood. Clinical course and prognosis depend on the affected sites and extent of the condition, deterioration of lung function being a major cause of morbidity and mortality.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse lymphangioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse lymphangiomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse lymphatic malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Disseminated lymphangioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Disseminated lymphangiomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Disseminated lymphatic malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GLA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized lymphatic anomaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Generalized lymphatic anomaly</rdfs:label>
        <skos:broadMatch>ICD-10:I89.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:2E81.10</skos:exactMatch>
        <skos:exactMatch>MONDO:0015408</skos:exactMatch>
        <skos:exactMatch>UMLS:C3839921</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_141209"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Generalized lymphatic anomaly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_141214 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_141214">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156237"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Isolated congenital syngnathia is a very rare developmental defect during embryogenesis disorder characterized by varying degrees of congenital fusion (ranging from simple mucosal adhesions to extensive bony fusion) of mandible to maxilla that is not associated with any other malformations. Patients present with mouth opening limitation (which could range from severe to minimal restriction) that typically results in feeding, swallowing and/or respiratory difficulties which may lead to failure to thrive, malnutrition and/or temporomandibular joint ankylosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital maxillomandibular fusion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated congenital syngnathia</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated congenital syngnathia</rdfs:label>
        <skos:broadMatch>ICD-10:Q67.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA5Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015409</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706392</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_141214"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Isolated congenital syngnathia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_141219 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_141219">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_155835"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare otorhinolaryngological malformation characterized by the presence of a dermoid cyst, located on the dorsum of the nose, which presents a fistula, often extending to the intracranial region. Patients present a firm, slow-growing mass, which contains skin and dermal elements (including hair follicles and sebaceous glands), that do not transilluminate or compress, and may be associated with intermittent or chronic discharge of sebaceous material, soft tissue and skeletal deformity, and local infection. Meningitis, convulsions and cerebral abscess may be observed if intracranial extension exists.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Nasal dorsum fistula</oboInOwl:hasExactSynonym>
        <rdfs:label>Nasal dorsum fistula</rdfs:label>
        <skos:broadMatch>ICD-10:Q18.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA5Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015410</skos:exactMatch>
        <skos:exactMatch>MONDO:15410</skos:exactMatch>
        <skos:exactMatch>UMLS:C0339853</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_141219"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Nasal dorsum fistula</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_141229 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_141229">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_155832"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68329"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Craniofacial cleft</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Facial cleft</oboInOwl:hasExactSynonym>
        <rdfs:label>Facial cleft</rdfs:label>
        <skos:exactMatch>ICD-11:LA51</skos:exactMatch>
        <skos:exactMatch>MONDO:0015411</skos:exactMatch>
        <skos:exactMatch>MONDO:15411</skos:exactMatch>
        <skos:exactMatch>UMLS:C5886881</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_141229"/>

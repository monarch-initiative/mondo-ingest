    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2764 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2764">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399158"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Osteochondritis dissecans (OCD) is a rare bone disease characterized by an acquired idiopathic necrotic lesion of subchondral bone with the formation of a sequestrum, which may detach to form loose bodies in joints. OCD mainly affects the knee, ankle and elbow joints and can lead to pain, functional limitations and secondary osteoarthritis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">König disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteochondritis dissecans</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteochondritis dissecans</rdfs:label>
        <skos:broadMatch>ICD-11:FB82.1</skos:broadMatch>
        <skos:exactMatch>ICD-10:M93.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0017178</skos:exactMatch>
        <skos:exactMatch>MeSH:D010008</skos:exactMatch>
        <skos:exactMatch>MedDRA:10031231</skos:exactMatch>
        <skos:exactMatch>UMLS:C0029421</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2764"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Osteochondritis dissecans</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



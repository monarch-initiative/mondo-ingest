    <!-- http://www.orpha.net/ORDO/Orphanet_35878 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_35878">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165985"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79167"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4335"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare diffuse form of congenital hyperinsulinism characterized by an excessive/ uncontrolled insulin secretion (inappropriate for the level of glycemia), chronic hyperammonemia and recurrent episodes of hypoglycemia induced by fasting and protein rich meals. Epilepsy and cognitive deficit, which are unrelated to hypoglycemia but possibly related to the chronic hyperammonemia, may also occur. This disorder is usually responsive to diazoxide treatment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HI/HA syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hyperinsulinism-hyperammonemia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperinsulinism-hyperammonemia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E72.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.AY</skos:broadMatch>
        <skos:exactMatch>MONDO:0011717</skos:exactMatch>
        <skos:exactMatch>MeSH:C538375</skos:exactMatch>
        <skos:exactMatch>OMIM:606762</skos:exactMatch>
        <skos:exactMatch>UMLS:C1847555</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_35878"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hyperinsulinism-hyperammonemia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_35889 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_35889">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_556508"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare intoxication with opioids, a large group of alkaloid analgesics, mainly characterized by miosis (pinpoint pupil), respiratory depression (bradypnea/apnea) and central nervous system depression (sedation or coma). Other manifestations include hypotension, reduced bowel motility, hypothermia and hypoglycemia. Naloxone, a competitive inhibitor of the mu-opioid receptor, is a potent antagonist and is used as the antidote for opioid intoxication.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Acute opioid intoxication</oboInOwl:hasExactSynonym>
        <rdfs:label>Acute opioid intoxication</rdfs:label>
        <skos:exactMatch>ICD-11:6C43.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0018173</skos:exactMatch>
        <skos:exactMatch>MONDO:18173</skos:exactMatch>
        <skos:exactMatch>UMLS:C5848046</skos:exactMatch>
        <skos:narrowMatch>ICD-10:T40.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:T40.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:T40.2</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_35889"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Acute opioid intoxication</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_359 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_359">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522578"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A clinically diverse group of rare eye disorders with genetic predisposition characterized by elevated intraocular pressure (IOP) and glaucomatous changes of the optic nerve head, leading to field defects, visual loss and blindness. It can be sub-classified as primary (congenital glaucoma, juvenile glaucoma) or secondary according to the presence or absence of systemic or other ocular anomalies (iridogoniodysgenesis, Stickler syndrome, Coats syndrome). The clinical presentation is variable and is based on age, severity of glaucoma, presence of ocular abnormalities and development of secondary IOP related abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary glaucoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pediatric-onset glaucoma of genetic origin</oboInOwl:hasExactSynonym>
        <rdfs:label>Pediatric-onset glaucoma of genetic origin</rdfs:label>
        <skos:exactMatch>MONDO:18174</skos:exactMatch>
        <skos:exactMatch>MeSH:C580055</skos:exactMatch>
        <skos:exactMatch>UMLS:C3711383</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_359"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pediatric-onset glaucoma of genetic origin</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_35909 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_35909">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68334"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6631"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18451"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited bleeding disorder due to the reduction in activity and antigen levels of both factor V (FV) and factor VIII (FVIII) and characterized by mild-to-moderate bleeding symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Combined deficiency of factor V and factor VIII</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">F5F8D</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FV and FVIII combined deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined deficiency of factor V and factor VIII</rdfs:label>
        <skos:broadMatch>ICD-10:D68.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B14.Z</skos:broadMatch>
        <skos:exactMatch>MONDO:0018175</skos:exactMatch>
        <skos:exactMatch>MeSH:C565577</skos:exactMatch>
        <skos:exactMatch>UMLS:C1856883</skos:exactMatch>
        <skos:narrowMatch>OMIM:227300</skos:narrowMatch>
        <skos:narrowMatch>OMIM:227310</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613625</skos:narrowMatch>
    </owl:Class>

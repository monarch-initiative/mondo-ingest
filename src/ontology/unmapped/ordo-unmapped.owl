                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3690"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Muenke syndrome is a syndromic craniosynostosis with significant phenotypic variability, usually characterized by coronal synostosis, midfacial retrusion, strabismus, hearing loss and developmental delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Muenke syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Muenke syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.GY</skos:broadMatch>
        <skos:exactMatch>MONDO:0011274</skos:exactMatch>
        <skos:exactMatch>MeSH:C537369</skos:exactMatch>
        <skos:exactMatch>MedDRA:10088781</skos:exactMatch>
        <skos:exactMatch>OMIM:602849</skos:exactMatch>
        <skos:exactMatch>UMLS:C1864436</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_53271"/>

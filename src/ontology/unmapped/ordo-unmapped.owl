            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12718"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Microcephaly-complex motor and sensory axonal neuropathy syndrome is an extremely rare subtype of hereditary motor and sensory neuropathy characterized by severe, rapidly-progressing, distal, symmetric polyneuropathy and microcephaly (which can be evident in utero) with intact cognition. Clinically it presents with delayed motor development, hypotonia, absent or reduced deep tendon reflexes, progressive muscle wasting and weakness and scoliosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microcephaly-complex motor and sensory axonal neuropathy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Microcephaly-complex motor and sensory axonal neuropathy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0018507</skos:exactMatch>
        <skos:exactMatch>OMIM:620542</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706585</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_423894"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, syndromic intellectual disability characterized by hypotonia, developmetal delay, absent or severly delayed speech development, intellectual disability, obstructive sleep apnea, mild dysmorphic facial features and behavioral abnormalities. Epilepsy, ataxia and nystagmus have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>AHDC1-related intellectual disability-obstructive sleep apnea-mild dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Xia-Gibbs syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>AHDC1-related intellectual disability-obstructive sleep apnea-mild dysmorphism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0014358</skos:exactMatch>
        <skos:exactMatch>OMIM:615829</skos:exactMatch>
        <skos:exactMatch>UMLS:C4014419</skos:exactMatch>
    </owl:Class>

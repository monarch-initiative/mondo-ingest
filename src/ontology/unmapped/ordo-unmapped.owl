            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, potentially lethal, autosomal recessive metabolic disease characterized by impaired glucose-galactose absorption resulting in severe watery diarrhea and dehydration with onset in the neonatal period.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CGGM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital glucose-galactose malabsorption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GGM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glucose-galactose malabsorption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SGLT1 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Glucose-galactose malabsorption</rdfs:label>
        <skos:broadMatch>ICD-10:E74.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C61.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0011731</skos:exactMatch>
        <skos:exactMatch>MeSH:C562602</skos:exactMatch>

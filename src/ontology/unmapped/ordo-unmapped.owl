    <!-- http://www.orpha.net/ORDO/Orphanet_295 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_295">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_138059"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_232035"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Foetal parvovirus syndrome is a foetopathy likely to occur when a pregnant woman is infected by parvovirus B19. In adults, the virus causes a butterfly erythema infectiosum (also called Fifth Disease; &apos;slapped cheek disease&apos;) and flu-like symptoms with symmetric polyarthralgias, which usually do not warrant prenatal diagnosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fetal parvovirus syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mother-to-child transmission of parvovirus syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Parvovirus antenatal infection</oboInOwl:hasExactSynonym>
        <rdfs:label>Fetal parvovirus syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:P35.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:KA62.7</skos:exactMatch>
        <skos:exactMatch>MONDO:0017453</skos:exactMatch>
        <skos:exactMatch>MeSH:C536301</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931167</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_295"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Fetal parvovirus syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2950 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2950">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C044"/>
        <oboInOwl:hasExactSynonym xml:lang="en">TPT-PS syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Triphalangeal thumb-polysyndactyly syndrome</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:exactMatch>MeSH:C536563</skos:exactMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717336"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15946"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Occult macular dystrophy is a rare, genetic retinal dystrophy disease characterized by bilateral progressive decline of visual acuity, due to retinal dysfunction confined only to the macula, associated with normal fundus and fluorescein angiograms and severly attenuated focal macular and multifocal electroretinograms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Miyake disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OCMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Occult macular dystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Occult macular dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:H35.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B75.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013316</skos:exactMatch>
        <skos:exactMatch>OMIM:613587</skos:exactMatch>
        <skos:exactMatch>UMLS:C3150833</skos:exactMatch>
    </owl:Class>

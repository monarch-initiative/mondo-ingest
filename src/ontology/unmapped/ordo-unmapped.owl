            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, pure or complex form of hereditary spastic paraplegia characterized by progressive spastic paraplegia with pyramidal signs in the upper and lower limbs, and decreased vibration sense.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant spastic paraplegia type 13</oboInOwl:hasExactSynonym>

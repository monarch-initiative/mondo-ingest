        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79196"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98370"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4311"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A disorder that is principally characterized by hemolytic anemia, (usually rather mild), however, the presence of neurological symptoms has also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Gamma-glutamylcysteine synthetase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glutamate-cysteine ligase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Glutamate-cysteine ligase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D55.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009259</skos:exactMatch>
        <skos:exactMatch>OMIM:230450</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268523</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_33574"/>

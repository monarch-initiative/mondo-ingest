    <!-- http://www.orpha.net/ORDO/Orphanet_2542 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2542">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98555"/>
        <obo:IAO_0000115 xml:lang="en">A non-syndromic group of structural developmental eye defects characterized by the variable combination of microphthalmia, ocular coloboma, and anophthalmia, either unilaterally or bilaterally, with no other associated ocular conditions in the affected/contralateral eye, and no systemic anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated MAC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated microphthalmia-anophthalmia-coloboma</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated microphthalmia-anophthalmia-coloboma</rdfs:label>
        <skos:exactMatch>MONDO:16764</skos:exactMatch>
        <skos:exactMatch>OMIM:251600</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679828</skos:exactMatch>
        <skos:narrowMatch>OMIM:156850</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610093</skos:narrowMatch>
        <skos:narrowMatch>OMIM:611038</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613094</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613517</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613704</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615113</skos:narrowMatch>
    </owl:Class>

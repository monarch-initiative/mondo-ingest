    <!-- http://www.orpha.net/ORDO/Orphanet_1200 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1200">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156246"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_435606"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30551"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17264"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomaly syndrome characterized by bilateral choanal atresia associated with characteristic cranio-facial dysmorphisms (hypertelorism with narrow palpebral fissures, coloboma of inferior eyelid with presence of eyelashes medial to the defect, prominent nasal bridge, thin lips, prominent ears), that can be accompanied by hearing loss, unilateral cleft lip, preauricular tags, cardiac septal defects and anomalies of the kidneys. Affected individuals have normal intelligence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Burn-McKeown syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Choanal atresia-hearing loss-cardiac defects-craniofacial dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Burn-McKeown syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0012064</skos:exactMatch>
        <skos:exactMatch>MeSH:C537411</skos:exactMatch>
        <skos:exactMatch>OMIM:608572</skos:exactMatch>
        <skos:exactMatch>UMLS:C1837822</skos:exactMatch>
        <skos:narrowMatch>OMIM:616462</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1200"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

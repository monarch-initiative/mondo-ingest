                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11573"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of tyrosine metabolism characterized by hypertyrosinemia with oculocutaneous manifestations and, in some cases, intellectual deficit.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratosis palmoplantaris-corneal dystrophy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oculocutaneous tyrosinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Richner-Hanhart syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tyrosinemia due to TAT deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tyrosinemia due to tyrosine aminotransferase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tyrosinemia type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tyrosinemia type II</oboInOwl:hasExactSynonym>
        <rdfs:label>Tyrosinemia type 2</rdfs:label>
        <skos:broadMatch>ICD-10:E70.2</skos:broadMatch>

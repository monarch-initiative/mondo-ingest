        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79207"/>
        <obo:IAO_0000115 xml:lang="en">A rare lysosomal disease characterized by an accumulation of cystine inside the lysosomes, causing damage in different organs and tissues, particularly in the kidneys and eyes. Three clinical forms have been described: nephropathic infantile, nephropathic juvenile and ocular.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cystinosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Protein defect of cystin transport</oboInOwl:hasExactSynonym>

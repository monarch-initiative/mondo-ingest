    <!-- http://www.orpha.net/ORDO/Orphanet_498228 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_498228">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98058"/>
        <obo:IAO_0000115 xml:lang="en">A rare urogenital tumor characterized by stromal and epithelial components forming cysts lined by hyperplastic epithelium in a cellular or sarcomatoid stroma. The tumors may be clinically benign or malignant and tend to recur after transurethral resection. Metastatic spread is to lungs, bone, and liver. Patients may present with obstructive voiding symptoms, dysuria, hematuria, urinary retention, or a palpable abdominal mass. The prostate is palpably enlarged but feels soft and spongy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cystic epithelial-stromal tumors of the prostate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cystosarcoma phyllodes of the prostate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Phyllodes tumor of the prostate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phyllodes type of atypical prostatic hyperplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Phyllodes tumor of the prostate</rdfs:label>
        <skos:broadMatch>ICD-10:C61</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C82.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0021102</skos:exactMatch>
        <skos:exactMatch>UMLS:C1335409</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_498228"/>

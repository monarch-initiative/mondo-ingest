        <oboInOwl:hasExactSynonym>Neonatal glycine encephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal non-ketotic hyperglycinemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Neonatal glycine encephalopathy</rdfs:label>

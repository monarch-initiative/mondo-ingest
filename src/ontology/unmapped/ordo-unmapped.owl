    <!-- http://www.orpha.net/ORDO/Orphanet_293199 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_293199">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_780"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11998"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7765"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare soft tissue sarcoma characterized by a high-grade lesion occurring almost exclusively in adults, composed of bizarre polygonal, round, and spindle cells with evidence of skeletal muscle differentiation. Patients usually present with a rapidly growing, painful mass located in the deep soft tissues of the extremities, but also other anatomic regions. Prognosis is generally poor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Pleomorphic rhabdomyosarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Pleomorphic rhabdomyosarcoma</rdfs:label>
        <skos:broadMatch>ICD-10:C49.9</skos:broadMatch>
        <skos:exactMatch>MONDO:0017386</skos:exactMatch>
        <skos:exactMatch>UMLS:C0334480</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_293199"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pleomorphic rhabdomyosarcoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2932 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2932">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182064"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_208978"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare chronic monophasic progressive or relapsing symmetric sensorimotor disorder characterized by progressive muscular weakness with impaired sensation, absent or diminished tendon reflexes, electrodiagnostic features suggestive of demyelination and occasional elevated cerebrospinal fluid (CSF) protein level.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CIDP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic inflammatory demyelinating polyneuropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chronic inflammatory demyelinating polyradiculoneuropathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Chronic inflammatory demyelinating polyneuropathy</rdfs:label>
        <skos:broadMatch>ICD-10:G61.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:8C01.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0006702</skos:exactMatch>
        <skos:exactMatch>MeSH:D020277</skos:exactMatch>
        <skos:exactMatch>MedDRA:10057645</skos:exactMatch>
        <skos:exactMatch>UMLS:C0393819</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2932"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal anomaly characterized by variable clinical features, most commonly including hypotonia, neonatal feeding and respiratory difficulties, microcephaly, global developmental delay and intellectual disability, growth hormone deficiency, hypothyroidism, hearing loss, aural atresia, dysmorphic facial features and behavioral characteristics.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ring 18</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ring chromosome 18</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ring chromosome 18 syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ring chromosome 18 syndrome</rdfs:label>

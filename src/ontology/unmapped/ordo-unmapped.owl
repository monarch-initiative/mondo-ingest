                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7207"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of multiple-pathway glycosylation characterised by psychomotor delay, seizures, failure to thrive, cardiomyopathy, and ichthyosis-like cutaneous anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type If</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG-If</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG1F</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Carbohydrate deficient glycoprotein syndrome type If</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 1f</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type If</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MPDU1-CDG</oboInOwl:hasExactSynonym>
        <rdfs:label>MPDU1-CDG</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C54.2</skos:broadMatch>

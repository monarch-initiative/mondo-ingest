    <!-- http://www.orpha.net/ORDO/Orphanet_96148 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96148">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262083"/>

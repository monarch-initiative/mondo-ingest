        <oboInOwl:hasExactSynonym xml:lang="en">Infant-like botulism</oboInOwl:hasExactSynonym>
        <rdfs:label>Adult intestinal botulism</rdfs:label>
        <skos:broadMatch>ICD-10:A05.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:1A11.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0015806</skos:exactMatch>
        <skos:exactMatch>UMLS:C4289991</skos:exactMatch>
    </owl:Class>

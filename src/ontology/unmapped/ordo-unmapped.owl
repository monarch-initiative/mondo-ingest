        <owl:annotatedTarget>FRAXF syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100976 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100976">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_281097"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11777"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Bathing suit ichthyosis (BSI) is a rare variant of autosomal recessive congenital ichthyosis (ARCI) characterized by the presence of large dark scales in specific areas of the body.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BSI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bathing suit ichthyosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Bathing suit ichthyosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q80.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.02</skos:broadMatch>
        <skos:broadMatch>OMIM:242300</skos:broadMatch>
        <skos:exactMatch>MONDO:0015085</skos:exactMatch>
        <skos:exactMatch>UMLS:C4511230</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100976"/>

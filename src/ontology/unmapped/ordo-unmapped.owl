    <!-- http://www.orpha.net/ORDO/Orphanet_1361 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1361">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377790"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_447874"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79187"/>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism characterized by low serum carnosinase activity, persistent carnosinuria, and carnosinemia. The clinical phenotype is highly variable, with some patients remaining asymptomatic, while others have been reported to show severe developmental delay, intellectual disability, hypotonia, seizures, and other neurological signs and symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Carnosinase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Carnosinase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.F1</skos:broadMatch>
        <skos:exactMatch>MONDO:8921</skos:exactMatch>
        <skos:exactMatch>OMIM:212200</skos:exactMatch>
        <skos:exactMatch>UMLS:C5700357</skos:exactMatch>
    </owl:Class>

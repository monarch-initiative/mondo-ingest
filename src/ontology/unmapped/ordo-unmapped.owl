    <!-- http://www.orpha.net/ORDO/Orphanet_79502 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79502">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2338"/>

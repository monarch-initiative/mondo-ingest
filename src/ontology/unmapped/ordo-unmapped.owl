        <rdfs:label>Alpha-N-acetylgalactosaminidase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E77.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.21</skos:broadMatch>

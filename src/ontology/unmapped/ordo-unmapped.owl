    <!-- http://www.orpha.net/ORDO/Orphanet_228174 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_228174">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_64746"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_577 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_577">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79212"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93448"/>
        <obo:IAO_0000115 xml:lang="en">A rare lysosomal disease characterized by dysmorphic features and skeletal changes, restricted joint mobility, short stature, and hand deformities (such as claw hands, stiffness of hands, carpal tunnel syndrome, inability to make fists). Most patients have normal intellectual capacity and the clinical progression is less rapid than that of mucolipidosis type II (MLII).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mucolipidosis type III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pseudo-Hurler polydystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Mucolipidosis type III</rdfs:label>
        <skos:broadMatch>ICD-10:E77.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.20</skos:broadMatch>
        <skos:exactMatch>MedDRA:10072929</skos:exactMatch>
        <skos:exactMatch>UMLS:C0033788</skos:exactMatch>
        <skos:narrowMatch>OMIM:252600</skos:narrowMatch>
        <skos:narrowMatch>OMIM:252605</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_577"/>

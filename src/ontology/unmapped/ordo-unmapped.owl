    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_212 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_212">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79173"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2501"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism characterized by abnormal accumulation of plasma cystathionine and subsequent increased urinary excretion due to cystathionine gamma-lyase deficiency. The condition is considered benign without pathological relevance. Mode of inheritance is autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cystathionase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cystathionine gamma-lyase deficiency syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cystathioninuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Gamma-cystathionase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Cystathioninuria</rdfs:label>
        <skos:broadMatch>ICD-10:E72.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.B</skos:broadMatch>
        <skos:exactMatch>MONDO:0009058</skos:exactMatch>
        <skos:exactMatch>MeSH:C535408</skos:exactMatch>
        <skos:exactMatch>OMIM:219500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0220993</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_212"/>

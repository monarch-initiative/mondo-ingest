                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9360"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial Hemophagocytic lymphohistiocytosis (FHL) is a rare primary immunodeficiency characterized by a macrophage activation syndrome with an onset usually occurring within a few months or less common several years after birth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial HLH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial hemophagocytic lymphohistiocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial hemophagocytic lymphohistiocytosis</rdfs:label>
        <skos:broadMatch>ICD-10:D76.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.23</skos:broadMatch>
        <skos:exactMatch>MONDO:0015541</skos:exactMatch>
        <skos:exactMatch>MONDO:15541</skos:exactMatch>

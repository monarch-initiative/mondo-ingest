        <obo:IAO_0000115 xml:lang="en">Congenital muscular dystrophy-infantile cataract-hypogonadism syndrome is characterized by congenital muscular dystrophy, infantile cataract and hypogonadism. It has been described in seven individuals from an isolated Norwegian village and in one unrelated individual. Transmission appears to be autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bassoe syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital muscular dystrophy-infantile cataract-hypogonadism syndrome</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_412066 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_412066">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276058"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98534"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9390"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic neurodegenerative disease characterized by dementia and mild parkinsonism with poor levodopa response. Presenting clinical manifestations are memory problems, short attention span, disorientation, language impairment, rigidity, bradykinesia, postural instability and behavioral changes, including apathy, anxiety and delusions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PRKAR1B-related neurodegenerative dementia with intermediate filaments</oboInOwl:hasExactSynonym>
        <rdfs:label>PRKAR1B-related neurodegenerative dementia with intermediate filaments</rdfs:label>
        <skos:broadMatch>ICD-10:G31.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0018475</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751505</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_412066"/>

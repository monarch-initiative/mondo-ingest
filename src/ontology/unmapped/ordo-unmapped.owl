        <owl:annotatedTarget>FBLN1-related developmental delay-central nervous system anomaly-syndactyly syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

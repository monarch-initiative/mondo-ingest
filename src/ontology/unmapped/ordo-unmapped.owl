        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Mucinous adenocarcinoma of the appendix is a very rare, slow growing, well-differentiated epithelial neoplasm of the appendix characterized by abundant mucin production. Clinically, it presents as acute appendicitis (with abdominal pain, fever, leukocytosis) or as pseudomyxoma peritonei (wide-spread presence of mucin within the peritoneal cavity), however some patients may be completely asymptomatic at the time of diagnosis. In many cases, a second gastrointestinal malignancy is present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Appendiceal mucinous adenocarcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mucinous adenocarcinoma of the appendix</oboInOwl:hasExactSynonym>
        <rdfs:label>Mucinous adenocarcinoma of the appendix</rdfs:label>
        <skos:broadMatch>ICD-10:C18.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:2B81.00</skos:exactMatch>
        <skos:exactMatch>MONDO:0018330</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073361</skos:exactMatch>
        <skos:exactMatch>UMLS:C1706832</skos:exactMatch>
    </owl:Class>

        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7459"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7462"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited mitochondrial disease characterized by the clinical features of Leber hereditary optic neuropathy in combination with other systemic or neurological abnormalities. These abnormalities include: postural tremor, motor disorder, multiple sclerosis-like syndrome, spinal cord disease, skeletal changes, Parkinsonism with dystonia, anarthria, motor and sensory peripheral neuropathy, spasticity, mild encephalopathy, and cardiac arrhythmias.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LHON plus disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Leber plus disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Leber plus disease</rdfs:label>
        <skos:broadMatch>ICD-10:H47.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C73.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0020478</skos:exactMatch>

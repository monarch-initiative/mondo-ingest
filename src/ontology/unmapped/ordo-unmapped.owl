    <!-- http://www.orpha.net/ORDO/Orphanet_251038 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251038">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262851"/>

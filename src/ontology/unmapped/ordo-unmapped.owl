    <!-- http://www.orpha.net/ORDO/Orphanet_1642 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1642">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_261929"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_325638"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98087"/>
        <obo:IAO_0000115 xml:lang="en">Distal monosomy 9p is a rare chromosomal anomaly syndrome, resulting from a partial deletion of the short arm of chromosome 9, with a highly variable phenotype typically characterized by intellectual disability, craniofacial dysmorphism (trigonocephaly, upslanting palpebral fissures, hypoplastic supraorbital ridges), abnormal digits (long middle phalanges with short distal phalanges), as well as frequent association with genitourinary abnormalities (cryptorchidism, hypospadias, ambiguous genitalia, 46,XY testicular dysgenesis). Congenital hypothyroidism and cardiovascular defects have been reported in some cases. Patients present an increased risk for gonadoblastoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal deletion 9p syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal monosomy 9p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 9pter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Telomeric deletion 9p</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal deletion 9p syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0015605</skos:exactMatch>
        <skos:exactMatch>MeSH:C538025</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265425</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1642"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Distal deletion 9p syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1643 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1643">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263731"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Xp22.3 microdeletion syndrome is a microdeletion syndrome resulting from a partial deletion of the chromosome X. Phenotype is highly variable (depending on length of deletion), but is mainly characterized by X linked ichthyosis, mild-moderate intellectual deficit, Kallmann syndrome, short stature, chondrodysplasia punctata and ocular albinism. Epilepsy, attention deficit-hyperactivity disorder, autism and difficulties with social communication can be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(X)(p23)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Xp22.3 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(x)(p23)</oboInOwl:hasExactSynonym>
        <rdfs:label>Xp22.3 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0015606</skos:exactMatch>
        <skos:exactMatch>UMLS:C4512072</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1643"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Xp22.3 microdeletion syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1643"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>del(x)(p23)</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1646 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1646">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399775"/>

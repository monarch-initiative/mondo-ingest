        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <obo:IAO_0000115 xml:lang="en">A rare visceral arteriovenous malformation characterized by abnormal connections between uterine arteries and veins. Vaginal bleeding is the most common clinical feature, may be very severe, and is refractory to conventional treatments. Variable clinical features may include abdominal pulsatile masses, frequent urination or urinary incontinence, dyspareunia, and hematuria. Some patients remain asymptomatic.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arteriovenous malformation of the uterus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UAVM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UVM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Uterine arteriovenous malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Uterine vascular malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Uterine arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA90.32</skos:exactMatch>
    </owl:Class>

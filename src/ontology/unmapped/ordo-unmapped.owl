    <!-- http://www.orpha.net/ORDO/Orphanet_101009 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_101009">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic skin disease characterized by severe skin laxity affecting the trunk and limbs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Body skin hyperlaxity due to vitamin K-dependent coagulation factor deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PXE-like syndrome</oboInOwl:hasExactSynonym>

        <owl:annotatedTarget>Hypocalcemic vitamin D-resistant rickets</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_93164 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93164">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_444916"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare renal tubulopathy secondary to urinary tract infection (UTI) and/or urinary tract malformation (UTM) characterized by renal tubular resistance to aldosterone, characterized by hyponatremia, metabolic acidosis, hyperkalemia and inappropriately high serum aldosterone concentration and clinically manifesting as dehydration, vomiting, and poor oral intake.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Secondary pseudohypoaldosteronism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TPHA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Transient pseudohypoaldosteronism</oboInOwl:hasExactSynonym>
        <rdfs:label>Transient pseudohypoaldosteronism</rdfs:label>
        <skos:broadMatch>ICD-10:N15.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB90.4Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019643</skos:exactMatch>
        <skos:exactMatch>UMLS:C4273962</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93164"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

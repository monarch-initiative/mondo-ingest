    <!-- http://www.orpha.net/ORDO/Orphanet_3307 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3307">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262812"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Tetrasomy 18p is a very rare structural chromosomal anomaly affecting multiple body systems and characterized clinically by craniofacial abnormalities, delayed development, cognitive impairment, changes in muscle tone, distinctive facial features, and rarely renal malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isochromosome 18p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tetrasomy 18p syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Tetrasomy 18p syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD7Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013668</skos:exactMatch>
        <skos:exactMatch>MeSH:C538306</skos:exactMatch>
        <skos:exactMatch>OMIM:614290</skos:exactMatch>
        <skos:exactMatch>UMLS:C0795868</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3307"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_90044 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90044">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98365"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/47"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial pseudohyperkalemia (FP) is an inherited, mild, non-hemolytic subtype of hereditary stomatocytosis that is associated with a temperature-dependent anomaly in red cell membrane permeability to potassium that leads to high &lt;i&gt;in vitro&lt;/i&gt; potassium levels in samples stored below 37 C. FP is not associated with additional hematological abnormalities, although affected individuals may show some mild abnormalities like macrocytosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial pseudohyperkalemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial pseudohyperkalemia</rdfs:label>
        <skos:broadMatch>ICD-10:D58.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:3A10.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0012204</skos:exactMatch>
        <skos:exactMatch>OMIM:609153</skos:exactMatch>
        <skos:exactMatch>UMLS:C4273970</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_415 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_415">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

        <oboInOwl:hasExactSynonym xml:lang="en">MCPH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Microcephalia vera</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Microcephaly vera</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">True microcephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive primary microcephaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q02</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA05.0</skos:broadMatch>

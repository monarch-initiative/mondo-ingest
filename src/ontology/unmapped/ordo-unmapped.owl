    <!-- http://www.orpha.net/ORDO/Orphanet_251656 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251656">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251651"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Oligoastrocytoma is a type of low-grade glioma with a mixed astrocytoma and oligodendroglioma histology, manifesting with headaches, speech and motor problems, seizures and, in some, subarachnoid haemorrhage.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MOA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mixed oligoastrocytoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oligoastrocytoma, dual genotype</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oligoastrocytoma, dual genotype NEC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oligoastrocytoma, dual genotype, not elsewhere classified</oboInOwl:hasExactSynonym>
        <rdfs:label>Oligoastrocytoma, dual genotype</rdfs:label>
        <skos:broadMatch>ICD-10:C71.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016702</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073131</skos:exactMatch>
        <skos:exactMatch>UMLS:C0547065</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251656"/>

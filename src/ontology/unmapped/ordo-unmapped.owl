    <!-- http://www.orpha.net/ORDO/Orphanet_470 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_470">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

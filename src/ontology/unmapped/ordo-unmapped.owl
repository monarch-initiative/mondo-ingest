    <!-- http://www.orpha.net/ORDO/Orphanet_913 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_913">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100076"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2579 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2579">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183518"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_590 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_590">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

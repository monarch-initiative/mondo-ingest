    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_52056 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_52056">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

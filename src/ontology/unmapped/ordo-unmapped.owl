        <rdfs:label>Hand-foot-genital syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q51.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007698</skos:exactMatch>

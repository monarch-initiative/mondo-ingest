    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_93336 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93336">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498464"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10848"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13243"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Polydactyly of a triphalangeal thumb or PPD2 is a form of preaxial polydactyly of fingers, a limb malformation syndrome, that is characterized by the presence of a usually opposable triphalangeal thumb with or without additional duplication of one or more skeletal components of the thumb. The thumb appearance can differ widely in shape (wedge to rectangular) or it can be deviated in the radio-ulnar plane (clinodactyly). PPD2 is also associated with systemic syndromes, including Holt-Oram syndrome and Fanconi anemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PPD2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polydactyly of a triphalangeal thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Preaxial polydactyly type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Polydactyly of a triphalangeal thumb</rdfs:label>
        <skos:broadMatch>ICD-10:Q69.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.2</skos:broadMatch>
        <skos:broadMatch>OMIM:174500</skos:broadMatch>
        <skos:exactMatch>MONDO:0008270</skos:exactMatch>
        <skos:exactMatch>UMLS:C1868114</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

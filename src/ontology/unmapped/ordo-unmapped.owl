    <!-- http://www.orpha.net/ORDO/Orphanet_2891 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2891">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

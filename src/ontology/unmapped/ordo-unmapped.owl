        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary immunodeficiency characterized by defects in the leukocyte adhesion process, marked leukocytosis, recurrent infections, and delayed detachment of the umbilical cord.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LAD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Leukocyte adhesion deficiency</oboInOwl:hasExactSynonym>

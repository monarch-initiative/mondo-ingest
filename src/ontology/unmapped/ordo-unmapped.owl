    <!-- http://www.orpha.net/ORDO/Orphanet_101932 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_101932">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95464"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare congenital mitral malformations characterized by anomalies of the chordae tendineae and papillary muscles. This comprises anomalous mitral arcade or hammock valve (due to thickened and extremely short chordae tendineae), straddling valve (abnormal attachment of the chordae tendineae to both ventricles), and parachute valve (unifocal attachment of the chordae tendineae to a single or fused papillary muscle), resulting in an incompetent valve with regurgitation and/or stenosis and impaired left ventricular inflow, potentially leading to heart failure. In most cases, other cardiac anomalies are found in association.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anomaly of the mitral subvalvular apparatus</oboInOwl:hasExactSynonym>
        <rdfs:label>Anomaly of the mitral subvalvular apparatus</rdfs:label>
        <skos:broadMatch>ICD-10:Q23.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA87.13</skos:exactMatch>
        <skos:exactMatch>MONDO:0015109</skos:exactMatch>
        <skos:exactMatch>UMLS:C3164517</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_101932"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Anomaly of the mitral subvalvular apparatus</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



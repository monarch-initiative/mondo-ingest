    <!-- http://www.orpha.net/ORDO/Orphanet_2104 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2104">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterised by joint laxity, pectus carinatum and facial dysmorphism (including mild frontal bossing, lateral displacement of the inner canthi, a beaked nose with a low nasal bridge, malar hypoplasia, chubby cheeks, a striking philtrum and arched upper lips). There have been no further descriptions in the literature since 1980.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dysmorphism-pectus carinatum-joint laxity syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Guízar Vázquez-Sánchez-Manzano syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Dysmorphism-pectus carinatum-joint laxity syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0016219</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518558</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2104"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Dysmorphism-pectus carinatum-joint laxity syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_210548 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_210548">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180772"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269531"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269564"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/26361"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9588"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neurological disease characterized by association of macrocephaly, dysmorphic facial features and psychomotor delay leading to intellectual disability and autism spectrum disorder. Facial dysmorphism may include frontal bossing, hypertelorism, midface hypoplasia, depressed nasal bridge, short nose, and long philtrum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Macrocephaly-intellectual disability-autism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Macrocephaly-intellectual disability-autism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>OMIM:605309</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190809</skos:exactMatch>
        <skos:narrowMatch>OMIM:613926</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_210548"/>

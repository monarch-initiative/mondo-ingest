    <!-- http://www.orpha.net/ORDO/Orphanet_2291 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2291">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156249"/>

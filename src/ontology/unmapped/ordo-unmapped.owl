        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Neuroendocrine cell hyperplasia of infancy (NCHI) is a non-lethal pediatric form of interstitial lung disease (ILD) characterized by tachypnea without respiratory failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">NCHI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NEHI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neuroendocrine cell hyperplasia of infancy</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuroendocrine cell hyperplasia of infancy</rdfs:label>
        <skos:broadMatch>ICD-10:J84.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:CB04.7</skos:exactMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by mild intellectual deficit, congenital cataract, progressive sensorineural hearing impairment, ataxia, peripheral neuropathy, and short stature. There have been no further descriptions in the literature since 1991.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cataract-ataxia-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cataract-ataxia-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cataract-ataxia-deafness syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008928</skos:exactMatch>
        <skos:exactMatch>MeSH:C538283</skos:exactMatch>
        <skos:exactMatch>OMIM:212710</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796123</skos:exactMatch>
    </owl:Class>

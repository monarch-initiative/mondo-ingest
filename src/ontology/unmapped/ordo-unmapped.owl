            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2714"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Type 1 lissencephaly due to doublecortin (DCX) gene mutations is a semi-dominant X-linked disease characterised by intellectual deficiency and seizures that are more severe in male patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lissencephaly type 1 due to doublecortin gene mutation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked lissencephaly type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Lissencephaly type 1 due to doublecortin gene mutation</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD20.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0010239</skos:exactMatch>
        <skos:exactMatch>OMIM:300067</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275012</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2148"/>

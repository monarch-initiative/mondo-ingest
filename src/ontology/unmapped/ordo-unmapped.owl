        <oboInOwl:hasExactSynonym>Congenital hemangioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Haemangioma congénitale</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital hemangioma</rdfs:label>
        <skos:exactMatch>MONDO:0018715</skos:exactMatch>
        <skos:exactMatch>MONDO:18715</skos:exactMatch>
        <skos:exactMatch>MedDRA:10018818</skos:exactMatch>
        <skos:exactMatch>UMLS:C0235753</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_458775"/>

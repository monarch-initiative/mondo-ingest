    <!-- http://www.orpha.net/ORDO/Orphanet_261494 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_261494">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

        <oboInOwl:hasExactSynonym xml:lang="en">Benign adult familial myoclonus epilepsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FAME</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FCMTE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial adult myoclonic epilepsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial cortical myoclonic tremor and epilepsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial adult myoclonic epilepsy</rdfs:label>

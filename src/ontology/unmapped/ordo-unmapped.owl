            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Southeast Asian ovalocytosis (SAO) is a rare hereditary red cell membrane defect characterized by the presence of oval-shaped erythrocytes and with most patients being asymptomatic or occasionally manifesting with mild symptoms such as pallor, jaundice, anemia and gallstones.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary ovalocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Melanesian elliptocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Melanesian ovalocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SAO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Southeast Asian ovalocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stomatocytic elliptocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Southeast Asian ovalocytosis</rdfs:label>
        <skos:broadMatch>ICD-10:D58.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008165</skos:exactMatch>

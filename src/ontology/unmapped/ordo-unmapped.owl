            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A very rare, severe, genetic, combined immunodeficiency disorder characterized by lymphocytosis, decreased peripheral CD8+ T-cells, and presence of normal circulating CD4+ T-cells, leading to immune dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Combined immunodeficiency due to ZAP70 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Zeta-associated-protein 70 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined immunodeficiency due to ZAP70 deficiency</rdfs:label>

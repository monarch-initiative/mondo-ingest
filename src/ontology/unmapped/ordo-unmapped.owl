                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/638"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare isolated diffuse palmoplantar keratoderma characterized by diffuse, homogeneous, mild to thick, brown-to-yellowish palmoplantar hyperkeratosis (sometimes spreading over the dorsal aspect of fingers). Skin biopsy shows non-epidermolytic changes. There are no changes in hair, teeth or nails, and no syndromic involvement of other organs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse palmoplantar keratoderma, Bothnia type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Diffuse palmoplantar keratoderma, Bothnian type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NEPPK, Bothnia type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NEPPK, Bothnian type</oboInOwl:hasExactSynonym>
        <rdfs:label>Diffuse palmoplantar keratoderma, Bothnian type</rdfs:label>

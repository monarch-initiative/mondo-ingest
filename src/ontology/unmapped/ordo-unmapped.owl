        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1427 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1427">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_253"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93421"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93422"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2187"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Otospondylomegaepiphyseal dysplasia (OSMED) is an inborn error of cartilage collagen formation characterized by sensorineural hearing loss, enlarged epiphyses, skeletal dysplasia with disproportionately short limbs, vertebral body anomalies and a characteristic facies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive otospondylomegaepiphyseal dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OSMED</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive otospondylomegaepiphyseal dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0008975</skos:exactMatch>
        <skos:exactMatch>MedDRA:10084407</skos:exactMatch>
        <skos:exactMatch>OMIM:215150</skos:exactMatch>
        <skos:exactMatch>UMLS:C4520892</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1427"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autosomal recessive otospondylomegaepiphyseal dysplasia</owl:annotatedTarget>

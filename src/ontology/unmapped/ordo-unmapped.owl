        <obo:IAO_0000115 xml:lang="en">Malignant peripheral nerve sheath tumor (MPNST) is a rare and often aggressive soft tissue sarcoma occurring in a wide range of anatomical sites.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MPNST</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Malignant neurilemmoma</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_93298 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93298">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_932"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10994"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, lethal type of achondrogenesis characterized by severe micromelia with very short fingers and toes, a flat face, a short neck, thickened soft tissue around the neck, hypoplasia of the thorax, protuberant abdomen, a hydropic fetal appearance and distinctive histological features of the cartilage.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Achondrogenesis type 1B</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Achondrogenesis, Parenti-Fraccaro type</oboInOwl:hasExactSynonym>
        <rdfs:label>Achondrogenesis type 1B</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.50</skos:broadMatch>
        <skos:exactMatch>MONDO:0010966</skos:exactMatch>
        <skos:exactMatch>MeSH:C536016</skos:exactMatch>
        <skos:exactMatch>OMIM:600972</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265274</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93298"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Achondrogenesis type 1B</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_93299 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93299">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_932"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12305"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, lethal type of achondrogenesis characterized by dwarfism with extremely short limbs, narrow chest, short ribs that are easily fractured, soft skull bones and distinctive histological features of the cartilage.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Achondrogenesis type 1A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Achondrogenesis, Houston-Harris type</oboInOwl:hasExactSynonym>
        <rdfs:label>Achondrogenesis type 1A</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.50</skos:broadMatch>
        <skos:exactMatch>MONDO:0008701</skos:exactMatch>
        <skos:exactMatch>MeSH:C536015</skos:exactMatch>
        <skos:exactMatch>OMIM:200600</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265273</skos:exactMatch>
    </owl:Class>

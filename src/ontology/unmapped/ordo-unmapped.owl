    <!-- http://www.orpha.net/ORDO/Orphanet_319581 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319581">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_319543"/>

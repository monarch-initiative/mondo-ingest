        <oboInOwl:hasExactSynonym>Woolly hair</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wooly hair</oboInOwl:hasExactSynonym>
        <rdfs:label>Woolly hair</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.1</skos:broadMatch>

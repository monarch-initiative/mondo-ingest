        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4170"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital X-linked dyserythropoietic anemia characterized by moderate to severe anemia without thrombocytopenia, variable degrees of neutropenia, and bone marrow findings of trilineage dysplasia with hypocellularity of erythroid and granulocytic lineages. Peripheral blood shows anisocytosis, macrocytosis, poikilocytosis, elliptocytes, and fragmented erythrocytes. Platelet count is typically normal, although platelet morphology may be abnormal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked dyserythropoietic anemia with abnormal platelets and neutropenia</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked dyserythropoietic anemia with abnormal platelets and neutropenia</rdfs:label>
        <skos:broadMatch>ICD-10:D64.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A73</skos:broadMatch>
        <skos:exactMatch>MONDO:0010444</skos:exactMatch>
        <skos:exactMatch>OMIM:300835</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190600</skos:exactMatch>
    </owl:Class>

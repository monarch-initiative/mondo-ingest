        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An acromelic dysplasia that is characterized by severe brachydactyly, peripheral dysostosis with facial dysostosis, nasal hypoplasia, and developmental delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Acrodysostosis</oboInOwl:hasExactSynonym>

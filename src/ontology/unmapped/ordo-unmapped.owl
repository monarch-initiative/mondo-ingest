        <owl:annotatedTarget>Squamous cell carcinoma of liver and intrahepatic biliary tract</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <skos:narrowMatch>OMIM:607681</skos:narrowMatch>
        <skos:narrowMatch>OMIM:611942</skos:narrowMatch>
        <skos:narrowMatch>OMIM:612269</skos:narrowMatch>
    </owl:Class>

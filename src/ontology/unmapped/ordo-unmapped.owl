        <obo:IAO_0000115 xml:lang="en">A rare, hereditary ataxia disorder characterized by the presence of spastic ataxia in association with bilateral congenital cataract, macular corneal dystrophy (stromal with deposition of mucoid material) and nonaxial myopia. Patients present normal intellectual development. There have been no further descriptions in the literature since 1986.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bedouin spastic ataxia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mousa-Al Din-Al Nassar syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spastic ataxia-corneal dystrophy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spastic ataxia-ocular anomalies syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Spastic ataxia-corneal dystrophy syndrome</rdfs:label>

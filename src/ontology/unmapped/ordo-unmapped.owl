    <!-- http://www.orpha.net/ORDO/Orphanet_319234 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319234">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_341"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Venezuelan hemorrhagic fever (VHF), caused by the Guanarito virus, is a viral hemorrhagic disease characterized by fever, headache, arthralgia, sore throat, convulsions, and hemorrhagic manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Guanarito hemorrhagic fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Venezuelan hemorrhagic fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Venezuelan hemorrhagic fever</rdfs:label>
        <skos:broadMatch>ICD-10:A96.8</skos:broadMatch>

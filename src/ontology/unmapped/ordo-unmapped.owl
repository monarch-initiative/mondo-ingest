        <oboInOwl:hasExactSynonym>del(6)(p22)</oboInOwl:hasExactSynonym>
        <rdfs:label>6p22 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.61</skos:broadMatch>
        <skos:exactMatch>MONDO:0016655</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304528</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_329195 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329195">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180772"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1059">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140162"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183478"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_228308 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_228308">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_157"/>

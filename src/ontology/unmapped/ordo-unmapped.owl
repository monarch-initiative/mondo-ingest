    <!-- http://www.orpha.net/ORDO/Orphanet_444092 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_444092">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264699"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264992"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271870"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_280373"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_567556"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic systemic or rheumatologic disease characterized by interstitial lung disease (often with pulmonary hemorrhage) and inflammatory arthritis, associated with high-titer autoantibodies (including anti-nuclear and anti-neutrophil cytoplasmic antibodies, and rheumatoid factor). Patients present from infancy to adolescence with tachypnea, cough, hemoptysis, and/or joint pain. Some patients may also develop glomerular disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autoimmune interstitial lung disease-arthritis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">COPA syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Autoimmune interstitial lung disease-arthritis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:M35.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:CB05.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0014629</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083948</skos:exactMatch>
        <skos:exactMatch>OMIM:616414</skos:exactMatch>
        <skos:exactMatch>UMLS:C5243948</skos:exactMatch>
    </owl:Class>

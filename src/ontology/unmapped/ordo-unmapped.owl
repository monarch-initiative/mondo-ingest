    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1113 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1113">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294955"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404574"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">An extremely rare malformation syndrome characterized by the association of partial distal aphalangia with syndactyly, duplication of metatarsal IV, microcephaly, and mild intellectual disability.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aphalangy-syndactyly-microcephaly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Aphalangy-syndactyly-microcephaly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0010882</skos:exactMatch>
        <skos:exactMatch>OMIM:600384</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304033</skos:exactMatch>
    </owl:Class>

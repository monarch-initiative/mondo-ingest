    <!-- http://www.orpha.net/ORDO/Orphanet_3196 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3196">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101940"/>

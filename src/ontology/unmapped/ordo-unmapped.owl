            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11916"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Tumor necrosis factor receptor 1 associated periodic syndrome (TRAPS) is a periodic fever syndrome, characterized by recurrent fever, arthralgia, myalgia and tender skin lesions lasting for 1 to 3 weeks, associated with skin, joint, ocular and serosal inflammation and complicated by secondary amyloidosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial Hibernian fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TNF receptor 1-associated periodic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TRAPS syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tumor necrosis factor receptor 1 associated periodic syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Tumor necrosis factor receptor 1 associated periodic syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E85.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:4A60.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0007727</skos:exactMatch>
        <skos:exactMatch>MONDO:7727</skos:exactMatch>
        <skos:exactMatch>MedDRA:10067774</skos:exactMatch>
        <skos:exactMatch>OMIM:142680</skos:exactMatch>
        <skos:exactMatch>UMLS:C1275126</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

    <!-- http://www.orpha.net/ORDO/Orphanet_2238 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2238">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181405"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_300319 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300319">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

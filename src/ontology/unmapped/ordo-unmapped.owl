    <!-- http://www.orpha.net/ORDO/Orphanet_289548 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_289548">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101960"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2590"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Inherited isolated adrenal insufficiency due to partial CYP11A1 deficiency is a rare, genetic, chronic, primary adrenal insufficiency disorder, due to partial loss-of-function CYP11A1 mutations, characterized by early-onset adrenal insufficiency without associated abnormal external male genitalia. Patients present with signs of adrenal crisis, including electrolite abnormalities, severe weakness, recurrent vomiting and seizures. Ultrasound reveals absent (or very small) adrenal glands.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Inherited isolated adrenal insufficiency due to partial CYP11A1 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Inherited isolated adrenal insufficiency due to partial CYP11A1 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E27.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A74.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:613743</skos:broadMatch>
        <skos:exactMatch>MONDO:0017337</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707238</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

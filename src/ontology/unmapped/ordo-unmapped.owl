        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93440"/>
        <obo:IAO_0000115 xml:lang="en">An extremely rare, lethal, primary bone dysplasia characterized by thin ribs, thin long bones, high-arched palate and facial features of frontal bossing and low-set, posteriorly rotated ears. Bilateral cryptorchidism may be also observed. There have been no further descriptions in the literature since 1990.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Sharma-Kapoor-Ramji syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Thin ribs-tubular bones-dysmorphism syndrome</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Isolated ectopia lentis (IEL) is a rare, clinically variable, eye disorder characterized by dislocation of the lens, often causing significant reduction in visual acuity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ectopia lentis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial ectopia lentis</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_93388 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93388">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498451"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4220"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5956"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, congenital limb malformation characterized by shortened or underdeveloped middle phalanges of all digits, that are sometimes fused with the terminal phalanges. The proximal phalanges of the thumbs and big toes are also shortened. Short stature in adulthood has been reported in association.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Brachydactyly type A1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Brachydactyly, Farabee type</oboInOwl:hasExactSynonym>
        <rdfs:label>Brachydactyly type A1</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0007215</skos:exactMatch>
        <skos:exactMatch>MeSH:C537088</skos:exactMatch>
        <skos:exactMatch>OMIM:112500</skos:exactMatch>
        <skos:exactMatch>UMLS:C1862151</skos:exactMatch>
        <skos:narrowMatch>OMIM:607004</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615072</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616849</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93388"/>

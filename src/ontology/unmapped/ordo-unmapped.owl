    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_572 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_572">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_718053"/>

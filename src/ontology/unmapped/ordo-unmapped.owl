        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, non-syndromic cerebral malformation due to abnormal neuronal migration characterized by variable clinical manifestation depending on the location, size and thickness of subcortical bands. Clinical presentation ranges from mild cognitive deficit to developmental delay with severe intellectual disability, seizures and behavioral problems.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Subcortical band heterotopia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Subcortical laminar heterotopia</oboInOwl:hasExactSynonym>
        <rdfs:label>Subcortical band heterotopia</rdfs:label>

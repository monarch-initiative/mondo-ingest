    <!-- http://www.orpha.net/ORDO/Orphanet_280333 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280333">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102015"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371040"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371047"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2666"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of limb-girdle muscular dystrophy characterized by slowly-progressive, mainly proximal, muscle weakness presenting in early childhood (with difficulties walking and climbing stairs) and mild to severe intellectual disability. Additional manifestations reported include microcephaly, mild increase in thigh or calf muscles, and contractures of the ankles.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Alpha-dystroglycan-related LGMD R16</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Alpha-dystroglycan-related limb-girdle muscular dystrophy R16</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive limb-girdle muscular dystrophy type 2P</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD type 2P</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD2P</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Limb-girdle muscular dystrophy type 2P</oboInOwl:hasExactSynonym>
        <rdfs:label>Alpha-dystroglycan-related limb-girdle muscular dystrophy R16</rdfs:label>
        <skos:broadMatch>ICD-10:G71.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0013440</skos:exactMatch>
        <skos:exactMatch>OMIM:613818</skos:exactMatch>
        <skos:exactMatch>UMLS:C4511963</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

    <!-- http://www.orpha.net/ORDO/Orphanet_100069 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100069">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_282"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

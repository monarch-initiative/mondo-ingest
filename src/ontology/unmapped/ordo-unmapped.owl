    <!-- http://www.orpha.net/ORDO/Orphanet_59306 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_59306">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217619"/>

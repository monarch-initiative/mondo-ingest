    <!-- http://www.orpha.net/ORDO/Orphanet_1531 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1531">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183542"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_364559"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404568"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98038"/>
        <obo:IAO_0000115 xml:lang="en">Craniosynostosis is defined as the premature fusion of one or more cranial sutures leading to secondary distortion of skull shape resulting in skull deformities with a variable presentation. Craniosynostosis may occur in an isolated setting or as part of a syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Craniosynostosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Craniosynostosis</rdfs:label>
        <skos:exactMatch>ICD-10:Q75.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:LB70.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0015469</skos:exactMatch>
        <skos:exactMatch>MONDO:15469</skos:exactMatch>
        <skos:exactMatch>MeSH:D003398</skos:exactMatch>
        <skos:exactMatch>MedDRA:10049889</skos:exactMatch>
        <skos:exactMatch>UMLS:C0010278</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        <obo:IAO_0000115 xml:lang="en">A rare neuroendocrine neoplasm (NEN) characterized by severe peptic disease (ulcers/esophageal disease) caused by hypergastrinemia secondary to a gastrin-secreting NEN (gastrinoma) resulting in increased gastric acid secretion.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Gastrinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Zollinger-Ellison syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Zollinger-Ellison syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E16.4</skos:broadMatch>
        <skos:exactMatch>ICD-11:5A43.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0019610</skos:exactMatch>
        <skos:exactMatch>MeSH:D015043</skos:exactMatch>
        <skos:exactMatch>MedDRA:10017852</skos:exactMatch>
        <skos:exactMatch>UMLS:C0043515</skos:exactMatch>
    </owl:Class>

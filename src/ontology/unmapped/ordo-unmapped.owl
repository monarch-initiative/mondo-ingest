            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare photodermatosis characterized by cutaneous photosensitivity and slight dyspigmentation, without an increased risk of developing skin tumors. Telangiectasia may also be observed, but no other clinical abnormalities. Patients present in infancy or childhood, mode of inheritance is autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>UV-sensitive syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>UV-sensitive syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:L98.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EJ30.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015797</skos:exactMatch>
        <skos:exactMatch>MeSH:C563466</skos:exactMatch>
        <skos:exactMatch>UMLS:C1833561</skos:exactMatch>
        <skos:narrowMatch>OMIM:600630</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614621</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614640</skos:narrowMatch>
    </owl:Class>

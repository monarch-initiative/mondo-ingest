        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary headache disorder characterized by unilateral trigeminal pain that occurs in association with ipsilateral cranial autonomic symptoms (conjunctival injection and tearing).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>SUNCT syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Short-lasting unilateral neuralgiform headache attacks with conjunctival injection and tearing</oboInOwl:hasExactSynonym>
        <rdfs:label>SUNCT syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G44.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A82</skos:broadMatch>
        <skos:exactMatch>MONDO:0018927</skos:exactMatch>
        <skos:exactMatch>MeSH:D050798</skos:exactMatch>
        <skos:exactMatch>MedDRA:10061981</skos:exactMatch>
        <skos:exactMatch>UMLS:C1262087</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_444316 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_444316">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399158"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bone disease characterized by bone resorption affecting the distal phalanx, most commonly the terminal tuft, in the absence of a known cause. Patients present with shortening of the affected fingers or toes, associated with nail abnormalities (dystrophic or hypertrophic nails) and skin changes (such as ulceration or pigment anomalies).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Idiopathic phalangeal acro-osteolysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic phalangeal acroosteolysis</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic phalangeal acro-osteolysis</rdfs:label>
        <skos:broadMatch>ICD-10:M89.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB86.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0018635</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680064</skos:exactMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_659681"/>
        <obo:IAO_0000115 xml:lang="en">A rare porphyria characterized by a pre-existing myeloid disorder, skin fragility and blistering on the exposed areas, and hemorrhagic bullae typically on the back of the hands. Urine, plasma and fecal porphyrins are increased.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Erythropoietic uroporphyria associated with myeloid malignancy</oboInOwl:hasExactSynonym>

    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_180122 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_180122">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180065"/>

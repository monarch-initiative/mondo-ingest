        <skos:broadMatch>ICD-11:LD41.70</skos:broadMatch>
        <skos:exactMatch>MONDO:0016458</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304504</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_631 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_631">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

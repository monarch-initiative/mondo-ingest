            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation mainly characterized by unilateral or bilateral cryptophthalmos, syndactyly and urogenital anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cryptophthalmos-syndactyly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fraser syndrome</oboInOwl:hasExactSynonym>

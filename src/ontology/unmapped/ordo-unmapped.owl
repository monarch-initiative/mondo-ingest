            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomaly syndrome characterized by congenital diaphragmatic hernia (CDH) and pulmonary hypoplasia, distal limb hypoplasia and facial anomalies in addition to variable expression of additional birth defects.</obo:IAO_0000115>

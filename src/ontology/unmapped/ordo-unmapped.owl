    <!-- http://www.orpha.net/ORDO/Orphanet_97548 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97548">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108973"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271853"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_450"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4214"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of heterotaxy characterized by both atrial appendages having the morphology of a right atrial appendage, often associated with two morphologically right lungs and/or bronchi, and asplenia. Associated cardiovascular defects are frequent, including dextrocardia or mesocardia, common atrioventricular junction (atrioventricular septal defect), ventricular hypoplasia in half of cases, anomalous ventriculo-arterial connections (malposition or transposition of the great arteries), anomalous systemic and pulmonary venous connections (total anomalous pulmonary venous return), absent coronary sinus, and frequent subpulmonary stenosis. Cardiac arrhythmias are frequently observed. Typical extracardiac anomalies are midline liver, intestinal malrotation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ivemark syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RAI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Right atrial isomerism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Right isomerism</oboInOwl:hasExactSynonym>
        <rdfs:label>Right isomerism</rdfs:label>
        <skos:broadMatch>ICD-10:Q20.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA8Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008832</skos:exactMatch>
        <skos:exactMatch>MedDRA:10068335</skos:exactMatch>
        <skos:exactMatch>UMLS:C3178806</skos:exactMatch>
        <skos:narrowMatch>OMIM:208530</skos:narrowMatch>
        <skos:narrowMatch>OMIM:621079</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97548"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Right isomerism</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



    <!-- http://www.orpha.net/ORDO/Orphanet_1522 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1522">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183542"/>

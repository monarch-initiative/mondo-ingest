        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_101004 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_101004">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100982"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/22993"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A very rare, pure form of spastic paraplegia characterized by an onset in infancy of lower limb spasticity associated with gait disturbances, scissor gait, tiptoe walking, clonus and increased deep tendon reflexes. Mild upper limb involvement may occasionally also be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive spastic paraplegia type 24</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG24</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive spastic paraplegia type 24</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0011862</skos:exactMatch>
        <skos:exactMatch>MeSH:C564375</skos:exactMatch>
        <skos:exactMatch>OMIM:607584</skos:exactMatch>
        <skos:exactMatch>UMLS:C1843569</skos:exactMatch>
    </owl:Class>

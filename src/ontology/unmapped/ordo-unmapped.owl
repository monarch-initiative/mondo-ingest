    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90674">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_226298"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95488"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12372"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A type of central congenital hypothyroidism, a permanent thyroid deficiency that is present from birth, characterized by low levels of thyroid hormones due to a deficiency in TSH synthesis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated TSH deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated thyroid-stimulating hormone deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated thyrotropin deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated thyroid-stimulating hormone deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E03.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A00.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0010139</skos:exactMatch>
        <skos:exactMatch>MeSH:C000610012</skos:exactMatch>
        <skos:exactMatch>OMIM:275100</skos:exactMatch>
        <skos:exactMatch>UMLS:C4082174</skos:exactMatch>
    </owl:Class>

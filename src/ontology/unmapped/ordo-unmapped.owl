    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2941 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2941">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269523"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Porencephaly-cerebellar hypoplasia-internal malformations syndrome is rare central nervous system malformation syndrome characterized by bilateral porencephaly, absence of the septum pellucidum and cerebellar hypoplasia with absent vermis. Additionally, dysmorphic facial features (hypertelorism, epicanthic folds, high arched palate, prominent metopic suture), macrocephaly, corneal clouding, situs inversus, tetralogy of Fallot, atrial septal defects and/or seizures have been observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bonnemann-Meinecke syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Porencephaly-cerebellar hypoplasia-internal malformations syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Porencephaly-cerebellar hypoplasia-internal malformations syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0011036</skos:exactMatch>
        <skos:exactMatch>OMIM:601322</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796119</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2941"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Porencephaly-cerebellar hypoplasia-internal malformations syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

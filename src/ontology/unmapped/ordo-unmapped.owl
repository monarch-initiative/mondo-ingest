            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11647"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic primary bone dysplasia with increased bone density characterized by susceptibility to fractures after minor trauma, anemia, and characteristic skeletal radiographic changes, such as sandwich vertebra, bone-within-bone appearance, Erlenmeyer-shaped femoral metaphysis, and mild osteosclerosis of the skull base. Dental anomalies and visual impairment secondary to optic nerve compression have been rarely described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive intermediate osteopetrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Intermediate osteopetrosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Intermediate osteopetrosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0012679</skos:exactMatch>
        <skos:exactMatch>OMIM:611497</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432261</skos:exactMatch>
    </owl:Class>

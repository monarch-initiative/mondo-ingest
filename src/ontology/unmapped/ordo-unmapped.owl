    <!-- http://www.orpha.net/ORDO/Orphanet_289601 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_289601">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_233655"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary arterial and articular multiple calcification syndrome is a very rare genetic vascular disease of autosomal recessive inheritance, described in less than 20 patients to date, characterized by adult-onset (as early as the second decade of life) isolated calcification of the arteries of the lower extremities (including the iliac, femoral, and tibial arteries) as well as the capsule joints of the fingers, wrists, ankles and feet, and that usually manifests with mild paresthesias of the lower extremities, intense joint pain and swelling, and early onset arthritis of affected joints.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CALJA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Calcification of joints and arteries</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary arterial and articular multiple calcification syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary arterial and articular multiple calcification syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:I77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:BD52</skos:broadMatch>
        <skos:exactMatch>MONDO:0008895</skos:exactMatch>
        <skos:exactMatch>MeSH:C565891</skos:exactMatch>
        <skos:exactMatch>OMIM:211800</skos:exactMatch>
        <skos:exactMatch>UMLS:C1859372</skos:exactMatch>
    </owl:Class>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined oxidative phosphorylation defect type 21 is a rare mitochondrial disease characterized by axial hypotonia with limb hypertonia, developmental delay, hyperlactatemia, central nervous system anomalies visible on magnetic resonance imaging (e.g. corpus callosum hypoplasia, lesions of the globus pallidus) and multiple deficiency of the mitochondrial respiratory chain complexes in muscle tissue, but not in fibroblasts or liver.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COXPD21</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Combined oxidative phosphorylation defect type 21</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined oxidative phosphorylation defect type 21</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.23</skos:broadMatch>
        <skos:exactMatch>MONDO:0014398</skos:exactMatch>
        <skos:exactMatch>OMIM:615918</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706316</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_1471 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1471">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183557"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716422"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98553"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation syndrome characterized by the combination of bilateral coloboma of macula with horizontal pendular nystagmus and severe visual loss, and brachydactyly type B. The hand and feet defects comprise of shortening of the middle and terminal phalanges of the second to fifth digits, hypoplastic or absent nails (congenital anonychia), broad or bifid thumbs and halluces, syndactyly and flexion deformities of the joints of some digits.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Coloboma of macula-brachydactyly type B syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sorsby syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Sorsby syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007353</skos:exactMatch>
        <skos:exactMatch>MeSH:C535969</skos:exactMatch>
        <skos:exactMatch>OMIM:120400</skos:exactMatch>
        <skos:exactMatch>UMLS:C1852752</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1471"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2331 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2331">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156143"/>

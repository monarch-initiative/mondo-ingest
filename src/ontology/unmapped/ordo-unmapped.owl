    <!-- http://www.orpha.net/ORDO/Orphanet_1521 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1521">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180193"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_1493 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1493">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183469"/>

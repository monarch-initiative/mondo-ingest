            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive inborn error of metabolism characterized by increased urinary excretion of dicarboxylic amino acids, glutamate and aspartate, that can be associated with kidney stones and neuropsychiatric manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dicarboxylic aminoaciduria</oboInOwl:hasExactSynonym>

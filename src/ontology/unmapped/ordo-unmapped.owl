    <!-- http://www.orpha.net/ORDO/Orphanet_169793 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_169793">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98879"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98623"/>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of the anterior segment of the eye, characterized by a severe recurrent allergic reaction affecting the cornea and the conjunctiva. It presents with red eyes, ocular itching, photophobia, foreign body sensation, mucous discharge, blepharospasm, and blurring of vision. The symptoms are typically bilateral but may be asymmetric. Characteristic signs include conjunctival injection, giant papillae mostly on the upper tarsal conjunctiva (cobblestone appearance), limbal gelatinous infiltrates (Horner-Trantas dots), and variable corneal signs. The condition is more prevalent in hot climates and most commonly affects young boys.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Spring catarrh</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vernal keratoconjunctivitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Vernal keratoconjunctivitis</rdfs:label>
        <skos:broadMatch>ICD-10:H16.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:9A60.5</skos:exactMatch>
        <skos:exactMatch>MONDO:0019085</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0022577</skos:exactMatch>
    </owl:Class>

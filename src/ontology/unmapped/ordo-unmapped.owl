        <owl:annotatedTarget>Alar cartilages hypoplasia-coloboma-telecanthus syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2008 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2008">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139039"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disorder characterized by split-hand/split-foot malformation (SHFM), facial anomalies, cleft lip/palate, congenital heart defect (CHD), genital anomalies, and intellectual deficit.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ACFS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acrocardiofacial syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CCGE syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cleft palate-cardiac defect-genital anomalies-ectrodactyly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Acrocardiofacial syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010890</skos:exactMatch>
        <skos:exactMatch>MeSH:C563936</skos:exactMatch>
        <skos:exactMatch>OMIM:600460</skos:exactMatch>
        <skos:exactMatch>UMLS:C1838121</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2008"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_1035 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1035">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377790"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_447874"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79173"/>
        <obo:IAO_0000115 xml:lang="en">An extremely rare disorder of methionine cycle and sulfur amino acid metabolism characterized by increased urine excretion of beta-mercaptolactate-cysteine disulfide (due to deficiency of mercaptopyruvate sulfurtransferase activity in erythrocytes), leading to a positive cyanide nitroprusside test. Association with intellectual disability, congenital lens dislocation, and behavioral abnormalities has been reported, however the causal link remains to be established. There have been no further descriptions in the literature since 1981.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">3-mercaptopyruvate sulfurtransferase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ampola syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Beta-mercaptolactate cysteine disulfiduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MCDU</oboInOwl:hasExactSynonym>
        <rdfs:label>Beta-mercaptolactate cysteine disulfiduria</rdfs:label>
        <skos:broadMatch>ICD-10:E72.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.B</skos:broadMatch>
        <skos:exactMatch>MONDO:0009585</skos:exactMatch>
        <skos:exactMatch>OMIM:249650</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796055</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1035"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Beta-mercaptolactate cysteine disulfiduria</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1037 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1037">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_109007"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_723416"/>
        <obo:IAO_0000115 xml:lang="en">A group of disorders characterized by congenital limb contractures manifesting as limitation of movement of multiple limb joints at birth that is usually non-progressive and may include muscle weakness and fibrosis. This disorder is always associated with decreased intrauterine fetal movement which leads secondarily to the contractures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AMC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Arthrogryposis multiplex congenita</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple congenital arthrogryposis</oboInOwl:hasExactSynonym>
        <rdfs:label>Arthrogryposis multiplex congenita</rdfs:label>
        <skos:exactMatch>ICD-10:Q74.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0015168</skos:exactMatch>
        <skos:exactMatch>MONDO:15168</skos:exactMatch>
        <skos:exactMatch>MedDRA:10051643</skos:exactMatch>
        <skos:exactMatch>UMLS:C5779613</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1037"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Arthrogryposis multiplex congenita</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_103907 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_103907">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104006"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309001"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare intestinal disease characterized by impaired absorption of starch and short polymers of glucose due to primary small intestinal glucoamylase deficiency. Patients present in infancy or early childhood with chronic diarrhea, abdominal distention, and bloating. Levels of pancreatic amylase are typically normal, and histopathological analysis shows normal morphology of the intestinal mucosa.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Chronic diarrhea due to glucoamylase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maltase-glucoamylase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Chronic diarrhea due to glucoamylase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C61.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0015169</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275068</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_103907"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Chronic diarrhea due to glucoamylase deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_103908 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_103908">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104003"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363300"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717851"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_73014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11073"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4688"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, non-syndromic intestinal transport defect characterized by congenital onset of severe watery diarrhea containing high concentrations of sodium, hyponatremia and metabolic acidosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CSD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital sodium diarrhea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NHE3 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Na-H exchanger 3 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-syndromic congenital sodium diarrhea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sodium/proton exchanger-3 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital sodium diarrhea</rdfs:label>
        <skos:broadMatch>ICD-10:K90.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA90.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0015170</skos:exactMatch>
        <skos:exactMatch>UMLS:C0267663</skos:exactMatch>
        <skos:narrowMatch>OMIM:270420</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616868</skos:narrowMatch>
    </owl:Class>

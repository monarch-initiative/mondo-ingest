    <!-- http://www.orpha.net/ORDO/Orphanet_79395 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79395">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_281082"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_307773"/>

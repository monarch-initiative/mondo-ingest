    <!-- http://www.orpha.net/ORDO/Orphanet_2809 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2809">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98497"/>
        <obo:IAO_0000115 xml:lang="en">A rare peripheral neuropathy characterized by an acute onset of unilateral facial muscle weakness with Bell&apos;s phenomenon. It is non-progressive, resolves spontaneously, and it might be recurrent with no obvious precipitating factors.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial recurrent Bell palsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial recurrent peripheral facial palsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial recurrent peripheral facial palsy</rdfs:label>
        <skos:broadMatch>ICD-10:G51.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B88.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0007592</skos:exactMatch>

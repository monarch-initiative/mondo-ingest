    <!-- http://www.orpha.net/ORDO/Orphanet_75378 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_75378">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

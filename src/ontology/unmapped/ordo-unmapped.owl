    <!-- http://www.orpha.net/ORDO/Orphanet_51084 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_51084">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101934"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare variant of Torsade de pointes, a polymorphic ventricular tachycardia, which is characterized by a short coupling interval of the first TdP beat on electrocardiogram in the absence of any structural heart disease. It manifests in early adulthood with syncope, often results in ventricular fibrillation and shows a high risk of sudden cardiac death.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Torsade-de-pointes syndrome with short coupling interval</oboInOwl:hasExactSynonym>
        <rdfs:label>Torsade-de-pointes syndrome with short coupling interval</rdfs:label>
        <skos:broadMatch>ICD-10:I47.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:BC71.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0013317</skos:exactMatch>
        <skos:exactMatch>OMIM:613600</skos:exactMatch>
        <skos:exactMatch>UMLS:C3150851</skos:exactMatch>
    </owl:Class>

        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019022</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510044</skos:exactMatch>
    </owl:Class>

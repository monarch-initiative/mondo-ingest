        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurodevelopmental disorder characterized by neonatal hypotonia, global developmental delay, normal to accelerated growth, absent to severely delayed speech, and minor dysmorphic features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Phelan-McDermid syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Phelan-McDermid syndrome</rdfs:label>

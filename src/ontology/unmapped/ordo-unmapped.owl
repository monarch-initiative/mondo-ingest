    <!-- http://www.orpha.net/ORDO/Orphanet_100994 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100994">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_320342"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

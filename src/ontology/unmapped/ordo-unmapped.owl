        <skos:narrowMatch>OMIM:278700</skos:narrowMatch>
        <skos:narrowMatch>OMIM:278720</skos:narrowMatch>
        <skos:narrowMatch>OMIM:278730</skos:narrowMatch>
        <skos:narrowMatch>OMIM:278740</skos:narrowMatch>
        <skos:narrowMatch>OMIM:278760</skos:narrowMatch>
        <skos:narrowMatch>OMIM:278780</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610651</skos:narrowMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98646"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8108"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multisystem disorder characterized by congenital cataracts, glaucoma, intellectual disabilities, seizures, postnatal growth retardation and renal tubular dysfunction with chronic renal failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Lowe disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lowe oculo-cerebro-renal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lowe oculo-cerebro-renal syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lowe oculocerebrorenal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lowe syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OCRL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oculocerebrorenal syndrome of Lowe</oboInOwl:hasExactSynonym>
        <rdfs:label>Oculocerebrorenal syndrome of Lowe</rdfs:label>
        <skos:broadMatch>ICD-10:E72.0</skos:broadMatch>

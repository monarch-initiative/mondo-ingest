        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hemorrhagic disorder due to a constitutional haemostatic factors defect characterized by premature lysis of hemostatic clots and a moderate bleeding tendency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital PAI-1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital plasminogen activator inhibitor type 1 deficiency</oboInOwl:hasExactSynonym>

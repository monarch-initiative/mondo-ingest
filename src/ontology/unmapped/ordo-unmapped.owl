        <oboInOwl:hasExactSynonym xml:lang="en">LGMD D5 collagen VI-related dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD R22 collagen 6-related dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD R22 collagen VI-related dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mild form of COL6-related dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mild form of collagen VI-related dystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Bethlem muscular dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:G71.0</skos:broadMatch>

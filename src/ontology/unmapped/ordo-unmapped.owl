        <obo:IAO_0000115 xml:lang="en">Juberg-Hayward syndrome is a polymalformative syndrome that associates multiple skeletal anomalies with microcephaly, facial dysmorphism, urogenital anomalies and intellectual deficit.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cleft lip/palate-abnormal thumbs-microcephaly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Juberg-Hayward syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Orocraniodigital syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Juberg-Hayward syndrome</rdfs:label>

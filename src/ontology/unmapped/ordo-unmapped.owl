    <!-- http://www.orpha.net/ORDO/Orphanet_477650 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_477650">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182231"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_486955"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare rheumatologic disease characterized by sudden onset of symmetric inflammatory distal polyarthritis and multiple firm cutaneous nodules with predilection for the upper and lower extremities. Patients often develop sclerodactyly and joint contractures. Skin biopsy shows fibroblastic proliferation in a matrix of thickened collagen fibers, with loss of elastic fibers and no mucin deposition.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fibroblastic rheumatism</oboInOwl:hasExactSynonym>
        <rdfs:label>Fibroblastic rheumatism</rdfs:label>
        <skos:broadMatch>ICD-10:M06.4</skos:broadMatch>
        <skos:exactMatch>ICD-11:FB51.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0018783</skos:exactMatch>
        <skos:exactMatch>UMLS:C1302753</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_477650"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Fibroblastic rheumatism</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_477661 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_477661">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_695164"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717851"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive primary immunodeficiency characterized by infancy onset of severe inflammatory bowel disease with life-threatening diarrhea and failure to thrive, oral aphthous ulcers, and recurrent severe upper and lower respiratory tract infections with finger clubbing. Laboratory examination reveals increased IgE and decreased IgG levels, as well as reduced numbers of circulating CD19+ B-cells including IgM+ naive and class-switched IgG memory B-cells, with a concomitant increase in transitional B-cells, while T-cell numbers and function are normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">IL21-related infantile IBD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>IL21-related infantile inflammatory bowel disease</oboInOwl:hasExactSynonym>
        <rdfs:label>IL21-related infantile inflammatory bowel disease</rdfs:label>
        <skos:broadMatch>ICD-10:D84.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:DD7Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0014338</skos:exactMatch>
        <skos:exactMatch>OMIM:615767</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567788</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_477661"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>IL21-related infantile inflammatory bowel disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98749"/>
        <obo:IAO_0000115 xml:lang="en">A rare epilepsy syndrome characterized by adolescence/young adulthood onset of myoclonic with or without other generalized seizure types in an otherwise healthy individual. The electroencephalogram (EEG) shows 3-5.5&amp;nbsp;Hz generalized spike-waves and polyspike-waves. Photosensitivity is common.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">JME</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Juvenile myoclonic epilepsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile myoclonus epilepsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Juvenile myoclonic epilepsy</rdfs:label>
        <skos:broadMatch>ICD-10:G40.3</skos:broadMatch>
        <skos:broadMatch>OMIM:604827</skos:broadMatch>

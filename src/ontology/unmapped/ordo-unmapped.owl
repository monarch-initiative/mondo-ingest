    <!-- http://www.orpha.net/ORDO/Orphanet_85142 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85142">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C048"/>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Aldosterone-secreting adenoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Aldosteronoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Conn adenoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Primary aldosteronism due to Conn adenoma</oboInOwl:hasExactSynonym>

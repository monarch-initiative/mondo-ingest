        <obo:IAO_0000115 xml:lang="en">Dentin dysplasia-sclerotic bones syndrome is a rare, genetic odontologic disease characterized by the clinical, radiographic, and histologic features of dentine dysplasia and osteosclerosis of all long bones, with heavy cortical bone and narrowed or occluded marrow spaces. There have been no further descriptions in the literature since 1977.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dentin dysplasia-sclerotic bones syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Dentin dysplasia-sclerotic bones syndrome</rdfs:label>

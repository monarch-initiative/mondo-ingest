        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic syndrome with multiple congenital anomalies characterized by urogenital malformations, mainly hydrometrocolpos (HMC) in females, postaxial polydactyly (PAP) and congenital heart disease (CHD). The disorder is allelic with Bardet-Biedl syndrome&amp;nbsp;6 (BBS6).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hydrometrocolpos-postaxial polydactyly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Kaufman-Mckusick syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>McKusick-Kaufman syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>McKusick-Kaufman syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B70</skos:broadMatch>

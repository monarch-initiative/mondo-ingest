    <!-- http://www.orpha.net/ORDO/Orphanet_210110 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_210110">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2781"/>

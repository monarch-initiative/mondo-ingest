    <!-- http://www.orpha.net/ORDO/Orphanet_263455 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_263455">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165985"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

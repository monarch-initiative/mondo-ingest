                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2214"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare dystrophic epidermolysis bullosa (DEB) characterized by generalized blistering at birth that usually regresses within the first 6 to 24 months of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Self-improving DEB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Self-improving dystrophic epidermolysis bullosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Transient bullous dermolysis of the newborn</oboInOwl:hasExactSynonym>
        <rdfs:label>Self-improving dystrophic epidermolysis bullosa</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC32</skos:broadMatch>
        <skos:exactMatch>MONDO:0007548</skos:exactMatch>
        <skos:exactMatch>MeSH:C536979</skos:exactMatch>
        <skos:exactMatch>OMIM:131705</skos:exactMatch>
        <skos:exactMatch>UMLS:C1851573</skos:exactMatch>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8860"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8940"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A metabolic disease characterized by anosmia, cataract, early-onset retinitis pigmentosa and possible neurological manifestations, including peripheral neuropathy and cerebellar ataxia. Other features can be deafness, ichthyosis, skeletal abnormalities, and cardiac arrhythmia. It is characterized biochemically by accumulation of phytanic acid in plasma and tissues.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Adult Refsum disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic Refsum disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HMSN 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HMSN IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary motor and sensory neuropathy type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary motor and sensory neuropathy type IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Heredopathia atactica polyneuritiformis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phytanic-CoA hydroxylase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Adult Refsum disease</rdfs:label>
        <skos:broadMatch>ICD-11:5C57.1</skos:broadMatch>
        <skos:exactMatch>ICD-10:G60.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0009958</skos:exactMatch>
        <skos:exactMatch>MONDO:9958</skos:exactMatch>

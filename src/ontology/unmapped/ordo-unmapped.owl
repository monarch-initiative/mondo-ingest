            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, syndromic intellectual disability characterized by developmental delay, speech apraxia, autism with stereotypies, intellectual disability and unspecific dysmorphic facial features. Seizures or isolated EEG abnormalities may also be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Intellectual disability-autism-speech apraxia-craniofacial dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pilarowski-Bjornsson syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Intellectual disability-autism-speech apraxia-craniofacial dysmorphism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0060568</skos:exactMatch>
        <skos:exactMatch>MedDRA:10090383</skos:exactMatch>
        <skos:exactMatch>OMIM:617682</skos:exactMatch>
        <skos:exactMatch>UMLS:C4540131</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_529965"/>

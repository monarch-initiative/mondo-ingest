            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10593"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, cardiac rhythm disease characterized by ventricular fibrillation in the absence of any structural or functional heart disease, or known repolarization abnormalities. The presence of J waves is associated with a higher risk of nocturnal ventricular fibrillation events and a higher risk of recurrence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Idiopathic ventricular fibrillation</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic ventricular fibrillation</rdfs:label>
        <skos:broadMatch>ICD-10:I49.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:BC65.4</skos:exactMatch>
        <skos:exactMatch>OMIM:603829</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510132</skos:exactMatch>
        <skos:narrowMatch>OMIM:612956</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_228140"/>

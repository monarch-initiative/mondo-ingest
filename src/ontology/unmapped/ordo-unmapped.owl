    <!-- http://www.orpha.net/ORDO/Orphanet_228384 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_228384">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166469"/>

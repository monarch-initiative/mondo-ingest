    <!-- http://www.orpha.net/ORDO/Orphanet_100079 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100079">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_423982"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_481508"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare sporadic neoplasm of the appendix and the second most common type of digestive endocrine tumor, often with no specific clinical presentation. They are divided into either classic endocrine tumor of the appendix or the more aggressive goblet cell carcinoma (GCC).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Appendiceal NEN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Appendiceal neuroendocrine neoplasm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NEN of appendix</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neuroendocrine neoplasm of appendix</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuroendocrine neoplasm of appendix</rdfs:label>
        <skos:broadMatch>ICD-10:C18.1</skos:broadMatch>
        <skos:broadMatch>ICD-10:D37.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:2B81.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0015066</skos:exactMatch>
        <skos:exactMatch>MONDO:15066</skos:exactMatch>
        <skos:exactMatch>UMLS:C1879718</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100079"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neuroendocrine neoplasm of appendix</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100080 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100080">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_423991"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_481508"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare epithelial tumor of the large intestine, arising from enterochromaffin cells, most commonly in the cecum or ascending colon. The tumor is usually slow-growing and can be diagnosed as an incidental finding in an asymptomatic patient, while in the later stages patients can present with abdominal pain, palpable abdominal mass, changes in bowel habits, signs of bowel obstruction, gastrointestinal bleeding, anorexia, weight loss or, rarely, carcinoid syndrome (facial flushing, diarrhea, tachycardia, hypo- and hypertension, cardiac abnormalities).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Colonic NET</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NET of the colon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neuroendocrine neoplasm of the colon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neuroendocrine tumor of the colon</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuroendocrine tumor of the colon</rdfs:label>
        <skos:broadMatch>ICD-10:C18.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2B90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0002882</skos:exactMatch>
        <skos:exactMatch>UMLS:C1333097</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100080"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neuroendocrine tumor of the colon</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100081 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100081">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_423998"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_481508"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Neuroendocrine tumor of the rectum is a rare epithelial tumor of rectum arising from enterochromaffin cells, most often in the mid-rectum. The tumors are slow growing, in early stages majority are asymptomatic and are diagnosed incidentally. Later in the course, the tumor may present with rectal bleeding, abdominal or rectal pain, tenesmus, changes in bowel habits, or weight loss. In some cases it may present with carcinoid symptoms of flushing and increased gut motility.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">NET of the rectum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neuroendocrine tumor of the rectum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rectal NET</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rectal neuroendocrine tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuroendocrine tumor of the rectum</rdfs:label>
        <skos:broadMatch>ICD-10:C20</skos:broadMatch>
        <skos:exactMatch>ICD-11:2B92.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0003646</skos:exactMatch>
        <skos:exactMatch>MONDO:15068</skos:exactMatch>
        <skos:exactMatch>MONDO:3646</skos:exactMatch>
        <skos:exactMatch>MedDRA:10085767</skos:exactMatch>
        <skos:exactMatch>UMLS:C5554035</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100081"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neuroendocrine tumor of the rectum</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100082 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100082">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_424010"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_481508"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A are epithelial tumor of the anal canal arising from enterochromaffin cells in the colorectal-type epithelium above the dentate line and in the anal transition zone. The tumors are slow growing and the majority of cases are diagnosed in later advanced stages. It may present with symptoms related to the anatomical location of the tumor (rectal mass, rectal bleeding and pain, tenesmus or changes in bowel habits), symptoms of carcinoid syndrome (flushing and increased gut motility) or nonspecific symptoms of advanced disease (hepatomegaly, fever, weight loss, anorexia, malaise).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">NET of anal canal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neuroendocrine tumor of anal canal</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuroendocrine tumor of anal canal</rdfs:label>
        <skos:broadMatch>ICD-10:C21.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:2C00.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0015069</skos:exactMatch>
        <skos:exactMatch>UMLS:C3272849</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100082"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neuroendocrine tumor of anal canal</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100083 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100083">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100101"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98061"/>
        <obo:IAO_0000115 xml:lang="en">A rare head and neck tumor characterized by an epithelial neoplasm with evidence of neuroendocrine differentiation, typically located in the supraglottic larynx. The tumor can be well, moderately, or poorly differentiated, the latter group being subdivided into small cell or large cell neuroendocrine carcinomas. There is a strong association with tobacco use. Patients present with hoarseness, dysphagia, sore throat, airway obstruction, hemoptysis, and rarely a paraneoplastic syndrome due to aberrant hormone production. Poorly differentiated tumors are highly aggressive with high rates of regional and distant metastasis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Laryngeal neuroendocrine tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Laryngeal neuroendocrine tumor</rdfs:label>
        <skos:broadMatch>ICD-10:C32.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:2F00.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0015070</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681809</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100083"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Laryngeal neuroendocrine tumor</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100084 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100084">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100101"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98061"/>
        <obo:IAO_0000115 xml:lang="en">Middle ear neuroendocrine tumor is a rare, otorhinolaryngologic tumor characterized by a mixed glandular and non-glandular histological features and positive immunostaining for pancytokeratin, vimentin, synaptophysin and islet-1 protein. Common signs and symptoms are hearing loss, mass, pain, discharge, equilibrium disturbances, tinnitus and nerve paralysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Middle ear neuroendocrine tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Middle ear neuroendocrine tumor</rdfs:label>
        <skos:broadMatch>ICD-10:C30.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:2F00.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0015071</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305468</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100084"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

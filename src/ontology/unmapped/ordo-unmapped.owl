            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Vitamin B12-unresponsive methylmalonic acidemia type mut0 is an inborn error of metabolism characterized by recurrent ketoacidotic comas or transient vomiting, dehydration, hypotonia and intellectual deficit, which does not respond to administration of vitamin B12.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Complete deficiency of methylmalonyl-CoA mutase</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vitamin B12-unresponsive methylmalonic acidemia type mut0</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vitamin B12-unresponsive methylmalonic aciduria type mut0</oboInOwl:hasExactSynonym>
        <rdfs:label>Vitamin B12-unresponsive methylmalonic acidemia type mut0</rdfs:label>
        <skos:broadMatch>ICD-10:E71.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E0</skos:broadMatch>
        <skos:broadMatch>OMIM:251000</skos:broadMatch>

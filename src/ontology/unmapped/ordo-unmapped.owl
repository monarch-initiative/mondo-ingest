        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal disorder, characterized by childhood onset drug resistant epilepsy with typical electroencephalographic findings (EEG), mild to severe intellectual disability and behavioral problems.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ring 20</oboInOwl:hasExactSynonym>

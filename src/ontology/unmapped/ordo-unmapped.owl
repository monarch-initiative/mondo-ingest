    <!-- http://www.orpha.net/ORDO/Orphanet_411536 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_411536">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_3222"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9462"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A mild form of phosphoribosylpyrophosphate (PRPP) synthetase superactivity, an X-linked disorder of purine metabolism, characterized by adolescent or early adult-onset hyperuricemia and hyperuricosuria, leading to urolithiasis and gout.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Mild PRPP synthetase superactivity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mild PRPS1 superactivity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mild phosphoribosylpyrophosphate synthetase superactivity</oboInOwl:hasExactSynonym>
        <rdfs:label>Mild phosphoribosylpyrophosphate synthetase superactivity</rdfs:label>
        <skos:broadMatch>ICD-10:E79.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C55.0Y</skos:broadMatch>
        <skos:broadMatch>OMIM:300661</skos:broadMatch>
        <skos:exactMatch>MONDO:0018463</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680016</skos:exactMatch>
    </owl:Class>

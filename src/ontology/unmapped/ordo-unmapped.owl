    <!-- http://www.orpha.net/ORDO/Orphanet_276556 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_276556">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165985"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Gonadoblastoma is a rare benign neoplasm of mixed sex cord and germ cells, arising mostly in the dysgenic gonads of young women with a chromosome Y anomaly, presenting with abdominal enlargement, variable feminization or virilization or, in some cases, being asymptomatic. It is often associated with dysgerminoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Gonadoblastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Gonadoblastoma</rdfs:label>
        <skos:broadMatch>ICD-10:D39.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0002697</skos:exactMatch>
        <skos:exactMatch>MeSH:D018238</skos:exactMatch>
        <skos:exactMatch>OMIM:424500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0206661</skos:exactMatch>
    </owl:Class>

        <skos:exactMatch>MONDO:0006277</skos:exactMatch>
        <skos:exactMatch>MeSH:D018192</skos:exactMatch>
        <skos:exactMatch>MedDRA:10049459</skos:exactMatch>
        <skos:exactMatch>OMIM:606690</skos:exactMatch>
        <skos:exactMatch>UMLS:C0751674</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_538"/>

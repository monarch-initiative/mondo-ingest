                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Periodic paralysis with later-onset distal motor neuropathy is a rare, genetic, neuromuscular disease characterized by acute episodic muscle weakness in upper and lower extremities (which responds to acetazolamide treatment) associated with later-onset, chronic, slowly progressive, distal, axonal neuropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Periodic paralysis with later-onset distal motor neuropathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Periodic paralysis with later-onset distal motor neuropathy</rdfs:label>
        <skos:broadMatch>ICD-10:G72.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C74.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018343</skos:exactMatch>
        <skos:exactMatch>OMIM:500010</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751573</skos:exactMatch>
    </owl:Class>

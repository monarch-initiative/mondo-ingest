                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4249"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4817"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5213"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of Perrault syndrome characterized by sensorineural, generally bilateral, prelingual, progressive and sometimes asymmetric hearing loss, primary ovarian dysgenesis in females and neurological features of variable severity including cerebellar dysfunction/athrophy with ataxia, intellectual disability, neuropathy and behavioral symptoms. Additional clinical features may involve developmental delay, muscular and renal manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Perrault syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XX gonadal dysgenesis-deafness syndrome-progressive neurological manifestations</oboInOwl:hasExactSynonym>
        <rdfs:label>Perrault syndrome type 2</rdfs:label>
        <skos:exactMatch>MONDO:0013972</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816795</skos:exactMatch>
    </owl:Class>

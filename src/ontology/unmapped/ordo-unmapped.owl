        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68354"/>
        <obo:IAO_0000115 xml:lang="en">Kleine-Levin syndrome (KLS) is a rare neurological disorder of unknown origin characterised by relapsing-remitting episodes of hypersomnia in association with cognitive and behavioural disturbances.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Kleine-Levin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Kleine-Levin syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G47.8</skos:broadMatch>

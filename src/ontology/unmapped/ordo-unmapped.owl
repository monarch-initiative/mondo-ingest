    <!-- http://www.orpha.net/ORDO/Orphanet_2482 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2482">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

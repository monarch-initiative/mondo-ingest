    <!-- http://www.orpha.net/ORDO/Orphanet_57196 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_57196">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399319"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bone disease characterized by benign, usually unilateral, sclerosis of the inferomedial third of the clavicle. Patients present with localized swelling and persistent pain. Typical radiographic findings are expansion of the medial end of the clavicle with increased radio-density and signs of bone remodeling.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Medial condensing osteitis of the clavicle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteitis condensans of the clavicle</oboInOwl:hasExactSynonym>
        <rdfs:label>Medial condensing osteitis of the clavicle</rdfs:label>
        <skos:broadMatch>ICD-10:M85.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB72.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018929</skos:exactMatch>
        <skos:exactMatch>UMLS:C5396729</skos:exactMatch>
    </owl:Class>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247667 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247667">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139393"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_436"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, moderate form of hypophosphatasia (HPP) characterized by onset after six months of age and widely variable clinical features from low bone mineral density for age, to unexplained fractures, skeletal deformities, and rickets with short stature and waddling gait.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Childhood-onset Rathbun disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Childhood-onset hypophosphatasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Childhood-onset phosphoethanolaminuria</oboInOwl:hasExactSynonym>
        <rdfs:label>Childhood-onset hypophosphatasia</rdfs:label>
        <skos:broadMatch>ICD-10:E83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.3</skos:broadMatch>
        <skos:exactMatch>MeSH:C562440</skos:exactMatch>
        <skos:exactMatch>OMIM:241510</skos:exactMatch>
        <skos:exactMatch>UMLS:C0220743</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247667"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Childhood-onset hypophosphatasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247676 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247676">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_436"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A moderate form of hypophosphatasia (HPP) characterized by adult onset osteomalacia, chondrocalcinosis, osteoarthropathy, stress fractures and dental anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult Rathbun disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Adult hypophosphatasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult phosphoethanolaminuria</oboInOwl:hasExactSynonym>
        <rdfs:label>Adult hypophosphatasia</rdfs:label>
        <skos:broadMatch>ICD-10:E83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.3</skos:broadMatch>
        <skos:exactMatch>MeSH:C562647</skos:exactMatch>
        <skos:exactMatch>OMIM:146300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268413</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247676"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Adult hypophosphatasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247685 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247685">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_436"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A particular form of hypophosphatasia (HPP) characterized by reduced activity of unfractionated serum alkaline phosphatase, premature exfoliation of primary and/or permanent teeth and/or severe dental caries, in the absence of skeletal system abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Odontohypophosphatasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Odontohypophosphatasia</rdfs:label>
        <skos:broadMatch>ICD-10:E83.3</skos:broadMatch>
        <skos:broadMatch>OMIM:146300</skos:broadMatch>
        <skos:exactMatch>MONDO:0016607</skos:exactMatch>
        <skos:exactMatch>MeSH:C564146</skos:exactMatch>
        <skos:exactMatch>UMLS:C1840322</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247685"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Odontohypophosphatasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247691 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247691">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_477647"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_477754"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716459"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717348"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12269"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic cerebral small vessel disease characterized by progressive loss of visual acuity due to retinal vasculopathy, in combination with more variable neurological signs and symptoms including stroke, cognitive decline, migraine-like headaches, and seizures, among others, typically beginning in middle age. Psychiatric features such as depression and anxiety may also occur. Systemic vascular involvement with Raynaud phenomenon, micronodular liver cirrhosis, and glomerular kidney dysfunction is present in a subset of patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">RVCL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RVCL-S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Retinal vasculopathy and cerebral leukoencephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Retinal vasculopathy with cerebral leukoencephalopathy and systemic manifestations</oboInOwl:hasExactSynonym>
        <rdfs:label>Retinal vasculopathy with cerebral leukoencephalopathy and systemic manifestations</rdfs:label>
        <skos:broadMatch>ICD-10:I77.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:9B78.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0008641</skos:exactMatch>
        <skos:exactMatch>MeSH:C566007</skos:exactMatch>
        <skos:exactMatch>OMIM:192315</skos:exactMatch>
        <skos:exactMatch>UMLS:C1860518</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247691"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Retinal vasculopathy with cerebral leukoencephalopathy and systemic manifestations</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247698 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247698">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100091"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_653"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9967"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of multiple endocrine neoplasia type 2 (MEN2) syndrome characterized by medullary thyroid carcinoma in association with pheochromocytoma (one or both adrenal glands can be affected) and/or primary hyperparathyroidism (caused by parathyroid adenoma). Onset is typically later than in MEN2B, before 35 years of age. Diarrhea is the most frequent systemic symptom. Patients can develop Hirschsprung disease and, less frequently, cutaneous lichen amyloidosis or excessive production of adrenocorticotropic hormone.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MEN2A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple endocrine neoplasia type 2A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PTC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sipple syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple endocrine neoplasia type 2A</rdfs:label>
        <skos:broadMatch>ICD-10:D44.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F7A.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008234</skos:exactMatch>
        <skos:exactMatch>MeSH:D018813</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073148</skos:exactMatch>
        <skos:exactMatch>OMIM:171400</skos:exactMatch>
        <skos:exactMatch>UMLS:C0025268</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247698"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Multiple endocrine neoplasia type 2A</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2477 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2477">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_199633"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269553"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/21066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare central nervous system malformation characterized by an abnormally large brain, accompanied by abnormal head circumference measurements evident at birth or developing over the first years of life. The condition can be unilateral or bilateral and affects males more often than females. There is no typical pattern of symptoms, but mental retardation, seizures, and other neurologic abnormalities have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated megalencephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated megalencephaly</rdfs:label>
        <skos:exactMatch>ICD-10:Q04.5</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA05.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0016608</skos:exactMatch>
        <skos:exactMatch>UMLS:C2720434</skos:exactMatch>
        <skos:narrowMatch>OMIM:155350</skos:narrowMatch>
        <skos:narrowMatch>OMIM:248000</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2477"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Isolated megalencephaly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247709 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247709">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100091"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_653"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9967"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of multiple endocrine neoplasia type 2 (MEN2) syndrome characterized by aggressive medullary thyroid carcinoma in association with other endocrine tumors, notably pheochromocytoma (one or both adrenal glands can be affected). Onset is typically in infancy or childhood and patients often have a typical facies (mucosal neuromas of the lips and tongue, and bumpy lips), ophthalmologic abnormalities (alacrima in infancy, thickened and everted eyelids, mild ptosis, and prominent corneal nerves), skeletal anomalies (marfanoid body habitus, narrow long facies, pes cavus, pectus excavatum, high-arched palate, scoliosis, hyperextensible joints and slipped capital femoral epiphyses), and a generalized ganglioneuromatosis throughout the aerodigestive tract. Chronic constipation, abdominal distension, diarrhea, or megacolon at birth are often the initial manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MEN2B</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple endocrine neoplasia type 2B</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple endocrine neoplasia type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wagenmann-Froboese syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple endocrine neoplasia type 2B</rdfs:label>
        <skos:broadMatch>ICD-10:D44.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F7A.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008082</skos:exactMatch>
        <skos:exactMatch>MeSH:D018814</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056420</skos:exactMatch>
        <skos:exactMatch>OMIM:162300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0025269</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247709"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Multiple endocrine neoplasia type 2B</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247718 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247718">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98482"/>
        <obo:IAO_0000115 xml:lang="en">A rare idiopathic inflammatory myopathy characterized by diffuse destructive infiltration of CD68+ macrophages into the fascia rather than muscle fibers in muscle biopsies, proximal muscle weakness and myalgia with or without scaly dermatomyositis-like or atypical non-dermatomyositis-like skin lesions, elevation of creatine kinase levels and thickening of muscle fascia in muscle MRI.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">IMAM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inflammatory myopathy with abundant macrophages</oboInOwl:hasExactSynonym>
        <rdfs:label>Inflammatory myopathy with abundant macrophages</rdfs:label>
        <skos:broadMatch>ICD-10:G72.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0016609</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707791</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247718"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Inflammatory myopathy with abundant macrophages</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247724 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247724">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98482"/>
        <obo:IAO_0000115 xml:lang="en">A rare idiopathic inflammatory myopathy characterized by eosinophilic infiltration and inflammatory lesions of the skeletal muscle tissue, in the absence of an identifiable causative factor (e.g. parasitic infection, drug intake, systemic or malignant disease). Clinically patients may present focal or generalized muscle weakness and pain, difficulties to walk, motor clumsiness and/or mild bilateral Achilles tendon contracture , as well as elevated serum creatine kinase levels and peripheral blood and/or bone marrow hypereosinophilia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic eosinophilia-associated myopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Idiopathic eosinophilic myositis</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic eosinophilic myositis</rdfs:label>
        <skos:broadMatch>ICD-10:M60.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0016610</skos:exactMatch>
        <skos:exactMatch>UMLS:C4755301</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247724"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Idiopathic eosinophilic myositis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247762 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247762">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_71209"/>
        <obo:IAO_0000115 xml:lang="en">A rare soft tissue tumor characterized by a lobulated, localized (lipoblastoma) or diffuse (lipoblastomatosis) lesion resembling fetal adipose tissue, composed of mature and immature adipocytes. It is most commonly found during the first years of life and presents as a slowly growing, well circumscribed mass, which may compress adjacent structures, depending on the location. Malignant transformation or metastasis does not occur, while recurrences are described especially in lipoblastomatosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lipoblastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Lipoblastoma</rdfs:label>
        <skos:broadMatch>ICD-10:D17.9</skos:broadMatch>
        <skos:exactMatch>ICD-11:2E80.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0016611</skos:exactMatch>
        <skos:exactMatch>MeSH:D062689</skos:exactMatch>
        <skos:exactMatch>MedDRA:10074547</skos:exactMatch>
        <skos:exactMatch>UMLS:C1260965</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247762"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lipoblastoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247765 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247765">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183518"/>

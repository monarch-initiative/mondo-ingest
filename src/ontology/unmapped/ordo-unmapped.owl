    <!-- http://www.orpha.net/ORDO/Orphanet_168796 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168796">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101934"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217619"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_228184"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_300755"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6636"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant form of heart-hand syndrome that is characterized by adult onset, progressive cardiac conduction disease, tachyarrhythmias that can lead to sudden death, dilated cardiomyopathy and brachydactyly, with the hands less severely affected than the feet. Muscle weakness and/or myopathic electromyographic findings have been observed in some cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Atriodigital dysplasia, Slovenian type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cardiac conduction disease-dilated cardiomyopathy-brachydactyly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Heart-hand syndrome, Slovenian type</oboInOwl:hasExactSynonym>
        <rdfs:label>Heart-hand syndrome, Slovenian type</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012417</skos:exactMatch>
        <skos:exactMatch>MeSH:C535852</skos:exactMatch>
        <skos:exactMatch>OMIM:610140</skos:exactMatch>
        <skos:exactMatch>UMLS:C1857829</skos:exactMatch>
    </owl:Class>

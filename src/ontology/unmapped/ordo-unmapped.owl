                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4274"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation syndrome characterized by craniofacial, ocular, dental, digital anomalies and neurologic symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Meyer-Schwickerath syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Meyer-Schwickerath-Weyers syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ODDD syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ODOD syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oculo-dento-digital dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oculodentodigital dysplasia</oboInOwl:hasExactSynonym>

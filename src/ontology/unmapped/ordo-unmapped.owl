    <!-- http://www.orpha.net/ORDO/Orphanet_1318 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1318">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17485"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome with 46,XY difference of sex development characterized by mild developmental delay and streak gonads associated with short stature, cardiac, renal, musculoskeletal, and ectodermal abnormalities (the latter including scalp defects and unusual hair whorls), and dysmorphic facial features (such as preauricular pits, short columella, and small nares). There have been no further descriptions in the literature since 1980.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>XY type gonadal dysgenesis-associated anomalies syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>XY type gonadal dysgenesis-associated anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0009302</skos:exactMatch>
        <skos:exactMatch>MeSH:C565536</skos:exactMatch>
        <skos:exactMatch>OMIM:618419</skos:exactMatch>
        <skos:exactMatch>UMLS:C1856272</skos:exactMatch>
    </owl:Class>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20772"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30829"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/691"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic disorder with strabismus characterized by congenital non-progressive ophthalmoplegia affecting the oculomotor and/or trochlear nucleus/nerve and their innervated muscles. Patients present with abnormal resting position of the eyes (in most cases infraducted and exotropic), limitation of vertical and horizontal gaze, impaired binocular vision, amblyopia, unilateral or bilateral blepharoptosis, and compensatory abnormal head posture. Extraocular manifestations include intellectual disability, peripheral neuropathy, and skeletal abnormalities, among others.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital fibrosis of extraocular muscles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FEOM</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital fibrosis of extraocular muscles</rdfs:label>
        <skos:broadMatch>ICD-10:H49.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9C82.2</skos:broadMatch>

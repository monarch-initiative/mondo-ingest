    <!-- http://www.orpha.net/ORDO/Orphanet_217346 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_217346">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

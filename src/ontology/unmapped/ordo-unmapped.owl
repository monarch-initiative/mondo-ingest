            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic inflammatory corneal disorder characterized by anterior stromal corneal opacification and vascularization of the peripheral cornea with potential central progression and subsequent reduction in visual acuity. Variable features include abnormalities of the iris, such as stromal defects and ectropion uveae, as well as foveal hypoplasia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant keratitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary keratitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant keratitis</rdfs:label>
        <skos:broadMatch>ICD-10:H16.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9A7Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007848</skos:exactMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Multiple intestinal atresia is a rare form of intestinal atresia characterized by the presence of numerous atresic segments in the small bowel (duodenum) or large bowel and leading to symptoms of intestinal obstruction: vomiting, abdominal bloating and inability to pass meconium in newborns.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated multiple intestinal atresia</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated multiple intestinal atresia</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_381 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_381">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_284811"/>

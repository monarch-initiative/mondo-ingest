    <!-- http://www.orpha.net/ORDO/Orphanet_54251 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_54251">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_324927"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare autoinflammatory disorder characterized by recurrent attacks of fever and sterile abscesses.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aseptic abscess syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Aseptic abscesses syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Aseptic systemic abscesses</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Corticosteroid-sensitive aseptic abscess syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Disseminated aseptic abscesses</oboInOwl:hasExactSynonym>
        <rdfs:label>Aseptic abscess syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D89.8</skos:broadMatch>

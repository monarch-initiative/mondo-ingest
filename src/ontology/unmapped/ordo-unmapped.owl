        <rdfs:label>Borjeson-Forssman-Lehmann syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD29</skos:broadMatch>
        <skos:exactMatch>MONDO:0010537</skos:exactMatch>

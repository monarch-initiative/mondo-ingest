    <!-- http://www.orpha.net/ORDO/Orphanet_397922 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_397922">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101939"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_93552 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93552">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166484"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264704"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_280373"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_567560"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93573"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10540"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, systemic, autoimmune disease characterized by inflammation in any organ system, with onset prior to adulthood, presenting highly variable clinical manifestations, which usually have a more aggressive course and higher rate of major organ involvement than adult-onset systemic lupus erythematosus, resulting in potential damage to a variety of organs (e.g. the skin, kidneys, lungs, nervous system).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Pediatric systemic lupus erythematosus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SLE, pediatric onset</oboInOwl:hasExactSynonym>
        <rdfs:label>Pediatric systemic lupus erythematosus</rdfs:label>
        <skos:broadMatch>ICD-10:M32.0</skos:broadMatch>
        <skos:broadMatch>ICD-10:M32.1</skos:broadMatch>
        <skos:broadMatch>ICD-10:M32.8</skos:broadMatch>
        <skos:broadMatch>ICD-10:M32.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A40.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019725</skos:exactMatch>
        <skos:exactMatch>UMLS:C1274834</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93552"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pediatric systemic lupus erythematosus</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_93554 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93554">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_91138"/>
        <obo:IAO_0000115 xml:lang="en">A clinico-serological subtype of mixed cryoglobulinemia syndrome, an immune complex disorder, characterized by purpura, weakness and arthralgia and defined immunochemically by cryoglobulins composed of polyclonal IgGs (autoantigens) and monoclonal IgM (autoantibody).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MC type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mixed cryoglobulinemia type II</oboInOwl:hasExactSynonym>
        <rdfs:label>Mixed cryoglobulinemia type II</rdfs:label>
        <skos:broadMatch>ICD-10:D89.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A44.90</skos:broadMatch>
        <skos:exactMatch>MONDO:0019726</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680264</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93554"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mixed cryoglobulinemia type II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_93555 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93555">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_91138"/>
        <obo:IAO_0000115 xml:lang="en">A clinico-serological subtype of mixed cryoglobulinemia syndrome, is an immune complex disorder, characterized by purpura, weakness and arthralgia and defined immunochemically by cryoglobulins containing both polyclonal IgGs and polyclonal IgMs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MC type III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mixed cryoglobulinemia type III</oboInOwl:hasExactSynonym>
        <rdfs:label>Mixed cryoglobulinemia type III</rdfs:label>
        <skos:broadMatch>ICD-10:D89.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A44.90</skos:broadMatch>
        <skos:exactMatch>MONDO:0019727</skos:exactMatch>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, severe form of mevalonate kinase deficiency (MKD) characterized by dysmorphic features, failure to thrive, psychomotor delay, ocular involvement, hypotonia, progressive ataxia, myopathy, and recurrent inflammatory episodes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Complete mevalonate kinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MVA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mevalonic aciduria</oboInOwl:hasExactSynonym>
        <rdfs:label>Mevalonic aciduria</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C52.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0012481</skos:exactMatch>
        <skos:exactMatch>MedDRA:10072219</skos:exactMatch>
        <skos:exactMatch>OMIM:610377</skos:exactMatch>

        <obo:IAO_0000115 xml:lang="en">Lymphomatoid papulosis (LyP) is a rare cutaneous condition characterized by chronic, recurrent, and self-regressing papulonodular skin eruptions. It belongs to the spectrum of primary cutaneous CD30+ lymphoproliferative disorders, along with primary cutaneous anaplastic large cell lymphoma (primary C-ALCL) with which it shares overlapping clinical and histopathologic features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LyP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lymphomatoid papulosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Lymphomatoid papulosis</rdfs:label>
        <skos:broadMatch>ICD-10:C86.6</skos:broadMatch>
        <skos:exactMatch>ICD-11:2B03.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0020326</skos:exactMatch>
        <skos:exactMatch>MeSH:D017731</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056670</skos:exactMatch>
        <skos:exactMatch>UMLS:C0206182</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_79237 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79237">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_352"/>

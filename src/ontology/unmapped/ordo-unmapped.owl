        <skos:exactMatch>UMLS:C4274992</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100013"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lissencephaly with cerebellar hypoplasia type C</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100014 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100014">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_86823"/>
        <obo:IAO_0000115 xml:lang="en">A rare form of lissencephaly with cerebellar hypoplasia characterized by pronounced microcephaly (&amp;#8804; -3 SD), intellectual disability, spastic diplegia and moderate to severe cerebellar hypoplasia involving both vermis and hemispheres.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lissencephaly with cerebellar hypoplasia type D</oboInOwl:hasExactSynonym>
        <rdfs:label>Lissencephaly with cerebellar hypoplasia type D</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD20.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0015037</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274991</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100014"/>

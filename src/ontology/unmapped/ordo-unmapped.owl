            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare male infertility due to a sperm disorder characterized by the presence, in sperm, of a very high percentage of spermatozoa with enlarged head, irregular head shape, multiple flagella, and abnormal midpiece and acrosome. It is generally associated with severe oligoasthenozoospermia and a high rate of sperm chromosomal abnormalities (polyploidy, aneuploidy).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Macrocephalic sperm head syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Male infertility due to large-headed multiflagellar polyploid spermatozoa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Male infertility due to macrozoospermia</oboInOwl:hasExactSynonym>
        <rdfs:label>Male infertility due to large-headed multiflagellar polyploid spermatozoa</rdfs:label>

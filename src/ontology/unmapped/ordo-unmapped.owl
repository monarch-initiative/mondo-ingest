        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271841"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_314749"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79375"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9388"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare endocrine disease characterized by lentigines with a specific peri-orifical distribution, blue nevus, myxomas, various endocrine tumors including primary pigmented nodular adrenocortical disease (PPNAD), acromegaly, thyroid tumors, and a wide range of other tumors.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Carney complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Carney syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myxoma-spotty pigmentation-endocrine overactivity syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Carney complex</rdfs:label>
        <skos:broadMatch>ICD-10:D44.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A70.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:610489</skos:broadMatch>
        <skos:exactMatch>MONDO:0015285</skos:exactMatch>
        <skos:exactMatch>MeSH:D056733</skos:exactMatch>
        <skos:exactMatch>MedDRA:10076601</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406810</skos:exactMatch>
        <skos:narrowMatch>OMIM:160980</skos:narrowMatch>
        <skos:narrowMatch>OMIM:605244</skos:narrowMatch>
    </owl:Class>

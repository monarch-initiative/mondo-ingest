    <!-- http://www.orpha.net/ORDO/Orphanet_443197 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_443197">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_659681"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/397"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of heme metabolism characterized by severe cutaneous photosensitivity in affected boys and sometimes in girls, manifesting in childhood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked dominant erythropoietic protoporphyria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked dominant protoporphyria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked erythropoietic protoporphyria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XLDPP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XLPP</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked erythropoietic protoporphyria</rdfs:label>
        <skos:broadMatch>ICD-10:E80.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C58.12</skos:broadMatch>
        <skos:exactMatch>MONDO:0010420</skos:exactMatch>
        <skos:exactMatch>MeSH:C567464</skos:exactMatch>
        <skos:exactMatch>OMIM:300752</skos:exactMatch>
        <skos:exactMatch>UMLS:C2677889</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_443197"/>

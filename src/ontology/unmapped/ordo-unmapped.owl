        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_595337"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly characterized by complex glycerol kinase deficiency, congenital adrenal hypoplasia, intellectual disability and/or Duchenne muscular dystrophy that usually affect males. The clinical features depend on the deletion size and the number and type of involved genes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Complex GKD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Complex glycerol kinase deficiency</oboInOwl:hasExactSynonym>

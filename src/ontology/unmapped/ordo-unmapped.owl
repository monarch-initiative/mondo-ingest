    <!-- http://www.orpha.net/ORDO/Orphanet_60015 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_60015">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183542"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93451"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/450"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7392"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Enlarged parietal foramina (EPF) is a developmental defect, characterized by variable intramembranous ossification defects of the parietal bones, which is either asymptomatic, symptomatic (headaches, nausea, vomiting, intellectual disability) or associated with other pathologies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Catlin marks</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Enlarged parietal foramina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fenestrae parietales symmetricae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Foramina parietalia permagna</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary cranium bifidum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Symmetric parietal foramina</oboInOwl:hasExactSynonym>

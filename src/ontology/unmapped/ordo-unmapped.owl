                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3808"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterised by an absence of the lens. CPAK can be associated with variable secondary ocular defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital primary aphakia</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital primary aphakia</rdfs:label>
        <skos:exactMatch>ICD-10:Q12.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA12.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0012456</skos:exactMatch>
        <skos:exactMatch>MeSH:C537786</skos:exactMatch>
        <skos:exactMatch>MedDRA:10002947</skos:exactMatch>
        <skos:exactMatch>OMIM:610256</skos:exactMatch>
        <skos:exactMatch>UMLS:C1853230</skos:exactMatch>
    </owl:Class>

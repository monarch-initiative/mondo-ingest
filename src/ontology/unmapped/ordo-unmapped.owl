    <!-- http://www.orpha.net/ORDO/Orphanet_1692 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1692">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98131"/>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal trisomy, characterized by reduced fetal movements and intrauterine growth retardation, low birth weight, and multiple congenital anomalies. The latter include, amongst others, facial dysmorphism (like hypertelorism, cleft lip/palate, micrognathia, low hairline, and small, low-set, and posteriorly rotated ears), head circumference below average, deformities of the hands (camptodactyly) and feet, marked hypertrichosis, and anomalies of the brain, heart, and lungs. Lethality appears to depend on the degree of mosaicism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mosaic trisomy 1 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mosaic trisomy chromosome 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 1 mosaicism</oboInOwl:hasExactSynonym>
        <rdfs:label>Mosaic trisomy 1 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD40.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015706</skos:exactMatch>
        <skos:exactMatch>UMLS:C5394675</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

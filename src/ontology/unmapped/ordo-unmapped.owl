            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Haim-Munk syndrome (HMS) is characterized by palmoplantar hyperkeratosis, severe early-onset periodontitis, onychogryposis, pes planus, arachnodactyly and acroosteolysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Haim-Munk syndrome</oboInOwl:hasExactSynonym>

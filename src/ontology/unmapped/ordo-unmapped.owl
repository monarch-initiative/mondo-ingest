    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_241">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

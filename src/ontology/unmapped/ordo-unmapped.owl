            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive connective tissue disorder characterized by tortuosity and elongation of the large and medium-sized arteries and a propensity towards aneurysm formation, vascular dissection, and stenosis of the pulmonary arteries.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ATS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Arterial tortuosity syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Arterial tortuosity syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD28.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008818</skos:exactMatch>
        <skos:exactMatch>MeSH:C565942</skos:exactMatch>
        <skos:exactMatch>MedDRA:10080250</skos:exactMatch>
        <skos:exactMatch>OMIM:208050</skos:exactMatch>
        <skos:exactMatch>UMLS:C1859726</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_263524 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_263524">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98252"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by a rapid onset of seizures, an altered state of consciousness, neurologic decline, and variable degrees of hepatic dysfunction following a respiratory or gastrointesitnal infection (e.g. mycoplasma, influenza virus) in a previously healthy child. Brain MRI of patients reveals bilateral, multiple, symmetrical lesions predominantly observed in thalami and brainstem, but also in periventricular white matter and cerebellum in some cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ANEC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acute necrotizing encephalopathy of childhood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated ANE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated acute necrotizing encephalopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Acute necrotizing encephalopathy of childhood</rdfs:label>
        <skos:broadMatch>ICD-10:G31.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8E47</skos:broadMatch>
        <skos:exactMatch>MONDO:0016991</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706387</skos:exactMatch>
        <skos:narrowMatch>OMIM:614212</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

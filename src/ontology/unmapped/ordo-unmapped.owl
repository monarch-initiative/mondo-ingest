    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85453">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290839"/>

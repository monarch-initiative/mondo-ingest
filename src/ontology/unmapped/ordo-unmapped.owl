    <!-- http://www.orpha.net/ORDO/Orphanet_137678 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137678">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_253"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93421"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2200"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, primary bone dysplasia disorder characterized by early-onset, progressive pseudorheumatoid arthritis, platyspondyly, and hypoplasia/dysplasia of the third and fourth metatarsals, in the absence of ophthalmologic, cleft palate, and height anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Czech dysplasia, metatarsal type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SED with metatarsal shortening</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spondyloepiphyseal dysplasia with metatarsal shortening</oboInOwl:hasExactSynonym>
        <rdfs:label>Spondyloepiphyseal dysplasia with metatarsal shortening</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0012206</skos:exactMatch>
        <skos:exactMatch>MeSH:C535766</skos:exactMatch>
        <skos:exactMatch>OMIM:609162</skos:exactMatch>
        <skos:exactMatch>UMLS:C1836683</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_137678"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic skin disease predominantly featuring painful palmoplantar keratoderma, thickened nails, cysts and white plaques affecting tongue and oral mucosa.</obo:IAO_0000115>

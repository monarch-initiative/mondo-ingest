    <!-- http://www.orpha.net/ORDO/Orphanet_85290 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85290">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

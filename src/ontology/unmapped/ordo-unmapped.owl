            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic syndromic intellectual disability characterized by developmental delay, mild to severe intellectual disability, facial features (bulbous nasal tip, and macroglossia, macrostomia, or open mouth appearance) and a wide spectrum of other nonspecific variable clinical features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Developmental delay-facial dysmorphism syndrome due to MED13L deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MED13L-related intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Developmental delay-facial dysmorphism syndrome due to MED13L deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0014773</skos:exactMatch>
        <skos:exactMatch>MONDO:14773</skos:exactMatch>

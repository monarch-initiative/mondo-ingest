        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A very rare congenital genetic neurological disorder characterized by agenesis/hypoplasia of corpus callosum with developmental abnormalities, ocular disorders, and variable craniofacial and skeletal abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Craniofacial dysmorphism-coloboma-corpus callosum agenesis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Temtamy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Temtamy-Shalash syndrome</oboInOwl:hasExactSynonym>

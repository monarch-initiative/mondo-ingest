        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79382"/>
        <obo:IAO_0000115 xml:lang="en">A rare skin disorder characterized by recurring inflammation in the subcutaneous layer of fat.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic lobular panniculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic nodular panniculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Nodular non-suppurative panniculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pfeiffer-Weber-Christian syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Relapsing febrile nodular nonsuppurative panniculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Relapsing febrile nodular panniculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">WCD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Weber-Christian disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Weber-Christian panniculitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Nodular non-suppurative panniculitis</rdfs:label>
        <skos:broadMatch>ICD-11:EF00.Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:M35.6</skos:exactMatch>
        <skos:exactMatch>MONDO:0018063</skos:exactMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_400011"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_485382"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95710"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2594"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder that disrupts the synthesis of estradiol, resulting in hirsutism of mothers during gestation of an affected child; pseudohermaphroditism and virilization in women; and tall stature, osteoporosis and obesity in men.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aromatase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital estrogen deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Aromatase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E25.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A9Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013301</skos:exactMatch>
        <skos:exactMatch>MeSH:C537436</skos:exactMatch>
        <skos:exactMatch>OMIM:613546</skos:exactMatch>
        <skos:exactMatch>UMLS:C1960539</skos:exactMatch>
    </owl:Class>

        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by severe intellectual disability, facial dysmorphism (low-set and malformed ears, bulbous nasal tip, low hanging columella, bilateral cleft lip and palate), eye anomalies (microophthalmia, coloboma), intestinal abnormalities and heart defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cleft lip/palate-facial, eye, heart and intestinal anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kapur-Toriello syndrome</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_635 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_635">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251870"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare embryonal tumor of neuroepithelial tissue arising from neural crest cells, typically presenting in infancy or early childhood. Its symptoms depend on tumor stage and location along the sympathetic nervous system, ranging from localized masses to metastatic disease involving the bone, bone marrow, liver, lymph nodes, lung, central nervous system, or skin. Unlike more benign peripheral neuroblastic tumors (intermixed ganglioneuroblastoma and ganglioneuroma), neuroblastoma is characterized by its potential for aggressive invasion and metastases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neuroblastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuroblastoma</rdfs:label>
        <skos:broadMatch>ICD-10:C74.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A00.11</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH85Z0</skos:exactMatch>
        <skos:exactMatch>MONDO:0005072</skos:exactMatch>
        <skos:exactMatch>MeSH:D009447</skos:exactMatch>
        <skos:exactMatch>MedDRA:10029260</skos:exactMatch>
        <skos:exactMatch>UMLS:C0027819</skos:exactMatch>
        <skos:narrowMatch>OMIM:256700</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613013</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613014</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613015</skos:narrowMatch>

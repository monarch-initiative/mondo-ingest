                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6193"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Severe combined immunodeficiency (SCID) T-B+ due to JAK3 deficiency is a form of SCID characterized by severe and recurrent infections, associated with diarrhea and failure to thrive.</obo:IAO_0000115>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital leptin deficiency is a form of monogenic obesity characterised by severe early-onset obesity and marked hyperphagia.</obo:IAO_0000115>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_294988 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_294988">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498457"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation characterized by underdevelopment of the thumb, ranging from a slight decrease in thumb size to complete absence of the thumb. The malformation may occur isolated, combined to other defects of the hand or upper limb, or as part of a multiple congenital anomaly syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital absence/hypoplasia of thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital thumb hypodactyly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital thumb oligodactyly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated hypoplasia of thumb</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated hypoplasia of thumb</rdfs:label>
        <skos:broadMatch>ICD-10:Q71.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB99.7</skos:broadMatch>
        <skos:exactMatch>UMLS:C5925024</skos:exactMatch>
    </owl:Class>

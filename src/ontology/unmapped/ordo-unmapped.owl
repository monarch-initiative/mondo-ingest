        <obo:IAO_0000115 xml:lang="en">A rare disorder characterized by chondromatosis, typically involving the clavicles, upper end of the humerus, and lower end of the femur. Lesions are bilateral and symmetrical. The clinical course is benign.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Genochondromatosis type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Genochondromatosis type 1</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.2Y</skos:broadMatch>
        <skos:broadMatch>OMIM:137360</skos:broadMatch>
        <skos:exactMatch>MONDO:0019411</skos:exactMatch>
        <skos:exactMatch>UMLS:C5438970</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_401849 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_401849">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100980"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100982"/>

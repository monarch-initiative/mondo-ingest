    <!-- http://www.orpha.net/ORDO/Orphanet_90658 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90658">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_65753"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9118"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare subtype of CMT1 characterized by a variable clinical presentation. Onset within the first two years of life with a delay in walking is not uncommon; however, onset may occur later. CMT1E is caused by point mutations in the &lt;i&gt;PMP22&lt;/i&gt; (17p12) gene. The disease severity depends on the particular &lt;i&gt;PMP22&lt;/i&gt; mutation, with some cases being very mild and even resembling hereditary neuropathy with liability to pressure palsies, while others having an earlier onset with a more severe phenotype (reminiscent of Dejerine-Sottas syndrome) than that seen in CMT1A, caused by gene duplication. These severe cases may also report deafness and much slower motor nerve conduction velocities compared to CMT1A patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CMT1E</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Charcot-Marie-Tooth disease type 1E</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Charcot-Marie-Tooth disease-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Charcot-Marie-Tooth disease-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Charcot-Marie-Tooth disease type 1E</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C20.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0007311</skos:exactMatch>
        <skos:exactMatch>MeSH:C537986</skos:exactMatch>
        <skos:exactMatch>OMIM:118300</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931686</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90658"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Charcot-Marie-Tooth disease type 1E</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_90673 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90673">

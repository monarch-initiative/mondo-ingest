                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/560"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Fried syndrome is a rare X-linked mental retardation (XLMR) syndrome characterized by psychomotor delay, intellectual deficit, hydrocephalus, and mild facial anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fried syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Fried syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>

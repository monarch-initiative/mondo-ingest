            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurometabolic disease characterized by recurrent intractable seizures in the prenatal, neonatal and postnatal period that are resistant to anti-epileptic drugs (AEDs) but that are responsive to pharmacological dosages of pyridoxine (vitamin B6).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Antiquitin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PD-DEE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pyridoxine-dependent-developmental and epileptic encephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vitamin B6-dependent seizures</oboInOwl:hasExactSynonym>
        <rdfs:label>Pyridoxine-dependent-developmental and epileptic encephalopathy</rdfs:label>
        <skos:broadMatch>ICD-11:8A61.0Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:G40.8</skos:exactMatch>
        <skos:exactMatch>MONDO:0009945</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_98951 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98951">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_91412"/>
        <obo:IAO_0000115 xml:lang="en">Inverse Marcus-Gunn phenomenon is a rare congenital synkinesis where jaw opening by the pterygoid muscle (during eating or yawning) causes eyelid drooping from inhibition of the oculomotor nerve to the levator palpebrae superioris. Familial occurrence has been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Inverse Marcus-Gunn phenomenon</oboInOwl:hasExactSynonym>
        <rdfs:label>Inverse Marcus-Gunn phenomenon</rdfs:label>
        <skos:broadMatch>ICD-10:Q07.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9A03.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0020362</skos:exactMatch>
        <skos:exactMatch>UMLS:C5548210</skos:exactMatch>
    </owl:Class>

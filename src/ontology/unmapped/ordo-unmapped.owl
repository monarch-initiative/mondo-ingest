    <!-- http://www.orpha.net/ORDO/Orphanet_67039 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_67039">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_164001"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare oral disease characterized by unilateral enlargement of the right or left maxillary alveolar bone and gingiva in the region distal to the canines towards the maxillary tuberosity. In the enlarged region, dental abnormalities such as missing teeth, abnormal spacing and delayed eruption occur.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Segmental odontomaxillary dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Segmental odontomaxillary dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:K00.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA07.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0019029</skos:exactMatch>
        <skos:exactMatch>UMLS:C3698531</skos:exactMatch>
    </owl:Class>

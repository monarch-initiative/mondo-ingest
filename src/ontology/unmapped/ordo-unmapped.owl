    <!-- http://www.orpha.net/ORDO/Orphanet_1195 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1195">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309842"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

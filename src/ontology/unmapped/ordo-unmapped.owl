    <!-- http://www.orpha.net/ORDO/Orphanet_833 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_833">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225689"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519292"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522554"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79173"/>
        <obo:IAO_0000115 xml:lang="en">Encephalopathy due to sulfite oxidase deficiency is a rare neurometabolic disorder characterized by seizures, progressive encephalopathy and lens dislocation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Encephalopathy due to sulfite oxidase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Encephalopathy due to sulfite oxidase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.B</skos:broadMatch>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1074 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1074">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1071"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis malformation syndrome characterized by bands of extensile tissue connecting the margins of the upper and lower eyelids, in association with anal atresia. Patients may additionally present cleft palate, hydrocephalus and meningomyelocele. There have been no further descriptions in the literature since 1993.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ankyloblepharon filiforme adnatum-imperforate anus syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Aughton-Hufnagle syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ankyloblepharon filiforme adnatum-imperforate anus syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015201</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751231</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1074"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ankyloblepharon filiforme adnatum-imperforate anus syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1077 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1077">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_164001"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_420755"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare odontologic disorder characterized by the loss of the periodontal ligament space and orthodontic mobility.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ankylosis of teeth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dental ankylosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Dental ankylosis</rdfs:label>
        <skos:exactMatch>ICD-10:K03.5</skos:exactMatch>
        <skos:exactMatch>ICD-11:DA07.61</skos:exactMatch>
        <skos:exactMatch>MONDO:0008007</skos:exactMatch>
        <skos:exactMatch>MeSH:D020254</skos:exactMatch>
        <skos:exactMatch>MedDRA:10044019</skos:exactMatch>
        <skos:exactMatch>UMLS:C0155930</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1077"/>

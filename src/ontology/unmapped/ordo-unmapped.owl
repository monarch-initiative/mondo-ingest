        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/914"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of amyloidosis characterized by accumulation and extensive visceral deposition of an amyloidogenic variant of beta 2 microglobulin leading to progressive gastrointestinal dysfunction, Sjögren syndrome and autonomic neuropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant beta2-microglobulinic amyloidosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Variant ABeta2M amyloidosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Variant ABeta2M amyloidosis</rdfs:label>
        <skos:broadMatch>ICD-10:E85.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5D00.3</skos:broadMatch>
        <skos:broadMatch>OMIM:105200</skos:broadMatch>
        <skos:exactMatch>MONDO:0017810</skos:exactMatch>
        <skos:exactMatch>UMLS:C4302669</skos:exactMatch>
    </owl:Class>

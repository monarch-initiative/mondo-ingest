    <!-- http://www.orpha.net/ORDO/Orphanet_2728 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2728">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_293642"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A multiple congenital malformation syndrome characterized by blepharophimosis, ptosis, dental hypoplasia, hearing impairment and intellectual disability.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BMRS, Ohdo type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Blepharophimosis syndrome, Ohdo type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Blepharophimosis-intellectual disability syndrome, Ohdo type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ohdo syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ohdo-Madokoro-Sonoda syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Blepharophimosis-intellectual disability syndrome, Ohdo type</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>

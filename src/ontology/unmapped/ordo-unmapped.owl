            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare central nervous system malformation characterized by severe intellectual deficit, early hypotonia with progression to spasticity and contractures, choreoathetosis, seizures, dysmorphic face (long face with prominent forehead), and brain imaging abnormalities such as Dandy-Walker malformation, and iron deposition.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AP1S2-related X-linked intellectual disability</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_2514 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2514">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

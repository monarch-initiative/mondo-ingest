            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare skin disorder characterized by localized absence of skin that is usually located on the scalp but can occur anywhere on the body including the face, trunk and extremities. Aplasia cutis congenita (ACC) may occasionally be associated with other anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aplasia cutis congenita</oboInOwl:hasExactSynonym>
        <rdfs:label>Aplasia cutis congenita</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:LC60</skos:exactMatch>
        <skos:exactMatch>MONDO:0007145</skos:exactMatch>
        <skos:exactMatch>MedDRA:10002963</skos:exactMatch>
        <skos:exactMatch>UMLS:C0282160</skos:exactMatch>
        <skos:narrowMatch>OMIM:107600</skos:narrowMatch>
        <skos:narrowMatch>OMIM:600360</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619959</skos:narrowMatch>
    </owl:Class>

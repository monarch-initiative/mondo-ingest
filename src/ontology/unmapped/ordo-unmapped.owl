        <owl:annotatedTarget>Corneal endotheliitis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_137605 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137605">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_536391"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79375"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20249"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Legius syndrome, also known as NF1-like syndrome, is a rare, genetic skin pigmentation disorder characterized by multiple café-au-lait macules with or without axillary or inguinal freckling.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Legius syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NF1-like syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurofibromatosis 1-like syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nonmosaic LGSS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nonmosaic Legius syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Legius syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q85.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0012669</skos:exactMatch>
        <skos:exactMatch>MeSH:C548032</skos:exactMatch>
        <skos:exactMatch>OMIM:611431</skos:exactMatch>
        <skos:exactMatch>UMLS:C1969623</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_137605"/>

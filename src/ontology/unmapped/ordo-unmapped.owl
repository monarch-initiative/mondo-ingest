        <oboInOwl:hasExactSynonym xml:lang="en">Atypical lipoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Atypical lipomatous tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">WDLS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Well-differentiated liposarcoma</oboInOwl:hasExactSynonym>

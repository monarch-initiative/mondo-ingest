        <obo:IAO_0000115 xml:lang="en">An acquired form of alpha-thalassemia characterized by a myelodysplastic syndrome (MDS) or more rarely a myeloproliferative disease (MPD) associated with hemoglobin H disease (HbH).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ATMDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired HbH disease</oboInOwl:hasExactSynonym>

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2841">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183426"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79359"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13211"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, chronic epidermal disorder characterized by diffuse bilateral (or, rarely, localized segmental) erythematous plaques with blistering, erosions, maceration, and frequent secondary infection involving the flexural areas.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign chronic familial pemphigus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hailey-Hailey disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Hailey-Hailey disease</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0008218</skos:exactMatch>
        <skos:exactMatch>MeSH:D016506</skos:exactMatch>
        <skos:exactMatch>OMIM:169600</skos:exactMatch>
        <skos:exactMatch>UMLS:C0085106</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2841"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hailey-Hailey disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



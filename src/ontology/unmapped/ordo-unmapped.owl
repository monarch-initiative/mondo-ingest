    <!-- http://www.orpha.net/ORDO/Orphanet_2536 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2536">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98638"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis syndrome characterized by the association of microcornea, glaucoma and frontal sinus hypoplasia. Thick palmar skin and torus palatinus have also been reported. There have been no further descriptions in the literature since 1995.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microcornea-glaucoma-absent frontal sinuses syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Microcornea-glaucoma-absent frontal sinuses syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q15.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0007992</skos:exactMatch>
        <skos:exactMatch>MeSH:C537552</skos:exactMatch>
        <skos:exactMatch>OMIM:156700</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274800</skos:exactMatch>
    </owl:Class>

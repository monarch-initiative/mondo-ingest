    <!-- http://www.orpha.net/ORDO/Orphanet_99849 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99849">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

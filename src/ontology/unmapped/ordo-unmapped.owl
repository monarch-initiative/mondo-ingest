    <!-- http://www.orpha.net/ORDO/Orphanet_931 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_931">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498461"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13243"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An extremely rare developmental disorder characterized by bilateral, congenital and complete amputation of the distal extremities (amputation of distal epiphysis of the humerus, distal portion of the tibial diaphysis, aplasia of the radius, ulna, fibula) and aplasia of hands and feet (aplasia of carpal, metacarpal, tarsal, metatarsal and phalangeal bones). Rarely, an ectopic bone can be found at the distal end of the humerus. No other systemic manifestations have been reported and the disorder follows an autosomal recessive pattern of inheritance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated acheiropodia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated acheiropody</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated acheiropodia</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB9B</skos:broadMatch>
        <skos:exactMatch>MONDO:0008700</skos:exactMatch>
        <skos:exactMatch>MeSH:C536014</skos:exactMatch>
        <skos:exactMatch>OMIM:200500</skos:exactMatch>
        <skos:exactMatch>UMLS:C5924998</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_931"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

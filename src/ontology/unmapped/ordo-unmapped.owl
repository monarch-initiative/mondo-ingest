                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9585"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Midline interhemispheric variant of holoprosencephaly (MIH) or syntelencephaly is a form of holoprosencephaly (HPE) characterized by non-separation of the posterior frontal and parietal lobes, normally-formed callosal genu and splenium, absence of the callosal body, normally-separated hypothalamus and lentiform nucleus, and frequent heterotopic gray matter.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MIH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MIH type HPE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MIHF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MIHV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Middle interhemispheric fusion variant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Middle interhemispheric variant of holoprosencephaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Midline interhemispheric variant of holoprosencephaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Syntelencephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Midline interhemispheric variant of holoprosencephaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA05.2</skos:broadMatch>
        <skos:broadMatch>OMIM:157170</skos:broadMatch>
        <skos:broadMatch>OMIM:609637</skos:broadMatch>

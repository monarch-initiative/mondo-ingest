            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This syndrome is characterized by severe immunodeficiency, osteopetrosis, lymphedema and anhidrotic ectodermal dysplasia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hypohidrotic ectodermal dysplasia-immunodeficiency-osteopetrosis-lymphedema syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OL-HED-ID</oboInOwl:hasExactSynonym>

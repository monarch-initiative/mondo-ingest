        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98154"/>
        <obo:IAO_0000115 xml:lang="en">Paternal uniparental disomy of chromosome 20 is a very rare chromosomal anomaly in which both copies of chromosome 20 are inherited from the father. The main features described are high birth weight and/or early-onset obesity, relative macrocephaly, and tall stature. Most patients were ascertained during sporadic pseudohypoparathyroidism type 1b testing and have UPD involving variable segments of the long arm of chromosome 20.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Paternal UPD(20)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Paternal uniparental disomy of chromosome 20 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UPD(20)pat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>paternal upd(20)</oboInOwl:hasExactSynonym>
        <rdfs:label>Paternal uniparental disomy of chromosome 20 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD45.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0019924</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275028</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96194"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Paternal uniparental disomy of chromosome 20 syndrome</owl:annotatedTarget>

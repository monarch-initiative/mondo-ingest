        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_186 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_186">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101941"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506210"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare autoimmune cholestatic liver disease characterized by autoimmune mediated damage of small intrahepatic bile ducts leading to cholestasis, fibrosis, and potential cirrhosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hanot syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PBC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary biliary cholangitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary biliary cirrhosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary biliary cholangitis</rdfs:label>
        <skos:exactMatch>ICD-10:K74.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:DB96.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0005388</skos:exactMatch>
        <skos:exactMatch>MeSH:D008105</skos:exactMatch>
        <skos:exactMatch>MedDRA:10080429</skos:exactMatch>
        <skos:exactMatch>UMLS:C0008312</skos:exactMatch>
        <skos:narrowMatch>OMIM:109720</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613007</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613008</skos:narrowMatch>

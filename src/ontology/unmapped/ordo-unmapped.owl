        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_589522 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_589522">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207028"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_94145"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant cerebellar ataxia characterized by slowly progressive late-onset cerebellar ataxia, variably combined with sensory axonal neuropathy. Patients may present gait and limb ataxia, dysarthria, abnormal oculomotor function, and distal sensory impairment. Cerebellar atrophy is typically mild or absent.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA46</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 46</oboInOwl:hasExactSynonym>
        <rdfs:label>Spinocerebellar ataxia type 46</rdfs:label>

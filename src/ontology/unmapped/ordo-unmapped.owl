    <!-- http://www.orpha.net/ORDO/Orphanet_251066 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251066">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_261920"/>

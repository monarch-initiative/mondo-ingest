    <!-- http://www.orpha.net/ORDO/Orphanet_216828 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_216828">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_666"/>
        <rdfs:subClassOf>
            <owl:Restriction>

    <!-- http://www.orpha.net/ORDO/Orphanet_209867 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_209867">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_137839 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137839">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>

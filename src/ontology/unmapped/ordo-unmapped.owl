    <!-- http://www.orpha.net/ORDO/Orphanet_370109 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_370109">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_391711"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/795"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, persistent combined dystonia characterized by clinical signs similar to ataxia-telangiectasia but with a later (usually adulthood) onset and slower progression. Patients typically present extrapyramidal signs, such as resting tremor, choreathetosis, and dystonia, as the initial symptoms and later often develop mild cerebellar ataxia (with gait usually preserved). Telangiectasia and immunodeficiency may be absent but secondary features of ataxia-telangiectasia, such as risk of malignancy, dysarthria and peripheral neuropathy, are frequently present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ataxia-telangiectasia variant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">v-AT</oboInOwl:hasExactSynonym>
        <rdfs:label>Ataxia-telangiectasia variant</rdfs:label>
        <skos:broadMatch>ICD-10:G11.3</skos:broadMatch>
        <skos:broadMatch>OMIM:208900</skos:broadMatch>
        <skos:exactMatch>MONDO:0018266</skos:exactMatch>
        <skos:exactMatch>MeSH:C566865</skos:exactMatch>
        <skos:exactMatch>UMLS:C1876175</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_370109"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ataxia-telangiectasia variant</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



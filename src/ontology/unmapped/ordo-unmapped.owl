            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spinocerebellar ataxia type 17 (SCA17) is a rare subtype of type I autosomal dominant cerebellar ataxia (ADCA type I). It is characterized by a variable clinical picture which can include dementia, psychiatric disorders, parkinsonism, dystonia, chorea, spasticity, and epilepsy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HDL4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Huntington disease-like 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA17</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 17</oboInOwl:hasExactSynonym>
        <rdfs:label>Spinocerebellar ataxia type 17</rdfs:label>
        <skos:broadMatch>ICD-10:G11.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A03.16</skos:broadMatch>
        <skos:exactMatch>MONDO:0011781</skos:exactMatch>
        <skos:exactMatch>MeSH:C564616</skos:exactMatch>

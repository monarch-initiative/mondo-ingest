        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16384"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare malignant renal tumor, typically affecting the pediatric population, characterized by an abnormal proliferation of cells that resemble the kidney cells of an embryo (metanephroma), leading to the term embryonal tumor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Nephroblastoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Renal embryonic tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wilms tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Nephroblastoma</rdfs:label>
        <skos:broadMatch>ICD-10:C64</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C90.Y</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_1083 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1083">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_199639"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269573"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_48471"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Microlissencephaly describes a heterogenous group of a rare cortical malformations characterized by lissencephaly in combination with severe congenital microcephaly, presenting with spasticity, severe developmental delay, and seizures and with survival varying from days to years.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microlissencephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Microlissencephaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD20.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0015204</skos:exactMatch>
        <skos:exactMatch>UMLS:C1956147</skos:exactMatch>
        <skos:narrowMatch>OMIM:614019</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616212</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1083"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Microlissencephaly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1084 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1084">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Isolated lissencephaly type 1 without known genetic defects belongs to the genetically heterogeneous group, classic lissencephaly. It is a diagnosis of exclusion, when neither associated malformations nor family history are present, and in the absence of mutations of genes known to be involved in classic lissencephaly. Clinically patients present with the common features of classic lissencephaly such as developmental delay, intellectual disability, and seizures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated lissencephaly type 1 without known genetic defects</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated lissencephaly type 1 without known genetic defects</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD20.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0015205</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275151</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1084"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Isolated lissencephaly type 1 without known genetic defects</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



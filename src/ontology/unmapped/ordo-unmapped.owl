    <!-- http://www.orpha.net/ORDO/Orphanet_276174 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_276174">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

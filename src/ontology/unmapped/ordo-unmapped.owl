        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Patent ductus arteriosus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Persistent patency of the arterial duct</oboInOwl:hasExactSynonym>
        <rdfs:label>NON RARE IN EUROPE: Patent arterial duct</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

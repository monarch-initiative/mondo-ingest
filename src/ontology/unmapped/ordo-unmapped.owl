    <!-- http://www.orpha.net/ORDO/Orphanet_293642 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_293642">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_137831 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_137831">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

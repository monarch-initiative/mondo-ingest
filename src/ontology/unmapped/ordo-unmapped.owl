    <!-- http://www.orpha.net/ORDO/Orphanet_10 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_10">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165707"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263749"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_325546"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare sex chromosome number anomaly disorder characterized, genetically, by the presence of an extra X and Y chromosome in males and, clinically, by tall stature, dysfunctional testes associated with infertility and insufficient testosterone production, cognitive, affective and social functioning impairments, global developmental delay, and an increased risk of congenital malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>48,XXYY syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>48,XXYY syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q98.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD50.3Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015028</skos:exactMatch>
        <skos:exactMatch>MeSH:D007713</skos:exactMatch>
        <skos:exactMatch>MedDRA:10048230</skos:exactMatch>
        <skos:exactMatch>UMLS:C2936741</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_10"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>48,XXYY syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139027"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_169346"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183422"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183478"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_252190"/>

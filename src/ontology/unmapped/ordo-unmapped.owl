            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Immunodeficiency due to a late component of complement deficiency is a primary immunodeficiency due to an anomaly in either complement components C5, C6, C7, C8 or C9 and is typically characterized by meningitis due to often recurrent meningococcal infections. The prognosis is generally favorable.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Immunodeficiency due to C5 to C9 component complement deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Immunodeficiency due to a late component of complement deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Terminal complement pathway deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Immunodeficiency due to a late component of complement deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D84.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:4A00.11</skos:exactMatch>
        <skos:exactMatch>MONDO:0015700</skos:exactMatch>
        <skos:exactMatch>UMLS:C0398765</skos:exactMatch>
        <skos:narrowMatch>OMIM:609536</skos:narrowMatch>

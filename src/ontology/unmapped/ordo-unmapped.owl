    <!-- http://www.orpha.net/ORDO/Orphanet_2662 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2662">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4452"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies syndrome characterized by facial dysmorphism (hypertelorism, broad and high nasal bridge, depressed nasal ridge, short columella, underdeveloped maxilla, and prominent cupid-bow upper lip vermillion), mild to severe congenital sensorineural hearing loss, and skeletal abnormalities consisting of brachytelephalangy and broad thumbs and halluces with large, rounded epiphyses. Additional manifestations that have been reported include pulmonary valve stenosis, voice hoarseness and renal agenesis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Keipert syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nasodigitoacoustic syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Keipert syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0009720</skos:exactMatch>
        <skos:exactMatch>MeSH:C538337</skos:exactMatch>
        <skos:exactMatch>OMIM:301026</skos:exactMatch>
        <skos:exactMatch>UMLS:C1850627</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2662"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Keipert syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2663 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2663">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217619"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522548"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic developmental defect during embryogenesis disorder characterized by sensorineural hearing impairment, childhood-onset cataract, underdeveloped secondary sexual characteristics, spinal muscular atrophy, growth retardation, and cardiac and skeletal anomalies. Sudden death, as well as fatal cardiomyopathy and heart failure, have been described in some cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Deafness-cataract-skeletal anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Nathalie syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sensorineural hearing loss-cataract-skeletal anomalies-cardiomyopathy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Nathalie syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0009721</skos:exactMatch>
        <skos:exactMatch>MeSH:C538342</skos:exactMatch>
        <skos:exactMatch>OMIM:255990</skos:exactMatch>
        <skos:exactMatch>UMLS:C1850626</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2663"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Nathalie syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

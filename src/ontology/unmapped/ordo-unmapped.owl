    <!-- http://www.orpha.net/ORDO/Orphanet_79137 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79137">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

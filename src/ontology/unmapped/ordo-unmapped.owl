        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A very rare syndrome including short stature, facial dysmorphism, hand abnormalities and shawl scrotum.</obo:IAO_0000115>

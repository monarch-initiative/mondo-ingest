        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive uncomplicated HSP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive uncomplicated SPG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive uncomplicated spastic paraplegia</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive pure spastic paraplegia</rdfs:label>
        <skos:exactMatch>MONDO:15090</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680376</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100982"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_1333 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1333">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165661"/>

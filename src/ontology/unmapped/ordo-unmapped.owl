    <!-- http://www.orpha.net/ORDO/Orphanet_542822 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_542822">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1081"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare congenital coronary artery malformations comprising abnormal number of coronary ostia, malposition of a coronary ostium, and stenosis or atresia of a coronary ostium. Patients may remain asymptomatic or present with variable signs and symptoms, depending on the nature and severity of the malformation, including failure to thrive, dyspnea, syncope, angina pectoris, ventricular tachycardia, and myocardial ischemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anomaly of the coronary ostia</oboInOwl:hasExactSynonym>
        <rdfs:label>Anomaly of the coronary ostia</rdfs:label>
        <skos:exactMatch>UMLS:C5681322</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_542822"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Anomaly of the coronary ostia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



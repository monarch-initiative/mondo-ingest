    <!-- http://www.orpha.net/ORDO/Orphanet_444941 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_444941">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_109009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165707"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404577"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare genetic developmental defect during embryogenesis disorders characterized by varying degrees of caudal abdomen, pelvic, renal, anorectal, urogenital and/or lumbosacral spine malformations, with or without lower limb fusion. Phenotype is highly variable ranging from minor forms with isolated coccygeal agenesis to severe forms presenting with a single rudimentary limb. Central nervous system anomalies have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Caudal regression-sirenomelia spectrum</oboInOwl:hasExactSynonym>
        <rdfs:label>Caudal regression-sirenomelia spectrum</rdfs:label>
        <skos:exactMatch>MONDO:0018639</skos:exactMatch>
        <skos:exactMatch>MONDO:18639</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681198</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_444941"/>

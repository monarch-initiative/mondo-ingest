    <!-- http://www.orpha.net/ORDO/Orphanet_562559 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_562559">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139042"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_77830"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29256"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic multiple congenital anomalies/dysmorphic syndrome characterized by the association of severe intellectual disability, strabismus, and anterior maxillary protrusion with vertical maxillary excess, open bite, and prominent crowded teeth. Mild cochlear hearing loss has been reported in addition.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anterior maxillary protrusion-strabismus-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MRAMS syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Anterior maxillary protrusion-strabismus-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:F72.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0013353</skos:exactMatch>
        <skos:exactMatch>OMIM:613671</skos:exactMatch>
        <skos:exactMatch>UMLS:C3150924</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_562559"/>

        <obo:IAO_0000115 xml:lang="en">A contiguous gene syndrome comprising otodental syndrome (characterized by globodontia and sensorineural high-frequency hearing deficit) associated with eye abnormalities including, typically, iris and chorioretinal coloboma, as well as, on occasion, microcornea, microphtalmos, lenticular opacity, lens coloboma and iris pigment epithelial atrophy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">OOD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oculootodental syndrome</oboInOwl:hasExactSynonym>

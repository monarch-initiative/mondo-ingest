            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of oculocutaneous albinism characterized by varying degrees of skin and hair hypopigmentation, numerous ocular changes and misrouting of the optic nerves at the chiasm.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">OCA4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oculocutaneous albinism type 4</oboInOwl:hasExactSynonym>

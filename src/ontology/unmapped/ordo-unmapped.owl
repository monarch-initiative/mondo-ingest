    <!-- http://www.orpha.net/ORDO/Orphanet_52530 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_52530">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_275736"/>

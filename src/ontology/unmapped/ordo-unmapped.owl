    <!-- http://www.orpha.net/ORDO/Orphanet_96078 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96078">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262794"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">16p13.3 microduplication syndrome is a rare chromosomal anomaly syndrome resulting from a partial duplication of the short arm of chromosome 16 and manifesting with a variable phenotype which is mostly characterized by: mild to moderate intellectual deficit and developmental delay (particularly speech), normal growth, short, proximally implanted thumbs and other hand and feet malformations (such as camptodactyly, syndactyly, club feet), mild arthrogryposis and characteristic facies (upslanting, narrow palpebral fissures, hypertelorism, mid face hypoplasia, bulbous nasal tip and low set ears). Other reported manifestations include cryptorchidism, inguinal hernia and behavioral problems.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>16p13.3 microduplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal duplication 16p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal trisomy 16p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dup(16)(p13.3)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Telomeric duplication 16p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 16pter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dup(16)(p13.3)</oboInOwl:hasExactSynonym>
        <rdfs:label>16p13.3 microduplication syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0013273</skos:exactMatch>
        <skos:exactMatch>OMIM:613458</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518796</skos:exactMatch>
    </owl:Class>

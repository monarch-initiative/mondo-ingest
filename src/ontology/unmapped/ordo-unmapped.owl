    <!-- http://www.orpha.net/ORDO/Orphanet_404553 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_404553">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156143"/>

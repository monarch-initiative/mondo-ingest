    <!-- http://www.orpha.net/ORDO/Orphanet_70593 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_70593">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_169443"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary immunodeficiency characterized by normal immunoglobulin levels (including IgG sub-classes) but impaired polysaccharide responsiveness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Immunodeficiency due to selective anti-polysaccharide antibody deficiency</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare cardiomyopathy characterized anatomically by prominent left ventricular trabeculae and deep intratrabecular recesses causing progressive systolic and diastolic dysfunction, conduction abnormalities, and occasionally thromboembolic events.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LVNC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Left ventricular hypertrabeculation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Left ventricular noncompaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spongy myocardium</oboInOwl:hasExactSynonym>
        <rdfs:label>Left ventricular noncompaction</rdfs:label>
        <skos:broadMatch>ICD-10:I42.8</skos:broadMatch>

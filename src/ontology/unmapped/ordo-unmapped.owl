        <oboInOwl:hasExactSynonym xml:lang="en">PARK14</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PLA2G6-associated neurodegeneration, adult-onset</oboInOwl:hasExactSynonym>

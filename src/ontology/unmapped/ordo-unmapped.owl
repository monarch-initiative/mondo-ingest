    <!-- http://www.orpha.net/ORDO/Orphanet_79293 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79293">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182043"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

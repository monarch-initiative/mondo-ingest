    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_171829 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171829">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262047"/>

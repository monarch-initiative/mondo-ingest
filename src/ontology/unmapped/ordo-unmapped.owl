    <!-- http://www.orpha.net/ORDO/Orphanet_254704 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_254704">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377790"/>

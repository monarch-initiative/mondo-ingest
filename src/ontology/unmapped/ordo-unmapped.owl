            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3395"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Meige disease is a frequent form of late-onset, primary lymphedema characterized by lower limb lymphedema typically developing during puberty.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary lymphedema type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Meige disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Meige lymphedema</oboInOwl:hasExactSynonym>

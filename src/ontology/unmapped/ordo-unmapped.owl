    <!-- http://www.orpha.net/ORDO/Orphanet_91396 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91396">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>

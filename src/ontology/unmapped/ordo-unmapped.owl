        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A focal dystonia involving symmetrical benign essential blepharospasm (BEB) and oromandibular dystonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Blepharospasm-oromandibular dystonia syndrome</oboInOwl:hasExactSynonym>

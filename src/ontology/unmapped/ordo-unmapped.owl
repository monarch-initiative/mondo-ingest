        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <obo:IAO_0000115 xml:lang="en">An X-linked syndromic intellectual disability characterized by a few months of normal development, followed by progressive neurodegenerative course with gradual loss of vision, development of spastic tetraplegia, convulsions, microcephaly, failure to thrive, and early death.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked neurodegenerative syndrome, Hamel type</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked neurodegenerative syndrome, Hamel type</rdfs:label>
        <skos:broadMatch>ICD-10:G31.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019429</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305135</skos:exactMatch>
    </owl:Class>

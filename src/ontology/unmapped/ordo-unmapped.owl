    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_422 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_422">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156610"/>

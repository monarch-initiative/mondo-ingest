        <skos:exactMatch>MeSH:D007946</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056450</skos:exactMatch>
        <skos:exactMatch>UMLS:C0023461</skos:exactMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Distal trisomy of the short arm of chromosome 6 is characterized by pre- and postnatal growth retardation, a pattern of specific facial features (mostly of the eyes), microcephaly, and developmental delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal duplication 6p syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal trisomy 6p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Telomeric duplication 6p</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_640 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_640">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140453"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_261965"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9118"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by recurrent mononeuropathies usually triggered by minor physical activities innocuous to healthy people.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Current pressure-sensitive neuropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HNPP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary neuropathy with liability to pressure palsies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Heterozygous microdeletion 17p11.2p12</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Potato-grubbing palsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tomaculous neuropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tulip-bulb digger&apos;s palsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary neuropathy with liability to pressure palsies</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C20.Y</skos:broadMatch>

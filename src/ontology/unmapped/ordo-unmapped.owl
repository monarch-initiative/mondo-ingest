        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Wilson-Turner syndrome (WTS) is a very rare X-linked multisystem genetic disease characterized by intellectual disability, truncal obesity, gynecomastia, hypogonadism, dysmorphic facial features, and short stature.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">WTS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wilson-Turner syndrome</oboInOwl:hasExactSynonym>

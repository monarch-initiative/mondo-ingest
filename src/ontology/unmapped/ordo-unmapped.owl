    <!-- http://www.orpha.net/ORDO/Orphanet_317476 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_317476">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_480549"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_664450"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_664456"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/28880"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">X-linked immunodeficiency with magnesium defect, Epstein-Barr virus infection and neoplasia is a rare combined T and B cell immunodeficiency characterized by recurrent sinopulmonary and viral infections, persistent elevated Epstein-Barr virus (EBV) viremia and increased susceptibility to EBV-associated B-cell lymphoproliferative disorders. Immunological analyses show normal lymphocyte count or mild to moderate lymphopenia, inverted CD4:CD8 T-cell ratio and hypogammaglobulinemias.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CID due to MAGT1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Combined immunodeficiency due to MAGT1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked immunodeficiency with magnesium defect, Epstein-Barr virus infection and neoplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>XMEN</oboInOwl:hasExactSynonym>
        <rdfs:label>XMEN</rdfs:label>
        <skos:broadMatch>ICD-10:D81.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010455</skos:exactMatch>
        <skos:exactMatch>OMIM:300853</skos:exactMatch>
        <skos:exactMatch>UMLS:C3275445</skos:exactMatch>
    </owl:Class>

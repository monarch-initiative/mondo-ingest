        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506210"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare iron storage disorder present at birth characterized by the association of severe hepatocellular failure with hyperbilirubinemia, signs of hemorrhage, edema, ascites, hypoglycemia, and lactic acidosis with little to no elevation of transaminases. It is a distinct entity that differs from other forms of hemochromatosis with respect to its pathogenesis and molecular origin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neonatal hemochromatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Neonatal hemochromatosis</rdfs:label>
        <skos:broadMatch>ICD-10:E83.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0009275</skos:exactMatch>
        <skos:exactMatch>MeSH:C536394</skos:exactMatch>
        <skos:exactMatch>MedDRA:10078355</skos:exactMatch>
        <skos:exactMatch>OMIM:231100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268059</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked syndromic intellectual disability characterized by infantile-onset non-progressive intellectual deficit (with psychomotor developmental delay, cognitive impairment and macrocephaly) and early-onset parkinsonism (before 45 years of age), in male patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Early-onset parkinsonism-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Laxova-Opitz syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Waisman syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Early-onset parkinsonism-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G20</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD90.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0010709</skos:exactMatch>
        <skos:exactMatch>MeSH:C537179</skos:exactMatch>
        <skos:exactMatch>OMIM:311510</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796195</skos:exactMatch>
    </owl:Class>

        <obo:IAO_0000115 xml:lang="en">A rare inherited metabolic disease (comprising two major subtypes: type Ia and Ib) characterized by poor tolerance to fasting, growth delay and hepatomegaly resulting from accumulation of glycogen and fat in the liver.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">G6P deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD due to G6P deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease due to G6P deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glycogen storage disease due to glucose-6-phosphatase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hepatorenal glycogenosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Von Gierke disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Glycogen storage disease due to glucose-6-phosphatase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.3</skos:broadMatch>

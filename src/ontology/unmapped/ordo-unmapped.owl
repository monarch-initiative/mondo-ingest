        <skos:exactMatch>UMLS:C1449844</skos:exactMatch>
        <skos:narrowMatch>OMIM:145260</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614491</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614492</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614495</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614496</skos:narrowMatch>
    </owl:Class>

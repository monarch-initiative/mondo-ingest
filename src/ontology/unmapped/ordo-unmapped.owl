    <!-- http://www.orpha.net/ORDO/Orphanet_1929 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1929">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166484"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_699645"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98255"/>
        <obo:IAO_0000115 xml:lang="en">A rare inflammatory and autoimmune disease with epilepsy characterized by unilateral hemispheric atrophy, associated with drug-resistant focal epilepsy, progressive hemiplegia, and cognitive decline. The disease mainly affects children and begins with a prodromal period with mild hemiparesis or infrequent seizures lasting up to several years. The acute stage is marked by frequent seizures arising from one cerebral hemisphere, followed by a residual stage with persistent severe neurological deficits and relapsing epilepsy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Rasmussen subacute encephalitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rasmussen syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Rasmussen syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G04.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A62.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016019</skos:exactMatch>
        <skos:exactMatch>MeSH:C535291</skos:exactMatch>
        <skos:exactMatch>MedDRA:10071141</skos:exactMatch>
        <skos:exactMatch>UMLS:C2930868</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1929"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Rasmussen syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_193 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_193">

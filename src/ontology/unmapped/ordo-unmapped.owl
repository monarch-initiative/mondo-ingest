        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_97230 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97230">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79390"/>
        <obo:IAO_0000115 xml:lang="en">A rare photodermatosis characterized by an abrupt onset of transient erythema, wheals, and pruritus appearing within minutes of exposure to light.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Solar urticaria</oboInOwl:hasExactSynonym>
        <rdfs:label>Solar urticaria</rdfs:label>
        <skos:broadMatch>ICD-11:EB01.Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:L56.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0019945</skos:exactMatch>
        <skos:exactMatch>MeSH:D000092130</skos:exactMatch>
        <skos:exactMatch>MedDRA:10041307</skos:exactMatch>
        <skos:exactMatch>UMLS:C0263610</skos:exactMatch>
    </owl:Class>

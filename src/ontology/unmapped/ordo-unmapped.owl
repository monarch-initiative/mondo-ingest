    <!-- http://www.orpha.net/ORDO/Orphanet_1884 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1884">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519286"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522548"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522568"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716299"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, ophthalmic disorder characterized by the association of lens (ectopia and cataracts) and retinal (generalized tapetoretinal dystrophy and retinal detachment) anomalies, and variable myopia. Microcephaly and intellectual disability has been reported in some patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ectopia lentis-chorioretinal dystrophy-myopia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Noble-Bass-Sherman syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ectopia lentis-chorioretinal dystrophy-myopia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q15.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA12.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015997</skos:exactMatch>
        <skos:exactMatch>MeSH:C536124</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931115</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1884"/>

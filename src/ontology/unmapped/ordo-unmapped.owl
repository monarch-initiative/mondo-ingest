        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98543"/>
        <obo:IAO_0000115 xml:lang="en">Neuronal ceroid lipofuscinoses (NCLs) are a group of inherited progressive degenerative brain diseases characterized clinically by a decline of mental and other capacities, epilepsy, and vision loss through retinal degeneration, and histopathologically by intracellular accumulation of an autofluorescent material, ceroid lipofuscin, in the neuronal cells in the brain and in the retina.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CLN disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NCL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NCL disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neuronal ceroid lipofuscinosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Neuronal ceroid lipofuscinosis</rdfs:label>
        <skos:exactMatch>ICD-10:E75.4</skos:exactMatch>
        <skos:exactMatch>ICD-11:5C56.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0016295</skos:exactMatch>
        <skos:exactMatch>MONDO:16295</skos:exactMatch>
        <skos:exactMatch>MeSH:D009472</skos:exactMatch>
        <skos:exactMatch>MedDRA:10074607</skos:exactMatch>
        <skos:exactMatch>UMLS:C0027877</skos:exactMatch>
    </owl:Class>

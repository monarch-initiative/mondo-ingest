    <!-- http://www.orpha.net/ORDO/Orphanet_68 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_68">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163588"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98010"/>
        <obo:IAO_0000115 xml:lang="en">A rare parasitic disease caused by free-living amoebae belonging to the &lt;i&gt;Acanthamoeba, Naegleria&lt;/i&gt; and &lt;i&gt;Balamuthia genera&lt;/i&gt;, that are able to survive in an autonomous state in all natural environments and can also parasitize humans. In immunosuppressed individuals &lt;i&gt;Acanthamoeba&lt;/i&gt; genus contamination leads to granulomatous amoebic encephalitis (also reported in association with species of the &lt;i&gt;Balamuthia&lt;/i&gt; genus) together with other problems including cardiac, cutaneous and pulmonary manifestations, all of which influence the prognosis. In immunocompetent individuals, the &lt;i&gt;Naegleria fowleri&lt;/i&gt; species is responsible for primary amoebic meningoencephalitis, the evolution of which is rapidly fatal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Amoebiasis due to free-living amoebae</oboInOwl:hasExactSynonym>
        <rdfs:label>Amoebiasis due to free-living amoebae</rdfs:label>
        <skos:exactMatch>MONDO:0019036</skos:exactMatch>
        <skos:exactMatch>UMLS:C0153326</skos:exactMatch>
        <skos:narrowMatch>ICD-10:B60.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B60.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1A36.11</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1A36.12</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1A36.1Y</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

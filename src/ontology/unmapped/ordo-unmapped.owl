    <!-- http://www.orpha.net/ORDO/Orphanet_2158 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2158">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79181"/>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of histidine metabolism characterized by histidinuria without histidinemia due to impaired intestinal and renal tubular absorption of histidine. Developmental delay, intellectual disability, seizures, and mild dysmorphic features have been reported in association. There have been no further descriptions in the literature since 1992.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Histidinuria-renal tubular defect syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Histidinuria-renal tubular defect syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E70.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009346</skos:exactMatch>
        <skos:exactMatch>MeSH:C538321</skos:exactMatch>
        <skos:exactMatch>OMIM:235830</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268642</skos:exactMatch>
    </owl:Class>

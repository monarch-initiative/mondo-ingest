    <!-- http://www.orpha.net/ORDO/Orphanet_664912 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_664912">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93626"/>
        <obo:IAO_0000115 xml:lang="en">A rare vascular condition characterized by the formation of a thrombus (blood clot) in the renal vein of a newborn infant, typically within the first 28 days of life. This condition can cause renal (kidney) ischemia, and may lead to kidney damage, swelling, and potential loss of kidney function. Neonatal renal vein thrombosis (NRVT) can affect one kidney (unilateral) or both kidneys (bilateral), with the severity of symptoms often depending on the extent of the clot and the number of affected kidneys.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">NRVT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal RVT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neonatal renal venous thrombosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Neonatal renal venous thrombosis</rdfs:label>
        <skos:broadMatch>ICD-10:P29.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB90.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0971105</skos:exactMatch>
        <skos:exactMatch>MONDO:971105</skos:exactMatch>
        <skos:exactMatch>UMLS:C5925061</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_664912"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neonatal renal venous thrombosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

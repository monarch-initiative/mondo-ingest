    <!-- http://www.orpha.net/ORDO/Orphanet_79113 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79113">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/21869"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/24552"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital cataract - hypertrophic cardiomyopathy - mitochondrial myopathy (CCM) is a mitochondrial disease characterized by cataracts, hypertrophic cardiomyopathy, muscle weakness and lactic acidosis after exercise.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital cataract-hypertrophic cardiomyopathy-mitochondrial myopathy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sengers syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital cataract-hypertrophic cardiomyopathy-mitochondrial myopathy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008922</skos:exactMatch>
        <skos:exactMatch>MeSH:C538280</skos:exactMatch>
        <skos:exactMatch>OMIM:212350</skos:exactMatch>
        <skos:exactMatch>UMLS:C1859317</skos:exactMatch>
        <skos:narrowMatch>OMIM:615418</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618805</skos:narrowMatch>
    </owl:Class>

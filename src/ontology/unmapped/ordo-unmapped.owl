            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by microcephaly, characteristic facial features, hypotonia, non-progressive intellectual deficit, myopia and retinal dystrophy, neutropenia and truncal obesity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cohen syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cohen syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008999</skos:exactMatch>
        <skos:exactMatch>MeSH:C536438</skos:exactMatch>
        <skos:exactMatch>MedDRA:10049066</skos:exactMatch>
        <skos:exactMatch>OMIM:216550</skos:exactMatch>

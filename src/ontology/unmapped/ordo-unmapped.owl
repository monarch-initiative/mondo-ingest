    <!-- http://www.orpha.net/ORDO/Orphanet_329894 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329894">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_329888"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare juvenile idiopathic inflammatory myopathy characterized by the association of inflammatory myositis (manifesting with acral erythema, progressive weakness of the limbs, pain, general fatigue, moodiness or crankiness) with clinical and/or laboratory features of other autoimmune diseases (e.g. systemic lupus erythematosus, localized scleroderma, diabetes). Cardiac involvement has been reported in some patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Juvenile overlap myositis</oboInOwl:hasExactSynonym>
        <rdfs:label>Juvenile overlap myositis</rdfs:label>
        <skos:broadMatch>ICD-10:M33.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0018011</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707728</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_329894"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Juvenile overlap myositis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3299 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3299">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_65283 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_65283">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180772"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_768"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies syndrome with cardiac involvement as a major feature characterized by QT prolongation, congenital heart defects, syndactyly, facial dysmorphism and neurodevelopmental features. There are three clinical phenotypes recognized, the classical types that present with a prolonged QT interval and either with (TS1) or without (TS2) cutaneous syndactyly of fingers and toes. The atypical form (ATS) causes multi-system health concerns but not necessarily with prolonged QT.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LQT8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Long QT syndrome type 8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Long QT syndrome-syndactyly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Timothy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Timothy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:I49.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:BC65.0</skos:broadMatch>
        <skos:broadMatch>OMIM:618447</skos:broadMatch>
        <skos:exactMatch>MONDO:0010979</skos:exactMatch>
        <skos:exactMatch>MeSH:C536962</skos:exactMatch>
        <skos:exactMatch>MedDRA:10079205</skos:exactMatch>
        <skos:exactMatch>OMIM:601005</skos:exactMatch>
        <skos:exactMatch>UMLS:C1832916</skos:exactMatch>
    </owl:Class>

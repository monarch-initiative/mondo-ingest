                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic motor neuron disease characterized by predominantly motor axonal peripheral neuropathy manifesting with progressive scapuloperoneal muscular atrophy and weakness, laryngeal palsy, congenital absence of muscles, and, in some, skeletal abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurogenic scapuloperoneal amyotrophy, New England type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPSMA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Scapuloperoneal neuronopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Scapuloperoneal spinal muscular atrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Scapuloperoneal spinal muscular atrophy</rdfs:label>
        <skos:broadMatch>ICD-10:G12.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B61.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0008408</skos:exactMatch>
        <skos:exactMatch>OMIM:181405</skos:exactMatch>
        <skos:exactMatch>UMLS:C0751335</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_431255"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

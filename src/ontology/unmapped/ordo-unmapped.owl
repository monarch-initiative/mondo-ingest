    <!-- http://www.orpha.net/ORDO/Orphanet_2326 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2326">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_645378 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645378">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>

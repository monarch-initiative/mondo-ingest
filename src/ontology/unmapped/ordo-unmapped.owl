        <obo:IAO_0000115 xml:lang="en">Hypertelorism-hypospadias-polysyndactyly syndrome is a very rare syndrome associating an acro-fronto-facio-nasal dysostosis with genitourinary anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acrofrontofacionasal dysostosis type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acrofrontofacionasal syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypertelorism-hypospadias-polysyndactyly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Naguib-Richieri-Costa syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypertelorism-hypospadias-polysyndactyly syndrome</rdfs:label>

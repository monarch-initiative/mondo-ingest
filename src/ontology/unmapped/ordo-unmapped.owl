        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98010"/>
        <obo:IAO_0000115 xml:lang="en">A toxin-mediated infection due to the anaerobic bacteria &lt;i&gt;Clostridium tetani&lt;/i&gt; and characterized by spasms and contractions of the skeletal muscles, the disease is often lethal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Tetanus</oboInOwl:hasExactSynonym>
        <rdfs:label>Tetanus</rdfs:label>
        <skos:exactMatch>MONDO:0005526</skos:exactMatch>
        <skos:exactMatch>MeSH:D013742</skos:exactMatch>
        <skos:exactMatch>MedDRA:10043376</skos:exactMatch>
        <skos:exactMatch>UMLS:C0039614</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A33</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A34</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A35</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C13</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C14</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C15</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3299"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2483 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2483">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79384"/>
        <obo:IAO_0000115 xml:lang="en">A rare orofacial granulomatosis characterized by the triad of recurrent or persistent orofacial edema (facial and lip edemas), fissured tongue, and relapsing, unilateral or bilateral peripheral facial nerve paralysis. Most cases present with partial symptoms. Typical age of onset is in childhood or adolescence. Histological examination shows non-caseating epithelioid cell granulomas and lymphedema.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Melkersson-Rosenthal syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Melkersson-Rosenthal syndrome</rdfs:label>
        <skos:broadMatch>ICD-11:8B88.Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:G51.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0007969</skos:exactMatch>
        <skos:exactMatch>MeSH:D008556</skos:exactMatch>
        <skos:exactMatch>MedDRA:10027166</skos:exactMatch>

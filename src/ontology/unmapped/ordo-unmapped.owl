                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1908"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Chorea-acanthocytosis (ChAc) is a form of neuroacanthocytosis and is characterized clinically by a Huntington disease-like phenotype with progressive neurological symptoms including movement disorders, psychiatric manifestations and cognitive disturbances.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ChAc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chorea-acanthocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Choreoacanthocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Levine-Critchley syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Choreoacanthocytosis</rdfs:label>
        <skos:broadMatch>ICD-10:E78.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008695</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081505</skos:exactMatch>
        <skos:exactMatch>OMIM:200150</skos:exactMatch>
        <skos:exactMatch>UMLS:C5848062</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_79140 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79140">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100101"/>

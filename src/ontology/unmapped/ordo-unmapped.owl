    <!-- http://www.orpha.net/ORDO/Orphanet_329249 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329249">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98267"/>
        <rdfs:subClassOf>
            <owl:Restriction>

    <!-- http://www.orpha.net/ORDO/Orphanet_329308 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329308">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100981"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_86845 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_86845">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare mosaic syndrome characterized by the combination of two or more of the following: fibrous dysplasia of bone (FD), hyperpigmented macules, and hyperfunctioning endocrinopathies (precocious puberty, hyperthyroidism, growth hormone excess, endogenous Cushing syndrome).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>McCune-Albright syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>McCune-Albright syndrome</rdfs:label>

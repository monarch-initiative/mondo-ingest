            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Transient infantile hypertriglyceridemia and hepatosteatosis is a rare, genetic, hepatic disease characterized by massive hepatomegaly, moderate to severe, transient hypertriglyceridemia and hepatic steatosis (followed by fibrosis), manifesting in infancy with failure to thrive, vomiting, an enlarged abdomen and a fatty liver. Reduction or normalization of triglyceride serum levels occurs with advancing age.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Transient infantile hypertriglyceridemia and fatty liver</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Transient infantile hypertriglyceridemia and hepatosteatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Transient infantile hypertriglyceridemia and hepatosteatosis</rdfs:label>
        <skos:broadMatch>ICD-10:K76.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:DB99.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013771</skos:exactMatch>
        <skos:exactMatch>OMIM:614480</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751115</skos:exactMatch>
        <skos:narrowMatch>OMIM:619324</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_300293"/>

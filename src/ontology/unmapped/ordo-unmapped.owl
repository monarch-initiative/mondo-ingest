    <!-- http://www.orpha.net/ORDO/Orphanet_2300 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2300">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108967"/>

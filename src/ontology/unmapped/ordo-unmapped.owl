                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/23212"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Peripheral neuropathy-myopathy-hoarseness-hearing loss syndrome is a rare, syndromic genetic deafness characterized by a combination of muscle weakness, chronic neuropathic and myopathic features, hoarseness and sensorineural hearing loss. A wide range of disease onset and severity has been reported even within the same family.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MYH14-related peripheral neuropathy-myopathy-hoarseness-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Peripheral neuropathy-myopathy-hoarseness-deafness syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>MYH14-related peripheral neuropathy-myopathy-hoarseness-hearing loss syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0013711</skos:exactMatch>
        <skos:exactMatch>OMIM:614369</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190594</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_397744"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

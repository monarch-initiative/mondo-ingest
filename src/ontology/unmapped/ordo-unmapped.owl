        <obo:IAO_0000115 xml:lang="en">Unspecified juvenile idiopathic arthritis is a rare, pediatric, rheumatologic disease, a subtype of juvenile idiopathic arthritis (JIA) characterized by arthritis of an unknown cause that persists for at least 6 weeks, and does not fulfill the criteria for any of the other JIA subtypes, or fulfills criteria for more than one of the other subtypes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Unspecified JIA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Unspecified juvenile idiopathic arthritis</oboInOwl:hasExactSynonym>
        <rdfs:label>Unspecified juvenile idiopathic arthritis</rdfs:label>
        <skos:broadMatch>ICD-10:M08.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:FA24.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019607</skos:exactMatch>

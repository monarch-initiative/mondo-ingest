            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Thrombocythemia with distal limb defects is a rare, genetic syndrome with limb reduction defects characterized by thrombocytosis, unilateral transverse limb defects (ranging from absence of phalanges to absence of hand or forearm) and splenomegaly.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial thrombocytosis with transverse limb defect</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary thrombocytosis with transverse limb defect</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Thrombocythemia with distal limb defects</oboInOwl:hasExactSynonym>
        <rdfs:label>Thrombocythemia with distal limb defects</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0018000</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749944</skos:exactMatch>
    </owl:Class>

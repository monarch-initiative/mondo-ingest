    <!-- http://www.orpha.net/ORDO/Orphanet_3208 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3208">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206966"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98534"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11138"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18618"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30343"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13487"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary late-onset Parkinson disease (LOPD) is a form of Parkinson disease (PD), characterized by an age of onset of more than 50 years, tremor at rest, gait complaints and falls, bradykinesia, rigidity and painful cramps. Patients usually present a low risk of developing non motor symptoms, dystonia, dyskinesia and levodopa-induced dyskinesia (LID).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant late-onset Parkinson disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary late-onset Parkinson disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LOPD</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary late-onset Parkinson disease</rdfs:label>
        <skos:broadMatch>ICD-10:G20</skos:broadMatch>
        <skos:exactMatch>MONDO:0008199</skos:exactMatch>
        <skos:exactMatch>MONDO:8199</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274355</skos:exactMatch>
        <skos:narrowMatch>OMIM:168601</skos:narrowMatch>
        <skos:narrowMatch>OMIM:605543</skos:narrowMatch>
        <skos:narrowMatch>OMIM:607060</skos:narrowMatch>
        <skos:narrowMatch>OMIM:607688</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614203</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614251</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616361</skos:narrowMatch>
    </owl:Class>

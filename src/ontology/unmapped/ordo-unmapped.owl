    <!-- http://www.orpha.net/ORDO/Orphanet_79332 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79332">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269546"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_30391 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_30391">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108971"/>

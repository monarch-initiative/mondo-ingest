    <!-- http://www.orpha.net/ORDO/Orphanet_171871 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171871">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_756"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7979"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of pseudohypoaldosteronism type 1 characterized by mild mineralocorticoid resistance that is restricted to the kidneys and that usually improves in early childhood. Typical presentation is in the neonatal period with weight loss, failure to thrive, vomiting and dehydration in association with hyponatremia, hyperkalemia and metabolic acidosis as well as elevated aldosterone and renin levels.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant PHA1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant pseudohypoaldosteronism type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Renal PHA1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Renal pseudohypoaldosteronism type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Renal pseudohypoaldosteronism type 1</rdfs:label>
        <skos:broadMatch>ICD-10:N25.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB90.41</skos:broadMatch>
        <skos:exactMatch>MONDO:0008329</skos:exactMatch>
        <skos:exactMatch>OMIM:177735</skos:exactMatch>
        <skos:exactMatch>UMLS:C1449842</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_171871"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Renal pseudohypoaldosteronism type 1</owl:annotatedTarget>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2200"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Mild spondyloepiphyseal dysplasia due to COL2A1 mutation with early-onset osteoarthritis is a type 2 collagen-related bone disorder characterized by precocious, generalized osteoarthritis (with onset as early as childhood) and mild, dysplastic spinal changes (flattening of vertebrae, irregular endplates and wedge-shaped deformities) resulting in a mildly short trunk.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mild spondyloepiphyseal dysplasia due to COL2A1 mutation with early-onset osteoarthritis</oboInOwl:hasExactSynonym>
        <rdfs:label>Mild spondyloepiphyseal dysplasia due to COL2A1 mutation with early-onset osteoarthritis</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0011496</skos:exactMatch>
        <skos:exactMatch>OMIM:604864</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275063</skos:exactMatch>
    </owl:Class>

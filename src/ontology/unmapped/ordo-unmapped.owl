    <!-- http://www.orpha.net/ORDO/Orphanet_94065 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94065">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262119"/>

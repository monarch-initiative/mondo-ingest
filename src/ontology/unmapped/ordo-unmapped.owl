            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20582"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of hereditary spastic paraplegia characterized by delayed walking, toe walking, unsteady and spastic gait, hyperreflexia of the lower limbs, and extensor plantar responses. Upper limbs spasticity and dystonia, subclinical axonal neuropathy, cognitive impairment and intellectual disability have also been associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive spastic paraplegia type 56</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG56</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive spastic paraplegia type 56</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0014015</skos:exactMatch>
        <skos:exactMatch>OMIM:615030</skos:exactMatch>
        <skos:exactMatch>UMLS:C3539507</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

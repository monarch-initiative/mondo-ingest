        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <obo:IAO_0000115 xml:lang="en">Yemenite deaf-blind hypopigmentation syndrome is an exceedingly rare genetic disorder characterized by cutaneous pigmentation anomalies, ocular disorders and hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Deaf blind hypopigmentation syndrome, Yemenite type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Warburg-Thomsen syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Yemenite deaf-blind hypopigmentation syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Deaf blind hypopigmentation syndrome, Yemenite type</rdfs:label>
        <skos:broadMatch>ICD-10:Q13.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011133</skos:exactMatch>
        <skos:exactMatch>MeSH:C536771</skos:exactMatch>
        <skos:exactMatch>OMIM:601706</skos:exactMatch>
        <skos:exactMatch>UMLS:C1866425</skos:exactMatch>
    </owl:Class>

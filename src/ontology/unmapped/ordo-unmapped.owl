            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6990"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An X-linked syndromic intellectual disability characterized by developmental delay, variable degree of intellectual disability, speech delay or absent speech, pyramidal signs, tremor, macroorchidism and variable mood and behavior problems, including psychosis and autistic-like behavior. Males are predominantly affected, some females show lower cognitive abilities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Lindsay-Burn syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PPM-X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked intellectual disability-psychosis-macroorchidism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked intellectual disability-psychosis-macroorchidism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:F71.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90</skos:broadMatch>
        <skos:exactMatch>MONDO:0010235</skos:exactMatch>
        <skos:exactMatch>OMIM:300055</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796222</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3077"/>

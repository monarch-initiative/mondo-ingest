        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79359"/>
        <obo:IAO_0000115 xml:lang="en">A rare acquired epidermal dysplasia characterized by annular, well-circumscribed patches of erythematous depressed skin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Circumscribed acral hypokeratosis</oboInOwl:hasExactSynonym>

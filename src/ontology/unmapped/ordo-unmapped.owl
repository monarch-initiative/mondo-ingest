    <!-- http://www.orpha.net/ORDO/Orphanet_1344 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1344">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101934"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217635"/>

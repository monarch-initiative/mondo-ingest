    <!-- http://www.orpha.net/ORDO/Orphanet_1072 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1072">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1071"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15979"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, syndromic, developmental defect of the eye malformation characterized by unilateral or bilateral, single or multiple, filiforme bands of elastic tissue which connect the eyelid margins at the grey line, associated with cleft lip and palate. Eye examination is otherwise normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ankyloblepharon filiforme adnatum-cleft palate syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ankyloblepharon filiforme adnatum-cleft palate syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007123</skos:exactMatch>
        <skos:exactMatch>OMIM:106250</skos:exactMatch>
        <skos:exactMatch>UMLS:C1862866</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1072"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ankyloblepharon filiforme adnatum-cleft palate syndrome</owl:annotatedTarget>

        <obo:IAO_0000115 xml:lang="en">1p21.3 microdeletion syndrome is an extremely rare chromosomal anomaly characterized by severe speech and language delay, intellectual deficiency, autism spectrum disorder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>1p21.3 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(1)(p21.3)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 1p21.3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(1)(p21.3)</oboInOwl:hasExactSynonym>
        <rdfs:label>1p21.3 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.11</skos:broadMatch>
        <skos:exactMatch>MONDO:0017405</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304578</skos:exactMatch>
    </owl:Class>

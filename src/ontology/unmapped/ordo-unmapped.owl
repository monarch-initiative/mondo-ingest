    <!-- http://www.orpha.net/ORDO/Orphanet_2516 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2516">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>

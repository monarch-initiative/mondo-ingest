        <oboInOwl:hasExactSynonym xml:lang="en">Cancer of penis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Malignant penile tumor</oboInOwl:hasExactSynonym>

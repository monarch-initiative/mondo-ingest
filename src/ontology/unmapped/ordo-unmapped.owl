        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_53715"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3680"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4125"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6344"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive disorder characterized by the occurrence of cutaneous and subcutaneous calcified masses, usually adjacent to large joints, such as hips, shoulders and elbows. It can occur in the setting of hyperphosphatemia or normophosphatemia, depending on the type of gene mutation involved.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial hyperphosphatemic tumoral calcinosis/Hyperphosphatemic hyperostosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypercalcemic tumoral calcinosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial hyperphosphatemic tumoral calcinosis/Hyperphosphatemic hyperostosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:M11.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0100251</skos:exactMatch>
        <skos:exactMatch>OMIM:211900</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679978</skos:exactMatch>
        <skos:narrowMatch>OMIM:617993</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617994</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_397750 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_397750">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206976"/>

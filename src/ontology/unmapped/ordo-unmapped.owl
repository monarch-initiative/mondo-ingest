    <!-- http://www.orpha.net/ORDO/Orphanet_357107 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_357107">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

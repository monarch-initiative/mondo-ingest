        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">An X-linked syndromic intellectual disability characterized by intellectual disability, subcortical cerebral atrophy, dental anomalies, patella luxation, lower back skin dimple, and dysmorphic facial features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Prieto-Badia-Mulas syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked intellectual disability-dysmorphism-cerebral atrophy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked intellectual disability-dysmorphism-cerebral atrophy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>

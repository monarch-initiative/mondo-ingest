            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3683"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial isolated trichomegaly is a rare genetic hair anomaly characterized by a prolonged anagen phase of the eyelash hairs, leading to extreme eyelash growth that may result in corneal irritation. Increased growth of hair on other parts of the face (eyebrows, cheeks, forehead) and/or the body (chest, arms, legs) may be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial isolated trichomegaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial isolated trichomegaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.2</skos:broadMatch>

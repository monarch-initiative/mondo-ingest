    <!-- http://www.orpha.net/ORDO/Orphanet_2942 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2942">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98506"/>
        <obo:IAO_0000115 xml:lang="en">Postpoliomyelitis syndrome (PPS) is a neurologic disorder characterized by the development of new neuromuscular symptoms such as progressive muscular weakness or abnormal muscle fatigability occurring in survivors of the acute paralytic form of poliomyelitis, 15-40 years after recovery from the disease, and that is unexplained by other medical causes. Other manifestations that can occur gradually include generalized fatigue, muscle atrophy, muscle and joint pain, intolerance to cold, and difficulties sleeping, swallowing or breathing.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Postpolio syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Postpoliomyelitic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Postpoliomyelitis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Postpoliomyelitis syndrome</rdfs:label>
        <skos:exactMatch>ICD-10:G14</skos:exactMatch>
        <skos:exactMatch>ICD-11:8B62</skos:exactMatch>
        <skos:exactMatch>MONDO:0017416</skos:exactMatch>
        <skos:exactMatch>MeSH:D016262</skos:exactMatch>
        <skos:exactMatch>MedDRA:10036239</skos:exactMatch>
        <skos:exactMatch>UMLS:C0080040</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13176"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome with combined immunodeficiency characterized by a variable clinical presentation ranging from asymptomatic individuals to potentially life-threatening, recurrent bacterial infections associated with progressive loss of serum immunoglobulins and B cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CVID phenotype due to IKAROS functional haploinsufficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Common variable immunodeficiency phenotype due to IKAROS functional haploinsufficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Common variable immunodeficiency phenotype due to IKZF1 functional haploinsufficiency</oboInOwl:hasExactSynonym>

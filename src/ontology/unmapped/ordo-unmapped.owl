    <!-- http://www.orpha.net/ORDO/Orphanet_620186 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_620186">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_620152"/>
        <obo:IAO_0000115 xml:lang="en">A form of non-syndromic multisutural craniosynostosis characterized by premature fusion of the unicoronal and sagittal sutures, resulting in anterior plagiocephaly with contralateral frontal bulging and elongated head shape (turricephaly). Orbital abnormality and strabismus are associated features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated unicoronal and sagittal craniosynostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Non-syndromic unicoronal and sagittal craniosynostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-syndromic unilateral coronal and sagittal suture synostosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-syndromic unicoronal and sagittal craniosynostosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q75.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB70.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0850080</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680396</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_620186"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

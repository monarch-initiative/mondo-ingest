    <!-- http://www.orpha.net/ORDO/Orphanet_79141 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79141">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_307846"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare focal palmoplantar keratoderma disorder characterized by the development of thick, painful, non-erythematous, nummular keratotic lesions over pressure points of feet and possibly hands. Occasionally, knee and shin involvement, periungual/subungual hyperkeratoses, and blistering at the edge of the calluses, may be observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hereditary painful callosities</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratosis palmoplantaris nummularis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PPK nummularis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Plamoplantar hyperkeratosis nummularis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Plamoplantar keratoderma nummularis</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary painful callosities</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.31</skos:broadMatch>
        <skos:exactMatch>MONDO:0007248</skos:exactMatch>
        <skos:exactMatch>MeSH:C566180</skos:exactMatch>
        <skos:exactMatch>OMIM:114140</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861964</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_79141"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/27230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by the association of highly variable limb reduction defects affecting both upper and lower limbs, growth retardation, microcephaly, craniofacial anomalies and variable neurodevelopmental delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Pseudothalidomide syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Roberts syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Roberts-SC phocomelia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SC phocomelia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SC pseudothalidomide syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Roberts syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0100253</skos:exactMatch>
        <skos:exactMatch>MONDO:100253</skos:exactMatch>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3806"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4798"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial papillary or follicular thyroid carcinoma is a rare, hereditary nonmedullary thyroid carcinoma characterized by the presence of differentiated thyroid cancer of follicular cell origin in two or more first-degree relatives, in the absence of other familial tumor syndromes or radiation exposure. Frequent capsular invasion is observed. Biopsy reveals multicentric tumors with multiple adenomatous nodules with or without oxyphilia and follicular or papillary carcinoma histology.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FNMTC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial papillary or follicular thyroid carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial pure nonmedullary thyroid carcinoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial papillary or follicular thyroid carcinoma</rdfs:label>
        <skos:broadMatch>ICD-10:C73</skos:broadMatch>
        <skos:broadMatch>OMIM:188550</skos:broadMatch>
        <skos:exactMatch>MONDO:0017895</skos:exactMatch>
        <skos:narrowMatch>OMIM:188470</skos:narrowMatch>
        <skos:narrowMatch>OMIM:603386</skos:narrowMatch>
        <skos:narrowMatch>OMIM:603744</skos:narrowMatch>
        <skos:narrowMatch>OMIM:606240</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616534</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616535</skos:narrowMatch>
    </owl:Class>

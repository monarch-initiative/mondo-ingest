        <oboInOwl:hasExactSynonym xml:lang="en">CMRD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CRD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chylomicron retention disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Chylomicron retention disease</rdfs:label>
        <skos:broadMatch>ICD-10:E78.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C81.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0009528</skos:exactMatch>
        <skos:exactMatch>MeSH:C535460</skos:exactMatch>
        <skos:exactMatch>OMIM:246700</skos:exactMatch>

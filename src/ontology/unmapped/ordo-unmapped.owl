                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16783"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by synchronous or metachronous occurrence of primary hyperparathyroidism and ossifying fibroma of the maxilla and/or mandible, associated with an increased risk of parathyroid carcinoma. Occurrence of renal cysts or tumors, multiple uterine polyps, and thyroid tumors has also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HPT-JT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hyperparathyroidism-jaw tumor syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperparathyroidism-jaw tumor syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E21.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A51.0</skos:broadMatch>
        <skos:broadMatch>OMIM:145001</skos:broadMatch>

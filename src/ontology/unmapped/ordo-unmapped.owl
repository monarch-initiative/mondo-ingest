        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98052"/>
        <obo:IAO_0000115 xml:lang="en">A rare immunologic pulmonary disorder caused by hypersensitivity to &lt;i&gt;Aspergillus fumigatus&lt;/i&gt;, clinically manifesting with poorly controlled asthma and recurrent pulmonary infiltrates.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ABPA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Allergic aspergillosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Allergic bronchopulmonary aspergillosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hinson-Pepys disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Allergic bronchopulmonary aspergillosis</rdfs:label>
        <skos:broadMatch>ICD-10:B44.1+</skos:broadMatch>
        <skos:broadMatch>ICD-10:J99.8*</skos:broadMatch>
        <skos:broadMatch>ICD-11:CA82.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0015243</skos:exactMatch>
        <skos:exactMatch>MeSH:D001229</skos:exactMatch>
        <skos:exactMatch>MedDRA:10006474</skos:exactMatch>
        <skos:exactMatch>UMLS:C0004031</skos:exactMatch>
        <skos:narrowMatch>OMIM:103920</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1164"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

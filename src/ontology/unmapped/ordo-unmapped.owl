        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Double-outlet left ventricle (DOLV) is an extremely rare congenital cardiac malformation in which both the aorta and the pulmonary artery arise, either exclusively or predominantly, from the morphologic left ventricle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DOLV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Double outlet left ventricle</oboInOwl:hasExactSynonym>
        <rdfs:label>Double outlet left ventricle</rdfs:label>
        <skos:exactMatch>ICD-10:Q20.2</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA85.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0018090</skos:exactMatch>

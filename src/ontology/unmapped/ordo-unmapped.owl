        <obo:IAO_0000115 xml:lang="en">A rare combined hyperlipidemia (HLP type 3) characterized by high levels of cholesterol and triglycerides, transported by intermediate density lipoproteins (IDLs), and a high risk of progressive atherosclerosis and premature cardiovascular disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Broad-beta disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dysbetalipoproteinemia</oboInOwl:hasExactSynonym>

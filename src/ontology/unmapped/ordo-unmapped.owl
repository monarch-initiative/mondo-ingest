        <oboInOwl:hasExactSynonym xml:lang="en">Rod monochromacy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rod monochromatism</oboInOwl:hasExactSynonym>

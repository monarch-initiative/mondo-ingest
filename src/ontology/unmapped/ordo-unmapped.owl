    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_19 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_19">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225689"/>

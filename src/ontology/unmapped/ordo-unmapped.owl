    <!-- http://www.orpha.net/ORDO/Orphanet_97685 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97685">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262137"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_636"/>
        <obo:IAO_0000115 xml:lang="en">17q11 microdeletion syndrome is a rare severe form of neurofibromatosis type 1 (NF1) characterized by mild facial dysmorphism, developmental delay, intellectual disability, increased risk of malignancies, and a large number of neurofibromas.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>17q11 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(17)(q11)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 17q11</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NF1 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurofibromatosis type 1 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(17)(q11)</oboInOwl:hasExactSynonym>
        <rdfs:label>17q11 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q85.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.H0</skos:broadMatch>
        <skos:exactMatch>MONDO:0013357</skos:exactMatch>
        <skos:exactMatch>MeSH:C563524</skos:exactMatch>
        <skos:exactMatch>OMIM:613675</skos:exactMatch>
        <skos:exactMatch>UMLS:C5401456</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

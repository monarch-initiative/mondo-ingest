    <!-- http://www.orpha.net/ORDO/Orphanet_1302 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1302">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98300"/>
        <obo:IAO_0000115 xml:lang="en">A rare form of idiopathic interstitial pneumonia characterized pathologically by organizing pneumonia (OP) that presents with nonspecific flu-like symptoms, as well as cough and dyspnea, and where no etiological agent is found.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BOOP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bronchiolitis obliterans organizing pneumonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">COP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cryptogenic organizing pneumonia</oboInOwl:hasExactSynonym>
        <rdfs:label>Cryptogenic organizing pneumonia</rdfs:label>
        <skos:broadMatch>ICD-10:J84.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:CB03.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0015264</skos:exactMatch>
        <skos:exactMatch>MeSH:D018549</skos:exactMatch>
        <skos:exactMatch>MedDRA:10011496</skos:exactMatch>
        <skos:exactMatch>UMLS:C0242770</skos:exactMatch>
    </owl:Class>

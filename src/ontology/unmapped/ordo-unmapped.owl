    <!-- http://www.orpha.net/ORDO/Orphanet_254851 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_254851">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254776"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

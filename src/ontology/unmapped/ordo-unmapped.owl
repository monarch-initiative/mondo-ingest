    <!-- http://www.orpha.net/ORDO/Orphanet_35710 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_35710">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104003"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

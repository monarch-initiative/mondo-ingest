            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spondyloepiphyseal dysplasia, Kimberley type (SEDK) is characterized by short stature and premature degenerative arthropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Spondyloepiphyseal dysplasia, Kimberley type</oboInOwl:hasExactSynonym>
        <rdfs:label>Spondyloepiphyseal dysplasia, Kimberley type</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0012019</skos:exactMatch>
        <skos:exactMatch>MeSH:C564252</skos:exactMatch>
        <skos:exactMatch>OMIM:608361</skos:exactMatch>
        <skos:exactMatch>UMLS:C1842149</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93283"/>

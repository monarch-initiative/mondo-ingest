    <!-- http://www.orpha.net/ORDO/Orphanet_930 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_930">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101936"/>

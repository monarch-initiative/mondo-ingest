    <!-- http://www.orpha.net/ORDO/Orphanet_171703 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171703">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

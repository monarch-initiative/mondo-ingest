        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_284454 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_284454">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_730376"/>
        <obo:IAO_0000115 xml:lang="en">A rare acquired retinal disorder characterised by sequential focal degeneration of photoreceptors, retinal pigment epithelium and choroid, with the majority of patients experiencing sudden onset photopsia and acute scotomas. Although patients typically retain decent visual acuity, blind spot enlargement and retinal pigment epithelial disturbances tend to develop over time. Individuals also often complain of distortion of central vision, photophobia and difficulty with night vision, with more advanced cases reporting loss of peripheral vision.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AZOOR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acute zonal occult outer retinopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Acute zonal occult outer retinopathy</rdfs:label>
        <skos:broadMatch>ICD-10:H35.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B65.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0017298</skos:exactMatch>
        <skos:exactMatch>UMLS:C0730298</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_284454"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

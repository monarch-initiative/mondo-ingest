    <!-- http://www.orpha.net/ORDO/Orphanet_369 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_369">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

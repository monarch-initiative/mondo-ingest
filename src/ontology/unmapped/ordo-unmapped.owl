            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Endocrine-cerebro-osteodysplasia (ECO) syndrome is characterized by various anomalies of the endocrine, cerebral, and skeletal systems resulting in neonatal mortality.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ECO syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Endocrine-cerebro-osteodysplasia syndrome</oboInOwl:hasExactSynonym>

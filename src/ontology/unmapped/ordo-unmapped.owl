        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98006"/>
        <obo:IAO_0000115 xml:lang="en">Worster-Drought syndrome (WDS) is a form of cerebral palsy characterized by congenital pseudobulbar (suprabulbar) paresis manifesting as selective weakness of the lips, tongue and soft palate, dysphagia, dysphonia, drooling and jaw jerking.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital suprabulbar paresis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Worster-Drought syndrome</oboInOwl:hasExactSynonym>

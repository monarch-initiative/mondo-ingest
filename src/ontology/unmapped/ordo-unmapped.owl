        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare metabolic liver disease characterized by progressive liver disease and early cirrhosis due to accumulation of toxic cholesterol metabolites, which are detectable in bile, plasma, and urine, in association with dental abnormalities such as general hypomineralization and enamel hypoplasia, as well as occurrence of supernumerary teeth. There have been no further descriptions in the literature since 1996.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Lyngstadaas syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Steroid dehydrogenase deficiency-dental anomalies syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Steroid dehydrogenase deficiency-dental anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:K76.8</skos:broadMatch>

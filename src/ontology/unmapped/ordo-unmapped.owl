        <oboInOwl:hasExactSynonym>Stargardt disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Stargardt disease</rdfs:label>
        <skos:broadMatch>ICD-10:H35.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B70</skos:broadMatch>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare childhood-onset epilepsy characterized by sudden onset, short lasting absence associated with rhythmical myoclonia of head and shoulders.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Epilepsy with myoclonic absences</oboInOwl:hasExactSynonym>
        <rdfs:label>Epilepsy with myoclonic absences</rdfs:label>
        <skos:broadMatch>ICD-10:G40.4</skos:broadMatch>

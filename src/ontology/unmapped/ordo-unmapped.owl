    <!-- http://www.orpha.net/ORDO/Orphanet_3115 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3115">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140453"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7225"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9118"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare demyelinating hereditary motor and sensory neuropathy characterized by prominent gait ataxia, pes cavus, tendon areflexia, distal limb weakness, tremor in the upper limbs, distal sensory loss, kyphoscoliosis, and progressive muscle atrophy. The disease becomes symptomatic in infancy or childhood, mode of inheritance is autosomal dominant.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary areflexic dystasia, Roussy-Lévy type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Roussy-Lévy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Roussy-Lévy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C20.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008392</skos:exactMatch>
        <skos:exactMatch>MedDRA:10063449</skos:exactMatch>
        <skos:exactMatch>OMIM:180800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0205713</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3115"/>

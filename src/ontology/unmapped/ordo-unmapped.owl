        <obo:IAO_0000115 xml:lang="en">Spinocerebellar ataxia type 23 (SCA23) is a very rare subtype of type I autosomal dominant cerebellar ataxia (ADCA type I). It is characterized by gait ataxia, dysarthria, slowed saccades, ocular dysmetria, Babinski sign and hyperreflexia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA23</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 23</oboInOwl:hasExactSynonym>
        <rdfs:label>Spinocerebellar ataxia type 23</rdfs:label>

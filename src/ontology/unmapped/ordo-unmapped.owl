    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_100013 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100013">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_86823"/>
        <obo:IAO_0000115 xml:lang="en">A severe form of lissencephaly with cerebellar hypoplasia characterized by severe microcephaly, cleft palate, and severe cerebellar and brainstem hypoplasia leading to neonatal death.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lissencephaly with cerebellar hypoplasia type C</oboInOwl:hasExactSynonym>
        <rdfs:label>Lissencephaly with cerebellar hypoplasia type C</rdfs:label>

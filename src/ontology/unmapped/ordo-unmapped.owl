    <!-- http://www.orpha.net/ORDO/Orphanet_199337 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_199337">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101937"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165661"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2443"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_293830"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16232"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic mitochondrial disease characterized by exocrine pancreatic insufficiency, dyserythropoietic anemia, and calvarial hyperostosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Pancreatic insufficiency-anemia-hyperostosis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Pancreatic insufficiency-anemia-hyperostosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012992</skos:exactMatch>
        <skos:exactMatch>OMIM:612714</skos:exactMatch>
        <skos:exactMatch>UMLS:C2675184</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_199337"/>

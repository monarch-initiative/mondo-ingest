    <!-- http://www.orpha.net/ORDO/Orphanet_84132 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_84132">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206662"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209041"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209193"/>

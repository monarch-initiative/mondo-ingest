        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare lethal combination of manifestations including short stature, congenital cataracts, encephalopathy with epileptic fits, and postmortem confirmation of nephropathy (renal tubular necrosis). There have been no further descriptions in the literature since 1963.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cataract-nephropathy-encephalopathy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Crome syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cataract-nephropathy-encephalopathy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009045</skos:exactMatch>
        <skos:exactMatch>MeSH:C536216</skos:exactMatch>
        <skos:exactMatch>OMIM:218900</skos:exactMatch>
        <skos:exactMatch>UMLS:C0795914</skos:exactMatch>
    </owl:Class>

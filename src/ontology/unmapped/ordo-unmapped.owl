    <!-- http://www.orpha.net/ORDO/Orphanet_2597 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2597">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206966"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254837"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A rare metabolic myopathy presenting during childhood, and characterized clinically by growth failure, severe muscle weakness, and moderate sensorineural deafness and biochemically by metabolic acidosis, elevated serum pyruvate concentration, hyperalaninemia and hyperalaninuria. There have been no further descriptions in the literature since 1973.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mitochondrial myopathy-lactic acidosis-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mitochondrial myopathy-lactic acidosis-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Mitochondrial myopathy-lactic acidosis-deafness syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G71.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C73.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:251950</skos:broadMatch>
        <skos:exactMatch>MONDO:0016825</skos:exactMatch>
        <skos:exactMatch>MeSH:C537476</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518539</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2597"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mitochondrial myopathy-lactic acidosis-deafness syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2598 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2598">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206966"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35696"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98362"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/24249"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Mitochondrial myopathy and sideroblastic anemia belongs to the heterogeneous family of metabolic myopathies. It is characterised by progressive exercise intolerance manifesting in childhood, onset of sideroblastic anaemia around adolescence, lactic acidaemia, and mitochondrial myopathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MLASA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mitochondrial myopathy and sideroblastic anemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myopathy, lactic acidosis and sideroblastic anemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Mitochondrial myopathy and sideroblastic anemia</rdfs:label>
        <skos:broadMatch>ICD-10:G71.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A72.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0000863</skos:exactMatch>
        <skos:exactMatch>MeSH:C536101</skos:exactMatch>
        <skos:exactMatch>OMIM:600462</skos:exactMatch>
        <skos:exactMatch>UMLS:C1838103</skos:exactMatch>
        <skos:narrowMatch>OMIM:500011</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613561</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2598"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mitochondrial myopathy and sideroblastic anemia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_25980 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_25980">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206644"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206662"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/22082"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked myopathy characterized by childhood or adult-onset of slowly progressive muscle weakness and unique histopathological findings (autophagic vacuoles with sarcolemmal features).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked myopathy with excessive autophagy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XMEA</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked myopathy with excessive autophagy</rdfs:label>
        <skos:broadMatch>ICD-10:G71.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A41.21</skos:broadMatch>
        <skos:exactMatch>MONDO:0010684</skos:exactMatch>
        <skos:exactMatch>MeSH:C564093</skos:exactMatch>
        <skos:exactMatch>OMIM:310440</skos:exactMatch>
        <skos:exactMatch>UMLS:C1839615</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_25980"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>X-linked myopathy with excessive autophagy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_26 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_26">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79163"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79171"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98396"/>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of vitamin B12 (cobalamin) metabolism characterized by megaloblastic anemia, lethargy, failure to thrive, developmental delay, intellectual deficit and seizures. There are four complementation classes of cobalamin defects (cblC, cblD, cblF and cblJ) that are responsible for methylmalonic acidemia - homocystinuria (methylmalonic acidemia - homocystinuria cblC, cblD cblF and cblJ).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Combined defect in adenosylcobalamin and methylcobalamin synthesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Methylmalonic acidemia with homocystinuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Methylmalonic aciduria with homocystinuria</oboInOwl:hasExactSynonym>
        <rdfs:label>Methylmalonic acidemia with homocystinuria</rdfs:label>
        <skos:broadMatch>ICD-10:E71.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E0</skos:broadMatch>
        <skos:exactMatch>MONDO:0016826</skos:exactMatch>
        <skos:exactMatch>MeSH:C537359</skos:exactMatch>
        <skos:exactMatch>UMLS:C5848324</skos:exactMatch>
        <skos:narrowMatch>OMIM:277380</skos:narrowMatch>
        <skos:narrowMatch>OMIM:277400</skos:narrowMatch>
        <skos:narrowMatch>OMIM:277410</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614857</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_26"/>

        <obo:IAO_0000115 xml:lang="en">Myoclonus-dystonia syndrome (MDS) is a rare movement disorder characterized by mild to moderate dystonia along with &apos;lightning-like&apos; myoclonic jerks.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Alcohol-responsive dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary essential myoclonus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myoclonic dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Myoclonus-dystonia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Myoclonus-dystonia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G24.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A02.11</skos:broadMatch>
        <skos:exactMatch>MONDO:0000903</skos:exactMatch>

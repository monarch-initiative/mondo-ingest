            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">COG4-CDG is an extremely rare form of CDG syndrome characterized clinically in the single reported case to date by seizures, some dysmorphic features, axial hypotonia, slight peripheral hypertonia and hyperreflexia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type IIj</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG-IIj</oboInOwl:hasExactSynonym>

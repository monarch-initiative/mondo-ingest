            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">The CDG (Congenital Disorders of Glycosylation) syndromes are a group of autosomal recessive disorders affecting glycoprotein synthesis. CDG syndrome type IIh is characterised by severe psychomotor retardation, failure to thrive and intolerance to wheat and dairy products.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type IIh</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG-IIh</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG2H</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>COG8-CDG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Carbohydrate deficient glycoprotein syndrome type IIh</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 2h</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type IIh</oboInOwl:hasExactSynonym>
        <rdfs:label>COG8-CDG</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C54.2</skos:broadMatch>

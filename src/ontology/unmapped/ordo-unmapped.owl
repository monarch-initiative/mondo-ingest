        <rdfs:label>Tunnel subaortic stenosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q24.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA8A.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0020394</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681647</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_99053"/>

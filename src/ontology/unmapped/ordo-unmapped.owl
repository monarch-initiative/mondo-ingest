    <!-- http://www.orpha.net/ORDO/Orphanet_79333 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79333">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

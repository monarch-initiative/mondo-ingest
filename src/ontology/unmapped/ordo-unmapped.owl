        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17129"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited inborn error of metabolism resulting in a severe zinc deficiency and characterized by acral dermatitis, alopecia, diarrhea and growth failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AEZ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acrodermatitis enteropathica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acrodermatitis enteropathica, zinc deficiency type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inherited zinc deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Acrodermatitis enteropathica</rdfs:label>
        <skos:broadMatch>ICD-10:E83.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C64.20</skos:exactMatch>
        <skos:exactMatch>MONDO:0008713</skos:exactMatch>
        <skos:exactMatch>MeSH:C538178</skos:exactMatch>
        <skos:exactMatch>MedDRA:10000596</skos:exactMatch>
        <skos:exactMatch>OMIM:201100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0221036</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

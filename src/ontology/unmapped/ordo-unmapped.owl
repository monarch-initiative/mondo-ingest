        <owl:annotatedTarget>Short stature-skeletal dysplasia-retinal degeneration-intellectual disability-sensorineural hearing loss syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_589515 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_589515">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166472"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_94145"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14957"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic syndromic intellectual disability characterized by developmental delay, intellectual disability, ataxia, and, more variably, seizures and short stature. Behavioral abnormalities may also be observed, as well as variable facial and other dysmorphic features (such as broad nasal bridge, hypertelorism, almond-shaped eyes, high-arched palate, and anomalies of the fingers and toes). Brain imaging may reveal dilated ventricles, small corpus callosum, or posterior fossa abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PADDAS syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>PUM1-associated developmental disability-ataxia-seizure syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>PUM1-associated developmental disability-ataxia-seizure syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0035117</skos:exactMatch>
        <skos:exactMatch>MONDO:35117</skos:exactMatch>
        <skos:exactMatch>OMIM:620719</skos:exactMatch>
        <skos:exactMatch>UMLS:C4693672</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_589515"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

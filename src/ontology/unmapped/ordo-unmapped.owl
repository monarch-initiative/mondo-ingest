        <obo:IAO_0000115 xml:lang="en">Ewing&apos;s sarcoma is a malignant small round cell bone tumor with strong metastatic potential.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Osseous Ewing sarcoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Skeletal Ewing sarcoma</oboInOwl:hasExactSynonym>

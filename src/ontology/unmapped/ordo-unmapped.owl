    <!-- http://www.orpha.net/ORDO/Orphanet_1450 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1450">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363203"/>

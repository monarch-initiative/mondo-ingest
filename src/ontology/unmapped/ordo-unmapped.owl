    <!-- http://www.orpha.net/ORDO/Orphanet_69 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_69">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182222"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A vast group of rare systemic diseases characterized by the presence of insoluble fibrillar protein deposits in tissues. Amyloidoses are classified according to biochemical type of amyloid protein involved.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Amyloidosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Amyloidosis</rdfs:label>
        <skos:exactMatch>ICD-10:E85.0</skos:exactMatch>

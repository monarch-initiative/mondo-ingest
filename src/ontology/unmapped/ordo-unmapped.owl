        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2801 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2801">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93444"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11909"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Juvenile Paget disease is a very rare form of Paget disease of the bone characterized by a general increase in bone turnover with increased bone resorption and deposition, resulting in cortical and trabecular thickening, and clinically presenting as progressive skeletal deformities, growth impairment, fractures, vertebral collapse, skull enlargement and sensorineural hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial osteoectasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary hyperphosphatasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperostosis corticalis deformans juvenilis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">JPG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Juvenile Paget disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Juvenile Paget disease</rdfs:label>
        <skos:broadMatch>ICD-10:M88.0</skos:broadMatch>
        <skos:broadMatch>ICD-10:M88.8</skos:broadMatch>
        <skos:broadMatch>ICD-10:M88.9</skos:broadMatch>
        <skos:exactMatch>ICD-11:FB85.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0009394</skos:exactMatch>
        <skos:exactMatch>MeSH:C537701</skos:exactMatch>
        <skos:exactMatch>MedDRA:10078977</skos:exactMatch>
        <skos:exactMatch>OMIM:239000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268414</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2801"/>

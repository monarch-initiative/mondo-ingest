        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of Mayer-Rokitansky-Küster-Hauser syndrome, characterized by congenital aplasia of the uterus and upper two-thirds of the vagina that is associated with at least one other malformation such as renal, vertebral, or, less commonly, auditory and cardiac defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Atypical MRKH syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MRKH syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MURCS association</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mayer-Rokitansky-Küster-Hauser syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Müllerian duct aplasia-renal dysplasia-cervical somite anomalies syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Mayer-Rokitansky-Küster-Hauser syndrome type 2</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD2F.14</skos:exactMatch>

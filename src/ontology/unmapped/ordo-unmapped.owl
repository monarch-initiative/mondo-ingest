    <!-- http://www.orpha.net/ORDO/Orphanet_289553 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_289553">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2732 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2732">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">Olivopontocerebellar atrophy-deafness syndrome is characterised by infancy-onset olivopontocerebellar atrophy, sensorineural deafness and speech impairment. It has been described in less than 15 children. Most cases were sporadic, but autosomal recessive inheritance was suggested in three cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Olivopontocerebellar atrophy-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Olivopontocerebellar atrophy-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Olivopontocerebellar atrophy-deafness syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017135</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275113</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2732"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Olivopontocerebellar atrophy-deafness syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2733 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2733">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93438"/>
        <obo:IAO_0000115 xml:lang="en">Omodysplasia is a rare skeletal dysplasia characterized by severe limb shortening and facial dysmorphism. Two types of omodysplasia have been described: an autosomal recessive or generalized form (also referred to as micromelic dysplasia with dislocation of radius) marked by severe micromelic dwarfism with predominantly rhizomelic shortening of both the upper and lower limbs, and an autosomal dominant form in which stature is normal and shortening is limited to the upper limbs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Omodysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Omodysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.A</skos:broadMatch>
        <skos:exactMatch>MONDO:0017136</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510897</skos:exactMatch>
        <skos:narrowMatch>OMIM:164745</skos:narrowMatch>
        <skos:narrowMatch>OMIM:258315</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2733"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Omodysplasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2736 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2736">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139039"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by the association of omphalocele and cleft palate. Other reported features include cleft lip, bifid uvula, bilateral talipes equinovarus, bicornuate uterus, and hydrocephalus internus. The condition is lethal in infancy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Czeizel syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lethal omphalocele-cleft palate syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lethal omphalocele-cleft palate syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009780</skos:exactMatch>
        <skos:exactMatch>MeSH:C537747</skos:exactMatch>
        <skos:exactMatch>OMIM:258320</skos:exactMatch>
        <skos:exactMatch>UMLS:C1850317</skos:exactMatch>

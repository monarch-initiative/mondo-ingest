    <!-- http://www.orpha.net/ORDO/Orphanet_157954 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_157954">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181387"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

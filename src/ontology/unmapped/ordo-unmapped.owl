    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_43">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101960"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181441"/>

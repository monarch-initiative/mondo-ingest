    <!-- http://www.orpha.net/ORDO/Orphanet_1685 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1685">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163588"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare parasitic diseases characterized by infection with flukes with oral and ventral suckers, comprising Clonorchiasis (infection with liver flukes), Fasciolopsiasis (infection with intestinal flukes), and Paragonimiasis (infection with lung flukes). Signs and symptoms depend on the affected organ and are of variable severity. Some patients may be asymptomatic.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distomiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fluke infection</oboInOwl:hasExactSynonym>
        <rdfs:label>Distomatosis</rdfs:label>
        <skos:broadMatch>ICD-10:B66.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0015675</skos:exactMatch>
        <skos:exactMatch>MONDO:15675</skos:exactMatch>
        <skos:exactMatch>UMLS:C0040820</skos:exactMatch>
        <skos:narrowMatch>ICD-10:B66.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B66.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B66.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B66.3</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B66.4</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B66.5</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1F80</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1F83</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1F85</skos:narrowMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_312 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_312">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_281103"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

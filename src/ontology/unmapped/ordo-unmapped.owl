            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Isolated cleft lip is a fissure type embryopathy extending from the upper lip to the nasal base.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated cleft lip</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated cleft lip</rdfs:label>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of congenital dyserythropoietic anemia (CDA) characterized by dyserythropoiesis, with big multinucleated erythroblasts in the bone marrow, and manifesting with mild to moderate anemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDA III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDA type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDA type III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital dyserythropoietic anemia type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital dyserythropoietic anemia type III</oboInOwl:hasExactSynonym>

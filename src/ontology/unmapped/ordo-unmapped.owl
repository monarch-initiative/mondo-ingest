        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Spastic paraplegia-precocious puberty syndrome is a complex form of hereditary spastic paraplegia characterized by the onset of progressive spastic paraplegia associated with precocious puberty (due to Leydig cell hyperplasia) in childhood (at the age of 2 years). Moderate intellectual disability was also reported. There have been no further descriptions in the literature since 1983.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Spastic paraplegia-precocious puberty syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Spastic paraplegia-precocious puberty syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0008443</skos:exactMatch>
        <skos:exactMatch>MeSH:C536874</skos:exactMatch>
        <skos:exactMatch>OMIM:182820</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518543</skos:exactMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">Systemic polyarteritis nodosa (PAN) is a chronic systemic necrotizingvasculitis of adults and childrenaffecting small- and medium-sized vessels and characterized by formation of microaneurysms leading to serious generalized disease and multi-organ involvement.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Systemic PAN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Systemic periarteritis nodosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Systemic polyarteritis nodosa</oboInOwl:hasExactSynonym>

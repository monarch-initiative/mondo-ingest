    <!-- http://www.orpha.net/ORDO/Orphanet_227990 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_227990">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_282196"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare autoimmune polyendocrinopathy characterized by autoimmune activity against an endocrine organ in combination with at least one more endocrine or non-endocrine organ. Typical autoimmune diseases occurring in this type include insulin-requiring diabetes, pernicious anemia, alopecia, vitiligo, or myasthenia gravis, but not Addison disease, thyroid disease, or hypoparathyroidism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">APS type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">APS4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autoimmune polyendocrine syndrome type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autoimmune polyendocrinopathy type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autoimmune polyglandular syndrome type 4</oboInOwl:hasExactSynonym>
        <rdfs:label>Autoimmune polyendocrinopathy type 4</rdfs:label>
        <skos:broadMatch>ICD-10:E31.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5B00</skos:broadMatch>
        <skos:exactMatch>MONDO:0016423</skos:exactMatch>
        <skos:exactMatch>UMLS:C3266026</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_227990"/>

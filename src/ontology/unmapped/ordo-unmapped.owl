        <owl:annotatedTarget>Mixed sclerosing bone dystrophy with extra-skeletal manifestations</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

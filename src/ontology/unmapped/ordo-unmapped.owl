        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11535"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">X-linked dystonia-parkinsonism (XDP) is a neurodegenerative movement disorder characterized by adult-onset parkinsonism that is frequently accompanied by focal dystonia, which becomes generalized over time, and that has a highly variable clinical course.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DYT3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lubag</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lubag syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked dystonia-parkinsonism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XDP</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked dystonia-parkinsonism</rdfs:label>
        <skos:broadMatch>ICD-10:G24.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A00.20</skos:broadMatch>
        <skos:exactMatch>MONDO:0010747</skos:exactMatch>
        <skos:exactMatch>MeSH:C564048</skos:exactMatch>
        <skos:exactMatch>OMIM:314250</skos:exactMatch>
        <skos:exactMatch>UMLS:C1839130</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

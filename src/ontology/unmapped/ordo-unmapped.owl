    <!-- http://www.orpha.net/ORDO/Orphanet_1551 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1551">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309839"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Familial benign copper deficiency is a rare disorder of mineral absorption and transport characterized by hypocupremia that manifests as failure to thrive, mild anemia, repeated seizures, hypotonia, and seborrheic skin. Spurring of the femur and tibia are also noted on radiographic imaging. Symptoms are reversible or improve with supplements of oral copper. There have been no further descriptions in the literature since 1988.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial benign copper deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial benign hypocupremia</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial benign copper deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E83.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007368</skos:exactMatch>
        <skos:exactMatch>MeSH:C535468</skos:exactMatch>
        <skos:exactMatch>OMIM:121270</skos:exactMatch>
        <skos:exactMatch>UMLS:C1852576</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1551"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial benign copper deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1552 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1552">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>

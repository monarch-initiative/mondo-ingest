    <!-- http://www.orpha.net/ORDO/Orphanet_2582 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2582">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182222"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_556508"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Myalgia-eosinophilia syndrome associated with tryptophan is a rare systemic disease characterized by severe myalgia and peripheral eosinophilia associated with tryptophan dietary supplementation. The symptoms do not subside after tryptophan discontinuation. Clinical presentation includes muscle tenderness and cramps, fatigue, weakness, paresthesia, peripheral edema, arthralgia, dyspnea, skin rash, dry mouth, and development of scleroderma-like skin abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Myalgia-eosinophilia syndrome associated with tryptophan</oboInOwl:hasExactSynonym>
        <rdfs:label>Myalgia-eosinophilia syndrome associated with tryptophan</rdfs:label>
        <skos:broadMatch>ICD-10:M35.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A43.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016822</skos:exactMatch>
        <skos:exactMatch>MeSH:D016603</skos:exactMatch>
        <skos:exactMatch>MedDRA:10014952</skos:exactMatch>
        <skos:exactMatch>UMLS:C1275050</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2582"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

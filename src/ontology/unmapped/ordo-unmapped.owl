    <!-- http://www.orpha.net/ORDO/Orphanet_506 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_506">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225700"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225703"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2443"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98687"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29685"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A progressive neurological disease defined by specific neuropathological features associating brainstem and basal ganglia lesions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Infantile subacute necrotizing encephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Leigh disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Leigh syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Leigh syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G31.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C53.24</skos:exactMatch>
        <skos:exactMatch>MONDO:0009723</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_88639 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_88639">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79163"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4908"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Neurodegeneration due to 3-hydroxyisobutyryl-CoA hydrolase deficiency is characterised by delayed motor development, hypotonia and progressive neurodegeneration. To date, it has been described in four boys. The syndrome is caused by mutations affecting the two alleles of the &lt;i&gt; HIBCH&lt;/i&gt; gene, encoding 3-hydroxyisobutyryl-CoA hydrolase. The mode of transmission has not yet been established.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HIBCH deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Methacrylic aciduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neurodegeneration due to 3-hydroxyisobutyryl-CoA hydrolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Valine metabolic defect</oboInOwl:hasExactSynonym>
        <rdfs:label>Neurodegeneration due to 3-hydroxyisobutyryl-CoA hydrolase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E71.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E0</skos:broadMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_1133 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1133">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181381"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183625"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic ectodermal dysplasia syndrome characterized by lipoatrophic diabetes, mild craniofacial dysmorphism (such as pronounced antitragal incisura and mandibular prognathism), ectodermal dysplasia (generalized hypotrichosis and dental and nail abnormalities), hypoplasia or aplasia of the breasts, and urogenital/renal anomalies. Additional reported manifestations include skeletal abnormalities and hepatosplenomegaly. There have been no further descriptions in the literature since 1992.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>AREDYLD syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acrorenal defect-ectodermal dysplasia-diabetes syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>AREDYLD syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008812</skos:exactMatch>
        <skos:exactMatch>MeSH:C537427</skos:exactMatch>
        <skos:exactMatch>OMIM:207780</skos:exactMatch>
        <skos:exactMatch>UMLS:C0342280</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1133"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>AREDYLD syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1134 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1134">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156246"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">An extremely rare, major congenital malformation consisting of an absence of the nose ranging from hyporrhinia (absence of external nasal structures) to total arrhinia (absence of external nose, nasal airways, olfactory bulbs, or olfactory nerve) often causing respiratory distress and requiring surgical correction. Arrhinia can be bilateral or unilateral (hemiarrhinia). Associated anomalies include ocular features (hypertelorism, microphthalmia, eyelid coloboma), facial clefts, midline defects and microtia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated arrhinia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated nose agenesis</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated arrhinia</rdfs:label>
        <skos:broadMatch>ICD-10:Q30.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA70.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0015237</skos:exactMatch>
        <skos:exactMatch>MeSH:C537438</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265740</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1134"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Isolated arrhinia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



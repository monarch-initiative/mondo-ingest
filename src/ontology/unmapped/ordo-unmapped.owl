    <!-- http://www.orpha.net/ORDO/Orphanet_411543 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_411543">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_3222"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9462"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A severe form of phosphoribosylpyrophosphate (PRPP) synthetase superactivity, an X-linked disorder of purine metabolism, characterized by early onset hyperuricemia and hyperuricosuria, and clinically manifesting with urolithiasis, gout and neurodevelopmental anomalies consisting of variable combinations of sensorineural hearing loss, hypotonia, and ataxia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe PRPP synthetase superactivity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe PRPS1 superactivity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Severe phosphoribosylpyrophosphate synthetase superactivity</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe phosphoribosylpyrophosphate synthetase superactivity</rdfs:label>
        <skos:broadMatch>ICD-10:E79.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C55.0Y</skos:broadMatch>
        <skos:broadMatch>OMIM:300661</skos:broadMatch>
        <skos:exactMatch>MONDO:0018464</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680017</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_411543"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Severe phosphoribosylpyrophosphate synthetase superactivity</owl:annotatedTarget>

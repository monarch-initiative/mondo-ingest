            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/35416"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Primary dystonia, DYT17 type is a rare, genetic, isolated dystonia initially presenting as torticollis, and later progressing to segmental or generalized dystonia. Dysphonia and dysarthria also occur later in the disease course.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Primary dystonia, DYT17 type</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary dystonia, DYT17 type</rdfs:label>
        <skos:broadMatch>ICD-10:G24.1</skos:broadMatch>

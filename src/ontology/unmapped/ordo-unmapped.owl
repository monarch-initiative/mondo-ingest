            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hypotrichosis with juvenile macular degeneration (HJMD) is a very rare syndrome characterized by sparse and short hair from birth followed by progressive macular degeneration leading to blindness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HJMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypotrichosis with juvenile macular degeneration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypotrichosis with juvenile macular dystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypotrichosis with juvenile macular degeneration</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011107</skos:exactMatch>
        <skos:exactMatch>MeSH:C537698</skos:exactMatch>
        <skos:exactMatch>OMIM:601553</skos:exactMatch>
        <skos:exactMatch>UMLS:C1832162</skos:exactMatch>
    </owl:Class>

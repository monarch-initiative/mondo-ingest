        <skos:narrowMatch>OMIM:609630</skos:narrowMatch>
        <skos:narrowMatch>OMIM:612557</skos:narrowMatch>
        <skos:narrowMatch>OMIM:612558</skos:narrowMatch>
        <skos:narrowMatch>OMIM:612559</skos:narrowMatch>
    </owl:Class>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Crisponi syndrome (CS) is a severe disorder characterized by muscular contractions at birth, intermittent hyperthermia, facial abnormalities and camptodactyly.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Crisponi syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Crisponi syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G90.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.41</skos:broadMatch>
        <skos:broadMatch>OMIM:272430</skos:broadMatch>
        <skos:exactMatch>MONDO:0010091</skos:exactMatch>
        <skos:exactMatch>MeSH:C536214</skos:exactMatch>
        <skos:exactMatch>UMLS:C1832409</skos:exactMatch>
    </owl:Class>

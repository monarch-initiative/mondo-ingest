    <!-- http://www.orpha.net/ORDO/Orphanet_38874 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_38874">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_295041 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_295041">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C053"/>

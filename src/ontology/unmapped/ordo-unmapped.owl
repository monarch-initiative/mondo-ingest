        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare skeletal dysplasia characterized by short limbs dysmorphic facies and diagnostic radiographic findings.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AO3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">AOIII</oboInOwl:hasExactSynonym>

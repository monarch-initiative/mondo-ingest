    <!-- http://www.orpha.net/ORDO/Orphanet_3230 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3230">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139042"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183580"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">Deafness-oligodontia syndrome is characterised by sensorineural hearing loss and oligodontia/hypodontia. It has been described in two pairs of siblings and in one isolated case. Dizziness was reported in one of the pairs of siblings. Transmission appears to be autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Deafness-oligodontia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hearing loss-oligodontia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Deafness-oligodontia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:H90.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009089</skos:exactMatch>
        <skos:exactMatch>MeSH:C538049</skos:exactMatch>
        <skos:exactMatch>OMIM:221740</skos:exactMatch>
        <skos:exactMatch>UMLS:C1857333</skos:exactMatch>
    </owl:Class>

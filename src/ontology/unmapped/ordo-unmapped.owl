        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">Inhalational botulism is a man-made form of botulism, a rare acquired neuromuscular junction disease with descending flaccid paralysis caused by botulinum neurotoxins (BoNTs).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Inhalation botulism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inhalational botulism</oboInOwl:hasExactSynonym>
        <rdfs:label>Inhalational botulism</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_231632 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231632">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_231641"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Ectopic aldosterone-producing tumor is an extremely rare aldosterone-producing neoplasm composed of aberrant adrenocortical tissue located outside the adrenal glands (e.g. in retroperitoneum, perirenal or periaortic fatty tissue, thorax, spinal canal, testes, ovaries) typically characterized by symptoms related to increased aldosterone levels (such as sustained, treatment-resistant hypertension and hypokalemia) or symptoms caused by local tumor enlargement.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ectopic aldosterone-producing tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Extra-adrenal aldosterone-producing tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Ectopic aldosterone-producing tumor</rdfs:label>
        <skos:broadMatch>ICD-10:E26.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A72.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0016506</skos:exactMatch>
        <skos:exactMatch>UMLS:C4755311</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4390"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital neurocutaneous syndrome defined by a facial capillary malformation or port-wine birthmark (PWB) associated with cerebral and ocular ipsilateral vascular malformations in most of the cases resulting in variable ocular and neurological complications.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Encephalofacial angiomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Encephalotrigeminal angiomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SWS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sturge-Weber syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sturge-Weber-Dimitri syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sturge-Weber-Krabbe angiomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sturge-Weber-Krabbe syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Sturge-Weber syndrome</rdfs:label>

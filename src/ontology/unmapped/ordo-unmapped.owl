    <!-- http://www.orpha.net/ORDO/Orphanet_98673 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98673">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254822"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98672"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2973"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9255"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neuro-ophthalmological disease which is one of the most common forms of hereditary optic neuropathy characterized by progressive bilateral visual loss with an onset during the first decade of life, associated with optic disc pallor, visual acuity loss, visual field deficits and color vision defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant optic atrophy, Kjer type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autosomal dominant optic atrophy, classic form</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Kjer optic atrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Optic atrophy type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant optic atrophy, classic form</rdfs:label>
        <skos:broadMatch>ICD-10:H47.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:9C40.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008134</skos:exactMatch>
        <skos:exactMatch>UMLS:C0338508</skos:exactMatch>
        <skos:narrowMatch>OMIM:165500</skos:narrowMatch>
        <skos:narrowMatch>OMIM:605293</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610708</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618977</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98673"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autosomal dominant optic atrophy, classic form</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



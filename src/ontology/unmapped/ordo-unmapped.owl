    <!-- http://www.orpha.net/ORDO/Orphanet_126 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_126">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98575"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98578"/>
        <obo:IAO_0000115 xml:lang="en">A rare ophthalmic disorder characterized by blepharophimosis, ptosis, epicanthus inversus, and telecanthus, that can appear associated with (type 1) or without primary ovarian insufficiency (POI; type 2).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BPES</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Blepharophimosis-ptosis-epicanthus inversus syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Blepharophimosis-ptosis-epicanthus inversus syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q10.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD21.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007201</skos:exactMatch>
        <skos:exactMatch>MeSH:C562419</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081258</skos:exactMatch>
        <skos:exactMatch>OMIM:110100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0220663</skos:exactMatch>
    </owl:Class>

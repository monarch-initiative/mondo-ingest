    <!-- http://www.orpha.net/ORDO/Orphanet_1310 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1310">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93443"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2197"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Caffey disease is an osteosclerotic dysplasia characterized by acute inflammation with massive subperiosteal new bone formation usually involving the diaphyses of the long bones, as well as the ribs, mandible, scapulae, and clavicles. The disease is associated with fever, irritability pain and soft tissue swelling, with onset around the age of 2 months and resolving spontaneously by the age of 2 years. However, prenatal disease onset has also been described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Caffey disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Infantile cortical hyperostosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Caffey disease</rdfs:label>
        <skos:broadMatch>ICD-10:M89.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007244</skos:exactMatch>
        <skos:exactMatch>MeSH:D006958</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073206</skos:exactMatch>
        <skos:exactMatch>OMIM:114000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0020497</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1310"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Caffey disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1313 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1313">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic intellectual disability characterized by severe intellectual disability and calcification of the choroid plexus, associated with elevated cerebrospinal fluid protein concentration. Additional signs and symptoms include strabismus, increased deep tendon reflexes, and foot deformities, among others. There have been no further descriptions in the literature since 1993.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Infantile choroidocerebral calcification syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile choroidocerebral calcification syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G93.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008981</skos:exactMatch>
        <skos:exactMatch>MeSH:C535357</skos:exactMatch>
        <skos:exactMatch>OMIM:215480</skos:exactMatch>
        <skos:exactMatch>UMLS:C1859092</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1313"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Infantile choroidocerebral calcification syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1314 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1314">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98006"/>
        <obo:IAO_0000115 xml:lang="en">Symmetrical thalamic calcifications are clinically distinguished by a low Apgar score, spasticity or marked hypotonia, weak or absent cry, poor feeding, and facial diplegia or weakness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bilateral symmetrical thalamic gliosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Symmetrical thalamic calcifications</oboInOwl:hasExactSynonym>
        <rdfs:label>Symmetrical thalamic calcifications</rdfs:label>
        <skos:broadMatch>ICD-10:G93.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0015269</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304914</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1314"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Symmetrical thalamic calcifications</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Schilder&apos;s disease is a progressive demyelinating disorder of the central nervous system.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Myelinoclastic diffuse sclerosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Schilder disease</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic craniosynostosis characterized by the association of coronal craniosynostosis with radial ray anomalies (oligodactyly, aplasia or hypoplasia of the thumb, aplasia or hypoplasia of the radius).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Baller-Gerold syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Baller-Gerold syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q75.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.GY</skos:broadMatch>
        <skos:exactMatch>MONDO:0009039</skos:exactMatch>
        <skos:exactMatch>MeSH:C536788</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083963</skos:exactMatch>
        <skos:exactMatch>OMIM:218600</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265308</skos:exactMatch>
    </owl:Class>

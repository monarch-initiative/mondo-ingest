    <!-- http://www.orpha.net/ORDO/Orphanet_1114 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1114">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183481"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183542"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

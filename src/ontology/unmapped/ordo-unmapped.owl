    <!-- http://www.orpha.net/ORDO/Orphanet_32960 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_32960">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290839"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290842"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_324924"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare adrenal Cushing syndrome characterized by bilateral benign adrenal macronodules (&gt;1 cm) that potentially produce autonomously variable levels of cortisol excess. Although in most cases are ACTH-independent, non-suppressed ACTH levels have been described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CS due to BMACD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CS due to BMAD</oboInOwl:hasExactSynonym>

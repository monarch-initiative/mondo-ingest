        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-syndromic form of thyroid cancer characterized by occurrence of thyroid carcinoma (TC) as the primary feature in a familial setting.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial nonmedullary thyroid carcinoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial nonmedullary thyroid carcinoma</rdfs:label>

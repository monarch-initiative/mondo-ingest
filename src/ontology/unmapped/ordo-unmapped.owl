        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183622"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_202948"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12787"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30650"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic congenital malformation syndrome characterized by bilateral anophthalmia (or less commonly microphthalmia) in association with a variable combination of the following: pulmonary hypoplasia or agenesis, congenital diaphragmatic hernia or eventration, and variable cardiovascular defects (congenital heart defects and/or pulmonary artery atresia). Intellectual disability is noted in surviving patients. Other variable malformations affecting different organ systems, as well as facial dysmorphism, may be observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Anophthalmia-pulmonary hypoplasia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Matthew-Wood syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PDAC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pulmonary hypoplasia-diaphragmatic hernia-anophthalmia-cardiac defect syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spear syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Matthew-Wood syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q11.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD21.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0011010</skos:exactMatch>
        <skos:exactMatch>MeSH:C537768</skos:exactMatch>
        <skos:exactMatch>OMIM:601186</skos:exactMatch>
        <skos:exactMatch>UMLS:C1832661</skos:exactMatch>
    </owl:Class>

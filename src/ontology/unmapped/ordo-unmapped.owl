            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15646"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic, multiple congenital anomalies syndrome characterized by the overlap of several typical clinical features of Bohring-Opitz syndrome and of Crisponi Syndrome/cold-induced sweating syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>KLHL7-related Bohring-Opitz-like and Crisponi/Cold-induced sweating-like overlap syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PERCHING syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>KLHL7-related Bohring-Opitz-like and Crisponi/Cold-induced sweating-like overlap syndrome</rdfs:label>

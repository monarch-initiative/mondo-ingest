    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_31150 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_31150">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207018"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207021"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_31153"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic neurometabolic disease characterized biochemically by an almost complete absence of plasma high-density lipoproteins (HDL), and clinically by liver, spleen, lymph node and tonsil enlargement along with multifocal peripheral neuropathy, corneal, skin and nail and, occasionally, cardiovascular disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ATP-binding cassette transporter A1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Analphalipoproteinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tangier disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Tangier disease</rdfs:label>
        <skos:broadMatch>ICD-10:E78.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C81.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008783</skos:exactMatch>
        <skos:exactMatch>MeSH:D013631</skos:exactMatch>
        <skos:exactMatch>MedDRA:10051875</skos:exactMatch>
        <skos:exactMatch>OMIM:205400</skos:exactMatch>
        <skos:exactMatch>UMLS:C0039292</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

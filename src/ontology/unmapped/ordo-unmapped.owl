    <!-- http://www.orpha.net/ORDO/Orphanet_284388 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_284388">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377792"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98022"/>
        <obo:IAO_0000115 xml:lang="en">A rare cerebrovascular disorder characterized by severe headaches with or without focal neurological deficits or seizures, and a reversible segmental and multifocal vasoconstriction of cerebral arteries. It may occur spontaneously or be provoked by various precipitating factors, the most common being postpartum and exposure to various vasoactive substances such as illicit drugs and selective serotonin-reuptake inhibitors. The major complication is ischemic or hemorrhagic stroke.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">RCVS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reversible cerebral vasoconstriction syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Reversible cerebral vasoconstriction syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:I67.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B22.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0017291</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073240</skos:exactMatch>
        <skos:exactMatch>UMLS:C3544214</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_284388"/>

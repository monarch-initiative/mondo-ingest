            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2591"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of classic congenital adrenal hyperplasia (CAH) characterized by glucocorticoid deficiency, hyperandrogenism, hypertension and virilization in females.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CAH due to 11-beta-hydroxylase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CYP11B1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital adrenal hyperplasia due to 11-beta-hydroxylase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital adrenal hyperplasia due to 11-beta-hydroxylase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E25.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A71.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0008729</skos:exactMatch>
        <skos:exactMatch>MeSH:C535978</skos:exactMatch>
        <skos:exactMatch>MedDRA:10000002</skos:exactMatch>
        <skos:exactMatch>OMIM:202010</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268292</skos:exactMatch>
    </owl:Class>

        <obo:IAO_0000115 xml:lang="en">Maternal uniparental disomy of chromosome 6 is an uniparental disomy of maternal origin characterized by intrauterine growth retardation. Homozygosity for a recessive disease mutation for which only a mother is a carrier may lead to other phenotypes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Maternal uniparental disomy of chromosome 6 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UPD(6)mat</oboInOwl:hasExactSynonym>

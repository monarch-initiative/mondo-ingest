            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A congenital, X-linked, clinical subtype of L1 syndrome, characterized by spastic paraplegia, mild to moderate intellectual disability and normal brain morphology. This subtype represents the milder end of the L1 syndrome spectrum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked complicated spastic paraplegia type 1</oboInOwl:hasExactSynonym>

        <skos:exactMatch>MeSH:D006816</skos:exactMatch>
        <skos:exactMatch>MedDRA:10070668</skos:exactMatch>
        <skos:exactMatch>OMIM:143100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0020179</skos:exactMatch>
    </owl:Class>

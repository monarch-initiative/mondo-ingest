        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Interleukin-1 receptor-associated kinase-4 (IRAK-4) deficiency is an immunodeficiency associated with increased susceptibility to invasive infections caused by pyogenic bacteria.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Transient predisposition to invasive pyogenic bacterial infection</oboInOwl:hasExactSynonym>
        <rdfs:label>Transient predisposition to invasive pyogenic bacterial infection</rdfs:label>

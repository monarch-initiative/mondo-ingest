        <oboInOwl:hasExactSynonym>Congenital dyserythropoietic anemia type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary erythroblastic multinuclearity with a positive acidified-serum test (hempas)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SEC23B-CDG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hereditary erythroblastic multinuclearity with a positive acidified-serum test</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital dyserythropoietic anemia type II</rdfs:label>

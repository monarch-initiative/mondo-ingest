        <oboInOwl:hasExactSynonym xml:lang="en">Hyperlipidemia type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperlipoproteinemia type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Remnant hyperlipoproteinemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Dysbetalipoproteinemia</rdfs:label>

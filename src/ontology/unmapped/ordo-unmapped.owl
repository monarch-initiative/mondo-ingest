        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_97 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_211062"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98745"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1388"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of hereditary episodic ataxia (EA) characterized by paroxysmal episodes of ataxia lasting hours, with interictal nystagmus and mildly progressive ataxia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Episodic ataxia type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial paroxysmal ataxia</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial paroxysmal ataxia</rdfs:label>
        <skos:broadMatch>ICD-10:G11.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A03.14</skos:broadMatch>
        <skos:exactMatch>MONDO:0007163</skos:exactMatch>
        <skos:exactMatch>OMIM:108500</skos:exactMatch>
        <skos:exactMatch>UMLS:C1720416</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial paroxysmal ataxia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_970 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_970">

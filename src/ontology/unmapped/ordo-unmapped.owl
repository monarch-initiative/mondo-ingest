                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14203"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare severe neurodegenerative disorder that is considered one of the phenocopies of Huntington Disease (HD) affecting patients of African descent and characterized by a triad of movement (chorea, oculomotor, parkinsonism), psychiatric (prominently sadness, irritability and anxiety), and cognitive abnormalities (early cognitive decline and subcortical-like dementia).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HDL2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Huntington disease-like 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Huntington disease-like 2</rdfs:label>
        <skos:broadMatch>ICD-10:G10</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A01.11</skos:broadMatch>
        <skos:exactMatch>MONDO:0011671</skos:exactMatch>
        <skos:exactMatch>MeSH:C564708</skos:exactMatch>
        <skos:exactMatch>OMIM:606438</skos:exactMatch>
        <skos:exactMatch>UMLS:C1847987</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_206484 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_206484">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363472"/>

        <owl:annotatedTarget>Isolated congenital sclerocornea</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_91491 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91491">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98634"/>
        <obo:IAO_0000115 xml:lang="en">Congenital ectropion uveae is a rare, genetic, non-syndromic developmental defect of the eye characterized by the presence of iris pigment epithelium on the anterior surface of the iris, anterior insertion of the iris, angle dysgenesis and progressive open-angle glaucoma (the latter may present in infancy or may develop later in life). Patients may manifest with headaches, ocular pain, photophobia, and redness, watering and/or swelling of the eye. It can often be associated with neurofibromatosis and less commonly with other ocular abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital ectropion uveae</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital ectropion uveae</rdfs:label>
        <skos:broadMatch>ICD-10:Q13.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA14.03</skos:broadMatch>
        <skos:exactMatch>MONDO:0019630</skos:exactMatch>
        <skos:exactMatch>UMLS:C1303012</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_91491"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital ectropion uveae</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_91492 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91492">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183557"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_141007 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_141007">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140997"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716405"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/21485"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental disorder of the ciliopathy group characterized by highly arched palate with bifid and lobulated tongue, lingual hamartoma, multiple frenula, bilateral supernumerary lower canines, hypertelorism, telecanthus, strabismus, broad and/or bifid nasal tip, short stature, bifid hallux, poly- and syndactyly, mild intellectual disability and specific retinal abnormalities mostly retinal coloboma. Brain structural anomalies may also be observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">OFD9</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oral-facial-digital syndrome type 9</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oral-facial-digital syndrome with retinal abnormalities</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Orofaciodigital syndrome type 9</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Orofaciodigital syndrome with retinal abnormalities</oboInOwl:hasExactSynonym>
        <rdfs:label>Orofaciodigital syndrome type 9</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD25.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0009795</skos:exactMatch>
        <skos:exactMatch>MeSH:C557818</skos:exactMatch>
        <skos:exactMatch>OMIM:258865</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796102</skos:exactMatch>
    </owl:Class>

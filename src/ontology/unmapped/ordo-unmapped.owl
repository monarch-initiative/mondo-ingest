    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_96107 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96107">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262995"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Distal trisomy 20q is a rare chromosomal anomaly syndrome, resulting from the partial trisomy of the long arm of chromosome 20, with high phenotypic variability mostly characterized by neurodevelopmental delay, cardiac malformations (e.g. ventricular septal defect, coarctation of aorta) and facial dysmorphism (incl. large/high forehead, microphthalmia, upslanting palpebral fissures, epicanthus, large, long, low-set ears, anteverted nares, protruding upper lip, cleft lip/palate, micro/retrognathia, dimpled chin). Skeletal (brachydactyly, scoliosis, pectus excavatum) and cerebral anomalies have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal duplication 20q syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal trisomy 20q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Telomeric duplication 20q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 20qter</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal duplication 20q syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD41.K0</skos:broadMatch>
        <skos:exactMatch>MONDO:0019888</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706935</skos:exactMatch>
    </owl:Class>

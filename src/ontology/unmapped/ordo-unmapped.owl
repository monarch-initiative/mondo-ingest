    <!-- http://www.orpha.net/ORDO/Orphanet_2140 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2140">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101944"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108977"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180776"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis which can be a non-syndromic (70%) or syndromic (30%) diaphragmatic malformation characterized by a posterolateral defect of the diaphragm that allows passage of abdominal viscera into the thorax, leading to respiratory insufficiency and persistent pulmonary hypertension.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital diaphragmatic hernia</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital diaphragmatic hernia</rdfs:label>
        <skos:exactMatch>ICD-10:Q79.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:LB00.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0005711</skos:exactMatch>
        <skos:exactMatch>MeSH:D065630</skos:exactMatch>
        <skos:exactMatch>MedDRA:10010439</skos:exactMatch>
        <skos:exactMatch>OMIM:142340</skos:exactMatch>
        <skos:exactMatch>UMLS:C0235833</skos:exactMatch>
        <skos:narrowMatch>OMIM:222400</skos:narrowMatch>
        <skos:narrowMatch>OMIM:306950</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610187</skos:narrowMatch>
    </owl:Class>

        <owl:annotatedTarget>Dietary iron overload disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_139512 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139512">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140453"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_99852 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99852">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68356"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/54925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Ravine syndrome is an extremely rare genetic neurological disorder, reported in a small number of patients in a specific community on Reunion Island (Ravine region), characterized by infantile anorexia with irrepressible and repeated vomiting, acute brainstem dysfunction, severe failure to thrive, and progressive encephalopathy with MRI showing vanishing of medulla oblongata and cerebellar white matter and severe atrophy of pons, along with supra-tentorial periventricular white-matter hyperintensities and basal ganglia anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive encephalopathy with severe infantile anorexia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ravine syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Reunion island-anorexia-vomiting which is irrepressible-neurological signs syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ravine syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E75.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A44.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0020505</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275006</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_99852"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ravine syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



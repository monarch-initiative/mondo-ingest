    <!-- http://www.orpha.net/ORDO/Orphanet_1270 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1270">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

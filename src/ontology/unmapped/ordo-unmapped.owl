            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of iron metabolism and transport characterized by elevated serum ferritin levels, increased serum iron, increased transferrin saturation, and heavy iron deposition in hepatocytes. Iron deposition has also been indicated in heart and bone marrow, while hematological examination of peripheral blood shows no abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FTH1-associated iron overload</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>FTH1-related iron overload</oboInOwl:hasExactSynonym>

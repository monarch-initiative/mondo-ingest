    <!-- http://www.orpha.net/ORDO/Orphanet_457260 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_457260">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

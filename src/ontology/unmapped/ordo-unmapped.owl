            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare type of Stickler syndrome characterized by moderate to severe sensorineural hearing loss, high myopia, retinal degeneration, vitreous anomalies, and epiphyseal dysplasia. Midface hypoplasia, cleft palate, as well as additional skeletal manifestations (such as platyspondyly, scoliosis, and tibial and femoral bowing at birth) have also been observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive Stickler syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive Stickler syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>UMLS:C5439212</skos:exactMatch>
        <skos:narrowMatch>OMIM:614134</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614284</skos:narrowMatch>
        <skos:narrowMatch>OMIM:620022</skos:narrowMatch>
    </owl:Class>

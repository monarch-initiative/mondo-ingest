    <!-- http://www.orpha.net/ORDO/Orphanet_199310 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_199310">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263749"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_325546"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_325638"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, sex chromosome disorder of sex development characterized by the two different haploid sets of maternal and paternal chromosomes and variable phenotype - from normal male or female genitalia, to different degrees of ambiguous genitalia, and often infertility. Also, in the cases of monochorionic dizygotic twins, it can be confined to blood of both twins.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">46,XX/46,XY chimerism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tetragametic chimerism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Tetragametic chimerism syndrome</rdfs:label>
        <skos:exactMatch>ICD-10:Q99.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:LD56</skos:exactMatch>
        <skos:exactMatch>MONDO:0016045</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432480</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_199310"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Tetragametic chimerism syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_199315 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_199315">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_109009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_364568"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404571"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404577"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Familial clubfoot with or without associated lower limb anomalies is a rare congenital limb malformation syndrome characterized by malalignment of the bones and joints of the foot and ankle, with presence of forefoot and midfoot adductus, hindfoot varus, and ankle equinus, presenting as rigid inward turning of the foot towards the midline, in various members of a single family. Hypoplasia of lower leg muscles is a frequently associated finding. Patients may present with other low-limb malformations, such as patellar hypoplasia, oblique talus, tibial hemimelia, and polydactyly.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial clubfoot with or without associated lower limb anomalies</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial clubfoot with or without associated lower limb anomalies</rdfs:label>
        <skos:broadMatch>ICD-10:Q66.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB98.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016046</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680522</skos:exactMatch>
        <skos:narrowMatch>OMIM:119800</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613618</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_199315"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial clubfoot with or without associated lower limb anomalies</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_199318 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_199318">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166469"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262119"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98033"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly characterized by a high risk for the occurrence of a wide range of neurodevelopmental anomalies including global developmental delay (DD), intellectual disability (ID), and behavioral issues of varying severity. 15q13.3 microdeletion does not lead to a clinically specific phenotype.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>15q13.3 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(15)(q13.3)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 15q13.3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(15)(q13.3)</oboInOwl:hasExactSynonym>
        <rdfs:label>15q13.3 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.F</skos:broadMatch>
        <skos:exactMatch>MONDO:0012774</skos:exactMatch>
        <skos:exactMatch>MeSH:C567439</skos:exactMatch>
        <skos:exactMatch>MedDRA:10090652</skos:exactMatch>
        <skos:exactMatch>OMIM:612001</skos:exactMatch>
        <skos:exactMatch>UMLS:C2677613</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_80 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_80">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163637"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_248365"/>

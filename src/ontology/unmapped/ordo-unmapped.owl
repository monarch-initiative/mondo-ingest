        <obo:IAO_0000115 xml:lang="en">A rare syndromic, inherited form of sideroblastic anemia characterized by mild to moderate anemia (with hypochromia and microcytosis) and early-onset, non- or slowly progressive spinocerebellar ataxia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Pagon-Bird-Detter syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked sideroblastic anemia and spinocerebellar ataxia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked sideroblastic anemia with ataxia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XLSA-A</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked sideroblastic anemia and spinocerebellar ataxia</rdfs:label>
        <skos:broadMatch>ICD-10:D64.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A72.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0010524</skos:exactMatch>
        <skos:exactMatch>MeSH:C536358</skos:exactMatch>

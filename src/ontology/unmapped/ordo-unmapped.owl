        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_817"/>
        <obo:IAO_0000115 xml:lang="en">A form of peeling skin syndrome characterized by a generalized distribution. It comprises two sub-types: the non-inflammatory (PSS type A) and the inflammatory (PSS type B) form. PSS type A is characterized by generalized white scaling with superficial non-inflammatory peeling of the skin, while PSS type B is characterized by superficial patchy peeling of the entire skin with underlying erythroderma, pruritus, and atopy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Generalized PSS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Generalized deciduous skin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized peeling skin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Generalized peeling skin syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q80.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0010033</skos:exactMatch>
        <skos:exactMatch>OMIM:270300</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305156</skos:exactMatch>
        <skos:narrowMatch>OMIM:616265</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

        <owl:annotatedTarget>acute myeloid leukemia with t(9;11)(p22;q23)</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED"/>

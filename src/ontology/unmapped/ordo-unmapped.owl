            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Type II granular corneal dystrophy (GCDII) is a rare form of stromal corneal dystrophy characterized by irregular-shaped well-demarcated granular deposits in the superficial central corneal stroma, and progressive visual impairment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Avellino corneal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GCD2</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare skeletal dysplasia, characterized clinically by short stature of variable degrees with short limbs, brachydactyly and narrow thorax.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Acrocapitofemoral dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Acrocapitofemoral dysplasia</rdfs:label>

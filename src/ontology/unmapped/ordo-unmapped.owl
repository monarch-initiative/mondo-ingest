            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A type of primary congenital hypothyroidism, a permanent thyroid hormone deficiency that is present from birth due to thyroid resistance to TSH.</obo:IAO_0000115>

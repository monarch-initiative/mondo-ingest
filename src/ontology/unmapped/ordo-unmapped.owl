        <obo:IAO_0000115 xml:lang="en">Mixed connective tissue disease (MCTD) is a rare connective tissue disorder combining clinical features of systemic lupus erythematosus (SLE), systemic sclerosis (SSc), polymyositis (PM) and/or rheumatoid arthritis (RA).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MCTD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mixed connective tissue disease</oboInOwl:hasExactSynonym>

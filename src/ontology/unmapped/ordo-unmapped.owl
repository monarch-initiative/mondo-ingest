            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare galactosemia characterized by early onset of cataract and an absence of the usual signs of classic galactosemia, although neonatal elevation of transaminases, bleeding diathesis and encephalopathy might be present in addition to cataract.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GALK deficiency</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_99147 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99147">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166775"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bleeding disorder characterized by defects in von Willebrand factor, similar to those seen in hereditary von Willebrand disease (VWD), but which are caused by an underlying pathology, generally in elderly patients without any personal or family history of bleeding anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired von Willebrand disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acquired von Willebrand syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Acquired von Willebrand syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D68.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0020460</skos:exactMatch>
        <skos:exactMatch>MedDRA:10069495</skos:exactMatch>
        <skos:exactMatch>UMLS:C0272362</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

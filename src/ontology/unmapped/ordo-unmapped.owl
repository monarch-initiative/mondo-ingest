            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/28296"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29250"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29262"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2962"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare ciliopathy with major skeletal involvement characterized by short ribs and extremely narrow thorax, severely shortened tubular bones with round metaphyseal ends and lateral spikes, and anomalies of multiple organs such as the heart, kidneys, liver, pancreas, intestine, and genitalia, with occasional occurrence of situs inversus totalis. Cleft lip/palate and polydactyly may also be present. The syndrome is fatal prenatally or in the perinatal period.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Short rib-polydactyly syndrome type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short rib-polydactyly syndrome, Verma-Naumoff type</oboInOwl:hasExactSynonym>
        <rdfs:label>Short rib-polydactyly syndrome, Verma-Naumoff type</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.B0</skos:broadMatch>
        <skos:exactMatch>MeSH:C537602</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432197</skos:exactMatch>
        <skos:narrowMatch>OMIM:613091</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614091</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615503</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615633</skos:narrowMatch>
    </owl:Class>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6716"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare bone dysplasia characterized by short stature, short hands and feet, mild facial dysmorphism, and characteristic X-ray abnormalities of the hands.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Acromicric dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Acromicric dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.8Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007055</skos:exactMatch>
        <skos:exactMatch>MeSH:C535662</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083854</skos:exactMatch>
        <skos:exactMatch>OMIM:102370</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265287</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_969"/>

        <oboInOwl:hasExactSynonym xml:lang="en">Multiple epiphyseal dysplasia-myopia-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple epiphyseal dysplasia, Beighton type</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

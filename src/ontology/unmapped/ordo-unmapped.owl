    <!-- http://www.orpha.net/ORDO/Orphanet_1675 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1675">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79193"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of pyrimidine metabolism characterized by a variable phenotype ranging from absence of symptoms to severe neurological involvement with developmental delay, intellectual disability, and seizures. Additional signs and symptoms may include hypotonia, microcephaly, ocular abnormalities (such as microphthalmia, nystagmus, and strabismus), and autistic behavior, among others. Analysis of urine typically shows high levels of uracil and thymine. Patients are at risk of suffering from severe toxicity after the administration of the anti-neoplastic agent 5-fluorouracil.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dihydropyrimidine dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial pyrimidinemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Dihydropyrimidine dehydrogenase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E79.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C55.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0010130</skos:exactMatch>
        <skos:exactMatch>MeSH:D054067</skos:exactMatch>
        <skos:exactMatch>MedDRA:10052622</skos:exactMatch>
        <skos:exactMatch>OMIM:274270</skos:exactMatch>
        <skos:exactMatch>UMLS:C1959620</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1675"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Dihydropyrimidine dehydrogenase deficiency</owl:annotatedTarget>

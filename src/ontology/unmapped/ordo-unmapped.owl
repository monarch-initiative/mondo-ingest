    <!-- http://www.orpha.net/ORDO/Orphanet_2849 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2849">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183422"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_319328"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysostosis with brachydactyly characterized by short digits predominantly on the preaxial (radial) side resulting in stub thumbs, short index fingers and a cutaneous web between the first and second fingers. No extraskeletal manifestations are present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Preaxial brachydactyly, PAX3 type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Preaxial digit brachydactyly-webbed fingers</oboInOwl:hasExactSynonym>
        <rdfs:label>Preaxial digit brachydactyly-webbed fingers</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0859005</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816807</skos:exactMatch>
    </owl:Class>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive disorder of lysine metabolism characterized by elevated levels of lysine in the cerebrospinal fluid and blood. Hyperlysinemia type I has been associated with a highly variable phenotype including seizures, hypotonia, and mild psychomotor delay, although isolated hyperlysinemia is probably a benign condition.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hyperlysinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperlysinemia type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lysine alpha-ketoglutarate reductase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperlysinemia</rdfs:label>
        <skos:broadMatch>ICD-10:E72.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0009388</skos:exactMatch>
        <skos:exactMatch>MeSH:D020167</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081311</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_147 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_147">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

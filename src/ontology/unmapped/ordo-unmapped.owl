                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3267"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked syndromic intellectual disability characterized by mild to profound intellectual disability, microcephaly, growth delay, and hypogenitalism. Obesity, early-onset diabetes and epilepsy are more variably present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MEHMO syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked intellectual disability-epileptic seizures-hypogenitalism-microcephaly-obesity syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>MEHMO syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD29</skos:broadMatch>
        <skos:exactMatch>MONDO:0010258</skos:exactMatch>
        <skos:exactMatch>MeSH:C537451</skos:exactMatch>
        <skos:exactMatch>OMIM:300148</skos:exactMatch>
        <skos:exactMatch>UMLS:C1846278</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_85282"/>

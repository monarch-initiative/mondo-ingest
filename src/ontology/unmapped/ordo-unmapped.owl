    <!-- http://www.orpha.net/ORDO/Orphanet_521123 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_521123">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182086"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_521132"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare radiation-induced disorder characterized by impairment of the peripheral nervous system at the level of the brachial or lumbosacral plexus following radiation therapy. Onset of symptoms can occur between several months up to decades after the last dose of radiation. Patients with radiation-induced brachial plexopathy typically present with mostly unilateral progressive paresthesia, followed by weakness, atrophy, and pain. Symptoms in radiation-induced lumbosacral plexopathy include more variable combinations of numbness, paresthesia, pain, and weakness, and are more often bilateral.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Radiation-induced plexopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Radiation-induced plexopathy</rdfs:label>
        <skos:broadMatch>ICD-10:G54.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B91.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0033838</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681446</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_521123"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Radiation-induced plexopathy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_521127 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_521127">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399158"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_521132"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare radiation-induced disorder characterized by exposed irradiated bone that fails to heal over a period of three months without evidence of persisting or recurrent tumor. Patients present with pain, dysesthesia, dysgeusia, fetor oris, trismus, ulceration or necrosis of the mucosa with exposure of necrotic bone, and local suppuration. Complications include pathological fractures, formation of intra- or extra-oral fistulae, and infection. MRI shows cortical destruction, abnormal bone marrow signal, and irregular contrast enhancement.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MORN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteoradionecrosis of the mandible</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteoradionecrosis of the mandible</rdfs:label>
        <skos:broadMatch>ICD-10:K10.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA06.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0033839</skos:exactMatch>
        <skos:exactMatch>UMLS:C1290728</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_521127"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Osteoradionecrosis of the mandible</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



    <!-- http://www.orpha.net/ORDO/Orphanet_263479 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_263479">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306648"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, congenital carbohydrate intolerance disorder characterized by lack of endogenous sucrase activity, marked reduction in isomaltase activity, and moderate decrease in maltase activity, and clinically manifesting with diarrhea, abdominal pain and bloating, failure to thrive.</obo:IAO_0000115>

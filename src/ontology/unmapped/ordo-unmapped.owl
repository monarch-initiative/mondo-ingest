    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_401923 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_401923">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

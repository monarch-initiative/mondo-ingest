    <!-- http://www.orpha.net/ORDO/Orphanet_404493 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_404493">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404481"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

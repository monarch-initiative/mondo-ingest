    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2591 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2591">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183487"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206982"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271832"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_71209"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7883"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8804"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare benign soft tissue tumor characterized by the development of nodules in the skin, striated muscles, bones, and in exceptional cases, visceral organs, leading to a broad spectrum of clinical symptoms. It contains myofibroblasts.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Infantile myofibromatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile myofibromatosis</rdfs:label>
        <skos:broadMatch>ICD-10:D48.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F7C</skos:broadMatch>
        <skos:exactMatch>MONDO:0016824</skos:exactMatch>
        <skos:exactMatch>MeSH:C562978</skos:exactMatch>
        <skos:exactMatch>OMIM:228550</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432284</skos:exactMatch>
        <skos:narrowMatch>OMIM:615293</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2591"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_168966 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168966">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_223735"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare lymphoma characterized by the concurrent occurrence of two or more histologic types of lymphoma involving the same anatomic site. Composite lymphomas can be combinations of two non-Hodgkin lymphomas or of a non-Hodgkin and a Hodgkin lymphoma. In many cases, the tumors are clonally related. Clinical presentation and treatment are determined by the more aggressive component.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Composite Hodgkin and non-Hodgkin lymphoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Composite lymphoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Composite lymphoma</rdfs:label>
        <skos:broadMatch>ICD-10:C81.7</skos:broadMatch>
        <skos:broadMatch>ICD-10:C85.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:XH3BP6</skos:broadMatch>
        <skos:exactMatch>MONDO:0005710</skos:exactMatch>
        <skos:exactMatch>MeSH:D058617</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073957</skos:exactMatch>
        <skos:exactMatch>UMLS:C0545080</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

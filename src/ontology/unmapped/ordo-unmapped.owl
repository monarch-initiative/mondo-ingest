    <!-- http://www.orpha.net/ORDO/Orphanet_65743 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_65743">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294060"/>

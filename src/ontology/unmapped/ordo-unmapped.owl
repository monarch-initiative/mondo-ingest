    <!-- http://www.orpha.net/ORDO/Orphanet_79118 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79118">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93587"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/28510"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by intrauterine growth retardation, permanent neonatal diabetes mellitus, and congenital hypothyroidism. Additional manifestations include congenital glaucoma, hepatic disease (hepatitis, fibrosis, and cirrhosis), polycystic kidneys, exocrine pancreatic dysfunction, sensorineural hearing impairment, developmental delay, and mild facial dysmorphism (such as flat nasal bridge, epicanthal folds, long philtrum, and low-set ears), among others.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neonatal diabetes-congenital hypothyroidism-congenital glaucoma-hepatic fibrosis-polycystic kidneys syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Neonatal diabetes-congenital hypothyroidism-congenital glaucoma-hepatic fibrosis-polycystic kidneys syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:P70.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB8Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012436</skos:exactMatch>
        <skos:exactMatch>OMIM:610199</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510367</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_79118"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neonatal diabetes-congenital hypothyroidism-congenital glaucoma-hepatic fibrosis-polycystic kidneys syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_79124 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79124">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101938"/>

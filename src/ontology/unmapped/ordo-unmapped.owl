    <!-- http://www.orpha.net/ORDO/Orphanet_171680 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171680">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_48471"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Lissencephaly (LIS) due to TUBA1A mutation is a congenital cortical development anomaly due to abnormal neuronal migration involving neocortical and hippocampal lamination, corpus callosum, cerebellum and brainstem. A large clinical spectrum can be observed, from children with severe epilepsy and intellectual and motor deficit to cases with severe cerebral dysgenesis in the antenatal period leading to pregnancy termination due to the severity of the prognosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lissencephaly due to TUBA1A mutation</oboInOwl:hasExactSynonym>
        <rdfs:label>Lissencephaly due to TUBA1A mutation</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>

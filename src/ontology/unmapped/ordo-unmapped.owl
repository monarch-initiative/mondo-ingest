    <!-- http://www.orpha.net/ORDO/Orphanet_289176 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_289176">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_437"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2932"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3356"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, autosomal recessive renal phosphate-wasting disorder characterized by childhood-onset hypophosphatemia that clinically manifests with rickets and/or osteomalacia, slow growth/short stature, bone pain and skeletal deformities. Additional findings may include fatigue, muscle weakness and repeated bone fractures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ARHR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autosomal recessive hypophosphatemic rickets</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive hypophosphatemic rickets</rdfs:label>
        <skos:broadMatch>ICD-10:E83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C63.22</skos:broadMatch>
        <skos:exactMatch>MONDO:0017324</skos:exactMatch>
        <skos:exactMatch>MedDRA:10077943</skos:exactMatch>
        <skos:exactMatch>UMLS:C0342643</skos:exactMatch>
        <skos:narrowMatch>OMIM:241520</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613312</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_289176"/>

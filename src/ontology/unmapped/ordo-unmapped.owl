    <!-- http://www.orpha.net/ORDO/Orphanet_2962 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2962">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207018"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_289866"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79389"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98628"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98644"/>
        <obo:IAO_0000115 xml:lang="en">De Barsy syndrome (DBS) is characterized by facial dysmorphism (down-slanting palpebral fissures, a broad flat nasal bridge and a small mouth) with a progeroid appearance, large and late-closing fontanel, cutis laxa (CL), joint hyperlaxity, athetoid movements and hyperreflexia, pre- and postnatal growth retardation, intellectual deficit and developmental delay, and corneal clouding and cataract.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutis laxa-corneal clouding-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>De Barsy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progeroid syndrome, De Barsy type</oboInOwl:hasExactSynonym>
        <rdfs:label>De Barsy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD28.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0017569</skos:exactMatch>
        <skos:exactMatch>MeSH:C535990</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083947</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268354</skos:exactMatch>
        <skos:narrowMatch>OMIM:219150</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614438</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2962"/>

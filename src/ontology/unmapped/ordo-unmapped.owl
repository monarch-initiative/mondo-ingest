            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare insulin-resistance syndrome characterized by marked hyperinsulinemia, frequently associated with glucose tolerance abnormalities or diabetes, acanthosis nigricans, and hyperandrogenism in females.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Insulin-resistance syndrome type A</oboInOwl:hasExactSynonym>

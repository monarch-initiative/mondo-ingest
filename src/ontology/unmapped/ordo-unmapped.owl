        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98578"/>
        <obo:IAO_0000115 xml:lang="en">A rare group of syndromic intellectual disabilities characterized by global developmental delay (DD)/intellectual disability (ID), blepharophimosis and other craniofacial dysmorphisms, and organ anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Blepharophimosis-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Blepharophimosis-intellectual disability syndrome</rdfs:label>
        <skos:exactMatch>MONDO:0017393</skos:exactMatch>
        <skos:exactMatch>MONDO:17393</skos:exactMatch>
        <skos:exactMatch>UMLS:C5229849</skos:exactMatch>
    </owl:Class>

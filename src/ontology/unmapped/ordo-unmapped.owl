            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Infantile-onset mesial temporal lobe epilepsy with severe cognitive regression is a rare monogenic disease with infantile-onset pharmacoresistant focal seizures of mesial temporal lobe onset manifesting with unresponsiveness, hypertonia and automatisms and cognitive regression soon after seizure onset leading to severe intellectual disability with behavioral abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Infantile-onset mesial temporal lobe epilepsy with severe cognitive regression</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>TNK2-related epilepsy with severe cognitive regression</oboInOwl:hasExactSynonym>
        <rdfs:label>TNK2-related epilepsy with severe cognitive regression</rdfs:label>
        <skos:broadMatch>ICD-10:G40.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0018314</skos:exactMatch>
        <skos:exactMatch>UMLS:C4750853</skos:exactMatch>
    </owl:Class>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5391"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hurler syndrome is the most severe form of mucopolysaccharidosis type 1 (MPS1), a rare lysosomal storage disease, characterized by skeletal abnormalities, cognitive impairment, heart disease, respiratory problems, enlarged liver and spleen, characteristic facies and reduced life expectancy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hurler disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hurler syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MPS1H</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MPSIH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucopolysaccharidosis type 1H</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucopolysaccharidosis type IH</oboInOwl:hasExactSynonym>
        <rdfs:label>Hurler syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E76.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.30</skos:broadMatch>
        <skos:exactMatch>MONDO:0011758</skos:exactMatch>
        <skos:exactMatch>OMIM:607014</skos:exactMatch>
        <skos:exactMatch>UMLS:C0086795</skos:exactMatch>
    </owl:Class>

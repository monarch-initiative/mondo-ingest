        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98366"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12811"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">McLeod neuroacanthocytosis syndrome (MLS) is a form of neuroacanthocytosis and is characterized clinically by a Huntington&apos;s disease-like phenotype with an involuntary hyperkinetic movement disorder, psychiatric manifestations and cognitive alterations, and biochemically by absence of the Kx antigen and by weak expression of the Kell antigens.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MLS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>McLeod neuroacanthocytosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked McLeod syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>McLeod neuroacanthocytosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G10</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:300842</skos:broadMatch>
        <skos:exactMatch>MONDO:0018945</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081507</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510408</skos:exactMatch>
    </owl:Class>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30578"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, inherited, epidermolysis bullosa simplex characterized by mild, generalized trauma-induced scale crusts and intermittent blistering, sometimes combined with erosions, recovering with slight scarring and post-inflammatory hyperpigmentation. Clinical symptoms improve with age.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EBS due to exophilin 5 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Epidermolysis bullosa simplex due to exophilin 5 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Epidermolysis bullosa simplex due to exophilin 5 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC30</skos:broadMatch>
        <skos:exactMatch>MONDO:0014014</skos:exactMatch>

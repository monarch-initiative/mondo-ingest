            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A mitochondrial disorder of long chain fatty acid oxidation characterized in most patients by onset in infancy/ early childhood of hypoketotic hypoglycemia, metabolic acidosis, liver disease, hypotonia and, frequently, cardiac involvement with arrhythmias and/or cardiomyopathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LCHAD deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LCHADD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Long chain 3-hydroxyacyl-CoA dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Long-chain 3-hydroxyacyl-coenzyme A dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Long chain 3-hydroxyacyl-CoA dehydrogenase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E71.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C52.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0012173</skos:exactMatch>

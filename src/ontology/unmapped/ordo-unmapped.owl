        <obo:IAO_0000115 xml:lang="en">Microcephaly - cardiac defect - lung malsegmentation syndrome is a very rare syndrome characterized by the combination of microcephaly, heart defects, renal hypoplasia, lung segmentation defects and cleft palate.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ellis-Yale-Winter syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Microcephaly-cardiac defect-lung malsegmentation syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Microcephaly-cardiac defect-lung malsegmentation syndrome</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_472 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_472">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163588"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Isosporiasis (also known as cystoisosporiasis) is an exclusively human parasitosis occurring mainly in the tropics and subtropics, due to infection with &lt;i&gt;Isospora belli&lt;/i&gt; (through ingestion of contaminated food), that is frequently asymptomatic or that can cause fever and diarrhea, but that is usually a self-limiting condition in the immunocompetent. HIV-positive individuals are particularly at risk of suffering from symptomatic isosporiasis and can manifest with a more severe clinical course of chronic diarrhea and severe weight loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cystoisosporiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isosporiasis</oboInOwl:hasExactSynonym>
        <rdfs:label>Isosporiasis</rdfs:label>
        <skos:exactMatch>ICD-10:A07.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:1A33</skos:exactMatch>
        <skos:exactMatch>MONDO:0018769</skos:exactMatch>
        <skos:exactMatch>MeSH:D021865</skos:exactMatch>
        <skos:exactMatch>MedDRA:10023076</skos:exactMatch>
        <skos:exactMatch>UMLS:C0311386</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_472"/>

        <rdfs:label>Upper limb hypertrophy</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB97.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0017476</skos:exactMatch>
        <skos:exactMatch>UMLS:C0575518</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_295049"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Upper limb hypertrophy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_158775 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_158775">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2467"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6342"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, slowly progressive form of systemic mastocytosis (SM) characterized by gradual accumulation of neoplastic mast cells in the visceral organs. Patients typically present with splenomegaly, hypercellular marrow and, in most cases, urticaria pigmentosa-like skin lesions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Smoldering systemic mastocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Smoldering systemic mastocytosis</rdfs:label>
        <skos:broadMatch>ICD-10:D47.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A21.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015557</skos:exactMatch>
        <skos:exactMatch>MedDRA:10089905</skos:exactMatch>
        <skos:exactMatch>UMLS:C3897042</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_158775"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Smoldering systemic mastocytosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_158778 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_158778">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2467"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_620178 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_620178">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_620152"/>
        <obo:IAO_0000115 xml:lang="en">A form of non-syndromic multisutural craniosynostosis characterized by bilateral premature fusion of the lambdoid sutures, resulting in flattening and widening of the entire occipital region, with compensatory bossing of the vertex region (giving the cranium an elongated shape), and anterior-posterior displacement of the ears.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated bilambdoid craniosynostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated pachycephaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Non-syndromic bilambdoid craniosynostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-syndromic bilateral lambdoid synostosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-syndromic bilambdoid craniosynostosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q75.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB70.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0850079</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680395</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_620178"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

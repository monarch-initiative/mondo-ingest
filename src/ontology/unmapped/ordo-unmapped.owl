    <!-- http://www.orpha.net/ORDO/Orphanet_251274 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251274">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_235936"/>

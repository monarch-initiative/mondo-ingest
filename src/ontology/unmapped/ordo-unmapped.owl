        <obo:IAO_0000115 xml:lang="en">A rare, autosomal recessive congenital cerebellar ataxia characterized by congenital malformation of the brainstem and agenesis or hypoplasia of the cerebellar vermis leading to an abnormal respiratory pattern, nystagmus, hypotonia, ataxia, and delay in achieving motor milestones.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CPD IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cerebelloparenchymal disorder IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic Joubert syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated Joubert syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Joubert syndrome type A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Joubert-Boltshauser syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pure Joubert syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated Joubert syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD20.00</skos:exactMatch>

        <oboInOwl:hasExactSynonym xml:lang="en">Global developmental delay-hypotonia-high pain tolerance syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MASNS</oboInOwl:hasExactSynonym>

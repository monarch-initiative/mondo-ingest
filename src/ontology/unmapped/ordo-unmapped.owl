    <!-- http://www.orpha.net/ORDO/Orphanet_535 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_535">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_315350"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">Rare cutaneous lupus erythematosus (CLE) is an autoimmune disease that denotes a heterogeneous spectrum of clinical manifestations affecting the skin and can be divided into 4 categories: acute CLE (ACLE); subacute CLE (SCLE); chronic CLE (CCLE; the most diverse form); and intermittent CLE (ICLE). CLE can either occur alone or associated with systemic lupus erythematosus (SLE).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Rare cutaneous lupus erythematosus</oboInOwl:hasExactSynonym>
        <rdfs:label>Rare cutaneous lupus erythematosus</rdfs:label>
        <skos:exactMatch>MONDO:18887</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056509</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680424</skos:exactMatch>
    </owl:Class>

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_476403">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_593"/>
        <oboInOwl:hasExactSynonym>Hypercontractile muscle stiffness syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypercontractile muscle stiffness syndrome</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_43116 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_43116">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_466658"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by an excess of serotonin in the central nervous system, associated with the use of various agents, including selective serotonin reuptake inhibitors (SSRIs) and recreational stimulants.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Serotonergic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Serotonin storm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Serotonin syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Serotonin toxicity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Serotonin toxidrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Serotonin syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:T43.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:8D85</skos:broadMatch>
        <skos:exactMatch>MONDO:0018546</skos:exactMatch>

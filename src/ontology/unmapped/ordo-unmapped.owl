    <!-- http://www.orpha.net/ORDO/Orphanet_220 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_220">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183422"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_325638"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_567562"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98087"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12796"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic, syndromic glomerular disorder characterized by the association of nephropathy presenting as persistent proteinuria or overt nephrotic syndrome, Wilms tumor and genitourinary structural defects. In addition, disorders of testicular development are common in subjects with 46,XY karyotype.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Denys-Drash syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Drash syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wilms tumor-DSD syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wilms tumor-disorder of sex development syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Denys-Drash syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:N04.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2A.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008682</skos:exactMatch>
        <skos:exactMatch>MeSH:D030321</skos:exactMatch>
        <skos:exactMatch>MedDRA:10070179</skos:exactMatch>
        <skos:exactMatch>OMIM:194080</skos:exactMatch>
        <skos:exactMatch>UMLS:C0950121</skos:exactMatch>
    </owl:Class>

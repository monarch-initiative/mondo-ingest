    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_209916 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_209916">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_3394"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare soft tissue sarcoma characterized by a lesion in the deep soft tissues of the proximal extremities and limb girdles, composed of malignant chondroblast-like cells arranged in cords, clusters, or networks, and an abundant myxoid matrix. The tumor is typically encased by a pseudocapsule and divided into multiple nodules by fibrous septa. Patients present with a soft tissue mass which can be painful and may ulcerate the skin or restrict range of motion if located next to joints. Despite prolonged survival, local recurrence and metastasis are frequent.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Extraskeletal myxoid chondrosarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Extraskeletal myxoid chondrosarcoma</rdfs:label>
        <skos:broadMatch>ICD-10:C49.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:2B50.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012825</skos:exactMatch>
        <skos:exactMatch>MeSH:C563195</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073134</skos:exactMatch>
        <skos:exactMatch>OMIM:612237</skos:exactMatch>
        <skos:exactMatch>UMLS:C1275278</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_209916"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Extraskeletal myxoid chondrosarcoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_209919 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_209919">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101939"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Idiopathic copper-associated cirrhosis is a rare copper-overload liver disease characterized by a rapidly progressive liver cirrhosis from the first few years of life leading to hepatic insufficiency and harboring a specific pathological aspect: pericellular fibrosis, inflammatory infiltration, hepatocyte necrosis, absence of steatosis, poor regeneration and histochemical copper staining.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Idiopathic copper-associated cirrhosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-Wilsonian hepatic copper toxicosis of infancy and childhood</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic copper-associated cirrhosis</rdfs:label>
        <skos:broadMatch>ICD-10:K74.6</skos:broadMatch>
        <skos:broadMatch>OMIM:215600</skos:broadMatch>
        <skos:exactMatch>ICD-11:DB93.21</skos:exactMatch>
        <skos:exactMatch>MONDO:0016204</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274853</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_209919"/>

        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8850"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8859"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by sensorineural hearing loss, abnormalities in the secondary dentition (such as enamel hypoplasia, taurodontism, or dental overcrowding), and nail abnormalities (including leukonychia and presence of transverse ridges). Association with macular dystrophy has also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Deafness-enamel hypoplasia-nail defects syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hearing loss-enamel hypoplasia-nail defects syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Heimler syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Deafness-enamel hypoplasia-nail defects syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0100229</skos:exactMatch>
        <skos:exactMatch>MeSH:C535994</skos:exactMatch>
        <skos:exactMatch>OMIM:234580</skos:exactMatch>
        <skos:exactMatch>UMLS:C1856186</skos:exactMatch>
        <skos:narrowMatch>OMIM:616617</skos:narrowMatch>
    </owl:Class>

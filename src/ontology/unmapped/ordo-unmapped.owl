                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10985"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic disorder of urea cycle metabolism characterized by either a neonatal-onset with manifestations of lethargy, poor feeding, vomiting and tachypnea or, more commonly, presentations in infancy, childhood or adulthood with chronic neurocognitive deficits, acute encephalopathy and/or coagulation defects or other chronic liver dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HHH syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hyperornithinemia-hyperammonemia-homocitrullinuria syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ORNT1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ornithine carrier deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ornithine translocase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Triple H syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperornithinemia-hyperammonemia-homocitrullinuria syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E72.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.AY</skos:broadMatch>
        <skos:exactMatch>MONDO:0009393</skos:exactMatch>
        <skos:exactMatch>MeSH:C538380</skos:exactMatch>

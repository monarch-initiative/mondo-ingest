    <!-- http://www.orpha.net/ORDO/Orphanet_397968 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_397968">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_91024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15974"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive axonal hereditary motor and sensory neuropathy characterized by early-onset axial hypotonia, generalized muscle weakness, absent deep tendon reflexes and decreased muscle mass. Electromyography reveals decreased motor nerve conduction velocities with markedly reduced sensory and motor amplitudes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CMT2R</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Charcot-Marie-Tooth disease type 2R</oboInOwl:hasExactSynonym>
        <rdfs:label>Charcot-Marie-Tooth disease type 2R</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0014208</skos:exactMatch>

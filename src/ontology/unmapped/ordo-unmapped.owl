    <!-- http://www.orpha.net/ORDO/Orphanet_319494 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319494">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100088"/>

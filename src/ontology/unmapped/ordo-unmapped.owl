            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Infantile-onset ascending hereditary spastic paralysis (IAHSP) is a very rare motor neuron disease characterized by severe spasticity of the lower limbs in early life, progression of spasticity to the upper limbs in late childhood, and dysarthria.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">IAHSP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Infantile-onset ascending hereditary spastic paralysis</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile-onset ascending hereditary spastic paralysis</rdfs:label>
        <skos:broadMatch>ICD-10:G12.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0011797</skos:exactMatch>
        <skos:exactMatch>MeSH:C537217</skos:exactMatch>
        <skos:exactMatch>OMIM:607225</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931441</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_293168"/>

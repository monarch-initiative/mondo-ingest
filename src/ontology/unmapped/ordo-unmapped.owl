    <!-- http://www.orpha.net/ORDO/Orphanet_47045 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_47045">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_208650"/>

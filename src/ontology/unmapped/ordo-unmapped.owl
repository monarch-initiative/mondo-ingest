        <skos:exactMatch>OMIM:309640</skos:exactMatch>
    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_163985 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_163985">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183521"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2076"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306773"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14561"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, X-linked, syndromic intellectual disability disease characterized by neonatal hypertonia which evolves to hypotonia and an exaggerated startle response (to sudden visual, auditory or tactile stimuli), followed by the development of early-onset, frequently refractory, tonic or myoclonic seizures. Progressive epileptic encephalopathy, intellectual disability, and psychomotor development arrest, with subsequent decline, may be additionally associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hyperekplexia-epilepsy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperekplexia-epilepsy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G25.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0010375</skos:exactMatch>
        <skos:exactMatch>OMIM:300607</skos:exactMatch>
        <skos:exactMatch>UMLS:C5191643</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_163985"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hyperekplexia-epilepsy syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



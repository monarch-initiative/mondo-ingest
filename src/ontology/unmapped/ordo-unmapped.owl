            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Epidermodysplasia verruciformis (EV) is a rare inherited genodermatosis characterized by chronic infection with human papillomavirus (HPV) leading to polymorphous cutaneous lesions and high risk of developing non melanoma skin cancer.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Inherited epidermodysplasia verruciformis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lewandowsky-Lutz syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lutz-Lewandowsky epidermodysplasia verruciformis</oboInOwl:hasExactSynonym>
        <rdfs:label>Inherited epidermodysplasia verruciformis</rdfs:label>
        <skos:broadMatch>ICD-10:B07</skos:broadMatch>
        <skos:broadMatch>ICD-11:1E83</skos:broadMatch>
        <skos:exactMatch>MONDO:0009176</skos:exactMatch>

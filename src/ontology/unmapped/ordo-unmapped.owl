    <!-- http://www.orpha.net/ORDO/Orphanet_97249 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97249">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_441434"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98523"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13406"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic form of pontocerebellar hypoplasia (PCH) characterized by neocortical and pontocerebellar hypoplasia with pons and cerebellum equally affected and that clinically manifests with neonatal hypotonia and impaired swallowing followed by seizures, optic atrophy and short stature from infancy onward. Movement disorders, as seen in other forms of PCH, are absent.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cerebellar atrophy with progressive microcephaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PCH3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pontocerebellar hypoplasia type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Pontocerebellar hypoplasia type 3</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD20.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0011948</skos:exactMatch>
        <skos:exactMatch>MeSH:C548072</skos:exactMatch>
        <skos:exactMatch>OMIM:608027</skos:exactMatch>
        <skos:exactMatch>UMLS:C1842687</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97249"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

        <oboInOwl:hasExactSynonym>Primary peritoneal carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary peritoneal serous carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Serous surface papillary carcinoma</oboInOwl:hasExactSynonym>

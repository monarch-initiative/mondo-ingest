    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2934 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2934">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, life-threatening developmental defect during embryogenesis characterized by polysyndactyly of fingers and toes as well as complex congenital heart defects (e.g. atrioventricular septal defects, aortic dextroposition, single ventricle, hypo- or hypertrophy of one side of the heart). Additional features may include dysmorphic traits (large fontanel, high forehead, ptosis, hypertelorism, epicanthus, low-set malformed ears, prominent root of the nose, bulbous nose, anteverted nares, long and smooth philtrum, thin upper lip, micrognathism, hirsutism, single transverse crease) nail hypoplasia, phalange agenesis/hypoplasia, flexion contractures, polysplenia, multiple hepatic/renal cysts, atrophic biliary vesicle, ductal plate malformation and genital anomalies (e.g. micropenis, undescended testes, hypoplastic scrotum). The syndrome is usually fatal in utero or in infancy, but survival cases have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bonneau syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polysyndactyly-cardiac malformation syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Polysyndactyly-cardiac malformation syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009900</skos:exactMatch>
        <skos:exactMatch>MeSH:C564875</skos:exactMatch>
        <skos:exactMatch>OMIM:263630</skos:exactMatch>
        <skos:exactMatch>UMLS:C1849719</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2934"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Polysyndactyly-cardiac malformation syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_293462 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_293462">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98626"/>
        <obo:IAO_0000115 xml:lang="en">Pre-Descemet corneal dystrophy (PDCD) is a rare form of stromal corneal dystrophy characterized by focal, fine, gray opacities in the deep stroma immediately anterior to the Descemet membrane, with no effect on vision.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PDCD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pre-Descemet corneal dystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Pre-Descemet corneal dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:H18.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:9A70.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017392</skos:exactMatch>
        <skos:exactMatch>UMLS:C0339282</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_293462"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pre-Descemet corneal dystrophy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2935 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2935">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, hereditary, congenital limb malformation characterized by polydactyly with crossed involvement of hands and feet with no other associated malformations or anomalies. Patients present with a combination of unilateral or bilateral preaxial polydactyly of hands with postaxial polydactyly of feet or postaxial polydactyly of hands with preaxial polydactyly of feet. Additional manifestations include bilateral cutaneous syndactyly of first, second and third toes and occasionally cutaneous syndactyly of hands.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Crossed polysyndactyly</oboInOwl:hasExactSynonym>
        <rdfs:label>Crossed polysyndactyly</rdfs:label>
        <skos:broadMatch>ICD-10:Q70.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0008286</skos:exactMatch>
        <skos:exactMatch>MeSH:C566773</skos:exactMatch>
        <skos:exactMatch>OMIM:175690</skos:exactMatch>
        <skos:exactMatch>UMLS:C1867999</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2935"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Crossed polysyndactyly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_293603 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_293603">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_589856">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156246"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare T-B+ severe combined immunodeficiency characterized by markedly decreased numbers of T-cells and normal or increased numbers of B-cells and natural killer (NK) cells. Hypogammaglobulinemia has also been reported. Patients generally present in infancy with recurrent infections, failure to thrive, rash, fever, hepatosplenomegaly, lymphadenopathy, and pancytopenia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">T-B+NK+ SCID due to CD45 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T-B+NK+ severe combined immunodeficiency due to CD45 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>T-B+NK+ severe combined immunodeficiency due to CD45 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D81.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0015702</skos:exactMatch>

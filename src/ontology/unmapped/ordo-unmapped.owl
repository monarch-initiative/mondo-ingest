            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, hereditary, non-syndromic form of vitreoretinopathy characterized by retinal tears due to abnormal vitreous, and commonly present refractive errors. No other signs or symptoms of Stickler syndrome is present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant rhegmatogenous retinal detachment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated ocular Stickler syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated ocular Stickler syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:H33.0</skos:broadMatch>

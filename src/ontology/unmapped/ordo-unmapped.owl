    <!-- http://www.orpha.net/ORDO/Orphanet_75389 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_75389">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156532"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by intrauterine growth retardation, multiple congenital malformations (such as brain malformations including ectopic neuropituitary gland, hypoplastic adenopituitary, and hypoplastic cerebellar vermis, cardiac and renal anomalies, and postaxial polydactyly), abnormal hair structure with temporal balding, and dysmorphic facial features with hypoplastic nasal bridge, anteverted nostrils, dysplastic ears, long and smooth philtrum, narrow upper lip, and prominent, asymmetric lower lip. Postnatal growth retardation and severe developmental delay have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Brain malformation-congenital heart disease-postaxial polydactyly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Goossens-Devriendt syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Brain malformation-congenital heart disease-postaxial polydactyly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019153</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303545</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_75389"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

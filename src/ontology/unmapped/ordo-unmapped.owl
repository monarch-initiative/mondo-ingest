    <!-- http://www.orpha.net/ORDO/Orphanet_64747 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_64747">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare genetic peripheral neuropathies characterized by slowly progressive sensory-motor involvement leading to muscle weakness, atrophy and sensory loss, mainly affecting the distal limbs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CMTX</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked Charcot-Marie-Tooth disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked hereditary motor and sensory neuropathy</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked Charcot-Marie-Tooth disease</rdfs:label>
        <skos:broadMatch>ICD-11:8C20.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0018994</skos:exactMatch>

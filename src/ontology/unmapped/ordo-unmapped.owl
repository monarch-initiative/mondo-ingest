    <!-- http://www.orpha.net/ORDO/Orphanet_2456 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2456">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180170"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Familial supernumerary nipples is a rare breast malformation characterized by the presence, in various members of a single family, of one or more nipple(s) and/or their related tissue, in addition to the normal bilateral chest nipples. The anomaly is usually situated along the embryonic milk line, from axillae to inguinal regions, but other locations are also possible. Association with dental abnormalities, Becker nevus, renal or underlying breast tissue malignancy and genitourinary malformations has been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial supernumerary nipples</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated polythelia</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial supernumerary nipples</rdfs:label>
        <skos:broadMatch>ICD-10:Q83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB63</skos:broadMatch>
        <skos:exactMatch>MONDO:0008101</skos:exactMatch>
        <skos:exactMatch>OMIM:163700</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707878</skos:exactMatch>
    </owl:Class>

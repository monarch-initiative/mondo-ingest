        <skos:narrowMatch>OMIM:615300</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616138</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617565</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619518</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619737</skos:narrowMatch>
        <skos:narrowMatch>OMIM:621101</skos:narrowMatch>
    </owl:Class>

        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies characterized by the presence of at least three of the following malformations: vertebral defects, anal atresia, cardiac defects, tracheo-esophageal fistula, renal anomalies, and limb abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">VACTERL association</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>VACTERL/VATER association</oboInOwl:hasExactSynonym>

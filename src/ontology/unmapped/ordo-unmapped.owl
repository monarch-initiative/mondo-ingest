    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_440713 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_440713">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79186"/>

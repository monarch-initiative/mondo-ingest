    <!-- http://www.orpha.net/ORDO/Orphanet_636955 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_636955">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_46485"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare autoimmune bullous skin disease characterized by the formation of subcorneal blisters mediated by autoantibodies against desmoglein 1, affecting predominantly seborrheic areas such as the head, neck, and upper trunk, but without any mucosal involvement. The lesions may be worsened by exposure to UV light and typically progress over weeks or months. The disease frequently occurs in children and young adults and is endemic to rural areas of Brazil and other countries in South America, as well as North Africa.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Endemic pemphigus foliaceus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fogo selvagem</oboInOwl:hasExactSynonym>
        <rdfs:label>Endemic pemphigus foliaceus</rdfs:label>
        <skos:broadMatch>ICD-11:EB40.1</skos:broadMatch>
        <skos:exactMatch>ICD-10:L10.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0043257</skos:exactMatch>
        <skos:exactMatch>MONDO:43257</skos:exactMatch>
        <skos:exactMatch>MeSH:C535551</skos:exactMatch>
        <skos:exactMatch>UMLS:C0263314</skos:exactMatch>
    </owl:Class>

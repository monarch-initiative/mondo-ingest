        <oboInOwl:hasExactSynonym xml:lang="en">Ocular albinism with congenital sensorineural hearing loss</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Waardenburg syndrome type 2 with ocular albinism</oboInOwl:hasExactSynonym>
        <rdfs:label>Ocular albinism with congenital sensorineural deafness</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

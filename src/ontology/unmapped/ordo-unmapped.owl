            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Ghosal hematodiaphyseal dysplasia syndrome (GHDD) is a rare disorder characterized by increased bone density (predominantly diaphyseal) and aregenerative corticosteroid-sensitive anemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diaphyseal dysplasia-anemia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ghosal hematodiaphyseal dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ghosal syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ghosal hematodiaphyseal dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009274</skos:exactMatch>

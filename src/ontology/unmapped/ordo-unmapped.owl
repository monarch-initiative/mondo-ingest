    <!-- http://www.orpha.net/ORDO/Orphanet_1190 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1190">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_138055"/>

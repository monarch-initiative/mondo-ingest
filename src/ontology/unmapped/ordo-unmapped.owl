        <oboInOwl:hasExactSynonym>Oculocutaneous albinism type 1A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tyrosinase-negative oculocutaneous albinism</oboInOwl:hasExactSynonym>
        <rdfs:label>Oculocutaneous albinism type 1A</rdfs:label>
        <skos:broadMatch>ICD-10:E70.3</skos:broadMatch>

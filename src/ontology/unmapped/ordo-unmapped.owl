            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Guanidinoacetate methyltransferase (GAMT) deficiency is a creatine deficiency syndrome characterized by global developmental delay/intellectual disability (DD/ID), prominent speech delay, autistic/hyperactive behavioral disorders, seizures, and various types of pyramidal and/or extra-pyramidal manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GAMT deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Guanidinoacetate methyltransferase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Guanidinoacetate methyltransferase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.4</skos:broadMatch>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25896"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined immunodeficiency (CID) due to &lt;i&gt;ORAI1&lt;/i&gt; deficiency is a form of CID due to Calcium release activated Ca2+ (CRAC) channel dysfunction characterized by recurrent infections, congenital myopathy, ectodermal dysplasia and anhydrosis.</obo:IAO_0000115>

    <!-- http://www.orpha.net/ORDO/Orphanet_230800 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_230800">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1267"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">Infectious botulism is a form of botulism, a rare acquired neuromuscular junction disease, characterized by descending flaccid paralysis caused by botulinum neurotoxins (BoNTs), produced &lt;i&gt;in vivo&lt;/i&gt; leading to toxin-mediated infection. Infectious botulism includes wound botulism and intestinal toxemia botulism (infant botulism and adult intestinal botulism).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Toxin-mediated infectious botulism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Toxin-mediated infective botulism</oboInOwl:hasExactSynonym>
        <rdfs:label>Toxin-mediated infectious botulism</rdfs:label>
        <skos:broadMatch>ICD-10:A05.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:1A11.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0016468</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679843</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

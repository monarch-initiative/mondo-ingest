    <!-- http://www.orpha.net/ORDO/Orphanet_36234 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_36234">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Bacterial toxic shock syndrome (TSS) is a potentially fatal, acute disease characterized by a sudden onset of high fever along with nausea, myalgia, vomiting and multisystem organ involvement, potentially leading to shock and death. TSS is mediated by superantigenic toxins, usually caused by an infection with &lt;i&gt;Staphylococcus aureus&lt;/i&gt; in staphylococcal TSS or &lt;i&gt;Streptococcus pyogenes&lt;/i&gt; in streptococcal TSS.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bacterial TSS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bacterial toxic-shock syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Bacterial toxic-shock syndrome</rdfs:label>
        <skos:exactMatch>ICD-10:A48.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:1C45</skos:exactMatch>
        <skos:exactMatch>MONDO:0001881</skos:exactMatch>
        <skos:exactMatch>MedDRA:10044248</skos:exactMatch>
        <skos:exactMatch>UMLS:C0600327</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_36234"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Bacterial toxic-shock syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_36235 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_36235">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_300579"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bacterial infectious disease characterized by staphylococcal epidermolytic toxin-mediated scarlatiniform exanthema accentuated in the flexural areas, as well as fever and affection of the general condition. The exanthema progresses to desquamation in large flaps, while blistering is not observed. Enanthema, strawberry tongue or palatal petechiae are absent. The condition has mainly been reported in children and young adults.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Staphylococcal scarlet fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Staphylococcal scarlet fever</rdfs:label>
        <skos:broadMatch>ICD-10:A38</skos:broadMatch>
        <skos:exactMatch>ICD-11:EA50.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0018180</skos:exactMatch>
        <skos:exactMatch>MedDRA:10039587</skos:exactMatch>
        <skos:exactMatch>UMLS:C5848379</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_36235"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Staphylococcal scarlet fever</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_36236 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_36236">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_300579"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare staphylococcal toxemia caused by epidermolytic toxins of &lt;i&gt;Staphylococcus aureus&lt;/i&gt; and characterized by the appearance of widespread erythematous patches, on which large blisters develop. Upon rupture of these blisters, the skin appears reddish and scalded. The lesions typically begin in the face and rapidly expand to other parts of the body. The disease may be complicated by pneumonia and sepsis. It most commonly affects newborns and infants.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Generalized exfoliative disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SSSS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Staphylococcal scalded skin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Staphylococcal scalded skin syndrome</rdfs:label>
        <skos:exactMatch>ICD-10:L00</skos:exactMatch>
        <skos:exactMatch>ICD-11:EA50.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0018181</skos:exactMatch>
        <skos:exactMatch>MeSH:D013206</skos:exactMatch>
        <skos:exactMatch>MedDRA:10041929</skos:exactMatch>
        <skos:exactMatch>UMLS:C0038165</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_36236"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Staphylococcal scalded skin syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_36237 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_36237">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_300579"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90077"/>
        <obo:IAO_0000115 xml:lang="en">A rare, acquired, typically benign, bacterial infectious disease caused by &lt;i&gt;Staphylococcus aureus&lt;/i&gt; characterized by large, fragile vesicles and flaccid bullae on an erythematous base, which evolve into moistened erosions with a thin, varnish-like crust, usually localized in intertriginous areas of the trunk and extremities (armpits, groins, between the fingers or toes, beneath the breasts). Although uncommon, systemic symptoms, such as fever, diarrhea, and weakness, may be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bullous impetigo</oboInOwl:hasExactSynonym>
        <rdfs:label>Bullous impetigo</rdfs:label>
        <skos:broadMatch>ICD-10:L01.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:1B72.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0018182</skos:exactMatch>
        <skos:exactMatch>MedDRA:10006563</skos:exactMatch>
        <skos:exactMatch>UMLS:C1542647</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_36237"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Bullous impetigo</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_36238 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_36238">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101944"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_300579"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Staphylococcal necrotizing pneumonia is a rare, bacterial, pulmonary infectious disease, caused by a Panton-Valentine leukocidin-producing Staphylococcus aureus strain, characterized by severe respiratory failure, extensive, rapidly progressing pneumonia and hemorrhagic lung necrosis. Patients typically present with influenza-like symptoms, such as fever, cough, and chest pain, as well as hemoptysis, hypotension, leukopenia, and severe respiratory symptoms that rapidly evolve to acute respiratory distress syndrome and septic shock. High mortality is associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Staphylococcal necrotizing pneumonia</oboInOwl:hasExactSynonym>
        <rdfs:label>Staphylococcal necrotizing pneumonia</rdfs:label>
        <skos:broadMatch>ICD-10:J15.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:CA40.06</skos:broadMatch>
        <skos:exactMatch>MONDO:0018183</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706659</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_36238"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Staphylococcal necrotizing pneumonia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_36258 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_36258">

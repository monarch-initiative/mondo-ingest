    <!-- http://www.orpha.net/ORDO/Orphanet_369913 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_369913">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217587"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35696"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

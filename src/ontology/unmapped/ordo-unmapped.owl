    <!-- http://www.orpha.net/ORDO/Orphanet_2743 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2743">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

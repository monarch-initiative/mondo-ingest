            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Paroxysmal non-kinesigenic dyskinesia (PNKD) is a form of paroxysmal dyskinesia, characterized by attacks of dystonic or choreathetotic movements precipitated by stress, fatigue, coffee or alcohol intake or menstruation.</obo:IAO_0000115>

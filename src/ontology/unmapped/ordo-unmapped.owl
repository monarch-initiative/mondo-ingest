    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_748">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183710"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">Mendelian susceptibility to mycobacterial diseases (MSMD) is a rare immunodeficiency syndrome, characterized by a narrow vulnerability to poorly virulent mycobacteria, such as bacillus Calmette-Guérin (BCG) vaccines and environmental mycobacteria (EM), and defined by severe, recurrent infections, either disseminated or localized.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic infection caused by BCG or atypical mycobacteria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MSMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mendelian susceptibility to atypical mycobacteria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mendelian susceptibility to mycobacterial diseases</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mendelian susceptibility to mycobacterial infections</oboInOwl:hasExactSynonym>
        <rdfs:label>Mendelian susceptibility to mycobacterial diseases</rdfs:label>
        <skos:exactMatch>MONDO:0019146</skos:exactMatch>
        <skos:exactMatch>MONDO:19146</skos:exactMatch>
        <skos:exactMatch>UMLS:C3266863</skos:exactMatch>
    </owl:Class>

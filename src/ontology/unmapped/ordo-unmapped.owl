    <!-- http://www.orpha.net/ORDO/Orphanet_77296 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_77296">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183542"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

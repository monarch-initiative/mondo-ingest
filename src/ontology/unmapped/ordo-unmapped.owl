    <!-- http://www.orpha.net/ORDO/Orphanet_180247 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_180247">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180312"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare vaginal tumors comprising HPV-associated and HPV-independent squamous cell carcinoma, glandular tumors (including HPV-associated adenocarcinoma, endometrioid carcinoma, clear cell carcinoma, gastric type and intestinal type mucinous carcinoma, and mesonephric adenocarcinoma), adenocarcinoma of Skene gland origin, adenosquamous carcinoma, and adenoid basal carcinoma. Depending on the type of tumor and disease stage, patients may present with symptoms related to a vaginal mass, vaginal bleeding and/or discharge, postcoital bleeding, urinary symptoms, pelvic pain, and a foreign body sensation within the vagina.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Vaginal carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vaginal malignant epithelial tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Vaginal carcinoma</rdfs:label>
        <skos:broadMatch>ICD-10:C52</skos:broadMatch>
        <skos:exactMatch>ICD-11:2C71</skos:exactMatch>
        <skos:exactMatch>MONDO:0015867</skos:exactMatch>
        <skos:exactMatch>UMLS:C0262659</skos:exactMatch>
    </owl:Class>

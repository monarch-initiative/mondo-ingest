    <!-- http://www.orpha.net/ORDO/Orphanet_3145 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3145">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183592"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93603"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, renal tubular disease characterised by nephrogenic diabetes insipidus, intracerebral calcifications, intellectual disability, short stature and facial dysmorphism. There have been no further descriptions in the literature since 1990.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Arginine vasopressin resistance-intracranial calcification-short stature-facial dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nephrogenic diabetes insipidus-intracranial calcification-short stature-facial dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Arginine vasopressin resistance-intracranial calcification-short stature-facial dysmorphism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:N25.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB90.4A</skos:broadMatch>
        <skos:exactMatch>MONDO:0009099</skos:exactMatch>
        <skos:exactMatch>MeSH:C535949</skos:exactMatch>
        <skos:exactMatch>OMIM:221995</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931070</skos:exactMatch>
    </owl:Class>

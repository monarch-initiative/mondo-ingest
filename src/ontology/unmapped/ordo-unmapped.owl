        <owl:annotatedTarget>Torsade-de-pointes syndrome with short coupling interval</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_511 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_511">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79197"/>
        <obo:IAO_0000115 xml:lang="en">A rare inherited disorder of branched-chain amino acid metabolism classically characterized by poor feeding, lethargy, vomiting and a maple syrup odor in the cerumen (and later in urine) noted soon after birth, followed by progressive encephalopathy and central respiratory failure if untreated. The four overlapping phenotypic subtypes are: classic, intermediate, intermittent and thiamine-responsive MSUD.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BCKD deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">BCKDH deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Branched-chain 2-ketoacid dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Branched-chain ketoaciduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MSUD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Maple syrup urine disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Maple syrup urine disease</rdfs:label>
        <skos:exactMatch>ICD-10:E71.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:5C50.D0</skos:exactMatch>
        <skos:exactMatch>MONDO:0009563</skos:exactMatch>
        <skos:exactMatch>MeSH:D008375</skos:exactMatch>
        <skos:exactMatch>MedDRA:10026817</skos:exactMatch>
        <skos:exactMatch>UMLS:C0024776</skos:exactMatch>
        <skos:narrowMatch>OMIM:248600</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615135</skos:narrowMatch>
        <skos:narrowMatch>OMIM:620698</skos:narrowMatch>
        <skos:narrowMatch>OMIM:620699</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98249"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2197"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2209"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2210"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited connective tissue disorder characterized by skin hyperextensibility, widened atrophic scars, and generalized joint hypermobility.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Classical EDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Classical Ehlers-Danlos syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">cEDS</oboInOwl:hasExactSynonym>
        <rdfs:label>Classical Ehlers-Danlos syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q79.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD28.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0007522</skos:exactMatch>
        <skos:exactMatch>UMLS:C4225429</skos:exactMatch>
        <skos:narrowMatch>OMIM:130000</skos:narrowMatch>
        <skos:narrowMatch>OMIM:130010</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_287"/>

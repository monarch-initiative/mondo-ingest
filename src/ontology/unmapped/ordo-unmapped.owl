        <oboInOwl:hasExactSynonym xml:lang="en">Cervical malignant mixed epithelial and mesenchymal tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Malignant mixed epithelial and mesenchymal tumor of cervix uteri</oboInOwl:hasExactSynonym>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247546 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247546">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_247525"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/758"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A severe form of citrullinemia type 1 characterized biologically by hyperammonemia and clinically by progressive lethargy, poor feeding and vomiting, seizures and possible loss of consciousness, within one to a few days of birth, with variable signs of increased intracranial pressure. The condition can lead to significant neurologic deficits.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acute neonatal citrullinemia type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acute neonatal citrullinemia type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset citrullinemia type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset citrullinemia type I</oboInOwl:hasExactSynonym>
        <rdfs:label>Acute neonatal citrullinemia type I</rdfs:label>
        <skos:broadMatch>ICD-10:E72.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.A3</skos:broadMatch>
        <skos:broadMatch>OMIM:215700</skos:broadMatch>
        <skos:exactMatch>MONDO:0016600</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679618</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247546"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Acute neonatal citrullinemia type I</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247573 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247573">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_247525"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/758"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of citrullinemia type I characterized clinically by adult onset of symptoms including variable hyperammonemia and less striking neurological findings which may include intense headache, scotomas, migraine-like episodes, ataxia, slurred speech, lethargy and drowsiness. Serious increased intracranial pressure may occur.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Late-onset citrullinemia type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Late-onset citrullinemia type I</oboInOwl:hasExactSynonym>
        <rdfs:label>Late-onset citrullinemia type I</rdfs:label>
        <skos:broadMatch>ICD-10:E72.2</skos:broadMatch>
        <skos:broadMatch>OMIM:215700</skos:broadMatch>
        <skos:exactMatch>MONDO:0016601</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268546</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247573"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Late-onset citrullinemia type I</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247582 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247582">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_187"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive urea cycle defect characterized clinically by recurring episodes of hyperammonemia and associated neuropsychiatric symptoms in the adult-onset form (citrullinemia type II), and by transient cholestasis and variable hepatic dysfunction in the neonatal form (neonatal intrahepatic cholestasis due to citrin deficiency).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Citrin deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Citrin deficiency</rdfs:label>
        <skos:exactMatch>MONDO:0016602</skos:exactMatch>
        <skos:exactMatch>MONDO:16602</skos:exactMatch>
        <skos:exactMatch>UMLS:C1997910</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247582"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Citrin deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247585 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247585">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_247582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10983"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A severe subtype of citrin deficiency characterized clinically by adult onset (20 and 50 years of age), recurrent episodes of hyperammonemia and associated neuropsychiatric symptoms such as nocturnal delirium, confusion, restlessness, disorientation, drowsiness, memory loss, abnormal behavior (aggression, irritability, and hyperactivity), seizures, and coma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult-onset citrin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult-onset citrullinemia type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult-onset citrullinemia type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CTLN2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Citrullinemia type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Citrullinemia type II</oboInOwl:hasExactSynonym>
        <rdfs:label>Citrullinemia type II</rdfs:label>
        <skos:broadMatch>ICD-10:E72.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.A3</skos:broadMatch>
        <skos:exactMatch>MONDO:0016603</skos:exactMatch>
        <skos:exactMatch>MeSH:C538053</skos:exactMatch>
        <skos:exactMatch>OMIM:603471</skos:exactMatch>
        <skos:exactMatch>UMLS:C1863844</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247585"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Citrullinemia type II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247598 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247598">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_247582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10983"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A mild subtype of citrin deficiency characterized clinically by low birth weight, failure to thrive, transient intrahepatic cholestasis, multiple aminoacidemia, galactosemia, hypoproteinemia, hepatomegaly, decreased coagulation factors, hemolytic anemia, variable but mostly mild liver dysfunction, and hypoglycemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">NICCD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal intrahepatic cholestasis caused by citrin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neonatal intrahepatic cholestasis due to citrin deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Neonatal intrahepatic cholestasis due to citrin deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.A3</skos:broadMatch>
        <skos:exactMatch>MONDO:0011601</skos:exactMatch>
        <skos:exactMatch>OMIM:605814</skos:exactMatch>
        <skos:exactMatch>UMLS:C1853942</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247598"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neonatal intrahepatic cholestasis due to citrin deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2476 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2476">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139039"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis disorder characterized by spinal dysraphism, cleft lip and palate, limb reduction defects and anencephaly. There have been no further descriptions in the literature since 1994.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dysraphism-cleft lip/palate-limb reduction defects syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Medeira-Dennis-Donnai syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Dysraphism-cleft lip/palate-limb reduction defects syndrome</rdfs:label>
        <skos:exactMatch>MONDO:0016604</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679624</skos:exactMatch>
        <skos:narrowMatch>ICD-10:Q00.0</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2476"/>

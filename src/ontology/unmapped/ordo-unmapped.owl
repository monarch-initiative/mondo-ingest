    <!-- http://www.orpha.net/ORDO/Orphanet_352709 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_352709">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_216"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98261"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2531"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neuronal ceroid lipofuscinosis characterized by adulthood-onset (11-65&amp;nbsp;years with the mean of 34&amp;nbsp;years) epilepsy, cognitive impairment, dementia with behavioral, neuropsychiatric, and movement disturbances. Facial dyskinesia and myoclonus epilepsy are commonly observed. Unspecified motor speech problems and akinetic mutism are also reported in some patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CLN13 disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Kufs disease type B</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NCL13</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neuronal ceroid lipofuscinosis type 13</oboInOwl:hasExactSynonym>
        <rdfs:label>CLN13 disease</rdfs:label>
        <skos:broadMatch>ICD-10:E75.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0014147</skos:exactMatch>
        <skos:exactMatch>MONDO:14147</skos:exactMatch>
        <skos:exactMatch>OMIM:615362</skos:exactMatch>
        <skos:exactMatch>UMLS:C3715049</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_352709"/>

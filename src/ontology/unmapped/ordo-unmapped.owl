    <!-- http://www.orpha.net/ORDO/Orphanet_2552 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2552">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163588"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare parasitic disease characterized by chronic diarrhea leading to severe weight loss caused by microsporidia contamination (most commonly by Encephalitozoon or Enterocytozoon). Contamination can occur through ingesting spores present in water or food or via direct human-to-human contact. Immunodeficient patients (such as individuals with HIV, and patients who have undergone a bone marrow or organ transplant) may be severely affected. These protozoan parasites mainly develop in intestinal cells, but can also be found in adipocytes, epithelial cells and blood cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microsporidiosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Microsporidiosis</rdfs:label>
        <skos:broadMatch>ICD-10:B60.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:1F58</skos:exactMatch>
        <skos:exactMatch>MONDO:0005846</skos:exactMatch>
        <skos:exactMatch>MeSH:D016881</skos:exactMatch>
        <skos:exactMatch>MedDRA:10053982</skos:exactMatch>
        <skos:exactMatch>UMLS:C0085407</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2552"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12843"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18647"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19691"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29622"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary optic atrophy characterized by an early onset of bilateral optic nerve degeneration without other systemic features. Clinical manifestations include pallor of the optic disks, severe but slowly progressing visual impairment, and in some patients also paracentral scotoma, photophobia and dyschromatopsia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive isolated optic atrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive non-syndromic optic atrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive isolated optic atrophy</rdfs:label>
        <skos:broadMatch>ICD-10:H47.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:9C40.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0014753</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680331</skos:exactMatch>
        <skos:narrowMatch>OMIM:258500</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616289</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616732</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617302</skos:narrowMatch>
        <skos:narrowMatch>OMIM:620583</skos:narrowMatch>
        <skos:narrowMatch>OMIM:620629</skos:narrowMatch>
    </owl:Class>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Partial agenesis of the pancreas is characterized by the congenital absence of a critical mass of pancreatic tissue.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital pancreatic agenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Partial agenesis of the pancreas</oboInOwl:hasExactSynonym>

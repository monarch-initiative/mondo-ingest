            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9179"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, mitochondrial DNA maintenance syndrome characterized by early-onset cerebellar ataxia, and variable combination of epilepsy, headache, dysarthria, ophthalmoplegia, peripheral neuropathy, intellectual disability, psychiatric symptoms and movement disorders.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MIRAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Recessive mitochondrial ataxia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Recessive mitochondrial ataxia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.21</skos:broadMatch>
        <skos:exactMatch>MONDO:0019791</skos:exactMatch>
        <skos:exactMatch>UMLS:C4760799</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_94125"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Mendelian susceptibility to mycobacterial diseases (MSMD) due to partial IRF8 (interferon regulatory factor 8) deficiency is a rare genetic variant of MSMD characterized by a selective susceptibility to relatively mild infections with bacillus Calmette-Guérin (BCG)..</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MSMD due to partial IRF8 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MSMD due to partial interferon regulatory factor 8 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mendelian susceptibility to mycobacterial diseases due to partial IRF8 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mendelian susceptibility to mycobacterial diseases due to partial interferon regulatory factor 8 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Mendelian susceptibility to mycobacterial diseases due to partial IRF8 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D84.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A00.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0013957</skos:exactMatch>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A severe form of junctional epidermolysis bullosa (JEB) characterized by generalized blistering at birth and congenital atresia of the pylorus and rarely of other portions of the gastrointestinal tract.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Carmi syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">JEB with pyloric atresia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">JEB-PA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Junctional epidermolysis bullosa with pyloric atresia</oboInOwl:hasExactSynonym>
        <rdfs:label>Junctional epidermolysis bullosa with pyloric atresia</rdfs:label>

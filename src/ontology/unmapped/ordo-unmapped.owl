        <owl:annotatedTarget>Baló concentric sclerosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_228169 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_228169">

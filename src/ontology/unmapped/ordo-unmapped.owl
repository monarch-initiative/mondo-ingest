    <!-- http://www.orpha.net/ORDO/Orphanet_314802 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_314802">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181393"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

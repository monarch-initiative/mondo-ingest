        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Resistance to thyrotropin-releasing hormone (TRH) syndrome is a type of central congenital hypothyroidism characterized by low levels of thyroid hormones due to insufficient release of thyroid-stimulating hormone (TSH) caused by pituitary resistance to TRH. It may or may not be observed from birth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Central hypothyroidism due to TRH receptor deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Resistance to thyrotropin-releasing hormone syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TRH resistance syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Resistance to thyrotropin-releasing hormone syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E03.1</skos:broadMatch>

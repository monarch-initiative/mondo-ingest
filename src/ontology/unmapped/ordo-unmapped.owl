        <skos:exactMatch>ICD-11:LA90.5</skos:exactMatch>
        <skos:exactMatch>MONDO:0009930</skos:exactMatch>
        <skos:exactMatch>MedDRA:10037332</skos:exactMatch>
        <skos:exactMatch>OMIM:265140</skos:exactMatch>
        <skos:exactMatch>UMLS:C0155675</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

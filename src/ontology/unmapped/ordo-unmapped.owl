    <!-- http://www.orpha.net/ORDO/Orphanet_300298 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300298">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

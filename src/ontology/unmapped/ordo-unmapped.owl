        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98292"/>
        <obo:IAO_0000115 xml:lang="en">A rare neoplastic disease characterized by a localized, unifocal, low-grade tumor composed of mature mast cells, without evidence of systemic mastocytosis or skin lesions. The tumor most commonly arises in the lung and shows a non-destructive growth pattern.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Extracutaneous mastocytoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Extracutaneous mastocytoma</rdfs:label>
        <skos:broadMatch>ICD-10:C96.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:2A21.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0019025</skos:exactMatch>
        <skos:exactMatch>UMLS:C0272202</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_238593 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_238593">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165711"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_596448"/>
        <obo:IAO_0000115 xml:lang="en">Sclerosing mesenteritis (SM) is a rare pathological disease causing inflammation of the adipose tissue of the small bowel mesentery and is commonly associated with abdominal pain, diarrhea, nausea, weight loss, bloating and loss of appetite. The two subforms include mesenteric panniculitis (where inflammation and fatty necrosis are dominant features) and retractile mesenteritis (where fibrosis and retraction dominate).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>IgG4-related mesenteritis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated mesenteric lipodystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lipomatous mesenteritis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Liposclerotic mesenteritis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mesenteric lipogranuloma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mesenteric panniculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sclerosing mesenteritis</oboInOwl:hasExactSynonym>
        <rdfs:label>IgG4-related mesenteritis</rdfs:label>
        <skos:broadMatch>ICD-10:K65.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A43.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0016544</skos:exactMatch>
        <skos:exactMatch>MedDRA:10063031</skos:exactMatch>
        <skos:exactMatch>UMLS:C0267770</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_238593"/>

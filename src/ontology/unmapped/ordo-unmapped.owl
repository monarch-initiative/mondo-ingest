    <!-- http://www.orpha.net/ORDO/Orphanet_90080 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90080">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377793"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519329"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare ophthalmic condition characterized by formation of excessive scar tissue between the conjunctiva/Tenon capsule and the sclera at the surgical site following glaucoma filtration surgery. Scarring can occur months or years after surgery, resulting in treatment failure with poor postoperative control of intraocular pressure and, potentially, loss of vision.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Scarring in glaucoma filtration surgical procedures</oboInOwl:hasExactSynonym>
        <rdfs:label>Scarring in glaucoma filtration surgical procedures</rdfs:label>
        <skos:broadMatch>ICD-10:H59.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9D22</skos:broadMatch>
        <skos:exactMatch>UMLS:C5681395</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90080"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Scarring in glaucoma filtration surgical procedures</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_90081 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90081">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_310050"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377793"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare condition associated with acquired immunodeficiency syndrome (AIDS) and characterized by unwanted weight loss (involving both fat and muscle) of more than ten percent of body weight, with either diarrhea or weakness and fever which have lasted at least 30 days and are not related to an infection.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>AIDS wasting syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>AIDS wasting syndrome</rdfs:label>
        <skos:broadMatch>ICD-11:1C62.3Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:B22.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0005797</skos:exactMatch>
        <skos:exactMatch>MONDO:5797</skos:exactMatch>
        <skos:exactMatch>MeSH:D019247</skos:exactMatch>
        <skos:exactMatch>MedDRA:10050309</skos:exactMatch>
        <skos:exactMatch>UMLS:C0343755</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90081"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>AIDS wasting syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_901 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_901">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90077"/>
        <obo:IAO_0000115 xml:lang="en">Wells syndrome is characterised by the presence of recurrent cellulitis-like eruptions with eosinophilia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Eosinophilic cellulitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wells syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Wells syndrome</rdfs:label>
        <skos:exactMatch>ICD-10:L98.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:EB30</skos:exactMatch>
        <skos:exactMatch>MONDO:0019547</skos:exactMatch>
        <skos:exactMatch>MeSH:C536693</skos:exactMatch>
        <skos:exactMatch>MedDRA:10053776</skos:exactMatch>
        <skos:exactMatch>UMLS:C0343101</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_901"/>

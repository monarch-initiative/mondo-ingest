    <!-- http://www.orpha.net/ORDO/Orphanet_139515 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139515">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_64749"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16873"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of Charcot-Marie-Tooth disease type&amp;nbsp;4 characterized by childhood- to adulthood-onset of variably severe, rapidly progressive, demyelinating with axonal loss sensorimotor neuropathy typically manifesting with delayed motor development, proximal and distal asymmetric muscle weakness and atrophy of the lower and upper extremities, severe motor dysfunction with mildly reduced sensory impairment, and areflexia. Nerve conduction velocities range from very mildly to severely reduced.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CMT4J</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Charcot-Marie-Tooth disease type 4J</oboInOwl:hasExactSynonym>
        <rdfs:label>Charcot-Marie-Tooth disease type 4J</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C20.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0012640</skos:exactMatch>
        <skos:exactMatch>MeSH:C566984</skos:exactMatch>
        <skos:exactMatch>OMIM:611228</skos:exactMatch>
        <skos:exactMatch>UMLS:C1970011</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_139515"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Charcot-Marie-Tooth disease type 4J</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_139518 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139518">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140465"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Distal hereditary motor neuropathy type 1 is a rare neuromuscular disease characterized by slowly-progressive lower limb muscular weakness and atrophy, without sensory impairment. Additional clinical features may include pes cavus, hammertoe and increased muscle tone.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant distal juvenile spinal muscular atrophy type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Distal hereditary motor neuropathy type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">dHMN1</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal hereditary motor neuropathy type 1</rdfs:label>
        <skos:broadMatch>ICD-10:G12.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B61.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0008451</skos:exactMatch>
        <skos:exactMatch>MeSH:C566675</skos:exactMatch>
        <skos:exactMatch>OMIM:182960</skos:exactMatch>
        <skos:exactMatch>UMLS:C1866784</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_139518"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Distal hereditary motor neuropathy type 1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

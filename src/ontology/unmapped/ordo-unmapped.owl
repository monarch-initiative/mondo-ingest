    <!-- http://www.orpha.net/ORDO/Orphanet_512103 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_512103">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_281103"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6413"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, inherited, non-syndromic ichthyosis characterized by congenital, generalized erythroderma with cutaneous blistering and erosions, resembling collodion presentation at birth, replaced by progressive hyperkeratosis later in life without palmoplantar involvement. The ultrastructural pathology consists of sparse keratin filaments and keratin clumps that show a nearly homogeneous, amorphous structure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AREI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autosomal recessive epidermolytic ichthyosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive epidermolytic ichthyosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q80.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.03</skos:broadMatch>
        <skos:exactMatch>MONDO:0044742</skos:exactMatch>
        <skos:exactMatch>OMIM:620707</skos:exactMatch>
        <skos:exactMatch>UMLS:C5437635</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_512103"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autosomal recessive epidermolytic ichthyosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_512260 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_512260">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98095"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary ataxia characterized by delayed motor milestones in early infancy, hypotonia, ataxic gait, intention tremor, nystagmus, dysarthric speech, and variable learning difficulties. Neuroimaging shows a mixed picture of cerebellar hypoplasia and degeneration, with an almost absent inferior lobule and thinning of the folia of the vermis. In addition, cisterna magna and fourth ventricle are enlarged with relative sparing of the brain stem volume.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital cerebellar ataxia due to RNU12 mutation</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital cerebellar ataxia due to RNU12 mutation</rdfs:label>
        <skos:broadMatch>ICD-10:G11.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0033717</skos:exactMatch>
        <skos:exactMatch>OMIM:620208</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567894</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_512260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital cerebellar ataxia due to RNU12 mutation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_513 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_513">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_547"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare Non-Hodgkin lymphoma characterized by malignant proliferation of lymphoid cells blocked at an early stage of differentiation. It accounts for 75% of all cases of childhood leukemia cases. The peak incidence occurs between 2 and 5&amp;nbsp;years of age. Patients may present with symptoms, frequently including lymphadenopathy, hepatosplenomegaly, bone pain, fever and signs of hemorrhage or they may remain asymptomatic. Some patients may also present with acute with a life-threatening hemorrhage, infection, or respiratory distress. Although it primarily affects the bone marrow and peripheral blood, the abnormal cells can infiltrate any organ or tissue.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ALL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acute lymphoblastic leukemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acute lymphoblastic leukemia/lymphoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acute lymphocytic leukemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Precursor lymphoid neoplasm</oboInOwl:hasExactSynonym>
        <rdfs:label>Acute lymphoblastic leukemia</rdfs:label>
        <skos:exactMatch>ICD-10:C91.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0004967</skos:exactMatch>
        <skos:exactMatch>MONDO:4967</skos:exactMatch>
        <skos:exactMatch>MeSH:D054198</skos:exactMatch>
        <skos:exactMatch>OMIM:613065</skos:exactMatch>
        <skos:exactMatch>UMLS:C1961102</skos:exactMatch>
        <skos:narrowMatch>OMIM:247640</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613067</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_513"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Acute lymphoblastic leukemia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_513436 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_513436">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100981"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30213"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive complex spastic paraplegia characterized by mostly adult-onset progressive spasticity and weakness predominantly affecting the lower limbs, axonal motor and sensory neuropathy, and cerebellar symptoms like ataxia, dysarthria, and oculomotor abnormalities. Variable degrees of cognitive impairment may also be present. Subtle extrapyramidal involvement and supranuclear gaze palsy were reported in some cases. Features on brain imaging include cerebral and cerebellar atrophy and sometimes abnormalities of the corpus callosum or basal ganglia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive spastic paraplegia type 78</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG78</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive spastic paraplegia type 78</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0014975</skos:exactMatch>
        <skos:exactMatch>OMIM:617225</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567893</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_513436"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autosomal recessive spastic paraplegia type 78</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_513456 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_513456">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/21208"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic multiple congenital anomalies/dysmorphic syndrome characterized by global developmental delay, intellectual disability, seizures, abnormal gait, and craniofacial dysmorphism (including coarse features, depressed nasal bridge, anteverted nares, broad nasal tip, prominent maxilla and upper lip, wide mouth, abnormal gingiva, and widely spaced teeth). Additional reported manifestations are ocular anomalies, cardiac defects, gastrointestinal problems, and autistic features. Brain imaging may show thin corpus callosum, white matter abnormalities, or dilated ventricles.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Intellectual disability-seizures-abnormal gait-facial dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Skraban-Deardorff syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Intellectual disability-seizures-abnormal gait-facial dysmorphism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0054636</skos:exactMatch>
        <skos:exactMatch>OMIM:617616</skos:exactMatch>
        <skos:exactMatch>UMLS:C4539927</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_513456"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Intellectual disability-seizures-abnormal gait-facial dysmorphism syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_514 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_514">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_167714"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A form of acute myeloid leukemia that is either comprised of more than 80% of monoblasts or 30-80% monoblasts with (pro)monocytic differentiation. It presents with asthenia, pallor, fever, and dizziness. Specific features include hyperleukocytosis, propensity for extramedullary infiltrates, coagulation abnormalities including disseminated intravascular coagulation and neurological disorders. Leukemia cutis and gingival infiltration can also be seen. A characteristic translocation observed is t(9;11).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AML M5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acute monoblastic or monocytic leukemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acute monoblastic/monocytic leukemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Acute monoblastic/monocytic leukemia</rdfs:label>
        <skos:exactMatch>ICD-10:C93.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:2A60.34</skos:exactMatch>
        <skos:exactMatch>MONDO:0007896</skos:exactMatch>
        <skos:exactMatch>MONDO:7896</skos:exactMatch>
        <skos:exactMatch>MeSH:D007948</skos:exactMatch>
        <skos:exactMatch>UMLS:C3831784</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_514"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Acute monoblastic/monocytic leukemia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_514352 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_514352">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108961"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371445"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic esophageal malformation characterized by severe congenital brachyesophagus with midline diaphragmatic hernia and secondary intrathoracic stomach, and vertebral anomalies (in particular rachischisis of the cervical/thoracic spine). Additional reported manifestations include intrauterine growth restriction, short neck, intestinal malrotation, herniation of other abdominal organs, and cleft lip, among others. The condition is mostly fatal in the neonatal or early infantile period.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital brachyesophagus-intrathoracic stomach-vertebral anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Serpentine-like syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital brachyesophagus-intrathoracic stomach-vertebral anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0034895</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680208</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_514352"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital brachyesophagus-intrathoracic stomach-vertebral anomalies syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_514980 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_514980">

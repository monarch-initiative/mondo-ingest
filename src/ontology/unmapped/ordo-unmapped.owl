        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic neurological disorder characterized by the presence of diffuse pachygyria and arachnoid cysts, psychomotor developmental delay and intellectual disability. Seizures (absence, atonic and generalized tonic-clonic) and, on occasion, headache are also associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Kuzniecky syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pachygyria-intellectual disability-epilepsy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Pachygyria-intellectual disability-epilepsy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G40.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0010840</skos:exactMatch>
        <skos:exactMatch>MeSH:C538091</skos:exactMatch>
        <skos:exactMatch>OMIM:600176</skos:exactMatch>
        <skos:exactMatch>UMLS:C1838491</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2798"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2387 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2387">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

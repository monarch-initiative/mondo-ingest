        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <obo:IAO_0000115 xml:lang="en">Griscelli syndrome (GS) is a rare cutaneous disease characterized by a silvery-gray sheen of the hair and hypopigmentation of the skin, which can be associated to primary neurological impairment (type 1), immunologic impairment (type 2) or be isolated (type 3).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Chédiak-Higashi-like syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Griscelli syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Griscelli-Pruniéras syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Partial albinism-immunodeficiency syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Griscelli syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E70.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC23.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018306</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081517</skos:exactMatch>
        <skos:exactMatch>UMLS:C0398794</skos:exactMatch>

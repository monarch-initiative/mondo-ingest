    <!-- http://www.orpha.net/ORDO/Orphanet_199306 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_199306">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1991"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2917"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Cleft lip and palate is a fissure type embryopathy extending across the upper lip, nasal base, alveolar ridge and the hard and soft palate.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Alveolar cleft lip and palate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cleft lip and palate</oboInOwl:hasExactSynonym>

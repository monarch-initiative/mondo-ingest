        <oboInOwl:hasExactSynonym xml:lang="en">14q22 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Al Frayh-Facharzt-Haque syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 14q22</oboInOwl:hasExactSynonym>
        <rdfs:label>Anophthalmia-hypothalamo-pituitary insufficiency syndrome</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

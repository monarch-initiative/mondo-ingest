    <!-- http://www.orpha.net/ORDO/Orphanet_798 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_798">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

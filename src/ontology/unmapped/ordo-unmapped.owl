    <!-- http://www.orpha.net/ORDO/Orphanet_2815 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2815">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by spastic paraparesis presenting in late childhood and hearing loss. Additional features may include retinal anomalies, lenticular opacities, short stature, hypogonadism, sensory deficits, tremor, dysdiadochokinesia, elevated cerebrospinal fluid protein, and absent or prolonged somatosensory evoked potentials. Plasma and fibroblast levels of saturated very long-chain fatty acids are normal. There have been no further descriptions in the literature since 1986.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Spastic paraparesis-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spastic paraparesis-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wells-Jankovic syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Spastic paraparesis-deafness syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010732</skos:exactMatch>
        <skos:exactMatch>MeSH:C536692</skos:exactMatch>
        <skos:exactMatch>OMIM:312910</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931291</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2815"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Spastic paraparesis-deafness syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <oboInOwl:hasExactSynonym xml:lang="en">Deafness-onychodystrophy-osteodystrophy-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Deafness-onychodystrophy-osteodystrophy-intellectual disability-seizures syndrome</oboInOwl:hasExactSynonym>

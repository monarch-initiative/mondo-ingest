    <!-- http://www.orpha.net/ORDO/Orphanet_87 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_87">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_138055"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139393"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98650"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98684"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A frequent form of acrocephalosyndactyly, a group of inherited congenital malformation disorders, characterized by craniosynostosis, midface hypoplasia, and finger and toe anomalies and/or syndactyly.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ACS1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acrocephalosyndactyly type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Apert syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Apert syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD24.G2</skos:exactMatch>
        <skos:exactMatch>MONDO:0007041</skos:exactMatch>
        <skos:exactMatch>MedDRA:10002943</skos:exactMatch>
        <skos:exactMatch>OMIM:101200</skos:exactMatch>
        <skos:exactMatch>UMLS:C0001193</skos:exactMatch>
    </owl:Class>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_447 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_447">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_158300"/>

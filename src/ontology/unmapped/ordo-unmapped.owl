        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neurological disorder characterized by severe episodic perirectal pain accompanied by skin flushing that is typically precipitated by defecation. Ocular and submaxillary pain, associated with triggers including cold or other irritants, may become more prominent with age.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial rectal pain</oboInOwl:hasExactSynonym>

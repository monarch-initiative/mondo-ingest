        <skos:exactMatch>MedDRA:10083960</skos:exactMatch>
        <skos:exactMatch>OMIM:228000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268255</skos:exactMatch>
    </owl:Class>

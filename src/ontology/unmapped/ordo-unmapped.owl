        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Fused manidbular incisors is an extremely rare dental anomaly that is characterized by the union of two, normally separated, incisor tooth germs of the primary dentition. It is frequently associated with hypodontia and an increased risk of pulp exposure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fused mandibular incisors</oboInOwl:hasExactSynonym>
        <rdfs:label>Fused mandibular incisors</rdfs:label>
        <skos:broadMatch>ICD-10:K00.2</skos:broadMatch>

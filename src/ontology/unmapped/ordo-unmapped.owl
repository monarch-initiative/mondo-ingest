    <!-- http://www.orpha.net/ORDO/Orphanet_91397 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91397">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156237"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>

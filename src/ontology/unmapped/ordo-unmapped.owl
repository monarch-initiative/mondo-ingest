        <oboInOwl:hasExactSynonym xml:lang="en">Schimmelpenning syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Solomon syndrome</oboInOwl:hasExactSynonym>

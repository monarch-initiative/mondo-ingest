    <!-- http://www.orpha.net/ORDO/Orphanet_26348 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_26348">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166775"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare hemorrhagic disorder characterized by decreased factor II plasma levels in association with severe liver disease, vitamin K deficiency, or vitamin K antagonist treatment, or in the context of other conditions such as systemic lupus erythematosus, primary antiphospholipid syndrome, or infections. Patients present with increased bleeding tendency leading to easy bruising, frequent nosebleeds, hemorrhaging after surgery or trauma, and heavy menstrual bleeding, among others. Joint bleeding is uncommon.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired hypoprothrombinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acquired prothrombin deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Acquired prothrombin deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D68.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016990</skos:exactMatch>
        <skos:exactMatch>MeSH:C538174</skos:exactMatch>
        <skos:exactMatch>UMLS:C0392610</skos:exactMatch>
    </owl:Class>

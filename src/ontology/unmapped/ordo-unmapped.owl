        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by the triad of adult-onset moderate to severe bilateral sensorineural hearing loss, premature graying of scalp hair, and essential tremor manifesting as involuntary shaking of the head. Additional pigmentation abnormalities have not been reported in this syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Sensorineural deafness-early graying-essential tremor syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sensorineural hearing loss-early graying-essential tremor syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Sensorineural hearing loss-early graying-essential tremor syndrome</rdfs:label>

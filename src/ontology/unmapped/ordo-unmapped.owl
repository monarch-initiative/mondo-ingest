    <!-- http://www.orpha.net/ORDO/Orphanet_210136 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_210136">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101939"/>

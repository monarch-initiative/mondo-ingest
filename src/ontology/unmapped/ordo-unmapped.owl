    <!-- http://www.orpha.net/ORDO/Orphanet_1757 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1757">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294959"/>

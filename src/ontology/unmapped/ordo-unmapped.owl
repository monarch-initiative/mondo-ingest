    <!-- http://www.orpha.net/ORDO/Orphanet_2611 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2611">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294057"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare skin disease characterized by a hamartomatous epidermal lesion presenting as a linear array of verrucous, hyperkeratotic papules that often coalesce into plaques and are formed along the lines of Blaschko. The condition is associated with involvement of other organ systems, mainly brain, eye, and skeletal system. It is the result of mosaic post-zygotic mutations and most commonly presents at birth, but may occur anytime during childhood, rarely also in adulthood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Linear hamartoma syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Linear verrucous nevus syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Linear verrucous nevus syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LC00.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016831</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679838</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2611"/>

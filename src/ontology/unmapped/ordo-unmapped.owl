    <!-- http://www.orpha.net/ORDO/Orphanet_2831 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2831">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

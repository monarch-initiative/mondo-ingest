    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_398069 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_398069">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_398073"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_641343"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6814"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare imprinting disorder characterized by muscular hypotonia, joint contractures/arthrogryposis, developmental delay, usually mild to moderate intellectual disability, short stature, hypogonadism, autism spectrum disorder and, less often, hyperphagia and seizures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SYS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Schaaf-Yang syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Schaaf-Yang syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0014243</skos:exactMatch>
        <skos:exactMatch>MeSH:C000726748</skos:exactMatch>
        <skos:exactMatch>OMIM:615547</skos:exactMatch>
        <skos:exactMatch>UMLS:C5575066</skos:exactMatch>
    </owl:Class>

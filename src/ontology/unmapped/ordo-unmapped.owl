    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1231">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79365"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98571"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20670"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation syndrome with neonatal onset characterized by congenital generalized hypertrichosis, redundant skin and facial dysmorphism such as ectropion and macrostomia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Barber-Say syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypertrichosis-atrophic skin-ectropion-macrostomia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Barber-Say syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0008853</skos:exactMatch>
        <skos:exactMatch>MeSH:C537908</skos:exactMatch>
        <skos:exactMatch>OMIM:209885</skos:exactMatch>
        <skos:exactMatch>UMLS:C1319466</skos:exactMatch>
    </owl:Class>

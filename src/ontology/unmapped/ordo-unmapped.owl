        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Davis-Lafer syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>OBSOLETE: Intellectual disability-unusual facies, Davis-Lafer type</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

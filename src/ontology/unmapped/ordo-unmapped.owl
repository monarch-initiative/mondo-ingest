    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_469 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_469">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104003"/>

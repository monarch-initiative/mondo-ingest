                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11566"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/43"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/44"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive primary immunodeficiency characterized by severe reduction in the cell surface expression of HLA class I molecules, typically resulting in childhood-onset of chronic bacterial infections of the respiratory tract evolving to widespread bronchiectasis and respiratory insufficiency. Sterile necrotizing granulomatous skin lesions mainly involving the extremities and the mid-face may be observed in some patients. Severe viral infections do not occur as part of the condition. Atypical variants without respiratory or cutaneous manifestations, as well as asymptomatic individuals have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bare lymphocyte syndrome type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Immunodeficiency by defective expression of MHC class I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MHC class I deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Immunodeficiency by defective expression of MHC class I</rdfs:label>
        <skos:exactMatch>ICD-10:D81.6</skos:exactMatch>
        <skos:exactMatch>ICD-11:4A01.11</skos:exactMatch>
        <skos:exactMatch>MONDO:0011476</skos:exactMatch>
        <skos:exactMatch>MeSH:C565759</skos:exactMatch>
        <skos:exactMatch>OMIM:604571</skos:exactMatch>
        <skos:exactMatch>UMLS:C1858266</skos:exactMatch>
        <skos:narrowMatch>OMIM:241600</skos:narrowMatch>
    </owl:Class>

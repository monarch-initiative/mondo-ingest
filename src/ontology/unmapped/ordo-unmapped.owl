            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30881"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of congenital disorders of N-linked glycosylation characterized by microcephaly, hepatomegaly, edema of the extremities, intractable seizures, recurrent infections and increased bleeding tendency. The disease is caused by mutations in the gene &lt;i&gt;ALG13&lt;/i&gt; (Xq23).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ALG13-CDG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type Is</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG-Is</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG1S</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 1s</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type Is</oboInOwl:hasExactSynonym>
        <rdfs:label>ALG13-CDG</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C54.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0010472</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_497906 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_497906">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182070"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183500"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_370106"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

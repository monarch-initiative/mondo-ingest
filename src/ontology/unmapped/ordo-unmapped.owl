        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716427"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20761"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Autosomal recessive spastic paraplegia type 15 is a complex form of hereditary spastic paraplegia characterized by a childhood to adulthood onset of slowly progressive lower limb spasticity (resulting in gait disturbance, extensor plantar responses and decreased vibration sense) associated with mild intellectual disability, mild cerebellar ataxia, peripheral neuropathy (with distal upper limb amyotrophy) and retinal degeneration. Thin corpus callosum is a common imaging finding.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive spastic paraplegia type 15</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary spastic paraparesis type 15</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kjellin syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG15</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spastic paraplegia-retinal degeneration syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Kjellin syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0010044</skos:exactMatch>
        <skos:exactMatch>MeSH:C536642</skos:exactMatch>
        <skos:exactMatch>OMIM:270700</skos:exactMatch>
        <skos:exactMatch>UMLS:C1849128</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100996"/>

        <oboInOwl:hasExactSynonym xml:lang="en">PFITS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Periodic fever-immunodeficiency-thrombocytopenia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Periodic fever-immunodeficiency-thrombocytopenia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D84.8</skos:broadMatch>

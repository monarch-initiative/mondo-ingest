        <skos:broadMatch>ICD-11:2A21.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019314</skos:exactMatch>
        <skos:exactMatch>MeSH:D054705</skos:exactMatch>
        <skos:exactMatch>UMLS:C0343115</skos:exactMatch>

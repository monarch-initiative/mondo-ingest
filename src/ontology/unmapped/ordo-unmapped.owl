        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital controlateral synkinesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital mirror movements</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial congenital mirror movements</rdfs:label>
        <skos:broadMatch>ICD-10:G25.8</skos:broadMatch>

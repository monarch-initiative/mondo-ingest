    <!-- http://www.orpha.net/ORDO/Orphanet_874 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_874">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_168194"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare disorder that manifest in adults and generally present with a variety of non-specific manifestations (depending on tumor site and infiltration) such as weight loss, exhaustion, hemorrhagic pericardial effusion, heart failure, arrhythmias, and embolisms, or that can also be asymptomatic. In adults 75% of heart tumors are benign, with myxoma being the most common benign tumor (accounting for 50-70% of all primary heart tumors) and rhabdomyosarcoma comprising 75% of malignant heart tumors. Other malignant tumors of the heart include fibrosarcoma and leiomyosarcoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult cardiac tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult heart tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary adult heart tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary adult heart tumor</rdfs:label>
        <skos:broadMatch>ICD-10:C38.0</skos:broadMatch>
        <skos:broadMatch>ICD-10:D15.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F01</skos:broadMatch>
        <skos:exactMatch>MONDO:0019493</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275152</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_874"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Primary adult heart tumor</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_875 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_875">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_168194"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Cardiac tumours are benign or malignant neoplasms arising primarily in the inner lining, muscle layer, or the surrounding pericardium of the heart. They can be primary or metastatic.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cardiac tumor of child</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Heart tumor of child</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary pediatric heart tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary pediatric heart tumor</rdfs:label>
        <skos:broadMatch>ICD-10:C38.0</skos:broadMatch>
        <skos:broadMatch>ICD-10:D15.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F01</skos:broadMatch>
        <skos:exactMatch>MONDO:0019494</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274356</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_238621 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_238621">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117569"/>

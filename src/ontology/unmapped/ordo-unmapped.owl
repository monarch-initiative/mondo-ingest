    <!-- http://www.orpha.net/ORDO/Orphanet_306741 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_306741">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68363"/>
        <obo:IAO_0000115 xml:lang="en">Hemidystonia-hemiatrophy (HD-HA) is a rare dystonia, usually caused by a static cerebral injury occurring at birth or during infancy, that is characterized by a combination of hemidystonia (HD), involving one half of the body, and hemiatrophy (HA) on the same side as the HD.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HD-HA syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hemidystonia-hemiatrophy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hemidystonia-hemiatrophy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G24.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0017649</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510649</skos:exactMatch>
    </owl:Class>

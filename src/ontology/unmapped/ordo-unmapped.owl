        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-hereditary condition characterized by gastrointestinal stromal tumors (GIST, intramural mesenchymal tumors of the gastrointestinal tract with neuronal or neural crest cell origin), pulmonary chondromas and extraadrenal paragangliomas.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Carney triad</oboInOwl:hasExactSynonym>
        <rdfs:label>Carney triad</rdfs:label>
        <skos:broadMatch>ICD-10:D44.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F7A.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0011424</skos:exactMatch>
        <skos:exactMatch>MeSH:C565803</skos:exactMatch>
        <skos:exactMatch>OMIM:604287</skos:exactMatch>
        <skos:exactMatch>UMLS:C1858592</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_139411"/>

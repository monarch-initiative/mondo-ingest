    <!-- http://www.orpha.net/ORDO/Orphanet_2637 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2637">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_240371"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_324761"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_477771"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

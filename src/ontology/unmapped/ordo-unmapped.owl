        <obo:IAO_0000115 xml:lang="en">A rare congenital abnormality in which the eyelids are absent and skin covers the ocular bulb, which is often microphthalmic. A few cases of complete bilateral cryptophthalmia have been described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated cryptophthalmia</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated cryptophthalmia</rdfs:label>
        <skos:broadMatch>ICD-10:Q11.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA14.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0007410</skos:exactMatch>
        <skos:exactMatch>OMIM:123570</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305274</skos:exactMatch>
    </owl:Class>

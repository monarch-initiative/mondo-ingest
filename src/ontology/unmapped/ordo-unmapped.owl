            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1391"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Sinoatrial node dysfunction and deafness is a rare genetic disease characterized by congenital severe to profound deafness with no evidence of vestibular dysfunction, associated with sinoatrial node dysfunction with pronounced bradycardia and increased variability of heart rate at rest and episodic syncopes that may be triggered by enhanced physical activity and stress.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Sinoatrial node dysfunction and deafness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sinoatrial node dysfunction and hearing loss</oboInOwl:hasExactSynonym>
        <rdfs:label>Sinoatrial node dysfunction and deafness</rdfs:label>
        <skos:broadMatch>ICD-10:H91.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:BC80.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0013960</skos:exactMatch>
        <skos:exactMatch>OMIM:614896</skos:exactMatch>
        <skos:exactMatch>UMLS:C3554018</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_324321"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_96194 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96194">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

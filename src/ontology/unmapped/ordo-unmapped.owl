    <!-- http://www.orpha.net/ORDO/Orphanet_98919 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98919">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_231416"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare acquired peripheral neuropathy characterized by acute ophthalmoplegia, ataxia, and areflexia, typically manifesting with diplopia and unsteady gait, and generalized areflexia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cranial variant of GBS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cranial variant of Guillain-Barré syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fisher syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Miller Fisher syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Miller Fisher syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G61.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C01.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0005851</skos:exactMatch>
        <skos:exactMatch>MeSH:D019846</skos:exactMatch>
        <skos:exactMatch>MedDRA:10049567</skos:exactMatch>
        <skos:exactMatch>UMLS:C0393799</skos:exactMatch>
    </owl:Class>

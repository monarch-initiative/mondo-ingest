            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Isolated congenital digital clubbing is a rare genodermatosis disorder characterized by enlargement of the terminal segments of fingers and toes with thickened nails without any other abnormality.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital acropachy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital digital clubbing</oboInOwl:hasExactSynonym>

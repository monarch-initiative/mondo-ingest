                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11918"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined immunodeficiency due to OX40 deficiency is a rare combined T and B cell immunodeficiency characterized by susceptibility to develop an aggressive, childhood-onset, disseminated, cutaneous and systemic Kaposi sarcoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Combined immunodeficiency due to OX40 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Combined immunodeficiency with childhood-onset Kaposi sarcoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Combined immunodeficiency with impaired immunity to HHV-8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Combined immunodeficiency with impaired immunity to human herpes virus 8</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined immunodeficiency due to OX40 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D81.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.1Y</skos:broadMatch>

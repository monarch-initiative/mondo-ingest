        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693802"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98746"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6296"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic epilepsy syndrome characterized by seizures onset typically in the first week of life, in otherwise healthy newborns, and usually resolving within the first year of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BFNS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign familial neonatal convulsions</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign familial neonatal epilepsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign familial neonatal seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SeLNE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Self-limited neonatal epilepsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Self-limited neonatal epilepsy</rdfs:label>
        <skos:broadMatch>ICD-10:G40.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016027</skos:exactMatch>
        <skos:exactMatch>MONDO:16027</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_97278 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97278">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506060"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">PPoma is a type of pancreatic endocrine tumor that hypersecretes pancreatic polypeptide (PP) but that does not cause a hypersecretion syndrome (is non-functioning) and instead presents with only non-specific symptoms such as weight loss, abdominal pain, jaundice, diarrhea and/or an abdominal mass, hence leading to a late diagnosis. PPoma can be associated with multiple endocrine neoplasia 1 (MEN-1).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PPoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pancreatic polypeptidoma</oboInOwl:hasExactSynonym>
        <rdfs:label>PPoma</rdfs:label>
        <skos:broadMatch>ICD-10:D37.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C10.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0019957</skos:exactMatch>
        <skos:exactMatch>UMLS:C0346407</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97278"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>PPoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_97279 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97279">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506060"/>

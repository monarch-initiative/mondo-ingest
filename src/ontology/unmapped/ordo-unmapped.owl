                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4274"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Craniometaphyseal dysplasia (CMD) is a very rare genetic bone disease characterized by progressive diffuse hyperostosis of cranial bones causing facial dysmorphism and functional repercussions, and metaphyseal widening of long bones.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Craniometaphyseal dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Craniometaphyseal dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015465</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265292</skos:exactMatch>
        <skos:narrowMatch>OMIM:123000</skos:narrowMatch>
        <skos:narrowMatch>OMIM:218400</skos:narrowMatch>
    </owl:Class>

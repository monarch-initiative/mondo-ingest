        <owl:annotatedTarget>Isolated congenital onychodysplasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_79145 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79145">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309505"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371200"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

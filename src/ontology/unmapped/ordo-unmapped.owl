        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/21957"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare epilepsy syndrome characterized by infantile- to early childhood-onset of progressive myoclonic seizures (occasionally accompanied by generalized tonic-clonic seizures) and severe, progressive neurological regression, leading to psychomotor and cognitive decline, cerebellar ataxia, dementia and, frequently, early death. Vision loss may be associated. EEG typically reveals epileptiform activity with predominance in the posterior region and photosensitivity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EPM3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PME type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive myoclonic epilepsy due to KCTD7 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progressive myoclonic epilepsy type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive myoclonus epilepsy type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Progressive myoclonic epilepsy type 3</rdfs:label>
        <skos:broadMatch>ICD-10:G40.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.41</skos:broadMatch>
        <skos:broadMatch>OMIM:611726</skos:broadMatch>
        <skos:exactMatch>MONDO:0012721</skos:exactMatch>
        <skos:exactMatch>MeSH:C567095</skos:exactMatch>
        <skos:exactMatch>UMLS:C2673257</skos:exactMatch>
    </owl:Class>

        <obo:IAO_0000115 xml:lang="en">A rare form of polyarticular juvenile idiopathic arthritis characterized by childhood-onset chronic arthritis of unknown cause involving five or more joints at disease onset and absence of rheumatoid factor IgM.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile polyarthritis without rheumatoid factor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile rheumatoid factor-negative polyarthritis</oboInOwl:hasExactSynonym>

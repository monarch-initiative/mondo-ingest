                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/583"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Cenani-Lenz syndrome (CLS) is a congenital malformation syndrome that associates a complex syndactyly of the hands with malformations of the forearm bones and similar manifestations in the lower limbs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cenani syndactyly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cenani-Lenz syndactyly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cenani-Lenz syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Syndactyly type 7</oboInOwl:hasExactSynonym>
        <rdfs:label>Cenani-Lenz syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB79.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008931</skos:exactMatch>
        <skos:exactMatch>MeSH:C538150</skos:exactMatch>
        <skos:exactMatch>OMIM:212780</skos:exactMatch>
        <skos:exactMatch>UMLS:C1859309</skos:exactMatch>
    </owl:Class>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by the triad of anorectal malformations, presacral mass and sacral anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Currarino syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Currarino triad</oboInOwl:hasExactSynonym>
        <rdfs:label>Currarino syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008305</skos:exactMatch>
        <skos:exactMatch>MeSH:C536221</skos:exactMatch>
        <skos:exactMatch>MedDRA:10079857</skos:exactMatch>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_168583 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168583">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_172"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1983"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary North American Indian childhood cirrhosis is a severe autosomal recessive intrahepatic cholestasis that has only been described in aboriginal children from northwestern Quebec. Manifesting first as transient neonatal jaundice, the disease evolves into periportal fibrosis and cirrhosis during a period ranging from childhood to adolescence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hereditary North American Indian childhood cirrhosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary North American Indian childhood cirrhosis</rdfs:label>
        <skos:broadMatch>ICD-10:K74.6</skos:broadMatch>
        <skos:exactMatch>ICD-11:DB93.20</skos:exactMatch>
        <skos:exactMatch>MONDO:0011497</skos:exactMatch>
        <skos:exactMatch>MeSH:C565737</skos:exactMatch>
        <skos:exactMatch>OMIM:604901</skos:exactMatch>
        <skos:exactMatch>UMLS:C1858051</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_168583"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hereditary North American Indian childhood cirrhosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_168588 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168588">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180208"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181412"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_202940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4795"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5208"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, endocrine disease characterized by defect in conversion of cortisone to active cortisol, resulting in ACTH-mediated excessive androgen release from adrenal glands. Premature adrenarche is typical with precocious pseudopuberty, proportionate tall stature and accelerated bone maturation in males, and hirsutism, oligoamenorrhea, central obesity and infertility in females. Imaging studies may indicate adrenal hyperplasia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">11-beta-hydroxysteroid dehydrogenase deficiency type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hyperandrogenism due to cortisone reductase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyperandrogenism due to cortisone reductase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E25.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A71.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0000193</skos:exactMatch>
        <skos:exactMatch>UMLS:C4329210</skos:exactMatch>
        <skos:narrowMatch>OMIM:604931</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614662</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_168588"/>

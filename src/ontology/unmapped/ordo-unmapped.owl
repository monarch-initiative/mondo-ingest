    <!-- http://www.orpha.net/ORDO/Orphanet_319213 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319213">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_341"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Lujo hemorrhagic fever, caused by the Lujo virus (a newly discovered Old World arenavirus) is a zoonotic disease from Zambia, Africa, whose reservoir is unknown and is characterized by fever and hemorrhagic manifestations with an extremely high fatality rate of 80% (in the 5 reported cases to date) and a moderate to high level of nosocomial transmission.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lujo hemorrhagic fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Zambian hemorrhagic fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Lujo hemorrhagic fever</rdfs:label>
        <skos:broadMatch>ICD-10:A96.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:1D6Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017872</skos:exactMatch>
        <skos:exactMatch>MeSH:C000723471</skos:exactMatch>
        <skos:exactMatch>MedDRA:10079325</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274433</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_319213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lujo hemorrhagic fever</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

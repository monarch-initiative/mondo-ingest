        <obo:IAO_0000115 xml:lang="en">A rare osteochondrosis characterized by uni- or bilateral avascular necrosis (AVN) of the femoral head in children.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Aseptic necrosis of the capital femoral epiphysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Legg-Calvé-Perthes disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteochondrosis of the capital femoral epiphysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Perthes disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Legg-Calvé-Perthes disease</rdfs:label>

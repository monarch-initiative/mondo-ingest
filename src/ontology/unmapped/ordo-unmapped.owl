        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8941"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary, metabolic disease characterized by serum levels of alpha-1-antitrypsin (AAT) that are well below the normal range. In the most severe form, the disease can clinically manifest with chronic liver disorders (cirrhosis, fibrosis), respiratory disorders (emphysema, bronchiectasis), and rarely panniculitis or vasculitis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Alpha-1-antitrypsin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Alpha-1-proteinase inhibitor deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Alpha1-antitrypsin deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Alpha-1-antitrypsin deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E88.0</skos:broadMatch>
        <skos:broadMatch>OMIM:613490</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C5A</skos:exactMatch>
        <skos:exactMatch>MONDO:0013282</skos:exactMatch>
        <skos:exactMatch>MeSH:D019896</skos:exactMatch>
        <skos:exactMatch>MedDRA:10001806</skos:exactMatch>
        <skos:exactMatch>UMLS:C0221757</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_60"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Alpha-1-antitrypsin deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

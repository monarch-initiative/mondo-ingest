    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93271">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1505"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

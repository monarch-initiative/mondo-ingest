    <!-- http://www.orpha.net/ORDO/Orphanet_96184 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96184">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254516"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98153"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly characterized by prenatal and postnatal growth retardation, hypotonia, motor delay, early puberty, obesity, short adult stature, small hands and feet, mild intellectual disability, and mild dysmorphic facial features (frontal bossing, short nose with wide nasal tip, micrognathia, high palate, short philtrum).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Temple syndrome due to maternal uniparental disomy of chromosome 14</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UPD(14)mat</oboInOwl:hasExactSynonym>
        <rdfs:label>Temple syndrome due to maternal uniparental disomy of chromosome 14</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2Y</skos:broadMatch>
        <skos:broadMatch>OMIM:616222</skos:broadMatch>
        <skos:exactMatch>MONDO:0019915</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680248</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96184"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Temple syndrome due to maternal uniparental disomy of chromosome 14</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_96185 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96185">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98153"/>
        <obo:IAO_0000115 xml:lang="en">Maternal uniparental disomy of chromosome 16 is a uniparental disomy of maternal origin which might be associated with intrauterine growth retardation and an elevated risk of congenital malformations. Healthy carriers have also been reported. In addition, cases of homozygosity for a recessive disease mutation for which the mother was a carrier have been described, and specific phenotype depends on the inherited disorder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Maternal uniparental disomy of chromosome 16 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UPD(16)mat</oboInOwl:hasExactSynonym>
        <rdfs:label>Maternal uniparental disomy of chromosome 16 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD45.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0019916</skos:exactMatch>
        <skos:exactMatch>UMLS:C4750769</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96185"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Maternal uniparental disomy of chromosome 16 syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_96186 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96186">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98153"/>
        <obo:IAO_0000115 xml:lang="en">Maternal uniparental disomy of chromosome 20 (UPD 20) is a very rare chromosomal anomaly in which both copies of chromosome 20 are inherited from the mother. The main feature described is prenatal and postnatal growth retardation. Microcephaly, minor dysmorphic features and psychomotor developmental delay have been occasionally reported. Maternal UPD20 is most often ascertained by a mosaic trisomy 20 pregnancy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Maternal UPD(20)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Maternal uniparental disomy of chromosome 20 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UPD(20)mat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>maternal upd(20)</oboInOwl:hasExactSynonym>
        <rdfs:label>Maternal uniparental disomy of chromosome 20 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD45.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0019917</skos:exactMatch>
        <skos:exactMatch>OMIM:617352</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275029</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96186"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Maternal uniparental disomy of chromosome 20 syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>

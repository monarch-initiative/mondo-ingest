    <!-- http://www.orpha.net/ORDO/Orphanet_99966 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99966">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251852"/>

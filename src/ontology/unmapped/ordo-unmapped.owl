        <oboInOwl:hasExactSynonym xml:lang="en">VCAN-related vitreoretinopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vitreoretinal degeneration, Wagner type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wagner disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wagner syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Wagner disease</rdfs:label>

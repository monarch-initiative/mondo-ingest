        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A form of focal dystonia, affecting the lower part of the face and jaws. It is characterized by sustained or repetitive involuntary jaw and tongue movements and facial grimacing caused by involuntary spasms of the masticatory, facial, pharyngeal, lingual, and lip muscles.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Oromandibular dystonia</oboInOwl:hasExactSynonym>
        <rdfs:label>Oromandibular dystonia</rdfs:label>
        <skos:broadMatch>ICD-11:8A02.0Y</skos:broadMatch>
        <skos:exactMatch>ICD-10:G24.4</skos:exactMatch>
        <skos:exactMatch>MONDO:0019771</skos:exactMatch>
        <skos:exactMatch>MedDRA:10067954</skos:exactMatch>
        <skos:exactMatch>UMLS:C2242577</skos:exactMatch>
    </owl:Class>

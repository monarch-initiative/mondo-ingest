    <!-- http://www.orpha.net/ORDO/Orphanet_79304 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79304">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_172"/>

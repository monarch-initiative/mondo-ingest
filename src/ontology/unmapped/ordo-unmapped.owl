    <!-- http://www.orpha.net/ORDO/Orphanet_85201 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85201">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

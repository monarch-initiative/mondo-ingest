        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare otorhinolaryngologic malformation characterized by the isolated finding of a short and immobile soft palate with anatomical disproportion of the velopharyngeal structures, preventing velopharyngeal closure. Patients present with delayed speech development and hypernasal speech.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital velopharyngeal incompetence</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital velopharyngeal incompetence</rdfs:label>

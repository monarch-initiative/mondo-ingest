        <obo:IAO_0000115 xml:lang="en">A rare skin disease of unknown origin characterized by macrocheilia and secretions of thick saliva from swollen labial minor salivary glands.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cheilitis glandularis</oboInOwl:hasExactSynonym>
        <rdfs:label>Cheilitis glandularis</rdfs:label>
        <skos:broadMatch>ICD-10:K13.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA00.0</skos:broadMatch>

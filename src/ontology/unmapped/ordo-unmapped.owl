    <!-- http://www.orpha.net/ORDO/Orphanet_231013 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231013">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519349"/>

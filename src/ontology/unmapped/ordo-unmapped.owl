    <!-- http://www.orpha.net/ORDO/Orphanet_90350 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90350">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_289866"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93446"/>
        <obo:IAO_0000115 xml:lang="en">A spectrum of connective tissue disorders characterized by the association of wrinkled, redundant and sagging inelastic skin with growth and developmental delay, and skeletal anomalies. The spectrum ranges from patients with classic autosomal recessive cutis laxa type 2 (ARCL2, Debré type) to patients with a milder form of the disease, wrinkled skin syndrome (WSS).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ARCL2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autosomal recessive cutis laxa type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutis laxa with joint laxity and developmental delay</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive cutis laxa type 2</rdfs:label>
        <skos:exactMatch>MONDO:0019573</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432337</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90350"/>

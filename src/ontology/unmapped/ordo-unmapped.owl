            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10483"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Malignant hyperthermia (MH) is a pharmacogenetic disorder of skeletal muscle that presents as a hypermetabolic response to potent volatile anesthetic gases such as halothane, sevoflurane, desflurane and the depolarizing muscle relaxant succinylcholine, and rarely, to stresses such as vigorous exercise and heat.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperthermia of anesthesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Malignant hyperthermia of anesthesia</oboInOwl:hasExactSynonym>
        <rdfs:label>Malignant hyperthermia of anesthesia</rdfs:label>
        <skos:exactMatch>ICD-10:T88.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:8C78</skos:exactMatch>
        <skos:exactMatch>MONDO:0018493</skos:exactMatch>
        <skos:exactMatch>MeSH:D008305</skos:exactMatch>
        <skos:exactMatch>MedDRA:10020844</skos:exactMatch>
        <skos:exactMatch>OMIM:145600</skos:exactMatch>
        <skos:exactMatch>UMLS:C0024591</skos:exactMatch>
        <skos:narrowMatch>OMIM:154275</skos:narrowMatch>
        <skos:narrowMatch>OMIM:154276</skos:narrowMatch>
        <skos:narrowMatch>OMIM:600467</skos:narrowMatch>
        <skos:narrowMatch>OMIM:601887</skos:narrowMatch>
        <skos:narrowMatch>OMIM:601888</skos:narrowMatch>
    </owl:Class>

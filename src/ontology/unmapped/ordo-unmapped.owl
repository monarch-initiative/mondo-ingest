    <!-- http://www.orpha.net/ORDO/Orphanet_1756 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1756">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>

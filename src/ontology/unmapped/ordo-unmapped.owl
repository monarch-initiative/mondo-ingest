        <oboInOwl:hasExactSynonym xml:lang="en">Congenital cystic adenomatous malformation of the lung type 0</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital pulmonary airway malformation type 0</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital pulmonary airway malformation type 0</rdfs:label>

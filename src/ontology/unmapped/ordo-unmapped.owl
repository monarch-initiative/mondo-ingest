    <!-- http://www.orpha.net/ORDO/Orphanet_1031 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1031">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139042"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183580"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93593"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/23015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A extremely rare, genetic malformation syndrome characterized by hypoplastic amelogenesis imperfecta (hypoplastic dental enamel) and nephrocalcinosis (precipitation of calcium salts in renal tissue). Oral manifestations include yellow and misshaped teeth, delayed tooth eruption, and intrapulpal calcifications. Nephrocalcinosis is often asymptomatic but can progress during late childhood or early adulthood to impaired renal function, recurrent urinary infections, renal tubular acidosis, and rarely to end-stage renal failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Amelogenesis imperfecta-nephrocalcinosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Enamel-renal syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Enamel-renal syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:K00.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA30.6</skos:broadMatch>
        <skos:exactMatch>MONDO:0008771</skos:exactMatch>
        <skos:exactMatch>MeSH:C538241</skos:exactMatch>
        <skos:exactMatch>OMIM:204690</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931783</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1031"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Enamel-renal syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



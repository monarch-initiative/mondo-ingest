                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/430"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Self-healing collodion baby (SHCB) is a minor variant of autosomal recessive congenital ichthyosis (ARCI) characterized by the presence of a collodion membrane at birth that heals within the first weeks of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SHCB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SICI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Self-healing collodion baby</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Self-improving collodion baby</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Self-improving congenital ichthyosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Self-improving collodion baby</rdfs:label>
        <skos:broadMatch>ICD-10:Q80.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.02</skos:broadMatch>
        <skos:broadMatch>OMIM:242300</skos:broadMatch>
        <skos:exactMatch>MONDO:0017267</skos:exactMatch>
        <skos:exactMatch>MeSH:C565473</skos:exactMatch>
        <skos:exactMatch>UMLS:C1855789</skos:exactMatch>
        <skos:narrowMatch>OMIM:242100</skos:narrowMatch>
        <skos:narrowMatch>OMIM:606545</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_281122"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2909 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2909">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139033"/>

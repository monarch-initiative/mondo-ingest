        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An X-linked recessive retinal disease characterized by fundus hypopigmentation, decreased visual acuity, nystagmus, astigmatism, progressive axial myopia, defective dark adaptation and protanopia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AIED</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Forsius-Eriksson syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Forsius-Eriksson type ocular albinism</oboInOwl:hasExactSynonym>

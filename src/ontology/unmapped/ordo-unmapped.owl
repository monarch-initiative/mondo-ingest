                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3395"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare intracranial congenital high-flow vascular malformation characterized by arteriovenous shunts draining into the median prosencephalic vein of Markowski, embryonic precursor of the vein of Galen, typically presenting in neonates or infants.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">VOGM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vein of Galen arteriovenous malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vein of Galen malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Vein of Galen malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q28.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA90.20</skos:exactMatch>
        <skos:exactMatch>MONDO:0015196</skos:exactMatch>
        <skos:exactMatch>MeSH:C536535</skos:exactMatch>
        <skos:exactMatch>MedDRA:10077889</skos:exactMatch>

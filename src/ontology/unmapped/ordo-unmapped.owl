        <obo:IAO_0000115 xml:lang="en">A rare syndrome characterized by sparse hair, osteopenia, intellectual disability, minor facial abnormalities, joint laxity and hypotonia. There have been no further descriptions in the literature since 1992.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Kaler-Garrity-Stern syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteopenia-intellectual disability-sparse hair syndrome</oboInOwl:hasExactSynonym>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_66646"/>
        <obo:IAO_0000115 xml:lang="en">Diffuse cutaneous mastocytosis (DCM) is a rare form of cutaneous mastocytosis (CM) characterized by generalized erythroderma, various degrees of blistering, skin with a &apos;&apos;peau d&apos;orange&apos;&apos; appearance and the accumulation of mast cells in the skin. At least two DCM variants are recognized, one with extreme blistering (Bullous DCM) and one with infiltrations (Pseudoxanthomatous DCM).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DCM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse cutaneous maculopapulous mastocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Diffuse cutaneous mastocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Diffuse cutaneous mastocytosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A21.1Y</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH2RG8</skos:exactMatch>
        <skos:exactMatch>MONDO:0019315</skos:exactMatch>
        <skos:exactMatch>MedDRA:10012812</skos:exactMatch>
        <skos:exactMatch>UMLS:C0024901</skos:exactMatch>
    </owl:Class>

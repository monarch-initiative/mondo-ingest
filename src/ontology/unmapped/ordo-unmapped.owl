    <!-- http://www.orpha.net/ORDO/Orphanet_583097 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_583097">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_530313"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8975"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare PIK3CA-related overgrowth syndrome characterized by congenital non-hereditary facial overgrowth due to post-zygotic activating mutations in the &lt;i&gt;PIK3CA&lt;/i&gt; gene. It is unilateral and involves hypertrophy of both the soft and hard tissue structures on the affected side of the face, including hypertrophy of the facial bones, macroglossia, and proliferation of the parotid gland. Early eruption of the teeth is common.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CIL-F</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital infiltrating lipomatosis of the face</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Facial infused lipomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fibroadipose infiltrating lipomatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital infiltrating lipomatosis of the face</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:EF02.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0035592</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680341</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_583097"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital infiltrating lipomatosis of the face</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_583595 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_583595">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35705"/>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6535"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare glycogen storage disease characterized by easy fatigue, exertional myalgia, painful muscle stiffness, and cramps, with or without myoglobinuria. Pustular psoriasis-like eruptions with antecedent annular scaly plaques may be observed in some patients. In affected women, pregnancy may be complicated by abdominal pain and dystocia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD due to lactate dehydrogenase M-subunit deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glycogen storage disease due to lactate dehydrogenase M-subunit deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis due to lactate dehydrogenase M-subunit deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LDH-M subunit deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lactate dehydrogenase A deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Glycogen storage disease due to lactate dehydrogenase M-subunit deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E74.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C51.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0013047</skos:exactMatch>
        <skos:exactMatch>MeSH:C538133</skos:exactMatch>
        <skos:exactMatch>OMIM:612933</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931743</skos:exactMatch>
    </owl:Class>

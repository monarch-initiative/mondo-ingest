    <!-- http://www.orpha.net/ORDO/Orphanet_101005 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_101005">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100981"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25855"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Autosomal recessive spastic paraplegia type 25 (SPG25) is a rare, complex type of hereditary spastic paraplegia characterized by adult-onset spastic paraplegia associated with spinal pain that radiates to the upper or lower limbs and is related to disk herniation (with minor spondylosis), as well as mild sensorimotor neuropathy. The SPG25 phenotype has been mapped to a locus on chromosome 6q23-q24.1.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive spastic paraplegia type 25</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive spastic paraplegia-disc herniation syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG25</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive spastic paraplegia type 25</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0011992</skos:exactMatch>
        <skos:exactMatch>MONDO:11992</skos:exactMatch>
        <skos:exactMatch>MeSH:C536861</skos:exactMatch>
        <skos:exactMatch>OMIM:608220</skos:exactMatch>
        <skos:exactMatch>UMLS:C2936860</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_101005"/>

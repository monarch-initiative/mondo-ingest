    <!-- http://www.orpha.net/ORDO/Orphanet_1878 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1878">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102015"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207107"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

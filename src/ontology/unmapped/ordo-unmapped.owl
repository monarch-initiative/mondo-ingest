    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2386 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2386">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_308041"/>

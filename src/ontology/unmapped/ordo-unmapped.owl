            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurodevelopmental disorder characterized by early-onset drug-resistant seizures and severe neurodevelopmental impairment with major motor development delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDD</oboInOwl:hasExactSynonym>

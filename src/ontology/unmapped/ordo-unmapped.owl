    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_314684 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_314684">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_279911"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Primary bone lymphoma is a rare lymphoid hemopathy defined as single or multiple tumors in the bone, not associated with infringement or violation of other extranodal malignant lymph nodes outside the area. It usually presents with bone pain, nerve compression, a palpable mass or fracture, while systemic features (fever, night sweats, fatigue, loss of appetite, weight loss) are not common.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Primary bone lymphoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary bone lymphoma</rdfs:label>
        <skos:broadMatch>ICD-10:C85.7</skos:broadMatch>
        <skos:exactMatch>MONDO:0017814</skos:exactMatch>
        <skos:exactMatch>UMLS:C1332582</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_314684"/>

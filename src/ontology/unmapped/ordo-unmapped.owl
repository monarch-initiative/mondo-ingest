        <owl:annotatedTarget>Orofaciodigital syndrome type 5</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_292 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_292">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_232035"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">An infectious embryofetopathy including coxsackie viruses and ECHO viruses that have been reported to cause spontaneous abortion, stillbirth, acute systemic illness in the newborn, and possibly fetal malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Antenatal enterovirus infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital enterovirus infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mother-to-child transmission of enterovirus infection</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital enterovirus infection</rdfs:label>
        <skos:broadMatch>ICD-10:P35.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:KA62.5</skos:exactMatch>
        <skos:exactMatch>MONDO:0017375</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274223</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

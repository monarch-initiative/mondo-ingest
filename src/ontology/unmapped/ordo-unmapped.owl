    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_559 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_559">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207028"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522548"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98098"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98574"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/24624"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive disorder characterized by cerebellar ataxia, early-onset bilateral cataracts, chronic myopathy; additional features are delayed motor development and variable intellectual disability, hypergonadotrophic hypogonadism and delayed puberty, and short stature.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Marinesco-Sjögren syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Marinesco-Sjögren syndrome</rdfs:label>

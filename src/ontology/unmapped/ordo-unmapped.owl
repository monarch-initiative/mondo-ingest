    <!-- http://www.orpha.net/ORDO/Orphanet_1708 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1708">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98131"/>
        <obo:IAO_0000115 xml:lang="en">Mosaic trisomy 16 is a rare chromosomal anomaly syndrome with a highly variable phenotype ranging from minor anomalies with normal development to intrauterine growth retardation, abnormal skin pigmentation, craniofacial and body asymmetry, cardiac (e.g. ventricular septal defect) and genital (e.g. hypospadias, cryptorchidism) anomalies, scoliosis and hearing loss to neonatal death. Additional features observed include skeletal malformations (e.g. clino/polydactyly, talipes), mild facial dysmorphism, and developmental delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mosaic trisomy 16 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mosaic trisomy chromosome 16</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 16 mosaicism</oboInOwl:hasExactSynonym>
        <rdfs:label>Mosaic trisomy 16 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD40.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015729</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707009</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

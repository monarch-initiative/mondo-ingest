        <owl:annotatedTarget>Dent disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1653 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1653">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_167759"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Dentin dysplasia (DD) is a rare disorder belonging to the group of hereditary dentin defects and is characterized by abnormal dentin structure and root development resulting in abnormal tooth development. It encompasses two subtypes: DD type I and DD type II.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dentin dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Dentin dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:K00.5</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA30.7</skos:exactMatch>
        <skos:exactMatch>MONDO:0015613</skos:exactMatch>
        <skos:exactMatch>MeSH:D003805</skos:exactMatch>
        <skos:exactMatch>UMLS:C0011430</skos:exactMatch>
        <skos:narrowMatch>OMIM:125400</skos:narrowMatch>
        <skos:narrowMatch>OMIM:125420</skos:narrowMatch>
    </owl:Class>

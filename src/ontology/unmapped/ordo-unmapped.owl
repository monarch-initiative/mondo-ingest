    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_139536 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139536">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140465"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15832"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25786"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4162"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant distal hereditary motor neuropathy disease characterized by muscle weakness and wasting predominantly affecting the hands, in particular the thenar and first dorsal interosseus muscles, and/or marked foot deformity and gait disturbance. Sensation is normal, although reduced response to vibration has been described. The disease is slowly progressive with an age of onset within the first few decades of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal HMN V</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Distal hereditary motor neuropathy type 5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal hereditary motor neuropathy type V</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal spinal muscular atrophy type 5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">dHMN5</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal hereditary motor neuropathy type 5</rdfs:label>
        <skos:broadMatch>ICD-10:G12.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B61.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0100350</skos:exactMatch>
        <skos:exactMatch>MeSH:C563443</skos:exactMatch>
        <skos:exactMatch>UMLS:C1833308</skos:exactMatch>
        <skos:narrowMatch>OMIM:600794</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614751</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619112</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_139536"/>

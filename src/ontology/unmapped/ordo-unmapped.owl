        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare arrhythmogenic right ventricular cardiomyopathy (ARVC) and a cutaneous phenotype, characterized by peculiar woolly hair and palmoplantar keratoderma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">KWWH type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratoderma with woolly hair type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratosis palmoplantaris with arrythmogenic cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Naxos disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Naxos syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Palmoplantar hyperkeratosis with arrythmogenic cardiomyopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Palmoplantar keratoderma with arrythmogenic cardiomyopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Naxos disease</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_99067 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99067">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1329"/>

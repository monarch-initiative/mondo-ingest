    <!-- http://www.orpha.net/ORDO/Orphanet_96101 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96101">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262905"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Distal trisomy 9q is a rare chromosomal anomaly, resulting from the partial trisomy of the long arm of chromosome 9, with a variable phenotype mostly characterized by psychomotor and speech delay, intellectual disability, hypotonia, long narrow habitus, craniofacial dysmorphism (incl. micro/dolichocephaly, facial asymmetry, narrow palpebral fissures, deep-set eyes, strabismus, microphthalmia, abnormally shaped ears, microstomia, micro/retrognathia) and hand and feet anomalies (incl. arachnodactyly, camptodactyly, abnormal implantation of digits). Congenital flexion contractures and limited joint movements have also been observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal duplication 9q syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal trisomy 9q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Telomeric duplication 9q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 9qter</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal duplication 9q syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD41.80</skos:broadMatch>
        <skos:exactMatch>MONDO:0019883</skos:exactMatch>
        <skos:exactMatch>UMLS:C4706939</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96101"/>

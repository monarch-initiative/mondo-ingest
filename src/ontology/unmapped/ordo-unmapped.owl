    <!-- http://www.orpha.net/ORDO/Orphanet_329802 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329802">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262725"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare partial autosomal trisomy/tetrasomy characterized by global developmental delay, intellectual disability, autistic behavior, muscular hypotonia, macrocephaly and facial dysmorphism (frontal bossing, short palpebral fissures, low set, dysplastic ears, short or shallow philtrum, high arched or narrow palate, micrognathia). Other associated clinical features include sleep disturbances, seizures, aplasia/hypoplasia of the corpus callosum, skeletal abnormalities (large hands and feet, long fingers and toes, talipes).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>5p13 microduplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dup(5)(p13)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 5p13</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dup(5)(p13)</oboInOwl:hasExactSynonym>
        <rdfs:label>5p13 microduplication syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0013169</skos:exactMatch>
        <skos:exactMatch>OMIM:613174</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749507</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_329802"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>5p13 microduplication syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    <owl:Axiom>

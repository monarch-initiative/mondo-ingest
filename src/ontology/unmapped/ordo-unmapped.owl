        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98027"/>
        <obo:IAO_0000115 xml:lang="en">A rare epidermolysis bullosa simplex characterized by the association of the typical trauma-induced blisters with additional features including hearing impairment, alopecia, hypo- or anodontia, and nail dystrophy. Occurrence of vitiliginous skin areas unrelated to the sites of the blisters has also been described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EBS with anodontia/hypodontia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Epidermolysis bullosa simplex with anodontia/hypodontia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Kallin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Epidermolysis bullosa simplex with anodontia/hypodontia</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC30</skos:broadMatch>
        <skos:exactMatch>MONDO:0016514</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432313</skos:exactMatch>
    </owl:Class>

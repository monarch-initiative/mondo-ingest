            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Classic maple syrup urine disease (classic MSUD) is the most severe and probably common form of MSUD characterized by a maple syrup odor in the cerumen at birth, poor feeding, lethargy and focal dystonia, followed by progressive encephalopathy and central respiratory failure if untreated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic BCKD deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic MSUD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic branched-chain alpha-ketoacid dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic branched-chain ketoaciduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Classic maple syrup urine disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Classic maple syrup urine disease</rdfs:label>
        <skos:broadMatch>ICD-10:E71.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.D0</skos:broadMatch>

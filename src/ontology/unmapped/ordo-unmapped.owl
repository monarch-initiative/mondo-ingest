    <!-- http://www.orpha.net/ORDO/Orphanet_35664 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_35664">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2962"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9722"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neurometabolic disease characterized by prenatal and postnatal growth retardation, hypotonia, failure to thrive, large and late-closing fontanel, development delay, cutis laxa, joint laxity, progeroid appearance, and dysmorphic facial features. In addition, corneal opacities, cataracts, myopia, seizures, hyperreflexia and athetoid movements have also been associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ALDH18A1-related De Barsy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Delta-1-pyrroline 5-carboxylate synthetase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurocutaneous syndrome, Bicknell type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">P5CS deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>ALDH18A1-related De Barsy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009053</skos:exactMatch>
        <skos:exactMatch>OMIM:219150</skos:exactMatch>
        <skos:exactMatch>UMLS:C5234852</skos:exactMatch>
    </owl:Class>

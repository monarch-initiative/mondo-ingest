    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_397941 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_397941">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309347"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371047"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6823"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">MAN1B1-CDG is a form of congenital disorders of N-linked glycosylation characterized by intellectual disability, delayed motor development, hypotonia and truncal obesity. Additional features include slight facial dysmorphism (hypertelorism, downslanting palpebral fissures, large, low-set ears, hypoplastic nasolabial fold, thin upper lip), hypermobility of the joints and skin laxity. The disease is caused by mutations in the gene &lt;i&gt;MAN1B1&lt;/i&gt; (9q34.3).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Carbohydrate deficient glycoprotein syndrome type II due to MAN1B1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 2 due to MAN1B1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type II due to MAN1B1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intellectual disability-truncal obesity syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MAN1B1-CDG</oboInOwl:hasExactSynonym>
        <rdfs:label>MAN1B1-CDG</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C54.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0018349</skos:exactMatch>
        <skos:exactMatch>OMIM:614202</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518783</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_397941"/>

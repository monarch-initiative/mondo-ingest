            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An axonal Charcot-Marie-Tooth (CMT) peripheral sensorimotor polyneuropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant Charcot-Marie-Tooth disease type 2K</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CMT2K</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant Charcot-Marie-Tooth disease type 2K</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C20.1</skos:broadMatch>

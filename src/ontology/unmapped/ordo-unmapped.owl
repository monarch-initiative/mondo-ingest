    <!-- http://www.orpha.net/ORDO/Orphanet_95429 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95429">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183478"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_211247"/>

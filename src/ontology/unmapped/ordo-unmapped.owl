        <skos:broadMatch>ICD-10:E88.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5D0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008846</skos:exactMatch>
        <skos:exactMatch>MeSH:C538259</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083911</skos:exactMatch>
        <skos:exactMatch>OMIM:209300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0521802</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1195"/>

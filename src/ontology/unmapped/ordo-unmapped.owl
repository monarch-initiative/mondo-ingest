            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare punctate palmoplantar keratoderma characterized by multiple small, round to oval or rhomboid, yellowish, hyperkeratotic papules and plaques most commonly localized to the palms of the hands and soles of the feet, potentially extending to the dorsum of the hands and feet in severe cases. Histopathological analysis shows hyperkeratosis, epidermal hypertrophy, and fragmentation and rarefaction of elastic fibers. The condition can be sporadic or familial.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AKE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acrokeratoelastoidosis of Costa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PPKP3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Punctate palmoplantar hyperkeratosis type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Punctate palmoplantar keratoderma type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Acrokeratoelastoidosis of Costa</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC20.32</skos:broadMatch>
        <skos:exactMatch>MONDO:0007047</skos:exactMatch>

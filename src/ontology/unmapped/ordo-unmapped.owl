        <skos:broadMatch>ICD-11:GB83</skos:broadMatch>
        <skos:exactMatch>MONDO:0017044</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518090</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2666"/>

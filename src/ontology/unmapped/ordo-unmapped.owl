        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_656071"/>
        <obo:IAO_0000115 xml:lang="en">Malignant atrophic papulosis (MAP) is a rare, chronic, thrombo-obliterative vasculopathy characterized by papular skin lesions with central porcelain-white atrophy and a surrounding teleangiectatic rim. Systemic lesions may affect the gastrointestinal tract and the central nervous system (CNS) and are potentially lethal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutaneo-muco-intestinal syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MAP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Malignant atrophic papulosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Papulosis atrophicans maligna</oboInOwl:hasExactSynonym>
        <rdfs:label>Malignant atrophic papulosis</rdfs:label>
        <skos:broadMatch>ICD-10:I77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EF5Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011208</skos:exactMatch>
        <skos:exactMatch>MeSH:D054853</skos:exactMatch>
        <skos:exactMatch>MedDRA:10064281</skos:exactMatch>
        <skos:exactMatch>OMIM:602248</skos:exactMatch>
        <skos:exactMatch>UMLS:C0221011</skos:exactMatch>
    </owl:Class>

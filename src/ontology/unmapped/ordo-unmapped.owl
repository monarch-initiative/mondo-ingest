            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Chédiak-Higashi syndrome (CHS) is a rare severe genetic disorder generally characterized by partial oculocutaneous albinism (OCA), severe immunodeficiency, mild bleeding, neurological dysfunction and lymphoproliferative disorder. A classic, early-onset form and an attenuated, later-onset form (Atypical CHS) have been described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Chédiak-Higashi disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chédiak-Higashi syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chédiak-Higashi-Steinbrink syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Chédiak-Higashi syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E70.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC23.20</skos:broadMatch>
        <skos:exactMatch>MONDO:0008963</skos:exactMatch>
        <skos:exactMatch>MeSH:D002609</skos:exactMatch>
        <skos:exactMatch>MedDRA:10008415</skos:exactMatch>
        <skos:exactMatch>OMIM:214500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0007965</skos:exactMatch>
    </owl:Class>

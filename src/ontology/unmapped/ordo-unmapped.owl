            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4284"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, syndromic genetic deafness disease characterized by symmetric or asymmetric knuckle pads (typically located on the distal and interphalangeal joints), leukonychia, diffuse palmoplantar keratoderma, and congenital, mild to moderate sensorineural deafness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bart-Pumphrey syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Knuckle pads-leukonychia-sensorineural deafness-palmoplantar hyperkeratosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Knuckle pads-leukonychia-sensorineural deafness-palmoplantar keratoderma syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Knuckle pads-leukonychia-sensorineural hearing loss-palmoplantar hyperkeratosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Knuckle pads-leukonychia-sensorineural hearing loss-palmoplantar keratoderma syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Knuckle pads-leukonychia-sensorineural deafness-palmoplantar hyperkeratosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007866</skos:exactMatch>
        <skos:exactMatch>MeSH:C537210</skos:exactMatch>
        <skos:exactMatch>OMIM:149200</skos:exactMatch>
        <skos:exactMatch>UMLS:C0266004</skos:exactMatch>
    </owl:Class>

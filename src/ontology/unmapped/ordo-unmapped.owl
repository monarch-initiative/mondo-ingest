        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare non-syndromic urogenital tract malformation characterized by improper development of the vas deferens leading to male infertility.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CBAVD</oboInOwl:hasExactSynonym>

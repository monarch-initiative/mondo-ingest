    <!-- http://www.orpha.net/ORDO/Orphanet_85281 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85281">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C052"/>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Lubs-Arena syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: X-linked intellectual disability, Lubs type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: X-linked intellectual disability-hypotonia-recurrent Infections syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>OBSOLETE: MECP2 duplication syndrome</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_85282 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85282">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225700"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225703"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_240371"/>

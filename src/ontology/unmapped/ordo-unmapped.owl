        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2970 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2970">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_435365"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1952"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare lower urinary tract obstruction (LUTO) characterized by varying degrees of an enlarged urinary bladder, dilated ureters, hydronephrosis, and poorly contractile and disorganized detrusor and ureteral smooth muscle, in association with hypoplastic or absent midline abdominal skeletal musculature, and bilaterally undescended testes in males.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Abdominal muscle deficiency syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Eagle-Barret syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Obrinsky syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Prune belly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Triad syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Prune belly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q79.4</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD2F.10</skos:exactMatch>
        <skos:exactMatch>MONDO:0007032</skos:exactMatch>
        <skos:exactMatch>MeSH:D011535</skos:exactMatch>
        <skos:exactMatch>MedDRA:10051025</skos:exactMatch>
        <skos:exactMatch>OMIM:100100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0033770</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

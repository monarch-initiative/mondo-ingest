    <!-- http://www.orpha.net/ORDO/Orphanet_79456 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79456">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

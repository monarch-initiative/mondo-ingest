    <!-- http://www.orpha.net/ORDO/Orphanet_252164 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_252164">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_252131"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare benign peripheral nerve sheath tumor characterized by a usually encapsulated space-occupying lesion composed of differentiated neoplastic Schwann cells. It most commonly arises from peripheral nerves in the head and neck region and extensor aspects of the extremities, but also from spinal and cranial nerves, especially the vestibular nerve. The tumor may be asymptomatic or cause symptoms related to a mass effect. It grows slowly and only rarely undergoes malignant transformation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Benign schwannoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurilemmoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurilemoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Peripheral fibroblastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Benign schwannoma</rdfs:label>
        <skos:broadMatch>ICD-10:D36.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F3Y</skos:broadMatch>
        <skos:exactMatch>MeSH:D009442</skos:exactMatch>
        <skos:exactMatch>MedDRA:10029235</skos:exactMatch>
        <skos:exactMatch>UMLS:C0027809</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_252164"/>

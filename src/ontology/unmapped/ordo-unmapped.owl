        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Isolated arhinencephaly is a rare non-syndromic central nervous system malformation defined by the agenesis of the olfactory bulbs and tracts and characterized by complete congenital anosmia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated arhinencephaly</oboInOwl:hasExactSynonym>

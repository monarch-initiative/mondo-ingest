                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spondyloepiphyseal dysplasia, Maroteaux type is a very rare type of spondyloepiphyseal dysplasia described in fewer than 10 patients to date and characterized clinically by dysplastic epiphyses, short stature appearing in infancy, short neck, short and stubby hands and feet, scoliosis, genu valgum, abnormal pelvis, osteoporosis and osteoarthritis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Pseudo-Morquio syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pseudo-Morquio type II syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SEMD, Maroteaux type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SEMD-M</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spondyloepimetaphyseal dysplasia, Maroteaux type</oboInOwl:hasExactSynonym>
        <rdfs:label>Spondyloepimetaphyseal dysplasia, Maroteaux type</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>

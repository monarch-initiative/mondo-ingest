        <owl:annotatedTarget>Hearing loss-familial salivary gland insensitivity to aldosterone syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

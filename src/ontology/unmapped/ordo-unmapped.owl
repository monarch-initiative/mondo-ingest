    <!-- http://www.orpha.net/ORDO/Orphanet_96201 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96201">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399853"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_400022"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_485382"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95710"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98159"/>
        <obo:IAO_0000115 xml:lang="en">X small rings is a rare chromosome X structural anomaly, with highly variable phenotype, principally characterized by developmental delay, intellectual disability, short stature, craniofacial dysmorphism (incl. microcephaly, facial asymmetry, hypertelorism, long palpebral fissures, epicanthus, low-set or malrotated ears, broad nose with a flat nasal bridge, anteverted nares, long philtrum, thin upper lip, high arched palate, micrognathia) and skeletal anomalies (e.g. cubitus valgus, talipes equinovarus). Patients may also present heart malformations (e.g. ventricular septal defects, mitral valve stenosis), sacral dimple, soft tissue syndactyly, pigmented nevi, and seizures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X small rings syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>X small rings syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD51</skos:broadMatch>
        <skos:exactMatch>MONDO:0019926</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707824</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96201"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>X small rings syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



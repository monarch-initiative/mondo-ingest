        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal recessive retinal disorder characterized by color blindness, nystagmus, photophobia, and severely reduced visual acuity due to the absence or impairment of cone function.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ACHM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Achromatopsia</oboInOwl:hasExactSynonym>

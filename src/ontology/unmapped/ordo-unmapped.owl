    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_37553 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_37553">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101934"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206976"/>

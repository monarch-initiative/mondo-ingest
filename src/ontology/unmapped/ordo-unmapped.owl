    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96152">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C052"/>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Distal deletion 20q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Monosomy 20qter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Telomeric deletion 20q</oboInOwl:hasExactSynonym>
        <rdfs:label>OBSOLETE: Distal monosomy 20q</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>

    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2213 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2213">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139036"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139039"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183576"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Hypertelorism-microtia-facial clefting syndrome, or HMC syndrome, is a very rare syndrome characterized by the combination of hypertelorism, cleft lip and palate and microtia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bixler-Christian-Gorlin syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HMC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypertelorism-microtia-facial clefting syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypertelorism-microtia-facial clefting syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0009404</skos:exactMatch>
        <skos:exactMatch>MeSH:C537632</skos:exactMatch>
        <skos:exactMatch>OMIM:239800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0220742</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hypertelorism-microtia-facial clefting syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2215 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2215">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1037"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156237"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_466658"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_728642"/>
        <obo:IAO_0000115 xml:lang="en">An extremely rare arthrogryposis syndrome, described in only two pairs of siblings from two unrelated families to date, and characterized by the association of arthrogryposis, congenital torticollis, dysmorphic facial features (i.e. asymmetry of the face, myopathic facial movements, ptosis, posteriorly rotated ears, cleft palate), progressive scoliosis and episodes of malignant hyperthermia. There have been no further descriptions in the literature since 1988.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Froster-Iskenius-Waterson-Hall syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Malignant hyperthermia-arthrogryposis-torticollis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple pterygium-malignant hyperthermia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple pterygium-malignant hyperthermia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G71.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009012</skos:exactMatch>
        <skos:exactMatch>OMIM:217150</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304748</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2215"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Multiple pterygium-malignant hyperthermia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2216 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2216">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_138059"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251535"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare maternal disease-related embryofetopathy characterized by variable developmental anomalies of the fetus due to teratogenic effect of elevated maternal body temperature (resulting from febrile illness or hot environment exposure). Reported developmental anomalies include neural tube defects (spina bifida, ecephalocele, anencephaly), cardiac defects (transposition of great vessels), urogenital defects (hypospadias), abdominal wall defects, cleft lip/palate, eye defects (cataract, coloboma) or various minor anomalies (e.g., bifid uvula, preauricular pit or tag). Consensus regarding cause-effect relationship has not been reached.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Maternal hyperthermia-induced birth defects</oboInOwl:hasExactSynonym>
        <rdfs:label>Maternal hyperthermia-induced birth defects</rdfs:label>
        <skos:broadMatch>ICD-10:Q86.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016378</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707329</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2216"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Maternal hyperthermia-induced birth defects</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2218 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2218">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269546"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269570"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79365"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic syndrome characterized by the association of congenital hypertrichosis in the anterior cervical region with peripheral sensory and motor neuropathy. Associated features may include retinal anomalies, spina bifida, kyphoscoliosis and hallux valgus, and developmental delay (one case). There have been no further descriptions in the literature since 1993.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cervical hypertrichosis-peripheral neuropathy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cervical hypertrichosis-peripheral neuropathy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G60.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0009405</skos:exactMatch>
        <skos:exactMatch>OMIM:239840</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303793</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2218"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Cervical hypertrichosis-peripheral neuropathy syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_222 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_222">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90077"/>
        <obo:IAO_0000115 xml:lang="en">Erosive pustular dermatosis of the scalp is a rare chronic inflammation of the scalp usually occurring in elderly women (&gt;70 years old) and characterized by the development of painful pustules, shallow erosions, and crusting on atrophic skin that eventually result in cicatricial alopecia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Erosive pustular dermatosis of the scalp</oboInOwl:hasExactSynonym>
        <rdfs:label>Erosive pustular dermatosis of the scalp</rdfs:label>
        <skos:broadMatch>ICD-10:L98.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:EG30.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0016379</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406464</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_222"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Erosive pustular dermatosis of the scalp</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2220 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2220">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79365"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <obo:IAO_0000115 xml:lang="en">Hypertrichosis cubiti is a rare hair anomaly characterized by symmetrical, congenital or early-onset, bilateral hypertrychosis localized on the externsor surfaces of the upper extremities (especially the elbows). Short stature, or other abnormalities, such as developmental delay, facial anomalies and intellectual disability, may or may not be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hairy elbows syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypertrichosis cubiti</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MacDermot-Patton-Williams syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypertrichosis cubiti</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MeSH:C535618</skos:exactMatch>
        <skos:exactMatch>MedDRA:10068636</skos:exactMatch>
        <skos:exactMatch>OMIM:139600</skos:exactMatch>
        <skos:exactMatch>UMLS:C1841696</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2220"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hypertrichosis cubiti</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2221 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2221">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79365"/>
        <obo:IAO_0000115 xml:lang="en">A rare cutaneous paraneoplastic disease characterized by the presence of excessive lanugo-type hair on the glabrous skin of face, neck, trunk and limbs that can be associated with additional clinical features such as burning glossitis, papillary hypertrophy of the tongue, diarrhea, dysgeusia, and/or weight loss. It is associated with lymphoma or cancer of the gastrointestinal system, urinary tract, lung, breast, uterus or ovary.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Acquired hypertrichosis lanuginosa</oboInOwl:hasExactSynonym>
        <rdfs:label>Acquired hypertrichosis lanuginosa</rdfs:label>
        <skos:broadMatch>ICD-11:EL10</skos:broadMatch>
        <skos:exactMatch>ICD-10:L68.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0016380</skos:exactMatch>
        <skos:exactMatch>UMLS:C0343072</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2221"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Acquired hypertrichosis lanuginosa</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2222 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2222">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79365"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <obo:IAO_0000115 xml:lang="en">Hypertrichosis lanuginosa congenita is a rare congenital skin disease characterized by the presence of 3 to 5cm long lanugo-type hair on the entire body, with the exception of palms, soles, and mucous membranes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hypertrichosis lanuginosa congenita</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypertrichosis universalis</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypertrichosis lanuginosa congenita</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016381</skos:exactMatch>
        <skos:exactMatch>MeSH:C538389</skos:exactMatch>
        <skos:exactMatch>UMLS:C0235864</skos:exactMatch>
        <skos:narrowMatch>OMIM:145700</skos:narrowMatch>
        <skos:narrowMatch>OMIM:145701</skos:narrowMatch>
        <skos:narrowMatch>OMIM:307150</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2222"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hypertrichosis lanuginosa congenita</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2224 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2224">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_289829"/>

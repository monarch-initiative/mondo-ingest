    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_79322 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79322">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309526"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371071"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of multiple glycosylation pathways characterized by global developmental delay, motor skills delay, hypotonia, seizures, microcephaly and eye abnormalities (including retinopathy, nystagmus, strabismus) with varying onset and severity. Additional clinical features may include peripheral neuropathy, dysmorphic features (facial and limb abnormalities), ataxia and severe gastrointestinal involvement.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type Ie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG-Ie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG1E</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Carbohydrate deficient glycoprotein syndrome type Ie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 1e</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type Ie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>DPM1-CDG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dol-P-mannosyltransferase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>DPM1-CDG</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C54.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0012123</skos:exactMatch>
        <skos:exactMatch>MeSH:C535743</skos:exactMatch>
        <skos:exactMatch>OMIM:608799</skos:exactMatch>
        <skos:exactMatch>UMLS:C1837396</skos:exactMatch>
    </owl:Class>

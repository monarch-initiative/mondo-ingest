        <oboInOwl:hasExactSynonym xml:lang="en">Oculodentodigitalis dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oculodentoosseous dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osseous-oculo-dental dysplasia</oboInOwl:hasExactSynonym>

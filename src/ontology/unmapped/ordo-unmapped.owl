    <!-- http://www.orpha.net/ORDO/Orphanet_324381 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_324381">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206662"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Hereditary inclusion body myopathy type 4 is a rare non-dystrophic myopathy characterized by slowly progressive muscular weakness and atrophy initially involving proximal lower limbs and hip girdle and later on shoulder girdle, proximal upper limbs and axial muscles. Ambulation is usually preserved. Congophilic inclusions with cytoplasmic inclusions of 15-21 nm filaments on electron microscopy are revealed in muscle biopsy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HIBM4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary inclusion body myopathy type 4</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary inclusion body myopathy type 4</rdfs:label>
        <skos:broadMatch>ICD-10:G71.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0017931</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749501</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_324381"/>

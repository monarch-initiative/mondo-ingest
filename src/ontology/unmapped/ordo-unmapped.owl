        <oboInOwl:hasExactSynonym xml:lang="en">HEXA disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tay-Sachs disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Tay-Sachs disease</rdfs:label>
        <skos:broadMatch>ICD-10:E75.0</skos:broadMatch>

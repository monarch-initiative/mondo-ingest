                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7788"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multisystemic genetic disorder characterized by a characteristic facial features with macrocephaly, overgrowth in infancy, intellectual disability and behavioral problems including anxieties and aggressiveness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Malan overgrowth syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sotos syndrome 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Malan overgrowth syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2C</skos:broadMatch>
        <skos:exactMatch>MONDO:0013885</skos:exactMatch>
        <skos:exactMatch>OMIM:614753</skos:exactMatch>
        <skos:exactMatch>UMLS:C3553660</skos:exactMatch>
    </owl:Class>

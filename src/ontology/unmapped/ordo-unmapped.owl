    <!-- http://www.orpha.net/ORDO/Orphanet_240371 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_240371">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139024"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_294016 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_294016">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269528"/>

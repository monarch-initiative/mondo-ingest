        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/26267"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Limb-girdle muscular dystrophy due to POMK deficiency is a form of limb-girdle muscular dystrophy presenting in infancy with muscle weakness and delayed motor development (eventually learning to walk at 18 months of age) followed by progressive proximal weakness, pseudohypertrophy of calf muscles, mild facial weakness, and borderline intelligence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LGMD due to POMK deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Limb-girdle muscular dystrophy due to POMK deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Limb-girdle muscular dystrophy due to POMK deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:G71.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C70.41</skos:broadMatch>
        <skos:exactMatch>MONDO:0014489</skos:exactMatch>
        <skos:exactMatch>OMIM:616094</skos:exactMatch>
        <skos:exactMatch>UMLS:C4015184</skos:exactMatch>
    </owl:Class>

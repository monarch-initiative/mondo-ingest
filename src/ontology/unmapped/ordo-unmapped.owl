    <!-- http://www.orpha.net/ORDO/Orphanet_306516 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_306516">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183592"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309848"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93603"/>
        <obo:IAO_0000115 xml:lang="en">Familial primary hypomagnesemia with hypercalciuria and nephrocalcinosis (FHHNC) is a form of familial primary hypomagnesemia (FPH), characterized by renal magnesium (Mg) and calcium (Ca) wasting, nephrocalcinosis, kidney failure and, in some cases, severe ocular impairment. Two subtypes of FHHNC are described: FHHNC with severe ocular involvement (FHHNCOI) and without severe ocular involvement (FHHN).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FHHNC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial primary hypomagnesemia with hypercalciuria and nephrocalcinosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Michellis-Castrillo syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary hypomagnesemia with hypercalciuria and nephrocalcinosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary hypomagnesemia with hypercalciuria and nephrocalcinosis</rdfs:label>
        <skos:broadMatch>ICD-10:E83.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.41</skos:broadMatch>
        <skos:exactMatch>MONDO:0017624</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679977</skos:exactMatch>
    </owl:Class>

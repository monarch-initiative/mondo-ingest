        <obo:IAO_0000115 xml:lang="en">Immune hydrops fetalis (IHF), a form of HF, describes the excessive accumulation of fetal fluid within the fetal extravascular compartments and body cavities due to maternal rhesus (Rh) incompatibility.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">IHF</oboInOwl:hasExactSynonym>

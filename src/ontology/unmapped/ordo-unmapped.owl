            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome characterized by hypokalemic metabolic alkalosis in combination with significant hypomagnesemia and low urinary calcium excretion.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Gitelman syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Gitelman syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:N15.8</skos:broadMatch>

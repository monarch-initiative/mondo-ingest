    <!-- http://www.orpha.net/ORDO/Orphanet_95496 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_95496">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>

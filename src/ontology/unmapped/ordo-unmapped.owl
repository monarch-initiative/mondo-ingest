        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A primary immunodeficiency disease characterized by microthrombocytopenia, eczema, infections and an increased risk for autoimmune manifestations and malignancies.</obo:IAO_0000115>

    <!-- http://www.orpha.net/ORDO/Orphanet_88949 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_88949">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156162"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_34149"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant tubulointerstitial kidney (ADTKD) disease due to &lt;i&gt;MUC1&lt;/i&gt; mutations characterized clinically by a bland urinalysis (absence of blood or protein in the urine), and chronic kidney disease leading to end-stage kidney disease (ESKD) between 20 and 80 years.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ADTKD-MUC1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MCKD1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MUC1-related autosomal dominant tubulointerstitial kidney disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MUC1-related medullary cystic kidney disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MUCI-related ADTKD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Medullary cystic kidney disease type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>MUC1-related autosomal dominant tubulointerstitial kidney disease</rdfs:label>
        <skos:broadMatch>ICD-10:Q61.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB82</skos:broadMatch>
        <skos:exactMatch>MONDO:0020726</skos:exactMatch>
        <skos:exactMatch>MeSH:C536137</skos:exactMatch>
        <skos:exactMatch>OMIM:174000</skos:exactMatch>
        <skos:exactMatch>UMLS:C1868139</skos:exactMatch>
    </owl:Class>

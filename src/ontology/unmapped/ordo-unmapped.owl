    <!-- http://www.orpha.net/ORDO/Orphanet_1798 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1798">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93444"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia with increased bone density characterized by craniofacial dysostosis with a small cranium and thin skull bone, depressions over the frontoparietal and occipitoparietal sutures, marked hypoplasia of mandible, exophthalmos, cortical sclerosis of the long bones and normal intelligence. The long bones are short and bent, and thickening of bone cortex occurs during the pubertal and post-pubertal periods and increases with age. There have been no further descriptions in the literature since 1995.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant osteosclerosis, Stanescu type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Craniofacial dysostosis-diaphyseal hyperplasia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dysostosis, Stanescu type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stanescu osteosclerosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Craniofacial dysostosis-diaphyseal hyperplasia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007396</skos:exactMatch>
        <skos:exactMatch>MeSH:C562974</skos:exactMatch>
        <skos:exactMatch>OMIM:122900</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432263</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1798"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Craniofacial dysostosis-diaphyseal hyperplasia syndrome</owl:annotatedTarget>

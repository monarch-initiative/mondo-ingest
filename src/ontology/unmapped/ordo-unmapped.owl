        <oboInOwl:hasExactSynonym xml:lang="en">Pulmonary arterial hypertension-leukopenia-atrial septal defect syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Dursun syndrome</rdfs:label>

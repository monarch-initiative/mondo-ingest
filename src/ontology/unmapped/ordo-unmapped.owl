            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by hamartomatous intestinal polyposis, lipomas, macrocephaly and genital lentiginosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BRRS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bannayan-Riley-Ruvalcaba syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myhre-Riley-Smith syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Bannayan-Riley-Ruvalcaba syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2D.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:158350</skos:broadMatch>
        <skos:exactMatch>MONDO:0007924</skos:exactMatch>
        <skos:exactMatch>MedDRA:10080314</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265326</skos:exactMatch>

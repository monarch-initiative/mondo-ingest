        <owl:annotatedTarget>Hardikar syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1416 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1416">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182231"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271870"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant skeletal disorder, characterized by progressive bone resorption in the distal phalanges (acro-osteolysis), progressive osteoporosis, distinct craniofacial changes, dental anomalies, and occasional association with renal abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acroosteolysis dominant type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Acroosteolysis with osteoporosis and changes in skull and mandible</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Arthrodentoosteodysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cheney syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hajdu-Cheney syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hajdu-Cheney syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:M89.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB86.2</skos:broadMatch>

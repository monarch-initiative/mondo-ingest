        <owl:annotatedTarget>Urachal cyst</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_488168 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_488168">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183426"/>

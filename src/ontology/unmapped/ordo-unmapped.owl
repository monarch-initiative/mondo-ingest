        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294955"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404574"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11602"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital anomalies syndrome characterized by a variable spectrum of ulnar defects, mammary and apocrine gland hypoplasia and genital anomalies. The most frequent signs include fifth finger and dental anomalies, delayed puberty and mammary hypoplasia. Short stature and obesity are common.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Pallister ulnar-mammary syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Schinzel syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">UMS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ulnar-mammary syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ulnar-mammary syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q71.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008411</skos:exactMatch>
        <skos:exactMatch>MeSH:C536937</skos:exactMatch>
        <skos:exactMatch>MedDRA:10084409</skos:exactMatch>
        <skos:exactMatch>OMIM:181450</skos:exactMatch>
        <skos:exactMatch>UMLS:C1866994</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3138"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_258 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_258">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207094"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

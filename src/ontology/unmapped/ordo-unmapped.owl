    <!-- http://www.orpha.net/ORDO/Orphanet_69028 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_69028">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_109009"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_364568"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404571"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404577"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare disorders characterized by brachydactyly due to abnormal development of the phalanges and/or metacarpals. Brachydactyly is part of a group of limb malformations characterized by dysostosis, involving abnormal development of individual bones, either in isolation or in combination with other skeletal abnormalities. These disorders primarily affect the skeleton, although extraskeletal manifestations may also occur.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dysostosis with brachydactyly</oboInOwl:hasExactSynonym>
        <rdfs:label>Dysostosis with brachydactyly</rdfs:label>
        <skos:exactMatch>MONDO:19066</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681270</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_69028"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Dysostosis with brachydactyly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_69061 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_69061">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_357502"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377792"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary glomerulopathy of unknown cause characterized by edema, nephrotic-range proteinuria and hypoalbuminemia that responds to standard prednisone treatment within 4-6 weeks.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Idiopathic steroid-sensitive nephrotic syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic steroid-sensitive nephrotic syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:N04.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB41</skos:broadMatch>
        <skos:broadMatch>OMIM:615861</skos:broadMatch>
        <skos:exactMatch>MONDO:0019067</skos:exactMatch>
        <skos:exactMatch>UMLS:C0403396</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_69061"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Idiopathic steroid-sensitive nephrotic syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_69063 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_69063">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_567562"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7154"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, congenital glomerular disease due to maternal anti-neutral endopeptidase (NEP) alloimmunization characterized by severe renal failure and nephrotic syndrome at birth, which rapidly improves in the first weeks of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Alloimmune neonatal renal disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital membranous nephropathy due to fetomaternal anti-neutral endopeptidase alloimmunization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FMAIG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fetomaternal alloimmunization with antenatal glomerulopathies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal glomerulopathy due to neprilysin alloimmunization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal membranous glomerulopathy with maternal NEP deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal membranous glomerulopathy with maternal neutral endopeptidase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital membranous nephropathy due to fetomaternal anti-neutral endopeptidase alloimmunization</rdfs:label>
        <skos:broadMatch>ICD-10:P96.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB41</skos:broadMatch>
        <skos:exactMatch>MONDO:0019068</skos:exactMatch>
        <skos:exactMatch>UMLS:C4511239</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_69063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital membranous nephropathy due to fetomaternal anti-neutral endopeptidase alloimmunization</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_69076 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_69076">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79178"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93593"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11037"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, glucose transport disorder characterized by the presence of persistent isolated glucosuria in the absence of both proximal tubular dysfunction and hyperglycemia. The disorder is benign in the majority of cases although it may occasionally manifest with polyuria, enuresis, a mild growth and pubertal maturation delay, hypercalciuria, aminoaciduria and, in severe cases, increased incidence of urinary infections and episodic dehydration and ketosis during pregnancy and starvation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial renal glucosuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial renal glycosuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SGLT2 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial renal glucosuria</rdfs:label>
        <skos:broadMatch>ICD-10:E74.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C61.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0009297</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073689</skos:exactMatch>
        <skos:exactMatch>OMIM:233100</skos:exactMatch>
        <skos:exactMatch>UMLS:C3245525</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_69076"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial renal glucosuria</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_69077 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_69077">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_3394"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Rhabdoid tumor (RT) is an aggressive pediatric soft tissue sarcoma that arises in the kidney, the liver, the peripheral nerves and all miscellaneous soft-parts throughout the body. RT involving the central nervous system (CNS) is called atypical teratoid rhabdoid tumor (ATRT).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Malignant rhabdoid tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rhabdoid tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Rhabdoid tumor</rdfs:label>
        <skos:broadMatch>ICD-10:C49.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:2B5K</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH3RF3</skos:exactMatch>
        <skos:exactMatch>MONDO:0002728</skos:exactMatch>
        <skos:exactMatch>MeSH:D018335</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073334</skos:exactMatch>
        <skos:exactMatch>UMLS:C0206743</skos:exactMatch>
        <skos:narrowMatch>OMIM:609322</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613325</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_69077"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Rhabdoid tumor</owl:annotatedTarget>

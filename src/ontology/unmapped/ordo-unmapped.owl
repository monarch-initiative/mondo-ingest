    <!-- http://www.orpha.net/ORDO/Orphanet_39 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_39">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

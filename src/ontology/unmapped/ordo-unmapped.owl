    <!-- http://www.orpha.net/ORDO/Orphanet_97355 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_97355">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306666"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_89043"/>
        <obo:IAO_0000115 xml:lang="en">Parkinsonism with dementia of Guadeloupe is characterised by symmetrical bradykinesia, predominantly axial rigidity, postural instability with early falls and cognitive decline with prominent features of frontal lobe dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Atypical parkinsonism in the Caribbean</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Caribbean parkinsonism</oboInOwl:hasExactSynonym>
        <rdfs:label>Caribbean parkinsonism</rdfs:label>
        <skos:broadMatch>ICD-10:F02.3*</skos:broadMatch>
        <skos:broadMatch>ICD-10:G20+</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A00.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019977</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275027</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_97355"/>

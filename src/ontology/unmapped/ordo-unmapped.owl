        <skos:broadMatch>ICD-11:2A90.B</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH05D8</skos:exactMatch>
        <skos:exactMatch>MONDO:0850112</skos:exactMatch>
        <skos:exactMatch>MONDO:850112</skos:exactMatch>
        <skos:exactMatch>MedDRA:10082495</skos:exactMatch>
        <skos:exactMatch>UMLS:C4528210</skos:exactMatch>
    </owl:Class>

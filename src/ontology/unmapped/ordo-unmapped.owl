        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3239 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3239">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A rare otorhinolaryngologic disease characterized by congenital deafness with profound sensorineural hearing loss, short stature, vitiligo, muscle wasting, and achalasia. There have been no further descriptions in the literature since 1971.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Deafness-vitiligo-achalasia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hearing loss-vitiligo-achalasia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Deafness-vitiligo-achalasia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009085</skos:exactMatch>
        <skos:exactMatch>OMIM:221350</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518568</skos:exactMatch>
    </owl:Class>

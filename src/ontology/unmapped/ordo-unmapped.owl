        <obo:IAO_0000115 xml:lang="en">Familial developmental dysphasia is a severe form of developmental verbal apraxia characterized by a deficit in spontaneous speech, writing, grammatical judgment and repetition, defective articulation, moderate to severe degree of dyspraxia, a reduced use of consonant clusters, and comprehension delay. Hearing and intelligence are normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Billard-Toutain-Maheut syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FOXP2-associated dysphasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial developmental dysphasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial developmental dysphasia</rdfs:label>
        <skos:broadMatch>ICD-10:F80.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0010821</skos:exactMatch>
        <skos:exactMatch>MeSH:C563997</skos:exactMatch>
        <skos:exactMatch>OMIM:600117</skos:exactMatch>
        <skos:exactMatch>UMLS:C1838630</skos:exactMatch>
    </owl:Class>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_424053 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_424053">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217074"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, epithelial tumor of the pancreas characterized, histologically, by columnar, mucin-producing epithelium associated with ovarian-type subepithelial stroma, which does not communicate with the pancreatic ductal system, most frequently localized to the body or tail of the pancreas. Clinically, small tumors (&lt;3 cm) are usually asymptomatic, while large tumors typically present obstructive jaundice, a palpable abdominal mass, and may associate portal hypertension, hemobilia and diabetes mellitus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mucinous cystadenocarcinoma of the pancreas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pancreatic mucinous cystadenocarcinoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Mucinous cystadenocarcinoma of the pancreas</rdfs:label>
        <skos:broadMatch>ICD-11:2C10.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0018523</skos:exactMatch>
        <skos:exactMatch>MONDO:18523</skos:exactMatch>
        <skos:exactMatch>UMLS:C2063873</skos:exactMatch>
        <skos:narrowMatch>ICD-10:C25.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C25.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C25.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C25.7</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C25.8</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_424053"/>

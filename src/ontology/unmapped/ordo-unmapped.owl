        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Multifocal motor neuropathy (MMN) is a rare acquired immune-mediatedneuropathy characterized clinically by a purely motor deficit with conduction block and asymmetric multifocal weakness, fasciculations, and cramping.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MMN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MMNCB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multifocal motor neuropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multifocal motor neuropathy with conduction block</oboInOwl:hasExactSynonym>
        <rdfs:label>Multifocal motor neuropathy</rdfs:label>
        <skos:broadMatch>ICD-10:G61.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C01.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0018979</skos:exactMatch>
        <skos:exactMatch>MedDRA:10065579</skos:exactMatch>
        <skos:exactMatch>UMLS:C0393847</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_294060 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_294060">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_109007"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_723416"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare genetic disorders characterized by the presence of joint contractures and multiple soft tissue webs (pterygia) across the neck and various joints, as well as typical facial appearance and a variety of other congenital anomalies. Both lethal (lethal and X-linked lethal multiple pterygium syndrome) and non-lethal (autosomal recessive and autosomal dominant multiple pterygium syndrome) forms occur.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Multiple pterygium syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple pterygium syndrome</rdfs:label>
        <skos:exactMatch>ICD-11:LD26.40</skos:exactMatch>
        <skos:exactMatch>MONDO:0017415</skos:exactMatch>
        <skos:exactMatch>MONDO:17415</skos:exactMatch>

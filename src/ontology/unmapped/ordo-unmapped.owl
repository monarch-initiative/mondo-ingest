    <!-- http://www.orpha.net/ORDO/Orphanet_263543 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_263543">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

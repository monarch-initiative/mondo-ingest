        <oboInOwl:hasExactSynonym xml:lang="en">Mild peroxisome biogenesis disorder-Zellweger spectrum disorder</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile Refsum disease</rdfs:label>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, syndromic intellectual disability characterized by severe intellectual disability, distinctive craniofacial features and variable multiple congenital anomalies including ocular, brain, urogenital and skeletal abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Oculocerebrofacial syndrome, Kaufman type</oboInOwl:hasExactSynonym>

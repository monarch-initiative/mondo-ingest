        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98655"/>
        <obo:IAO_0000115 xml:lang="en">A rare renal disease characterized by glomerular nephropathy with hematuria progressing to end-stage renal disease (ESRD), frequently associated with sensorineural deafness, and occasionally with ocular anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Alport deafness-nephropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Alport hearing loss-nephropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Alport syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Alport syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018965</skos:exactMatch>
        <skos:exactMatch>MeSH:D009394</skos:exactMatch>
        <skos:exactMatch>MedDRA:10001843</skos:exactMatch>
        <skos:exactMatch>UMLS:C1567741</skos:exactMatch>

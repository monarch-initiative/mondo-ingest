        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary neuromuscular disorder characterized by multiple cores on muscle biopsy and clinical features of a congenital myopathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MmD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiminicore disease</oboInOwl:hasExactSynonym>

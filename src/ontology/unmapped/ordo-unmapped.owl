        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98640"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, non-syndromic developmental defect of the eye disorder, with high clinical and genetic heterogeneity, most frequently characterized by bilateral, symmetrical, non-progressive cataracts which present at birth or in early-childhood. Additional ocular manifestations (e.g. anterior segment dysgenesis, colobomas, nystagmus, microcornea, microphthalmia, myopia) may be associated, however other organs/systems are usually not affected.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Early onset non-syndromic cataract</oboInOwl:hasExactSynonym>
        <rdfs:label>Early onset non-syndromic cataract</rdfs:label>
        <skos:broadMatch>OMIM:611597</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q12.0</skos:exactMatch>

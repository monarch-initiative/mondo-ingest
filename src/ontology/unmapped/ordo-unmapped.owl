                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30417"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic form of obesity characterized by severe early-onset obesity, hyperphagia, insulin resistance with hyperinsulinemia, reduced adult final height, delayed speech and language development and a tendency for social isolation and aggressive behavior.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Severe early-onset obesity-insulin resistance syndrome due to SH2B1 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe early-onset obesity-insulin resistance syndrome due to SH2B1 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E66.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5B81.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017994</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190989</skos:exactMatch>
    </owl:Class>

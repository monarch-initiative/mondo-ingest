            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare difference of sex development (DSD) due to a defect in metabolizing testosterone to dihydrotestosterone and characterized by incomplete intrauterine masculinization which ranges from a female genitalia with a blind vaginal pouch to a fully male phenotype with pseudovaginal posterior hypospadias and micropenis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">46,XY DSD due to 5-alpha-reductase 2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>46,XY difference of sex development due to 5-alpha-reductase 2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">46,XY disorder of sex development due to 5-alpha-reductase 2 deficiency</oboInOwl:hasExactSynonym>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">C syndrome is a rare multiple congenital anomaly/intellectual disability syndrome characterized by trigonocephaly and metopic suture synostosis, dysmorphic facial features, short neck, skeletal anomalies, and variable intellectual disability.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>C syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OTCS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Opitz C trigonocephaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Opitz trigonocephaly C syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Opitz trigonocephaly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trigonocephaly C syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>C syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.GY</skos:broadMatch>
        <skos:exactMatch>MONDO:0008893</skos:exactMatch>
        <skos:exactMatch>MeSH:C537418</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083975</skos:exactMatch>
        <skos:exactMatch>OMIM:211750</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796095</skos:exactMatch>
    </owl:Class>

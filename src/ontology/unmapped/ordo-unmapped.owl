        <skos:exactMatch>MONDO:0012895</skos:exactMatch>
        <skos:exactMatch>OMIM:612406</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190526</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

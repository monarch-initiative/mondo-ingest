    <!-- http://www.orpha.net/ORDO/Orphanet_93314 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93314">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_364820"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_431272 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_431272">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_431263"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3702"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, muscular dystrophy disease characterized by the co-occurrence of late onset scapular and peroneal muscle weakness, principally manifesting with distal lower limb and proximal upper limb weakness and scapular winging.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked SPMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked scapuloperoneal muscular dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked scapuloperoneal syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked scapuloperoneal muscular dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:G71.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C70.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0010400</skos:exactMatch>
        <skos:exactMatch>OMIM:300695</skos:exactMatch>
        <skos:exactMatch>UMLS:C5399872</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_431272"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>X-linked scapuloperoneal muscular dystrophy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Dementia due to thiamine deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>NON RARE IN EUROPE: Wernicke encephalopathy</rdfs:label>

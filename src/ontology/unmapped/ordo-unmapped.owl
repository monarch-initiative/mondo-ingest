        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare parenchymal liver disease characterized by progressive fibrosis of the portal tracts due to arrest of maturation of the ductal plate of the intrahepatic bile ducts. Clinically, it may manifest as a portal hypertensive, cholangitic, mixed, or latent form. Onset of symptoms is mostly in adolescence or young adulthood. Hepatocellular function is relatively well preserved.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated CHF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isolated congenital hepatic fibrosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated congenital hepatic fibrosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q44.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB20.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0018840</skos:exactMatch>
        <skos:exactMatch>MeSH:C562378</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056533</skos:exactMatch>
        <skos:exactMatch>UMLS:C0009714</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

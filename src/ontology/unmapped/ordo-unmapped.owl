        <owl:annotatedTarget>Myopericytoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2897 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2897">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183438"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

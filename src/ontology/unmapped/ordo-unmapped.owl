        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Mild Canavan disease (CD) is a neurodegenerative disorder characterized by mild speech delay or motor development.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile Canavan disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mild Canavan disease</oboInOwl:hasExactSynonym>

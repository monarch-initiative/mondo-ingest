            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined immunodeficiency due to MALT1 deficiency is a rare, genetic form of primary immunodeficiency characterized by growth retardation, early recurrent pulmonary infections leading to bronchiectasis, inflammatory gastrointestinal disease, and other symptoms, such as rash, dermatitis, skin infections.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Combined immunodeficiency due to MALT1 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined immunodeficiency due to MALT1 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D81.8</skos:broadMatch>

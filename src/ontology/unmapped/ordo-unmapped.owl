    <!-- http://www.orpha.net/ORDO/Orphanet_447795 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_447795">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225700"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377790"/>

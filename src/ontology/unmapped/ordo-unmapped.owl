            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Histidinemia is a rare metabolic disorder characterized by elevated histidine levels in blood, urine, and cerebrospinal fluid, generally with no clinical repercussions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HAL deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HIS deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Histidase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Histidine ammonia-lyase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Histidinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Histidinuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperhistidinemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Histidinemia</rdfs:label>
        <skos:broadMatch>ICD-10:E70.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C50.20</skos:exactMatch>
        <skos:exactMatch>MONDO:0009345</skos:exactMatch>
        <skos:exactMatch>MeSH:C538320</skos:exactMatch>
        <skos:exactMatch>OMIM:235800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0220992</skos:exactMatch>
    </owl:Class>

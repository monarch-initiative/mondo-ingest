        <skos:exactMatch>OMIM:113970</skos:exactMatch>
        <skos:exactMatch>UMLS:C0006413</skos:exactMatch>
        <skos:narrowMatch>ICD-10:C83.7</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C91.8</skos:narrowMatch>

        <oboInOwl:hasExactSynonym xml:lang="en">Pseudovitamin D-deficient rickets</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">VDDI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">VDDR-I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vitamin D dependent rickets type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vitamin D-dependency type I</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypocalcemic vitamin D-dependent rickets</rdfs:label>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_178493 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_178493">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C048"/>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Myopic maculopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>NON RARE IN EUROPE: Myopic macular degeneration</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

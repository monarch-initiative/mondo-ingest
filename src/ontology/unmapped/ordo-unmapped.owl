    <!-- http://www.orpha.net/ORDO/Orphanet_190 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_190">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183503"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_525677"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_71281"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716459"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717348"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98631"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <obo:IAO_0000115 xml:lang="en">Coats disease (CD) is an idiopathic disorder characterized by retinal telangiectasia with deposition of intraretinal or subretinal exudates, potentially leading to retinal detachment and unilateral blindness. CD is classically an isolated and unilateral condition affecting otherwise healthy young children.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Coats disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital retinal telangiectasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Leber miliary aneurysm</oboInOwl:hasExactSynonym>
        <rdfs:label>Coats disease</rdfs:label>
        <skos:broadMatch>ICD-10:H35.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD21.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010269</skos:exactMatch>
        <skos:exactMatch>MeSH:D058456</skos:exactMatch>
        <skos:exactMatch>MedDRA:10015901</skos:exactMatch>
        <skos:exactMatch>OMIM:300216</skos:exactMatch>
        <skos:exactMatch>UMLS:C0154832</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_190"/>

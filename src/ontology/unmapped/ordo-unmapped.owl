        <skos:exactMatch>UMLS:C0035021</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A68.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A68.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A68.9</skos:narrowMatch>
    </owl:Class>

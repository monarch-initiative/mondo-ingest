    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_240 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_240">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10853"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic skeletal dysplasia marked by disproportionate short stature and the characteristic Madelung wrist deformity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Léri-Weill dyschondrosteosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Léri-Weill syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Léri-Weill dyschondrosteosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.A</skos:broadMatch>
        <skos:exactMatch>MONDO:0007481</skos:exactMatch>
        <skos:exactMatch>MeSH:C537119</skos:exactMatch>
        <skos:exactMatch>OMIM:127300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265309</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_240"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_93476 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93476">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217581"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_579"/>

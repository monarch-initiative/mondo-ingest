    <!-- http://www.orpha.net/ORDO/Orphanet_319605 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319605">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_748"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2578"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">X-linked (XR) Mendelian susceptibility to mycobacterial diseases (MSMD) describes a rare group of immunodeficiencies due to specific mutations in the inhibitor of kappa light polypeptide gene enhancer in B-cells, kinase gamma (&lt;i&gt;IKBKG&lt;/i&gt;) or the cytochrome b-245, beta polypeptide (&lt;i&gt;CYBB&lt;/i&gt;) genes. They are characterized by mycobacterial infections, occuring in males.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked MSMD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked mendelian susceptibility to mycobacterial diseases</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked mendelian susceptibility to mycobacterial diseases</rdfs:label>
        <skos:broadMatch>ICD-10:D84.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A00.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0017905</skos:exactMatch>
        <skos:exactMatch>OMIM:300645</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304413</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

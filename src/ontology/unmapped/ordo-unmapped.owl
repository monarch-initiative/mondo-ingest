        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645273"/>
        <obo:IAO_0000115 xml:lang="en">A rare lipomatous, dysraphic malformation characterized by attachment to the dorsal surface of the spinal cord but not extending to the conus. It can be associated with others features such as a stalk and vertebral bone abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Conus sparing spinal cord lipoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dorsal spinal cord lipoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Dorsal spinal cord lipoma</rdfs:label>

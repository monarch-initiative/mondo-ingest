    <!-- http://www.orpha.net/ORDO/Orphanet_2826 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2826">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100979"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_319504 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319504">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35696"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

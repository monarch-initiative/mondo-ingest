    <!-- http://www.orpha.net/ORDO/Orphanet_450 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_450">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98716"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by abnormal arrangement of the thoraco-abdominal organs across the left-right axis of the body. By definition, it does not include situs inversus totalis (total mirror-imagery).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Heterotaxy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Heterotaxy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Visceral heterotaxy</oboInOwl:hasExactSynonym>
        <rdfs:label>Visceral heterotaxy</rdfs:label>
        <skos:exactMatch>ICD-10:Q89.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0018677</skos:exactMatch>
        <skos:exactMatch>MONDO:18677</skos:exactMatch>
        <skos:exactMatch>MeSH:D059446</skos:exactMatch>
        <skos:exactMatch>MedDRA:10067265</skos:exactMatch>
        <skos:exactMatch>UMLS:C3178805</skos:exactMatch>
        <skos:narrowMatch>OMIM:270100</skos:narrowMatch>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital factor V deficiency is an inherited bleeding disorder due to reduced plasma levels of factor V (FV) and characterized by mild to severe bleeding symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital factor V deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Owren disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Parahemophilia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Proaccelerin deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital factor V deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D68.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B14.Z</skos:broadMatch>
        <skos:exactMatch>MONDO:0009210</skos:exactMatch>
        <skos:exactMatch>MeSH:D005166</skos:exactMatch>
        <skos:exactMatch>MedDRA:10048930</skos:exactMatch>
        <skos:exactMatch>OMIM:227400</skos:exactMatch>
        <skos:exactMatch>UMLS:C0015499</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_326"/>

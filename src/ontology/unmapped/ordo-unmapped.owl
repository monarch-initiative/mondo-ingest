            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of oculocutaneous albinism type 1 (OCA1) characterized by skin and hair hypopigmentation, nystagmus, reduced iris and retinal pigment and misrouting of the optic nerves.</obo:IAO_0000115>

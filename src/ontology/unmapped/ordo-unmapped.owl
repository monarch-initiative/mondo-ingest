    <!-- http://www.orpha.net/ORDO/Orphanet_85203 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85203">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294959"/>

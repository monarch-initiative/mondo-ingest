        <obo:IAO_0000115 xml:lang="en">Multiple system atrophy, parkinsonian type (MSA-p) is a form of multiple system atrophy (MSA) with predominant parkinsonian features (bradykinesia, rigidity, irregular jerky postural tremor, and postural instability).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MSA, parkinsonian type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MSA-p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple system atrophy, parkinsonian type</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple system atrophy, parkinsonian type</rdfs:label>
        <skos:exactMatch>ICD-10:G23.2</skos:exactMatch>
        <skos:exactMatch>ICD-11:8D87.01</skos:exactMatch>
        <skos:exactMatch>MONDO:0020352</skos:exactMatch>

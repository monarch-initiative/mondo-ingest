    <!-- http://www.orpha.net/ORDO/Orphanet_1309 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1309">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_357506"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93546"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11630"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare renal tract malformation characterized by dilated malformation of the medullary collecting ducts (typically bilateral), and associated with stone formation, renal colic, hematuria, urinary tract infection, nephrocalcinosis, calcium nephrolithiasis, pyelonephritis, hypercalciuria and hypocitraturia. The disease is associated with abnormal distal tubular functions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cacchi-Ricci disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MSK</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Medullary sponge kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Precalicial canalicular ectasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Medullary sponge kidney</rdfs:label>
        <skos:broadMatch>ICD-10:Q61.5</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB30.8</skos:exactMatch>
        <skos:exactMatch>MONDO:0015268</skos:exactMatch>
        <skos:exactMatch>MeSH:D007691</skos:exactMatch>
        <skos:exactMatch>MedDRA:10027104</skos:exactMatch>
        <skos:exactMatch>UMLS:C0022681</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1309"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Medullary sponge kidney</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

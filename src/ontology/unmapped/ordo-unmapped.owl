        <skos:narrowMatch>OMIM:600638</skos:narrowMatch>
        <skos:narrowMatch>OMIM:602078</skos:narrowMatch>
        <skos:narrowMatch>OMIM:609384</skos:narrowMatch>
        <skos:narrowMatch>OMIM:609428</skos:narrowMatch>
        <skos:narrowMatch>OMIM:609612</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616219</skos:narrowMatch>
    </owl:Class>

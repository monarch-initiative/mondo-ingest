    <!-- http://www.orpha.net/ORDO/Orphanet_558 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_558">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139030"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_284993"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_285014"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498448"/>

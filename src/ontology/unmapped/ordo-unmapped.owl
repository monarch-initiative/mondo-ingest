    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_264580 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_264580">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_370"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8926"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8931"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Glycogen storage disease (GSD) due to liver phosphorylase kinase (PhK) deficiency is a benign inborn error of glycogen metabolism characterized by hepatomegaly, growth retardation, and mild delay in motor development during childhood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD due to liver phosphorylase kinase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type 9A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type 9C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type IXa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GSD type IXc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glycogen storage disease due to liver phosphorylase kinase deficiency</oboInOwl:hasExactSynonym>

        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: CAVC-left heart obstruction syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>OBSOLETE: Complete atrioventricular canal-left heart obstruction syndrome</rdfs:label>

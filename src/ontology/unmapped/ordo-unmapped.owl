    <!-- http://www.orpha.net/ORDO/Orphanet_401996 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_401996">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93587"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29170"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic renal disease characterized by slowly progressive, chronic, tubulointerstitial nephritis, leading to end-stage renal disease before the age of 50 years, manifesting with mild proteinuria, glucosuria and, occasionally, urinary sediment abnormalities (mainly hematuria). Mild extrarenal manifestations, such as recurrent upper respiratory tract infections and abnormal liver function tests, may be associated. Renal biopsy reveals severe, chronic, interstitial fibrosis and tubular changes, as well as hallmark karyomegalic tubular epithelial cells which line the proximal and distal tubules and have enlarged, hyperchromatic nuclei.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">KIN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Karyomegalic interstitial nephritis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Systemic karyomegaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Karyomegalic interstitial nephritis</rdfs:label>
        <skos:broadMatch>ICD-10:N11.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB55.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013898</skos:exactMatch>
        <skos:exactMatch>OMIM:614817</skos:exactMatch>
        <skos:exactMatch>UMLS:C3553774</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_401996"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

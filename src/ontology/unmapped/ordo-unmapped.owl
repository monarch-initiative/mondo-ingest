    <!-- http://www.orpha.net/ORDO/Orphanet_22 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_22">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225707"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of epidermolysis bullosa simplex (EBS) characterized by generalized blistering associated with muscular dystrophy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EBS with muscular dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EBS-MD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Epidermolysis bullosa simplex with muscular dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Limb-girdle muscular dystrophy with epidermolysis bullosa simplex</oboInOwl:hasExactSynonym>
        <rdfs:label>Epidermolysis bullosa simplex with muscular dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC30</skos:broadMatch>
        <skos:exactMatch>MONDO:0009181</skos:exactMatch>
        <skos:exactMatch>OMIM:226670</skos:exactMatch>

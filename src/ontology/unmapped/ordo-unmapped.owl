    <!-- http://www.orpha.net/ORDO/Orphanet_86911 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_86911">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306759"/>

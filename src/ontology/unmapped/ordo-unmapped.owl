        <oboInOwl:hasExactSynonym xml:lang="en">Acrodysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Arkless-Graham syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Maroteaux-Malamut syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Acrodysostosis</rdfs:label>

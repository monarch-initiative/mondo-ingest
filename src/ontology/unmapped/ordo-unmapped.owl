                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2309"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare infantile epilepsy syndrome characterized by an infantile-onset of sudden, frequent and generalized myoclonic seizures that occur in neurologically and developmentally normal patients, and later resolve during childhood with a generally favorable outcome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign myoclonic epilepsy of infancy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign myoclonus epilepsy of infancy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MEI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Myoclonic epilepsy of infancy</oboInOwl:hasExactSynonym>
        <rdfs:label>Myoclonic epilepsy of infancy</rdfs:label>
        <skos:broadMatch>ICD-10:G40.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.1Y</skos:broadMatch>
        <skos:broadMatch>OMIM:605021</skos:broadMatch>
        <skos:exactMatch>MONDO:0019486</skos:exactMatch>
        <skos:exactMatch>MONDO:100566</skos:exactMatch>
        <skos:exactMatch>MONDO:19486</skos:exactMatch>
        <skos:exactMatch>UMLS:C0751120</skos:exactMatch>
        <skos:narrowMatch>OMIM:617976</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618364</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

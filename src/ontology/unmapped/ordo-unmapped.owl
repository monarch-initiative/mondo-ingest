        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207021"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19880"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary disease with peripheral neuropathy characterized by distal sensorimotor or motor neuropathy of the lower limbs with muscle weakness and atrophy. Some patients show overt connective tissue disease with signs and symptoms like increased skin elasticity and easy bruising (but no atrophic scarring), decreased clotting, aortic aneurysms, joint hypermobility, and recurrent tendon ruptures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EMILIN-1-related connective tissue disease</oboInOwl:hasExactSynonym>
        <rdfs:label>EMILIN-1-related connective tissue disease</rdfs:label>
        <skos:broadMatch>ICD-10:G60.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0044622</skos:exactMatch>
        <skos:exactMatch>OMIM:620080</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681244</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_485418"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_94075 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_94075">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117569"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">Severe-immune mediated enteropathy describes a variety of intestinal disorders that can range from a serious, early-onset systemic disease (IPEX) to a mild isolated gastrointestinal disease. In children it manifests with severe diarrhea and dehydration in the presence of characteristic antibodies (anti-enterocyte and anti-goblet cell) and in adults with chronic diarrhea, malabsorption and weight loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autoimmune enteropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Immune-mediated protracted diarrhea of infancy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Severe immune-mediated enteropathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe immune-mediated enteropathy</rdfs:label>
        <skos:exactMatch>MedDRA:10081456</skos:exactMatch>
        <skos:exactMatch>UMLS:C0341305</skos:exactMatch>
    </owl:Class>

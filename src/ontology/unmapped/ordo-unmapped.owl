    <!-- http://www.orpha.net/ORDO/Orphanet_2876 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2876">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>

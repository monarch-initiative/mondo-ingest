    <!-- http://www.orpha.net/ORDO/Orphanet_98869 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98869">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_251019 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251019">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262010"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare partial autosomal deletion syndrome characterized by a variable phenotype including moderate to severe intellectual disability, behavioral problems, short stature, microcephaly, dysplastic nails, sparse hair, cleft palate and dysmorphic craniofacial features. The deletion typically includes the gene &lt;i&gt;SATB2&lt;/i&gt;, and patients present with the typical features of SATB2-associated syndrome, with the addition of a variable pattern of cardiovascular, genitourinary, and ectodermal congenital anomalies due to the involvement of adjacent genes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>2q32q33 deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(2)(q32q33)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 2q32q33</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(2)(q32q33)</oboInOwl:hasExactSynonym>
        <rdfs:label>2q32q33 deletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.20</skos:broadMatch>
        <skos:broadMatch>OMIM:612313</skos:broadMatch>
        <skos:exactMatch>MONDO:0012864</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304531</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251019"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

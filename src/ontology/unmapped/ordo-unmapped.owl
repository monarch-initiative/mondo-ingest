        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716405"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79389"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">Cockayne syndrome (CS) is a multisystem condition characterized by short stature, a characteristic facial appearance, premature aging, photosensitivity, progressive neurological dysfunction, and intellectual deficit.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cockayne syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cockayne syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2B</skos:broadMatch>
        <skos:exactMatch>MONDO:0016006</skos:exactMatch>
        <skos:exactMatch>MeSH:D003057</skos:exactMatch>
        <skos:exactMatch>MedDRA:10009835</skos:exactMatch>
        <skos:exactMatch>UMLS:C0009207</skos:exactMatch>
        <skos:narrowMatch>OMIM:133540</skos:narrowMatch>
        <skos:narrowMatch>OMIM:214150</skos:narrowMatch>
        <skos:narrowMatch>OMIM:216400</skos:narrowMatch>
        <skos:narrowMatch>OMIM:278780</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610756</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610758</skos:narrowMatch>
        <skos:narrowMatch>OMIM:616570</skos:narrowMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93546"/>
        <obo:IAO_0000115 xml:lang="en">Megacystic-megaureter syndrome is an urinary tract malformation characterized by the presence of a massive primary non-obstructive vesicoureteral reflux and a large capacity, smooth, thin walled bladder due to the continual recycling of refluxed urine. Recurrent urinary infections are commonly associated with this condition.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Megacystis-megaureter syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Megaureter-megacystis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Megacystis-megaureter syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q62.7</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB31.7</skos:exactMatch>
        <skos:exactMatch>MONDO:0016548</skos:exactMatch>
        <skos:exactMatch>UMLS:C0431752</skos:exactMatch>
    </owl:Class>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare progressive myoclonic epilepsy (PME) disorder characterized by action- and stimulus-sensitive myoclonus, and tonic-clonic seizures with ataxia, but with only a mild cognitive decline over time.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EPM1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progressive myoclonic epilepsy type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive myoclonus epilepsy type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ULD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Unverricht-Lundborg disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Progressive myoclonic epilepsy type 1</rdfs:label>
        <skos:broadMatch>ICD-10:G40.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.41</skos:broadMatch>

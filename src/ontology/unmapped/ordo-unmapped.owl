    <!-- http://www.orpha.net/ORDO/Orphanet_90050 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90050">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716459"/>
        <obo:IAO_0000115 xml:lang="en">A rare retinal vasoproliferative disease affecting preterm infants characterized initially by a delay in physiologic retinal vascular development and compromised physiologic vascularity, and subsequently by aberrant angiogenesis in the form of intravitreal neovascularization.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ROP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Retinopathy of prematurity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Retrolental fibroplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Retinopathy of prematurity</rdfs:label>
        <skos:broadMatch>OMIM:133780</skos:broadMatch>
        <skos:exactMatch>ICD-10:H35.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:9B71.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0006952</skos:exactMatch>
        <skos:exactMatch>MeSH:D012178</skos:exactMatch>
        <skos:exactMatch>MedDRA:10038933</skos:exactMatch>
        <skos:exactMatch>UMLS:C0035344</skos:exactMatch>
    </owl:Class>

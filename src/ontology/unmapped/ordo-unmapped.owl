            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Superficial epidermolytic ichthyosis (SEI) is a rare keratinopathic ichthyosis (KI) characterized by the presence of superficial blisters and erosions at birth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ichthyosis bullosa of Siemens</oboInOwl:hasExactSynonym>

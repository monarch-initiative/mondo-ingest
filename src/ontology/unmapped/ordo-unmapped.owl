    <!-- http://www.orpha.net/ORDO/Orphanet_603684 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_603684">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

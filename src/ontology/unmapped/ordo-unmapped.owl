        <obo:IAO_0000115 xml:lang="en">Pentalogy of Cantrell (POC) is a lethal multiple congenital anomalies syndrome, characterized by the presence of 5 major malformations: midline supraumbilical abdominal wall defect, lower sternal defect, diaphragmatic pericardial defect, anterior diaphragmatic defect and various intracardiac malformations. Ectopia cordis (EC) is often found in fetuses with POC.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cantrell deformity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cantrell syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pentalogy of Cantrell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Thoraco-abdominal syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Pentalogy of Cantrell</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010742</skos:exactMatch>

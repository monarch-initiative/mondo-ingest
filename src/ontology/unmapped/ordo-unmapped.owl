    <!-- http://www.orpha.net/ORDO/Orphanet_93325 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93325">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2333"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/24725"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, primary bone dysplasia characterized by severe growth retardation, short stature, cortical thickening and medullary stenosis of long bones, delayed closure of the anterior fontanelle, absent diploic space in the skull bones, prominent forehead, macrocephaly, dental anomalies, eye problems (hypermetropia and pseudopapilledema), and hypocalcemia due to hypoparathyroidism, sometimes resulting in convulsions. Intelligence is normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant Kenny-Caffey syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant Kenny-Caffey syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.D</skos:broadMatch>
        <skos:exactMatch>MONDO:0007478</skos:exactMatch>
        <skos:exactMatch>OMIM:127000</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681457</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93325"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Autosomal dominant Kenny-Caffey syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79381"/>
        <obo:IAO_0000115 xml:lang="en">A progressive cutaneous disorder predominantly affecting males, characterized by hypertrophy and thickening of the skin of the scalp, forming convoluted furrows with deep, tender, and cerebriform cutaneous folds. Hair is usually normal in the furrows and sparse on the folds. It can be isolated or associated with other abnormalities, such as intellectual deficit, epilepsy, cataract, blindness, and deafness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Primary cutis verticis gyrata</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary cutis verticis gyrata</rdfs:label>
        <skos:broadMatch>ICD-11:EE7Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019033</skos:exactMatch>

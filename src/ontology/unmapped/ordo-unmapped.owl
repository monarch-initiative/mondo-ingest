    <!-- http://www.orpha.net/ORDO/Orphanet_85199 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85199">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139393"/>

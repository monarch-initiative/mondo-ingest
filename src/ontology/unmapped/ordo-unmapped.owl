        <oboInOwl:hasExactSynonym xml:lang="en">Tyrosine hydroxylase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tyrosine hydroxylase-deficient dopa-responsive dystonia</oboInOwl:hasExactSynonym>

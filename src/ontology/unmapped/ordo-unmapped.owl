    <!-- http://www.orpha.net/ORDO/Orphanet_257 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_257">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139027"/>

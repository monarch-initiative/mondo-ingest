    <!-- http://www.orpha.net/ORDO/Orphanet_500062 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_500062">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_324924"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25118"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic autoinflammatory syndrome characterized by early-onset of repeated episodes of fever, nodular neutrophil-rich panniculitis, arthralgia, and lipodystrophy. Additional reported features include diarrhea, failure to thrive, lymphadenopathy, and vasculitis. Laboratory examination may reveal elevated serum C-reactive protein and leukocytosis with neutrophilia in the absence of infection.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Infantile-onset periodic fever-panniculitis-dermatosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ORAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OTULIN deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OTULIN-related autoinflammatory syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Otulipenia</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile-onset periodic fever-panniculitis-dermatosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D89.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A60.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0014912</skos:exactMatch>
        <skos:exactMatch>OMIM:617099</skos:exactMatch>
        <skos:exactMatch>UMLS:C4310614</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_500062"/>

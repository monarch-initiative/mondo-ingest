    <!-- http://www.orpha.net/ORDO/Orphanet_90025 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90025">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93458"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare, congenital, non-syndromic distal limb malformation disorders characterized by webbing or fusion of the fingers or toes, involving soft parts only or including bone structure. The morphological anomaly can be unilateral or bilateral, symmetrical or asymmetrical, depending on the specific type.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Non-syndromic syndactyly</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-syndromic syndactyly</rdfs:label>
        <skos:exactMatch>ICD-10:Q70</skos:exactMatch>
        <skos:exactMatch>ICD-11:LB79</skos:exactMatch>
        <skos:exactMatch>MONDO:0019530</skos:exactMatch>
        <skos:exactMatch>MONDO:19530</skos:exactMatch>
        <skos:exactMatch>MeSH:D013576</skos:exactMatch>

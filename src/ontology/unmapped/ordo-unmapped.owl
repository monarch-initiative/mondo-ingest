    <!-- http://www.orpha.net/ORDO/Orphanet_564178 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_564178">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166472"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183592"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309848"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93603"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/799"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disorder of magnesium transport characterized by infantile onset of generalized seizures and severe hypomagnesemia due to massive renal magnesium wasting. Seizures persist despite magnesium supplementation and are associated with significant global developmental delay and intellectual disability. Brain MRI may show reduced cerebral volume.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Primary hypomagnesemia-refractory seizures-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary hypomagnesemia-refractory seizures-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E83.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB90.4Y</skos:broadMatch>
        <skos:exactMatch>OMIM:618314</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681271</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_564178"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Primary hypomagnesemia-refractory seizures-intellectual disability syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_56425 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_56425">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_228312"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Cold agglutinin disease is a type of autoimmune hemolytic anemia defined by the presence of cold autoantibodies (autoantibodies which are active at temperatures below 30°C).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CAD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chronic cold agglutinin disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cold agglutinin disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cold agglutinin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cold agglutinin disease</rdfs:label>
        <skos:broadMatch>ICD-10:D59.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A20.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0018922</skos:exactMatch>
        <skos:exactMatch>UMLS:C0175816</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_56425"/>

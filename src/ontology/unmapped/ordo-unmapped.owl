        <skos:broadMatch>ICD-10:G90.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C59.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0009123</skos:exactMatch>
        <skos:exactMatch>MeSH:C535600</skos:exactMatch>
        <skos:exactMatch>OMIM:223360</skos:exactMatch>

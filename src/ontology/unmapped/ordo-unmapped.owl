        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant malformation syndrome characterized by hypertelorism, omphalocoele, cleft lip, ear pits, uterine malformation (bicornuate uterus), and more variably by diaphragmatic hernia and congenital heart defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Brachycephalofrontonasal dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SPECC1L-related hypertelorism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Teebi hypertelorism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>SPECC1L-related hypertelorism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0800025</skos:exactMatch>
        <skos:exactMatch>OMIM:145420</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796179</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1519"/>

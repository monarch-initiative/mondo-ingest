    <!-- http://www.orpha.net/ORDO/Orphanet_371007 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_371007">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

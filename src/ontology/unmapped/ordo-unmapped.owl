        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Von Willebrand disease type 1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_166081 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_166081">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_903"/>
        <obo:IAO_0000115 xml:lang="en">A form of von Willebrand disease (VWD) characterized by a bleeding disorder associated with a qualitative deficiency and functional anomalies of the Willebrand factor (VWF). Depending on the type of functional abnormalities, this form is classified as type 2A, 2B, 2M or 2N.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Von Willebrand disease type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Von Willebrand disease type 2</rdfs:label>
        <skos:broadMatch>ICD-10:D68.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B12</skos:broadMatch>
        <skos:exactMatch>MONDO:0013304</skos:exactMatch>
        <skos:exactMatch>MeSH:D056728</skos:exactMatch>
        <skos:exactMatch>OMIM:613554</skos:exactMatch>

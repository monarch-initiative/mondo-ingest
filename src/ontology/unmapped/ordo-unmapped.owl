        <obo:IAO_0000115 xml:lang="en">Q fever, caused by &lt;i&gt;Coxiella burnetii&lt;/i&gt;, is a bacterial zoonosis with a wide clinical spectrum that can be life-threatening and, in some cases, can become chronic.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Coxiellosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection due to Coxiella burnetii</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nine Mile fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Q fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Quadrilateral fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Query fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Q fever</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_1433 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1433">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716299"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <obo:IAO_0000115 xml:lang="en">A rare ectodermal dysplasia syndrome, characterized by the association of choroidal atrophy (sometimes regional), together with other ectodermal dysplasia features including fine and sparse hair, absent or decreased lashes and eyebrows, and possibly mild visual loss and dysplastic/thick/grooved nails.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Choroidal atrophy-alopecia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Moloney syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Regional choroidal atrophy and alopecia</oboInOwl:hasExactSynonym>
        <rdfs:label>Choroidal atrophy-alopecia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015428</skos:exactMatch>
        <skos:exactMatch>MeSH:C535810</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931026</skos:exactMatch>
    </owl:Class>

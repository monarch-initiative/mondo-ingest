        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Acquired pernicious anemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Addison-Biermer anemia</oboInOwl:hasExactSynonym>

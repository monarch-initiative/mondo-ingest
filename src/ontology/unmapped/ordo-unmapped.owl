    <!-- http://www.orpha.net/ORDO/Orphanet_268129 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_268129">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_209224"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

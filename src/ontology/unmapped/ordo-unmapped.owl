        <obo:IAO_0000115 xml:lang="en">A rare non-acquired pituitary hormone deficiency characterized by growth deficiency, delayed bone age, and short stature of variable severity and age of onset, and with variable response to treatment with recombinant human growth hormone, depending on the respective subtype of the disease. Hormone deficiency may be quantitative or qualitative in nature.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital IGHD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital isolated GH deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital isolated growth hormone deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Non-acquired isolated growth hormone deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-acquired isolated growth hormone deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E23.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A61.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0000050</skos:exactMatch>
        <skos:exactMatch>MedDRA:10035083</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679572</skos:exactMatch>
        <skos:narrowMatch>OMIM:173100</skos:narrowMatch>
        <skos:narrowMatch>OMIM:262400</skos:narrowMatch>
        <skos:narrowMatch>OMIM:262650</skos:narrowMatch>
        <skos:narrowMatch>OMIM:300123</skos:narrowMatch>

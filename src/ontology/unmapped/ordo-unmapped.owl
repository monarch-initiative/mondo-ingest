        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomaly syndrome characterized by a distinct facial phenotype, intellectual disability, epilepsy, Hirschsprung disease (HSCR) and variable congenital malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hirschsprung disease-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mowat-Wilson syndrome</oboInOwl:hasExactSynonym>

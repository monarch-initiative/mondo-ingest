    <!-- http://www.orpha.net/ORDO/Orphanet_101070 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_101070">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4512"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Bilateral frontoparietal polymicrogyria (BFPP) is a sub-type of polymicrogyria (PMG), a cerebral cortical malformation characterized by excessive cortical folding and abnormal cortical layering, that involves the frontoparietal region of the brain and that presents with hypotonia, developmental delay, moderate to severe intellectual disability, pyramidal signs, epileptic seizures, non progressive cerebellar ataxia, dysconjugate gaze and/or strabismus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bilateral frontoparietal polymicrogyria</oboInOwl:hasExactSynonym>
        <rdfs:label>Bilateral frontoparietal polymicrogyria</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA05.50</skos:broadMatch>
        <skos:exactMatch>MONDO:0011738</skos:exactMatch>
        <skos:exactMatch>MeSH:C564652</skos:exactMatch>
        <skos:exactMatch>OMIM:606854</skos:exactMatch>
        <skos:exactMatch>UMLS:C1847352</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_101070"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Bilateral frontoparietal polymicrogyria</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



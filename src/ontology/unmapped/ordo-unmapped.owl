            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A disorder of most severe form of alopecia areata, an inflammatory disease of the hair follicle, which is characterized by a complete loss of hair of the scalp and all the hair-bearing areas of the body.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Alopecia universalis</oboInOwl:hasExactSynonym>
        <rdfs:label>Alopecia universalis</rdfs:label>
        <skos:broadMatch>ICD-11:ED70.2Y</skos:broadMatch>
        <skos:broadMatch>OMIM:104000</skos:broadMatch>

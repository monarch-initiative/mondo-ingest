            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3951"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Friedreich ataxia (FRDA) is an inherited neurodegenerative disorder classically characterized by progressive gait and limb ataxia, dysarthria, dysphagia, oculomotor dysfunction, loss of deep tendon reflexes, pyramidal tract signs, scoliosis, and in some, cardiomyopathy, diabetes mellitus, visual loss and defective hearing.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FRDA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Friedreich ataxia</oboInOwl:hasExactSynonym>
        <rdfs:label>Friedreich ataxia</rdfs:label>
        <skos:broadMatch>ICD-10:G11.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:8A03.10</skos:exactMatch>
        <skos:exactMatch>MONDO:0100339</skos:exactMatch>
        <skos:exactMatch>MONDO:100339</skos:exactMatch>
        <skos:exactMatch>MeSH:D005621</skos:exactMatch>
        <skos:exactMatch>MedDRA:10017374</skos:exactMatch>
        <skos:exactMatch>OMIM:229300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0016719</skos:exactMatch>
        <skos:narrowMatch>OMIM:601992</skos:narrowMatch>
    </owl:Class>

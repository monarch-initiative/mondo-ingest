    <!-- http://www.orpha.net/ORDO/Orphanet_101010 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_101010">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_320342"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_320346"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Gaucher disease type 2 is the acute neurological form of Gaucher disease (GD). It is characterized by early-onset and severe neurological involvement of the brainstem, associated with an organomegaly and generally leading to death before the age of 2.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acute neuronopathic Gaucher disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gaucher disease type 2</oboInOwl:hasExactSynonym>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_811 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_811">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101937"/>

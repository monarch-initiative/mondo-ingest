    <!-- http://www.orpha.net/ORDO/Orphanet_100035 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100035">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306636"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare nonmalignant hepatic lesion characterized by a mass with a completely necrotic core often partially calcified, surrounded by a dense hyalinized fibrous capsule containing elastin fibers. Patients are usually asymptomatic but some may suffer from intermittent abdominal pain or discomfort.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hepatic solitary necrotic nodule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Solitary necrotic nodule of the liver</oboInOwl:hasExactSynonym>
        <rdfs:label>Solitary necrotic nodule of the liver</rdfs:label>
        <skos:broadMatch>ICD-10:K76.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:DB99.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015049</skos:exactMatch>
        <skos:exactMatch>UMLS:C2960192</skos:exactMatch>
    </owl:Class>

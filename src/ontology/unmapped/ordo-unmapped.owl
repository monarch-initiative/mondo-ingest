            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9607"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Brachydactyly type E (BDE) is a congenital malformation of the digits characterized by variable shortening of the metacarpals with more or less normal length phalanges, although the terminal phalanges are often short.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Brachydactyly type E</oboInOwl:hasExactSynonym>
        <rdfs:label>Brachydactyly type E</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0019677</skos:exactMatch>
        <skos:exactMatch>MeSH:C566194</skos:exactMatch>
        <skos:exactMatch>OMIM:113300</skos:exactMatch>
        <skos:exactMatch>UMLS:C4315392</skos:exactMatch>
        <skos:narrowMatch>OMIM:613382</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93387"/>

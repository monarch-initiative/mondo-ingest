    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_521268 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_521268">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207018"/>

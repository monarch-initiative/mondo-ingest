        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">T-B+ severe combined immunodeficiency (SCID) is a group of rare monogenic primary immunodeficiency disorders characterized by a lack of functional peripheral T lymphocytes with presence of B lymphocytes, resulting in early-onset severe respiratory viral, bacterial or fungal infections, diarrhea and failure to thrive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">T-B+ SCID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T-B+ severe combined immunodeficiency</oboInOwl:hasExactSynonym>

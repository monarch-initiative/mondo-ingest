    <!-- http://www.orpha.net/ORDO/Orphanet_1234 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1234">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294963"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

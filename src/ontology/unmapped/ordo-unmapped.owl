        <obo:IAO_0000115 xml:lang="en">Familial osteochondritis dissecans is a rare genetic skeletal disorder characterized clinically by abnormal chondro-skeletal development, disproportionate short stature and skeletal deformation mainly affecting the knees, hips, ankles and elbows with onset generally in late childhood or adolescence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial osteochondritis dissecans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteochondritis dissecans and short stature</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial osteochondritis dissecans</rdfs:label>
        <skos:broadMatch>ICD-10:M93.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB82.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0100462</skos:exactMatch>
        <skos:exactMatch>MeSH:C580095</skos:exactMatch>
        <skos:exactMatch>UMLS:C3665488</skos:exactMatch>
    </owl:Class>

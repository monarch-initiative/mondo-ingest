    <!-- http://www.orpha.net/ORDO/Orphanet_269229 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_269229">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_729519"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndrome with a brainstem malformation as a major feature characterized by ventral pontine hypoplasia, dorsal cap projection into the forth ventricle and cranial nerve dysfunction. Clinical manifestations of multiple cranial nerves deficits, pyramidal and cerebellar signs include neonatal hypotonia, ataxia, sensorineural deafness, reduced vision, language and speech disorders, feeding and swallowing difficulties, facial paralysis and intellectual disability. Various cardiac, gastrointestinal, genitourinary and skeletal defects have been sometimes reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PTCD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pontine tegmental cap dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Pontine tegmental cap dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0013858</skos:exactMatch>
        <skos:exactMatch>OMIM:614688</skos:exactMatch>
        <skos:exactMatch>UMLS:C3541340</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_269229"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pontine tegmental cap dysplasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



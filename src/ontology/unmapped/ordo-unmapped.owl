        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93439"/>
        <obo:IAO_0000115 xml:lang="en">Campomelia, Cumming type, is characterized by the association of limb defects and multivisceral anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Campomelia, Cumming type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cumming syndrome</oboInOwl:hasExactSynonym>

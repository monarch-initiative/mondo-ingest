        <oboInOwl:hasExactSynonym xml:lang="en">Optic atrophy-ophthalmoplegia-ptosis-deafness-myopathy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Optic atrophy-ophthalmoplegia-ptosis-hearing loss-myopathy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Treft-Sanborn-Carey syndrome</rdfs:label>
        <owl:deprecated>true</owl:deprecated>

        <obo:IAO_0000115 xml:lang="en">Criss cross heart (CCH) is a cardiac malformation where the inflow streams of the two ventricles cross due to twisting of the heart about its major axis. The clinical features depend on the particular cardiac defects associated, like simple or corrected transposition of the great arteries and ventricular septal defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Criss-cross atrioventricular relationships</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Criss-cross heart</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Superoinferior ventricles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Twisted atrioventricular connections</oboInOwl:hasExactSynonym>
        <rdfs:label>Criss-cross heart</rdfs:label>
        <skos:broadMatch>ICD-10:Q24.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA81</skos:broadMatch>
        <skos:exactMatch>MONDO:0015449</skos:exactMatch>
        <skos:exactMatch>MeSH:D003420</skos:exactMatch>
        <skos:exactMatch>UMLS:C0010334</skos:exactMatch>
    </owl:Class>

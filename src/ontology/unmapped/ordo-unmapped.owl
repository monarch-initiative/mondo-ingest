            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, skeletal muscle channelopathy characterized by slow muscle relaxation after contraction (myotonia).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Myotonia congenita</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Thomsen and Becker disease</oboInOwl:hasExactSynonym>

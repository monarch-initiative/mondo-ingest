        <owl:annotatedTarget>Chronic intestinal pseudoobstruction syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_298 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_298">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_104013"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206966"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225700"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225703"/>

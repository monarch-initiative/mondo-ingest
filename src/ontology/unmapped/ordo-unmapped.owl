    <!-- http://www.orpha.net/ORDO/Orphanet_3184 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3184">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139042"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183460"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183580"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79372"/>
        <obo:IAO_0000115 xml:lang="en">A rare malformation syndrome characterized by generalized multiple steatocystomas and natal teeth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Steatocystoma multiplex-natal teeth syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Steatocystoma multiplex-natal teeth syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:L72.2</skos:broadMatch>

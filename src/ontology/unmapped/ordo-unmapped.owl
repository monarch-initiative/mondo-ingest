    <!-- http://www.orpha.net/ORDO/Orphanet_2086 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2086">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_252057"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95503"/>
        <obo:IAO_0000115 xml:lang="en">Optic pathway glioma (OPG) is a benign tumor that develop along the optic nerve (chiasm, tracts, and radiations) characterized by impairment or loss of vision and may be accompanied by diencephalic symptoms such as reduced growth and alteration in sleeping patterns. OPG are often linked to neurofibromatosis type 1 (NF1).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Optic pathway glioma</oboInOwl:hasExactSynonym>
        <rdfs:label>Optic pathway glioma</rdfs:label>
        <skos:broadMatch>ICD-10:D33.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:2A02.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016167</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073338</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796418</skos:exactMatch>
    </owl:Class>

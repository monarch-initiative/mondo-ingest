    <!-- http://www.orpha.net/ORDO/Orphanet_83453 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_83453">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180205"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254373"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, non-malformative vulvovaginal disease characterized by a combination of erosive or desquamative lichen planus (LP) of vulval, vaginal and gingival mucosae, with a high propensity for scarring and stricture formation. Additional sites of involvement are frequently observed (in particular, tongue, buccal mucosae, skin and perianal LP). Patients may be asymptomatic or, more commonly, present with pain, burning, discomfort and bleeding, dyspareunia, and seropurulent vaginal discharge.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Vulvovaginal gingival syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Vulvovaginal gingival syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:L43.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EA91.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0019370</skos:exactMatch>
        <skos:exactMatch>UMLS:C3873472</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_83453"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Vulvovaginal gingival syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_83454 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_83454">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102006"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371436"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_459548"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_715334"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_715339"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14373"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare vascular anomaly or angioma characterized by the presence of small, multifocal bluish-purple venous lesions mainly involving the skin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Glomangiomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glomuvenous malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary multiple glomangiomas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple glomus tumors</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">VMGLOM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Venous malformations with glomus cells</oboInOwl:hasExactSynonym>
        <rdfs:label>Glomuvenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LC51</skos:broadMatch>
        <skos:exactMatch>MONDO:0007672</skos:exactMatch>
        <skos:exactMatch>MeSH:C536827</skos:exactMatch>
        <skos:exactMatch>OMIM:138000</skos:exactMatch>
        <skos:exactMatch>UMLS:C1841984</skos:exactMatch>
    </owl:Class>

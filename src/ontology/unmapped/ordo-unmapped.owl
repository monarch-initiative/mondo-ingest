    <!-- http://www.orpha.net/ORDO/Orphanet_60025 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_60025">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156610"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital, distal arthogryposis syndrome characterized by microstomia, whistling-face appearance, Chin with V- or H- shaped creased, and prominent nasolabial folds; most patients present club foot and congenital joint contractures of the hands and feet. It is the most severe form of distal arthrogryposis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Craniocarpotarsal dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Craniocarpotarsal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal arthrogryposis type 2A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Freeman-Burian syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Freeman-Sheldon syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Whistling face syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Freeman-Sheldon syndrome</rdfs:label>

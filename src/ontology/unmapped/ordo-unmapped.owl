    <!-- http://www.orpha.net/ORDO/Orphanet_566862 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_566862">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271853"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_450"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare, congenital, non-syndromic, cardiovascular malformation characterized by the position of the heart being predominantly to the right of the thoracic midline, with the cardiac apex pointing to the right, due to abnormalities of embryologic origin that are intrinsic to the heart itself. Additional cardiac defects (e.g. septal defects, congenitally corrected transposition of the great arteries) can be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LAI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Left atrial isomerism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Left isomerism</oboInOwl:hasExactSynonym>
        <rdfs:label>Left isomerism</rdfs:label>
        <skos:broadMatch>ICD-10:Q20.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA8Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0035451</skos:exactMatch>
        <skos:exactMatch>UMLS:C0344694</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_566862"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Left isomerism</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_566943 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_566943">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399158"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bone disease characterized by spontaneous adult-onset tarsal navicular osteonecrosis. Patients present with chronic mid- and hindfoot pain, swelling and tenderness over the dorsomedial aspect of the midfoot, flattening of the medial longitudinal arch, and pes planovarus. Radiographic findings include comma-shaped deformity due to collapse of the lateral part of the navicular bone and medial or dorsal protrusion of a portion or the entire bone. The condition may be bilateral or asymmetric and associated with pathological fractures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Brailsford disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mueller-Weiss osteonecrosis of the tarsal bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mueller-Weiss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Mueller-Weiss syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:M92.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB81.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0035452</skos:exactMatch>
        <skos:exactMatch>MedDRA:10082326</skos:exactMatch>
        <skos:exactMatch>UMLS:C4761149</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_566943"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mueller-Weiss syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_567 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_567">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_138047"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139036"/>

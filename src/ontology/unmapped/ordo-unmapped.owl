        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare toxic dermatosis with clinical and histological features characterized by the destruction and detachment of the skin epithelium and mucous membranes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Epidermal necrolysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SJS-TEN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Stevens-Johnson syndrome/toxic epidermal necrolysis spectrum</oboInOwl:hasExactSynonym>
        <rdfs:label>Stevens-Johnson syndrome/toxic epidermal necrolysis spectrum</rdfs:label>
        <skos:broadMatch>OMIM:608579</skos:broadMatch>

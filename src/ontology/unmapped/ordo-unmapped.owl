    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3225 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3225">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

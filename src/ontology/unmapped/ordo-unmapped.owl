    <!-- http://www.orpha.net/ORDO/Orphanet_230 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_230">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182058"/>

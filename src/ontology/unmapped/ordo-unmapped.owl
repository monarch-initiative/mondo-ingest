        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Galactosialidosis is a lysosomal storage disease characterized by coarse facial features, macular &apos;&apos;cherry red spot&apos;&apos;, and dysostosis multiplex. Clinical presentation can be heterogenous ranging from a severe, early-onset, rapidly progressive infantile form to late onset, slowly progressive juvenile/adult form.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Galactosialidosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Goldberg syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neuraminidase deficiency with beta-galactosidase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Galactosialidosis</rdfs:label>
        <skos:broadMatch>ICD-10:E77.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.21</skos:broadMatch>

        <owl:annotatedTarget>Tumor necrosis factor receptor 1 associated periodic syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

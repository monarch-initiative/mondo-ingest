        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare difference of sex development (DSD) characterized by histologically confirmed testicular and ovarian tissue in an individual with a 46,XX karyotype.</obo:IAO_0000115>

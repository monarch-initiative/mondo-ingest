        <obo:IAO_0000115 xml:lang="en">6p22 microdeletion syndrome is a newly described syndrome associated with a variable clinical phenotype including developmental delay, facial dysmorphism, short neck and diverse malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>6p22 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(6)(p22)</oboInOwl:hasExactSynonym>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79375"/>
        <obo:IAO_0000115 xml:lang="en">Leukonychia totalis-acanthosis-nigricans-like lesions-abnormal hair syndrome is a rare, syndromic nail anomaly disorder characterized by the association of leukonychia totalis with acanthosis-nigricans-like lesions (occurring in the neck, axillae and abdomen regions) and hair dysplasia, manifesting with dry, brittle hair which presents an irregular pattern of complete or incomplete twists and an irregular surface with londitudinal furrows on electronic microscopy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Leukonychia totalis-acanthosis-nigricans-like lesions-abnormal hair syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Leukonychia totalis-acanthosis-nigricans-like lesions-abnormal hair syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC22.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0016213</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751169</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_210133"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

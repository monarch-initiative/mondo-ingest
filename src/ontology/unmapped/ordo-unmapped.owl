        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90291"/>
        <obo:IAO_0000115 xml:lang="en">Limited cutaneous systemic sclerosis (lcSSc) is a subtype of systemic sclerosis (SSc) characterized by the association of Raynaud&apos;s phenomenon with skin fibrosis limited to the hands, face, feet and forearms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Limited cutaneous systemic scleroderma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Limited cutaneous systemic sclerosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Limited cutaneous systemic sclerosis</rdfs:label>
        <skos:broadMatch>ICD-10:M34.1</skos:broadMatch>
        <skos:broadMatch>OMIM:181750</skos:broadMatch>
        <skos:exactMatch>MONDO:0016358</skos:exactMatch>
        <skos:exactMatch>UMLS:C5574860</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_31202 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_31202">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A tropical infectious disease caused by the Gram-negative bacterium &lt;i&gt;Burkholderia pseudomallei&lt;/i&gt;, which is present in soil and water in tropical countries. Melioidosis can present itself in many ways, including pneumonia, sepsis and abscess formation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Burkholderia pseudomallei infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Melioidosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Melioidosis</rdfs:label>
        <skos:exactMatch>ICD-11:1C42</skos:exactMatch>
        <skos:exactMatch>MONDO:0017775</skos:exactMatch>
        <skos:exactMatch>MeSH:D008554</skos:exactMatch>
        <skos:exactMatch>MedDRA:10069748</skos:exactMatch>
        <skos:exactMatch>UMLS:C0025229</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A24.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A24.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A24.3</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A24.4</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615557</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

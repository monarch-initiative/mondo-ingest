        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited epidermolysis bullosa (EB) characterized by skin fragility and blistering at birth followed by development of photosensitivity and progressive poikilodermatous skin changes.</obo:IAO_0000115>

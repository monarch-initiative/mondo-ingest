        <skos:broadMatch>ICD-11:8C20.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0013212</skos:exactMatch>
        <skos:exactMatch>MeSH:C567653</skos:exactMatch>
        <skos:exactMatch>OMIM:613287</skos:exactMatch>
        <skos:exactMatch>UMLS:C2750090</skos:exactMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A very rare genetic necrotic bone disorder characterized clinically by painless swelling of the proximal interphalangeal joints associated with osteonecrosis of epiphyses followed by osteoarthritic changes, with onset before 25 years of age and often a benign course.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Aseptic necrosis of phalangeal epiphyses</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteochondrosis of phalangeal epiphyses</oboInOwl:hasExactSynonym>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare eye tumor disease representing the most common intraocular malignancy in children. It is a life threatening neoplasia but is potentially curable and it can be hereditary or non hereditary, unilateral or bilateral.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Retinoblastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Retinoblastoma</rdfs:label>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by the association of congenital hypoparathyroidism, nephropathy, congenital lymphedema, mitral valve prolapse and brachytelephalangy. Additional features include mild facial dysmorphism, hypertrichoses, and nail abnormalities. There have been no further descriptions in the literature since 1993.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dahlberg syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dahlberg-Borer-Newcomer syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lymphedema-hypoparathyroidism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Dahlberg-Borer-Newcomer syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009533</skos:exactMatch>
        <skos:exactMatch>MeSH:C535769</skos:exactMatch>
        <skos:exactMatch>OMIM:247410</skos:exactMatch>
        <skos:exactMatch>UMLS:C1855477</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1563"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Dahlberg-Borer-Newcomer syndrome</owl:annotatedTarget>

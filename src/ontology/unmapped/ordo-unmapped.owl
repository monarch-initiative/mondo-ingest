    <!-- http://www.orpha.net/ORDO/Orphanet_169464 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_169464">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_459348"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

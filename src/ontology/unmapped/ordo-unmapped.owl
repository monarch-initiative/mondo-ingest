        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182047"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309515"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8957"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Paroxysmal nocturnal hemoglobinuria (PNH) is an acquired clonal hematopoietic stem cell disorder characterized by corpuscular hemolytic anemia, bone marrow failure and frequent thrombotic events.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Marchiafava-Micheli disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PNH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Paroxysmal nocturnal hemoglobinuria</oboInOwl:hasExactSynonym>
        <rdfs:label>Paroxysmal nocturnal hemoglobinuria</rdfs:label>
        <skos:exactMatch>ICD-10:D59.5</skos:exactMatch>
        <skos:exactMatch>ICD-11:3A21.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0100244</skos:exactMatch>
        <skos:exactMatch>MeSH:D006457</skos:exactMatch>
        <skos:exactMatch>MedDRA:10034042</skos:exactMatch>
        <skos:exactMatch>OMIM:300818</skos:exactMatch>
        <skos:exactMatch>UMLS:C0024790</skos:exactMatch>
        <skos:narrowMatch>OMIM:615399</skos:narrowMatch>
    </owl:Class>

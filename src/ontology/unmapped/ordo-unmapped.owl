    <!-- http://www.orpha.net/ORDO/Orphanet_412206 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_412206">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_164001"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_420755"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9608"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic odontologic disease characterized by failure of eruption of non-ankylosed permanent teeth without evidence of obvious mechanical obstruction. Posterior teeth are preferentially affected (typically with involvement of all teeth distal to the most mesial non-erupted tooth), resulting in a posterior open bite. Non-ankylosed teeth tend to become ankylosed, and orthodontic treatment of affected teeth is generally unsuccessful.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PFE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary failure of tooth eruption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary retention of teeth</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary failure of tooth eruption</rdfs:label>
        <skos:broadMatch>ICD-10:K00.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:DA07.6Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007434</skos:exactMatch>
        <skos:exactMatch>MeSH:C565114</skos:exactMatch>
        <skos:exactMatch>OMIM:125350</skos:exactMatch>
        <skos:exactMatch>UMLS:C1852222</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_412206"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Primary failure of tooth eruption</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_412217 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_412217">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_391711"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Dystonia-aphonia syndrome is a rare, genetic, persistent combined dystonia disorder characterized by slowly progressive, severe, caudo-rostrally spreading generalized dystonia with prominent facial and oro-mandibular involvement leading to severe anarthria and/or aphonia, swallowing difficulties, and gait disturbances. Additional manifestations include slowed horizontal saccades, subclinical epilepsy, photic myoclonus, oral hypertrophic changes (e.g. gingival or lingual hyperplasia), as well as delayed milestones and cognitive impairment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dystonia-aphonia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Dystonia-aphonia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G24.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0018476</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190573</skos:exactMatch>
    </owl:Class>

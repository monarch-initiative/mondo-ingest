        <skos:broadMatch>OMIM:609508</skos:broadMatch>
        <skos:exactMatch>MONDO:0016202</skos:exactMatch>
        <skos:exactMatch>MeSH:C563710</skos:exactMatch>
        <skos:exactMatch>UMLS:C1836081</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_98759 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98759">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_158266"/>

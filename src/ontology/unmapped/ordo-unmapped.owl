    <!-- http://www.orpha.net/ORDO/Orphanet_603 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_603">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206650"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

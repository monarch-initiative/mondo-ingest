    <!-- http://www.orpha.net/ORDO/Orphanet_79329 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79329">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309347"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371047"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371183"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of disorder of protein N-glycosylation characterized by facial dysmorphism (large, posteriorly rotated ears with prominent antihelices, convex nasal ridge, open mouth, large and crowded teeth), stereotypic hand movements, seizures, and varying degrees of developmental delay. A bleeding tendency is also observed and this results from diminished platelet aggregation. The disease is caused by loss-of-function mutations in the gene &lt;i&gt;MGAT2&lt;/i&gt; (14q21).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type IIa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG-IIa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG2A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Carbohydrate deficient glycoprotein syndrome type IIa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 2a</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type IIa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MGAT2-CDG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">N-acetylglucosaminyltransferase 2 deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>MGAT2-CDG</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C54.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008908</skos:exactMatch>
        <skos:exactMatch>MeSH:C535752</skos:exactMatch>
        <skos:exactMatch>OMIM:212066</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931008</skos:exactMatch>
    </owl:Class>

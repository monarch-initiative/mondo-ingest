            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare oligosaccharidosis characterized by facial dysmorphism, progressive intellectual disability and psychomotor deterioration due to accumulation of glycoasparagines in tissues and body fluids.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Aspartylglucosaminidase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Aspartylglucosaminuria</oboInOwl:hasExactSynonym>

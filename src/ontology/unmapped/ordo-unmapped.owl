    <!-- http://www.orpha.net/ORDO/Orphanet_268882 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_268882">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268843"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2891"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A central nervous system malformation characterized by caudal displacement of the cerebellar tonsils exceeding 5mm below the foramen magnum with or without syringomyelia. Symptoms vary in onset and severity and include suboccipital headache, neck pain, vertigo, tinnitus, ocular symptoms (diplopia, blurred vision, photofobia, nystagmus), lower cranial nerve signs, cerebellar ataxia, and spasticity. Some affected individuals can be asymptomatic.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arnold-Chiari malformation type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Arnold-Chiari malformation type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chiari malformation type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chiari malformation type I</oboInOwl:hasExactSynonym>
        <rdfs:label>Arnold-Chiari malformation type I</rdfs:label>
        <skos:broadMatch>ICD-10:Q07.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA07.4</skos:exactMatch>
        <skos:exactMatch>MONDO:0007316</skos:exactMatch>
        <skos:exactMatch>MONDO:7316</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056944</skos:exactMatch>
        <skos:exactMatch>OMIM:118420</skos:exactMatch>
        <skos:exactMatch>UMLS:C0750929</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

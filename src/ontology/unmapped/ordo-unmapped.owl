        <obo:IAO_0000115 xml:lang="en">Xq27.3q28 duplication syndrome is a recently described syndrome characterized by short stature, hypogonadism, developmental delay and facial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dup(X)(q27.3q28)</oboInOwl:hasExactSynonym>

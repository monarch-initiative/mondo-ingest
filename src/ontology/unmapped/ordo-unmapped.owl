    <!-- http://www.orpha.net/ORDO/Orphanet_251279 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251279">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_202948"/>

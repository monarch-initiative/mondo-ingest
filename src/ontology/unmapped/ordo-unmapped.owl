        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716367"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-progressive form of cone photoreceptor dysfunction syndrome characterized by reduced visual acuity, normal fundus appearance and absent or reduced cone responses on electroretinography. In contrast to all other forms of cone dysfunction color vision is normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Oligocone syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oligocone trichromacy</oboInOwl:hasExactSynonym>

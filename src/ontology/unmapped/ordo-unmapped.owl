        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <oboInOwl:hasExactSynonym xml:lang="en">AHC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Adrenal hypoplasia congenita</oboInOwl:hasExactSynonym>

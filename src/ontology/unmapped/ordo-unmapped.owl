                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6708"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An extremely rare genetic syndromic intellectual disability described in less than 20 families to date and characterized by total or partial alopecia associated with intellectual deficit. The syndrome can be associated with other anomalies such as seizures, sensorineural hearing loss, delayed psychomotor development, and/or hypertonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Alopecia-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Perniola-Krajewska-Carnevale syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Alopecia-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008756</skos:exactMatch>
        <skos:exactMatch>MeSH:C536660</skos:exactMatch>

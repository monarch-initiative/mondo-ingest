    <!-- http://www.orpha.net/ORDO/Orphanet_411712 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_411712">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309833"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

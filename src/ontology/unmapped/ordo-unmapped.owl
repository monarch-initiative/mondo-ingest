    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_228379 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_228379">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163585"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90077"/>
        <obo:IAO_0000115 xml:lang="en">Virus-associated trichodysplasia spinulosa is a rare infectious skin disease characterized by the development of follicular papules with keratin spicules in various parts of the body, predominantly in the face (e.g. nose, eyebrows, auricles), that is due to polyomavirus infection in immunocompromized patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cyclosporine-induced folliculodystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pilomatrix dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trichodysplasia spinulosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">VATS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Virus-associated trichodysplasia spinulosa</oboInOwl:hasExactSynonym>
        <rdfs:label>Virus-associated trichodysplasia spinulosa</rdfs:label>
        <skos:broadMatch>ICD-10:L08.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:ED5Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016455</skos:exactMatch>
        <skos:exactMatch>MedDRA:10072358</skos:exactMatch>
        <skos:exactMatch>UMLS:C3267126</skos:exactMatch>
    </owl:Class>

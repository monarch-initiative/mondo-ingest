                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14409"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Progressive polyneuropathy with bilateral striatal necrosis is a rare, genetic disorder of thiamine metabolism and transport characterized by the childhood-onset of recurrent episodes of flaccid paralysis and encephalopathy, associated with bilateral striatal necrosis and chronic progressive axonal polyneuropathy with proximal and distal muscle weakness, areflexia, contractures and foot deformities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Progressive polyneuropathy with bilateral striatal necrosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Progressive polyneuropathy with bilateral striatal necrosis</rdfs:label>

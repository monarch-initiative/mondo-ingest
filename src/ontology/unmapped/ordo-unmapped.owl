        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_98815 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98815">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_726812"/>
        <obo:IAO_0000115 xml:lang="en">A form of rare self-limited childhood occipital epilepsy characterized by focal seizures with autonomic features, such as nausea, vomiting, pallor, and cardiorespiratory changes, in addition to visual disturbances. Patient shows a fluctuation in symptoms and awareness during the same seizure event. Seizures are typically long lasting. This syndrome is the most common cause of afebrile, nonconvulsive status epilepticus in childhood. Seizures typically begin between the ages of 3 and 6, with remission usually occurring within 2 or 3 years. They are usually infrequent, however in some patients they can be frequent or disruptive. There is no impact on neurodevelopment, unlike self-limited childhood focal epilepsies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign childhood occipital epilepsy, Panayiotopoulos type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Early-onset benign childhood occipital epilepsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Panayiotopoulos syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SeLEAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Self-limited epilepsy with autonomic seizures</oboInOwl:hasExactSynonym>
        <rdfs:label>Self-limited epilepsy with autonomic seizures</rdfs:label>
        <skos:broadMatch>ICD-10:G40.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0020307</skos:exactMatch>
        <skos:exactMatch>UMLS:C0393676</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98815"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Self-limited epilepsy with autonomic seizures</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_98816 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98816">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_726812"/>
        <obo:IAO_0000115 xml:lang="en">A form of rare self-limited childhood occipital epilepsy characterized by seizures originating in the occipital lobe, often present with visual phenomena, occurring around 7-16 years. Seizures are typically characterized by sensory visual symptoms with elementary visual phenomena, such as flashing lights, visual distortions, eye deviation, or temporary blindness. Secondary generalized seizures may also occur. The severity and the frequency of the seizures vary among the patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COVE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Childhood occipital visual epilepsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic chilldhood occipital epilepsy-Gastaut type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Late-onset benign childhood occipital epilepsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Childhood occipital visual epilepsy</rdfs:label>
        <skos:broadMatch>ICD-10:G40.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0020308</skos:exactMatch>
        <skos:exactMatch>UMLS:C0393677</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98816"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Childhood occipital visual epilepsy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_98818 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98818">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98259"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4585"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of epileptic encephalopathy with spike-wave activation in sleep (EE-SWAS) characterized by various combinations of acquired cognitive, language, behavioral, and motor deficits associated with marked spike- and- wave activation in sleep. In Landau-Kleffner syndrome (LKS), receptive language is mainly affected, with an acquired auditory verbal agnosia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired epileptic aphasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LKS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Landau-Kleffner syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Landau-Kleffner syndrome</rdfs:label>
        <skos:broadMatch>OMIM:245570</skos:broadMatch>
        <skos:exactMatch>ICD-10:F80.3</skos:exactMatch>
        <skos:exactMatch>ICD-11:8A62.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0009509</skos:exactMatch>
        <skos:exactMatch>MeSH:D018887</skos:exactMatch>
        <skos:exactMatch>MedDRA:10052075</skos:exactMatch>
        <skos:exactMatch>UMLS:C0282512</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98818"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Landau-Kleffner syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_98819 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98819">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98259"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic epilepsy characterized by mostly benign simple or complex partial seizures with autonomic or psychic auras. Seizures occur infrequently, are of short duration and are usually well controlled with medication. Development and cognition are normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial temporal lobe epilepsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial temporal lobe epilepsy</rdfs:label>
        <skos:broadMatch>ICD-10:G40.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.4Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0005115</skos:exactMatch>
        <skos:exactMatch>MONDO:5115</skos:exactMatch>
        <skos:exactMatch>MeSH:C536956</skos:exactMatch>
        <skos:exactMatch>OMIM:608096</skos:exactMatch>
        <skos:exactMatch>UMLS:C1842564</skos:exactMatch>
        <skos:narrowMatch>OMIM:611631</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_98819"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial temporal lobe epilepsy</owl:annotatedTarget>

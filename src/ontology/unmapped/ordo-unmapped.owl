        <obo:IAO_0000115 xml:lang="en">Sympathetic ophthalmia (SO) is a bilateral granulomatous anterior uveitis usually occurring within the three months following trauma or a surgical procedure involving one eye.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Sympathetic ophthalmia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sympathetic uveitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Sympathetic ophthalmia</rdfs:label>
        <skos:broadMatch>ICD-10:H44.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:9B65.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0019198</skos:exactMatch>
        <skos:exactMatch>MeSH:D009879</skos:exactMatch>
        <skos:exactMatch>MedDRA:10042742</skos:exactMatch>
        <skos:exactMatch>UMLS:C0029077</skos:exactMatch>
    </owl:Class>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_35706 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_35706">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_225696"/>

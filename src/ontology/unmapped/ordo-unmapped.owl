        <skos:broadMatch>ICD-11:LD90</skos:broadMatch>
        <skos:exactMatch>MONDO:0010483</skos:exactMatch>
        <skos:exactMatch>OMIM:300912</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305023</skos:exactMatch>
    </owl:Class>

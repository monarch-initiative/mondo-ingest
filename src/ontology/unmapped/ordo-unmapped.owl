        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hand-foot-genital syndrome (HFGS) is a very rare multiple congenital abnormality syndrome characterized by distal limb malformations and urogenital defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HFGS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hand-foot-genital syndrome</oboInOwl:hasExactSynonym>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2828 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2828">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182058"/>

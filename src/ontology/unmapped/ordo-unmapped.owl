            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14957"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary ataxia characterized by adult onset of slowly progressive cerebellar degeneration with gait ataxia, dysmetria, dysarthria, and in some cases diplopia. Cognitive functions are normal, and seizures are absent. Magnetic resonance imaging reveals mild atrophy of the cerebellar vermis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult-onset SCA47</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult-onset spinocerebellar ataxia type 47</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>PUM1-related cerebellar ataxia</oboInOwl:hasExactSynonym>
        <rdfs:label>PUM1-related cerebellar ataxia</rdfs:label>
        <skos:broadMatch>ICD-10:G11.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A03.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0033482</skos:exactMatch>
        <skos:exactMatch>OMIM:617931</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816800</skos:exactMatch>
    </owl:Class>

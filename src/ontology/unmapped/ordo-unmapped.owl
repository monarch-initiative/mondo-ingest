    <!-- http://www.orpha.net/ORDO/Orphanet_157215 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_157215">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_437"/>

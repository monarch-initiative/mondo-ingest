        <skos:exactMatch>MONDO:0019621</skos:exactMatch>
        <skos:exactMatch>UMLS:C3872848</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_91359"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Metatropic dysplasia (MTD) is a rare spondyloepimetaphyseal dysplasia characterized by a long trunk and short limbs in infancy followed by severe and progressive kyphoscoliosis causing a reversal in proportions during childhood (short trunk and long limbs) and a final short stature in adulthood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Metatropic dwarfism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Metatropic dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Metatropic dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0007986</skos:exactMatch>
        <skos:exactMatch>MeSH:C537356</skos:exactMatch>
        <skos:exactMatch>MedDRA:10082970</skos:exactMatch>
        <skos:exactMatch>OMIM:156530</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265281</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2635"/>

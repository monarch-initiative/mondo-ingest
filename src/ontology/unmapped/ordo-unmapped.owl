        <oboInOwl:hasExactSynonym xml:lang="en">Polydactyly-cleft lip/palate-psychomotor retardation syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Váradi syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Váradi-Papp syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Orofaciodigital syndrome type 6</rdfs:label>

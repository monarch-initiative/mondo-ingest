        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare disease, manifesting with idiopathic pulmonary fibrosis, hepatic nodular regenerative hyperplasia leading to portal hypertension and thrombocytopenia due to bone marrow hypoplasia. The condition was associated with 100% mortality.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Pulmonary fibrosis-hepatic hyperplasia-bone marrow hypoplasia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Pulmonary fibrosis-hepatic hyperplasia-bone marrow hypoplasia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:J84.1</skos:broadMatch>

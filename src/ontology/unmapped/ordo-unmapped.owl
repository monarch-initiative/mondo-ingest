    <!-- http://www.orpha.net/ORDO/Orphanet_70476 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_70476">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519280"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93454"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysostosis characterized by the presence of fifteen dorsal vertebrae and rib pairs with a normal complement of lumbar vertebrae. Patients may also present with Hirschsprung&apos;s disease, membraneous imperforate anus with perineal fistula, cryptorchidism, high-arched palate, simian crease and absent nails. There have been no further descriptions in the literature since 1985.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Melhem-Fahl syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Melhem-Fahl syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q76.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.H</skos:broadMatch>
        <skos:exactMatch>MONDO:0016622</skos:exactMatch>
        <skos:exactMatch>MeSH:C537238</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931453</skos:exactMatch>
    </owl:Class>

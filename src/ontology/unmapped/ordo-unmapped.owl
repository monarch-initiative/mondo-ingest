    <!-- http://www.orpha.net/ORDO/Orphanet_2063 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2063">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108973"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139036"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183576"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294955"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_404574"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysostosis syndrome characterized by abnormal fusion of the spleen with the gonad (or more rarely with remnants of the mesonephros), limb abnormalities (consisting of amelia or severe reduction defects leading to upper and/or lower rudimentary limbs) and orofacial abnormalities such as cleft palate, bifid uvula, microglossia and mandibular hypoplasia. It could also be associated with other malformations such as cryptorchidism, anal stenosis/atresia, hypoplastic lungs and cardiac malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SGFLD syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Splenogonadal fusion-limb defects-micrognathia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Splenogonadal fusion-limb defects-micrognathia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008460</skos:exactMatch>
        <skos:exactMatch>MeSH:C537318</skos:exactMatch>
        <skos:exactMatch>OMIM:183300</skos:exactMatch>
        <skos:exactMatch>UMLS:C1866745</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

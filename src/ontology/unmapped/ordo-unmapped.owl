        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Blepharonasofacial syndrome is a rare otorhinolaryngological malformation syndrome characterized by a distinctive mask-like facial dysmorphism, lacrimal duct obstruction, extrapyramidal features, digital malformations and intellectual disability.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Blepharonasofacial malformation syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pashayan syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pashayan-Pruzansky syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Blepharonasofacial malformation syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0007200</skos:exactMatch>
        <skos:exactMatch>MeSH:C536303</skos:exactMatch>
        <skos:exactMatch>OMIM:110050</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796197</skos:exactMatch>
    </owl:Class>

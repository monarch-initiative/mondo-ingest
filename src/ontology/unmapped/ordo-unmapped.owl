    <!-- http://www.orpha.net/ORDO/Orphanet_217008 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_217008">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_715334"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79379"/>
        <obo:IAO_0000115 xml:lang="en">A rare vascular anomaly characterized by congenital, progressive, circumscribed venous malformations (phlebectasias) primarily involving the upper and/or lower extremities, either on one side or bilaterally. The malformed vessels are visible beneath the skin. Veins of all sizes are affected. Pain, swelling, muscle wasting, and ulceration may occur.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bockenheimer syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Extensive venous malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Genuine diffuse phlebectasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Segmental venous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Segmental venous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LC51</skos:broadMatch>
        <skos:exactMatch>MONDO:0016311</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679814</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_217008"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Segmental venous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_217012 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_217012">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_94148"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/24160"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An autosomal dominant cerebellar ataxia type III that is characterized by the late-onset of ataxia, dysarthria and horizontal gaze nystagmus, and that is occasionally accompanied by pyramidal signs, tremor, decreased vibration sense and hearing difficulties.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA31</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 31</oboInOwl:hasExactSynonym>
        <rdfs:label>Spinocerebellar ataxia type 31</rdfs:label>
        <skos:broadMatch>ICD-10:G11.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A03.16</skos:broadMatch>
        <skos:exactMatch>MONDO:0007296</skos:exactMatch>
        <skos:exactMatch>MeSH:C566146</skos:exactMatch>
        <skos:exactMatch>OMIM:117210</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861736</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_217012"/>

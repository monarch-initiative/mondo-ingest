    <!-- http://www.orpha.net/ORDO/Orphanet_352670 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_352670">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

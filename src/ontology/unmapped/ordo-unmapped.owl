    <!-- http://www.orpha.net/ORDO/Orphanet_171844 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171844">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139030"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519292"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522554"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716405"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic ectopia lentis characterized by progressive visual loss leading to blindness, spinal deformities such as scoliosis or kyphoscoliosis, and arachnodactyly (abnormally long, slender fingers and toes). Visual impairment often begins in childhood due to lens luxation and retinal complications. Male patients typically present with the full phenotype, whereas females may exhibit only blindness. No other associated skeletal, skin, joint, or visceral abnormalities have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Blindness-scoliosis-arachnodactyly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Blindness-scoliosis-arachnodactyly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD28.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012907</skos:exactMatch>
        <skos:exactMatch>OMIM:612445</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303548</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_171844"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Blindness-scoliosis-arachnodactyly syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_171848 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171848">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207015"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_352309"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716405"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15868"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic syndrome with peripheral neuropathy characterized by polyneuropathy, hearing loss, ataxia, retinitis pigmentosa, and cataracts. Polyneuropathy presents with slowly progressive and often demyelinating sensorimotor neuropathy where pes cavus, decreased sensation and hyporeflexia may appear as early signs. Hearing loss is progressive, usually bilateral and presents with childhood/early adolescent-onset whereas patients develop retinis pigmentosa and cataracts (typically posterior subcapsular) often in early to mid-adulthood. Ataxia may manifest with gait instability/spasticity, dysarthria, intention tremor and dysmetria of the limbs. Additional clinical features may include tendon abnormalities, hyperreflexia, extensor plantar responses. Seizures and mild intellectual disability is reported in few patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PHARC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Peripheral neuropathy, Fiskerstrand type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Polyneuropathy-deafness-ataxia-retinitis pigmentosa-cataract syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polyneuropathy-hearing loss-ataxia-retinitis pigmentosa-cataract syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Polyneuropathy-hearing loss-ataxia-retinitis pigmentosa-cataract syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G60.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012984</skos:exactMatch>
        <skos:exactMatch>OMIM:612674</skos:exactMatch>
        <skos:exactMatch>UMLS:C4509920</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_171848"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Polyneuropathy-hearing loss-ataxia-retinitis pigmentosa-cataract syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



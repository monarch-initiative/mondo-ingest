    <!-- http://www.orpha.net/ORDO/Orphanet_67 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_67">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163588"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A parasitic disease caused by the protozoa, &lt;i&gt;Entamoeba histolytica&lt;/i&gt;, mainly occurring in tropical regions after the ingestion of an amoebic cyst, and resulting in clinical manifestations that may range from an asymptomatic state to amoebic colitis (violent abdominal pain, a painful contracted feeling around the anal sphincter, blood and mucus in the stools but without the presence of fever), or amoebic liver abscesses (fever, chills, abdominal pain, weight loss, hepatomegaly) that can be fatal if not immediately treated. Extraintestinal involvement elsewhere (i.e. thoracic, hepatic) is extremely rare.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Amoebiasis due to Entamoeba histolytica</oboInOwl:hasExactSynonym>
        <rdfs:label>Amoebiasis due to Entamoeba histolytica</rdfs:label>
        <skos:exactMatch>ICD-11:1A36</skos:exactMatch>
        <skos:exactMatch>MONDO:0019028</skos:exactMatch>

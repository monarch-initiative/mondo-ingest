                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/986"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Intermittent maple syrup urine disease (intermittent MSUD) is a mild form of MSUD where patients (when well) are asymptomatic with normal levels of branched-chain amino acids (BCAAs) but with catabolic stress are at risk of acute decompensation with ketoacidosis, which can lead to cerebral edema and coma if untreated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Intermittent BCKD deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intermittent MSUD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Intermittent branched-chain alpha-ketoacid dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Intermittent maple syrup urine disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Intermittent maple syrup urine disease</rdfs:label>

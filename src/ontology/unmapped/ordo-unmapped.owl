        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98300"/>
        <obo:IAO_0000115 xml:lang="en">Respiratory bronchiolitis - interstitial lung disease is a mild inflammatory pulmonary disorder developed by cigarette smokers and characterized by shortness of breath and cough, pulmonary function abnormalities of mixed restrictive and obstructive lung disease and high resolution CT scanning showing centrilobular micronodules, ground glass opacities and peribronchiolar thickening.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">RB-ILD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Respiratory bronchiolitis-interstitial lung disease syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Respiratory bronchiolitis-interstitial lung disease syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:J68.4</skos:broadMatch>
        <skos:exactMatch>ICD-11:CB03.6</skos:exactMatch>
        <skos:exactMatch>MONDO:0019204</skos:exactMatch>
        <skos:exactMatch>MedDRA:10066393</skos:exactMatch>
        <skos:exactMatch>UMLS:C1735355</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_79127"/>

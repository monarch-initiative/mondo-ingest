    <!-- http://www.orpha.net/ORDO/Orphanet_370968 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_370968">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309469"/>

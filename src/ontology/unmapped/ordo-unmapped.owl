    <!-- http://www.orpha.net/ORDO/Orphanet_3085 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3085">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156165"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522548"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic retinitis pigmentosa characterized by pigmentary retinopathy, diabetes mellitus with hyperinsulinism, acanthosis nigricans, secondary cataracts, neurogenic deafness, short stature mild hypogonadism in males and polycystic ovaries with oligomenorrhea in females. Inheritance is thought to be autosomal recessive. It can be distinguished from Alstrom syndrome by the presence of intellectual disability and the absence of renal insufficiency. There have been no further descriptions in the literature since 1993.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Edwards-Sethi syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Retinitis pigmentosa-intellectual disability- labyrinthine deafness-hypogenitalism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Retinitis pigmentosa-intellectual disability-deafness-hypogonadism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Retinitis pigmentosa-intellectual disability-sensorineural hearing loss-hypogenitalism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Retinitis pigmentosa-intellectual disability-deafness-hypogonadism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009983</skos:exactMatch>
        <skos:exactMatch>OMIM:268020</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518330</skos:exactMatch>
    </owl:Class>

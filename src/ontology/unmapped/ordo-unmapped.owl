            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare autosomal dominant association characterized clinically by juvenile cataract associated with bilateral microcornea, and renal glucosuria without other renal tubular defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Juvenile cataract-microcornea-renal glucosuria syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile cataract-microcornea-renal glycosuria syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Juvenile cataract-microcornea-renal glucosuria syndrome</rdfs:label>

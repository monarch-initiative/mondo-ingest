        <skos:exactMatch>MONDO:0007405</skos:exactMatch>
        <skos:exactMatch>OMIM:123500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0010273</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

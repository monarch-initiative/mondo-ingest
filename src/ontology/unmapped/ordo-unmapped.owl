                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/18305"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">X-linked intellectual disability, Hedera type is a rare X-linked intellectual disability syndrome characterized by an onset in infancy of delayed motor and speech milestones, generalized tonic-clonic seizures and drop attacks, and mild to moderate intellectual disability. Additional, less common manifestations include scoliosis, ataxia (resulting in progressive gait disturbance), and bilateral pes planovalgus. Physical appearance is normal with no dysmorphic features reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MRXSH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked intellectual disability, Hedera type</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked intellectual disability, Hedera type</rdfs:label>
        <skos:broadMatch>ICD-10:G25.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90</skos:broadMatch>
        <skos:exactMatch>MONDO:0010319</skos:exactMatch>
        <skos:exactMatch>MeSH:C564516</skos:exactMatch>
        <skos:exactMatch>OMIM:300423</skos:exactMatch>
        <skos:exactMatch>UMLS:C1845543</skos:exactMatch>
    </owl:Class>

        <oboInOwl:hasExactSynonym xml:lang="en">Sensorineural deafness with imperforate anus and hypoplastic thumbs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sensorineural hearing loss with imperforate anus and hypoplastic thumbs</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_703 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_703">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

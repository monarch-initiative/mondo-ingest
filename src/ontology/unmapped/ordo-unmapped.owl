    <!-- http://www.orpha.net/ORDO/Orphanet_79477 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79477">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_331249"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_381"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79391"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare subtype of Griscelli syndrome characterized by pigmentary dilution in skin and hair with irregular clumps of pigment in hair shafts resulting in silvery hair, in association with increased susceptibility to recurrent infections and immunological abnormalities, in particular impairment of T-cell and natural killer cytotoxic activity eventually leading to hemophagocytic lymphohistiocytosis. Patients may present neurological manifestations related to infiltration of the central nervous system in the context of the hemophagocytic syndrome. The disease is mostly fatal in the first decade of life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Griscelli syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Griscelli-Pruniéras syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypopigmentation-immunodeficiency with or without neurologic impairment syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Griscelli syndrome type 2</rdfs:label>
        <skos:broadMatch>ICD-10:E70.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.23</skos:broadMatch>
        <skos:exactMatch>MONDO:0011872</skos:exactMatch>
        <skos:exactMatch>MeSH:C537302</skos:exactMatch>
        <skos:exactMatch>OMIM:607624</skos:exactMatch>
        <skos:exactMatch>UMLS:C1868679</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_79477"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Griscelli syndrome type 2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



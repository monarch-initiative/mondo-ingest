    <!-- http://www.orpha.net/ORDO/Orphanet_576349 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_576349">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290842"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_324924"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_622720"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16412"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary periodic fever syndrome characterized by infantile or childhood onset of episodes of fever and cold-induced urticaria-like rash and arthralgias. Ocular features such as conjunctivitis and uveitis may also be present. Presentation is typically mild, and symptoms resolve without treatment in most cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FCAS4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial cold autoinflammatory syndrome 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>NLRC4-related familial cold autoinflammatory syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NLRC4-related familial cold urticaria</oboInOwl:hasExactSynonym>
        <rdfs:label>NLRC4-related familial cold autoinflammatory syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D89.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A60.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0014498</skos:exactMatch>
        <skos:exactMatch>OMIM:616115</skos:exactMatch>
        <skos:exactMatch>UMLS:C4015276</skos:exactMatch>
    </owl:Class>

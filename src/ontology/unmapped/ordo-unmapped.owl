        <skos:broadMatch>ICD-11:5C63.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007272</skos:exactMatch>
        <skos:exactMatch>OMIM:115300</skos:exactMatch>
        <skos:exactMatch>UMLS:C4511672</skos:exactMatch>
        <skos:narrowMatch>OMIM:277350</skos:narrowMatch>
    </owl:Class>

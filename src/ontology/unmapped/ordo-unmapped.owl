    <!-- http://www.orpha.net/ORDO/Orphanet_1412 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1412">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93459"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7866"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Tarsal-carpal coalition syndrome is characterised by fusion of the carpals, tarsals, and phalanges.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Tarsal-carpal coalition syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Tarsal-carpal coalition syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0008521</skos:exactMatch>
        <skos:exactMatch>MeSH:C536943</skos:exactMatch>
        <skos:exactMatch>OMIM:186570</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861305</skos:exactMatch>
        <skos:narrowMatch>OMIM:186400</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1412"/>

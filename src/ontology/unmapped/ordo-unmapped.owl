    <!-- http://www.orpha.net/ORDO/Orphanet_168598 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168598">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79173"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6903"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism characterized by persistently elevated serum methionine levels. Half of patients reported with MAT I/III deficiency, notably those with hypermethioninemia below 800 µM, have no CNS abnormalities and are clinically asymptomatic. However, individuals with higher levels might show evidence of central nervous system abnormalities, most notably hypo- or demyelination on brain MRI, as well as developmental delay and intellectual disability. Bad breath or a strong smell of urine and sweat may be noted in some patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MAT I/III deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Methionine adenosyltransferase I/III deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mudd&apos;s disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Methionine adenosyltransferase I/III deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.B</skos:broadMatch>
        <skos:exactMatch>MONDO:0009607</skos:exactMatch>
        <skos:exactMatch>MONDO:9607</skos:exactMatch>
        <skos:exactMatch>OMIM:250850</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268621</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_168598"/>

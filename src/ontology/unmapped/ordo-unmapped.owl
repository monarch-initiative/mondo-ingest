        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_280065 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280065">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_280062"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79379"/>
        <obo:IAO_0000115 xml:lang="en">A rare, life-threatening, non-inflammatory vasculopathy characterized clinically by progressive and painful skin lesions associated with calcification of cutaneous arterial microvessels. Calciphylaxis predominantly affects patients with end-stage kidney disease (ESKD) on dialysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Calciphylaxis cutis</oboInOwl:hasExactSynonym>
        <rdfs:label>Calciphylaxis cutis</rdfs:label>
        <skos:broadMatch>ICD-10:E83.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:EB90.42</skos:broadMatch>
        <skos:exactMatch>MONDO:0017216</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274083</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_280065"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Calciphylaxis cutis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_280068 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280068">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_280062"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare, life-threatening, non-inflammatory vasculopathy characterized by diffuse precipitation of calcium in viscera (mainly in the heart or lungs, but also in the stomach or kidneys) leading to fibrosis and thrombosis, which eventually causes tissue necrosis. Depending on the affected organ, patients may present with dyspnea, cough and respiratory failure or acute heart block and subsequent sudden cardiac death. The disease predominantly affects patients with end-stage kidney disease (ESKD) on dialysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Visceral calciphylaxis</oboInOwl:hasExactSynonym>
        <rdfs:label>Visceral calciphylaxis</rdfs:label>
        <skos:broadMatch>ICD-10:E83.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:EB90.42</skos:broadMatch>
        <skos:exactMatch>MONDO:0017217</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749793</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_280068"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Visceral calciphylaxis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_280071 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280071">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309347"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371071"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/32456"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of congenital disorders of N-linked glycosylation characterized by facial dysmorphism (microcephaly, high forehead, low posterior hairline, strabismus), hypotonia, failure to thrive, intractable seizures, developmental delay, persistent vomiting and gastric bleeding. Additional features that may be observed include fat pads anomalies, inverted nipples, and body temperature oscillation. The disease is caused by mutations in the gene &lt;i&gt;ALG11&lt;/i&gt; (13q14.3).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ALG11-CDG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG syndrome type Ip</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG-Ip</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDG1P</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Carbohydrate deficient glycoprotein syndrome type Ip</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type 1p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital disorder of glycosylation type Ip</oboInOwl:hasExactSynonym>
        <rdfs:label>ALG11-CDG</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C54.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0013349</skos:exactMatch>
        <skos:exactMatch>OMIM:613661</skos:exactMatch>
        <skos:exactMatch>UMLS:C3150913</skos:exactMatch>
    </owl:Class>

        <skos:narrowMatch>OMIM:163800</skos:narrowMatch>
        <skos:narrowMatch>OMIM:182190</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614090</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619464</skos:narrowMatch>
    </owl:Class>

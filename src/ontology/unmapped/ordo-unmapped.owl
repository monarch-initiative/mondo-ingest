    <!-- http://www.orpha.net/ORDO/Orphanet_1390 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1390">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>

        <obo:IAO_0000115 xml:lang="en">A rare otorhinolaryngologic disease characterized by adult-onset progressive enophthalmos due to collapse of some or all of the maxillary sinus walls and remodeling of the orbital floor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CMA grade 3</oboInOwl:hasExactSynonym>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genodermatosis characterized by a hair shaft dysplasia resulting in hypotrichosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Monilethrix</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Moniliform hair syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Monilethrix</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.1</skos:broadMatch>

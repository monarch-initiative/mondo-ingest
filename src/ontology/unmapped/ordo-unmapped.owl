    <!-- http://www.orpha.net/ORDO/Orphanet_67038 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_67038">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_300842"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>

        <skos:exactMatch>ICD-11:5C50.21</skos:exactMatch>
        <skos:exactMatch>MONDO:0010167</skos:exactMatch>
        <skos:exactMatch>MeSH:C536479</skos:exactMatch>
        <skos:exactMatch>OMIM:276880</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268514</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79215"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A very rare lysosomal storage disease that is clinically and pathologically heterogeneous and is characterized by deficient NAGA activity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Alpha-N-acetylgalactosaminidase deficiency</oboInOwl:hasExactSynonym>

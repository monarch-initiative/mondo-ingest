    <!-- http://www.orpha.net/ORDO/Orphanet_1116 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1116">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117569"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139027"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165655"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183481"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_568044"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79380"/>
        <obo:IAO_0000115 xml:lang="en">An extremely rare association syndrome, described in only two brothers to date (one of which died at 2 months of age), characterized by aplasia cutis congenita of the vertex and generalized edema (as well as hypoproteinemia and lymphopenia) due to intestinal lymphangiectasia. There have been no further descriptions in the literature since 1985.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aplasia cutis congenita-intestinal lymphangiectasia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bronspiegel-Zelnick syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Aplasia cutis congenita-intestinal lymphangiectasia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008808</skos:exactMatch>
        <skos:exactMatch>MeSH:C537788</skos:exactMatch>
        <skos:exactMatch>OMIM:207731</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304031</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1116"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Aplasia cutis congenita-intestinal lymphangiectasia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1117 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1117">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139027"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183481"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716405"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79380"/>
        <obo:IAO_0000115 xml:lang="en">A rare disorder characterised by the association of aplasia cutis congenita with high myopia, congenital nystagmus and cone-rod dysfunction. It has been described in two siblings (brother and sister).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aplasia cutis-myopia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Gershoni-Baruch-Leibo syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Aplasia cutis-myopia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010988</skos:exactMatch>
        <skos:exactMatch>OMIM:601075</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304032</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1117"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Aplasia cutis-myopia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1118 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1118">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294957"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498477"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, congenital dysostosis disorder characterized by fibular aplasia (or hypoplasia) associated with ectrodactyly and/or brachydactyly or syndactyly. Additional variable features include shortening of the femur, as well as tibial, hip, knee, and/or ankle defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fibular aplasia-ectrodactyly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Fibular aplasia-ectrodactyly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0007225</skos:exactMatch>
        <skos:exactMatch>MeSH:C537930</skos:exactMatch>
        <skos:exactMatch>OMIM:113310</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303759</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1118"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Fibular aplasia-ectrodactyly syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_112 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_112">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183592"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93603"/>
        <obo:IAO_0000115 xml:lang="en">Bartter syndrome is a group of rare renal tubular disease characterized by impaired salt reabsorption in the thick ascending limb of Henle&apos;s loop and clinically by the association of hypokalemic alkalosis, hypercalciuria/nephrocalcinosis, increased levels of plasma renin and aldosterone, low blood pressure and vascular resistance to angiotensin II.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bartter syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Renal tubular normotensive hypokalemic alkalosis with hypercalciuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Salt-losing tubular disorder, Henle&apos;s loop type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Salt-wasting tubulopathy, Henle&apos;s loop type</oboInOwl:hasExactSynonym>
        <rdfs:label>Bartter syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E26.8</skos:broadMatch>
        <skos:broadMatch>OMIM:601198</skos:broadMatch>
        <skos:exactMatch>ICD-11:GB90.43</skos:exactMatch>
        <skos:exactMatch>MONDO:0015231</skos:exactMatch>
        <skos:exactMatch>MeSH:D001477</skos:exactMatch>
        <skos:exactMatch>MedDRA:10050839</skos:exactMatch>
        <skos:exactMatch>UMLS:C0004775</skos:exactMatch>
        <skos:narrowMatch>OMIM:241200</skos:narrowMatch>
        <skos:narrowMatch>OMIM:300971</skos:narrowMatch>
        <skos:narrowMatch>OMIM:601678</skos:narrowMatch>
        <skos:narrowMatch>OMIM:602522</skos:narrowMatch>
        <skos:narrowMatch>OMIM:607364</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613090</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_112"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Bartter syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1120 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1120">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108993"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108995"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182111"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183622"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by the association of unilateral complete or partial lung agenesis, complex congenital cardiac anomalies such as atrial septal defect, total anomalous pulmonary venous return, or patent ductus arteriosus, and ipsilateral or bilateral thumb abnormalities. Presence of facial dysmorphism and other malformative features has also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lung agenesis-heart defect-thumb anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mardini-Nyhan syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lung agenesis-heart defect-thumb anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011116</skos:exactMatch>
        <skos:exactMatch>OMIM:601612</skos:exactMatch>
        <skos:exactMatch>UMLS:C4302918</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1120"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lung agenesis-heart defect-thumb anomalies syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1121 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1121">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294957"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Radial deficiency-tibial hypoplasia syndrome is a rare, genetic dysostosis syndrome with combined reduction defects of upper and lower limbs characterized by bilateral radial aplasia, absent thumbs and bilateral tibial hypo/aplasia. Additional bone anomalies (including partial toe hypo/aplasia, short fibula and clubhand) may be associated. There have been no further descriptions in the literature since 1996.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Radial deficiency-tibial hypoplasia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Radial deficiency-tibial hypoplasia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0015232</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190823</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1121"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Radial deficiency-tibial hypoplasia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1122 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1122">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294957"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysostosis with combined reduction of upper and lower limbs characterized by severe ulnar hypoplasia, absence of fingers two to five, and split-foot. Mostly both hands and feet are affected. Patients may also present with curved and broad radius with cortical thickening. There have been no further descriptions in the literature since 1978.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ulnar hypoplasia-lobster-claw deformity of feet syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ulnar hypoplasia-split foot syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Van den Berghe-Dequecker syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Ulnar hypoplasia-split foot syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q73.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0010750</skos:exactMatch>
        <skos:exactMatch>MeSH:C536936</skos:exactMatch>
        <skos:exactMatch>OMIM:314360</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518553</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1122"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ulnar hypoplasia-split foot syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1123 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1123">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by caudal appendage, short terminal phalanges and deafness. Additional clinical features may include short stature, intellectual disability, facial dysmorphism and cryptorchidism. There have been no further descriptions in the literature since 1994.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Caudal appendage-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Caudal appendage-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lynch-Lee-Murday syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Caudal appendage-deafness syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015233</skos:exactMatch>
        <skos:exactMatch>MeSH:C537713</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931593</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1123"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Caudal appendage-deafness syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1125 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1125">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98688"/>
        <obo:IAO_0000115 xml:lang="en">Ocular motor apraxia, Cogan type is characterised by impairment of voluntary horizontal eye movements and compensatory head thrust. Around 50 cases have been described so far. The oculomotor manifestations tend to improve with age but the syndrome may also be associated with learning and speech difficulties, or, in some cases, cerebral malformations. Both sporadic and familial forms have been described, with sporadic forms being more frequent. The mode of transmission of the familial form has not yet been clearly established. A gene located on the long arm of chromosome 2, near to the &lt;i&gt;NPHP1&lt;/i&gt; gene involved in nephronophthisis, may be associated with ocular motor apraxia, Cogan type.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ocular motor apraxia, Cogan type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Oculomotor apraxia, Cogan type</oboInOwl:hasExactSynonym>
        <rdfs:label>Ocular motor apraxia, Cogan type</rdfs:label>
        <skos:broadMatch>ICD-10:H51.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9C82.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0009764</skos:exactMatch>
        <skos:exactMatch>MeSH:C537423</skos:exactMatch>
        <skos:exactMatch>OMIM:257550</skos:exactMatch>
        <skos:exactMatch>UMLS:C0543874</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1125"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ocular motor apraxia, Cogan type</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1126 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1126">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268926"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic non-syndromic central nervous system malformation characterized by absence of the telencephalon and absent or abnormal diencephalic structures, combined with severe abnormalities of the mesencephalon and cerebellum. Further malformations, for example of the hands and feet, have been described in addition.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Aprosencephaly cerebellar dysgenesis</oboInOwl:hasExactSynonym>
        <rdfs:label>Aprosencephaly cerebellar dysgenesis</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA05.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011062</skos:exactMatch>
        <skos:exactMatch>MeSH:C563331</skos:exactMatch>
        <skos:exactMatch>OMIM:601374</skos:exactMatch>
        <skos:exactMatch>UMLS:C1832412</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1126"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Aprosencephaly cerebellar dysgenesis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1129 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1129">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <obo:IAO_0000115 xml:lang="en">A multiple congenital developmental anomalies syndrome characterized by arachnodactyly of fingers and toes associated with craniofacial dysmorphism (including abnormal cranial ossification, frontal bossing, flat calvaria, shallow deformed orbits resulting in exophthalmos, midface hypoplasia and micrognathia), feeding difficulties in infancy, infantile muscular hypotonia, and developmental delay leading to intellectual disability.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Arachnodactyly-abnormal ossification-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Kosztolanyi syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Arachnodactyly-abnormal ossification-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0015234</skos:exactMatch>
        <skos:exactMatch>MeSH:C537024</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931398</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1129"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Arachnodactyly-abnormal ossification-intellectual disability syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_113 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_113">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139027"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183487"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <obo:IAO_0000115 xml:lang="en">Bazex-Dupré-Christol syndrome is a rare genodermatosis with a predisposition to early-onset basal cell carcinomas.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BDCS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bazex-Dupré-Christol syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Follicular atrophoderma and basal cell carcinomas</oboInOwl:hasExactSynonym>
        <rdfs:label>Bazex-Dupré-Christol syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0010535</skos:exactMatch>
        <skos:exactMatch>MeSH:C537663</skos:exactMatch>
        <skos:exactMatch>OMIM:301845</skos:exactMatch>
        <skos:exactMatch>UMLS:C0346104</skos:exactMatch>
    </owl:Class>

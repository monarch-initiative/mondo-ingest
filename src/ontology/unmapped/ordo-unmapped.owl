    <!-- http://www.orpha.net/ORDO/Orphanet_286 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_286">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_285014"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98249"/>

        <skos:broadMatch>ICD-11:LD24.8Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0011907</skos:exactMatch>
        <skos:exactMatch>MeSH:C564334</skos:exactMatch>
        <skos:exactMatch>OMIM:607778</skos:exactMatch>
        <skos:exactMatch>UMLS:C1843096</skos:exactMatch>
    </owl:Class>

        <obo:IAO_0000115 xml:lang="en">Xeroderma pigmentosum (XP) is a rare genodermatosis characterized by extreme sensitivity to ultraviolet (UV)-induced changes in the skin and eyes, and multiple skin cancers. It is subdivided into 8 complementation groups, according to the affected gene: classical XP (XPA to XPG) and XP variant (XPV).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Xeroderma pigmentosum</oboInOwl:hasExactSynonym>
        <rdfs:label>Xeroderma pigmentosum</rdfs:label>
        <skos:exactMatch>ICD-10:Q82.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:LD27.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0019600</skos:exactMatch>

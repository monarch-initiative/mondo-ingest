        <obo:IAO_0000115 xml:lang="en">A rare systemic disease characterized by the accumulation (usually organized in granulomas) of macrophage, bearing the features of Langerhans cells in various tissues.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Histiocytosis X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Langerhans cell granulomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Langerhans cell histiocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Langerhans cell histiocytosis</rdfs:label>
        <skos:exactMatch>ICD-11:2B31.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0018310</skos:exactMatch>
        <skos:exactMatch>MeSH:D006646</skos:exactMatch>
        <skos:exactMatch>MedDRA:10069698</skos:exactMatch>
        <skos:exactMatch>OMIM:604856</skos:exactMatch>
        <skos:exactMatch>UMLS:C0019621</skos:exactMatch>
        <skos:narrowMatch>ICD-10:C96.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C96.5</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C96.6</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:2B31.20</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:2B31.2Y</skos:narrowMatch>
    </owl:Class>

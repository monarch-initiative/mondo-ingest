    <!-- http://www.orpha.net/ORDO/Orphanet_171 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_447771"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10732"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Primary sclerosing cholangitis (PSC) is a rare, slowly progressive liver disease characterized by inflammation and destruction of the intra- and/or extra-hepatic bile ducts that lead to cholestasis, liver fibrosis, liver cirrhosis and ultimately liver failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PSC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary sclerosing cholangitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary sclerosing cholangitis</rdfs:label>
        <skos:broadMatch>ICD-10:K83.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:DB96.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0013433</skos:exactMatch>
        <skos:exactMatch>MedDRA:10036732</skos:exactMatch>
        <skos:exactMatch>OMIM:613806</skos:exactMatch>
        <skos:exactMatch>UMLS:C0566602</skos:exactMatch>
        <skos:narrowMatch>OMIM:602114</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_171"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Primary sclerosing cholangitis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1711 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1711">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98131"/>
        <obo:IAO_0000115 xml:lang="en">Mosaic trisomy 17 is a rare chromosomal anomaly syndrome, with a highly variable clinical presentation, mostly characterized by growth delay, intellectual disability, body asymmetry with leg length differentiation, scoliosis, and congenital heart anomalies (e.g. ventricular septal defect). Prenatal ultrasound findings include intrauterine growth retardation, nuchal thickening brain anomalies (e.g. cerebellar hypoplasia), pleural effusion and single umbilical artery. Patients with no associated malformations have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mosaic trisomy 17 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mosaic trisomy chromosome 17</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 17 mosaicism</oboInOwl:hasExactSynonym>
        <rdfs:label>Mosaic trisomy 17 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD40.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0015730</skos:exactMatch>
        <skos:exactMatch>UMLS:C1096168</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1711"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mosaic trisomy 17 syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/27310"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited cancer-predisposing syndrome characterized by skin lesions, benign and malignant kidney tumors, and pulmonary cysts that may be associated with pneumothorax.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Birt-Hogg-Dubé syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hornstein-Knickenberg syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Birt-Hogg-Dubé syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:C64</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0800445</skos:exactMatch>

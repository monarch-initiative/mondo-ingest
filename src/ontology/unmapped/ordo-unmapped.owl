            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary skin disease characterized by irregularly distributed epidermal papular/punctate hyperkeratosis of the palms and soles with wide variation among patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Buschke-Fischer-Brauer syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratodermia palmoplantaris papulosa, Buschke-Fischer-Brauer type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PPKP1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Punctate palmoplantar keratoderma type 1</oboInOwl:hasExactSynonym>

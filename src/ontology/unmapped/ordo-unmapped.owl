    <!-- http://www.orpha.net/ORDO/Orphanet_221117 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_221117">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

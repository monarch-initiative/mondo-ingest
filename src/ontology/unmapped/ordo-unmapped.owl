        <skos:exactMatch>OMIM:612423</skos:exactMatch>
        <skos:exactMatch>UMLS:C0272339</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_749"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital prekallikrein deficiency</owl:annotatedTarget>

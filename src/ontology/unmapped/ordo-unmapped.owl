        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6597"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Stüve-Wiedemann syndrome (SWS) is a rare autosomal recessive congenital primary skeletal dysplasia, characterized by small stature, bowing of the long bones, camptodactyly, hyperthermic episodes, respiratory distress/apneic episodes and feeding difficulties that usually lead to early mortality.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Neonatal Schwartz-Jampel syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SJS2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">STWS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SWS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Schwartz-Jampel syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stüve-Wiedemann dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Stüve-Wiedemann syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stüve-Wiedemann syndrome type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Stüve-Wiedemann syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.C</skos:broadMatch>
        <skos:exactMatch>MONDO:0800043</skos:exactMatch>
        <skos:exactMatch>MeSH:C537502</skos:exactMatch>
        <skos:exactMatch>OMIM:601559</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796176</skos:exactMatch>
    </owl:Class>

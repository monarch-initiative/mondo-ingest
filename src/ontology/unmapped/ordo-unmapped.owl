                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30521"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hereditary folate malabsorption (HFM) is an inherited disorder of folate transport characterized by a systemic and central nervous system (CNS) folate deficiency manifesting as megaloblastic anemia, failure to thrive, diarrhea and/or oral mucositis, immunologic dysfunction and neurological disorders.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital folate malabsorption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary folate malabsorption</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary folate malabsorption</rdfs:label>
        <skos:broadMatch>ICD-10:E53.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C63.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0009238</skos:exactMatch>
        <skos:exactMatch>MeSH:C562799</skos:exactMatch>
        <skos:exactMatch>OMIM:229050</skos:exactMatch>
        <skos:exactMatch>UMLS:C0342705</skos:exactMatch>
    </owl:Class>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Progressive familial intrahepatic cholestasis type 2 (PFIC2), a type of progressive familial intrahepatic cholestasis (PFIC), is a severe, neonatal, hereditary disorder in bile formation that is hepatocellular in origin and not associated with extrahepatic features. Initially, PFIC2 was reported under the name Byler syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BSEP deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PFIC2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progressive familial intrahepatic cholestasis type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Progressive familial intrahepatic cholestasis type 2</rdfs:label>
        <skos:broadMatch>ICD-10:K76.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C58.03</skos:broadMatch>
        <skos:exactMatch>MONDO:0011156</skos:exactMatch>

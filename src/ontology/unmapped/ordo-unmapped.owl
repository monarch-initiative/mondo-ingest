    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1879 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1879">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2781"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

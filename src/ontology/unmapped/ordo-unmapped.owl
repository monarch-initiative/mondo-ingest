    <!-- http://www.orpha.net/ORDO/Orphanet_171876 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_171876">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

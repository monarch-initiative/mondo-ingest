        <oboInOwl:hasExactSynonym xml:lang="en">LGMD2E</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Limb-girdle muscular dystrophy due to beta-sarcoglycan deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Limb-girdle muscular dystrophy type 2E</oboInOwl:hasExactSynonym>

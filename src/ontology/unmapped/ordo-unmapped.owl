            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, non-syndromic, obesity disease characterized by severe, early-onset obesity, associated with major hyperphagia and endocrine abnormalities, resulting from leptin receptor deficiency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Obesity due to leptin receptor gene deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Obesity due to leptin receptor gene deficiency</rdfs:label>

        <rdfs:label>1q41q42 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0012927</skos:exactMatch>
        <skos:exactMatch>OMIM:612530</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274528</skos:exactMatch>
    </owl:Class>

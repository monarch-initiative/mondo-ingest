    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_459074 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_459074">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_166463 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_166463">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101998"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183512"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <oboInOwl:hasExactSynonym>Epilepsy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Epilepsy syndrome</rdfs:label>

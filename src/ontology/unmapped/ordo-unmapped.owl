                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A recessive distal myopathy characterized by weakness in the distal lower extremity posterior compartment (gastrocnemius and soleus muscles) and associated with difficulties in standing on tip toes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Miyoshi myopathy</oboInOwl:hasExactSynonym>

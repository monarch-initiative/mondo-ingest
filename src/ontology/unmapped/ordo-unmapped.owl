    <!-- http://www.orpha.net/ORDO/Orphanet_98808 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98808">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_255"/>

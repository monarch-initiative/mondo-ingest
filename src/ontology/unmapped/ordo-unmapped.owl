    <!-- http://www.orpha.net/ORDO/Orphanet_168956 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_168956">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217720"/>

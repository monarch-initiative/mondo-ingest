    <!-- http://www.orpha.net/ORDO/Orphanet_284180 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_284180">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263775"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic intellectual disability characterized by developmental delay and intellectual disability, learning and behavioral problems, short stature, thin and sparse hair, mild dysmorphic features, tapering fingers and later onset of scoliosis, obesity and cardiovascular problems (cardiomegaly and cardiomyopathy). Females have normal intelligence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dup(X)(p22)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dup(X)(p22.13p22.2)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Duplication Xp22</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Xp22.13p22.2 duplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dup(x)(p22)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dup(x)(p22.13p22.2)</oboInOwl:hasExactSynonym>
        <rdfs:label>Xp22.13p22.2 duplication syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD51</skos:broadMatch>
        <skos:exactMatch>MONDO:0017284</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190686</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_284180"/>

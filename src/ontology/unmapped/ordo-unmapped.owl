        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93453"/>
        <obo:IAO_0000115 xml:lang="en">Craniofaciofrontodigital syndrome is a rare multiple congenital anomalies syndrome characterized by mild intellectual disability, short stature, cardiac anomalies, mild dysmorphic features (macrocephaly, prominent forehead, hypertelorism, exophthalmos), cutis laxa, joint hyperlaxity, wrinkled palms and soles and skeletal anomalies (sella turcica, wide ribs and small vertebral bodies).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cantu craniofaciofrontodigital syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Craniofaciofrontodigital syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Craniofaciofrontodigital syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007259</skos:exactMatch>
        <skos:exactMatch>MeSH:C567298</skos:exactMatch>

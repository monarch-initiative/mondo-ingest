        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neurodevelopmental disorder characterized by cognitive impairment of variable severity, behavioral abnormalities, and sleep disturbance. Patients present with distinctive physical features and a wide range of malformations (e.g. cardiac, renal).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">17p11.2 microdeletion syndrome</oboInOwl:hasExactSynonym>

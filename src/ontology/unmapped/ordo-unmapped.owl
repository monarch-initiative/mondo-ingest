    <!-- http://www.orpha.net/ORDO/Orphanet_2390 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2390">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_331184"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by frequent infections associated with neutropenia and IgA deficiency, in combination with osteoporosis and skeletal anomalies, such as posterior spinal arch fusion defect, metacarpal subluxation, syndactyly, and camptodactyly. Reported dysmorphic features include synophrys, anteverted nostrils, and single palmar crease. There have been no further descriptions in the literature since 1972.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lichtenstein syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lichtenstein syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D70</skos:broadMatch>
        <skos:exactMatch>MONDO:0009523</skos:exactMatch>
        <skos:exactMatch>MeSH:C535894</skos:exactMatch>
        <skos:exactMatch>OMIM:246550</skos:exactMatch>
        <skos:exactMatch>UMLS:C1855502</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2390"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lichtenstein syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2391 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2391">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182108"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare thoracic malformation characterized by fixation of the scapula to the first rib by a congenitally short costocoracoid ligament, leading to limited rotation or retraction of the scapula, as well as rounding of the shoulders and loss of the anterior clavicular contour. There have been no further descriptions in the literature since 1989.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenitally short costocoracoid ligament</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenitally short costocoracoid ligament</rdfs:label>
        <skos:broadMatch>ICD-10:Q68.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0007388</skos:exactMatch>
        <skos:exactMatch>MeSH:C536448</skos:exactMatch>
        <skos:exactMatch>OMIM:122580</skos:exactMatch>
        <skos:exactMatch>UMLS:C1852523</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2391"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenitally short costocoracoid ligament</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2394 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2394">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_401854"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>

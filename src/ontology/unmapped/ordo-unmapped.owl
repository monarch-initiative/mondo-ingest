        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98038"/>
        <obo:IAO_0000115 xml:lang="en">A rare cranial malformation characterized by hyperostosis frontalis interna, variably associated with metabolic and endocrine disorders (such as obesity, diabetes mellitus, and hirsutism, among others). Compression by calvarial thickening may lead to cerebral atrophy and present with cognitive impairment, neuropsychiatric symptoms, headaches, and epilepsy. The condition predominantly affects women.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperostosis frontalis interna</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Morgagni-Stewart-Morel syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Morgagni-Stewart-Morel syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:M85.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB80.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0007766</skos:exactMatch>
        <skos:exactMatch>MeSH:D006957</skos:exactMatch>

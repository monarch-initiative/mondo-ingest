                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/92"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Very long-chain acyl-CoA dehydrogenase (VLCAD) deficiency (VLCADD) is an inherited disorder of mitochondrial long-chain fatty acid oxidation with a variable presentation including: cardiomyopathy, hypoketotic hypoglycemia, liver disease, exercise intolerance and rhabdomyolysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">VLCAD deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">VLCADD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Very long chain acyl-CoA dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Very long chain acyl-CoA dehydrogenase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E71.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C52.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0008723</skos:exactMatch>
        <skos:exactMatch>MeSH:C536353</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_402082 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_402082">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98261"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic neurological disorder characterized by early-onset progressive ataxia associated with myoclonic seizures, generalized tonic-clonic seizures (which are often sleep-related), and normal to mild intellectual disability. Dysarthria, upward gaze palsy, sensory neuropathy, developmental delay and autistic disorder have also been associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EPM5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PME type 5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progressive myoclonic epilepsy type 5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive myoclonus epilepsy type 5</oboInOwl:hasExactSynonym>
        <rdfs:label>Progressive myoclonic epilepsy type 5</rdfs:label>
        <skos:broadMatch>ICD-10:G40.3</skos:broadMatch>
        <skos:broadMatch>OMIM:607459</skos:broadMatch>
        <skos:exactMatch>UMLS:C5190799</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_402082"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Progressive myoclonic epilepsy type 5</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_402364 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_402364">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269528"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2375"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Infantile cerebral and cerebellar atrophy with postnatal progressive microcephaly is a rare, central nervous system malformation syndrome characterized by progressive microcephaly with profound motor delay and intellectual disability, associated with hypertonia, spasticity, clonus, and seizures, with brain imaging revealing severe cerebral and cerebellar atrophy, and poor myelination.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Infantile cerebral and cerebellar atrophy with postnatal progressive microcephaly</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile cerebral and cerebellar atrophy with postnatal progressive microcephaly</rdfs:label>
        <skos:broadMatch>ICD-10:Q04.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0013351</skos:exactMatch>
        <skos:exactMatch>OMIM:613668</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749432</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_402364"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Infantile cerebral and cerebellar atrophy with postnatal progressive microcephaly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_402823 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_402823">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163585"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_57146"/>
        <obo:IAO_0000115 xml:lang="en">Hepatitis delta is a rare hepatic disease characterized by variable degrees of acute hepatitis resulting from infection with the hepatitis delta virus. Occasionally it may present a benign course, but most frequently it manifests with severe liver disease that may include fulminant liver failure, hepatic decompensation and rapid progression to cirrhosis. All patients present concomitant hepatitis B virus infection and an increased risk of developing hepatocellular carcinoma has been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">HDV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hepatitis D virus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hepatitis delta</oboInOwl:hasExactSynonym>
        <rdfs:label>Hepatitis delta</rdfs:label>
        <skos:exactMatch>ICD-10:B17.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:1E51.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0005789</skos:exactMatch>
        <skos:exactMatch>MeSH:D003699</skos:exactMatch>
        <skos:exactMatch>MedDRA:10019762</skos:exactMatch>
        <skos:exactMatch>UMLS:C0011226</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_402823"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hepatitis delta</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_403 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_403">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_235936"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare heritable, glucocorticoid remediable form of primary aldosteronism (PA) characterized by early-onset hypertension, hyperaldosteronism, variable hypokalemia, low plasma renin activity (PRA), and abnormal production of 18-oxocortisol and 18-hydroxycortisol.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dexamethasone-sensitive hypertension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FH-I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FH1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial hyperaldosteronism type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial hyperaldosteronism type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GRA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glucocorticoid-remediable aldosteronism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glucocorticoid-sensitive hypertension</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial hyperaldosteronism type I</rdfs:label>
        <skos:broadMatch>ICD-10:E26.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A72.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0007080</skos:exactMatch>
        <skos:exactMatch>MeSH:C563177</skos:exactMatch>
        <skos:exactMatch>OMIM:103900</skos:exactMatch>
        <skos:exactMatch>UMLS:C3838731</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_403"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial hyperaldosteronism type I</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_40366 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_40366">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251529"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare teratogenic disorder due to acitretin or etretinate exposure during the first trimester of pregnancy, carrying a risk of fetal malformations of approximately 20%, including central nervous system, craniofacial, ear, thymic, cardiac and limb anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Acitretin/etretinate embryopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fetal acitretin/etretinate syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Retinoid embryopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Acitretin/etretinate embryopathy</rdfs:label>
        <skos:broadMatch>ICD-10:Q86.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018442</skos:exactMatch>
        <skos:exactMatch>UMLS:C4510941</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_40366"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Acitretin/etretinate embryopathy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_404 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_404">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100091"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_235936"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_271847"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A heritable form of primary aldosteronism (PA) characterized by hypertension of varying severity, non-glucocorticoid remediable hyperaldosteronism, variable hypokalemia, low plasma renin activity (PRA) and increased aldosterone-to-renin ratio.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FH-II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">FH2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial hyperaldosteronism type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial hyperaldosteronism type II</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial hyperaldosteronism type II</rdfs:label>
        <skos:broadMatch>ICD-10:E26.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A72.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0011576</skos:exactMatch>
        <skos:exactMatch>MeSH:C565312</skos:exactMatch>
        <skos:exactMatch>OMIM:605635</skos:exactMatch>
        <skos:exactMatch>UMLS:C1854107</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_404"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited cancer-predisposing syndrome characterized by the fulfilment of the Amsterdam criteria for hereditary nonpolyposis colorectal cancer (HNPCC) but without alterations, either somatic or germline, in the DNA mismatch repair (MMR) genes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FCCTX</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial colorectal cancer Type X</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial colorectal cancer Type X</rdfs:label>
        <skos:broadMatch>ICD-11:2B90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018604</skos:exactMatch>
        <skos:exactMatch>UMLS:C3896578</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_1307 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1307">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262914"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

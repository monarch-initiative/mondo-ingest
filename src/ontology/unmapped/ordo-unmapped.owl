            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/17091"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare skin disease belonging to the spectrum of autoinflammatory syndromes characterized by the triad of pyoderma gangrenosum (PG), suppurative hidradenitis (SH) and acne.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PASH syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pyoderma gangrenosum-acne-suppurative hidradenitis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>PASH syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D89.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A60.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017332</skos:exactMatch>
        <skos:exactMatch>MedDRA:10084535</skos:exactMatch>
        <skos:exactMatch>UMLS:C5191642</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        <obo:IAO_0000115 xml:lang="en">2q31.1 microdeletion syndrome is a well-defined and clinically recognisable syndrome characterized by moderate to severe developmental delay, short stature, facial dysmorphism and variable limb defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>2q31.1 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(2)(q31.1)</oboInOwl:hasExactSynonym>

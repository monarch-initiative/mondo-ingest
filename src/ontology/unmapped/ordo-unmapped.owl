    <!-- http://www.orpha.net/ORDO/Orphanet_244310 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_244310">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309347"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_476406 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_476406">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139021"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183570"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_284790"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_476403"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare defect of tropomyosin characterized by decreased fetal movements and generalized muscle stiffness at birth. Additional features include joint contractures, short stature, kyphosis, dysmorphic features, temperature dysregulation, and variably severe respiratory involvement with hypoxemia. Muscle biopsy shows mild myopathic features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital generalized hypercontractile muscle stiffness syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital generalized hypercontractile muscle stiffness syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G71.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0018780</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567789</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_476406"/>

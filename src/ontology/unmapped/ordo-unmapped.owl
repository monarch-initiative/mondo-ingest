        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16268"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A very rare genetic multisystemic disorder characterized by progressive neurological, ophthalmologic and endocrine manifestations leading to severe handicap.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LMS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Laurence-Moon syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Laurence-Moon syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009514</skos:exactMatch>
        <skos:exactMatch>MeSH:D007849</skos:exactMatch>
        <skos:exactMatch>MedDRA:10056710</skos:exactMatch>
        <skos:exactMatch>OMIM:245800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0023138</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2377"/>

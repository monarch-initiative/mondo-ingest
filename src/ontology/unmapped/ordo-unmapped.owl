    <!-- http://www.orpha.net/ORDO/Orphanet_2023 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2023">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_223727"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_3394"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">An aggressive sarcoma of soft tissues or bone that can arise from any part of the body, clinically presenting as swelling, mass, pain, pathological fracture and occasional systemic features and is characterized by high local recurrence and significant metastasis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">UPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Undifferentiated pleomorphic sarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Undifferentiated pleomorphic sarcoma</rdfs:label>
        <skos:broadMatch>ICD-10:C49.9</skos:broadMatch>
        <skos:exactMatch>MONDO:0002142</skos:exactMatch>
        <skos:exactMatch>MeSH:D051677</skos:exactMatch>
        <skos:exactMatch>UMLS:C0334463</skos:exactMatch>
    </owl:Class>

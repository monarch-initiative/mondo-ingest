    <!-- http://www.orpha.net/ORDO/Orphanet_31204 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_31204">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bacterial infection characterized by various clinical manifestations depending on the site of infection, caused by the Gram-positive bacillus &lt;i&gt;Nocardia&lt;/i&gt;. The most common presentation is lung infection, which typically follows pathogen inhalation. Dissemination to other organs may occur, especially among immunocompromised patients. Primary skin and soft-tissue infection follows skin inoculation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Nocardiosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Nocardiosis</rdfs:label>
        <skos:exactMatch>ICD-11:1C1B</skos:exactMatch>
        <skos:exactMatch>MONDO:0017776</skos:exactMatch>
        <skos:exactMatch>MeSH:D009617</skos:exactMatch>
        <skos:exactMatch>MedDRA:10029444</skos:exactMatch>
        <skos:exactMatch>UMLS:C0028242</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A43.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A43.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A43.8</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A43.9</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C1B.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C1B.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C1B.Y</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_31204"/>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Fish eye disease (FED) is a form of genetic LCAT (lecithin-cholesterol acyltransferase) deficiency characterized clinically by corneal opacifications, and biochemically by significantly reduced HDL cholesterol and partial LCAT enzyme deficiency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FED</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fish-eye disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Partial LCAT deficiency</oboInOwl:hasExactSynonym>

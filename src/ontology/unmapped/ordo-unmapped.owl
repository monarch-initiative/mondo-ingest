            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9210"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9455"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital hypopituitarism is characterized by multiple pituitary hormone deficiency, including somatotroph, thyrotroph, lactotroph, corticotroph or gonadotroph deficiencies. Congenital hypopituitarism is rare compared with the high incidence of hypopituitarism induced by pituitary adenomas, transsphenoidal surgery or radiotherapy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Combined pituitary hormone deficiencies, genetic forms</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial congenital hypopituitarism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple pituitary hormone deficiencies, genetic forms</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined pituitary hormone deficiencies, genetic forms</rdfs:label>
        <skos:broadMatch>ICD-10:E23.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A61.0</skos:broadMatch>

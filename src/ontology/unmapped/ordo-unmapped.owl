        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C044"/>
        <rdfs:label>X-linked intellectual disability, Brooks type</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>

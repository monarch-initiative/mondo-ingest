            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by patients presenting with a multitude of clinical features of Proteus syndrome without meeting the diagnostic criteria for the disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Proteus-like syndrome</oboInOwl:hasExactSynonym>

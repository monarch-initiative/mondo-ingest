    <!-- http://www.orpha.net/ORDO/Orphanet_64741 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_64741">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101945"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A biphasic primary lung neoplasm, belonging to the group of sarcomatoid lung carcinomas (SLCs). The tumor contains both an epithelial well-differentiated component, showing tubular architecture resembling the normal fetal lung, and a mesenchymal undifferentiated stroma with a so-called &apos;&apos;blastema-like&apos;&apos; configuration that resembles an embryonic lung.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Pneumoblastoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pulmonary blastoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Pulmonary blastoma</rdfs:label>
        <skos:broadMatch>ICD-11:2C25.Y</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH5VH1</skos:exactMatch>
        <skos:exactMatch>MONDO:0005933</skos:exactMatch>
        <skos:exactMatch>MeSH:D018202</skos:exactMatch>
        <skos:exactMatch>UMLS:C0206629</skos:exactMatch>
        <skos:narrowMatch>ICD-10:C34.1</skos:narrowMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare autosomal recessive forms of ichthyosis clinically characterized by superficial, asymptomatic, spontaneous peeling of the skin and histologically by a shedding of the outer layers of the epidermis. PSS presents with either an acral (acral PSS) or a generalized distribution for generalized PSS type A (noninflammatory) or B (inflammatory).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Deciduous skin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial continuous skin peeling syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic deciduous skin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratosis exfoliativa congenita</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PSS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Peeling skin disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Peeling skin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Peeling skin syndrome</rdfs:label>
        <skos:exactMatch>ICD-11:EC20.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0019347</skos:exactMatch>
        <skos:exactMatch>MONDO:19347</skos:exactMatch>
        <skos:exactMatch>MeSH:C564818</skos:exactMatch>
        <skos:exactMatch>UMLS:C1849193</skos:exactMatch>

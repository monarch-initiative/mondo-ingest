            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4868"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Developmental delay with autism spectrum disorder and gait instability is a rare, genetic, neurological disorder characterized by infant hypotonia and feeding difficulties, global development delay, mild to moderated intellectual disability, delayed independent ambulation, broad-based gait with arms upheld and flexed at the elbow with brisk walking or running, and limited language skills. Behavior patterns are highly variable and range from sociable and affectionate to autistic behavior.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Developmental delay with ASD and gait instability</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Developmental delay with autism spectrum disorder and gait instability</oboInOwl:hasExactSynonym>
        <rdfs:label>Developmental delay with autism spectrum disorder and gait instability</rdfs:label>
        <skos:broadMatch>ICD-10:F84.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0014224</skos:exactMatch>
        <skos:exactMatch>OMIM:615516</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749505</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_329195"/>

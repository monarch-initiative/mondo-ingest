    <!-- http://www.orpha.net/ORDO/Orphanet_213792 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_213792">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_213782"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare subtype of malignant mixed epithelial and mesenchymal tumor composed of benign or mildly atypical glandular elements and a surrounding low-grade malignant stroma, often containing heterologous elements, such as areas of sex-cord-like or smooth muscle differentiation. It usually presents with vaginal bleeding or discharge, lower abdominal pain and/or a cervical mass or polyp. The tumor may arise from pre-existing endometriosis and patients may have a history of recurrent cervical polyps.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Adenosarcoma of the cervix uteri</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cervical adenosarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Adenosarcoma of the cervix uteri</rdfs:label>
        <skos:broadMatch>ICD-11:2C77.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0002876</skos:exactMatch>
        <skos:exactMatch>UMLS:C1516426</skos:exactMatch>
        <skos:narrowMatch>ICD-10:C53.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C53.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:C53.8</skos:narrowMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_319223 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319223">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_341"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A disorder that caused by the Junin virus (JUNV), is an acute viral hemorrhagic disease characterized by initial fever and malaise followed by gastrointestinal symptoms and in some cases hemorrhagic and neurological manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Argentine hemorrhagic fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Argentinian hemorrhagic fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Junin hemorrhagic fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Argentine hemorrhagic fever</rdfs:label>
        <skos:exactMatch>ICD-10:A96.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:1D61.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0017874</skos:exactMatch>
        <skos:exactMatch>MedDRA:10003090</skos:exactMatch>
        <skos:exactMatch>UMLS:C0019097</skos:exactMatch>
    </owl:Class>

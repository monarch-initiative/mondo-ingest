    <!-- http://www.orpha.net/ORDO/Orphanet_31205 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_31205">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bacterial zoonosis characterized by fever, arthralgia and a rash predominantly affecting the extremities, typically occurring after a bite or scratch from infected rats. The disease may be caused by &lt;i&gt;Streptobacillus moniliformis&lt;/i&gt;, also known as streptobacillosis, or by &lt;i&gt;Spirillum minus&lt;/i&gt;, also known as sodoku.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Rat-bite fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Rat-bite fever</rdfs:label>
        <skos:exactMatch>ICD-11:1B90</skos:exactMatch>
        <skos:exactMatch>MONDO:0006941</skos:exactMatch>
        <skos:exactMatch>MeSH:D011906</skos:exactMatch>
        <skos:exactMatch>MedDRA:10037904</skos:exactMatch>
        <skos:exactMatch>UMLS:C0034686</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A25.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A25.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A25.9</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_31205"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Rat-bite fever</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

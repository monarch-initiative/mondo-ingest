        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_93337 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93337">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498464"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Polydactyly of an index finger or PPD3 is a form of preaxial polydactyly of fingers, a limb malformation syndrome, where the thumb is replaced by one or two triphalangeal digits with dermatoglyphic pattern specific of the index finger. Two forms of PPD3 have been characterized: unilateral and bilateral. There have been no further descriptions in the literature since 1962.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PPD3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polydactyly of an index finger</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Preaxial polydactyly type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Polydactyly of an index finger</rdfs:label>
        <skos:broadMatch>ICD-10:Q69.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB78.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008271</skos:exactMatch>
        <skos:exactMatch>MeSH:C566784</skos:exactMatch>
        <skos:exactMatch>OMIM:174600</skos:exactMatch>
        <skos:exactMatch>UMLS:C1868113</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93337"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Polydactyly of an index finger</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_93338 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93338">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_498464"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4319"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Polysyndactyly or PPD4 is a form of preaxial polydactyly of fingers, a limb malformation syndrome, characterized by the presence of a thumb showing the mildest degree of duplication, being broad, bifid or with radially deviated distal phalanx. Syndactyly of various degrees of third-and-fourth fingers is occasionally present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PPD4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polysyndactyly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Preaxial polydactyly type 4</oboInOwl:hasExactSynonym>
        <rdfs:label>Polysyndactyly</rdfs:label>
        <skos:exactMatch>ICD-10:Q70.4</skos:exactMatch>
        <skos:exactMatch>ICD-11:LB78.1</skos:exactMatch>
        <skos:exactMatch>MONDO:8272</skos:exactMatch>

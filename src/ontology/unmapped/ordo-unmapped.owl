        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly characterized by variable developmental delay with intellectual disability, epilepsy, pigmentary skin anomalies and characteristic facial features usually caused by mosaic tetrasomy of the short arm of chromosome&amp;nbsp;12. A wide range of pulmonary, cardiac, renal, gastrointestinal, genitourinary, ophtalmologic and auditory features are also associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isochromosome 12p mosaicism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Isochromosome 12p syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pallister-Killian syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Pallister-Killian syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>

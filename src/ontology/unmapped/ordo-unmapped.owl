    <!-- http://www.orpha.net/ORDO/Orphanet_1445 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1445">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363203"/>

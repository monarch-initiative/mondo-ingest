        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_95718"/>
        <obo:IAO_0000115 xml:lang="en">Thyroid hemiagenesis is a form of thyroid dysgenesis characterized by an absence of half of the thyroid gland that is usually asymptomatic but may result in primary congenital hypothyroidism, a permanent thyroid deficiency that is present from birth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Thyroid hemiagenesis</oboInOwl:hasExactSynonym>
        <rdfs:label>Thyroid hemiagenesis</rdfs:label>
        <skos:broadMatch>ICD-10:E03.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A00.01</skos:broadMatch>
        <skos:broadMatch>OMIM:218700</skos:broadMatch>
        <skos:exactMatch>MONDO:0019860</skos:exactMatch>
        <skos:exactMatch>MedDRA:10077609</skos:exactMatch>
        <skos:exactMatch>UMLS:C4023190</skos:exactMatch>
    </owl:Class>

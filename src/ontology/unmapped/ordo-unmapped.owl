                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4189"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Glutaryl-CoA dehydrogenase (GCDH) deficiency (GDD) is an autosomal recessive neurometabolic disorder clinically characterized by encephalopathic crises resulting in striatal injury and a severe dystonic dyskinetic movement disorder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GA1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GCDHD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glutaric acidemia type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glutaric aciduria type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Glutaryl-CoA dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glutaryl-coenzyme A dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Glutaryl-CoA dehydrogenase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E1</skos:broadMatch>
        <skos:exactMatch>MONDO:0009281</skos:exactMatch>
        <skos:exactMatch>MeSH:C536833</skos:exactMatch>

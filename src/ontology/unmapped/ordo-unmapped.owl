        <oboInOwl:hasExactSynonym xml:lang="en">X-linked hydrocephalus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked hydrocephalus with stenosis of aqueduct of Sylvius</oboInOwl:hasExactSynonym>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_320380 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_320380">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100981"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29106"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Autosomal recessive spastic paraplegia type 54 (SPG54) is a rare, complex form of hereditary spastic paraplegia characterized by the onset in early childhood of progressive spastic paraplegia associated with cerebellar signs, short stature, delayed psychomotor development, intellectual disability and, less commonly, foot contractures, dysarthria, dysphagia, strabismus and optic hypoplasia. SPG54 is caused by mutations in the &lt;i&gt;DDHD2&lt;/i&gt; gene (8p11.23) encoding phospholipase DDHD2.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal recessive spastic paraplegia type 54</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPG54</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal recessive spastic paraplegia type 54</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0014018</skos:exactMatch>
        <skos:exactMatch>OMIM:615033</skos:exactMatch>
        <skos:exactMatch>UMLS:C3539495</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_320380"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

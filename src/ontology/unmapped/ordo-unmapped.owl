        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism characterized by increased concentrations of sarcosine in plasma and urine due to sarcosine dehydrogenase deficiency. The condition is considered benign and not associated with any specific clinical phenotype. Mode of inheritance is autosomal recessive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Sarcosine dehydrogenase complex deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sarcosinemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Sarcosinemia</rdfs:label>
        <skos:broadMatch>ICD-10:E72.5</skos:broadMatch>
        <skos:exactMatch>ICD-11:5C50.71</skos:exactMatch>
        <skos:exactMatch>MONDO:0010008</skos:exactMatch>

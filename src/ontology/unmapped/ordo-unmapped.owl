            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Primary ciliary dyskinesia - retinitis pigmentosa is an X-linked ciliary dysfunction of both respiratory epithelium and photoreceptors of the retina leading to ocular disorders (mild night blindness, constriction of the visual field, and scotopic and photopic ERG responses reduced to 30-60%) associated with primary ciliary dyskinesia manifestations (chronic bronchorrhea with bronchiectasis and chronic sinusitis) and sensorineural hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Primary ciliary dyskinesia-retinitis pigmentosa syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary ciliary dyskinesia-retinitis pigmentosa syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q34.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA75.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010330</skos:exactMatch>
        <skos:exactMatch>OMIM:300455</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304829</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

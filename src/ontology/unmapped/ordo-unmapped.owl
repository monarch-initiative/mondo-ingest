        <skos:exactMatch>MONDO:0011819</skos:exactMatch>
        <skos:exactMatch>MeSH:C537198</skos:exactMatch>
        <skos:exactMatch>OMIM:607346</skos:exactMatch>
        <skos:exactMatch>UMLS:C5235656</skos:exactMatch>
        <skos:narrowMatch>ICD-11:8A03.16</skos:narrowMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">An infectious disease, rare in Europe, characterized by relapsing fever accompanied by headaches, vomiting and myalgia lasting 2-7&amp;nbsp;days, with afebrile intervals of up to 10&amp;nbsp;days. It is caused by bacterial species of the genus &lt;i&gt;Borrelia&lt;/i&gt;, and transmitted by ticks (tick-borne relapsing fever; TBRF) and lice (louse-borne relapsing fever; LBRF).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Relapsing fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Relapsing fever</rdfs:label>
        <skos:exactMatch>ICD-11:1C1J</skos:exactMatch>
        <skos:exactMatch>MONDO:0019633</skos:exactMatch>

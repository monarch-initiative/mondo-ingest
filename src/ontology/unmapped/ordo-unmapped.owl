            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Genetic hyperferritinemia without iron overload is a rare biological anomaly defined as high serum ferritin levels without elevations of transferrin saturation, tissue or serum iron and characterized by an apparently asymptomatic clinical phenotype.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign hyperferritinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Genetic hyperferritinemia without iron overload</oboInOwl:hasExactSynonym>
        <rdfs:label>Genetic hyperferritinemia without iron overload</rdfs:label>

    <!-- http://www.orpha.net/ORDO/Orphanet_99865 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99865">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363504"/>

        <skos:broadMatch>ICD-11:5A51.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0015027</skos:exactMatch>
        <skos:exactMatch>MeSH:C564166</skos:exactMatch>
        <skos:exactMatch>MedDRA:10080773</skos:exactMatch>
        <skos:exactMatch>UMLS:C4551961</skos:exactMatch>
        <skos:narrowMatch>OMIM:145000</skos:narrowMatch>
        <skos:narrowMatch>OMIM:600166</skos:narrowMatch>
        <skos:narrowMatch>OMIM:610071</skos:narrowMatch>

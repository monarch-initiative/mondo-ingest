    <!-- http://www.orpha.net/ORDO/Orphanet_99135 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99135">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98370"/>
        <obo:IAO_0000115 xml:lang="en">A rare constitutional hemolytic anemia characterized by a low 6-phosphogluconate dehydrogenase activity in the erythrocytes, which clinically manifests with a well-compensated chronic nonspherocytic hemolytic anemia and transient hemolytic periods with jaundice.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>6-phosphogluconate dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>6-phosphogluconate dehydrogenase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D55.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0020457</skos:exactMatch>
        <skos:exactMatch>OMIM:619199</skos:exactMatch>
        <skos:exactMatch>UMLS:C5543091</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_99135"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, vitreous-retinal disease characterized by ocular developmental anomalies such as microcornea, a shallow anterior chamber, glaucoma and cataract. Abnormal chorioretinal pigmentation is present, usually lying between the vortex veins and the ora serrata for 360 degrees.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ADVIRC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autosomal dominant vitreoretinochoroidopathy</oboInOwl:hasExactSynonym>

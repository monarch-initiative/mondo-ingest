            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A very rare and mild form of spondylocostal dysostosis characterized by vertebral and costal segmentation defects, often with a reduction in the number of ribs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant spondylocostal dysostosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant spondylocostal dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant spondylocostal dysostosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q76.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.H</skos:broadMatch>
        <skos:broadMatch>OMIM:122600</skos:broadMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93446"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, primary bone dysplasias characterized by increased bone fragility, low bone mass, and susceptibility to bone fractures. The clinical severity is heterogeneous.</obo:IAO_0000115>

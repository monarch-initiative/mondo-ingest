        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A cosmopolitan fungal infection due to &lt;i&gt;Cryptococcus neoformans&lt;/i&gt;.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cryptococcosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Cryptococcosis</rdfs:label>
        <skos:exactMatch>ICD-11:1F27</skos:exactMatch>

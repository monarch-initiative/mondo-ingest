    <!-- http://www.orpha.net/ORDO/Orphanet_1600 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1600">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156237"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262146"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

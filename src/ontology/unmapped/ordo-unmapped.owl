            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare acute hepatic porphyria characterized by neurovisceral attacks without skin symptoms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ALAD porphyria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Porphyria due to ALA dehydratase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Porphyria due to ALAD deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Porphyria due to delta-aminolevulinate dehydratase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Porphyria of Doss</oboInOwl:hasExactSynonym>
        <rdfs:label>Porphyria due to ALA dehydratase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E80.2</skos:broadMatch>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2538 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2538">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108965"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies syndrome characterized by congenital microgastria and a uni- or bilateral limb reduction defect, that can include absent or hypoplastic thumbs, radius, ulna and/or amelia. Association with other variable abnormalities, including intestinal malrotation, asplenia, dysplastic kidneys, hypoplastic lungs, dysplastic corpus collosum, and abnormal genitalia, has been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Microgastria-limb reduction defect syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Microgastria-limb reduction defect syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007993</skos:exactMatch>
        <skos:exactMatch>MeSH:C537554</skos:exactMatch>
        <skos:exactMatch>OMIM:156810</skos:exactMatch>
        <skos:exactMatch>UMLS:C4303067</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_51188 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_51188">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254837"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

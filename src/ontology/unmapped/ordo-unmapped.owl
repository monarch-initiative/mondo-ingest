    <!-- http://www.orpha.net/ORDO/Orphanet_418 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_418">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101960"/>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_169105 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_169105">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

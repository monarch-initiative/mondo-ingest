        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hereditary sensory and autonomic neuropathy with deafness and global delay</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_139578 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139578">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100981"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140477"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1618"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurological disorder characterized by infantile to childhood onset of progressive sensory neuropathy in association with spastic paraplegia and mutilating acropathy. Patients present lower limb spasticity and progressive severe sensory loss leading to chronic ulcerations in both upper and lower limbs. Electrophysiological studies are consistent with axonal sensory neuropathy, and nerve biopsy shows axonopathy with loss of myelinated nerve fibers of all diameters as well as of unmyelinated axons.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Mutilating HSAN with spastic paraplegia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mutilating hereditary sensory neuropathy with spastic paraplegia</oboInOwl:hasExactSynonym>
        <rdfs:label>Mutilating hereditary sensory neuropathy with spastic paraplegia</rdfs:label>
        <skos:broadMatch>ICD-10:G60.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009748</skos:exactMatch>
        <skos:exactMatch>MONDO:9748</skos:exactMatch>
        <skos:exactMatch>OMIM:256840</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679610</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_139578"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

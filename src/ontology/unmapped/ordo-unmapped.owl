        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98628"/>
        <obo:IAO_0000115 xml:lang="en">Oculodental syndrome, Rutherfurd type is a rare genetic disorder that is primarily characterized by the classical triad of gingival fibromatosis, non-eruption of tooth and corneal dystrophy (bilateral corneal vascularization and opacity). Abnormally shaped teeth have also been reported. The syndrome is transmitted as an autosomal dominant trait.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Gingival hypertrophy-corneal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oculodental syndrome, Rutherfurd type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rutherfurd syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Oculodental syndrome, Rutherfurd type</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:9A70.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008396</skos:exactMatch>
        <skos:exactMatch>MeSH:C537732</skos:exactMatch>
        <skos:exactMatch>OMIM:180900</skos:exactMatch>
        <skos:exactMatch>UMLS:C0796140</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2709"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Oculodental syndrome, Rutherfurd type</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



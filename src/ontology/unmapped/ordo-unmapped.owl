    <!-- http://www.orpha.net/ORDO/Orphanet_573163 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_573163">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100091"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A rare neuroendocrine tumor arising from chromaffin cells of the adrenal medulla (pheochromocytoma) or from sympathetic and parasympathetic ganglia (paraganglioma). These tumors are most often benign and may produce catecholamines in excess causing hypertension and sometimes severe acute cardiovascular complications.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Pheochromocytoma-paraganglioma</oboInOwl:hasExactSynonym>
        <rdfs:label>Pheochromocytoma-paraganglioma</rdfs:label>
        <skos:exactMatch>MONDO:0035540</skos:exactMatch>
        <skos:exactMatch>UMLS:C5681712</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_573163"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pheochromocytoma-paraganglioma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_573253 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_573253">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_573278"/>
        <obo:IAO_0000115 xml:lang="en">A rare subtype of split cord malformation characterized by both hemicords included in the same single dural sac. An intradural intervening mesenchymal septum may be present.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Diplomyelia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCM type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCM type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Split cord malformation type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Split cord malformation type II</oboInOwl:hasExactSynonym>
        <rdfs:label>Split cord malformation type II</rdfs:label>
        <skos:broadMatch>ICD-10:Q06.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA07.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0035541</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680360</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_573253"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Split cord malformation type II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_573278 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_573278">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268843"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645202"/>
        <obo:IAO_0000115 xml:lang="en">A rare malformation characterized by localized longitudinal division of the spinal cord into two &quot;hemicords&quot;. Vertebro-costal anomalies are commonly associated. Classic overlying skin stigmata is a focal hypertrichosis/hairy patch. Split cord malformations may be associated with other dysraphic anomalies (eg: filum lipoma).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SCM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Split cord malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Split cord malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q06.2</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_573278"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Split cord malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_574 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_574">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262173"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98642"/>
        <obo:IAO_0000115 xml:lang="en">Monosomy 21 is a chromosomal anomaly characterized by the loss of variable portions of a segment of the long arm of chromosome 21 that leads to an increased risk of birth defects, developmental delay and intellectual deficit.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>21q deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">21q- syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Partial 21q monosomy</oboInOwl:hasExactSynonym>
        <rdfs:label>21q deletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.M</skos:broadMatch>
        <skos:exactMatch>MONDO:0018930</skos:exactMatch>
        <skos:exactMatch>MeSH:C537108</skos:exactMatch>
        <skos:exactMatch>UMLS:C0795876</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_91498 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_91498">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519353"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neuro-ophthalmological disease characterized by congenital fourth cranial nerve palsy, manifesting with hypertropia in side gaze, unexplained head tilt, acquired vertical diplopia, and progressive increase in vertical fusional vergence amplitudes with prolonged occlusion. Facial asymmetry (i.e. hemifacial retrusion, upward slanting of mouth on the side of the head tilt, mild enophthalmos of paretic eye) and superior oblique tendon abnormalities (such as absence, redundance, misdirection) are frequently associated. Some asymptomatic cases have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial congenital palsy of trochlear nerve</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial congenital palsy of trochlear nerve</rdfs:label>
        <skos:broadMatch>ICD-10:H49.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:9C81.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0007626</skos:exactMatch>
        <skos:exactMatch>MeSH:C565007</skos:exactMatch>
        <skos:exactMatch>OMIM:136480</skos:exactMatch>
        <skos:exactMatch>UMLS:C1850996</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_91498"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial congenital palsy of trochlear nerve</owl:annotatedTarget>

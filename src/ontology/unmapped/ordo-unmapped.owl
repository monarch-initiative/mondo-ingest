    <!-- http://www.orpha.net/ORDO/Orphanet_1144 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1144">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

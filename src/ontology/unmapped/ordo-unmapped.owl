    <!-- http://www.orpha.net/ORDO/Orphanet_458830 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_458830">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_211247"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_459526"/>

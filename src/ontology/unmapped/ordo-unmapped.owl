    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2322 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2322">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117573"/>

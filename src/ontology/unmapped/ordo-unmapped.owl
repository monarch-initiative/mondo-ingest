        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Hypotrichosis simplex (HS) or hereditary hypotrichosis simplex (HHS) is characterized by reduced pilosity over the scalp and body (with sparse, thin, and short hair) in the absence of other anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary hypotrichosis simplex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypotrichosis simplex</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypotrichosis simplex</rdfs:label>
        <skos:broadMatch>ICD-10:L65.8</skos:broadMatch>

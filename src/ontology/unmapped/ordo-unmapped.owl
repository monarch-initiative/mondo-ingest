        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/29090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This syndrome is characterized by the association of severe nasal hypoplasia, hypoplasia of the eyes, hyposmia, hypogeusia and hypogonadotropic hypogonadism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bosma arhinia-microphthalmia syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bosma-Henkin-Christiansen syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hyposmia-nasal and ocular hypoplasia-hypogonadotropic hypogonadism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hyposmia-nasal and ocular hypoplasia-hypogonadotropic hypogonadism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>OMIM:603457</skos:broadMatch>

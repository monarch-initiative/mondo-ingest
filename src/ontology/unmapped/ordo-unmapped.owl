    <!-- http://www.orpha.net/ORDO/Orphanet_79159 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79159">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217619"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79163"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/87"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare organic aciduria characterized by isolated elevation of C4-acylcarnitine. Patient may be asymptomatic (notably during the early childhood) or may present with anemia, dilated cardiomyopathy, mild peripheral pulmonary stenosis, and carnitine deficiency. Mild developmental delay, speech delay, muscle hypotonia, emesis and dehydration have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isobutyric aciduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isobutyryl-CoA dehydrogenase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Isobutyryl-CoA dehydrogenase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E71.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E0</skos:broadMatch>
        <skos:exactMatch>MONDO:0012648</skos:exactMatch>
        <skos:exactMatch>MeSH:C535541</skos:exactMatch>
        <skos:exactMatch>OMIM:611283</skos:exactMatch>
        <skos:exactMatch>UMLS:C1969809</skos:exactMatch>
    </owl:Class>

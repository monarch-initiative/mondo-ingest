    <!-- http://www.orpha.net/ORDO/Orphanet_25 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_25">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

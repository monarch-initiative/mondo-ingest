        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93420"/>
        <obo:IAO_0000115 xml:lang="en">A primary bone dysplasia with micromelia characterized by micromelia, macrocephaly, narrow thorax, and distinctive facial features. It includes TD, type 1 (TD1) and TD, type 2 (TD2), that can be differentiated from each other by femur and skull shape.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">TD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Thanatophoric dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Thanatophoric dysplasia</rdfs:label>
        <skos:exactMatch>ICD-10:Q77.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:LD24.02</skos:exactMatch>
        <skos:exactMatch>MONDO:0017042</skos:exactMatch>
        <skos:exactMatch>MeSH:D013796</skos:exactMatch>
        <skos:exactMatch>MedDRA:10089187</skos:exactMatch>
        <skos:exactMatch>UMLS:C0039743</skos:exactMatch>
        <skos:narrowMatch>OMIM:156830</skos:narrowMatch>
        <skos:narrowMatch>OMIM:187600</skos:narrowMatch>
        <skos:narrowMatch>OMIM:187601</skos:narrowMatch>
    </owl:Class>

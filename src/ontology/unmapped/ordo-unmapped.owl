    <!-- http://www.orpha.net/ORDO/Orphanet_2688 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2688">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_178996"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare acquired immunodeficiency disease characterized by adult-onset absolute neutrophil counts less than 1.5 x 10^9/L on at least 3 occasions in a 3 month period that cannot be attributable to drugs or a specific genetic, infectious, inflammatory, autoimmune or malignant cause. Recurrent aphtous stomatitis and a history of mild bacterial infections are typically associated. A benign outcome with a low rate of severe infections and no secondary malignancies is observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult chronic idiopathic neutropenia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Adult idiopathic neutropenia</oboInOwl:hasExactSynonym>
        <rdfs:label>Adult idiopathic neutropenia</rdfs:label>
        <skos:broadMatch>ICD-10:D70</skos:broadMatch>
        <skos:broadMatch>ICD-11:4B00.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0011922</skos:exactMatch>
        <skos:exactMatch>OMIM:607847</skos:exactMatch>
        <skos:exactMatch>UMLS:C5191335</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2688"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Adult idiopathic neutropenia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_268810 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_268810">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268744"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645202"/>
        <obo:IAO_0000115 xml:lang="en">Posterior meningocele is a rare neural tube closure defect characterized by the herniation of a cerebrospinal fluid-filled sac, that is lined by dura and arachnoid mater, through a posterior spina bifida and covered by a layer of skin of variable thickness, which may be dysplastic or ulcerated. The spinal cord and nerves are generally not included and function normally, although sometimes a tethered cord may be associated. They are most commonly located in the lumbar or sacral region.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated posterior meningocele</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated posterior meningocele</rdfs:label>
        <skos:broadMatch>ICD-10:Q05.2</skos:broadMatch>
        <skos:broadMatch>ICD-10:Q05.3</skos:broadMatch>
        <skos:broadMatch>ICD-10:Q05.7</skos:broadMatch>
        <skos:broadMatch>ICD-10:Q05.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA02.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017076</skos:exactMatch>
        <skos:exactMatch>MONDO:17076</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680741</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_268810"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Isolated posterior meningocele</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_268813 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_268813">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268744"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645202"/>
        <obo:IAO_0000115 xml:lang="en">A rare closed neural tube defect characterized by cystic dilatation of the central canal of the spinal cord, herniating through a posterior vertebral arch defect (spina bifida) into an expanded cerebrospinal fluid (CSF) filled dural sac (meningocele). It can be located at the caudal part of the spinal cord (terminal myelocystocele) or above conus (non terminal myelocystocele).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Myelocystocele</oboInOwl:hasExactSynonym>
        <rdfs:label>Myelocystocele</rdfs:label>
        <skos:broadMatch>ICD-10:Q05.9</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA02.02</skos:exactMatch>
        <skos:exactMatch>MONDO:0017077</skos:exactMatch>
        <skos:exactMatch>MONDO:17077</skos:exactMatch>
        <skos:exactMatch>UMLS:C4551677</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_268813"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Myelocystocele</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_268817 -->


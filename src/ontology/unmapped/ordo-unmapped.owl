    <!-- http://www.orpha.net/ORDO/Orphanet_34516 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_34516">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102014"/>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_180154 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_180154">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180151"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare vaginal malformation characterized by the presence of a complete or incomplete longitudinal or transverse septum in the vagina due to disrupted fusion or canalization of the solid vaginal plate during embryogenesis. Signs and symptoms depend on the type of septum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Septate vagina</oboInOwl:hasExactSynonym>
        <rdfs:label>Septate vagina</rdfs:label>
        <skos:broadMatch>ICD-10:Q52.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB42.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0015848</skos:exactMatch>
        <skos:exactMatch>UMLS:C0266411</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_180154"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Septate vagina</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_180157 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_180157">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180154"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare vaginal malformation characterized by the presence of a complete or incomplete septum dividing the vagina into two parallel cavities, resulting from failure of reabsorption of the midline uterine septum between the two fused Müllerian ducts during embryogenesis. Patients are often asymptomatic, but may present with menorrhagia, dysmenorrhea, dyspareunia, infertility, or spontaneous abortion. The condition may occur as an isolated malformation or in association with other Müllerian duct anomalies (such as septate uterus or uterus didelphys) or renal abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Longitudinal vaginal septum</oboInOwl:hasExactSynonym>
        <rdfs:label>Longitudinal vaginal septum</rdfs:label>
        <skos:broadMatch>ICD-10:Q52.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB42.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0015849</skos:exactMatch>
        <skos:exactMatch>UMLS:C1841680</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_180157"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Longitudinal vaginal septum</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_180160 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_180160">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180154"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare vaginal malformation characterized by the presence of a complete or incomplete transverse septum at any level of the vagina (most frequently the upper or middle third), resulting from incomplete fusion between the Müllerian duct component and the urogenital sinus component of the vagina during embryogenesis. The condition is only rarely diagnosed in neonates or infants, unless it causes significant hydromucocolpos. Complete septa present with primary amenorrhea, cyclic pelvic pain, dyspareunia, or a pelvic mass consisting of accumulated menstrual blood, while incomplete septa may lead to dyspareunia and dysmenorrhea.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Transverse vaginal septum</oboInOwl:hasExactSynonym>
        <rdfs:label>Transverse vaginal septum</rdfs:label>
        <skos:broadMatch>ICD-10:Q52.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LB42.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0015850</skos:exactMatch>
        <skos:exactMatch>UMLS:C1856006</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_180160"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Transverse vaginal septum</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



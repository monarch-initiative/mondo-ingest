    <!-- http://www.orpha.net/ORDO/Orphanet_73 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_73">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182231"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_235832"/>

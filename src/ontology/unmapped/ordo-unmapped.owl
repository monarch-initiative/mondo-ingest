    <!-- http://www.orpha.net/ORDO/Orphanet_1441 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1441">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363203"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly characterized by highly variable manifestations, ranging from a severe phenotype which presents with lissencephaly and severe intellectual disability to a milder phenotype that includes short stature, microcephaly, intellectual disability, seizures (that may be pharmacoresistant), café-au-lait spots, retinal flecks and minor facial dysmorphism, depending on the presence or absence of the Miller-Dieker critical region.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ring 17</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ring chromosome 17</oboInOwl:hasExactSynonym>

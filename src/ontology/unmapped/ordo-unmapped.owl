        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked congenital myopathy characterized by numerous centrally placed nuclei on muscle biopsy and that presents at birth with marked weakness, hypotonia and respiratory failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked centronuclear myopathy</oboInOwl:hasExactSynonym>

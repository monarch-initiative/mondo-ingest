        <owl:annotatedTarget>Isolated congenital laryngeal web</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2375 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2375">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked syndromic intellectual disability characterized by congenital and permanent vocal cord paralysis causing severe congenital laryngeal stridor, associated with intellectual disability in male patients. Other presenting symptoms may include weak cry, cough, cyanosis, neonatal asphyxia, feeding difficulty, aspiration, and bronchiectasis. Microcephaly, tone abnormalities, visual and hearing impairment may also be associated features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Laryngeal abductor paralysis-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Plott syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Laryngeal abductor paralysis-intellectual disability syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:J38.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0010639</skos:exactMatch>
        <skos:exactMatch>OMIM:308850</skos:exactMatch>
        <skos:exactMatch>UMLS:C4319572</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2375"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Laryngeal abductor paralysis-intellectual disability syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2377 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2377">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

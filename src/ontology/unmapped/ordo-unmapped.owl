    <!-- http://www.orpha.net/ORDO/Orphanet_363447 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363447">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_211037"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neuromuscular disease characterized by early onset muscular weakness with predominant proximal lower limb involvement. The disorder is static or only mildly progressive. The severity of manifestations ranges from lethal, congenital muscular atrophy with arthrogryposis to asymptomatic with subclinical features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant childhood-onset proximal spinal muscular atrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lower extremity-predominant autosomal dominant proximal spinal muscular atrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SMALED</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant childhood-onset proximal spinal muscular atrophy</rdfs:label>
        <skos:broadMatch>ICD-10:G12.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B61.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018190</skos:exactMatch>
        <skos:exactMatch>UMLS:C1834690</skos:exactMatch>
        <skos:narrowMatch>OMIM:158600</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615290</skos:narrowMatch>
    </owl:Class>

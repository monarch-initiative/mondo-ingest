    <!-- http://www.orpha.net/ORDO/Orphanet_3222 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3222">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

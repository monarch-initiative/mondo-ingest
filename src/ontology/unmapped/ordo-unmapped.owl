                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8548"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An extremely rare form of bone dysplasia characterized by the features of osteogenesis imperfecta such as bone fragility associated with multiple fractures, bone deformities (metaphyseal irregularities and bowing of the long bones) and blue sclera, in association with growth failure, craniosynostosis, hydrocephalus, ocular proptosis, and distinctive facial features (e.g. frontal bossing, midface hypoplasia, and micrognathia).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bone fragility-craniosynostosis-proptosis-hydrocephalus syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cole-Carpenter syndrome</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_231 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2034"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Dracunculiasis (Guinea worm disease) is a neglected tropical disease (NTD) characterized by a painful burning skin lesion from which the &lt;i&gt;Dracunculus medinensis&lt;/i&gt; parasite emerges approximately 1 year after infection resulting from consumption of unsafe drinking water containing parasite-infected copepods (&lt;i&gt;Cyclops spp.&lt;/i&gt;, microcrustacea also called water fleas).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dracunculiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dracunculosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Guinea worm disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Medina worm disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Medinensis</oboInOwl:hasExactSynonym>
        <rdfs:label>Dracunculiasis</rdfs:label>
        <skos:exactMatch>ICD-10:B72</skos:exactMatch>
        <skos:exactMatch>ICD-11:1F64</skos:exactMatch>
        <skos:exactMatch>MONDO:0016472</skos:exactMatch>
        <skos:exactMatch>MeSH:D004320</skos:exactMatch>
        <skos:exactMatch>MedDRA:10013618</skos:exactMatch>
        <skos:exactMatch>UMLS:C0013100</skos:exactMatch>
    </owl:Class>

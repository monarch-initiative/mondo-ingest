            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Cutaneous mastocytoma is a form of cutaneous mastocytosis (CM) generally characterized by the presence of a solitary or multiple hyperpigmented macules, plaques or nodules associated with abnormal accumulation of mast cells in the skin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutaneous local mastocytoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cutaneous mastocytoma</oboInOwl:hasExactSynonym>

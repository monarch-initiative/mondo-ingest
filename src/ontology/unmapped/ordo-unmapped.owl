        <skos:narrowMatch>OMIM:252160</skos:narrowMatch>
        <skos:narrowMatch>OMIM:272300</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615501</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_833"/>

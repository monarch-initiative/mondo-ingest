    <!-- http://www.orpha.net/ORDO/Orphanet_100025 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100025">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_86864"/>
        <obo:IAO_0000115 xml:lang="en">A type of HCD characterized by the production of incomplete monoclonal alpha-heavy chains without associated light chains. Alpha-HCD is considered to be a subtype of immunoproliferative small intestinal disease (IPSID). The clinical presentation includes chronic diarrhea with evidence of malabsorption.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Alpha-HCD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Alpha-heavy chain disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">IPSID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Immunoproliferative small intestinal disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mediterranean lymphoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Alpha-heavy chain disease</rdfs:label>
        <skos:broadMatch>ICD-10:C88.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:2A84.0</skos:exactMatch>
        <skos:exactMatch>ICD-11:XH1Y65</skos:exactMatch>
        <skos:exactMatch>MONDO:0015045</skos:exactMatch>
        <skos:exactMatch>MeSH:D007161</skos:exactMatch>
        <skos:exactMatch>UMLS:C0021071</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_100025"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_85188 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85188">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93444"/>
        <obo:IAO_0000115 xml:lang="en">Metaphyseal dysplasia, Braun-Tinschert type is characterised by metaphyseal undermodeling with broadening of the long bones and femora with an &apos;Erlenmeyer flask&apos;&apos; appearance, expansion and bowing of the radii with severe varus deformity and flat exostoses of the long bones at the metadiaphyseal junctions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Metaphyseal dysplasia, Braun-Tinschert type</oboInOwl:hasExactSynonym>
        <rdfs:label>Metaphyseal dysplasia, Braun-Tinschert type</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.1Y</skos:broadMatch>

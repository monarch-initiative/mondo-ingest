            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7652"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic chromosomal instability syndrome presenting at birth with microcephaly, dysmorphic facial features which become more noticeable with age, growth delay, recurring sinopulmonary infections and extremely high frequency of malignancies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AT V1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ataxia-telangiectasia, variant 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Berlin breakage syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Immunodeficiency-microcephaly-chromosomal instability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Microcephaly-immunodeficiency-lymphoid malignancy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NBS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Nijmegen breakage syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Seemanova syndrome type 2</oboInOwl:hasExactSynonym>
        <rdfs:label>Nijmegen breakage syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.31</skos:broadMatch>
        <skos:exactMatch>MONDO:0009623</skos:exactMatch>
        <skos:exactMatch>MeSH:D049932</skos:exactMatch>
        <skos:exactMatch>MedDRA:10067857</skos:exactMatch>

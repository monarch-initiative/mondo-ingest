        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_399096 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_399096">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206653"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/27337"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Distal anoctaminopathy is a rare, autosomal recessive distal myopathy characterized by early adult-onset, slowly progressive, often asymmetrical, lower limb muscle weakness initially affecting the calves (with relative anterior muscle sparing) and later proximal muscle involvement, as well as highly elevated creatine kinase (CK) serum levels.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal anoctaminopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MMD3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Miyoshi muscular dystrophy type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal anoctaminopathy</rdfs:label>
        <skos:broadMatch>ICD-10:G71.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0013222</skos:exactMatch>
        <skos:exactMatch>MeSH:C567645</skos:exactMatch>
        <skos:exactMatch>OMIM:613319</skos:exactMatch>
        <skos:exactMatch>UMLS:C2750076</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_399096"/>

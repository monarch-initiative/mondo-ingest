    <!-- http://www.orpha.net/ORDO/Orphanet_35807 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_35807">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363582"/>

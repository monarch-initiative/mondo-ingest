        <oboInOwl:hasExactSynonym>Malignant peripheral nerve sheath tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Malignant schwannoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurofibrosarcoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurogenic sarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Malignant peripheral nerve sheath tumor</rdfs:label>
        <skos:broadMatch>ICD-10:C47.9</skos:broadMatch>
        <skos:exactMatch>ICD-11:2A02.10</skos:exactMatch>
        <skos:exactMatch>MONDO:0017827</skos:exactMatch>

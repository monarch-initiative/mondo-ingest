    <!-- http://www.orpha.net/ORDO/Orphanet_96167 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96167">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263708"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Recombinant 8 (rec(8)) syndrome, also known as San Luis Valley syndrome, is a complex chromosomal disorder that is due to a parental pericentric inversion of chromosome 8 and is characterized by major congenital heart anomalies, urogenital malformations, moderate to severe intellectual deficiency and mild craniofacial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Duplication 8q/deletion 8p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rec(8) syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rec8 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Recombinant 8 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Recombinant chromosome 8 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">San Luis Valley syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Recombinant 8 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD41.P</skos:broadMatch>
        <skos:exactMatch>MONDO:0008365</skos:exactMatch>
        <skos:exactMatch>MeSH:C535296</skos:exactMatch>
        <skos:exactMatch>OMIM:179613</skos:exactMatch>
        <skos:exactMatch>UMLS:C0795822</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96167"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98033"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic, neurodevelopmental syndrome characterized by hypothalamic-pituitary dysfunction with severe hypotonia and feeding deficits during the neonatal period followed by an excessive weight gain period with hyperphagia with a risk of severe obesity during childhood and adulthood, learning difficulties, deficits of social skills and behavioral problems or severe psychiatric problems.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Prader-Labhart-Willi syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Prader-Willi syndrome</oboInOwl:hasExactSynonym>

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_96125 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96125">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

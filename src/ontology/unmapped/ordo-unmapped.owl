    <!-- http://www.orpha.net/ORDO/Orphanet_75563 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_75563">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309813"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98362"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/397"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">X-linked sideroblastic anemia is a constitutional microcytic, hypochromic anemia of varying severity that is clinically characterized by manifestations of anemia and iron overload and that may respond to treatment with pyridoxine and folic acid.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked sideroblastic anemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XLSA</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked sideroblastic anemia</rdfs:label>
        <skos:broadMatch>ICD-10:D64.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A72.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0020721</skos:exactMatch>
        <skos:exactMatch>MeSH:C536761</skos:exactMatch>
        <skos:exactMatch>OMIM:300751</skos:exactMatch>
        <skos:exactMatch>UMLS:C4551511</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_75563"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>X-linked sideroblastic anemia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_75564 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_75564">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_1047"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_52688"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10768"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25941"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare myelodysplastic syndrome (MDS) characterized by ineffective hemopoiesis affecting one or more blood cell lineages (myeloid, erythroid or megakaryocytic) leading to peripheral blood cytopenias and an increased risk of developing leukaemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AISA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Acquired idiopathic sideroblastic anemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary acquired sideroblastic anemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RARS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Refractory anemia with ringed sideroblasts</oboInOwl:hasExactSynonym>
        <rdfs:label>Acquired idiopathic sideroblastic anemia</rdfs:label>
        <skos:broadMatch>ICD-10:D64.3</skos:broadMatch>
        <skos:exactMatch>ICD-11:2A33</skos:exactMatch>
        <skos:exactMatch>MONDO:0019157</skos:exactMatch>
        <skos:exactMatch>MONDO:19157</skos:exactMatch>
        <skos:exactMatch>UMLS:C4016601</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_75564"/>

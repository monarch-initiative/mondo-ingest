        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_329481 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329481">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_181437"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183586"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93548"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/613"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic renal disease characterized by the formation of intraglomerular lipoprotein thrombi due to lipid deposition in severely dilated glomerular capillaries. Laboratory examination reveals abnormal serum lipid profiles, in particular markedly elevated apolipoprotein E. Clinical manifestations include proteinuria or nephrotic syndrome with hypertension and potential progression to chronic renal failure. Systemic complications of dyslipidemia are not observed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LPG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lipoprotein glomerulopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Lipoprotein glomerulopathy</rdfs:label>
        <skos:broadMatch>ICD-10:N07.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:MF82</skos:exactMatch>
        <skos:exactMatch>MONDO:0012725</skos:exactMatch>
        <skos:exactMatch>MeSH:C567089</skos:exactMatch>
        <skos:exactMatch>OMIM:611771</skos:exactMatch>
        <skos:exactMatch>UMLS:C2673196</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_329481"/>

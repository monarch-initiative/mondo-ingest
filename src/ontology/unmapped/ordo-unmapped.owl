        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare Prader-Willi like syndrome due to an interstitial deletion located at 6q16.1q16.2 and characterized by obesity, hyperphagia, hypotonia, small hands and feet, eye/vision anomalies, and global developmental delay.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>6q16 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(6)(q16)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 6q16</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Prader-Willi-like syndrome due to microdeletion 6q16</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(6)(q16)</oboInOwl:hasExactSynonym>
        <rdfs:label>6q16 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD29</skos:broadMatch>

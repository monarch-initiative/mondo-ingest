        <obo:IAO_0000115 xml:lang="en">A rare anomaly of puberty or/and menstrual cycle characterized by recurrent fevers (higher than 38 degrees Celsius) associated with the luteal phase of the menstrual cycle in women.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Luteal-phase-dependent febrile episode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Luteal-phase-dependent periodic fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Menstrual cycle-dependent febrile episode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Menstrual cycle-dependent periodic fever</oboInOwl:hasExactSynonym>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1369 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1369">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217587"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254830"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_352312"/>

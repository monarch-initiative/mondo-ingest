            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of congenital dyserythropoietic anemia (CDA) characterized by moderate to severe anemia, often macrocytic, occasionally associated with congenital malformations, primarily affecting the distal extremities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CDA I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CDA type 1</oboInOwl:hasExactSynonym>

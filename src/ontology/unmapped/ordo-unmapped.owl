    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_330197">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C051"/>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Genetic MCA/variable MR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OBSOLETE: Genetic multiple congenital anomalies-variable intellectual disability with or without dysmorphism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>OBSOLETE: Genetic multiple congenital anomalies/dysmorphic syndrome-variable intellectual disability syndrome</rdfs:label>

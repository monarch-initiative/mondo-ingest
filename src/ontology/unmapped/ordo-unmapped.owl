        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/496"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare ectodermal dysplasia syndrome characterized by the association of sparse, woolly, curly hair, ankyloblepharon, and nail dysplasia. Additional reported features include abnormal oral frenula, bifid tongue, lip pits, adhesions between upper and lower lips, hypertelorism and flat nasal bridge, alveolar synechia, and imperforate vagina.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Baughman syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CHAND syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CHANDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Curly hair-ankyloblepharon-nail dysplasia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>CHAND syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q82.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008959</skos:exactMatch>
        <skos:exactMatch>MeSH:C538074</skos:exactMatch>
        <skos:exactMatch>OMIM:214350</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406733</skos:exactMatch>
    </owl:Class>

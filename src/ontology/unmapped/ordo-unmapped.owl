        <oboInOwl:hasExactSynonym xml:lang="en">DYRK1A-related intellectual disability syndrome due to a point mutation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Intellectual disability syndrome due to a DYRK1A point mutation</oboInOwl:hasExactSynonym>

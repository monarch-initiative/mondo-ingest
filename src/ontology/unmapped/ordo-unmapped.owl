    <!-- http://www.orpha.net/ORDO/Orphanet_261144 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_261144">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262110"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3760"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, complex type of hereditary spastic paraplegia characterized by early-onset progressive spastic paraplegia presenting in infancy, associated with optic atrophy, fixation nystagmus, polyneuropathy occurring in late childhood/early adolescence leading to severe motor disability and progressive joint contractures and scoliosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SPOAN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spastic paraplegia-optic atrophy-neuropathy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Spastic paraplegia-optic atrophy-neuropathy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B44.01</skos:broadMatch>
        <skos:exactMatch>MONDO:0012297</skos:exactMatch>
        <skos:exactMatch>MeSH:C563702</skos:exactMatch>
        <skos:exactMatch>OMIM:609541</skos:exactMatch>
        <skos:exactMatch>UMLS:C1836010</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_98868 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98868">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

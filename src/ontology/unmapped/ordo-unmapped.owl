    <!-- http://www.orpha.net/ORDO/Orphanet_889 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_889">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156149"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A small vessel vasculitis characterized by neutrophilic inflammation predominantly limited to the superficial cutaneous postcapillary venules and without systemic vasculitis or glomerulonephritis. Typical presentation is of unifocal or multifocal palpable purpura on the lower extremities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutaneous hypersensitivity vasculitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cutaneous small vessel vasculitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Cutaneous small vessel vasculitis</rdfs:label>
        <skos:broadMatch>ICD-10:M31.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:EF40.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0019509</skos:exactMatch>
        <skos:exactMatch>MONDO:19509</skos:exactMatch>
        <skos:exactMatch>UMLS:C0151436</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

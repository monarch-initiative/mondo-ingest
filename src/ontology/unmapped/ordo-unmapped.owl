        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare neurodegenerative disease usually presenting before the age of 30 and which is characterized by dystonia, L-dopa-responsive parkinsonism, pyramidal signs and rapid cognitive decline.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adult PLAN</oboInOwl:hasExactSynonym>

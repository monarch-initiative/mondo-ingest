        <skos:broadMatch>ICD-10:G12.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:8B61.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019079</skos:exactMatch>
        <skos:exactMatch>UMLS:C4024957</skos:exactMatch>
        <skos:narrowMatch>OMIM:253300</skos:narrowMatch>
        <skos:narrowMatch>OMIM:253400</skos:narrowMatch>
        <skos:narrowMatch>OMIM:253550</skos:narrowMatch>
        <skos:narrowMatch>OMIM:271150</skos:narrowMatch>
    </owl:Class>

        <owl:annotatedTarget>Fibrolipomatous filum anomaly</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645282 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645282">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268357"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A rare group of dysraphic abnormality characterized by anatomical anomaly of the filum. The filum lacks its normal characteristics (thin, loose extension of the pia mater under the termination of the spinal cord).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anomaly of the filum</oboInOwl:hasExactSynonym>
        <rdfs:label>Anomaly of the filum</rdfs:label>
        <skos:exactMatch>UMLS:C5816730</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645282"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Anomaly of the filum</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645285 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645285">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645367"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysraphic spinal cord lipoma characterized by the lipomatous mass extending ventrally to the dorsal root entry zone, indicating a more severe malformation of the spinal cord. The diagnosis can be suggested on imaging but usually confirmed during surgery.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Chaotic conus spinal cord lipoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Chaotic conus spinal cord lipoma</rdfs:label>
        <skos:broadMatch>ICD-10:Q76.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0968986</skos:exactMatch>
        <skos:exactMatch>MONDO:968986</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816729</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645285"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Chaotic conus spinal cord lipoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645288 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645288">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645297"/>
        <obo:IAO_0000115 xml:lang="en">A rare form of extramedullary conus region spinal cord lipoma characterized by its location, extending from the poorly delineated tip of the conus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Terminal extramedullary conus spinal cord lipoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Terminal extramedullary conus spinal cord lipoma</rdfs:label>
        <skos:exactMatch>MONDO:0970957</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816727</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645288"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Terminal extramedullary conus spinal cord lipoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645291 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645291">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645297"/>
        <obo:IAO_0000115 xml:lang="en">A rare form of extramedullary conus region spinal cord lipoma characterized by a location at the posterior surface of the conus and its tip. i.e-&quot;transitional&quot; between posterior and terminal conus region spinal cord lipoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Transitional extramedullary conus spinal cord lipoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Transitional extramedullary conus spinal cord lipoma</rdfs:label>
        <skos:exactMatch>MONDO:0970958</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816728</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645291"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Transitional extramedullary conus spinal cord lipoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645294 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645294">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645297"/>
        <obo:IAO_0000115 xml:lang="en">A rare form of conus region spinal cord lipoma characterized by its location where the interface between the lipoma and the spinal cord is strictcly above the level of the tip of the conus. The tip of the conus is readily delineated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Posterior extramedullary conus spinal cord lipoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Posterior extramedullary conus spinal cord lipoma</rdfs:label>
        <skos:exactMatch>MONDO:0970959</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816725</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645294"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Posterior extramedullary conus spinal cord lipoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645297 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645297">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645367"/>
        <obo:IAO_0000115 xml:lang="en">A rare closed lipomatous, dysraphic malformation of the lower spinal cord characterized by extramedullary lipomatous mass attached to the conus region. The conus is dysplastic and poorly delineated. Various morphological subtypes are recognized. Possible symptoms include bowel and bladder dysfunction and neuro-orthopedic deformity of the lower limbs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Extramedullary conus spinal cord lipoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Extramedullary conus spinal cord lipoma</rdfs:label>
        <skos:broadMatch>ICD-10:Q06.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0968987</skos:exactMatch>
        <skos:exactMatch>MONDO:968987</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816726</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645297"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Extramedullary conus spinal cord lipoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645300 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645300">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645343"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-saccular limited dorsal myeloschisis histologically characterized by skin tissue with a jagged depression of squamous epithelium continued to subcutaneous mature adipose tissue with loose connective tissue. GFAP-immunopositive glial cells are embedded in the subcutaneous lipoma. The extradural and intradural stalk have cord-like fibrocollagenous tissue containing adipose tissue, peripheral nerve fibers, clusters of melanocytes, and skeletal muscle fibers.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Lipomatous flat LDM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lipomatous flat limited dorsal myeloschisis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lipomatous non-saccular LDM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lipomatous non-saccular limited dorsal myeloschisis</oboInOwl:hasExactSynonym>
        <rdfs:label>Lipomatous non-saccular limited dorsal myeloschisis</rdfs:label>
        <skos:exactMatch>MONDO:0970960</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816723</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645300"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lipomatous non-saccular limited dorsal myeloschisis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645310 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645310">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645343"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-saccular limited dorsal myeloschisis, in which the stalk histology is characterized by skin tissue with dermo-epidermal epithelium in continuity with a subcutaneous fibrocollagenous tract containing various ectopic tissues.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Fibroneural flat LDM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fibroneural flat limited dorsal myeloschisis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Fibroneural non-saccular LDM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fibroneural non-saccular limited dorsal myeloschisis</oboInOwl:hasExactSynonym>
        <rdfs:label>Fibroneural non-saccular limited dorsal myeloschisis</rdfs:label>
        <skos:exactMatch>MONDO:0970961</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816724</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645310"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Fibroneural non-saccular limited dorsal myeloschisis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645319 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645319">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268744"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645196"/>
        <obo:IAO_0000115 xml:lang="en">A rare spinal dysraphism characterized by a meningocele, containing a stalk, that is attached to the inner surface of the meningocele. The stalk can be posteriorly fibroneural (saccular limited dorsal myeloschisis) or the spinal cord itself (myelic limited dorsal malformation).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Saccular spinal dysraphism with a stalk to the dome</oboInOwl:hasExactSynonym>
        <rdfs:label>Saccular spinal dysraphism with a stalk to the dome</rdfs:label>
        <skos:exactMatch>UMLS:C5816721</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645319"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Saccular spinal dysraphism with a stalk to the dome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645322 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645322">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645279"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysraphic abnormality characterized by the infiltration of fatty tissue localized in the filum terminale, with abnormal conus shape. The spinal cord is typically attenuated and the limit between its end and the fatty filum is hard to distinguish. There are no additional spinal cord malformation, but it can be associated with vertebral abnormalities, anorectal malformation or other syndromic condition. It is named transitional for its intermediate image between an isolated filum lipoma and a terminal conus region lipoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated transitional filum lipoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated transitional filum lipoma</rdfs:label>
        <skos:broadMatch>ICD-10:Q06.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0958346</skos:exactMatch>
        <skos:exactMatch>MONDO:958346</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816722</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645322"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Isolated transitional filum lipoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645325 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645325">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645279"/>
        <obo:IAO_0000115 xml:lang="en">A rare dysraphic abnormality characterized by the infiltration of fatty tissue localized in the filum terminale, thickens and loses its flexibility, with normal conus shape, regardless of conus level. There is no other spinal cord malformation associated, but it can be associated with extraspinal malformation (ex: anorectal malformation) or syndromic situation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated filum lipoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lipoma of the filum terminale</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated filum lipoma</rdfs:label>
        <skos:broadMatch>ICD-10:Q76.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0958347</skos:exactMatch>
        <skos:exactMatch>MONDO:958347</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816720</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645325"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Isolated filum lipoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645334 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645334">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645193"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645282"/>
        <obo:IAO_0000115 xml:lang="en">A rare closed dysraphism with terminal stalk characterized by persistant rudimentary spinal cord below conus. It contains non-functional neural tissue and is typically isolated. The diagnostic is suggested by attenuated conus without fat, further confirmed by pathological analysis (glioneuronal core with ependyma-lined lumen, nerve roots, and dorsal root ganglia). Differential diagnostic with intraoperative neurophysiological monitoring is mandatory as neuroimaging fails to distinguish it from functional conus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Retained medullary cord</oboInOwl:hasExactSynonym>
        <rdfs:label>Retained medullary cord</rdfs:label>
        <skos:broadMatch>ICD-10:Q76.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0958348</skos:exactMatch>
        <skos:exactMatch>MONDO:958348</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816811</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Retained medullary cord</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645337 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645337">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268813"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645319"/>
        <obo:IAO_0000115 xml:lang="en">A rare closed spinal dysraphism characterized by a myelocystocele at the termination of the spinal cord. It may be an isolated anomaly or be associated with other defects, including sacral agenesis, anorectal and genitourinary anomalies. The conus is not identifiable. The myelocystocele sac may have a significant lipomatous component (terminal lipomyelocystocele).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Terminal myelocystocele</oboInOwl:hasExactSynonym>
        <rdfs:label>Terminal myelocystocele</rdfs:label>
        <skos:broadMatch>ICD-10:Q05.9</skos:broadMatch>
        <skos:exactMatch>MONDO:0970962</skos:exactMatch>
        <skos:exactMatch>MONDO:970962</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816718</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645337"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Terminal myelocystocele</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645340 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645340">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_268813"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare closed spinal dysraphism characterized by myelocystocele located above the conus region. Also considered as a form of saccular limited dorsal myeloschisis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Non-terminal myelocystocele</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-terminal myelocystocele</rdfs:label>
        <skos:broadMatch>ICD-10:Q05.9</skos:broadMatch>
        <skos:exactMatch>MONDO:0957451</skos:exactMatch>
        <skos:exactMatch>UMLS:C5816719</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_645340"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Non-terminal myelocystocele</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_645343 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_645343">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_645196"/>
        <obo:IAO_0000115 xml:lang="en">A rare form of limited dorsal myeloschisis (LDM), characterized by a non saccular cutaneous stigmata (midline skin abnormality classically dimple, pit or sometimes angioma), the stalk is attached to this cutaneous stigmata. Fibroneural stalk varies in thickness and complexity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Flat LDM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-saccular LDM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Non-saccular limited dorsal myeloschisis</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-saccular limited dorsal myeloschisis</rdfs:label>

        <owl:annotatedTarget>Respiratory bronchiolitis-interstitial lung disease syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_79128 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79128">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98300"/>
        <obo:IAO_0000115 xml:lang="en">A rare idiopathic interstitial pneumonia characterized by a diffuse, dense, polyclonal lymphoid cell infiltration of the pulmonary interstitium and air spaces, with high prevalence in patients with immune dysregulation. Presenting symptoms are non-specific and include dyspnea and cough. The clinical course is highly variable, ranging from spontaneous resolution to progressive, fatal respiratory failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Lymphocytic interstitial pneumonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lymphoid interstitial pneumonia</oboInOwl:hasExactSynonym>
        <rdfs:label>Lymphoid interstitial pneumonia</rdfs:label>
        <skos:broadMatch>ICD-10:J84.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:CB03.5</skos:exactMatch>
        <skos:exactMatch>MONDO:0009537</skos:exactMatch>
        <skos:exactMatch>MeSH:C562489</skos:exactMatch>
        <skos:exactMatch>MedDRA:10062997</skos:exactMatch>
        <skos:exactMatch>OMIM:247610</skos:exactMatch>
        <skos:exactMatch>UMLS:C0264511</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

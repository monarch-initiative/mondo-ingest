        <obo:IAO_0000115 xml:lang="en">Classical Hodgkin lymphoma (CHL) is a B-cell lymphoma characterized histologically by the presence of large mononuclear Hodgkin cells and multinucleated Reed-Sternberg (HRS) cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic Hodgkin disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Classic Hodgkin lymphoma</oboInOwl:hasExactSynonym>

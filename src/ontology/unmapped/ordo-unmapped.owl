    <!-- http://www.orpha.net/ORDO/Orphanet_329977 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329977">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100079"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">A rare endocrine tumor of the appendix, seen twice as frequently in females than in males, and usually presenting before the fifth decade of life. It is usually asymptomatic when located in the tip of the appendix (without obstruction), but acute appendicitis is often associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic appendiceal neuroendocrine tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Classic appendix neuroendocrine tumor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Classic neuroendocrine tumor of appendix</oboInOwl:hasExactSynonym>
        <rdfs:label>Classic neuroendocrine tumor of appendix</rdfs:label>
        <skos:broadMatch>ICD-10:D37.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0018016</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679854</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_329977"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Classic neuroendocrine tumor of appendix</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_329984 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329984">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100079"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">Goblet cell carcinoma (GCC) is an aggressive type of endocrine tumor of the appendix presenting equally in males and females in the fifth decade of life and manifesting with a palpable mass and abdominal pain or acute appendicitis. Metastasis to the ovaries, peritoneum or right colon has usually already occurred in half of patients at the time of diagnosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GCC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Goblet cell adenocarcinoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Goblet cell carcinoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Goblet cell carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Goblet cell tumor</oboInOwl:hasExactSynonym>
        <rdfs:label>Goblet cell carcinoma</rdfs:label>
        <skos:broadMatch>ICD-10:C18.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0018017</skos:exactMatch>
        <skos:exactMatch>UMLS:C0205695</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_329984"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Goblet cell carcinoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A bleeding disorder characterized by mild to moderate mucocutaneous bleeding, which becomes more pronounced during pregnancy or following ingestion of drugs that have anti-platelet activity. This disease is due to hyperresponsive platelets, resulting in thrombocytopenia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PT-VWD</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_646278 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_646278">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156532"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

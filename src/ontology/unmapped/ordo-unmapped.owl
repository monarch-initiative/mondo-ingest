        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <obo:IAO_0000115 xml:lang="en">X-linked intellectual disability, Wilson type is characterised by severe intellectual deficit with mutism, epilepsy, growth retardation and recurrent infections. It has been described in three males from three generations of one family. The causative gene has been localised to the 11p region of the X chromosome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked intellectual disability, Wilson type</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked intellectual disability, Wilson type</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD90</skos:broadMatch>
        <skos:exactMatch>MONDO:0010658</skos:exactMatch>
        <skos:exactMatch>OMIM:309545</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305028</skos:exactMatch>
    </owl:Class>

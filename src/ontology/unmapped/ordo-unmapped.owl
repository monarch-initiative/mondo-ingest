        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal non-syndromic hypogammaglobulinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-syndromic agammaglobulinemia, non-Bruton type</oboInOwl:hasExactSynonym>

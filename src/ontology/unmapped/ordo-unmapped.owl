            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/10909"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of iron metabolism and transport characterized by iron retention in macrophages (particularly of the liver and spleen), with a clinical picture of mild anemia and elevated of serum ferritin levels. Ferroportin disease is distinct from hemochromatosis as it is not associated with high transferrin saturation or low hepcidin concentrations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ferroportin disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Ferroportin disease</rdfs:label>
        <skos:broadMatch>ICD-10:E83.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.10</skos:broadMatch>
        <skos:broadMatch>OMIM:606069</skos:broadMatch>
        <skos:exactMatch>UMLS:C1853733</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_648562"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Ferroportin disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_648569 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_648569">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_220489"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A group of genetic disorders of iron overload comprising the rarer forms of hemochromatosis (HC), characterized by a phenotype of severe tissue iron deposition. These rare forms are HJV or HAMP-related hemochromatosis, TFR2-related hemochromatosis and SLC40A1-related hemochromatosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Non-HFE-related hemochromatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Non-HFE-related hemochromatosis</rdfs:label>
        <skos:exactMatch>UMLS:C5816745</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_648569"/>

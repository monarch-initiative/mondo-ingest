    <!-- http://www.orpha.net/ORDO/Orphanet_2928 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2928">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

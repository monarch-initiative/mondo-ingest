        <obo:IAO_0000115 xml:lang="en">A rare genetic epilepsy syndrome characterized by repeated brief focal seizures occurring between 3 and 20&amp;nbsp;months of age, typically peaking around 6 months.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BFIE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">BFIS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign familial infantile convulsions</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign familial infantile epilepsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Benign familial infantile seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SeLIE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Self-limited infantile epilepsy</oboInOwl:hasExactSynonym>
        <rdfs:label>Self-limited infantile epilepsy</rdfs:label>

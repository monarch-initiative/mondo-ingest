        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare myotonic dystrophy of juvenile or adult-onset characterized by mild and fluctuating myotonia, muscle weakness, and rarely cardiac conduction disorders.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Myotonic dystrophy type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Proximal myotonic dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Proximal myotonic myopathy</oboInOwl:hasExactSynonym>

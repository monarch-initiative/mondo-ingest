        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <obo:IAO_0000115 xml:lang="en">An X-linked syndromic intellectual disability characterized by congenital ataxia and generalized hypotonia, global developmental delay with intellectual disability, myoclonic encephalopathy, progressive neurological deterioration, macular degeneration, and recurrent bronchopulmonary infections.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked neurodegenerative syndrome, Bertini type</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked neurodegenerative syndrome, Bertini type</rdfs:label>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2364"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Cold-induced sweating syndrome (CISS) is characterized by profuse sweating (involving the chest, face, arms and trunk) induced by cold ambient temperature.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CISS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cold-induced sweating syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Cold-induced sweating syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G90.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C21.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:272430</skos:broadMatch>
        <skos:exactMatch>MONDO:0015526</skos:exactMatch>
        <skos:narrowMatch>OMIM:610313</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_157820"/>

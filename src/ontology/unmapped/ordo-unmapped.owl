    <!-- http://www.orpha.net/ORDO/Orphanet_1832 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1832">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

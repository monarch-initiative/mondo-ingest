    <!-- http://www.orpha.net/ORDO/Orphanet_53296 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_53296">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_228215"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Familial cutaneous collagenoma is a connective tissue nevus characterized by multiple, flesh-colored asymptomatic nodules distributed symmetrically on the trunk and upper arms (mainly on the upper two-thirds of the back), manifesting around adolescence. The skin biopsy reveals an accumulation of collagen fibers with reduction in the number of elastic fibers. Cardiac anomalies may be observed. Familial cutaneous collagenoma follows an autosomal dominant mode of transmission.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial cutaneous collagenoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial cutaneous collagenoma</rdfs:label>
        <skos:broadMatch>ICD-10:L94.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LC2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007271</skos:exactMatch>
        <skos:exactMatch>MeSH:C562925</skos:exactMatch>
        <skos:exactMatch>OMIM:115250</skos:exactMatch>
        <skos:exactMatch>UMLS:C0406817</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_53296"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial cutaneous collagenoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_533 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_533">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163582"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare bacterial infectious disease caused by the foodborne pathogen &lt;i&gt;Listeria monocytogenes&lt;/i&gt;, characterized by a febrile gastroenteritis, which is usually mild and self-limiting in otherwise healthy persons, but can progress to severe illness in at-risk groups like pregnant women, elderly people, immunocompromised people, and neonates. Complications include sepsis, meningitis, and encephalitis. Listeriosis during pregnancy usually occurs during the third trimester and may lead to preterm labor, miscarriage, stillbirth, or intrauterine infection of the unborn child.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Listeria infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Listeriosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Listeriosis</rdfs:label>
        <skos:exactMatch>ICD-11:1C1A</skos:exactMatch>
        <skos:exactMatch>MONDO:0005828</skos:exactMatch>
        <skos:exactMatch>MeSH:D008088</skos:exactMatch>
        <skos:exactMatch>MedDRA:10024641</skos:exactMatch>
        <skos:exactMatch>UMLS:C5886852</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A32.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A32.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A32.7</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A32.8</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A32.9</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C1A.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C1A.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-11:1C1A.Y</skos:narrowMatch>
    </owl:Class>

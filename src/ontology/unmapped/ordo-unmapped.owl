    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1677 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1677">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_477805"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98727"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital heart malformation of unknown etiology that is characterized by an extremely dilated right atrium, and that is usually asymptomatic and fortuitously discovered by echocardiography or chest radiography, and can be sometimes associated with other anomalies such as atrial arrhythmias (e.g. atrial flutter, atrial fibrillation, supraventricular tachycardia), severe tricuspid regurgitation, or atrial thrombus that could lead to potentially life-threatening thromboembolic complications.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial idiopathic dilatation of the right atrium</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial idiopathic dilatation of the right atrium</rdfs:label>
        <skos:broadMatch>ICD-10:Q20.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA8F</skos:broadMatch>
        <skos:exactMatch>MONDO:0015666</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274283</skos:exactMatch>
    </owl:Class>

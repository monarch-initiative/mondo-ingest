    <!-- http://www.orpha.net/ORDO/Orphanet_178311 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_178311">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182231"/>

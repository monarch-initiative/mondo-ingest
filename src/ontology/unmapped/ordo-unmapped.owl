        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79373"/>
        <obo:IAO_0000115 xml:lang="en">A rare ectodermal dysplasia syndrome characterized by anonychia congenita totalis or rudimentary nails, macular hyper- and/or hypopigmentation (particularly affecting groins, axillae and breasts), coarse scalp hair (that becomes markedly thinned in early adult life), dry palmoplantar skin with distorted epidermal ridges and sore, cracked soles, and hypohidrosis. There have been no further descriptions in the literature since 1975.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Anonychia with flexural pigmentation</oboInOwl:hasExactSynonym>
        <rdfs:label>Anonychia with flexural pigmentation</rdfs:label>
        <skos:broadMatch>ICD-10:Q84.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007131</skos:exactMatch>
        <skos:exactMatch>MeSH:C566278</skos:exactMatch>
        <skos:exactMatch>OMIM:106750</skos:exactMatch>
        <skos:exactMatch>UMLS:C1862844</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_69125"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Anonychia with flexural pigmentation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



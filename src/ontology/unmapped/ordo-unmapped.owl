        <obo:IAO_0000115 xml:lang="en">A rare chondral and ectodermal dysplasia characterized by short ribs, polydactyly, growth retardation, and ectodermal and heart defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Chondroectodermal dysplasia</oboInOwl:hasExactSynonym>

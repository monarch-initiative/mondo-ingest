        <skos:exactMatch>MeSH:C535288</skos:exactMatch>
        <skos:exactMatch>MedDRA:10088963</skos:exactMatch>
        <skos:exactMatch>OMIM:266280</skos:exactMatch>
        <skos:exactMatch>UMLS:C1849453</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_228140 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_228140">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101934"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

        <owl:annotatedTarget>Familial omphalocele syndrome with facial dysmorphism</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_280406 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_280406">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35656"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_567562"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90642"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/20233"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic coenzyme Q10 deficiency characterized by sensorineural deafness and severe, progressive nephrotic syndrome not responding to steroid treatment. Clinical manifestations include early onset proteinuria, hypoalbuminemia and edema, leading to end-stage renal disease. The renal biopsy reveals focal segmental glomerulosclerosis and diffuse mesangial sclerosis. Rarely, seizures, ataxia and dysmorphic features have been described.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial steroid-resistant nephrotic syndrome with sensorineural deafness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial steroid-resistant nephrotic syndrome with sensorineural hearing loss</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial steroid-resistant nephrotic syndrome with sensorineural deafness</rdfs:label>
        <skos:broadMatch>ICD-10:N04.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB41</skos:broadMatch>
        <skos:exactMatch>MONDO:0013836</skos:exactMatch>
        <skos:exactMatch>OMIM:614650</skos:exactMatch>
        <skos:exactMatch>UMLS:C5191003</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_280406"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial steroid-resistant nephrotic syndrome with sensorineural deafness</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



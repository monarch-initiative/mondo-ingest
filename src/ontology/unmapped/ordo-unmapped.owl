    <!-- http://www.orpha.net/ORDO/Orphanet_239 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_239">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_253"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/21317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic primary bone dysplasia of the spondylo-epi-metaphyseal dysplasia (SEMD) group characterized by progressive short-trunked dwarfism, protruding sternum, microcephaly, intellectual disability and pathognomonic radiological findings (generalized platyspondyly with double-humped end plates, irregularly ossified femoral heads, a hypoplastic odontoid, and a lace-like appearance of iliac crests)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dyggve-Melchior-Clausen disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Dyggve-Melchior-Clausen disease</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0009130</skos:exactMatch>
        <skos:exactMatch>MeSH:C535726</skos:exactMatch>
        <skos:exactMatch>OMIM:223800</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265286</skos:exactMatch>
        <skos:narrowMatch>OMIM:304950</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_239"/>

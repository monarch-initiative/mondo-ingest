            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12726"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of von Willebrand disease (VWD) characterized by a bleeding disorder associated with a partial, quantitative plasmatic deficiency of an otherwise structurally and functionally normal von Willebrand factor (VWF).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Von Willebrand disease type 1</oboInOwl:hasExactSynonym>
        <rdfs:label>Von Willebrand disease type 1</rdfs:label>
        <skos:broadMatch>ICD-10:D68.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B12</skos:broadMatch>
        <skos:exactMatch>MONDO:0008668</skos:exactMatch>
        <skos:exactMatch>MeSH:D056725</skos:exactMatch>
        <skos:exactMatch>OMIM:193400</skos:exactMatch>
        <skos:exactMatch>UMLS:C1264039</skos:exactMatch>
    </owl:Class>

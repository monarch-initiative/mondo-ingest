            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Vitamin B12-unresponsive methylmalonic acidemia type mut- is an inborn error of metabolism characterized by recurrent ketoacidotic comas or transient vomiting, dehydration, hypotonia and intellectual deficit, which does not respond to administration of vitamin B12.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Partial deficiency of methylmalonyl-CoA mutase</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vitamin B12-unresponsive methylmalonic acidemia type mut-</oboInOwl:hasExactSynonym>

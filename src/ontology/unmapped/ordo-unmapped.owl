    <!-- http://www.orpha.net/ORDO/Orphanet_1447 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1447">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_363203"/>

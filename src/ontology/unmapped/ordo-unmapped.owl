    <!-- http://www.orpha.net/ORDO/Orphanet_31043 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_31043">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_306516"/>

        <oboInOwl:hasExactSynonym xml:lang="en">Severe PBD-ZSD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe peroxisome biogenesis disorder-Zellweger spectrum disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ZS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Zellweger syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Zellweger syndrome</rdfs:label>

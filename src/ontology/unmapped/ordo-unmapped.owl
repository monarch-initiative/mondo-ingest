    <!-- http://www.orpha.net/ORDO/Orphanet_329217 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329217">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_71281"/>
        <obo:IAO_0000115 xml:lang="en">A rare, potentially life-threatening, circulatory system disease characterized by variable signs and symptoms which may include headache, seizures, altered mental status, intracranial hypertension and cavernous sinus syndrome, among others.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CSVT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cerebral sinovenous thrombosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Cerebral sinovenous thrombosis</rdfs:label>

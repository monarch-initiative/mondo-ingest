    <!-- http://www.orpha.net/ORDO/Orphanet_216796 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_216796">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519296"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_666"/>

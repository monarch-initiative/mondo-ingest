            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, lethal, genetic, multiple congenital anomaly disorder characterized by the triad of brain malformation (mainly occipital encephalocele), large polycystic kidneys, and polydactyly, as well as associated abnormalities that may include cleft lip/palate, cardiac and genital anomalies, central nervous system (CNS) malformations, liver fibrosis, and bone dysplasia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Dysencephalia splanchnocystica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Meckel syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Meckel-Gruber syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Meckel syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q61.9</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD2F.13</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_2256 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2256">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <obo:IAO_0000115 xml:lang="en">Fibulo-ulnar hypoplasia-renal anomalies syndrome is characterized by fibuloulnar dysostosis with renal anomalies. It has been described in two sibs born to nonconsanguinous parents. The syndrome is lethal at birth (respiratory failure). Clinical manifestations include ear and facial anomalies (including micrognathia), symmetrical shortness of long bones, fibular agenesis and hypoplastic ulna, oligosyndactyly, congenital heart defects, and cystic or hypoplastic kidney. It is transmitted as an autosomal recessive trait.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Fibulo-ulnar hypoplasia-renal anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Saito-Kuba-Tsuruta syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Fibulo-ulnar hypoplasia-renal anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0009233</skos:exactMatch>
        <skos:exactMatch>MeSH:C537226</skos:exactMatch>
        <skos:exactMatch>OMIM:228940</skos:exactMatch>
        <skos:exactMatch>UMLS:C1856727</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2256"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Fibulo-ulnar hypoplasia-renal anomalies syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



    <!-- http://www.orpha.net/ORDO/Orphanet_217560 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_217560">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264694"/>

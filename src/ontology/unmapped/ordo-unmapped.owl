    <!-- http://www.orpha.net/ORDO/Orphanet_1160 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1160">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165711"/>

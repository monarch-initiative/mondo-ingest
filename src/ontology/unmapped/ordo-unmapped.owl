    <!-- http://www.orpha.net/ORDO/Orphanet_26792 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_26792">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_206953"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309120"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

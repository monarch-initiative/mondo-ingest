        <obo:IAO_0000115 xml:lang="en">Cystoid macular dystrophy is an autosomal dominantly inherited cystoid macular edema manifesting with macular atrophy, strabismus and, sometimes, pericentral retinitis pigmentosa. It is associated with a poor visual prognosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant cystoid macular edema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cystoid macular dystrophy</oboInOwl:hasExactSynonym>

        <rdfs:label>Autosomal dominant generalized epidermolysis bullosa simplex, severe form</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC30</skos:broadMatch>

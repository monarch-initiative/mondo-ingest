        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">Cutaneous polyarteritis nodosa (CPAN) is a rare limited form of polyarteritis nodosa (PAN), characterized by cutaneous vasculitis and mild and transient extracutaneous manifestations such as mild arthralgia, arthritis,myalgia, and rarely peripheral neuropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutaneous PAN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutaneous periarteritis nodosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cutaneous polyarteritis nodosa</oboInOwl:hasExactSynonym>
        <rdfs:label>Cutaneous polyarteritis nodosa</rdfs:label>
        <skos:broadMatch>ICD-10:M30.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:EF40.Z</skos:broadMatch>
        <skos:exactMatch>MONDO:0018592</skos:exactMatch>
        <skos:exactMatch>UMLS:C0343190</skos:exactMatch>
    </owl:Class>

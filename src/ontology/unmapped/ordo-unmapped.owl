    <!-- http://www.orpha.net/ORDO/Orphanet_976 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_976">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79191"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93593"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/626"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic nephropathy secondary to a disorder of purine metabolism characterized by the formation and hyperexcretion of 2,8-dihydroxyadenine (2,8-DHA) in urine, causing urolithiasis and crystalline nephropathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">2,8-dihydroxyadenine urolithiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">APRT deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Adenine phosphoribosyltransferase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Adenine phosphoribosyltransferase deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E79.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C55.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013869</skos:exactMatch>
        <skos:exactMatch>MeSH:C538228</skos:exactMatch>
        <skos:exactMatch>MedDRA:10072609</skos:exactMatch>
        <skos:exactMatch>OMIM:614723</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268120</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_976"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Adenine phosphoribosyltransferase deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



        <oboInOwl:hasExactSynonym xml:lang="en">Granular corneal dystrophy type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Granular corneal dystrophy type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Granular-lattice corneal dystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Granular corneal dystrophy type II</rdfs:label>

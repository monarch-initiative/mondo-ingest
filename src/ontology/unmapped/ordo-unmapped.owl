        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">9q31.1q31.3 microdeletion syndrome is a rare, genetic, syndromic intellectual disability characterized by mild intellectual disability, short stature with high body mass index, short neck with cervical gibbus and dysmorphic facial features. A metabolic syndrome, including type 2 diabetes, hypercholesterolemia and hypertension has also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>9q31.1q31.3 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(9)(q31.1q31.3)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 9q31.1q31.3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(9)(q31.1q31.3)</oboInOwl:hasExactSynonym>
        <rdfs:label>9q31.1q31.3 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0018428</skos:exactMatch>
        <skos:exactMatch>UMLS:C4750910</skos:exactMatch>
    </owl:Class>

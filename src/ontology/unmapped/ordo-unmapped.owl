            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by a distinctive facial dysmorphism, hydronephrosis, severe developmental delay, typical skeletal malformations, and genital and cardiac anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SGS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Schinzel-Giedion syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Schinzel-Giedion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>

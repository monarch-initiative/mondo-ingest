        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_653434"/>
        <obo:IAO_0000115 xml:lang="en">A rare autoinflammatory syndrome characterized by the combination of psoriatic arthritis, pyoderma gangrenosum, acne, and suppurative hidradenitis (which, in addition to axillae and inguinal folds, can be observed in other areas, such as the buttocks or labia majora).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PsAPASH syndrome</oboInOwl:hasExactSynonym>

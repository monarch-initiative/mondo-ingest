    <!-- http://www.orpha.net/ORDO/Orphanet_217 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_217">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_729563"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_730393"/>
        <obo:IAO_0000115 xml:lang="en">A rare non-syndromic central nervous system malformation characterized by the association of three signs: hydrocephalus, partial or complete absence of the cerebellar vermis, and posterior fossa cyst contiguous with the fourth ventricle, presenting early in life with hydrocephalus, bulging occiput and posterior fossa signs such as cranial nerve palsies, nystagmus and ataxia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Isolated Dandy-Walker malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Isolated Dandy-Walker malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q03.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA06.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0009072</skos:exactMatch>
        <skos:exactMatch>OMIM:220200</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931867</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_217"/>

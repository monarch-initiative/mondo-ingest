            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare ophthalmic disorder that is usually characterized by a progressive loss of central vision associated with irregular macular and perimacular yellow-white fundus flecks, and a so-called &apos;&apos;beaten bronze&apos;&apos; atrophic central macular lesion.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Fundus flavimaculatus</oboInOwl:hasExactSynonym>

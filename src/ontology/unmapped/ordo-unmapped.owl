        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Peters anomaly (PA) is a congenital corneal opacity disorder characterized by a central corneal leukoma that obstructs the pupil leading to visual loss as well as absence of the posterior corneal stroma and Descemet membrane.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Peters anomaly</oboInOwl:hasExactSynonym>

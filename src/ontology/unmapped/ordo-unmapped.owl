        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Carnosinase deficiency</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1366 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1366">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_307804"/>

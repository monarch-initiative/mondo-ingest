    <!-- http://www.orpha.net/ORDO/Orphanet_207 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_207">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139393"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98650"/>

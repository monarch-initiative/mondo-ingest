        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2605"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Cerebrotendinous xanthomatosis (CTX) is an anomaly of bile acid synthesis characterized by neonatal cholestasis, childhood-onset cataract, adolescent to young adult-onset tendon xanthomata, and brain xanthomata with adult-onset neurologic dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CTX</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cerebrotendinous xanthomatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sterol 27-hydroxylase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Cerebrotendinous xanthomatosis</rdfs:label>
        <skos:broadMatch>ICD-10:E75.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C52.11</skos:broadMatch>
        <skos:exactMatch>MONDO:0008948</skos:exactMatch>
        <skos:exactMatch>MeSH:D019294</skos:exactMatch>
        <skos:exactMatch>OMIM:213700</skos:exactMatch>
        <skos:exactMatch>UMLS:C0238052</skos:exactMatch>
    </owl:Class>

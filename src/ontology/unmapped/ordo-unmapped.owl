    <!-- http://www.orpha.net/ORDO/Orphanet_363686 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363686">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/30778"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, syndromic intellectual disability disorder characterized by global development delay with very limited or absent speech and language, severe intellectual disability, long slender fingers, ocular abnormalities (typically strabismus or hypermetropia), and facial dysmorphism that includes a grimacing facial expression, a tubular-shaped nose with a prominent, broad base and tip, and other variable features, such as broad forehead, hypertelorism, deep-set eyes, narrow palpebral fissures, short philtrum and/or broad mouth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Severe intellectual disability-poor language-strabismus-grimacing face-long fingers syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe intellectual disability-poor language-strabismus-grimacing face-long fingers syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0014034</skos:exactMatch>
        <skos:exactMatch>OMIM:615074</skos:exactMatch>
        <skos:exactMatch>UMLS:C4750954</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_363686"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Severe intellectual disability-poor language-strabismus-grimacing face-long fingers syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_363694 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_363694">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183592"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_275853"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35696"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>

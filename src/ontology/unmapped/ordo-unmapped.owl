        <obo:IAO_0000115 xml:lang="en">A rare genetic bone disease characterized by the association of osteogenesis imperfecta and congenital joint contractures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bruck syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteogenesis imperfecta-congenital joint contractures syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Bruck syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.KY</skos:broadMatch>
        <skos:exactMatch>MONDO:0017195</skos:exactMatch>
        <skos:exactMatch>MedDRA:10063718</skos:exactMatch>
        <skos:exactMatch>OMIM:259450</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432253</skos:exactMatch>
        <skos:narrowMatch>OMIM:609220</skos:narrowMatch>
    </owl:Class>

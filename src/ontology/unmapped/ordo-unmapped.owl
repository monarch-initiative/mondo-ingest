    <!-- http://www.orpha.net/ORDO/Orphanet_264450 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_264450">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262758"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Trisomy 8p is a rare chromosomal anomaly syndrome, resulting from the partial duplication of the short arm of chromosome 8, with highly variable phenotype ranging from no dysmorphic features and only mild intellectual disability to patients with severe developmental delay, neonatal hypotonia, short stature, profound intellectual disability, mild dysmorphic features (e.g. mild ptosis, hypertelorism, down-slanting palpebral fissures, broad nasal bridge, short, prominent philtrum, abnormal dentition) and structural brain abnormalities. Autism, epilepsy, and spastic paraplegia have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Duplication 8p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Trisomy 8p syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Trisomy 8p syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.2</skos:broadMatch>
        <skos:exactMatch>MONDO:0017013</skos:exactMatch>
        <skos:exactMatch>MeSH:C538019</skos:exactMatch>
        <skos:exactMatch>UMLS:C0795825</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_264450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Trisomy 8p syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2645 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2645">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139393"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93450"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3688"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia with disorganized development of skeletal components characterized by rhizomelic dwarfism, severe craniofacial dysmorphism including craniosynostosis, acrocephaly, a prominent forehead, midface hypoplasia, hypertelorism, depressed nasal bridge, anteverted nostrils, macroglossia, unerupted teeth. Patients also present with short neck, short and bowed limbs, short and broad hands and fingers, and flat feet. Intelligence is not affected.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Osteoglophonic dwarfism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteoglosphonic dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteoglosphonic dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.2Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008150</skos:exactMatch>
        <skos:exactMatch>MeSH:C536050</skos:exactMatch>
        <skos:exactMatch>OMIM:166250</skos:exactMatch>
        <skos:exactMatch>UMLS:C0432283</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2645"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

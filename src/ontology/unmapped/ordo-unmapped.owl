    <!-- http://www.orpha.net/ORDO/Orphanet_313772 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_313772">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_316240"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35698"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/315"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Early-onset spastic ataxia-myoclonic epilepsy-neuropathy syndrome is a rare hereditary spastic ataxia disorder characterized by childhood onset of slowly progressive lower limb spastic paraparesis and cerebellar ataxia (with dysarthria, swallowing difficulties, motor degeneration), associated with sensorimotor neuropathy (including muscle weakness and distal amyotrophy in lower extremities) and progressive myoclonic epilepsy. Ocular signs (ptosis, oculomotor apraxia), dysmetria, dysdiadochokinesia, dystonic movements and myoclonus may also be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">AFG3L2-related spastic ataxia-myoclonic epilepsy-neuropathy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal recessive spastic ataxia type 5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Early-onset spastic ataxia-myoclonic epilepsy-neuropathy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SPAX5</oboInOwl:hasExactSynonym>
        <rdfs:label>Early-onset spastic ataxia-myoclonic epilepsy-neuropathy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A03.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013776</skos:exactMatch>
        <skos:exactMatch>OMIM:614487</skos:exactMatch>
        <skos:exactMatch>UMLS:C3280977</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_313772"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Early-onset spastic ataxia-myoclonic epilepsy-neuropathy syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_313781 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_313781">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_261992"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">20p13 microdeletion syndrome is a rare chromosomal anomaly characterized by developmental delay, mild to moderate intellectual disability, epilepsy, and unspecific dysmorphic signs. High palate, delayed permanent tooth eruption, hypoplastic fingernails, clinodactyly and short fingers have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">20p subtelomeric deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>20p13 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(20)(p13)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 20p13</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(20)(p13)</oboInOwl:hasExactSynonym>
        <rdfs:label>20p13 microdeletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:exactMatch>MONDO:0017780</skos:exactMatch>
        <skos:exactMatch>UMLS:C4750789</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_313781"/>

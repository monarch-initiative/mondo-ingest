    <!-- http://www.orpha.net/ORDO/Orphanet_100997 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_100997">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_320350"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

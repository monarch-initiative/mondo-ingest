    <!-- http://www.orpha.net/ORDO/Orphanet_439755 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_439755">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_439737"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <obo:IAO_0000115 xml:lang="en">Single-organ polyarteritis nodosa (PAN) is a rare, often mild form of PAN characterized by limited disease without generalized manifestations, most often affecting the skin (cutaneous PAN), the brain, eyes, pancreas, testicles, ureter, breasts, or ovaries. Affected patients are often younger than those with systemic PAN and relapses appear to be more common.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Single-organ PAN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Single-organ periarteritis nodosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Single-organ polyarteritis nodosa</oboInOwl:hasExactSynonym>
        <rdfs:label>Single-organ polyarteritis nodosa</rdfs:label>
        <skos:broadMatch>ICD-10:M30.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A44.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0018595</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680051</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_439755"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Single-organ polyarteritis nodosa</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_439762 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_439762">

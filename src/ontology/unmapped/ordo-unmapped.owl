    <!-- http://www.orpha.net/ORDO/Orphanet_59315 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_59315">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>

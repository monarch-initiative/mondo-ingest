        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_169355"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182228"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522043"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_717757"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13890"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, systemic autoimmune disease characterized by failure to thrive, global developmental delay, distinctive craniofacial dysmorphism (relative macrocephaly, dolichocephaly, frontal bossing, orbital proptosis, flattened midface with a prominent occiput, low, posteriorly rotated ears, micrognatia), hepato- and/or splenomegaly, and multisystemic autoimmune disease involving the lungs, liver, gut and/or thyroid gland.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Syndromic multisystem autoimmune disease due to Itch deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Syndromic multisystem autoimmune disease due to Itch deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D89.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A43.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013245</skos:exactMatch>
        <skos:exactMatch>OMIM:613385</skos:exactMatch>
        <skos:exactMatch>UMLS:C4755273</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

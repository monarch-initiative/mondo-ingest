        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_300293 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_300293">

    <!-- http://www.orpha.net/ORDO/Orphanet_285 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_285">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98249"/>
        <obo:IAO_0000115 xml:lang="en">Ehlers-Danlos syndrome, hypermobility type (HT-EDS) is the most frequent form of EDS, a group of hereditary connective tissue diseases, and is characterized by joint hyperlaxity, mild skin hyperextensibility, tissue fragility and extra-musculoskeletal manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EDS III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EDS-HT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ehlers-Danlos syndrome hypermobility type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ehlers-Danlos syndrome type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypermobile EDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypermobile Ehlers-Danlos syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hEDS</oboInOwl:hasExactSynonym>
        <rdfs:label>Hypermobile Ehlers-Danlos syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q79.6</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD28.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0007523</skos:exactMatch>
        <skos:exactMatch>MeSH:C536196</skos:exactMatch>

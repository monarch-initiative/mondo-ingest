        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79207"/>
        <obo:IAO_0000115 xml:lang="en">A rare lysosomal storage disease characterized by a spectrum of clinical manifestations including neurological and developmental disorders with a severity ranging from the milder form, also called Salla disease (SD), to the most severe phenotype, also called infantile free sialic acid storage disease (ISSD).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FSASD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Free sialic acid storage disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Free sialic acid storage disorder</oboInOwl:hasExactSynonym>
        <rdfs:label>Free sialic acid storage disease</rdfs:label>
        <skos:broadMatch>ICD-10:E77.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0019366</skos:exactMatch>
        <skos:exactMatch>MeSH:C538523</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931872</skos:exactMatch>
        <skos:narrowMatch>OMIM:269920</skos:narrowMatch>
        <skos:narrowMatch>OMIM:604369</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_834"/>

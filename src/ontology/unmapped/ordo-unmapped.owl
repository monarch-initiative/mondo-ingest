            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, highly malignant central nervous system (CNS) rhabdoid tumor (RT) found almost exclusively in children.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ATRT</oboInOwl:hasExactSynonym>

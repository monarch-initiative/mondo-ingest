        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_767"/>
        <obo:IAO_0000115 xml:lang="en">Secondary polyarteritis nodosa (PAN) is a rare serious form of PAN characterized by vasculitis in a background of viral infection, primarily with hepatitis B virus (HBV).</obo:IAO_0000115>

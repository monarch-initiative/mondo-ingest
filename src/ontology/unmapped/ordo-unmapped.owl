                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/25740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4816"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7498"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare ciliopathy characterized by progressive hearing and visual loss in the first decades of life and, in some cases, vestibular dysfunction. Patients have normal hearing at birth. Onset of hearing loss is usually in late childhood or adolescence after development of speech. Profound deafness is mostly reported by middle age. Retinitis pigmentosa related visual loss also develops in late childhood or adolescence. Developmental motor milestones are generally normal but vestibular dysfunction may occur in adulthood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">USH3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Usher syndrome type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Usher syndrome type 3</rdfs:label>
        <skos:broadMatch>ICD-10:H35.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2H.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0016485</skos:exactMatch>
        <skos:exactMatch>UMLS:C1568248</skos:exactMatch>
        <skos:narrowMatch>OMIM:276902</skos:narrowMatch>
        <skos:narrowMatch>OMIM:500004</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614504</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617236</skos:narrowMatch>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_97120"/>
        <obo:IAO_0000115 xml:lang="en">A rare distal arthrogryposis characterized by multiple congenital contractures of limbs, without primary neurologic and/or muscle disease that affects limb function, and a mild to severe scoliosis. Intelligence is normal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Arthrogryposis-severe scoliosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal arthrogryposis type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal arthrogryposis type IID</oboInOwl:hasExactSynonym>
        <rdfs:label>Arthrogryposis-severe scoliosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q68.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.4Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0012195</skos:exactMatch>
        <skos:exactMatch>MeSH:C563791</skos:exactMatch>
        <skos:exactMatch>OMIM:609128</skos:exactMatch>

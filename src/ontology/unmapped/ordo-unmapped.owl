    <!-- http://www.orpha.net/ORDO/Orphanet_141000 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_141000">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_140997"/>

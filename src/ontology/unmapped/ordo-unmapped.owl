        <obo:IAO_0000115 xml:lang="en">Cholera is an infectious disease, caused by intestinal infection with &lt;i&gt;Vibrio cholerae&lt;/i&gt;, characterized by massive watery diarrhea and severe dehydration that can lead to shock and death if left untreated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cholera</oboInOwl:hasExactSynonym>
        <rdfs:label>Cholera</rdfs:label>
        <skos:exactMatch>ICD-11:1A00</skos:exactMatch>
        <skos:exactMatch>MONDO:0015766</skos:exactMatch>
        <skos:exactMatch>MeSH:D002771</skos:exactMatch>
        <skos:exactMatch>MedDRA:10008631</skos:exactMatch>
        <skos:exactMatch>UMLS:C0008354</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A00.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A00.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A00.9</skos:narrowMatch>
    </owl:Class>

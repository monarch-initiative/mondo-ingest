        <skos:exactMatch>MeSH:D002115</skos:exactMatch>
        <skos:exactMatch>MedDRA:10051714</skos:exactMatch>
        <skos:exactMatch>UMLS:C0006666</skos:exactMatch>
    </owl:Class>

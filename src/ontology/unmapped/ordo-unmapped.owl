        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare cono-truncal anomaly in which both the aorta and pulmonary artery originate, either entirely or predominantly, from the morphologic right ventricle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DORV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Double outlet right ventricle</oboInOwl:hasExactSynonym>
        <rdfs:label>Double outlet right ventricle</rdfs:label>
        <skos:broadMatch>OMIM:217095</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q20.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA85.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0018089</skos:exactMatch>
        <skos:exactMatch>MeSH:D004310</skos:exactMatch>
        <skos:exactMatch>MedDRA:10013611</skos:exactMatch>
        <skos:exactMatch>UMLS:C0013069</skos:exactMatch>
    </owl:Class>

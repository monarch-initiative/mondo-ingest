    <!-- http://www.orpha.net/ORDO/Orphanet_465 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_465">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_250808"/>

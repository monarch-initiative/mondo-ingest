        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98292"/>
        <obo:IAO_0000115 xml:lang="en">A heterogeneous group of rare, acquired and chronic hematological malignancies related to an abnormal accumulation/proliferation of neoplastic mast cells (MCs) in one or several organs, mainly the bone marrow (BM), associated frequently with skin involvement.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Systemic mastocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Systemic mastocytosis</rdfs:label>
        <skos:exactMatch>ICD-10:C96.2</skos:exactMatch>
        <skos:exactMatch>ICD-11:2A21.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0016586</skos:exactMatch>

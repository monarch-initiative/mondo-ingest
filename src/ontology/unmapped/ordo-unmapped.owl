        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/177"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inborn error of metabolism (organic aciduria) characterized by elevated urinary levels of numerous N-acetylated amino acids. A causal relationship with a specific clinical phenotype is uncertain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ACY1D</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Aminoacylase 1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">N-acyl-L-amino acid amidohydrolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">N-acyl-aliphatic-L-amino acid amidohydrolase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Aminoacylase 1 deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E72.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C50.E1</skos:broadMatch>
        <skos:exactMatch>MONDO:0012368</skos:exactMatch>
        <skos:exactMatch>MeSH:C538246</skos:exactMatch>
        <skos:exactMatch>OMIM:609924</skos:exactMatch>
        <skos:exactMatch>UMLS:C1835922</skos:exactMatch>
    </owl:Class>

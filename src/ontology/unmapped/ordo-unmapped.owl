    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_166265 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_166265">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_49042"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3054"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Dentinogenesis imperfecta type 3 (DGI-3) is a rare, severe form of dentinogenesis imperfecta (DGI) characterized by opalescent primary and permanent teeth, marked attrition, large pulp chambers, multiple pulp exposure and shell teeth radiographically (i.e. teeth which appear hollow due to dentin hypotrophy).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Dentinogenesis imperfecta type 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dentinogenesis imperfecta, Shields type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Dentinogenesis imperfecta type 3</rdfs:label>
        <skos:broadMatch>ICD-10:K00.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA30.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0007442</skos:exactMatch>
        <skos:exactMatch>MeSH:C538216</skos:exactMatch>
        <skos:exactMatch>OMIM:125500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0399378</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_166265"/>

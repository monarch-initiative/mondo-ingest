            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Beta-thalassemia (BT) intermedia is a form of BT characterized by mild to moderate anemia which does not or only occasionally requires transfusion.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Beta-NTDT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Beta-thalassemia intermedia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-transfusion dependent beta-thalassemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Beta-thalassemia intermedia</rdfs:label>
        <skos:broadMatch>ICD-10:D56.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A50.2</skos:broadMatch>
        <skos:broadMatch>OMIM:613985</skos:broadMatch>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716299"/>
        <obo:IAO_0000115 xml:lang="en">This syndrome is characterised by the association of microtia, eye coloboma, and imperforation of the nasolacrimal duct.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Balikova-Vermeesch syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Microtia-eye coloboma-imperforation of the nasolacrimal duct syndrome</oboInOwl:hasExactSynonym>

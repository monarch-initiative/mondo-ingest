    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_96187 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96187">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98153"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_247623 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247623">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_436"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic form of hypophosphatasia (HPP) characterized by markedly impaired bone mineralization &lt;i&gt;in utero&lt;/i&gt; due to reduced activity of serum alkaline phosphatase (ALP) and causing stillbirth or respiratory failure within days of birth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Perinatal lethal Rathbun disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Perinatal lethal hypophosphatasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Perinatal lethal phosphoethanolaminuria</oboInOwl:hasExactSynonym>
        <rdfs:label>Perinatal lethal hypophosphatasia</rdfs:label>
        <skos:broadMatch>ICD-10:E83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.3</skos:broadMatch>
        <skos:broadMatch>OMIM:241500</skos:broadMatch>
        <skos:exactMatch>MONDO:0016605</skos:exactMatch>
        <skos:exactMatch>MeSH:C567107</skos:exactMatch>
        <skos:exactMatch>UMLS:C2673477</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247623"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Perinatal lethal hypophosphatasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247638 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247638">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139393"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_436"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A very rare form of hypophosphatasia characterized by prenatal skeletal manifestations (limb shortening and bowing) that slowly resolve spontaneously and later may develop into the moderate childhood or adult forms of the disease.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Prenatal benign Rathbun disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Prenatal benign hypophosphatasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Prenatal benign phosphoethanolaminuria</oboInOwl:hasExactSynonym>
        <rdfs:label>Prenatal benign hypophosphatasia</rdfs:label>
        <skos:broadMatch>ICD-10:E83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.3</skos:broadMatch>
        <skos:exactMatch>UMLS:C5679616</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247638"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Prenatal benign hypophosphatasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_247651 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_247651">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139393"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_436"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, severe, genetic form of hypophosphatasia (HPP) characterized by infantile rickets without elevated serum alkaline phosphatase (ALP) activity and a wide range of clinical manifestations due to hypomineralization.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Infantile Rathbun disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Infantile hypophosphatasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Infantile phosphoethanolaminuria</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile hypophosphatasia</rdfs:label>
        <skos:broadMatch>ICD-10:E83.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.3</skos:broadMatch>
        <skos:exactMatch>MeSH:C562646</skos:exactMatch>
        <skos:exactMatch>OMIM:241500</skos:exactMatch>
        <skos:exactMatch>UMLS:C0268412</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_247651"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

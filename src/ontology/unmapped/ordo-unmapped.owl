            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Localized epidermolysis bullosa simplex, formerly known as EBS, Weber-Cockayne, is a basal subtype of epidermolysis bullosa simplex (EBS). The disease is characterized by blisters occurring mainly on the palms and soles, exacerbated by warm weather.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EBS-loc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Epidermolysis bullosa simplex of palms and soles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Epidermolysis bullosa simplex, Weber-Cockayne type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Localized EBS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Localized epidermolysis bullosa simplex</oboInOwl:hasExactSynonym>
        <rdfs:label>Localized epidermolysis bullosa simplex</rdfs:label>
        <skos:broadMatch>ICD-10:Q81.0</skos:broadMatch>

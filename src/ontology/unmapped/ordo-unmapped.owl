        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Thiamine-responsive maple syrup urine disease (thiamine-responsive MSUD) is a less severe variant of MSUD that manifests with a phenotype similar to intermediate MSUD but that responds positively to treatment with thiamine.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Thiamine-responsive BCKD deficiency</oboInOwl:hasExactSynonym>

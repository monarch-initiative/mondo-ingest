    <!-- http://www.orpha.net/ORDO/Orphanet_47159 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_47159">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_314822"/>

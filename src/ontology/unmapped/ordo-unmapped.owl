    <!-- http://www.orpha.net/ORDO/Orphanet_391307 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_391307">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

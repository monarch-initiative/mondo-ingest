    <!-- http://www.orpha.net/ORDO/Orphanet_2261 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2261">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

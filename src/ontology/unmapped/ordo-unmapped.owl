    <!-- http://www.orpha.net/ORDO/Orphanet_98848 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98848">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2467"/>

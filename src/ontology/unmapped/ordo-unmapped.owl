    <!-- http://www.orpha.net/ORDO/Orphanet_319266 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319266">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_341"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Omsk hemorrhagic fever (OHF), caused by Omsk hemorrhagic fever virus (OHFV), is a zoonotic disease characterized by fever, nausea, myalgia and moderately severe hemorrhagic manifestations as well as in some cases meningitis, pneumonia and nephrosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Omsk hemorrhagic fever</oboInOwl:hasExactSynonym>
        <rdfs:label>Omsk hemorrhagic fever</rdfs:label>
        <skos:exactMatch>ICD-10:A98.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:1D4A</skos:exactMatch>
        <skos:exactMatch>MONDO:0017882</skos:exactMatch>
        <skos:exactMatch>MeSH:D006481</skos:exactMatch>
        <skos:exactMatch>MedDRA:10030310</skos:exactMatch>
        <skos:exactMatch>UMLS:C0019103</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_319266"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Omsk hemorrhagic fever</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

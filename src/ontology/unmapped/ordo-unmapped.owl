    <!-- http://www.orpha.net/ORDO/Orphanet_488197 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_488197">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_716405"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98634"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/31582"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic retinal disorder characterized by bilateral iris coloboma, progressive retinal dystrophy and marked loss of vision, with or without congenital cataracts. Iridolenticular adhesions, scattered retinal pigmented epithelia mottling, and mild hypermetropic astigmatism may be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial progressive retinal dystrophy-iris coloboma-congenital cataract syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial progressive retinal dystrophy-iris coloboma-congenital cataract syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q13.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA10.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0014747</skos:exactMatch>
        <skos:exactMatch>OMIM:616722</skos:exactMatch>
        <skos:exactMatch>UMLS:C5567488</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_488197"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Familial progressive retinal dystrophy-iris coloboma-congenital cataract syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



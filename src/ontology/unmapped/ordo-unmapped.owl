        <owl:annotatedTarget>Tunnel subaortic stenosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_99054 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_99054">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_3189"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <oboInOwl:hasExactSynonym>Valvular pulmonary stenosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Valvular pulmonary stenosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q22.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0020395</skos:exactMatch>
        <skos:exactMatch>MeSH:D011666</skos:exactMatch>
        <skos:exactMatch>MedDRA:10037450</skos:exactMatch>
        <skos:exactMatch>UMLS:C1860336</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_99054"/>

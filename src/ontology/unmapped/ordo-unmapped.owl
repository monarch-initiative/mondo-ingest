    <!-- http://www.orpha.net/ORDO/Orphanet_600731 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_600731">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_424016 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_424016">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_424013"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A very rare tumor of the intestine, originating from the epithelium of the anal canal (including the mucosal surface, anal glands, and lining of fistulous tracts), macroscopically appearing as a nodular, often ulcerated, invasive mass located in the anal canal. Patients often present with rectal bleeding, as well as difficulty and pain during defecation. Inguinal lymphadenopathy, if present, usually indicates metastatic spread.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Adenocarcinoma of the anal canal</oboInOwl:hasExactSynonym>
        <rdfs:label>Adenocarcinoma of the anal canal</rdfs:label>
        <skos:broadMatch>ICD-10:C21.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:2C00.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0002735</skos:exactMatch>
        <skos:exactMatch>UMLS:C1332259</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_424016"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Adenocarcinoma of the anal canal</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_424019 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_424019">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_424013"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Squamous cell carcinoma of the anal canal is a rare epithelial intestinal neoplasm, arising from squamous epithelial cells in the anal canal, with variable macroscopic appearance, ranging from small, benign lesions (that mimick fissures, hemorrhoids or anorectal fistulae) to a large, exophytic or ulcerating tumor localized within the anal canal. Patients may be asymptomatic or present difficulty to defecate, anal bleeding, pain and/or discharge, and often have a history of chronic anal fistulae and abscesses, Crohn&apos;s disease, hemorrhoids, or, especially in younger patients, immunosuppression (such as HIV infection). Association with HPV infection is commonly reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Squamous cell carcinoma of the anal canal</oboInOwl:hasExactSynonym>
        <rdfs:label>Squamous cell carcinoma of the anal canal</rdfs:label>
        <skos:broadMatch>ICD-10:C21.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:2C00.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0004132</skos:exactMatch>
        <skos:exactMatch>UMLS:C4301960</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_424019"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Squamous cell carcinoma of the anal canal</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_424027 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_424027">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_352306"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98261"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/14253"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, neurological disorder characterized by childhood to adolescent-onset of action myoclonus, generalized tonic-clonic seizures, and slowly progressive, moderate to severe cognitive impairment that may lead to dementia. EEG reveals progressive slowing of background activity and epileptic abnormalities and brain MRI shows cerebellar and brainstem atrophy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">EPM8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PME type 8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive myoclonic epilepsy due to CERS1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progressive myoclonic epilepsy type 8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Progressive myoclonus epilepsy type 8</oboInOwl:hasExactSynonym>
        <rdfs:label>Progressive myoclonic epilepsy type 8</rdfs:label>
        <skos:broadMatch>ICD-10:G40.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A61.41</skos:broadMatch>
        <skos:exactMatch>MONDO:0014545</skos:exactMatch>
        <skos:exactMatch>OMIM:616230</skos:exactMatch>
        <skos:exactMatch>UMLS:C5190825</skos:exactMatch>
    </owl:Class>

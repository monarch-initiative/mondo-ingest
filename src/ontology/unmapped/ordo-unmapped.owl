    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_205">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101940"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309816"/>

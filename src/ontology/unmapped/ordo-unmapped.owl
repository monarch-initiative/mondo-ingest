    <!-- http://www.orpha.net/ORDO/Orphanet_66646 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_66646">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90077"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98292"/>
        <obo:IAO_0000115 xml:lang="en">A rare group of mastocytosis diseases characterized by abnormal accumulation and proliferation of mast cells in the skin and including the three recognised forms: diffuse cutaneous mastocytosis, cutaneous mastocytoma and, the most common form, maculopapular cutaneous mastocytosis. In some cases (most commonly in adults), cutaneous mastocytosis may occur in association with mast cell infiltration of various extracutaneous organs, in which case the disorder is referred to as systemic mastocytosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cutaneous mastocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Cutaneous mastocytosis</rdfs:label>
        <skos:exactMatch>ICD-11:2A21.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0019023</skos:exactMatch>
        <skos:exactMatch>MONDO:19023</skos:exactMatch>
        <skos:exactMatch>MeSH:D034701</skos:exactMatch>
        <skos:exactMatch>UMLS:C1136033</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_66646"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Cutaneous mastocytosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_66661 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_66661">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98292"/>
        <obo:IAO_0000115 xml:lang="en">Mast cell sarcoma is a rare, neoplastic disease characterized by locally destructive sarcoma-like growth of a solitary mass, composed of atypical mast cells, and without systemic involvement. It can affect any organ and the symptoms depend on the location. Cells are medium to large, pleomorphic or epithelioid, with oval, bilobed or multilobulated nuclei, sometimes prominent multinucleated giant cells. The disease closely resembles other neoplasms and may share associated markers, however the tumor is positive for mast cell tryptase.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mast cell sarcoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Mast cell sarcoma</rdfs:label>
        <skos:broadMatch>ICD-10:C96.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:2A21.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0019024</skos:exactMatch>
        <skos:exactMatch>MeSH:D012515</skos:exactMatch>
        <skos:exactMatch>UMLS:C0036221</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_66661"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Mast cell sarcoma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_66662 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_66662">

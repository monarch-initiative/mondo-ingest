    <!-- http://www.orpha.net/ORDO/Orphanet_157832 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_157832">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156246"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_188 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_188">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182222"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Systemic capillary leak syndrome (SCLS) is a severe systemic disease due to increased capillary permeability, characterized by episodes of hypotension, edema and hypovolemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Capillary hyperpermeability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Capillary leak syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Clarkson disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic capillary leak syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCLS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Systemic capillary leak syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Systemic capillary leak syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:I78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:BD5Y</skos:broadMatch>
        <skos:exactMatch>MONDO:1956</skos:exactMatch>
        <skos:exactMatch>MeSH:D019559</skos:exactMatch>
        <skos:exactMatch>MedDRA:10007196</skos:exactMatch>
        <skos:exactMatch>UMLS:C0343084</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

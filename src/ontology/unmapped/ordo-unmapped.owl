            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental disorder of the ciliopathy group characterized by postaxial polydactyly, mesomelic shortening of the legs (tibial hypoplasia), nonspecific orofacial features, and variable involvement of viscera (kidneys, liver) and the central nervous system.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Baraitser-Burn syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mohr-Majewski syndrome</oboInOwl:hasExactSynonym>

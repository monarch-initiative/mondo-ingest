    <!-- http://www.orpha.net/ORDO/Orphanet_79373 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79373">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139027"/>

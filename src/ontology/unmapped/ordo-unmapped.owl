            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, renal tubular disease characterized by progressive outgrowths of fluid-filled cysts from the renal epithelium, which can manifest with hematuria, urinary tract infections, hypertension, and abdominal or flank pain. The slowly progressive loss of kidney function may evolve to end stage kidney disease (ESKD).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ADPKD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Autosomal dominant polycystic kidney disease</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant polycystic kidney disease</rdfs:label>
        <skos:exactMatch>ICD-10:Q61.2</skos:exactMatch>
        <skos:exactMatch>ICD-11:GB81</skos:exactMatch>
        <skos:exactMatch>MONDO:0004691</skos:exactMatch>
        <skos:exactMatch>MeSH:D016891</skos:exactMatch>
        <skos:exactMatch>MedDRA:10036046</skos:exactMatch>
        <skos:exactMatch>UMLS:C0085413</skos:exactMatch>
        <skos:narrowMatch>OMIM:173900</skos:narrowMatch>
        <skos:narrowMatch>OMIM:600666</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613095</skos:narrowMatch>

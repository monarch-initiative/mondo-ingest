    <!-- http://www.orpha.net/ORDO/Orphanet_7 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_7">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

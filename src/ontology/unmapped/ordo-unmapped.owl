    <!-- http://www.orpha.net/ORDO/Orphanet_79409 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79409">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_303"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

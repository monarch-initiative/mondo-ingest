            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Deafness with labyrinthine aplasia, microtia, and microdontia (LAMM) is a genetic transmission deafness syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Deafness with labyrinthine aplasia, microtia, and microdontia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hearing loss with labyrinthine aplasia, microtia, and microdontia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LAMM syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Microdontia-type I microtia-deafness syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Microdontia-type I microtia-hearing loss syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Deafness with labyrinthine aplasia, microtia, and microdontia</rdfs:label>
        <skos:broadMatch>ICD-10:Q16.5</skos:broadMatch>

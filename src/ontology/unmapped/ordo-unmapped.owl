            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Type I lattice corneal dystrophy (LCDI) is a frequent form of stromal corneal dystrophy characterized by a network of delicate interdigitating branching filamentous opacities within the cornea with progressive visual impairment and no systemic manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Biber-Haab-Dimmer dystrophy</oboInOwl:hasExactSynonym>

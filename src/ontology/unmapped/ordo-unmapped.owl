    <!-- http://www.orpha.net/ORDO/Orphanet_708046 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_708046">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_707944"/>
        <obo:IAO_0000115 xml:lang="en">A rare fast-flow vascular malformation characterized by direct connections between extracranial arteries and veins bypassing the capillary bed due to abnormal vasculogenesis or angiogenesis. These fast-flow vascular lesions comprise numerous vessels which may be tortuous and dysfunctional, resulting in red discoloration, pain, ulceration, bleeding, and severe deformities. They are primarily found in the head and neck region, followed by the limbs and trunk.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Peripheral AVM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Peripheral arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Peripheral arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.8</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_708046"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Peripheral arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_708051 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_708051">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_707944"/>
        <obo:IAO_0000115 xml:lang="en">A rare fast-flow vascular anomaly characterized by direct extracranial artery-to-vein communication without an intervening nidus. The majority of the cases are asymptomatic. When present, the symptoms may include fatigue, dyspnea, palpitations, congestive heart failure, and pulmonary hypertension.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Peripheral AVF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Peripheral arteriovenous fistula</oboInOwl:hasExactSynonym>
        <rdfs:label>Peripheral arteriovenous fistula</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.8</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_708051"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Peripheral arteriovenous fistula</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



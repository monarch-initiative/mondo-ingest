    <!-- http://www.orpha.net/ORDO/Orphanet_945 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_945">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98038"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital malformation characterized by the absence of calvarial bones, dura mater and associated muscles while skull base, facial bones and brain structures are normal. Central nervous system is usually unaffected, however some neuropathological abnormalities such as holoprosencephaly, hydrocephalus, micropolygyria and gyration anomalies can be present. Prenatal diagnosis by ultrasonography is usually confirmed by magnetic resonance imaging as it can be confused with anencephaly or encephalocele.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Acalvaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary acalvaria</oboInOwl:hasExactSynonym>
        <rdfs:label>Acalvaria</rdfs:label>
        <skos:broadMatch>ICD-10:Q00.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA00.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019795</skos:exactMatch>
        <skos:exactMatch>MeSH:C535570</skos:exactMatch>
        <skos:exactMatch>UMLS:C2930936</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_945"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Acalvaria</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



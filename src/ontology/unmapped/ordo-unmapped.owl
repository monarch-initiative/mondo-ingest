        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic endocrine disease characterized by the association of hypergonadotropic hypogonadism and cataracts with onset during adolescence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hypergonadotropic hypogonadism-cataract syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lubinsky syndrome</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_293987 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_293987">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101944"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156610"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_240371"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare syndromic endocrine disease characterized by childhood-onset hyperphagia and obesity, alveolar hypoventilation, dysautonomia, hypothalamic dysfunction and neurobehavioral disorders. Central hypothyroidism, endocrine anomalies, electrolyte imbalances and respiratory failure may also be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ROHHAD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ROHHADNET</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rapid-onset childhood obesity-hypothalamic dysfunction-hypoventilation-autonomic dysregulation syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rapid-onset childhood obesity-hypothalamic dysfunction-hypoventilation-autonomic dysregulation-neural tumors syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Rapid-onset childhood obesity-hypothalamic dysfunction-hypoventilation-autonomic dysregulation syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E66.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A61.Y </skos:broadMatch>
        <skos:exactMatch>MONDO:0017408</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081396</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751121</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_293987"/>

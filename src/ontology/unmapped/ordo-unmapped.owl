    <!-- http://www.orpha.net/ORDO/Orphanet_355 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_355">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79225"/>
        <obo:IAO_0000115 xml:lang="en">Gaucher disease (GD) is a lysosomal storage disorder encompassing three main forms (types 1, 2 and 3), a fetal form and a variant with cardiac involvement (Gaucher disease - ophthalmoplegia - cardiovascular calcification or Gaucher-like disease).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acid beta-glucosidase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gaucher disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glucocerebrosidase deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Gaucher disease</rdfs:label>
        <skos:broadMatch>ICD-10:E75.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C56.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018150</skos:exactMatch>
        <skos:exactMatch>MeSH:D005776</skos:exactMatch>
        <skos:exactMatch>MedDRA:10018048</skos:exactMatch>
        <skos:exactMatch>UMLS:C0017205</skos:exactMatch>

        <oboInOwl:hasExactSynonym xml:lang="en">GSD, type IIb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease due to LAMP-2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease, type 2B</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogen storage disease, type IIb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Glycogenosis due to LAMP-2 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lysosomal glycogen storage disease with normal acid maltase activity</oboInOwl:hasExactSynonym>
        <rdfs:label>Danon disease</rdfs:label>

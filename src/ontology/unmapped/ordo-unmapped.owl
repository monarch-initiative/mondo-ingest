                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/1020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare mitochondrial oxidative phosphorylation disorder, caused by complex&amp;nbsp;III deficiency, characterized by congenital sensorineural hearing loss and pili torti. Hypogonadism and intellectual disability were occasionally reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Björnstad syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Crandall syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Deafness-pili torti-hypogonadism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hearing loss-pili torti-hypogonadism syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Björnstad syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:EC21.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0009872</skos:exactMatch>
        <skos:exactMatch>MeSH:C537633</skos:exactMatch>
        <skos:exactMatch>OMIM:262000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0266006</skos:exactMatch>
    </owl:Class>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5101"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Radio-ulnar synostosis-amegakaryocytic thrombocytopenia syndrome is characterised by the association of proximal fusion of the radius and ulna with congenital amegakaryocytic thrombocytopaenia. Less than 10 cases have been reported in the literature so far. The syndrome is transmitted as an autosomal dominant trait and is caused by mutations in the &lt;i&gt;HOXA11&lt;/i&gt; gene (7p15).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ATRUS syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Radio-ulnar synostosis-amegakaryocytic thrombocytopenia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Radio-ulnar synostosis-amegakaryocytic thrombocytopenia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B64.01</skos:broadMatch>

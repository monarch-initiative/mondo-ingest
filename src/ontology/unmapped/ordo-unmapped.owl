    <!-- http://www.orpha.net/ORDO/Orphanet_3074 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3074">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Intellectual disability-short stature-hypertelorism syndrome is a rare genetic syndromic intellectual disability characterized by short stature, mild to moderate intellectual disability, craniofacial dysmorphism (prominent broad &apos;square&apos; forehead, hypertelorism, depressed nasal bridge, broad nasal tip and anteverted nares) and early hypotonia, typically present until infancy. There have been no further descriptions in the literature since 1991.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Intellectual disability-short stature-hypertelorism syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Stoll-Géraudel-Chauvin syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Intellectual disability-short stature-hypertelorism syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0017668</skos:exactMatch>
        <skos:exactMatch>UMLS:C4749650</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3074"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Intellectual disability-short stature-hypertelorism syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3077 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3077">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_423994 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_423994">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_423991"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare epithelial tumour of the colon arising from squamous cells of the colorectal epithelium without the presence of squamous-lined fistulous tracts or a proximal extension of an anal squamous cell carcinoma. It usually presents with nonspecific symptoms, such as anorexia, weight loss, abdominal pain, changes of bowel habits, hematochesia or melena. Cases of severe, symptomatic hypercalcemia have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Squamous cell carcinoma of the colon</oboInOwl:hasExactSynonym>
        <rdfs:label>Squamous cell carcinoma of the colon</rdfs:label>
        <skos:broadMatch>ICD-11:2B90.Y</skos:broadMatch>

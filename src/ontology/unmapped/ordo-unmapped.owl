    <!-- http://www.orpha.net/ORDO/Orphanet_79298 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79298">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276585"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A form of congenital diazoxide-resistant hyperinsulinism characterized by recurrent episodes of profound hypoglycemia caused by an excessive/uncontrolled insulin secretion (inappropriate for the level of glycemia) due to a focal adenomatous hyperplasia of pancreas, that is unresponsive to medical treatment with diazoxide.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Diazoxide-resistant focal hyperinsulinism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperinsulinemic hypoglycemia, diazoxide-resistant focal form</oboInOwl:hasExactSynonym>
        <rdfs:label>Diazoxide-resistant focal hyperinsulinism</rdfs:label>
        <skos:exactMatch>MONDO:0019265</skos:exactMatch>
        <skos:exactMatch>MONDO:19265</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680204</skos:exactMatch>
    </owl:Class>

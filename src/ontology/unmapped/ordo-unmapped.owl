                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12856"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of functioning pancreatic neuroendocrine tumor characterized most commonly by a solitary, small pancreatic lesion that causes hyperinsulinemic hypoglycemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Insulinoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Insulinoma</rdfs:label>
        <skos:broadMatch>ICD-11:2C10.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0005048</skos:exactMatch>
        <skos:exactMatch>MONDO:5048</skos:exactMatch>
        <skos:exactMatch>MeSH:D007340</skos:exactMatch>
        <skos:exactMatch>MedDRA:10022498</skos:exactMatch>
        <skos:exactMatch>UMLS:C0021670</skos:exactMatch>
        <skos:narrowMatch>ICD-10:C25.4</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:D13.7</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:D37.7</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Biermer disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NON RARE IN EUROPE: Juvenile onset pernicious anemia</oboInOwl:hasExactSynonym>

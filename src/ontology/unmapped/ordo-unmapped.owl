            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spinocerebellar ataxia type 21 (SCA21) is a very rare subtype of type I autosomal dominant cerebellar ataxia (ADCA type I). It is characterized by slowly progressive cerebellar ataxia, mild cognitive impairment, postural and/or resting tremor, bradykinesia, and rigidity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA21</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 21</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_90790 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90790">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_399849"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_400018"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6413"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare keratinopathic ichthyosis (KPI) characterized by a blistering phenotype at birth which progressively becomes hyperkeratotic.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant epidermolytic ichthyosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">BCIE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bullous congenital ichthyosiform erythroderma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bullous congenital ichthyosiform erythroderma of Brock</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bullous ichthyosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EHK</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Epidermolytic hyperkeratosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ichthyosis hystrix Brocq type</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant epidermolytic ichthyosis</rdfs:label>
        <skos:broadMatch>ICD-11:EC20.03</skos:broadMatch>
        <skos:exactMatch>ICD-10:Q80.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0020702</skos:exactMatch>
        <skos:exactMatch>MONDO:20702</skos:exactMatch>

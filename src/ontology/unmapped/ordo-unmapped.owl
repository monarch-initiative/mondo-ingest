        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98642"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis, resulting from partial or total deletion of the short arm of chromosome 5, classically characterized by a high-pitched, monotone, cat-like cry (cri du chat) present since birth, associated with varying degrees of intellectual disability, developmental delay, microcephaly, and facial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cri du chat syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Deletion 5p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Monosomy 5p syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Monosomy 5p syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.4</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.51</skos:broadMatch>
        <skos:exactMatch>MONDO:0007404</skos:exactMatch>
        <skos:exactMatch>MeSH:D003410</skos:exactMatch>
        <skos:exactMatch>MedDRA:10011385</skos:exactMatch>
        <skos:exactMatch>OMIM:123450</skos:exactMatch>
        <skos:exactMatch>UMLS:C0010314</skos:exactMatch>
    </owl:Class>

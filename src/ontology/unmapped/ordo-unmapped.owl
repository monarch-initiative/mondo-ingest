                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6715"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare connective tissue disorder characterized by acromelic short stature, joint stiffness, stiff and thick skin, and characteristic eye abnormalities including microspherophakia, ectopia lentis, severe myopia, and glaucoma.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Weill-Marchesani syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Weill-Marchesani syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>

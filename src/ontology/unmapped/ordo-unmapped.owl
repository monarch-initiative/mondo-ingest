        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Localized scleroderma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_90290 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90290">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_C045"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Calcinosis-Raynaud phenomenon-esophageal involvement-sclerodactyly-telangiectasia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>CREST syndrome</rdfs:label>
        <owl:deprecated>true</owl:deprecated>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:exactMatch>ICD-10:M34.1</skos:exactMatch>

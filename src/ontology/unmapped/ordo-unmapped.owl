    <!-- http://www.orpha.net/ORDO/Orphanet_411777 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_411777">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <obo:IAO_0000115 xml:lang="en">Generalized eruptive keratoacanthoma (GEKA) is rare variant of keratoacanthoma (KA) that affects the skin and mucous membranes and which is characterized by a sudden generalized eruption of severely pruritic, hundreds to thousands of small follicular papules, often with a central keratotic plug.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GEKA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized eruptive keratoacanthoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Generalized eruptive keratoacanthomas of Grzybowski</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Grzybowski syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Generalized eruptive keratoacanthoma</rdfs:label>
        <skos:broadMatch>ICD-10:L85.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C31.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0018471</skos:exactMatch>

    <!-- http://www.orpha.net/ORDO/Orphanet_210584 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_210584">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_673470"/>
        <obo:IAO_0000115 xml:lang="en">Spindle cell hemangioma (SCH), also known as spindle cell hemangioendothelioma, is a rare benign vascular tumor either solitary or multiple, characterized by cavernous blood vessels separated by spindle cells reminiscent of those in Kaposis sarcoma and located in the dermis and subcutis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Spindle cell haemangioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spindle cell hemangioendothelioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spindle cell hemangioma</oboInOwl:hasExactSynonym>
        <rdfs:label>Spindle cell hemangioma</rdfs:label>
        <skos:broadMatch>ICD-10:D18.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F2Y</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH6RP8</skos:exactMatch>
        <skos:exactMatch>MONDO:0016222</skos:exactMatch>
        <skos:exactMatch>UMLS:C1304508</skos:exactMatch>
    </owl:Class>

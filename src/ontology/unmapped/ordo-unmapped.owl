    <!-- http://www.orpha.net/ORDO/Orphanet_216866 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_216866">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_157850"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/15894"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, childhood-onset neurodegenerative disorder characterized by progressive dystonia, dysarthria, retinal degeneration and abnormal iron accumulation in the globus pallidus and substantia nigra with a characteristic eye-of-the-tiger sign on T2-weighted MRI. Classic PKAN has early onset and rapid progression and accounts for about 75% of cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Classic pantothenate kinase-associated neurodegeneration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">NBIA1, classic form</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Neurodegeneration with brain iron accumulation type 1, classic form</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PKAN, classic form</oboInOwl:hasExactSynonym>
        <rdfs:label>Classic pantothenate kinase-associated neurodegeneration</rdfs:label>
        <skos:broadMatch>ICD-10:G23.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.10</skos:broadMatch>
        <skos:broadMatch>OMIM:234200</skos:broadMatch>
        <skos:exactMatch>MONDO:0016304</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679812</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_216866"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

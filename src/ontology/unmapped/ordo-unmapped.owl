    <!-- http://www.orpha.net/ORDO/Orphanet_3314 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3314">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

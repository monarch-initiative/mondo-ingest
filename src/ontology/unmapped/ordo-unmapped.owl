        <obo:IAO_0000115 xml:lang="en">3q29 microduplications are recently described chromosomal abnormalities with unclear clinical significance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>3q29 microduplication syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 3q29</oboInOwl:hasExactSynonym>
        <rdfs:label>3q29 microduplication syndrome</rdfs:label>

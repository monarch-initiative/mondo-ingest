        <oboInOwl:hasExactSynonym xml:lang="en">HITT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Heparin-induced-immune thrombocytopenia</oboInOwl:hasExactSynonym>

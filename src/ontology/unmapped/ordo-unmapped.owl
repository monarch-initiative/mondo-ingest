    <!-- http://www.orpha.net/ORDO/Orphanet_29 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_29">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_309025"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98644"/>

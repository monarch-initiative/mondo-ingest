    <!-- http://www.orpha.net/ORDO/Orphanet_2479 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2479">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_519288"/>

        <skos:exactMatch>MeSH:D016918</skos:exactMatch>
        <skos:exactMatch>MedDRA:10003267</skos:exactMatch>
        <skos:exactMatch>UMLS:C0085435</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_624 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_624">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183478"/>

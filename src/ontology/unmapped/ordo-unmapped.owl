    <!-- http://www.orpha.net/ORDO/Orphanet_2445 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2445">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98717"/>
        <obo:IAO_0000115 xml:lang="en">A group of congenital cardiac outflow tract anomalies that include such defects as tetralogy of Fallot, pulmonary atresia with ventricular septal defect, double-outlet right ventricle (DORV), double-outlet left ventricle, truncus arteriosus and transposition of the great arteries (TGA), among others. This group of defects is frequently found in patients with 22q11.2 deletion syndrome . A deletion of chromosome 22q11.2 has equally been associated in a subset of patients with various types of isolated non-syndromic conotruncal heart malformations (with the exception of DORV and TGA where this is very uncommon).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Conotruncal heart malformations</oboInOwl:hasExactSynonym>
        <rdfs:label>Conotruncal heart malformations</rdfs:label>
        <skos:exactMatch>MONDO:0016581</skos:exactMatch>
        <skos:exactMatch>MONDO:16581</skos:exactMatch>
        <skos:exactMatch>MeSH:C535464</skos:exactMatch>
        <skos:exactMatch>OMIM:217095</skos:exactMatch>
        <skos:exactMatch>UMLS:C1857586</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2445"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Conotruncal heart malformations</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

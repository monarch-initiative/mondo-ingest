            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Shwachman-Diamond syndrome (SDS) is a rare multisystemic syndrome characterized by chronic and usually mild neutropenia, pancreatic exocrine insufficiency associated with steatorrhea and growth failure, skeletal dysplasia with short stature, and an increased risk of bone marrow aplasia or leukemic transformation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Pancreatic insufficiency and bone marrow dysfunction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Shwachman syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Shwachman-Bodian-Diamond syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Shwachman-Diamond syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Shwachman-Diamond syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D61.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A70.0</skos:broadMatch>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder of fatty acid oxidation characterized by a wide clinical spectrum ranging from severe neonatal manifestations including cardiomyopathy, hypoglycemia, metabolic acidosis, skeletal myopathy and neuropathy, liver disease and death to a mild phenotype with peripheral polyneuropathy, episodic rhabdomyolysis and pigmentary retinopathy..</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mitochondrial trifunctional protein deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TFP deficiency</oboInOwl:hasExactSynonym>

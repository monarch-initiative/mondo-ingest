    <!-- http://www.orpha.net/ORDO/Orphanet_411788 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_411788">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183450"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

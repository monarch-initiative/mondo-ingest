        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <oboInOwl:hasExactSynonym>ATP13A2-related parkinsonism</oboInOwl:hasExactSynonym>
        <rdfs:label>ATP13A2-related parkinsonism</rdfs:label>
        <skos:exactMatch>UMLS:C5681397</skos:exactMatch>

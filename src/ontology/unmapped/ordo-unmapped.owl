    <!-- http://www.orpha.net/ORDO/Orphanet_1520 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1520">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

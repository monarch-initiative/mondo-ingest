            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare form of serine deficiency syndrome characterized clinically by acquired microcephaly, psychomotor retardation, intractable seizures and hypertonia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PSAT deficiency, infantile/juvenile form</oboInOwl:hasExactSynonym>

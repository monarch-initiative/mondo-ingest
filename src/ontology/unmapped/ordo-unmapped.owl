    <!-- http://www.orpha.net/ORDO/Orphanet_935 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_935">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_317419"/>

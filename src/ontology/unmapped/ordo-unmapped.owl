    <!-- http://www.orpha.net/ORDO/Orphanet_131 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_131">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101938"/>

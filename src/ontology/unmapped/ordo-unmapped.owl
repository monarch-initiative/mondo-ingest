    <!-- http://www.orpha.net/ORDO/Orphanet_2301 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2301">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108967"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_365563"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/24039"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3754"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital short bowel syndrome is a rare intestinal disorder of neonates of unknown etiology. Patients are born with a short small bowel (less than 75 cm in length) that compromises proper intestinal absorption and leads chronic diarrhea, vomiting and failure to thrive.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital short bowel syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital short bowel syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q43.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:LB15.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0014097</skos:exactMatch>
        <skos:exactMatch>OMIM:615237</skos:exactMatch>

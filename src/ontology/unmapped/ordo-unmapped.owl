            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Familial pancreatic carcinoma is defined by the presence of pancreatic cancer (PC) in two or more first-degree relatives.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial pancreatic cancer</oboInOwl:hasExactSynonym>

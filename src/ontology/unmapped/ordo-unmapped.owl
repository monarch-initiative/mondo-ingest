        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_90077"/>
        <obo:IAO_0000115 xml:lang="en">Interstitial granulomatous dermatitis with arthritis is a rare rheumatologic disease characterized by the occurrence of inflammatory arthritis in association with large, erythematous, symmetrical cutaneous lesions (ranging from typical, but infrequent, cord-like lesions on the flanks to more common violaceous plaques on the trunk and limbs) featuring a typical histologic infiltrate mainly constituted of histiocytes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Ackerman dermatitis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ackerman syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">IGDA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Interstitial granulomatous dermatitis with arthritis</oboInOwl:hasExactSynonym>
        <rdfs:label>Interstitial granulomatous dermatitis with arthritis</rdfs:label>
        <skos:broadMatch>ICD-10:L30.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019199</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751206</skos:exactMatch>
    </owl:Class>

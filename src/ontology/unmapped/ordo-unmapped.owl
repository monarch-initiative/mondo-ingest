        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare congenital limb formation characterized by partial or complete absence of the tibia with a relatively intact fibula.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Isolated congenital absence of tibia</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_96092 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96092">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_263708"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare chromosomal anomaly clinically characterized by mild to severe intellectual disability, severe developmental delay (psychomotor and speech development), hypotonia with tendency to later develop progressive hypertonia, and characteristic facial features. The main congenital anomalies associated include central nervous system (CNS) malformations such as hypoplasia/agenesis of the corpus callosum (80%), skeletal abnormalities such as scoliosis/kyphosis or dislocated hips (60%), and congenital heart defects (25%).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>8p inverted duplication/deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Invdupdel(8p)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Inverted 8p duplication/deletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>invdupdel(8p)</oboInOwl:hasExactSynonym>
        <rdfs:label>8p inverted duplication/deletion syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q99.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD41.P</skos:broadMatch>
        <skos:exactMatch>MONDO:0019876</skos:exactMatch>
        <skos:exactMatch>UMLS:C4273676</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96092"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>8p inverted duplication/deletion syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    <owl:Axiom>

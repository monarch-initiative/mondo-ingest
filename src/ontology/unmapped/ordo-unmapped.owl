            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Stapes ankylosis with broad thumbs and toes is a very rare genetic bone disorder characterized by ankylosis of stapes, broad thumbs and halluces, conductive hearing loss and hyperopia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Stapes ankylosis with broad thumbs and toes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Teunissen-Cremers syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Stapes ankylosis with broad thumbs and toes</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008484</skos:exactMatch>
        <skos:exactMatch>OMIM:184460</skos:exactMatch>
        <skos:exactMatch>UMLS:C1866656</skos:exactMatch>
    </owl:Class>

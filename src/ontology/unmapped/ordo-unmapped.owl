    <!-- http://www.orpha.net/ORDO/Orphanet_182 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_182">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_163591"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Chromomycosis is a chronic cutaneous and subcutaneous fungal infection, found mainly in subtropical and tropical areas (in soil and plant debris and transmitted by traumatic inoculation), and characterized clinically by slow growing, verrucous nodules, squamous plaques, or chronic limited lesions which are most commonly found on the lower limbs and which are characterized histologically by the presence of muriform cells. It is caused by dematiaceous fungi, with the main etiological agents being &lt;i&gt;Fonsecaea pedrosoi&lt;/i&gt;, &lt;i&gt;Phialophora verrucosa&lt;/i&gt; and &lt;i&gt;Cladophialophora carrionii&lt;/i&gt;. Rarely, it can be caused by &lt;i&gt;Rhinocladiella aquaspersa&lt;/i&gt;.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Chromoblastomycosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chromomycosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Chromomycosis</rdfs:label>
        <skos:exactMatch>ICD-11:1F24</skos:exactMatch>
        <skos:exactMatch>MONDO:0015908</skos:exactMatch>
        <skos:exactMatch>MeSH:D002862</skos:exactMatch>
        <skos:exactMatch>MedDRA:10008803</skos:exactMatch>
        <skos:exactMatch>UMLS:C0008582</skos:exactMatch>
        <skos:narrowMatch>ICD-10:B43.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B43.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B43.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B43.8</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:B43.9</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_182"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

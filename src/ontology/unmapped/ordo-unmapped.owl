        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_94145"/>
        <obo:IAO_0000115 xml:lang="en">Spinocerebellar ataxia type 3 (SCA3), also known as Machado-Joseph disease, is the most common subtype of type 1 autosomal dominant cerebellar ataxia (ADCA type 1), a neurodegenerative disorder, and is characterized by ataxia, external progressive ophthalmoplegia, and other neurological manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Azorean disease of the nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MJD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Machado disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Machado-Joseph disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nigro-spino-dentatal degeneration with nuclear ophthalmoplegia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SCA3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spinocerebellar ataxia type 3</oboInOwl:hasExactSynonym>
        <rdfs:label>Spinocerebellar ataxia type 3</rdfs:label>
        <skos:broadMatch>ICD-10:G11.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8A03.16</skos:broadMatch>
        <skos:exactMatch>MONDO:0007182</skos:exactMatch>
        <skos:exactMatch>MeSH:D017827</skos:exactMatch>
        <skos:exactMatch>OMIM:109150</skos:exactMatch>
        <skos:exactMatch>UMLS:C0024408</skos:exactMatch>
    </owl:Class>

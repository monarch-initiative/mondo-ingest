    <!-- http://www.orpha.net/ORDO/Orphanet_85280 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_85280">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

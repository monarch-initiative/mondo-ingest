                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12783"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">SERKAL (SEx Reversion, Kidneys, Adrenal and Lung dysgenesis) syndrome is characterised by female to male sex reversal and developmental anomalies of the kidneys, adrenal glands and lungs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>SERKAL syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sex reversion-kidneys, adrenal and lung dysgenesis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>SERKAL syndrome</rdfs:label>

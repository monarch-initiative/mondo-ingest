        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79379"/>
        <obo:IAO_0000115 xml:lang="en">A benign congenital skin disease characterised by progressive dilation of the subepidermal skin vessels manifesting as purple punctate lesions usually appearing on the lower limbs and buttocks and following the lines of Blaschko.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Angioma serpiginosum</oboInOwl:hasExactSynonym>
        <rdfs:label>Angioma serpiginosum</rdfs:label>
        <skos:broadMatch>ICD-10:L81.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LC50.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019803</skos:exactMatch>
        <skos:exactMatch>MedDRA:10086217</skos:exactMatch>

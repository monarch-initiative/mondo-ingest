            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Gelatinous drop-like corneal dystrophy (GDCD) is a form of superficial corneal dystrophy characterized by multiple prominent milky-white gelatinous nodules beneath the corneal epithelium, and marked visual impairment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GDCD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gelatinous drop-like corneal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary familial amyloidosis of the cornea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Subepithelial amyloidosis of the cornea</oboInOwl:hasExactSynonym>
        <rdfs:label>Gelatinous drop-like corneal dystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:H18.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:9A70.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008777</skos:exactMatch>

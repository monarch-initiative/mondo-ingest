        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, adult-onset, progressive myopathy characterized by progressive eyelid ptosis, ophthalmoplegia, dysphagia, dysarthria and proximal limb weakness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">OPMD</oboInOwl:hasExactSynonym>

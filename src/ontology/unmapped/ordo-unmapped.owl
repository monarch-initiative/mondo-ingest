    <!-- http://www.orpha.net/ORDO/Orphanet_444002 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_444002">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_251604 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251604">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_251595"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <oboInOwl:hasExactSynonym>Gemistocytic astrocytoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Gemistocytic astrocytoma</rdfs:label>

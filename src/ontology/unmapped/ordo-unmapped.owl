                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare inherited cancer syndrome, characterized by the development of multiple neuroendocrine tumors of the parathyroids, gastro-entero-pancreatic tract, and anterior pituitary gland, and less commonly the adrenal cortical gland, thymus and bronchi, with other non-endocrine tumors in some patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MEN1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple endocrine neoplasia type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wermer syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Multiple endocrine neoplasia type 1</rdfs:label>
        <skos:broadMatch>ICD-10:D44.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F7A.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0007540</skos:exactMatch>
        <skos:exactMatch>MeSH:D018761</skos:exactMatch>
        <skos:exactMatch>MedDRA:10073150</skos:exactMatch>
        <skos:exactMatch>OMIM:131100</skos:exactMatch>
        <skos:exactMatch>UMLS:C0025267</skos:exactMatch>
    </owl:Class>

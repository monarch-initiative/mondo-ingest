    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_70591 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_70591">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_71198"/>
        <obo:IAO_0000115 xml:lang="en">A rare complication of acute pulmonary embolism (PE), either symptomatic or not, that is characterized by fibrotic intravascular material occlusion of pulmonary arteries in combination with a secondary microvasculopathy of vessels less than 500 &amp;#181;m. The consequence is an increase in pulmonary vascular resistance (PVR) and progressive right heart failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CTEPH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic thromboembolic pulmonary hypertension</oboInOwl:hasExactSynonym>
        <rdfs:label>Chronic thromboembolic pulmonary hypertension</rdfs:label>
        <skos:broadMatch>ICD-10:I27.2</skos:broadMatch>
        <skos:exactMatch>ICD-11:BB01.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0013024</skos:exactMatch>
        <skos:exactMatch>MedDRA:10068739</skos:exactMatch>
        <skos:exactMatch>OMIM:612862</skos:exactMatch>
        <skos:exactMatch>UMLS:C2363973</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

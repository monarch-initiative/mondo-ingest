    <!-- http://www.orpha.net/ORDO/Orphanet_1046 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1046">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165707"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182043"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by lethal non-spherocytic, non-immune hemolytic anemia, in association with abnormalities of the external genitalia (such as micropenis and hypospadias). Reported dysmorphic features include flat occiput, dimpled earlobes, deep plantar creases, and increased space between the first and second toes. There have been no further descriptions in the literature since 1995.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Lethal hemolytic anemia-genital anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Water-West syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Lethal hemolytic anemia-genital anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D58.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010891</skos:exactMatch>
        <skos:exactMatch>OMIM:600461</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304746</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1046"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lethal hemolytic anemia-genital anomalies syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_1047 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1047">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108997"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">Sideroblastic anemias (SA) are a group of rare heterogeneous inherited or acquired bone marrow disorders, isolated or part of a syndrome, characterized by decreased hemoglobin synthesis, because of defective use of iron (although plasmatic iron levels may be normal or elevated) and the presence of ringed sideroblasts in the bone marrow due to the pathologic iron overload in mitochondria as visualized by Perls&apos; staining. The group encompasses (idiopathic) acquired sideroblastic anemia and constitutional sideroblastic anemias. The latter include syndromic sideroblastic anemias such as Pearson syndrome, mitochondrial mypathy and sideroblastic anemias, x-linked sideroblastic anemia-ataxia, thiamine responsive megaloblastic anemia syndrome and nonsyndromic sideroblastic anemias comprising x-linked and autosomal recessive sideroblastic anemias.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Sideroblastic anemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Sideroblastic anemia</rdfs:label>
        <skos:exactMatch>MONDO:0015194</skos:exactMatch>
        <skos:exactMatch>MONDO:15194</skos:exactMatch>
        <skos:exactMatch>MeSH:D000756</skos:exactMatch>
        <skos:exactMatch>MedDRA:10040661</skos:exactMatch>
        <skos:exactMatch>UMLS:C0002896</skos:exactMatch>
        <skos:narrowMatch>OMIM:182170</skos:narrowMatch>
        <skos:narrowMatch>OMIM:205950</skos:narrowMatch>
        <skos:narrowMatch>OMIM:300751</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619523</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1047"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Sideroblastic anemia</owl:annotatedTarget>

    <!-- http://www.orpha.net/ORDO/Orphanet_231500 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231500">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_264719"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79430"/>

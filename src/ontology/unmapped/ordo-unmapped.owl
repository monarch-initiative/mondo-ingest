            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare histidine metabolism disorder characterized by urocanic aciduria and other variable manifestations including intellectual deficit and intermittent ataxia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Encephalopathy due to urocanase deficiency</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_46486 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_46486">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79669"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98567"/>
        <obo:IAO_0000115 xml:lang="en">A rare autoimmune bullous skin disease characterized clinically by blistering of the mucous membranes followed by scarring, and immunologically characterized by IgG, IgA and/or C3 deposits on the epidermal basement membrane. The disease principally involves the oral mucosa, but may also affect ocular, pharyngolaryngeal, genital, and esophageal mucous membranes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Cicatricial pemphigoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucosal pemphigoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucosynechial pemphigoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mucous membrane pemphigoid</oboInOwl:hasExactSynonym>
        <rdfs:label>Mucous membrane pemphigoid</rdfs:label>
        <skos:broadMatch>ICD-10:L12.1</skos:broadMatch>
        <skos:broadMatch>OMIM:164185</skos:broadMatch>
        <skos:exactMatch>ICD-11:EB41.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0018746</skos:exactMatch>
        <skos:exactMatch>MedDRA:10057052</skos:exactMatch>
        <skos:exactMatch>UMLS:C0030804</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_46486"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

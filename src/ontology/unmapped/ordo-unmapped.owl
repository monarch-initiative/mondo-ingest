        <owl:annotatedTarget>Brachydactyly type B1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_572428 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_572428">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100049"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_290839"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8086"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic respiratory disease characterized by infantile onset of pulmonary alveolar proteinosis with hypogammaglobulinemia. Patients have normal respiratory function at birth, but subsequently develop recurrent, mainly viral, infections and progressive respiratory failure, often leading to death in infancy or early childhood. Additional reported features include leukocytosis and splenomegaly.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Infantile-onset pulmonary alveolar proteinosis-hypogammaglobulinemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OAS1 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OAS1-related infantile-onset pulmonary alveolar proteinosis-hypogammaglobulinemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile-onset pulmonary alveolar proteinosis-hypogammaglobulinemia</rdfs:label>
        <skos:broadMatch>ICD-10:J84.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:CB04.31</skos:broadMatch>
        <skos:exactMatch>MONDO:0035529</skos:exactMatch>
        <skos:exactMatch>OMIM:618042</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680364</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_572428"/>

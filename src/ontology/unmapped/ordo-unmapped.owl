        <oboInOwl:hasExactSynonym>Genetic nephrotic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary nephrotic syndrome</oboInOwl:hasExactSynonym>

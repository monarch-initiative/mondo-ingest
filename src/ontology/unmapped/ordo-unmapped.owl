    <!-- http://www.orpha.net/ORDO/Orphanet_2994 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2994">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_330206"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis mainly characterized by severe intellectual disability, short stature, hypogonadism, and distinct facial dysmorphism (including trigonocephaly, prominent forehead, asymmetric and flat face, hypertelorism, epicanthus, downslanting palpebral fissures, ptosis, low-set angulated ears, small mouth, high-arched/cleft palate crowded teeth, microretrognathia), as well as slender hands and/or feet. Variable additional features may include pterygia, hypoplastic nipples, cardiac anomaly, distal muscular wasting, limb contractures, skeletal anomalies (e.g. scoliosis, pectus excavatum, bilateral clubfeet), hypothyroidism, seizures, and cerebral anomalies. Puberty may be delayed.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Haspeslagh-Fryns-Muelenaere syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short stature-craniofacial anomalies-genital hypoplasia syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Short stature-craniofacial anomalies-genital hypoplasia syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008335</skos:exactMatch>
        <skos:exactMatch>MeSH:C535844</skos:exactMatch>
        <skos:exactMatch>OMIM:177980</skos:exactMatch>
        <skos:exactMatch>UMLS:C1867443</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2994"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Short stature-craniofacial anomalies-genital hypoplasia syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2995 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2995">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102010"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98578"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/132"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/144"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by facial dysmorphism (hypertelorism with ptosis, broad bulbous nose, ridged metopic suture, arched eyebrows, progressive coarsening of the face), ocular coloboma, pachygyria and/or band heterotopias with antero-posterior gradient, progressive joint stiffening, and intellectual deficit of variable severity, often with severe epilepsy. Fryns-Aftimos syndrome (FA; pachygyria, epilepsy, intellectual disability, dysmorphism) corresponds to the appearance of Baraitser-Winter cerebrofrontofacial syndrome (BWS) in elder patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Baraitser-Winter cerebrofrontofacial syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Baraitser-Winter cerebrofrontofacial syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0017579</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680770</skos:exactMatch>
        <skos:narrowMatch>OMIM:243310</skos:narrowMatch>
        <skos:narrowMatch>OMIM:614583</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2995"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Baraitser-Winter cerebrofrontofacial syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

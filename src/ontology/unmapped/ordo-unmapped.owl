    <!-- http://www.orpha.net/ORDO/Orphanet_231625 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_231625">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_231637"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A very rare surgically-correctable form of primary aldosteronism (PA) due to an aldosterone-secreting adrenal malignancy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Adrenocortical carcinoma with pure aldosterone hypersecretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pure APAC</oboInOwl:hasExactSynonym>

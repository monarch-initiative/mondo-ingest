        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Otodental syndrome is a very rare inherited condition characterized by grossly enlarged canine and molar teeth (globodontia) associated with sensorineural hearing loss.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Globodontia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Otodental dysplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Otodental syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Otodental syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:K00.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA30.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0008161</skos:exactMatch>
        <skos:exactMatch>MeSH:C563482</skos:exactMatch>
        <skos:exactMatch>OMIM:166750</skos:exactMatch>
        <skos:exactMatch>UMLS:C1833693</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2791"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Otodental syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_2792 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2792">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139036"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183576"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Otofaciocervical syndrome is a rare, genetic developmental defect during embryogenesis syndrome characterized by distinct facial features (long triangular face, broad forehead, narrow nose and mandible, high arched palate), prominent, dysmorphic ears (low-set and cup-shaped with large conchae and hypoplastic tragus, antitragus and lobe), long neck, preauricular and/or branchial fistulas and/or cysts, hypoplastic cervical muscles with sloping shoulders and clavicles, winged, low, and laterally-set scapulae, hearing impairment and mild intellectual deficit. Vertebral defects and short stature may also be associated.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Fara-Chlupackova syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OFC syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Otofaciocervical syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Otofaciocervical syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008163</skos:exactMatch>
        <skos:exactMatch>MeSH:C563481</skos:exactMatch>
        <skos:exactMatch>UMLS:C1833691</skos:exactMatch>
        <skos:narrowMatch>OMIM:166780</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615560</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2792"/>

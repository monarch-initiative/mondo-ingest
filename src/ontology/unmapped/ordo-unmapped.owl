    <!-- http://www.orpha.net/ORDO/Orphanet_829 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_829">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182231"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

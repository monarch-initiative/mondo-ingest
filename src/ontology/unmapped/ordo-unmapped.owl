    <!-- http://www.orpha.net/ORDO/Orphanet_447954 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_447954">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_35696"/>

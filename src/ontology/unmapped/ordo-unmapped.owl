        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia characterized by isolated upper limb mesomelic dysplasia. Patients present with ulnar hypoplasia with severe radial bowing, but normal stature.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Fryns-Hofkens-Fabry syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Upper limb mesomelic dysplasia, type Fryns</oboInOwl:hasExactSynonym>

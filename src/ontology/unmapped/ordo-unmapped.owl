    <!-- http://www.orpha.net/ORDO/Orphanet_522077 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_522077">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_494457"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_496916"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_522520"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98683"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11509"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurological disorder characterized by infantile hypotonia, congenital ophthalmic anomalies (including strabismus, esotropia, nystagmus, and central visual impairment), global developmental delay and intellectual disability, behavioral abnormalities, and movement disorder (such as dystonia, chorea, hyperkinesia, stereotypies). Mild facial dysmorphism and skeletal deformities have also been reported. EEG testing shows marked abnormalities in the absence of overt epileptic seizures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BAGOS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Baker-Gordon syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Infantile hypotonia-oculomotor anomalies-hyperkinetic movements-developmental delay syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SYT1-related neurodevelopmental disorder</oboInOwl:hasExactSynonym>
        <rdfs:label>Infantile hypotonia-oculomotor anomalies-hyperkinetic movements-developmental delay syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:F84.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0033864</skos:exactMatch>
        <skos:exactMatch>OMIM:618218</skos:exactMatch>
        <skos:exactMatch>UMLS:C4748715</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_522077"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Infantile hypotonia-oculomotor anomalies-hyperkinetic movements-developmental delay syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



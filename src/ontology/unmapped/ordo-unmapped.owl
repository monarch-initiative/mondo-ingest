        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare X-linked syndromic intellectual disability characterized by intellectual impairment of variable severity, progressive lower limb spasticity, and diffuse palmoplantar hyperkeratosis. Additional manifestations include pes cavus, extensor plantar responses, hand tremor, and mild dysmorphic facial features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Fitzsimmons-McLachlan-Gilbert syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Paraplegia-intellectual disability-hyperkeratosis syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Paraplegia-intellectual disability-hyperkeratosis syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G82.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0010662</skos:exactMatch>
        <skos:exactMatch>MeSH:C537058</skos:exactMatch>
        <skos:exactMatch>OMIM:309560</skos:exactMatch>
        <skos:exactMatch>UMLS:C2745996</skos:exactMatch>
    </owl:Class>

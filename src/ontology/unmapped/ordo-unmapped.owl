        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98578"/>
        <obo:IAO_0000115 xml:lang="en">A rare ophthalmic disorder characterized by congenital ptosis associated with pterygoid-levator synkinesis (also called jaw-winking).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Jaw-winking syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mandibulo-palpebral synkinesis-ptosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Marcus-Gunn phenomenon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Marcus-Gunn syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Marcus-Gunn syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q07.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:9A03.00</skos:exactMatch>

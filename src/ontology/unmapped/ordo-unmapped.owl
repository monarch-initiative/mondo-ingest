        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Thiamine-responsive megaloblastic anemia (TRMA) is characterized by a triad of megaloblastic anemia, non-type I diabetes mellitus, and sensorineural deafness.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Rogers syndrome</oboInOwl:hasExactSynonym>

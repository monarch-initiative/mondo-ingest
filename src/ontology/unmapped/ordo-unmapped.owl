        <obo:IAO_0000115 xml:lang="en">A rare aggressive skin cancer characterized by a rapidly growing nodule with both epithelial and neuroendocrine features, driven in 80% of cases by the oncogenic Merkel cell polyomavirus (MCPyV).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cutaneous neuroendocrine carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MCC</oboInOwl:hasExactSynonym>

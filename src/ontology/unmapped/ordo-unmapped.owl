    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693826 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693826">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108971"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <obo:IAO_0000115 xml:lang="en">A rare visceral arteriovenous malformation of the pancreas characterized by abnormal blood flow from the arterial system directly into the venous system without passing through the capillaries. Patients may present with episodic gastrointestinal bleeding or hemoperitoneum, epigastric or abdominal pain, pancreatitis, portal hypertension, and pseudocysts. Some patients remain asymptomatic.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arteriovenous malformation of the pancreas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pancreatic arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Pancreatic arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA90.3Y</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693826"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pancreatic arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693832 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693832">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_117569"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_165711"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Angiodysplasia of the GI tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GI arteriovenous malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gastrointestinal tract arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Gastrointestinal tract arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA90.3Y</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Gastrointestinal tract arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693839 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693839">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506213"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93618"/>
        <obo:IAO_0000115 xml:lang="en">A rare visceral arteriovenous malformation characterized by abnormal communications between renal arteries and the venous system. Most cases are asymptomatic but patients may present with clinical symptoms including hematuria, nausea, lumbar and abdominal pain, hypertension, cardiomegaly and high output heart failure. This type of malformation is more commonly reported in females.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arteriovenous malformation of the kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Renal arteriovenous malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">rAVM</oboInOwl:hasExactSynonym>
        <rdfs:label>Renal arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA90.3Y</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693839"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Renal arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693846 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693846">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101938"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506210"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <obo:IAO_0000115 xml:lang="en">A rare visceral arteriovenous malformation characterized by direct arterial-to-venous connections within the liver. Patients may be asymptomatic or present with symptoms such as anemia, consumptive coagulopathy, portal hypertension, hepatomegaly and may develop complications including congestive heart failure, necrosis of the liver or hydrops fetalis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arteriovenous malformation of the liver</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital hepatic arteriovenous malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HAVM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hepatic arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Hepatic arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA90.3Y</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693846"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Hepatic arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693855 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693855">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_715762"/>
        <obo:IAO_0000115 xml:lang="en">A group of rare fast-flow arteriovenous malformation characterized by abnormal communication between the arterial and the venous systems of the internal organs. They are more commonly observed in patients with multifocal vascular malformations. Clinical manifestations depend on the organ involved; however, they usually include abdominal pain, hemorrhage, chronic anemia, fatigue, gastrointestinal bleeding, hemoptysis and hypoxia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arteriovenous malformation of internal organs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Visceral arteriovenous malformation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Visceral fast-flow vascular malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Visceral fast-flow vascular malformation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Visceral fast-flow vascular malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693863 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693863">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108971"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <obo:IAO_0000115 xml:lang="en">A rare visceral arteriovenous malformation characterized by abnormal communication between splenic artery and the splenic vein at the level of the splenic hilum. These malformations may lead to the formation of splenic artery aneurysms that can rupture. Clinical features include abdominal pain, hematemesis, melena, diarrhea, and portal hypertension due to venous congestion. The spleen is typically enlarged with extensive areas of infarction and dilated vessels.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arteriovenous malformation of the spleen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Splenic arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Splenic arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA90.3Y</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693863"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Splenic arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693869 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693869">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108971"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <obo:IAO_0000115 xml:lang="en">A rare visceral arteriovenous malformation characterized by dilated and tortuous feeding arteries and veins of the gallblader. Patients present with abdominal pain. Association with hepatocellular carcinoma in some patients have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arteriovenous malformation of gallbladder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gallblader arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Gallblader arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA90.3Y</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Gallblader arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693872 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693872">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_101433"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_693855"/>
        <obo:IAO_0000115 xml:lang="en">A rare visceral arteriovenous malformation characterized by abnormal communication between veins and arteries of the ureter, urethra, or urinary bladder. Major clinical signs include hematuria and suprapubic pain. Additional clinical features may include acute urinary retention and increased urinary frequency.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Arteriovenous malformation of the urinary tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Urinary tract arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>Urinary tract arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA90.3Y</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693872"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Urinary tract arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693907 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693907">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_137667"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9871"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare capillary malformation-arteriovenous malformation characterized by single or multiple cutaneous lesions ranging from round to oval shape with pinkish to purplish-red or reddish-brown macules, randomly distributed over the body. Perilesional pale halo are usually detected on the skin. These lesions may occur with or without arteriovenous malformations/arteriovenous fistulas involving muscle, bone, spine and brain. Parkes Weber syndrome with segmental distribution may also be present. Most patients are asymptomatic except for the capillary malformations, the family history is often positive for capillary malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CM-AVM1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>RASA1-related capillary malformation-arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>RASA1-related capillary malformation-arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LC50.Y</skos:broadMatch>
        <skos:exactMatch>OMIM:608354</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693907"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>RASA1-related capillary malformation-arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_693912 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_693912">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_137667"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3395"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare capillary malformation-arteriovenous malformation characterized by multifocal pink-to-red cutaneous capillary malformations, mainly localized on the extremities, trunk, head and neck. Bier spots, epistaxis, and telangiectasias on the lips, perioral region and on the upper thorax are frequently observed. Arteriovenous malformations and fistulas involving muscle, bone, the spine and the brain may also be present. Most patients are asymptomatic except for the capillary malformations, the family history is often positive for capillary malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CM-AVM2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>EPHB4-related capillary malformation-arteriovenous malformation</oboInOwl:hasExactSynonym>
        <rdfs:label>EPHB4-related capillary malformation-arteriovenous malformation</rdfs:label>
        <skos:broadMatch>ICD-10:Q27.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LC50.Y</skos:broadMatch>
        <skos:exactMatch>OMIM:618196</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_693912"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>EPHB4-related capillary malformation-arteriovenous malformation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



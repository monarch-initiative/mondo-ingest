    <!-- http://www.orpha.net/ORDO/Orphanet_3376 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3376">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_459787"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_471383"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_96321"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98642"/>
        <obo:IAO_0000115 xml:lang="en">Triploidy is a rare chromosomal anomaly, polyploidy, characterized by early in utero growth restriction, and multiple birth defects, including neural tube defects, facial abnormalities, cleft lip/palate, congenital heart anomalies, genital malformations, and peripheral skeletal abnormalities. It is usually prenatally lethal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Triploidy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Triploidy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.7</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD42.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0018067</skos:exactMatch>
        <skos:exactMatch>MeSH:D057885</skos:exactMatch>
        <skos:exactMatch>UMLS:C0333693</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3376"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Triploidy syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3377 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3377">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_97120"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7578"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic, distal arthrogryposis characterized by pseudocamptodactyly, mild foot deformities, moderately short stature, and short muscles and tendons resulting in a limited range of motion of the hands, legs, and mouth, the later presenting with trismus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal arthrogryposis type 7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dutch-Kentucky syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hecht syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hecht-Beals syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Trismus-pseudocamptodactyly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Trismus-pseudocamptodactyly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q68.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD26.4Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008016</skos:exactMatch>
        <skos:exactMatch>MeSH:C535857</skos:exactMatch>
        <skos:exactMatch>OMIM:158300</skos:exactMatch>
        <skos:exactMatch>UMLS:C0265226</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3377"/>

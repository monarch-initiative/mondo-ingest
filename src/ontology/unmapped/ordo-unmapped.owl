        <oboInOwl:hasExactSynonym xml:lang="en">Partial epilepsy with auditory aura</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Partial epilepsy with auditory features</oboInOwl:hasExactSynonym>

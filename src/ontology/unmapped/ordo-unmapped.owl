            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Gray platelet syndrome (GPS) is a rare inherited bleeding disorder characterized by macrothrombocytopenia, myelofibrosis, splenomegaly and typical gray appearance of platelets on Wright stained peripheral blood smear.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Alpha storage pool deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">GPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gray platelet syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Platelet alpha-granule deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Gray platelet syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D69.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B62.00</skos:broadMatch>
        <skos:exactMatch>MONDO:0007686</skos:exactMatch>
        <skos:exactMatch>MeSH:D055652</skos:exactMatch>
        <skos:exactMatch>OMIM:139090</skos:exactMatch>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Thiel-Behnke corneal dystrophy (TBCD) is a rare form of superficial corneal dystrophy characterized by sub-epithelial honeycomb-shaped corneal opacities in the superficial cornea, and progressive visual impairment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Anterior limiting membrane dystrophy type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Anterior limiting membrane dystrophy type II</oboInOwl:hasExactSynonym>

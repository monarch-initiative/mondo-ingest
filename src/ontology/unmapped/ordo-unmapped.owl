    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_83467 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_83467">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166484"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_221114"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98750"/>
        <obo:IAO_0000115 xml:lang="en">Morvan syndrome is a rare, life-threatening, acquired neurologic disease characterized by neuromyotonia, dysautonomia and encephalopathy with severe insomnia. Signs involving central (e.g. hallucinations, confusion, amnesia, myoclonus), autonomic (e.g. variations in blood pressure, hyperhidrosis) and peripheral (e.g. painful cramps, myokymia) hyperactivity, as well as systemic manifestations (such as weight loss, pruritus, fever), are reported. Thymoma is present in some cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Limbic encephalitis-neuromyotonia-hyperhidrosis-polyneuropathy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Morvan fibrillary chorea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Morvan syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Morvan syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G60.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8E4A.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0008718</skos:exactMatch>
        <skos:exactMatch>MedDRA:10075006</skos:exactMatch>
        <skos:exactMatch>UMLS:C3854373</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_83467"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Morvan syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_83468 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_83468">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68411"/>
        <obo:IAO_0000115 xml:lang="en">A benign non-epithelial bone cavity that is asymptomatic and that is found most commonly in the second decade of life by chance. The long bones are most often affected, but cases involving the jaw bone have been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile bone cyst</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Solitary bone cyst</oboInOwl:hasExactSynonym>
        <rdfs:label>Solitary bone cyst</rdfs:label>
        <skos:exactMatch>ICD-10:M85.4</skos:exactMatch>
        <skos:exactMatch>ICD-11:FB80.5</skos:exactMatch>
        <skos:exactMatch>MONDO:0019372</skos:exactMatch>
        <skos:exactMatch>UMLS:C0005937</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_1717 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_1717">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262986"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Distal trisomy 19q is a rare chromosomal anomaly syndrome characterized by low birth weight, developmental delay, intellectual disability, short stature, craniofacial dysmorphism (incl. microcephaly, midface hypoplasia, hypertelorism, flat nasal bridge, ear anomalies, short philtrum, downturned corners of the mouth, micrognathia) and a short neck with redundant skin folds. Additional features may include hypotonia, skeletal anomalies (e.g. clino/camptodactyly), seizures and congenital cardiac, urogenital and gastrointestinal malformations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal duplication 19q syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal trisomy 19q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Telomeric duplication 19q</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trisomy 19qter</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal duplication 19q syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD41.J0</skos:broadMatch>
        <skos:exactMatch>MONDO:0015744</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707664</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_1717"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_139396 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_139396">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_43"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/61"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A progressive peroxisomal disease, characterized by endocrine dysfunction (adrenal failure and sometimes testicular insufficiency), progressive myelopathy and peripheral neuropathy, and leukodystrophy. Age of onset is highly variable, but often in the first decade.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">X-CALD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked cerebral adrenoleukodystrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked cerebral adrenoleukodystrophy</rdfs:label>
        <skos:broadMatch>ICD-10:E71.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C57.1</skos:broadMatch>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of congenital muscular dystrophy characterized by a congenital to childhood onset of progressive proximal muscle weakness, joint contractures, and potential respiratory insufficiency in adulthood.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bethlem muscular dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bethlem myopathy</oboInOwl:hasExactSynonym>

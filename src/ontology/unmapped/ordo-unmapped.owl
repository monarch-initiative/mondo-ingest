        <skos:exactMatch>ICD-10:Q25.0</skos:exactMatch>
        <skos:exactMatch>MedDRA:10034130</skos:exactMatch>
    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_707 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_707">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_659712"/>
        <obo:IAO_0000115 xml:lang="en">A rare zoonotic disease characterized by life-threatening, highly contagious and rapidly progressing infection caused by the Gram-negative bacterium &lt;i&gt;Yersinia pestis&lt;/i&gt;, affecting rodents, and transmitted to human accidentally. It manifests differently depending on the route of infection. Bubonic plague results from the bite of an infected rodent flea. Pneumonic plague, less frequent but more dangerous, may arise through inhalation of infectious droplets or spread of bubonic plague to the lungs. Septicemic plague occurs from dissemination into the bloodstream, either as a primary infection or as a complication of bubonic or pneumonic forms, leading to disseminated intravascular coagulation, necrosis, and multi-organ failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Plague</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Y. pestis infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Yersinia pestis infection</oboInOwl:hasExactSynonym>
        <rdfs:label>Plague</rdfs:label>
        <skos:exactMatch>ICD-11:1B93</skos:exactMatch>
        <skos:exactMatch>MONDO:0019095</skos:exactMatch>
        <skos:exactMatch>MeSH:D010930</skos:exactMatch>
        <skos:exactMatch>MedDRA:10035148</skos:exactMatch>
        <skos:exactMatch>UMLS:C0032064</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A20.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A20.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A20.2</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A20.3</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A20.7</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A20.8</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A20.9</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

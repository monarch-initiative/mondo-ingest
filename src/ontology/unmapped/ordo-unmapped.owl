        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79225"/>
        <obo:IAO_0000115 xml:lang="en">A rare lysosomal disorder that affects the white matter of the central and peripheral nervous systems characterized by neurodegeneration with severity depending on the age of onset (infantile, late-infantile, juvenile, adolescent and adulthood).</obo:IAO_0000115>

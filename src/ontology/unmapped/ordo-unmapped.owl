    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_314566 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_314566">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182070"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Primary progressive apraxia of speech is a rare neurodegenerative disease characterized by impaired planning or programming of the movements for speech, leading to phonetically and prosodically abnormal speech, in absence, at onset, of any other neurological features (such as aphasia, memory loss, pyramidal signs). Patients usually present articulatory distortions/groping, slow rate, distorted sound substitutions and/or trial and error articulatory movements which begin insiduously and worsen over time.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PPAOS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary progressive apraxia of speech</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary progressive apraxia of speech</rdfs:label>
        <skos:broadMatch>ICD-10:G31.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0017803</skos:exactMatch>
        <skos:exactMatch>UMLS:C5848171</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_314566"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Primary progressive apraxia of speech</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_314572 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_314572">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_477754"/>

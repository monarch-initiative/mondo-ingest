        <obo:IAO_0000115 xml:lang="en">A rare genetic multisystem disorder characterized by the variable association of retinal dystrophy, obesity, polydactyly, genitourinary and kidney anomalies, learning disability and hypogonadism, with a wide spectrum of other minor manifestations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">BBS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bardet-Biedl syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Bardet-Biedl syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A61.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0015229</skos:exactMatch>

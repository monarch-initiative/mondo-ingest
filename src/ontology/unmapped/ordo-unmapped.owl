        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98627"/>
        <obo:IAO_0000115 xml:lang="en">X-linked endothelial corneal dystrophy (XECD) is a rare subtype of posterior corneal dystrophy characterized by congenital ground glass corneal clouding or a diffuse corneal haze, and blurred vision in male patients.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-linked endothelial corneal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">XECD</oboInOwl:hasExactSynonym>

    <!-- http://www.orpha.net/ORDO/Orphanet_3305 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3305">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_96321"/>
        <obo:IAO_0000115 xml:lang="en">Tetraploidy is an extremely rare chromosomal anomaly, polyploidy, when an affected individual has four copies of each chromosome, instead of two, resulting in total of 92 chromosomes in each cell. The phenotype is severe with multiple congenital anomalies, including central nervous system, ocular, cardiac, renal, and/or genital malformations and limb defects. Most patients show severe intrauterine growth retardation, hypotonia, failure to thrive and developmental delay. It is usually associated with miscarriage.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Tetraploidy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Tetraploidy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q92.7</skos:broadMatch>
        <skos:exactMatch>ICD-11:LD42.1</skos:exactMatch>
        <skos:exactMatch>MONDO:0018026</skos:exactMatch>
        <skos:exactMatch>MeSH:D057891</skos:exactMatch>
        <skos:exactMatch>UMLS:C0333694</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3305"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Tetraploidy syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3306 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3306">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166469"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_180772"/>

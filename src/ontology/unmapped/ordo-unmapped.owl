        <obo:IAO_0000115 xml:lang="en">Idiopathic juvenile osteoporosis (IJO) is a primary condition of bone demineralization that presents with pain in the back and extremities, walking difficulties, multiple fractures, and radiological evidence of osteoporosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">IJO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Idiopathic juvenile osteoporosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Juvenile osteoporosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Idiopathic juvenile osteoporosis</rdfs:label>
        <skos:broadMatch>ICD-10:M81.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:FB83.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019409</skos:exactMatch>
        <skos:exactMatch>MeSH:C537700</skos:exactMatch>
        <skos:exactMatch>MedDRA:10088561</skos:exactMatch>
        <skos:exactMatch>UMLS:C0264080</skos:exactMatch>
        <skos:narrowMatch>OMIM:259750</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615221</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>

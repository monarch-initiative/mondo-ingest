        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <obo:IAO_0000115 xml:lang="en">Maternally-inherited mitochondrial dystonia is a rare neurological mitochondrial DNA-related disorder characterized clinically by progressive pediatric-onset dystonia with variable degrees of severity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Maternally-inherited mitochondrial dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mitochondrial DNA-related dystonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">mtDNA-related dystonia</oboInOwl:hasExactSynonym>
        <rdfs:label>Mitochondrial DNA-related dystonia</rdfs:label>
        <skos:broadMatch>ICD-10:G24.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C73.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016806</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274074</skos:exactMatch>
    </owl:Class>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, childhood-onset epilepsy syndrome characterized by multiple seizure types including myoclonic-atonic (MA) seizures that occur usually in previously healthy children.</obo:IAO_0000115>

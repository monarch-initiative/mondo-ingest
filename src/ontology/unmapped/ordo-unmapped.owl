    <!-- http://www.orpha.net/ORDO/Orphanet_411501 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_411501">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_108993"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182111"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare, respiratory malformation characterized by defective or completely absent bronchial wall cartilage in subsegmental bronchi, leading to distal airway collapse and contributing to the formation of bronchiectasis. The defect is mostly present between the fourth and sixth order bronchial divisions. Clinical manifestation includes recurrent pneumonia, coughing and wheezing.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Williams-Campbell syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Williams-Campbell syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q32.2</skos:broadMatch>
        <skos:broadMatch>ICD-11:LA74.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0008888</skos:exactMatch>
        <skos:exactMatch>UMLS:C0340231</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_411501"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Williams-Campbell syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_2184 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2184">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269531"/>

    <!-- http://www.orpha.net/ORDO/Orphanet_958 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_958">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102285"/>

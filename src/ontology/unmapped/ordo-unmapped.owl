                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/854"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies syndrome characterized by congenital hearing impairment, small or absent nails on the hands and feet, and small or absent terminal phalanges.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Autosomal dominant deafness-onychodystrophy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autosomal dominant hearing loss-onychodystrophy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DDOD syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Autosomal dominant deafness-onychodystrophy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.0Y</skos:broadMatch>

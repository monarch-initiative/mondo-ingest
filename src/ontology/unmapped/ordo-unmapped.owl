    <!-- http://www.orpha.net/ORDO/Orphanet_90051 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90051">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182222"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377793"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare systemic condition affecting neonates born at less than 37 weeks gestational age and characterized by life-threatening organ dysfunction caused by a dysregulated host response to an infection, which may have been acquired shortly before or during birth (resulting in early-onset neonatal sepsis during the first 72 hours of life), or after birth (leading to late-onset neonatal sepsis between 72 hours and three months). Prematurity constitutes one of the primary risk factors for neonatal sepsis. The clinical picture may develop gradually with signs and symptoms like irritability, lethargy, or poor feeding, or progress rapidly to respiratory distress, fever, hypothermia, hypotension, shock, and multiple organ failure.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Sepsis in premature infants</oboInOwl:hasExactSynonym>
        <rdfs:label>Sepsis in premature infants</rdfs:label>
        <skos:broadMatch>ICD-10:P36.0</skos:broadMatch>
        <skos:broadMatch>ICD-10:P36.1</skos:broadMatch>
        <skos:broadMatch>ICD-10:P36.2</skos:broadMatch>
        <skos:broadMatch>ICD-10:P36.3</skos:broadMatch>
        <skos:broadMatch>ICD-10:P36.4</skos:broadMatch>
        <skos:broadMatch>ICD-10:P36.5</skos:broadMatch>
        <skos:broadMatch>ICD-10:P36.8</skos:broadMatch>
        <skos:broadMatch>ICD-10:P36.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:KA60</skos:broadMatch>
        <skos:exactMatch>UMLS:C5681350</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90051"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

        <obo:IAO_0000115 xml:lang="en">Familial hypocalciuric hypercalcemia (FHH) is a generally asymptomatic genetic disorder of phosphocalcic metabolism characterized by lifelong moderate hypercalcemia along with normo- or hypocalciuria and elevated plasma parathyroid hormone (PTH) concentration.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FBH</oboInOwl:hasExactSynonym>

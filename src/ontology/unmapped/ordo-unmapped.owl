    <!-- http://www.orpha.net/ORDO/Orphanet_60014 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_60014">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_556508"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare dermatosis, which can be either localized or generalized, that occurs after prolonged contact and absorption of silver containing compounds over a period of years and that is characterized by irreversible blue-gray to gray-black staining of skin, fingernails and/or mucous membranes, most evident on sun exposed areas of the skin. Silver exposure is usually occupational but may also occur through dental amalgams, the ingestion of colloidal silver, acupuncture needles, orthopedic implants and topical medications (such as silver sulfadiazine).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Argyria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Silver staining</oboInOwl:hasExactSynonym>
        <rdfs:label>Argyria</rdfs:label>
        <skos:broadMatch>ICD-10:T56.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:ED6Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0018952</skos:exactMatch>
        <skos:exactMatch>MeSH:D001129</skos:exactMatch>
        <skos:exactMatch>MedDRA:10003094</skos:exactMatch>
        <skos:exactMatch>UMLS:C0003782</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_60014"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

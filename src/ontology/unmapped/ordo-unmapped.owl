    <!-- http://www.orpha.net/ORDO/Orphanet_59303 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_59303">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_156607"/>

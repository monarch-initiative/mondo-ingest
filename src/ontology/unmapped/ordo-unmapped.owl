    <!-- http://www.orpha.net/ORDO/Orphanet_2678 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2678">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79375"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6742"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hyperpigmentation of the skin characterized by the presence of several café-au-lait macules without any other manifestations of neurofibromatosis or any other systemic disorder. The macules may appear in infancy, but usually they are detected after 2&amp;nbsp;years of age. Hyperpigmented lesions may have smooth or irregular borders. Their size vary from a few millimeters to more than 10&amp;nbsp;cm.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CALs syndrome isolated</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial CALMs isolated</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial isolated CALSs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial isolated café-au-lait macules</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial isolated café-au-lait spots</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple isolated café-au-lait spots</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple isolated café-au-lait syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial isolated café-au-lait macules</rdfs:label>
        <skos:broadMatch>ICD-11:EC23.0</skos:broadMatch>
        <skos:exactMatch>ICD-10:L81.3</skos:exactMatch>
        <skos:exactMatch>OMIM:114030</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861975</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

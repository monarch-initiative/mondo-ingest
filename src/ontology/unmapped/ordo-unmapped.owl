    <!-- http://www.orpha.net/ORDO/Orphanet_79455 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79455">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

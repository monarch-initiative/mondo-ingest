                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/8031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary sensory and autonomic neuropathy characterized by anhidrosis, insensitivity to pain, self-mutilating behavior and episodes of fever.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CIPA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital insensitivity to pain with anhidrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HSAN4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hereditary sensory and autonomic neuropathy type 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary sensory and autonomic neuropathy type IV</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary sensory and autonomic neuropathy type 4</rdfs:label>
        <skos:broadMatch>ICD-10:G60.8</skos:broadMatch>

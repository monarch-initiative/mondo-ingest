        <oboInOwl:hasExactSynonym xml:lang="en">Curly fiber corneal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Honeycomb corneal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TBCD</oboInOwl:hasExactSynonym>

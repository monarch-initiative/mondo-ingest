    <!-- http://www.orpha.net/ORDO/Orphanet_329284 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329284">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>

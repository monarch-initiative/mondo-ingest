    <!-- http://www.orpha.net/ORDO/Orphanet_329475 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_329475">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100979"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/12666"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spastic paraplegia-Paget disease of bone syndrome is an extremely rare, complex form of hereditary spastic paraplegia characterized by a slowly progressive spastic paraplegia (with increased muscle tone, decreased strength in the anterior tibial muscles and hyperreflexia in the lower extremities with Babinski sign) presenting in adulthood, associated with Paget disease of the bone. Cognitive decline, dementia and myopathic changes at muscle biopsy have not been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Spastic paraplegia-Paget disease of bone syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Spastic paraplegia-Paget disease of bone syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G11.4</skos:broadMatch>
        <skos:exactMatch>MONDO:0018005</skos:exactMatch>
        <skos:exactMatch>UMLS:C4511969</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

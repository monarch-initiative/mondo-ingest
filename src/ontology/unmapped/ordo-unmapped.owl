    <!-- http://www.orpha.net/ORDO/Orphanet_36383 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_36383">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_477765"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2202"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/2203"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic neurological disorder characterized by the presence of fragile small-vessel intracerebral vasculature in various members of a single family, manifesting, clinically, with single or recurrent hemorrhagic and/or ischemic stroke and, frequently, ocular and renal involvement. Neuroimaging reveals diffuse, periventricular leukoencephalopathy associated with dilated perivascular spaces, lacunar infarction and microhemorrhages.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COL4A-related brain small vessel disease with hemorrhage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">COL4A-related retinal arteriolar tortuosity-infantile hemiparesis-autosomal dominant leukoencephalopathy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>COL4A1/2-related familial vascular leukoencephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">COL4A1/COL4A2-related familial vascular leukoencephalopathy</oboInOwl:hasExactSynonym>
        <rdfs:label>COL4A1/2-related familial vascular leukoencephalopathy</rdfs:label>
        <skos:broadMatch>ICD-10:I67.8</skos:broadMatch>
        <skos:broadMatch>OMIM:175780</skos:broadMatch>
        <skos:exactMatch>MONDO:0008289</skos:exactMatch>
        <skos:exactMatch>MONDO:8289</skos:exactMatch>
        <skos:exactMatch>UMLS:C4755307</skos:exactMatch>
    </owl:Class>

        <skos:exactMatch>UMLS:C0221032</skos:exactMatch>
        <skos:narrowMatch>OMIM:269700</skos:narrowMatch>
        <skos:narrowMatch>OMIM:608594</skos:narrowMatch>
        <skos:narrowMatch>OMIM:612526</skos:narrowMatch>
        <skos:narrowMatch>OMIM:613327</skos:narrowMatch>
    </owl:Class>

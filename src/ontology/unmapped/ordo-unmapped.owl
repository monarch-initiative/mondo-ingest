    <!-- http://www.orpha.net/ORDO/Orphanet_251383 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251383">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269531"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_269564"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611314"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79195"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/13398"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">CK syndrome is a rare, genetic, X-linked syndromic intellectual disability disorder characterized by mild to severe intellectual disability, infancy-onset seizures, post-natal microcephaly, cerebral cortical malformations, dysmorphic facial features (including long, narrow face, almond-shaped palpebral fissures, epicanthic folds, high nasal bridge, malar flattening, posteriorly rotated ears, high arched palate, crowded teeth, micrognathia) and thin body habitus. Long and slim fingers/toes, strabismus, hypotonia, spasticity, optic disc atrophy, and behavioral problems (aggression, attention deficit hyperactivity disorder and irritability) are additional features.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CK syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked intellectual disability-microcephaly-cortical malformation-thin habitus syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>CK syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD27.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0010441</skos:exactMatch>
        <skos:exactMatch>OMIM:300831</skos:exactMatch>
        <skos:exactMatch>UMLS:C3151781</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_251383"/>

        <obo:IAO_0000115 xml:lang="en">Chronic myeloid leukaemia (CML) is the most common myeloproliferative disorder accounting for 15-20% of all leukaemia cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CML</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chronic granulocytic leukemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Chronic myelogenous leukemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic myeloid leukemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Chronic myeloid leukemia</rdfs:label>

        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_68385"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98641"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/95"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Congenital cataract-hearing loss-severe developmental delay syndrome is a rare, genetic, lethal, neurometabolic disease characterized by congenital cataracts, sensorineural hearing loss, severe psychomotor developmental delay, severe, generalized muscular hypotonia, and central nervous system abnormalities (incl. cerebellar and cerebral hypoplasia, hypomyelination, wide subarachnoid spaces), in the presence of low serum copper and ceruloplasmin. Nystagmus and seizures have also been reported.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital cataract-deafness-severe developmental delay syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Congenital cataract-hearing loss-severe developmental delay syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Huppke-Brendel syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lethal neurodegenerative disorder due to copper transport defect</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital cataract-hearing loss-severe developmental delay syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E83.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C64.0Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0013772</skos:exactMatch>
        <skos:exactMatch>OMIM:614482</skos:exactMatch>
        <skos:exactMatch>UMLS:C4751114</skos:exactMatch>
    </owl:Class>

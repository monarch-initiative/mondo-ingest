    <!-- http://www.orpha.net/ORDO/Orphanet_297 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_297">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_166490"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98252"/>
        <obo:IAO_0000115 xml:lang="en">An infectious disease characterized by central nervous system (CNS) involvement caused by the TBE virus (TBEV) and transmitted to humans principally by the bite of ticks from the &lt;i&gt;Ixodes&lt;/i&gt; genus. The symptomatology is often biphasic, with the initial phase being associated with a nonspecific febrile illness and the second phase with meningitis, meningoencephalitis or meningoencephalomyelitis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">TBE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tick-borne encephalitis</oboInOwl:hasExactSynonym>
        <rdfs:label>Tick-borne encephalitis</rdfs:label>
        <skos:broadMatch>ICD-11:1C80</skos:broadMatch>
        <skos:exactMatch>MONDO:0017572</skos:exactMatch>
        <skos:exactMatch>MeSH:D004675</skos:exactMatch>
        <skos:exactMatch>MedDRA:10043847</skos:exactMatch>
        <skos:exactMatch>UMLS:C0014061</skos:exactMatch>
        <skos:narrowMatch>ICD-10:A84.0</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A84.1</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A84.8</skos:narrowMatch>
        <skos:narrowMatch>ICD-10:A84.9</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_297"/>

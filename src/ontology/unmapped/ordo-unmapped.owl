        <oboInOwl:hasExactSynonym xml:lang="en">Mucosa-associated lymphatic tissue lymphoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mucosa-associated lymphoid tissue lymphoma</oboInOwl:hasExactSynonym>
        <rdfs:label>MALT lymphoma</rdfs:label>
        <skos:exactMatch>ICD-10:C88.4</skos:exactMatch>
        <skos:exactMatch>MONDO:0007650</skos:exactMatch>
        <skos:exactMatch>MedDRA:10060707</skos:exactMatch>

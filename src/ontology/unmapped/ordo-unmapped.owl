        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Global developmental delay-osteopenia-ectodermal defect syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_73224 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_73224">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183592"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_217619"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93603"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/19903"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare genetic disease characterized by the combination of (i) a salt-losing renal tubulopathy with hypomagnesemia and hypokalemic metabolic alkalosis and (ii) dilated cardiomyopathy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Kidney tubulopathy-dilated cardiomyopathy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Kidney tubulopathy-dilated cardiomyopathy syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:N25.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:GB5Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0019130</skos:exactMatch>
        <skos:exactMatch>MONDO:19130</skos:exactMatch>
        <skos:exactMatch>OMIM:620152</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304399</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_73224"/>

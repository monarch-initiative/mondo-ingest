        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/21022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Combined oxidative phosphorylation defect type 8 is a mitochondrial disease due to a defect in mitochondrial protein synthesis resulting in deficiency of respiratory chain complexes I, III and IV in the cardiac and skeletal muscle and brain characterized by severe hypertrophic cardiomyopathy, pulmonary hypoplasia, generalized muscle weakness and neurological involvement.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">COXPD8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Combined oxidative phosphorylation defect type 8</oboInOwl:hasExactSynonym>
        <rdfs:label>Combined oxidative phosphorylation defect type 8</rdfs:label>
        <skos:broadMatch>ICD-10:E88.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:5C53.23</skos:broadMatch>
        <skos:exactMatch>MONDO:0013570</skos:exactMatch>
        <skos:exactMatch>OMIM:614096</skos:exactMatch>
        <skos:exactMatch>UMLS:C4518839</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_79292 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_79292">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557494"/>

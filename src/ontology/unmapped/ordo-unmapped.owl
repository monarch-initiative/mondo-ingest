        <skos:narrowMatch>OMIM:602085</skos:narrowMatch>
        <skos:narrowMatch>OMIM:607324</skos:narrowMatch>
        <skos:narrowMatch>OMIM:608562</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615226</skos:narrowMatch>
        <skos:narrowMatch>OMIM:617642</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618219</skos:narrowMatch>
        <skos:narrowMatch>OMIM:618498</skos:narrowMatch>
    </owl:Class>

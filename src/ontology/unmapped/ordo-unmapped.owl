    <!-- http://www.orpha.net/ORDO/Orphanet_90036 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_90036">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98375"/>
        <obo:IAO_0000115 xml:lang="en">Mixed autoimmune hemolytic anemia is a type of autoimmune hemolytic anemia (AIHA) defined by the presence of both warm and cold autoantibodies, which have a deleterious effect on red blood cells at either body temperature or at lower temperatures.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Mixed AIHA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Mixed-type autoimmune hemolytic anemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Mixed-type autoimmune hemolytic anemia</rdfs:label>
        <skos:broadMatch>ICD-10:D59.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:3A20.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0019534</skos:exactMatch>
        <skos:exactMatch>UMLS:C4305257</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_90036"/>

                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/9413"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Severe combined immunodeficiency (SCID) due to DNA-PKcs deficiency is an extremely rare type of SCID characterized by the classical signs of SCID (severe and recurrent infections, diarrhea, failure to thrive), absence of T and B lymphocytes, and cell sensitivity to ionizing radiation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">T-B-NK+ SCID due to DNA-PKcs deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T-B-NK+ severe combined immunodeficiency due to DNA-PKcs deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>T-B-NK+ severe combined immunodeficiency due to DNA-PKcs deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:D81.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:4A01.10</skos:broadMatch>
        <skos:exactMatch>MONDO:0014423</skos:exactMatch>
        <skos:exactMatch>OMIM:615966</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274221</skos:exactMatch>
    </owl:Class>

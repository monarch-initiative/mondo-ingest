        <obo:IAO_0000115 xml:lang="en">Carcinoma of the gallbladder (GBC) is the most common and aggressive form of biliary tract cancer (BTC) usually arising in the fundus of the gallbladder, rapidly metastasizing to lymph nodes and distant sites.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Carcinoma of gallbladder and EBT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Carcinoma of gallbladder and extrahepatic biliary tract</oboInOwl:hasExactSynonym>
        <rdfs:label>Carcinoma of gallbladder and extrahepatic biliary tract</rdfs:label>
        <skos:exactMatch>MONDO:0018918</skos:exactMatch>

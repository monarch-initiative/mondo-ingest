            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Axenfeld-Rieger syndrome (ARS) is a generic term used to designate overlapping genetic disorders, in which the major physical condition is anterior segment dysgenesis of the eye. Patients with ARS may also present with multiple variable congenital anomalies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Axenfeld syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Axenfeld-Rieger syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rieger syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Axenfeld-Rieger syndrome</rdfs:label>

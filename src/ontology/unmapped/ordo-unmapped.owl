            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary optic neuropathy characterized by sudden onset, painless central vision loss, loss of retinal ganglion cells and optic atrophy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">LHON</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Leber hereditary optic neuropathy</oboInOwl:hasExactSynonym>

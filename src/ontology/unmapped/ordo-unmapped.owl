        <obo:IAO_0000115 xml:lang="en">Progressive familial intrahepatic cholestasis (PFIC) refers to a heterogeneous group of autosomal recessive disorders of childhood that disrupt bile formation and present with cholestasis of hepatocellular origin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">PFIC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progressive familial intrahepatic cholestasis</oboInOwl:hasExactSynonym>

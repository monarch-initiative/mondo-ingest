    <!-- http://www.orpha.net/ORDO/Orphanet_2898 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2898">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_139393"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">A rare, syndromic intellectual disability characterized by severe intellectual deficit, brachycephaly, plagiocephaly, and prominent forehead in male patients. Females may display moderate intellectual deficit without craniofacial dysmorphism. There have been no further descriptions in the literature since 1992.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyde Forster-McCarthy-Berry syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>X-linked intellectual disability-plagiocephaly syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>X-linked intellectual disability-plagiocephaly syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.0</skos:broadMatch>

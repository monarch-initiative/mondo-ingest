    <!-- http://www.orpha.net/ORDO/Orphanet_178355 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_178355">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_253"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/21317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/16075"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Smith-McCort dysplasia (SMC) is a rare spondylo-epi-metaphyseal dysplasia characterized by the clinical manifestations of coarse facies, short neck, short trunk dwarfism with barrel-shaped chest and rhizomelic limb shortening, as well as specific radiological features (i.e. generalized platyspondyly with double-humped vertebral end plates and iliac crests with a lace-like appearance) and normal intelligence. The clinical and skeletal features are similar to those seen in the allelic disorder Dyggve-Melchior-Clausen syndrome (DMC), but can be distinguished from this syndrome by the absence of intellectual deficiency and microcephaly in SMC.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Smith-McCort dysplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Smith-McCort dysplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0015799</skos:exactMatch>
        <skos:exactMatch>MeSH:C564589</skos:exactMatch>
        <skos:exactMatch>UMLS:C1846431</skos:exactMatch>
        <skos:narrowMatch>OMIM:607326</skos:narrowMatch>
        <skos:narrowMatch>OMIM:615222</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_178355"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Smith-McCort dysplasia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_178364 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_178364">

    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_96168 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_96168">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_262101"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98642"/>
        <obo:IAO_0000115 xml:lang="en">Monosomy 13q34 is a rare chromosomal anomaly syndrome, resulting from the partial deletion of the long arm of chromosome 13, principally characterized by global developmental delay, mild intellectual disability, obesity and mild craniofacial dysmorphism (microcephaly, wide rectangular forehead, downslanting palpebral fissures, mild ptosis, prominent nose with long nasal bridge and broad tip, small chin). Other variable reported features include congenital heart defects, hand and foot anomalies (e.g. polydactyly) and agenesis of the corpus callosum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(13)(q34)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal deletion 13q34</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Monosomy 13q34 syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Subtelomeric deletion 13q34</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>del(13)(q34)</oboInOwl:hasExactSynonym>
        <rdfs:label>Monosomy 13q34 syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.D</skos:broadMatch>
        <skos:exactMatch>MONDO:0019902</skos:exactMatch>
        <skos:exactMatch>OMIM:619148</skos:exactMatch>
        <skos:exactMatch>UMLS:C4707797</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_96168"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Monosomy 13q34 syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    <owl:Axiom>

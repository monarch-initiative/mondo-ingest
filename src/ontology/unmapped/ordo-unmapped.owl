            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/11802"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare distal myopathy characterized by weakness in the distal upper extremities, usually finger and wrist extensors which later progresses to all hand muscles and distal lower extremity, primarily in toe and ankle extensors.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Distal myopathy, Welander type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">WDM</oboInOwl:hasExactSynonym>
        <rdfs:label>Distal myopathy, Welander type</rdfs:label>
        <skos:broadMatch>ICD-10:G71.0</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C75</skos:broadMatch>
        <skos:exactMatch>MONDO:0011466</skos:exactMatch>
        <skos:exactMatch>MedDRA:10078052</skos:exactMatch>
        <skos:exactMatch>OMIM:604454</skos:exactMatch>
        <skos:exactMatch>UMLS:C0221054</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_603"/>

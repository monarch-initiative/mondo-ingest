    <!-- http://www.orpha.net/ORDO/Orphanet_493 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_493">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183487"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79386"/>
        <obo:IAO_0000115 xml:lang="en">A rare inherited skin cancer syndrome characterized by the coexistence of features typical of both multiple self-healing squamous epithelioma and generalized eruptive keratoacanthoma, such as multiple small miliary-type lesions, larger self-healing lesions, and nodulo-ulcerative lesions. Lesions do not have a predilection for the mucosal surfaces.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Familial keratoacanthoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary keratoacanthoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple keratoacanthoma</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial keratoacanthoma</rdfs:label>
        <skos:broadMatch>ICD-10:L85.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C31.1</skos:broadMatch>
        <skos:exactMatch>MONDO:0018851</skos:exactMatch>
        <skos:exactMatch>MeSH:C536150</skos:exactMatch>
        <skos:exactMatch>UMLS:C5848325</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_493"/>

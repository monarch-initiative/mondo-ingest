        <oboInOwl:hasExactSynonym xml:lang="en">Trichothiodystrophy type E</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Trichothiodystrophy with congenital ichthyosis</oboInOwl:hasExactSynonym>
        <rdfs:label>IBIDS syndrome</rdfs:label>

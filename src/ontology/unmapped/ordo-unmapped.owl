        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, genetic multisystem disorder characterized by a neurodegenerative disorder associating global developmental delay, progressive microcephaly, and progressive cerebral and cerebellar atrophy with extrapyramidal involvement, progressive optic atrophy, and in many patients early-onset steroid-resistant nephrotic syndrome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Galloway syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Galloway-Mowat syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Microcephaly-hiatus hernia-nephrotic syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nephrosis-neuronal dysmigration syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Galloway-Mowat syndrome</rdfs:label>

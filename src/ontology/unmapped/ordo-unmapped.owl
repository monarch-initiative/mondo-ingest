            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/5024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A form of diazoxide-sensitive diffuse congenital hyperinsulinism due to HNF4A deficiency and, characterized by macrosomia, transient or persistent hyperinsulinemic hypoglycemia (HH), responsiveness to diazoxide and a propensity to develop maturity-onset diabetes of the young subtype 1 (MODY).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital hyperinsulinism due to HNF4A deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hyperinsulinemic hypoglycemia due to HNF4A deficiency</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital hyperinsulinism due to HNF4A deficiency</rdfs:label>
        <skos:broadMatch>ICD-10:E16.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:5A45</skos:broadMatch>
        <skos:exactMatch>MONDO:0016988</skos:exactMatch>
        <skos:exactMatch>MONDO:16988</skos:exactMatch>
        <skos:exactMatch>UMLS:C4274078</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_263455"/>

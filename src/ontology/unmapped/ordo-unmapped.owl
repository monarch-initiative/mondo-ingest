    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3246 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3246">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_294959"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93459"/>
        <obo:IAO_0000115 xml:lang="en">Symphalangism with multiple anomalies of hands and feet is a rare, genetic, congenital limb malformation disorder characterized by bilateral symphalangism of hands and feet associated with cutaneous syndactyly of digits II-V, unilateral or bilateral brachydactyly type D (i.e. short, broad terminal phalanges of the thumbs), clinodactyly of fifth toes and/or mild hypoplasia of the thenar and hypothenar eminences. There have been no further descriptions in the literature since 1981.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Learman syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Symphalangism with multiple anomalies of hands and feet</oboInOwl:hasExactSynonym>
        <rdfs:label>Symphalangism with multiple anomalies of hands and feet</rdfs:label>
        <skos:broadMatch>ICD-10:Q74.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008510</skos:exactMatch>
        <skos:exactMatch>MeSH:C566098</skos:exactMatch>
        <skos:exactMatch>OMIM:185750</skos:exactMatch>
        <skos:exactMatch>UMLS:C1861391</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3246"/>

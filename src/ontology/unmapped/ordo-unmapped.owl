        <obo:IAO_0000115 xml:lang="en">A rare sporadic neurodegenerative disease characterized by slowly progressive symptoms of orthostatic hypotension (OH), and other symptoms of generalised dysautonomia related to the impairment of the sympathetic component of the autonomic nervous system.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Bradbury-Eggleston syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Idiopathic orthostatic hypotension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PAF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pure autonomic failure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pure dysautonomia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pure idiopatic dysautonomia</oboInOwl:hasExactSynonym>
        <rdfs:label>Pure autonomic failure</rdfs:label>
        <skos:broadMatch>ICD-10:G90.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:8D84</skos:exactMatch>
        <skos:exactMatch>MONDO:0018608</skos:exactMatch>
        <skos:exactMatch>MeSH:D054970</skos:exactMatch>
        <skos:exactMatch>UMLS:C0393911</skos:exactMatch>
    </owl:Class>

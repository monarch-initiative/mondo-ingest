        <obo:IAO_0000115 xml:lang="en">A rare constitutional hemolytic anemia due to a red cell membrane anomaly characterized by lack or severe reduction of Rh blood group antigens, resulting in increased osmotic fragility of red blood cells and chronic hemolytic anemia of varying severity with stomatocytosis and spherocytosis. Two types of the syndrome arising from independent genetic mechanisms have been distinguished: the regulator type is caused by defects of the Rh associated glycoprotein (encoded by the &lt;i&gt;RHAG&lt;/i&gt; gene), while the amorph type is due to mutations at the &lt;i&gt;RH&lt;/i&gt; locus itself.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Rh deficiency syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rh-null syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Rh deficiency syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:D58.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:3A10.Y</skos:broadMatch>
        <skos:broadMatch>OMIM:268150</skos:broadMatch>
        <skos:exactMatch>MONDO:0019107</skos:exactMatch>
        <skos:exactMatch>MeSH:C562717</skos:exactMatch>
        <skos:exactMatch>UMLS:C0272052</skos:exactMatch>
        <skos:narrowMatch>OMIM:617970</skos:narrowMatch>
        <skos:narrowMatch>OMIM:619462</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_71275"/>

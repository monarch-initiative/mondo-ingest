        <obo:IAO_0000115 xml:lang="en">14q12 microdeletion syndrome is a recently described syndrome characterized by severe intellectual deficit, with a normal neonatal period, followed by a phase of regression at the age of 3-6 months.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Del(14)(q12)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>FOXG1 syndrome due to 14q12 microdeletion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monosomy 14q12</oboInOwl:hasExactSynonym>

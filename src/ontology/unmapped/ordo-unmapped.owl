        <skos:exactMatch>MONDO:0012980</skos:exactMatch>
        <skos:exactMatch>OMIM:612651</skos:exactMatch>
        <skos:exactMatch>UMLS:C4509819</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

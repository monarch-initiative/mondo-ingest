        <obo:IAO_0000115 xml:lang="en">A rare autoimmune disorder of the neuromuscular junction characterized by fatigable weakness of voluntary muscles.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Acquired myasthenia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Autoimmune myasthenia gravis</oboInOwl:hasExactSynonym>

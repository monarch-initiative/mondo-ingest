    <!-- http://www.orpha.net/ORDO/Orphanet_652 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_652">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_100091"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_2207"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276161"/>

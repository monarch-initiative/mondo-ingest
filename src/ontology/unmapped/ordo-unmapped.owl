        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Primary pulmonary hypoplasia is a rare, isolated, genetic developmental defect during embryogenesis characterized by congenital malformation of pulmonary parenchyma with absence of other anomalies. Neonatally patients present with decreased breath sounds, small lung volume and severe respiratory distress that is not responsive to aggressive treatment (including surfactant instillation/ mechanical respiratory support). It is usually not compatible with life.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Primary pulmonary hypoplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary pulmonary hypoplasia</rdfs:label>
        <skos:broadMatch>ICD-10:Q33.6</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA75.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0009936</skos:exactMatch>
        <skos:exactMatch>MONDO:9936</skos:exactMatch>
        <skos:exactMatch>OMIM:265430</skos:exactMatch>
        <skos:exactMatch>UMLS:C0456891</skos:exactMatch>
    </owl:Class>

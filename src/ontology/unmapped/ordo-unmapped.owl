    <!-- http://www.orpha.net/ORDO/Orphanet_18 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_18">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_314822"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

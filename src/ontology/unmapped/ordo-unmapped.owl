    <!-- http://www.orpha.net/ORDO/Orphanet_98757 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_98757">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_158266"/>

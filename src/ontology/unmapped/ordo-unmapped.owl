    <!-- http://www.orpha.net/ORDO/Orphanet_54247 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_54247">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_276058"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98534"/>
        <obo:IAO_0000115 xml:lang="en">A rare neurologic disease characterized by impairment of higher visual processing skills and other posterior cortical functions without any evidence of ocular abnormalities, relatively intact memory and language in the early stages, and atrophy of posterior brain regions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Benson syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Biparietal Alzheimer disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PCA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Posterior cortical atrophy</oboInOwl:hasExactSynonym>
        <rdfs:label>Posterior cortical atrophy</rdfs:label>
        <skos:broadMatch>ICD-10:G31.1</skos:broadMatch>
        <skos:exactMatch>ICD-11:8A21.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0018899</skos:exactMatch>
        <skos:exactMatch>MedDRA:10078207</skos:exactMatch>
        <skos:exactMatch>UMLS:C4275079</skos:exactMatch>
    </owl:Class>

                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004001"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/7060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies/dysmorphic syndrome characterized by diffuse cartilage calcification, brachytelephalangism, peripheral pulmonary artery stenoses and facial dysmorphism. Vascular calcification has been reported in some cases.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Keutel syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pulmonic stenosis-brachytelephalangism-calcification of cartilages syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Keutel syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0009495</skos:exactMatch>
        <skos:exactMatch>MeSH:C536167</skos:exactMatch>
        <skos:exactMatch>OMIM:245150</skos:exactMatch>
        <skos:exactMatch>UMLS:C1855607</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_85202"/>

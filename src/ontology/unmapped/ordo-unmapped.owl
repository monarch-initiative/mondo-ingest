    <!-- http://www.orpha.net/ORDO/Orphanet_213 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_213">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

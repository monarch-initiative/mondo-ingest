        <obo:IAO_0000115 xml:lang="en">A rare generalized, genetic disorder of proximal tubular transport characterized by excessive urine output with loss of low molecular weight solutes (amino acids, glucose, low-molecular weight proteins, organic acids, carnitine, calcium, phosphate, potassium, bicarbonate) and water, and which can be life threatening.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DeToni-Debré-Fanconi syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Primary Fanconi renal syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary Fanconi renotubular syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Primary Fanconi renotubular syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:E72.0</skos:broadMatch>
        <skos:exactMatch>ICD-11:GB90.42</skos:exactMatch>

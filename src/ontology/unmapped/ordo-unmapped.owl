    <!-- http://www.orpha.net/ORDO/Orphanet_263516 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_263516">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_371047"/>

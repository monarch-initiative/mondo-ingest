    <!-- http://www.orpha.net/ORDO/Orphanet_206586 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_206586">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207046"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">Neurolymphomatosis is a rare syndrome of peripheral and cranial nerve dysfunction in patients with hematologic malignancies, mostly non-Hodgkin&apos;s lymphoma or acute leukemia, characterized by painful or painless involvement of peripheral or cranial nerves or nerve roots. The clinical presentation is diverse depending on the site involved and includes plexopathy, mononeuritis multiplex, peripheral neuropathy, radiculopathy and cranial nerve palsies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Neurolymphomatosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Neurolymphomatosis</rdfs:label>
        <skos:broadMatch>ICD-10:C96.7</skos:broadMatch>
        <skos:broadMatch>ICD-10:G63.1</skos:broadMatch>
        <skos:broadMatch>ICD-11:8C01.Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0016101</skos:exactMatch>
        <skos:exactMatch>MeSH:D000077162</skos:exactMatch>
        <skos:exactMatch>UMLS:C4553088</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_206586"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neurolymphomatosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_206594 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_206594">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_207038"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <obo:IAO_0000115 xml:lang="en">A rare neuroinflammatory disease characterized by muscular weakness with impaired sensation, absent or diminished tendon reflexes and elevated cerebrospinal fluid (CSF) protein content. Subacute inflammatory demyelinating polyneuropathy (SIDP) is an intermediate form between Guillain-Barré syndrome (GBS) and chronic inflammatory demyelinating polyneuropathy (CIDP).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Subacute inflammatory demyelinating polyneuropathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Subacute inflammatory demyelinating polyradiculoneuropathy</oboInOwl:hasExactSynonym>
        <rdfs:label>Subacute inflammatory demyelinating polyneuropathy</rdfs:label>
        <skos:broadMatch>ICD-10:G61.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:8C01.2</skos:exactMatch>
        <skos:exactMatch>MONDO:0016102</skos:exactMatch>
        <skos:exactMatch>MedDRA:10081726</skos:exactMatch>
        <skos:exactMatch>UMLS:C0456517</skos:exactMatch>

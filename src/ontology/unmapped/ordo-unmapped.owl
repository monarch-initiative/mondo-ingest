        <oboInOwl:hasExactSynonym xml:lang="en">Platinum oculocutaneous albinism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Yellow oculocutaneous albinism</oboInOwl:hasExactSynonym>
        <rdfs:label>Oculocutaneous albinism type 1B</rdfs:label>
        <skos:broadMatch>ICD-10:E70.3</skos:broadMatch>

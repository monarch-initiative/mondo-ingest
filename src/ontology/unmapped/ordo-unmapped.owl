        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare thyroid disease characterized by familial occurrence of thyroid enlargement due to the development of multiple hyperplastic nodules with onset in childhood or adolescence. The condition is commonly associated with the development of other benign or malignant tumors.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">FMNG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial MNG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Familial multinodular goiter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Familial multinodular goiter syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Familial multinodular goiter</rdfs:label>

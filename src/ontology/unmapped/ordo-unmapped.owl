        <obo:IAO_0000115 xml:lang="en">A rare renal tubular disease characterized by impaired ability of the proximal tubule to reabsorb bicarbonate from the glomerular filtrate leading to hyperchloremic metabolic acidosis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Proximal renal tubular acidosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Renal tubular acidosis type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pRTA</oboInOwl:hasExactSynonym>

        <oboInOwl:hasExactSynonym>Hereditary leiomyomatosis and renal cell cancer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary leiomyomatosis with renal carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Hereditary multiple cutaneous leiomyomas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MCUL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Multiple cutaneous and uterine leiomyomas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Reed syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Hereditary leiomyomatosis and renal cell cancer</rdfs:label>
        <skos:broadMatch>ICD-10:C64</skos:broadMatch>
        <skos:broadMatch>ICD-11:2C90.Y</skos:broadMatch>

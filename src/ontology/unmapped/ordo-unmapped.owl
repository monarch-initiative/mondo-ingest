    <!-- http://www.orpha.net/ORDO/Orphanet_324416 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_324416">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <obo:IAO_0000115 xml:lang="en">Muscular hypertrophy-hepatomegaly-polyhydramnios syndrome is a rare genetic disease characterized by symmetrical muscular hypertrophy, hepatomegaly, polyhydramnios, macrocephaly and mild delay in motor, speech and language development.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Muscular hypertrophy-hepatomegaly-polyhydramnios syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Muscular hypertrophy-hepatomegaly-polyhydramnios syndrome</rdfs:label>

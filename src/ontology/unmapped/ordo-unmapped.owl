    <!-- http://www.orpha.net/ORDO/Orphanet_251061 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_251061">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_211053"/>

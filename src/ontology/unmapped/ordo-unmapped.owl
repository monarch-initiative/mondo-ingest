    <!-- http://www.orpha.net/ORDO/Orphanet_701 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_701">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_481771"/>

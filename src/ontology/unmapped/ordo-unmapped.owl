            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/3551"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A severe form of hemophilia B characterized by a large deficiency of factor IX (biological activity &lt;1 IU/dL) leading to frequent spontaneous hemorrhage and abnormal bleeding as a result of minor injuries or following trauma, surgery or tooth extraction. It primarily affects males but may also be observed in female carriers of disease-causing mutations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe congenital F9 deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Severe congenital factor IX deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Severe hemophilia B</oboInOwl:hasExactSynonym>
        <rdfs:label>Severe hemophilia B</rdfs:label>
        <skos:broadMatch>ICD-10:D67</skos:broadMatch>
        <skos:broadMatch>ICD-11:3B11.0</skos:broadMatch>
        <skos:broadMatch>OMIM:306900</skos:broadMatch>
        <skos:exactMatch>MONDO:0015715</skos:exactMatch>
        <skos:exactMatch>UMLS:C5679576</skos:exactMatch>
    </owl:Class>

    </owl:Class>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_93360 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_93360">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_253"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93441"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6391"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Spondyloepimetaphyseal dysplasia with multiple dislocations is a rare genetic primary bone dysplasia disorder characterized by midface hypoplasia, short stature, generalized joint laxity, multiple joint dislocations (most frequently of knees and hips), limb malalignment (genu valgum/varum) and progressive spinal deformity (e.g. kyphosis/scoliosis). Radiography reveals distinctive slender metacarpals and metatarsals, as well as small, irregular epiphyses, metaphyseal irregularities with vertical striations, constricted femoral necks and mild platyspondyly, among others.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">SEMD-MD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SEMDJL2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spondyloepimetaphyseal dysplasia with joint laxicity, Hall type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spondyloepimetaphyseal dysplasia with joint laxity type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Spondyloepimetaphyseal dysplasia with joint laxity, leptodactylic type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Spondyloepimetaphyseal dysplasia with multiple dislocations, Hall type</oboInOwl:hasExactSynonym>
        <rdfs:label>Spondyloepimetaphyseal dysplasia with joint laxity, leptodactylic type</rdfs:label>
        <skos:broadMatch>ICD-10:Q77.7</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD24.3</skos:broadMatch>
        <skos:exactMatch>MONDO:0011335</skos:exactMatch>
        <skos:exactMatch>MONDO:11335</skos:exactMatch>
        <skos:exactMatch>MeSH:C535784</skos:exactMatch>
        <skos:exactMatch>OMIM:603546</skos:exactMatch>
        <skos:exactMatch>UMLS:C1863732</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_93360"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Spondyloepimetaphyseal dysplasia with joint laxity, leptodactylic type</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    



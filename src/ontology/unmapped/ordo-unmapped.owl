            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare developmental defect during embryogenesis characterized by intellectual deficit, ataxia, postnatal microcephaly, and hyperkinesis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Christianson syndrome</oboInOwl:hasExactSynonym>

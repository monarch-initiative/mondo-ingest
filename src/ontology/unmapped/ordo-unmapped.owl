        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98741"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6263"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004003"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/6266"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare disorder characterized by periodic muscle paralysis, prolongation of the QT interval with a variety of ventricular arrhythmias (leading to predisposition to sudden cardiac death) and characteristic physical features: short stature, scoliosis, low-set ears, hypertelorism, broad nasal root, micrognathia, clinodactyly, brachydactyly and syndactyly.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Andersen syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Andersen-Tawil syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">LQT7</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Long QT syndrome type 7</oboInOwl:hasExactSynonym>
        <rdfs:label>Andersen-Tawil syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:G72.3</skos:broadMatch>
        <skos:broadMatch>ICD-11:BC65.0</skos:broadMatch>
        <skos:exactMatch>MONDO:0008222</skos:exactMatch>
        <skos:exactMatch>MeSH:D050030</skos:exactMatch>
        <skos:exactMatch>MedDRA:10083859</skos:exactMatch>
        <skos:exactMatch>OMIM:170390</skos:exactMatch>
        <skos:exactMatch>UMLS:C1563715</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_37553"/>

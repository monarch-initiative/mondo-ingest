        <skos:broadMatch>ICD-10:Q93.5</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD44.21</skos:broadMatch>
        <skos:exactMatch>MONDO:0012916</skos:exactMatch>
        <skos:exactMatch>OMIM:612513</skos:exactMatch>
        <skos:exactMatch>UMLS:C4304538</skos:exactMatch>
    </owl:Class>

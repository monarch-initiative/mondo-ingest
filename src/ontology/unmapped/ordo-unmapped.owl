        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A desmoid tumor (DT) is a benign, locally invasive soft tissue tumor associated with a high recurrence rate but with no metastatic potential.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Aggressive fibromatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Desmoid tumor</oboInOwl:hasExactSynonym>

        <obo:IAO_0000115 xml:lang="en">A rare tremor disorder characterized by an isolated high frequency (&gt;12 Hz) tremor that occurs when standing, typically in weight-bearing muscles, causing a feeling of unsteadiness or discomfort, which disappears when not standing.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">POT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Primary orthostatic tremor</oboInOwl:hasExactSynonym>

        <obo:IAO_0000115 xml:lang="en">A form of thoracic outlet syndrome that presents as unilateral upper extremity ischemia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ATOS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Arterial TOS</oboInOwl:hasExactSynonym>

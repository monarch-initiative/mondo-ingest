    <!-- http://www.orpha.net/ORDO/Orphanet_2253 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2253">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>

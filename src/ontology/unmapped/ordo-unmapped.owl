    <!-- http://www.orpha.net/ORDO/Orphanet_3186 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3186">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_102283"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_611327"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93547"/>
        <obo:IAO_0000115 xml:lang="en">A rare multiple congenital anomalies syndrome characterised by holoprosencephaly, predominantly radial limb deficiency (absent thumbs, phocomelia), heart defects, kidney malformations and absence of gallbladder. Variable manifestations include vertebral anomalies, cleft lip/palate, microphthalmia, absent nose, dysplastic ears, hearing loss, colobomas of the iris and retina and/or bifid uvula.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Holoprosencephaly-radial heart renal anomalies syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Steinfeld syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Holoprosencephaly-radial heart renal anomalies syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q87.8</skos:broadMatch>
        <skos:exactMatch>MONDO:0008488</skos:exactMatch>
        <skos:exactMatch>MeSH:C566655</skos:exactMatch>
        <skos:exactMatch>OMIM:184705</skos:exactMatch>
        <skos:exactMatch>UMLS:C1866649</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3186"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Holoprosencephaly-radial heart renal anomalies syndrome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3188 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3188">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_182111"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_506222"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98729"/>
        <obo:IAO_0000115 xml:lang="en">A rare progressive and life-threatening anomaly of the great vessels characterized by narrowing and obstruction of one or more normally positioned pulmonary vein at their junction with the left atrium. Presentation is typically during early infancy with dyspnea, tachypnea, and repeated pulmonary infections. Eventually, when all pulmonary veins of one lung are affected, the disorder results in pulmonary hypertension (PH) and consecutive pulmonary arterial hypertension (PAH). It may manifest as an isolated lesion or associated with other cardiac defects such as congenital pulmonary venous return anomaly and septal defects.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital pulmonary veins atresia or stenosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital pulmonary veins atresia or stenosis</rdfs:label>
        <skos:broadMatch>ICD-10:Q26.8</skos:broadMatch>
        <skos:exactMatch>ICD-11:LA86.3</skos:exactMatch>
        <skos:exactMatch>MONDO:0017864</skos:exactMatch>
        <skos:exactMatch>MONDO:17864</skos:exactMatch>
        <skos:exactMatch>UMLS:C5680865</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3188"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital pulmonary veins atresia or stenosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_3189 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_3189">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377791"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_98719"/>
        <obo:IAO_0000115 xml:lang="en">A rare congenital heart malformation characterized by an obstruction to flow through the pulmonary valve with a clinical presentation that may vary from critical stenosis presenting in the neonatal period to asymptomatic mild stenosis. The obstruction at the valvular level can be associated with obstruction at the subpulmonary, or supravalvar levels (valvar, subpulmonary, supravalvar pulmonary stenosis (PS).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Congenital pulmonary valvar stenosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital stenosis of pulmonary valve</oboInOwl:hasExactSynonym>
        <rdfs:label>Congenital pulmonary valvar stenosis</rdfs:label>
        <skos:exactMatch>ICD-10:Q22.1</skos:exactMatch>
        <skos:exactMatch>ICD-11:LA8A.00</skos:exactMatch>
        <skos:exactMatch>MONDO:0017865</skos:exactMatch>
        <skos:exactMatch>MedDRA:10037451</skos:exactMatch>
        <skos:exactMatch>UMLS:C0162164</skos:exactMatch>
        <skos:narrowMatch>OMIM:265500</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_3189"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Congenital pulmonary valvar stenosis</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>
    </owl:Axiom>
    


    <!-- http://www.orpha.net/ORDO/Orphanet_319 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_319">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_223727"/>

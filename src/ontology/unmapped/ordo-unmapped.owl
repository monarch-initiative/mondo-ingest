    <!-- http://www.orpha.net/ORDO/Orphanet_59305 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_59305">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_254685"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557492"/>
        <obo:IAO_0000115 xml:lang="en">A rare, malignant group of gestational trophoblastic diseases always following pregnancy, most often molar pregnancy (hydatidiform mole). Four histological forms are described: invasive mole, gestational choriocarcinoma, placental site trophoblastic tumor (PSTT) and epithelioid trophoblastic tumor (ETT).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">GTN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gestational trophoblastic neoplasm</oboInOwl:hasExactSynonym>
        <rdfs:label>Gestational trophoblastic neoplasm</rdfs:label>
        <skos:exactMatch>ICD-11:2C75.0</skos:exactMatch>
        <skos:exactMatch>MONDO:0018944</skos:exactMatch>
        <skos:exactMatch>MONDO:18944</skos:exactMatch>
        <skos:exactMatch>MedDRA:10061988</skos:exactMatch>
        <skos:exactMatch>UMLS:C1135868</skos:exactMatch>
    </owl:Class>

    <!-- http://www.orpha.net/ORDO/Orphanet_2779 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2779">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_183466"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377789"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_79375"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_93444"/>
        <obo:IAO_0000115 xml:lang="en">A rare primary bone dysplasia characterized by the association of osteopathia striata (longitudinal striations through most of the long bones) with a macular, hyperpigmented dermopathy and a white forelock.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Osteopathia striata-pigmentary dermopathy-white forelock syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Whyte-Murphy syndrome</oboInOwl:hasExactSynonym>
        <rdfs:label>Osteopathia striata-pigmentary dermopathy-white forelock syndrome</rdfs:label>
        <skos:broadMatch>ICD-10:Q78.8</skos:broadMatch>
        <skos:broadMatch>ICD-11:LD2F.1Y</skos:broadMatch>
        <skos:exactMatch>MONDO:0017197</skos:exactMatch>
        <skos:exactMatch>MeSH:C536054</skos:exactMatch>
        <skos:exactMatch>UMLS:C2931096</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>

        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare subtype of dystrophic epidermolysis bullosa (DEB) characterized by blisters and erosions which from adolescence or early adulthood are primarily confined to flexural skin sites.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">RDEB inversa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">RDEB-I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Recessive dystrophic epidermolysis bullosa inversa</oboInOwl:hasExactSynonym>

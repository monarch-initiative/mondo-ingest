    <!-- http://www.orpha.net/ORDO/Orphanet_2122 -->

    <owl:Class rdf:about="http://www.orpha.net/ORDO/Orphanet_2122">
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_377788"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_557493"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_673473"/>
        <rdfs:subClassOf rdf:resource="http://www.orpha.net/ORDO/Orphanet_71209"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004004"/>
                <owl:someValuesFrom rdf:resource="http://identifiers.org/hgnc/4382"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare, locally aggressive, cutaneous or visceral vascular tumor characterized by either superficial lesions presenting as blue-purple infiltrated ill-defined plaques, or deep lesions usually manifesting with coagulation abnormality. They are associated in about 3 out of 4 of cases with potentially lethal thrombocytopenia and consumption coagulopathy (Kasabach-Merritt phenomenon; KMP).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Kaposiform hemangioendothelioma</oboInOwl:hasExactSynonym>
        <rdfs:label>Kaposiform hemangioendothelioma</rdfs:label>
        <skos:broadMatch>ICD-10:C49.9</skos:broadMatch>
        <skos:broadMatch>ICD-11:2F72.Y</skos:broadMatch>
        <skos:exactMatch>ICD-11:XH6PA4</skos:exactMatch>
        <skos:exactMatch>MONDO:0016236</skos:exactMatch>
        <skos:exactMatch>MeSH:C537007</skos:exactMatch>
        <skos:exactMatch>MedDRA:10087551</skos:exactMatch>
        <skos:exactMatch>UMLS:C1367420</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.orpha.net/ORDO/Orphanet_2122"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Kaposiform hemangioendothelioma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#GENERATED_FROM_LABEL"/>

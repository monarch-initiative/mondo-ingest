            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Dysequilibrium syndrome (DES) is a non-progressive cerebellar disorder characterized by ataxia associated with an intellectual disability, delayed ambulation and cerebellar hypoplasia.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">CAMRQ syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Cerebellar ataxia-intellectual disability-dysequilibrium syndrome</oboInOwl:hasExactSynonym>

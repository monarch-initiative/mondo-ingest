        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A rare hereditary Transthyretin (TTR)-related systemic amyloidosis (ATTR) with predominant cardiac involvement resulting from myocardial infiltration of abnormal amyloid protein.</obo:IAO_0000115>
